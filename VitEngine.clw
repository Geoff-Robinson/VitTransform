! (c) 2019-2026 Geoffrey C. Robinson.  vitessegr AT gmail DOT com
! Released under the MIT License - see LICENSE.
!
!
! See VitEngine.inc header. File loop, wildcards and CLI parsing live in the
! driver program (vitTransform.clw), mirroring vtxaDiff's Transformations
! structure; this class handles one file end to end.
!
!
  MEMBER

  Include('StringTheory.inc'),ONCE
  Include('VitTokenize.inc'),ONCE
  Include('VitRules.inc'),ONCE
  Include('VitSymbols.inc'),ONCE
  Include('VitMatch.inc'),ONCE
  Include('VitRewrite.inc'),ONCE
  Include('VitTimer.inc'),ONCE
  Include('VitEngine.inc'),ONCE

  MAP
  END

! InlineSingleUse's liveness walk: how deep a nesting it will follow. Clarion code this deep is
! already unreadable, and the walk REFUSES rather than guesses when it runs past this - a wrong
! answer here deletes a store something still reads. Declared HERE rather than in the .inc
! because only this module uses it, and a comment block added to the .inc splits an alignment
! run there, which moves a column thirty lines away.
isu:maxDepth EQUATE(64)
isu:cmpdOps  EQUATE(' += -= *= /= ^= %= &= :=: ') ! the compound assignments: a read AND a write of their left side

! The StringTheory methods and properties that SET an object's encoding, base64 or gzip flags,
! which a getValue() copy leaves behind. TakeOverValue and DropValueCopy both ask it.
fl:writers   EQUATE(                                                                                                                 |
  ' ADDBOM ASNDECODE BASE64DECODE BASE64ENCODE BIGENDIAN ENCODEDWORDDECODE ENCODEDWORDENCODE GUNZIP GZIP JSONDECODE LITTLEENDIAN ' & |
    'LOADFILE NORMALIZE SETENCODINGFROMBOM SETVALUEBYCSTRINGADDRESS TOANSI TOUNICODE ENCODING BASE64 GZIPPED ENDIAN CODEPAGE SETVALUEW _STEALVALUE ')
fl:state     EQUATE(' BASE64NOWRAP BASE64URLSAFE ENDOFLASTLINE BYTES LASTERROR WINERRORCODE EOF ') ! the rest of an object's state a by-value copy leaves behind (the final sweep, V5-3)

! ====================================================================================
VitEngine.Construct Procedure()
ask  &VitEnginePlainAsk
  code
  self.tk   &= new VitTokenize
  self.syms &= new VitSymbols
  ask &= new VitEnginePlainAsk                  ! the isPlain() guard asks this engine, through it
  ask.eng &= SELF
  self.plainAsk &= ask
  self.rw   &= new VitRewrite
  self.tmr  &= new VitTimer
  self.rl   &= NULL
  self.maxPasses  = 20
  self.progressFn = 'VitTransform.progress.txt' ! real (stamped) name is built in Init - the driver cannot set self.stamp before the global's CONSTRUCT runs
  self.pp        &= NULL                        ! allocated only if SetupIncludes is called
  self.exptk     &= NULL
  self.ppLineMap &= NULL
  self.ppSrc     &= NULL
  self.useIncludes = 0
  self.recvMode = rm:check                      ! DEFAULT: see --receiver=
  self.stMeth &= new StringTheory
  self.syms.stMeth &= self.stMeth               ! a class that adds methods to StringTheory and overrides none is one
  self.urData &= new StringTheory
  self.urEsc &= new StringTheory
  self.lmNames &= new StringTheory
  self.kwUpper &= new StringTheory
  self.kwLower &= new StringTheory
  self.outSuffix &= new StringTheory
  self.bannerUsing &= new StringTheory
  self.kwTitle &= new StringTheory
  self.dgPure &= new StringTheory
  self.KnownRangePureList(self.dgPure)          ! THE BASE LIST ONLY. A rule file's PURE(...) additions are not here, so this refuses slightly more than KnownRanges does - the safe direction for a walk that DELETES a guard.
  ! EVERY ENTRY IS DELIMITED AT BOTH ENDS, and the extraction is CASE-BLIND. The lookup
  ! is instring(' NAME ', table), so the LAST entry needs a trailing space or it can never
  ! match - _SWITCHENDIAN was unmatchable and read as foreign. And StringTheory.inc spells
  ! two prototypes `procedure` and `PROCEDURE` rather than `Procedure`, so a case-sensitive
  ! extraction missed FormatHTML and IsTime. Each of those three made --receiver=check
  ! REFUSE a call it should have converted, which is the one thing check is supposed never
  ! to do.
  self.stMeth.append(' ABBREVIATE ADDBOM ADDLINE ADJUSTLENGTH AFTER AFTERLAST AFTERNTH ALL ANSITOUTF16 ')
  self.stMeth.append(' ANSITOUTF8 APIANSITOUTF8 APIUTF8TOANSI APPEND APPENDA APPENDBINARY ASNDECODE ASNENCODE ')
  self.stMeth.append(' ASNENCODENUMBER ASSIGN BASE32DECODE BASE32ENCODE BASE64DECODE BASE64ENCODE BASE85DECODE ')
  self.stMeth.append(' BASE85ENCODE BASETODEC BEFORE BEFORELAST BEFORENTH BETWEEN BIGENDIAN BYTETOHEX CAPACITY ')
  self.stMeth.append(' CAPITALIZE CAT CATADDR CHANGEBASE CHARS CHARTODECENTITY CLARIONTOUNIXDATE CLEANFILENAME ')
  self.stMeth.append(' CLIP CLIPLEN CLIPLENGTH COLORFROMHEX COLORTOHEX COLORTOLONG CONSTRUCT CONTAINSA ')
  self.stMeth.append(' CONTAINSADIGIT CONTAINSBYTE CONTAINSCHAR CONVERTANSITOOEM CONVERTOEMTOANSI CONVERTTABS ')
  self.stMeth.append(' COUNT COUNTBYTE COUNTWORDS CREATEDATEPICTURE CREATEHEXPICTURE CREATEKEYINPICTURE ')
  self.stMeth.append(' CREATENUMERICPICTURE CREATEPATTERNPICTURE CREATEPICTURE CREATESCIENTIFICPICTURE ')
  self.stMeth.append(' CREATESTRINGPICTURE CREATETIMEHOURSPICTURE CREATETIMEPICTURE CREATEUNIXTIMESTAMPPICTURE ')
  self.stMeth.append(' CROP CSVDECODE CSVENCODE DATEFROMWEEK DECENTITYTOCHAR DECODEHEXINLINE DECTOBASE ')
  self.stMeth.append(' DEFORMATDATE DEFORMATDATEDATE DEFORMATDATETEXT DEFORMATDATEWORKER DEFORMATHEX ')
  self.stMeth.append(' DEFORMATNUMBER DEFORMATPATTERN DEFORMATSCIENTIFIC DEFORMATTIME DEFORMATTIMEHOURS ')
  self.stMeth.append(' DEFORMATUNIXTIMESTAMP DEFORMATVALUE DELETELINE DESTRUCT ENCLOSE ENCODEDWORDDECODE ')
  self.stMeth.append(' ENCODEDWORDENCODE ENDSWITH EQUALS ERRORTRAP EXTENSIONONLY FILENAMEONLY FILESIZE FILTER ')
  self.stMeth.append(' FINDBETWEEN FINDBETWEENPOSITION FINDBYTE FINDCHAR FINDCHARS FINDCHARSADDR ')
  self.stMeth.append(' FINDENDOFSTRING FINDLAST FINDMATCH FINDMATCHPOSITION FINDNTH FINDWORD ')
  self.stMeth.append(' FLEXPOLYLINEDECODE FLUSH FLUSHANDKEEP FORMATDATE FORMATDATEWORKER FORMATHEX FORMATHTML ')
  self.stMeth.append(' FORMATMESSAGE FORMATNUMBER FORMATPATTERN FORMATTIME FORMATTIMEHOURS FORMATUNIXTIMESTAMP ')
  self.stMeth.append(' FORMATVALUE FREE FREELINES FROMBLOB FROMBYTES FROMHEX GETADDRESS GETBUFFERLENGTH ')
  self.stMeth.append(' GETBYTES GETCODEPAGEFROMCHARSET GETELAPSEDTIMEUTC GETLINE GETLINES GETVAL GETVALUE ')
  self.stMeth.append(' GETVALUEPTR GETWORD GUIDDECODE GUIDENCODE GUNZIP GZIP HEXTOBYTE HEXTOSTRING ')
  self.stMeth.append(' HTMLENTITYTODEC INLINE INSERT INSERTEVERY INSTRING INTERPRETDATEPICTURE ')
  self.stMeth.append(' INTERPRETHEXPICTURE INTERPRETKEYINPICTURE INTERPRETNUMERICPICTURE ')
  self.stMeth.append(' INTERPRETPATTERNPICTURE INTERPRETPICTURE INTERPRETSCIENTIFICPICTURE ')
  self.stMeth.append(' INTERPRETSTRINGPICTURE INTERPRETTIMEHOURSPICTURE INTERPRETTIMEPICTURE ')
  self.stMeth.append(' INTERPRETUNIXTIMESTAMPPICTURE ISALL ISALLDIGITS ISALLLOWER ISALLUPPER ISASCII ISDIGIT ')
  self.stMeth.append(' ISEMPTY ISLOWER ISTIME ISUPPER ISVALIDUTF8 JOIN JSONDECODE JSONENCODE KEEPCHARRANGES ')
  self.stMeth.append(' KEEPCHARS LEFT LEN LENGTH LENGTHA LINEENDINGS LITTLEENDIAN LOADFILE LOADLIBS ')
  self.stMeth.append(' LOADNORMALIZE LONGDIVISION LONGTOHEX LOWER MAKEGUID MAKEGUID4 MAKEGUID7 MATCH ')
  self.stMeth.append(' MATCHBRACKETS MD5 MERGEXML NORMALIZE NOSTREAM PARSEDATEPICTURE PARSEHEXPICTURE ')
  self.stMeth.append(' PARSEKEYINPICTURE PARSENUMERICPICTURE PARSEPATTERNPICTURE PARSEPICTURE ')
  self.stMeth.append(' PARSESCIENTIFICPICTURE PARSESTRINGPICTURE PARSETIMEHOURSPICTURE PARSETIMEPICTURE ')
  self.stMeth.append(' PARSEUNIXTIMESTAMPPICTURE PATHONLY PEEKRAM PREPEND QUOTE QUOTEDPRINTABLEDECODE ')
  self.stMeth.append(' QUOTEDPRINTABLEENCODE RANDOM RECORDS RELEASESPARECAPACITY REMOVE REMOVEATTRIBUTES ')
  self.stMeth.append(' REMOVEBYTE REMOVEBYTERANGE REMOVECHARRANGES REMOVECHARS REMOVEFROMPOSITION REMOVEHTML ')
  self.stMeth.append(' REMOVELEADING REMOVELINES REMOVEXMLPREFIXES REPLACE REPLACEBETWEEN REPLACEBYTE ')
  self.stMeth.append(' REPLACEEXCEPTBETWEEN REPLACELAST REPLACENTH REPLACESINGLECHARS REPLACESLICE ')
  self.stMeth.append(' RESERVECAPACITY REVERSE REVERSEBYTEORDER RIGHT SAVEFILE SAVEFILEA SEEDRANDOM ')
  self.stMeth.append(' SERIALIZEGROUP SERIALIZEQUEUE SETAFTER SETAFTERLAST SETAFTERNTH SETALL SETBEFORE ')
  self.stMeth.append(' SETBEFORELAST SETBEFORENTH SETBETWEEN SETBYTES SETDEFORMATVALUE SETENCODINGFROMBOM ')
  self.stMeth.append(' SETFORMATVALUE SETLEFT SETLENGTH SETLINE SETLINEFROMVALUE SETRANDOM SETRIGHT SETSLICE ')
  self.stMeth.append(' SETVALUE SETVALUEBYADDRESS SETVALUEBYCSTRINGADDRESS SETVALUEFROMLINE SLICE SORT ')
  self.stMeth.append(' SPARECAPACITY SPLIT SPLITBETWEEN SPLITBYMATCH SPLITEVERY SPLITINTOWORDS SQUEEZE START ')
  self.stMeth.append(' STARTSWITH STR STRCPY STREAM STRINGTOHEX SUB SWAP SWITCHENDIAN TAIL TOANSI TOBLOB ')
  self.stMeth.append(' TOBYTES TOCSTRING TOHEX TOP TOUNICODE TRACE TRACEHEX TRANSLATE TRIM UNIXTOCLARIONDATE ')
  self.stMeth.append(' UNIXTOCLARIONTIME UNQUOTE UPPER URLDECODE URLENCODE URLFILEONLY URLHOSTONLY ')
  self.stMeth.append(' URLPARAMETER URLPARAMETERSONLY URLPATHONLY URLPORTONLY URLPROTOCOLONLY UTCDATE UTCNOW ')
  self.stMeth.append(' UTCTIME UTF16TO8 UTF16TOANSI UTF16TOUTF8CHAR UTF8TO16 UTF8TOANSI WEEK WORDEND WORDSTART ')
  self.stMeth.append(' WRAPTEXT XMLDECODE XMLENCODE ZEROXDECODE ZEROXENCODE _BLOCK _BLOCKBOUND _COLORFROMCSL ')
  self.stMeth.append(' _COLORFROMHEX _COLORTOHEX _EQUALSUNICODE _GETNEXTBUFFERSIZE _IANANAMETONUMBER _MALLOC ')
  self.stMeth.append(' _MEMCHRS _MEMICHR _MEMICHRS _PROCESSCHARRANGES _REMOVEMATCHINGCHARS ')
  self.stMeth.append(' _REPLACEMATCHINGCHARS _SETVALUEPOINTER _STEALVALUE _SWITCHENDIAN ')
  self.acRoutQ   &= new RoutSpanQType           !
  self.tsProven  &= new TsProvenQType           !
  self.acDotQ    &= new DotRootQType            !
  self.sums      &= new SumQType                ! procedure summaries
  self.biTime    &= new TimeRowQType            ! --timing breakdowns
  self.doRefs    &= new DoRefQType              ! UnusedRoutines' index
  self.clsDecls  &= new ClsDeclQType            !
  self.ruTime    &= new TimeRowQType            !
  self.acScopeId  = 0

! ------------------------------------------------------------------------------------
VitEngine.Destruct Procedure()
  code
  if not self.plainAsk &= NULL then dispose(self.plainAsk).
  if not self.pp        &= NULL then dispose(self.pp).                            ! include expansion (only ever non-NULL after SetupIncludes)
  if not self.exptk     &= NULL then dispose(self.exptk).
  if not self.ppLineMap &= NULL then dispose(self.ppLineMap).
  if not self.ppSrc     &= NULL then dispose(self.ppSrc).
  if not self.stMeth    &= NULL then dispose(self.stMeth).
  if not self.urData    &= NULL then dispose(self.urData).
  if not self.urEsc     &= NULL then dispose(self.urEsc).
  if not self.lmNames   &= NULL then dispose(self.lmNames).
  if not self.kwUpper   &= NULL then dispose(self.kwUpper).
  if not self.kwLower   &= NULL then dispose(self.kwLower).
  if not self.outSuffix &= NULL then dispose(self.outSuffix).
  if not self.bannerUsing &= NULL then dispose(self.bannerUsing).
  if not self.kwTitle   &= NULL then dispose(self.kwTitle).
  if not self.dgPure    &= NULL then dispose(self.dgPure).
  if not self.acRoutQ &= NULL then free(self.acRoutQ) ; dispose(self.acRoutQ).    !
  if not self.acDotQ &= NULL then free(self.acDotQ) ; dispose(self.acDotQ).       !
  if not self.sums &= NULL then free(self.sums) ; dispose(self.sums).             !
  if not self.biTime &= NULL then free(self.biTime) ; dispose(self.biTime).       !
  if not self.doRefs &= NULL then free(self.doRefs) ; dispose(self.doRefs).       !
  if not self.clsDecls &= NULL then free(self.clsDecls) ; dispose(self.clsDecls). !
  if not self.ruTime &= NULL then free(self.ruTime) ; dispose(self.ruTime).       !
  if not self.planQ &= NULL then free(self.planQ) ; dispose(self.planQ).          !
  if not self.tsProven &= NULL then free(self.tsProven) ; dispose(self.tsProven). !
  dispose(self.tmr)
  dispose(self.rw)
  dispose(self.syms)
  dispose(self.tk)

! ------------------------------------------------------------------------------------
VitEngine.Init Procedure(VitRules pRl)
  code
  self.progressFn = 'VitTransform' & clip(self.stamp) & '.progress.txt' ! stamped heartbeat (driver sets stamp before Init) - the Construct-time build always got a blank stamp
  self.rl &= pRl
  self.totalChanges = 0
  self.filesChanged = 0
  self.filesDone    = 0
  self.saveErrors   = 0
  self.loadErrors   = 0
  self.ppErrors     = 0
  self.ppNotes      = 0

! ------------------------------------------------------------------------------------
! enable cross-file type resolution. The Preprocessor splices every INCLUDE
! (resolved through the .red table) into an expanded source; we tokenize that and
! feed it to VitSymbols.BuildTypeRegistry so self.* receivers resolve against real
! headers (DriverClass.Inc etc.). Opt-in: callers that never invoke this keep the
! original in-file-only behaviour with no preprocessor overhead.
! PERF: the expanded source is the full ABC/StringTheory/NetTalk include tree;
! per-file tokenisation of it is the dominant cost, and that is accepted here. If a large run
! is slow, the optimisation to reach for is header-registry caching keyed off the line map.
VitEngine.SetupIncludes Procedure(STRING pRedPath, STRING pRootDir, STRING pConfig, <STRING pDefines>)
  code
  self.redPath = pRedPath
  self.rootDir = pRootDir
  self.config  = choose(pConfig = '', 'Release', pConfig)
  self.ppDefines = choose(omitted(pDefines), '', pDefines)
  if self.pp &= NULL
    self.pp        &= new Preprocessor
    self.exptk     &= new VitTokenize
    self.ppLineMap &= new LineMapQueue
    self.ppSrc     &= new StringTheory
  end
  self.useIncludes = 1
  return 1

! ------------------------------------------------------------------------------------

! ------------------------------------------------------------------------------------
! ApplyCmtSetting - set ONE alignment field from a <name>=<value>. Used by a profile SETTINGS
! line and by the workbench; the command-line switches set the same fields in vitTransform's
! own switch parser, so a new setting is added in BOTH places. Returns 1 on success; 0 with
! pErr set on an unknown name or a bad value. The names are the CLI switches without the --.
! ------------------------------------------------------------------------------------
VitEngine.ApplyCmtSetting Procedure(STRING pKey, STRING pVal, *STRING pErr)
k   STRING(20),AUTO
v   STRING(32),AUTO
n   LONG,AUTO
  code
  pErr = ''
  k = lower(pKey)
  v = lower(pVal)
  ! A NUMBER MUST BE A NUMBER. Clarion stores a non-numeric string into a LONG as 0
  !   without a word, so cmtrun=ten would be a window of nothing; the rule-file lint
  !   refuses it first, and this is the second line of defence for a body that reached
  !   here another way. Nor may it be longer than nine digits: a LONG cannot hold every ten-digit
  !   number, and the command line refuses the same value (vitTransform's NumArg)
  case k
  of   'cmtgap'  orof 'cmtlimit' orof 'cmtslack' orof 'cmtoutlier' orof 'decloutlier'
  orof 'cmtwrap' orof 'cmtsplit' orof 'cmtreach' orof 'cmtinner'   orof 'cmtrun'      orof 'width'
    if len(clip(pVal)) > 9
      pErr = clip(pKey) & '=' & clip(pVal) & ' is too long - nine digits at most' ; return 0
    end
    loop n = 1 to len(clip(pVal))
      case val(pVal[n])
      of 48 to 57              ! '0' to '9'
      else
        pErr = clip(pKey) & '=' & clip(pVal) & ' is not a number' ; return 0
      end
    end
  end
  ! A GAP OF 0 IS REFUSED HERE AS --cmtgap=0 IS ON THE COMMAND LINE: it would join the comment to
  ! the code. A profile and the command line take the same values.
  if k = 'cmtgap' and pVal = 0
    pErr = 'cmtgap must be 1 or more' ; return 0
  end
  case k
  of 'cmtgap'      ; self.cmtGap       = pVal
  of 'cmtlimit'    ; self.alignLimit   = pVal
  of 'cmtslack'    ; self.alignSlack   = pVal
  of 'cmtoutlier'  ; self.alignOutlier = pVal
  of 'decloutlier' ; self.declOutlier  = pVal
  of 'cmtwrap'     ; self.cmtWrap      = pVal
  of 'cmtsplit'    ; self.cmtSplit     = pVal
  of 'cmtreach'    ; self.cmtReach     = pVal
  of 'cmtinner'    ; self.cmtInner     = pVal
  of 'cmtrun'      ; self.cmtRun       = pVal
  of 'width'
    n = pVal
    if ~n
      self.widthArg = -1       ! width=0 = never split
    elsif n < 40
      pErr = 'width must be 0 (never split) or at least 40' ; return 0
    else
      self.widthArg = n
    end
  of 'cmtfloor'
    case v
    of 'near'      ; self.cmtFloor = 0
    of 'commented' ; self.cmtFloor = 1
    of 'all'       ; self.cmtFloor = 2
    else           ; pErr = 'cmtfloor must be near, commented or all' ; return 0
    end
  of 'contindent'
    case v
    of 'indent'  ; self.contBracket = 0
    of 'bracket' ; self.contBracket = 1
    else         ; pErr = 'contindent must be indent or bracket' ; return 0
    end
  of 'cmtkeep'
    case v
    of 'off'     ; self.cmtKeep = 0
    of 'aligned' ; self.cmtKeep = 1
    else         ; pErr = 'cmtkeep must be off or aligned' ; return 0
    end
  of 'ignoremarks'
    case v
    of 'off' ; self.ignoreMarks = 0
    of 'on'  ; self.ignoreMarks = 1
    else     ; pErr = 'ignoremarks must be on or off' ; return 0
    end
  of 'cmtop'
    case v
    of 'code' ; self.cmtOpBar = 0
    of 'bar'  ; self.cmtOpBar = 1
    else      ; pErr = 'cmtop must be code or bar' ; return 0
    end
  of 'cmtend'
    case v
    of 'take'  ; self.cmtEndCount = 0
    of 'count' ; self.cmtEndCount = 1
    else       ; pErr = 'cmtend must be take or count' ; return 0
    end
  of 'cmtcont'
    case v
    of 'indent' ; self.cmtContNone = 0
    of 'none'   ; self.cmtContNone = 1
    else        ; pErr = 'cmtcont must be indent or none' ; return 0
    end
  of 'cmtbar'
    case v
    of 'bar'     ; self.cmtBarCmt = 0
    of 'comment' ; self.cmtBarCmt = 1
    else         ; pErr = 'cmtbar must be bar or comment' ; return 0
    end
  else
    pErr = 'unknown alignment setting: ' & pKey
    return 0
  end
  return 1

! ------------------------------------------------------------------------------------
! Hand the ENGINE's alignment settings to the TOKENIZER, which is where the three aligners
! and the comment wrapper read them from. BOTH entry points call this: TransformFile and
! TransformText have to agree about these or the preview stops matching a batch run, and a
! list written out twice does not stay in step by hand.
! TWO settings are not here, and both entry points set them themselves, in the same place.
! contBracket is read by SplitWideLines, which runs before the alignment block and so before
! this call. cmtSplitOnly is a mode chosen by whichever of --cmtwrap= and --cmtsplit= is in
! force, so it is set beside the WrapComments call it governs, either way, every time.
! Anything else a tokenizer pass reads from the engine belongs in this list.
!
! It is not only about switches. The engine is a static object, so the initial values in its
! declaration reach its fields; the tokenizer is NEW'd, where an initial value never arrives,
! so its own Construct repeats them by hand. This call is what makes the engine's answer the
! one that counts, whether it came from a switch, from a profile SETTINGS line, or from the
! shipped default.
! ------------------------------------------------------------------------------------
VitEngine.ApplyAlignToTokenizer Procedure()
  code
  if self.acDiag                               ! --acdiag needs the tokenizer's own
    self.tk.acDiag = 1                         !   log file switched on, because TraceIt is
    self.tk.logIt  = 1                         !   the only channel AlignComments has.
  end
  self.tk.cmtGap        = self.cmtGap          ! --cmtgap=<n>; starts at 1, the shipped spacing, and the switch refuses 0.
  self.tk.alignLimit    = self.alignLimit      ! --cmtlimit=<n>
  self.tk.alignSlack    = self.alignSlack      ! --cmtslack=<n>
  self.tk.alignOutlier  = self.alignOutlier    ! --cmtoutlier=<n>
  self.tk.declOutlier   = self.declOutlier     ! --decloutlier=<n>
  self.tk.cmtReach      = self.cmtReach        ! --cmtreach=<n>
  self.tk.cmtInner      = self.cmtInner        ! --cmtinner=<n>
  self.tk.cmtFloor      = self.cmtFloor        ! --cmtfloor=
  self.tk.cmtKeep       = self.cmtKeep         ! --cmtkeep=
  self.tk.cmtOpBar      = self.cmtOpBar        ! --cmtop=
  self.tk.cmtEndCount   = self.cmtEndCount     ! --cmtend=
  self.tk.cmtBarCmt     = self.cmtBarCmt       ! --cmtbar=comment
  self.tk.cmtContNone   = self.cmtContNone     ! --cmtcont=
  self.tk.cmtRun        = self.cmtRun          ! --cmtrun=<n>

VitEngine.TransformFile Procedure(STRING pFn, StringTheory pLog)
src          StringTheory
fileChanges  long,AUTO
passChanges  long,auto
pass         long,auto
dbg          StringTheory ! scratch for _List (which free()s its target)
txaFn        StringTheory ! scratch for the extension test below
hintI        long,auto    ! the no-extension hint: the walk back to the last path separator
hintP        long,auto    !   and where the file name's dot was, 0 = none
unSt         StringTheory ! builds the "declaration not visible" name list,
unMsg        StringTheory !   and the line it goes on
  code
  self.tmr.Start()
  self.tRules = 0 ; self.nRules = 0 ; self.tBuiltins = 0 ; self.nBuiltins = 0 ; self.tReparse = 0 ; self.nReparse = 0 ! --timing counters, per file
  self.rw.m.tRefresh = 0 ; self.rw.m.nRefresh = 0 ; self.tk.tLineNums = 0 ; self.tk.nLineNums = 0 ; self.syms.tBuild = 0 ; self.syms.nBuild = 0
  self.rw.m.tPatch = 0 ; self.rw.m.nPatch = 0 ; self.rw.m.postPatched = 0 ; self.rw.m.postMiss = 0 ; self.rw.m.patchable = 0
  free(self.biTime) ; free(self.ruTime)
  ! A FILE THAT IS THERE AND HOLDS NOTHING IS EMPTY, NOT UNREADABLE - the answer ruled on 30 Oct
  ! 2026 for an empty include or redirection file, and a source is no different: the compiler
  ! reads it as nothing at all. LoadFile answers false for a file of zero bytes with no Windows
  ! error, and also for a name that is not there, which EXISTS tells apart. Such a file goes to
  ! the empty-file line below, and the run is not failed for it.
  if not src.LoadFile(pFn) and (src.winErrorCode or ~exists(clip(pFn)))
    ! A source that was ASKED FOR and not transformed is a failed run, so it is counted and the
    ! caller's ERRORLEVEL says so: the commonest cause is an unquoted path with a space,
    ! where COMMAND() hands us the first fragment as the whole name - and reporting success for
    ! that is how a watched sweep transforms nothing and nobody notices. A name with no '.' in
    ! its last element is exactly that shape, so it gets told.
    self.loadErrors += 1
    pLog.append('ERROR could not load ' & clip(pFn) & ' : ' & src.LastError & '<13,10>')
    hintP = 0                                                                            ! a dot in the FILE NAME, not anywhere in the path:
    loop hintI = len(clip(pFn)) to 1 by -1                                               !   C:\v1.2\MySource has one and no extension
      if pFn[hintI] = '\' or pFn[hintI] = '/' then break.
      if pFn[hintI] = '.' then hintP = hintI.
    end
    if ~hintP
      pLog.append('      (no extension - if the path contains a SPACE, quote it: "My Source\a.clw")<13,10>')
    end
    return 0
  end
  if ~src._DataEnd
    pLog.append(clip(pFn) & ': empty file, skipped<13,10>')
    return 0
  end
  self.filesDone += 1
  ! Output is always CRLF: JoinToks emits it and that is what is written. An LF-only
  ! source is not valid Clarion, so one that arrives comes back normalised to CRLF, which
  ! is the more useful answer than faithfully preserving something invalid.
  ! ---- .txa: wrap it so the tokenizer sees Clarion. TxaPreProcess says what and why.
  !      The extension is the whole test - a template export is not source, and telling it
  !      apart by content would cost a scan to learn what the filename already says.
  self.isTxa   = choose(upper(txaFn.ExtensionOnly(clip(pFn))) = 'TXA')
  self.txaSaid = 0
  if self.isTxa
    self.TxaPreProcess(src)
    pLog.append(clip(pFn) & ': TXA - pre-processed for parsing. UnusedVars, UnusedAssignments and'     & |
                ' AutoCheck are RESTRICTED on a template export to procedures and routines contained'  & |
                ' WHOLLY inside one embed: the code the template generates is not in the file, so for' & |
                ' anything spanning embed points neither "never used" nor "always set before read"'    & |
                ' can be decided from what is here. UnusedRoutines annotates rather than commenting'   & |
                ' out, and UnreachableCode never walks past an embed boundary, for the same reason.<13,10>')
  end
  self.WidthPolicy(src)                                                                  ! width limit; it was made a method so the preview shares it
  self.curFile   = pFn
  self.sawAlign  = 0
  free(self.tsProven)                                                                    ! proofs are per FILE, never carried between files

  pLog.append('=== ' & clip(pFn) & ' ===<13,10>')
  self.Progress('parsing')
  self.tk.ParseText(src)
  self.rulesDirty = 0                                                                    ! fresh parse - the previous FILE's pending hazard is not this file's debt
  ! expand includes ONCE per file, tokenise the .red-expanded superset, and point the symbol
  ! table at it. VitSymbols.Build then sources the type registry from this stream on EVERY (re)build -
  ! including the resymbol that follows each rewrite - so cross-file header types survive the whole pass.
  if self.useIncludes and not self.pp &= NULL
    self.Progress('expanding includes')
    self.pp.Init(pFn, clip(self.redPath), clip(self.rootDir), clip(self.config), clip(self.ppDefines))
    self.ppSrc.free()
    if self.pp.Process(src, self.ppSrc, self.ppLineMap)                                  ! PROC: non-zero = preprocessor errors (still expands what it can)
      ! A HEADER THAT DID NOT RESOLVE IS AN ERROR, NOT A WARNING, AND IT HAS TO REACH THE
      ! EXIT CODE. Include expansion exists to build the cross-file type registry, and the
      ! typed metavars in a rule file are resolved against it. A missing header leaves that
      ! registry incomplete, so every typed rule in the run decided against a partial view of
      ! the program - the result is not the one the user asked for even though the run
      ! finished. Counting it here is what lets a calling script tell the two apart.
      if self.softIncludes                                                               ! NOBODY ASKED FOR THE INCLUDES in a run with no switch:
        self.ppNotes += 1                                                                !   they were read because a Clarion was there, so one
      else                                                                               !   that could not be found is a note on the report and
        self.ppErrors += 1                                                               !   the run ends as it would have without them
      end
      pLog.append(clip(pFn) & ': some includes could not be read - a rule that needs a type declared in one of ' & |
                  'them left those places alone:<13,10>' & self.pp.GetErrors() & '<13,10>')
    end
    self.Progress('tokenising expanded (' & self.ppSrc.Length() & ' bytes)')
    self.exptk.ParseText(self.ppSrc)
    self.syms.expTk    &= self.exptk                                                     ! persistent: Build reads it on resymbol
    self.syms.hdrBuilt  = 0                                                              ! new file's expansion -> rebuild the registry once
    pLog.append(clip(pFn) & ': +includes -> ' & self.ppSrc.Length() & ' expanded byte(s), ' & |
                self.exptk.records() & ' token(s)<13,10>')
    do ExpLevelFingerprint                                                               ! '+'/'-' census of the expanded stream (context-drift detector)
    if self.verbose                                                                      ! full EXPANDED-stream dump (level+type+text per token) -
      dbg.free()                                                                         !   diffing two contexts' dumps names the exact tokens whose
      self.exptk._List(dbg, 1)                                                           !   stamps drift (NB _List free()s its target first)
      pLog.append('--- exptk tokens ---<13,10>' & dbg.getValue() & '<13,10>')
    end
  else
    self.syms.expTk    &= NULL                                                           ! B0 path: in-file registry only
    self.syms.hdrBuilt  = 0
  end
  self.Progress('building symbols (' & self.tk.records() & ' tokens)')
  self.syms.traceReg = self.verbose                                                      ! registry decision trace under --verbose
  self.syms.Build(self.tk)                                                               ! scopes/symbols from raw self.tk; registry from expTk when set
  if self.syms.regEofDepth or self.syms.regEofStack                                      ! ALWAYS-ON health line - the registry desync signature
    pLog.append('WARNING type-registry scan ended unbalanced: depth ' & self.syms.regEofDepth & ', owner stack ' |
       & self.syms.regEofStack & ' (registry may be polluted - run --verbose for the trace)<13,10>')
  end
  if self.verbose and self.syms.traceReg and self.syms.regTrace._DataEnd
    pLog.append(self.syms.regTrace)
  end
  ! The version line, and nothing else - the one thing a report needs to say about itself
  ! is which VitTransform wrote it. Keep it to that: a report is read by a user deciding
  ! whether to accept a diff, and anything else here is noise to them.
  !
  ! THE BUILD NUMBER EARNS ITS PLACE, though, small and in brackets. A FAILED Clarion build
  ! leaves the PREVIOUS exe on disk and the gate then runs it and passes - the report is the
  ! only thing that says which engine actually produced these numbers. Bump vr:buildNo every
  ! gated round; `grep -o "VitTransform [0-9.]* (build [0-9]*)"` over the newest report is how
  ! you tell.
  pLog.append('VitTransform ' & vr:version & ' (build ' & vr:buildNo & ')<13,10>')
  pLog.append(clip(pFn) & ': symtab ' & records(self.syms.scopes) & ' scope(s), '                         & |
              records(self.syms.syms) & ' symbol(s), ' & records(self.syms.types) & ' type(s), '          & |
              records(self.syms.fields) & ' field(s), ' & records(self.syms.methods) & ' method(s) over ' & |
              self.tk.records() & ' token(s)<13,10>')                                                       ! diagnostic: a declaration-dense file reporting few scopes/symbols has a VitSymbols.Build desync
                                                                                                            !   (typed rules silently no-op); type/field counts are the Design-B registry (0 types on a class-defining file
                                                                                                            !   = registry miss; 0 methods on a class-including --root run = prototype scan miss)
  if self.verbose
    self.tk._List(dbg, 1)                                                                ! RAW TOKENS (text + type) - to see whether member chains like self.Direct are recombined into one token
    pLog.append('--- tokens ---<13,10>' & dbg.getValue() & '<13,10>')
    self.syms._List(dbg)                                                                 ! scopes + symbols (SELF / locals) - _List free()s dbg, so dump to a scratch then append
    pLog.append(dbg)
    self.syms._ListTypes(pLog)                                                           ! Design B: full type registry
  end
  self.rw.Init(self.rl, self.tk)
  self.rw.SetSymbols(self.syms)
  self.rw.m.plainAsk &= self.plainAsk
  self.rw.m.loose   = self.loose
  self.rw.m.verbose = self.verbose
  if self.verbose
    self.rw.m.vlog &= pLog
  else
    self.rw.m.vlog &= NULL
  end

  fileChanges = 0
  loop pass = 1 to self.maxPasses
    self.curPass = pass
    passChanges = self.RunPass(pLog)
    fileChanges += passChanges
    if ~passChanges then break.
    if pass = self.maxPasses
      pLog.append('WARNING ' & clip(pFn) & ' did not converge after ' & self.maxPasses & ' passes<13,10>')
    end
  end

  ! ---- the DEFERRED pass. A FINAL group's rules were inert for every pass
  !      above; now they get exactly one, on the converged text. This is for a transform whose
  !      OUTPUT the analyses cannot read - the choose return form holds valuePtr, which
  !      SpaceKeepUse refuses by design, and is neither of the two spellings SmProveSpaceless
  !      accepts. Run during convergence it destroyed the summary parser.MaskSigBase depends
  !      on, and the result silently went backwards. Deferring is better than teaching each
  !      recogniser the new shape: nothing runs afterwards, so nothing has to understand it.
  !      ONE pass, not a fixpoint - deferred rules do not cascade into each other. If that is
  !      ever wanted it should be an explicit second fixpoint, not an accident.
  !      BEFORE AlignComments, so comment columns settle on the genuinely final text.
  ! DO NOT gate this on `if fileChanges and ~self.dryRun`, the shape used by the
  ! AlignComments gate eight lines below. That is correct there, because that pass is
  ! COSMETIC; it is wrong for a SEMANTIC one. It would leave a file whose only applicable
  ! transform is a FINAL rule untouched entirely, and make --dry-run under-report.
  ! Both matter on a plain no-switch run: DEFAULTSTYLE selects st-getvalue-slice, which is
  ! declared FINAL. The pass is a no-op when no FINAL group is selected, so it is safe to
  ! run unconditionally; dry-run still writes nothing, it just counts honestly.
  self.rl.deferPhase = 1
  self.Progress('deferred (FINAL) rules')
  passChanges = self.RunPass(pLog)
  self.rl.deferPhase = 0
  fileChanges += passChanges

  ! ---- THE COSMETIC STAGES MUST NOT NEED A RULE CHANGE FIRST.
  !      Gate them on `fileChanges` and, on a file the rules have nothing to say about -
  !      already-transformed source, or a run whose whole point is layout - the splitter,
  !      both aligners and the trailing-whitespace clip can never run at all: the tool
  !      reports `0 change(s)` and writes nothing. Seen on a 13,415-line file, every rule
  !      evaluated in 4 seconds and nothing done.
  !      A file whose only defect is trailing whitespace IS rewritten - deliberate, and the
  !      intent of a layout-only run.
  !      Each stage returns what it did and that counts as a change, so the report is honest and
  !      WriteOutput below still only fires when something actually happened. They run under
  !      --dry-run too, so a dry run's count matches what a real run would do.
  self.tk.contBracket = self.contBracket                                                 ! --contindent=: SplitWideLines runs BELOW, long before the alignment block, so this cannot be set with the other cosmetic settings
  if self.splitWidth > 0
    self.Progress('split wide lines')
    if self.tk.SplitWideLines(self.splitWidth)                                           ! flattened-wide lines, broken at a sensible point
      self.tk.SetLineNumbers()                                                           !   new line breaks -> restamp before anything reads lineNo
      fileChanges += 1
    end
  end
  if self.sawAlign
    self.Progress('align comments')
    self.ApplyAlignToTokenizer()                                                         ! the aligners read the TOKENIZER's copies, and the preview calls the same one
    if self.tk.AlignCaseLabels(self.splitWidth) then fileChanges += 1.                   ! CASE label columns. Both of these change
    if self.tk.AlignDeclTypes(self.splitWidth) then fileChanges += 1.                    !   where code SITS, so they run BEFORE comment columns are measured. declaration types.
    if self.tk.AlignComments(self.splitWidth) then fileChanges += 1.                     ! '!' and '|' settle in one shared column
    if self.cmtWrap                                                                      ! --cmtwrap=<n>: split and join trailing
      self.tk.cmtSplitOnly = 0                                                           !   comments to that width. SET EITHER WAY: it
      if self.tk.WrapComments(self.cmtWrap) then fileChanges += 1.                       !   is a MODE, so one left set stays set. After the
    elsif self.cmtSplit                                                                  ! --cmtsplit=<n>: cut only, never join
      self.tk.cmtSplitOnly = 1
      if self.tk.WrapComments(self.cmtSplit) then fileChanges += 1.
    end                                                                                  !   columns, before the trailing-space clip
  end
  if self.tk.ClipLines() then fileChanges += 1.                                          ! trailing spaces/tabs. LAST, so nothing re-introduces any.
  if fileChanges
    self.filesChanged += 1
    self.totalChanges += fileChanges
    if ~self.dryRun
      self.WriteOutput(pFn, pLog)
    end
  end
  self.Progress('done (' & fileChanges & ' changes)')
  self.tmr.Stop()
  if self.rw.m.rtFallbacks                                                               ! header-derived table bypassed - measure how often the
    pLog.append(clip(pFn) & ': rettype fallback x ' & self.rw.m.rtFallbacks &            |                        !   old six-name list still carries bindings (retirement data)
                ' (receiver class not in the type registry - header truth unavailable)<13,10>')
    self.rw.m.rtFallbacks = 0
  end
  ! What the registry's remaining scope blindness costs, as a number rather than an
  ! argument. Two procedures that each declare a local QUEUE of the same name contribute their
  ! fields to ONE (owner,name) run, and a run that disagrees has no answer from the run alone.
  ! ResolveMember asks a second question there - which of those rows is declared where the USE
  ! SITE can see it - and answers when exactly one type survives it. The two counters are each
  ! other's CONTROL: `runScoped` is the narrowing arriving, `runClash` is what it still could
  ! not settle, and a zero in either one means nothing without the other beside it.
  if not self.syms &= NULL
    if self.syms.runScoped
      pLog.append(clip(pFn) & ': registry narrowed by scope x ' & self.syms.runScoped &  |
                  ' (a disagreeing field run settled by the use site''s own scope)<13,10>')
      self.syms.runScoped = 0
    end
    if self.syms.runClash
      pLog.append(clip(pFn) & ': scope-blind registry refused x ' & self.syms.runClash & |
                  ' (same-named local types share one field run and the use site cannot tell them apart)<13,10>')
      self.syms.runClash = 0
    end
  end
  do UnresolvedNote                                                                      ! say when typed rules refused because a DECLARATION was not visible - see the routine
  pLog.append(clip(pFn) & ': ' & fileChanges & ' change(s), ' & (self.curPass) & ' pass(es), '   & |
              self.rw.skipCount & ' comment-skip(s), ' & self.rw.widthSkips & ' width-skip(s), ' & |
              clip(self.tmr.Duration())                                                          & |
              choose(self.dryRun and fileChanges, '  [dry-run: not written]', '') & '<13,10>')
  if self.timing                                                                         ! --timing: where the run went, in seconds and calls. The postings
    pLog.append(clip(pFn) & ': timing - rule scans ' & format(self.tRules / 100, @n_9.2)                                            & |   !   rebuilds, renumbers and symbol rebuilds are INSIDE the scans and passes
                's (' & self.nRules & '), built-in passes ' & format(self.tBuiltins / 100, @n_9.2) & 's (' & self.nBuiltins & '), ' & |
                'postings rebuilds ' & format(self.rw.m.tRefresh / 100, @n_9.2) & 's (' & self.rw.m.nRefresh & '), '                & |
                'renumbers ' & format(self.tk.tLineNums / 100, @n_9.2) & 's (' & self.tk.nLineNums & '), '                          & |
                'symbol rebuilds ' & format(self.syms.tBuild / 100, @n_9.2) & 's (' & self.syms.nBuild & '), '                      & |
                're-lexes ' & format(self.tReparse / 100, @n_9.2) & 's (' & self.nReparse & '), '                                   & |
                'postings patches ' & format(self.rw.m.tPatch / 100, @n_9.2) & 's (' & self.rw.m.nPatch & ')<13,10>')
    if self.rw.dispatch
      pLog.append(clip(pFn) & ': dispatch grouped - ' & self.rw.cHits & ' scan(s) answered from the cache, ' & self.rw.cMiss & ' walked, ' & |
                  self.rw.cWalks & ' of those shared, answering for ' & self.rw.cMembers & ' more rule(s)<13,10>')
    end
    self.TimeBreakdown(pFn, pLog)
  end
  if self.rw.m.postCheck                                                                 ! --postcheck: every patch was compared with a full rebuild
    pLog.append(clip(pFn) & ': postings self-check: ' & self.rw.m.postPatched & ' patch(es) verified, ' & self.rw.m.postMiss & ' mismatch(es)' & |
                choose(~self.rw.m.postMiss, '', ' - WRONG PATCH, the rebuild was kept; the output is right, the patch is not') & '<13,10>')
  end
  return fileChanges

! ---- SAY WHEN A TYPED RULE REFUSED BECAUSE A DECLARATION WAS NOT VISIBLE.
!      Until this line existed the run simply did less and said nothing, which is the
!      failure mode this project keeps paying for: a silent refusal reads exactly like
!      "the rule did not apply here". It surfaced on an instring() that would not
!      convert, because self.PPDefines is declared in Preprocessor.inc and nothing had
!      read that file.
!      ONLY UNRESOLVED THINGS ARE COUNTED, never wrongly-typed ones - a rule that wanted
!      a StringTheory and found a LONG behaved correctly and must stay quiet, or this
!      line drowns in noise on every file. The distinction is made in
!      VitMatch.NoteChainUnres, where the two cases are visible.
!      The names are the DISTINCT receivers, capped at six with a count of the rest; the
!      total is every refusal, not every name.
!      THE PHRASE "declaration not visible" IS GREPPED BY run-regression.bat. Reword it
!      there in the same round or the suite reports the diagnostic missing - which it did,
!      loudly and correctly, when this message said "whose declaration is not visible".
UnresolvedNote routine
  data
unN    long
unR    long,auto
unTot  long
unThor byte
  code
  unSt.free()
  if ~self.rw.m.chainUnres then exit.
  if not self.pp &= NULL then unThor = 1. ! pp is non-NULL only once SetupIncludes has run
  if not self.rw.m.chainMissQ &= NULL
    loop unR = 1 to records(self.rw.m.chainMissQ)
      get(self.rw.m.chainMissQ, unR)
      if errorcode() then break.
      if unN >= 6 then break.
      if unN then unSt.append(', ').
      unSt.append(clip(self.rw.m.chainMissQ.recvU))
      unN += 1
    end
    unTot = records(self.rw.m.chainMissQ)
    if unTot > unN
      unSt.append(' and ')
      unSt.append(unTot - unN)
      if unTot >= 40                      ! 40 = the name cap in NoteChainUnres, so at the
        unSt.append('+ more')             !   cap the real total is higher than we can say
      else
        unSt.append(' more')
      end
    end
  end
  ! ONE STEP PER LINE, deliberately. The first cut built this message as a single
  ! multi-line continued expression and it would not compile - the error landed on a '('
  ! INSIDE a string literal, which is the compiler telling you its quote tracking is
  ! already lost somewhere earlier in the continuation. Do not make this clever again.
  unMsg.free()
  unMsg.append(clip(pFn))
  unMsg.append(': ')
  unMsg.append(self.rw.m.chainUnres)
  unMsg.append(' typed match(es) refused on ')
  unMsg.append(unTot)
  if unTot >= 40 then unMsg.append('+').
  unMsg.append(' receiver(s) - declaration not visible: ')
  unMsg.append(unSt)
  if unThor
    unMsg.append(' (the included files were read, so these are not reachable from the .RED either)')
  else
    unMsg.append(' - if any of these are declared in an INCLUDE, try --thorough')
  end
  unMsg.append('<13,10>')
  pLog.append(unMsg)
  self.rw.m.chainUnres = 0
  if not self.rw.m.chainMissQ &= NULL then free(self.rw.m.chainMissQ).

ExpLevelFingerprint routine
  data
fx    long,auto
nPlus long
nMin  long
  code
  ! census of '+'/'-' level marks in the EXPANDED stream. Identical text must give an
  ! identical census - a drift between invocation contexts (virgin vs reused exptk) localises
  ! the registry nondeterminism to the tokenizer; an identical census localises it to the
  ! BuildTypeRegistry scan. Cheap (one pass over the queue), logged only when includes are on.
  loop fx = 1 to records(self.exptk.tokens)
    get(self.exptk.tokens, fx)
    if errorcode() then break.
    case self.exptk.tokens.level
    of '+'
      nPlus += 1
    of '-'
      nMin += 1
    end
  end
  pLog.append(clip(pFn) & ': exptk level census +' & nPlus & ' -' & nMin & choose(nPlus <> nMin, '  [UNBALANCED]', '') & '<13,10>')

! ------------------------------------------------------------------------------------
! S4 live preview (design v01 5b / v02 5d): transform an in-MEMORY text buffer through
! the SAME pipeline as TransformFile - parse -> (optional include expansion) -> symbols
! -> fixpoint over the SELECTED rules -> JoinToks. NEVER writes a file (implicit dry-run).
! pOut receives the transformed text; pLog the per-rule change log (rule N line L: ...)
! the caller mines for changed-line highlighting. Selection is whatever the shared
! resolver last set on self.rl.groups - the preview is the real pipeline with a different
! output pane and cannot diverge from a batch run under the same selection.
! ------------------------------------------------------------------------------------
! ---- the width limit, as a METHOD so both entry points get the same answer.
!      It must NOT be a ROUTINE inside TransformFile with TransformText hard-coding a fixed
!      preview width. That is harmless only while the width merely decides whether to REFUSE
!      a conversion. SplitWideLines uses it too, and then it stops being harmless: the preview
!      splits at the hard-coded width while a batch run splits at the file's own, so a
!      90-char-line file (limit 102) shows unsplit lines in VitStyle and split ones on disk -
!      exactly the preview/batch divergence this design exists to prevent.
VitEngine.WidthPolicy Procedure(StringTheory pSrc)
fx   long,auto
run  long
mxw  long
  code
  ! allowed width = the codebase's own prevailing width plus a few chars,
  ! capped at 200; a file already wider than 200 is respected as-is and never extended.
  ! mxw = longest physical line of the ORIGINAL source (CRs ignored).
  ! --width=N overrides the scan entirely. --width=0 arrives here as -1 and means
  ! NEVER SPLIT - SplitWideLines and the width check are both gated on maxWidth > 0, so a
  ! zero switches the whole width policy off rather than setting an impossible limit.
  ! TWO different questions, and one number cannot answer both.
  !   rw.maxWidth  - the question: "would FLATTENING push this file past its own prevailing
  !                  width?" Derived from the file, and a file already wider than 200 is
  !                  respected as-is, because that check was guarding against EXTENDING lines.
  !   splitWidth   - the splitter's question: "is this line too wide to READ?" That is absolute.
  ! Do NOT share rw.maxWidth with the splitter. It fails on exactly the files that need it most:
  ! a source with one 465-char line gets a limit of 465, so nothing is ever over-wide and
  ! nothing is split.
  self.splitWidth = 240
  if self.widthArg < 0
    self.rw.maxWidth = 0
    self.splitWidth  = 0 ! --width=0 = never split
    return
  end
  if self.widthArg > 0
    self.rw.maxWidth = self.widthArg
    self.splitWidth  = self.widthArg
    return
  end
  loop fx = 1 to pSrc._DataEnd
    case val(pSrc.valuePtr[fx])
    of 10
      if run > mxw then mxw = run.
      run = 0
    of 13
      ! ignore
    else
      run += 1
    end
  end
  if run > mxw then mxw = run.
  if mxw >= 200
    self.rw.maxWidth = mxw
  else
    self.rw.maxWidth = choose(mxw + 12 > 200, 200, mxw + 12)
  end

! ------------------------------------------------------------------------------------
! THE FIXPOINT. Source text in, transformed text out, plus the change log.
!
! It runs passes until a pass changes nothing, capped by maxPasses with a did-not-converge
! warning. Running to a fixpoint rather than once is what lets one rule expose work for
! another, which is also why every rule has to be able to see its own output without
! re-firing on it - a rule that rewrites its own result never converges.
!
! The cosmetic passes are deliberately OUTSIDE this loop, run once after it settles: they
! report zero changes so they cannot drive another pass, and alignment that fed back into the
! fixpoint could not stabilise.
!
! This is the entry point VitStyle's live preview calls, so it must work on a buffer with no
! file behind it. Anything that needs a filename belongs in TransformFile, not here.
! ------------------------------------------------------------------------------------
VitEngine.TransformText Procedure(StringTheory pSrc, StringTheory pOut, StringTheory pLog)
src          StringTheory
fileChanges  long,auto
passChanges  long,auto
pass         long,auto
  code
  pOut.free()
  if ~pSrc._DataEnd                                                    ! passed StringTheory is by-reference (never NULL); just test empty
    pLog.append('(empty source)<13,10>')
    return 0
  end
  src.setValue(pSrc)
  self.WidthPolicy(src)                                                ! the SAME limit a batch run would use
  self.curFile   = '(preview)'
  self.isTxa     = 0                                                   ! .txa-ness is a property of a FILENAME, and a preview buffer has none.
  self.txaSaid   = 0                                                   ! TransformFile sets both per file, so without this reset an embedder that
  self.sawAlign  = 0                                                   ! calls both entry points carries the last FILE's answer into every preview.
  free(self.tsProven)                                                  !
  self.tk.ParseText(src)
  self.rulesDirty = 0                                                  ! fresh parse - a previous run's pending hazard is not this preview's debt
  self.rw.m.chainUnres = 0                                             ! same reasoning as the three resets above - the
  if not self.rw.m.chainMissQ &= NULL then free(self.rw.m.chainMissQ). !   preview has no report to print this on, so clear it or it accumulates across previews and lands on the next FILE's line
  self.tk.MapInit()                                                    ! arm the line map (identity now; MapFold composes it at every renumber)
  if self.useIncludes and not self.pp &= NULL                          ! same header fidelity as a real --root run when configured
    self.pp.Init('(preview)', clip(self.redPath), clip(self.rootDir), clip(self.config), clip(self.ppDefines))
    self.ppSrc.free()
    self.pp.Process(src, self.ppSrc, self.ppLineMap)
    self.exptk.ParseText(self.ppSrc)
    self.syms.expTk    &= self.exptk
  else
    self.syms.expTk    &= NULL
  end
  self.syms.hdrBuilt  = 0
  self.syms.traceReg = 0
  self.syms.Build(self.tk)
  self.rw.Init(self.rl, self.tk)
  self.rw.SetSymbols(self.syms)
  self.rw.m.plainAsk &= self.plainAsk
  self.rw.m.loose   = self.loose
  self.rw.m.verbose = 0
  self.rw.m.vlog   &= NULL
  fileChanges = 0
  loop pass = 1 to self.maxPasses
    self.curPass = pass
    passChanges = self.RunPass(pLog)
    fileChanges += passChanges
    if ~passChanges then break.
    if pass = self.maxPasses
      pLog.append('WARNING preview did not converge after ' & self.maxPasses & ' passes<13,10>')
    end
  end
  ! ---- the stages below are the SAME stages TransformFile runs after its
  !      fixpoint, in the same order, and the two lists have to be kept in step by hand - there
  !      is no shared routine for the STAGES. If a stage is ever added to TransformFile after its
  !      fixpoint, add it here too, or the preview silently stops matching a batch run again.
  !      The alignment SETTINGS are no longer on that hand-kept list: both entry points call
  !      ApplyAlignToTokenizer, which is the only place they are written.
  !      The preview's whole promise is that what VitStyle shows is what a batch run produces.
  !      This procedure must NOT stop at the fixpoint and skip the three stages that
  !      follow it in TransformFile, or the preview UNDER-REPORTS on an ordinary run:
  !        - the deferred FINAL pass. DEFAULTSTYLE selects st-getvalue-slice, which is declared
  !          FINAL, so this is not an edge case - it is every no-switch preview of any file
  !          containing `return st.getValue()`.
  !        - AlignComments and ClipLines, so the preview would show comment columns and
  !          trailing whitespace the written file will not have.
  !      The gating is the SAME in both: sawAlign, and nothing else. A preview has to show what
  !      a batch run would produce, so it cannot gate these differently.
  self.rl.deferPhase = 1
  passChanges = self.RunPass(pLog)
  self.rl.deferPhase = 0
  fileChanges += passChanges
  ! ---- mirrors TransformFile exactly - see the note there. The preview has to show
  !      what a batch run would produce, so it cannot gate these differently.
  self.tk.contBracket = self.contBracket                               ! --contindent=, as in TransformFile: the preview has to show what a real run would do
  if self.splitWidth > 0
    if self.tk.SplitWideLines(self.splitWidth)
      self.tk.SetLineNumbers()
      fileChanges += 1
    end
  end
  if self.sawAlign
    self.ApplyAlignToTokenizer()                                       ! the SAME call TransformFile makes: without it the preview aligned to whatever the tokenizer happened to hold
    if self.tk.AlignCaseLabels(self.splitWidth) then fileChanges += 1.
    if self.tk.AlignDeclTypes(self.splitWidth) then fileChanges += 1.
    if self.tk.AlignComments(self.splitWidth) then fileChanges += 1.
    if self.cmtWrap                                                    ! SET EITHER WAY here too: this is the
      self.tk.cmtSplitOnly = 0                                         !   PREVIEW path, where ONE engine object
      if self.tk.WrapComments(self.cmtWrap) then fileChanges += 1.     !   previews over and over in a session, so
    end                                                                !   a mode left set once stays set
    if self.cmtSplit and ~self.cmtWrap
      self.tk.cmtSplitOnly = 1
      if self.tk.WrapComments(self.cmtSplit) then fileChanges += 1.
    end
  end
  if self.tk.ClipLines() then fileChanges += 1.
  if self.tk.mapOn                                                     ! final compose - a builtin may have edited without a
    self.tk.MapFold()                                                  ! renumber since; after this, lineMap = OUTPUT line -> source line
    self.tk.mapOn = 0                                                  ! disarm: the map data stays for the caller, batch runs never fold
  end
  self.tk.JoinToks(pOut)                                               ! transformed text, format-preserving
  pOut.clip('<32,9>')                                                  ! matches WriteOutput - the last line has no EOL token to carry its tail
  return fileChanges

! ------------------------------------------------------------------------------------
VitEngine.RunPass Procedure(StringTheory pLog)
r           long,auto
sv          long,auto
t0          long,auto ! --timing: clock() at the start of a scan or a built-in pass
dt          long,auto ! --timing: the ticks that one scan or pass took
passChanges long
  code
  ! COUNT SITES, NOT ATTEMPTS. A match refused for an interior comment is refused again on
  ! every later pass - nothing about it changed - so a count kept for the whole file reports
  ! sites x passes: two real sites in a four-pass file came out as eight, and the report says
  ! the number counts skipped matches, so the reader goes looking for six that do not exist.
  ! Zeroing it per pass makes the reported figure the count from the LAST full pass, and by
  ! then the file has settled, so every still-refused site is counted exactly once.
  ! NOT on the deferred pass: that one runs only the FINAL rules, and clearing there would
  ! throw away what the full passes found and report almost nothing.
  if ~self.rl.deferPhase then self.rw.skipCount = 0.
  if self.rw.dispatch then self.BuildPlan().                                            ! grouped dispatch: the rules this pass visits, for the group walk
  loop r = 1 to records(self.rl.rules)
    get(self.rl.rules, r)
    if errorcode() then break.
    ! --only= NAMES ONE RULE (by name or by id), AND NAMING IT IS ASKING FOR IT, so the
    ! group test is skipped for that one rule. GroupActive decides the DEFAULT selection, and
    ! a rule asked for by id is not a default. Every analysis builtin lives inside a group
    ! that ships off, so testing the group first filtered them all out: the run finished
    ! having done nothing and exited 0, which reads exactly like "that rule found nothing in
    ! this file" - the one answer this switch exists to rule out. Trying one analysis on its
    ! own is what --only= is for.
    if self.onlyId
      if self.rl.rules.ruleId <> self.onlyId then cycle.
    elsif ~self.rl.GroupActive(self.rl.rules.groupId)
      cycle                                                                             ! unselected GROUP - rule/builtin inert this run
    end
    if self.skipId and self.rl.rules.ruleId = self.skipId then cycle.                   ! both tests sit BEFORE the builtin branch, so --only= runs one thing: placed after it, --only=<id> would still run
                                                                                        !   every BUILTIN while the README says "run only one rule". This is the switch you reach for to attribute a bad diff,
                                                                                        !   so it must not misattribute. NOTE: a BUILTIN's ruleId is its rule-file LINE NUMBER (ParseBuiltinLine), so it
                                                                                        !   shares a number space with declared rule ids - --only=<n> also keeps a builtin that happens to sit on line n.
    if self.rl.rules.kind = vr:kindBuiltin
      if self.rulesDirty                                                                ! a rule rewrite re-emits tokens WITHOUT
        self.RejoinReparse()                                                            ! level marks, and only a REPARSE restores them - AutoCheck's frame walk convicted
      end                                                                               ! safe vars on the stale stream. Builtins are entitled to a parse-fresh stream.
                                                                                        ! rulesDirty is set only by LEVEL-HAZARD replacements (RepHasLevelKeyword); level-neutral families (clip drops,
                                                                                        !   renames) skip the reparse. Builtins that restructure set wantReparse themselves - that path is unchanged.
                                                                                        ! It is a MEMBER (cleared inside RejoinReparse): as a RunPass local, a hazard rule firing AFTER the last builtin
                                                                                        !   died with the pass and the next pass's builtins - and the deferred FINAL pass - ran on the damaged stream.
      self.Progress('pass ' & self.curPass & ' builtin ' & clip(self.rl.rules.builtinName))
      t0 = clock()
      sv = self.DoBuiltin(r, pLog)
      dt = self.TicksSince(t0) ; self.tBuiltins += dt ; self.nBuiltins += 1
      if self.timing then self.NoteTime(self.biTime, self.rl.rules.builtinName, dt, sv).
      passChanges += sv
      if self.wantReparse
        self.RejoinReparse()
        self.wantReparse = 0
      elsif sv
        self.rw.m.Changed()                                                             ! builtin edited tokens - anchor counts stale
        self.rw.m.patchable = 0                                                         !   and no spans were noted: the full walk, not a patch
        self.syms.dirty = 1                                                             ! rebuild lazily at the next consumer (mirrors VitRewrite)
      end
      cycle
    end
    if self.rl.rules.skip then cycle.                                                   ! the --only/--skip tests are above, before the builtin branch
    self.Progress('pass ' & self.curPass & ' rule ' & self.rl.rules.ruleId & ' (changes so far: ' & passChanges & ')')
    sv = self.rw.changeCount
    t0 = clock()
    self.rw.ApplyRule(r, pLog)
    dt = self.TicksSince(t0) ; self.tRules += dt ; self.nRules += 1
    if self.timing then self.NoteTime(self.ruTime, self.RuleTag(), dt, self.rw.changeCount - sv).
    passChanges += self.rw.changeCount - sv
    if self.rw.changeCount > sv and self.RepHasLevelKeyword() then self.rulesDirty = 1. ! only a replacement carrying a LEVEL-BEARING keyword can damage levels
  end
  return passChanges

! ------------------------------------------------------------------------------------
! Grouped dispatch: the rules this pass will visit, in order, for the group walk to read.
! PassVisits applies the tests RunPass applies to a rule - keep the two in step.
! ------------------------------------------------------------------------------------
VitEngine.BuildPlan Procedure()
r  long,auto
  code
  if self.planQ &= NULL then self.planQ &= new PlanQType.
  free(self.planQ)
  loop r = 1 to records(self.rl.rules)
    if ~self.PassVisits(r) then cycle.
    clear(self.planQ)
    self.planQ.ruleRow = r
    add(self.planQ)
  end
  self.rw.plan &= self.planQ

VitEngine.PassVisits Procedure(LONG pRow)
  code
  get(self.rl.rules, pRow)
  if errorcode() then return 0.
  if self.rl.rules.kind <> vr:kindRule then return 0.
  if self.onlyId
    if self.rl.rules.ruleId <> self.onlyId then return 0.
  elsif ~self.rl.GroupActive(self.rl.rules.groupId)
    return 0
  end
  if self.skipId and self.rl.rules.ruleId = self.skipId then return 0.
  if self.rl.rules.skip then return 0.
  return 1


! ------------------------------------------------------------------------------------
! does the CURRENT rule's replacement contain a level-bearing keyword? Only such
! a replacement can damage the token LEVEL stream (a re-emitted IF/END/... carries no
! mark until reparse). Called only when the rule FIRED; repQ is a handful of tokens.
! ------------------------------------------------------------------------------------
VitEngine.RepHasLevelKeyword Procedure()
t   long,auto
  code
  if self.rl.rules.repQ &= NULL then return 1.                        ! no replacement recorded - stay conservative
  loop t = 1 to records(self.rl.rules.repQ)
    get(self.rl.rules.repQ, t)
    if errorcode() then break.
    if self.rl.rules.repQ.tok &= NULL then cycle.
    case upper(self.rl.rules.repQ.tok)
    of   'IF'    orof 'LOOP'  orof 'CASE' orof 'EXECUTE' orof 'BEGIN' |
    orof 'ELSE'  orof 'ELSIF' orof 'OF'   orof 'OROF'    orof 'END'   |
    orof 'UNTIL' orof 'WHILE'                                         ! post-test spellings carry the LOOP's '-'
      return 1
    end
  end
  ! THE PATTERN SIDE COUNTS TOO. A pattern that CONSUMED a level-bearing
  ! token - an END, an inline '.' terminator, or a structure keyword - removed marks
  ! the stream still needs, and no replacement scan can see that. Scanning only the
  ! replacement let 'y = 1 end ==> y = 2' delete a close with rulesDirty clear; the
  ! dead-code walk then commented LIVE code and the hoist pass moved a statement
  ! across the wrong branch. A '.' row here may be a member dot, which over-reparses
  ! (never under) - metavar rows are skipped, they bind rather than consume.
  if self.rl.rules.patQ &= NULL then return 1.                        ! no pattern recorded - stay conservative
  loop t = 1 to records(self.rl.rules.patQ)
    get(self.rl.rules.patQ, t)
    if errorcode() then break.
    if self.rl.rules.patQ.mvx then cycle.
    if self.rl.rules.patQ.tok &= NULL then cycle.
    if self.rl.rules.patQ.tok = '.' then return 1.
    case upper(self.rl.rules.patQ.tok)
    of   'IF'    orof 'LOOP'  orof 'CASE' orof 'EXECUTE' orof 'BEGIN' |
    orof 'ELSE'  orof 'ELSIF' orof 'OF'   orof 'OROF'    orof 'END'   |
    orof 'UNTIL' orof 'WHILE'                                         ! post-test spellings carry the LOOP's '-'
      return 1
    end
  end
  return 0

! ------------------------------------------------------------------------------------
! THE CASE BELOW IS THE INVENTORY of builtins: trust it over any list written in a
! comment, this one included. The cosmetic passes are deferred - run once after the
! fixpoint has converged, never counted as a fixpoint change - see the DEFERRED pass in
! TransformFile.
! ------------------------------------------------------------------------------------
VitEngine.DoBuiltin Procedure(LONG pRow, StringTheory pLog)
  code
  ! ---- the three whole-file analyses are RESTRICTED on a .txa (the embed rule, strict
  !      form), and SAY SO once. They do NOT refuse wholesale: each one
  !      runs, and the per-scope gate (ScopeFullyEmbedded, applied in AutoEligible for
  !      AutoCheck + UnusedAssignments and in RemoveUnusedPass for UnusedVars) admits
  !      only procedures/routines contained wholly inside one embed - in practice mostly
  !      ROUTINES, since a synthesised procedure header spans template data by
  !      construction. Logged once per file, not once per pass.
  if self.TxaAnalysisRefused(self.rl.rules.builtinName)
    if ~self.txaSaid
      self.txaSaid = 1
      pLog.append('BUILTIN ' & clip(self.rl.rules.builtinName) & ': RESTRICTED on a .txa to'        & |
                  ' procedures/routines wholly inside one embed - the template''s generated code'   & |
                  ' is not in this file, so anything spanning embed points cannot be decided here.' & |
                  ' Run on the generated .clw for full coverage.<13,10>')
    end
  end
  if not self.syms &= NULL then self.syms.EnsureFresh().                  ! builtins access syms.syms DIRECTLY (UnusedVars/AutoCheck row loops) - gate at dispatch
  case upper(self.rl.rules.builtinName)
  of 'ALIGNCOMMENTS'
    self.sawAlign = 1                                                     ! deferred: runs once after convergence (cosmetic)
    return 0
  of 'COMBINEADJACENTLITERALS'
    return self.BuiltinCombineLiterals(pLog)
  of 'REMOVEDOUBLEDBRACKETS'
    return self.BuiltinDoubledBrackets(pLog)
  of 'CHECKCASESTATEMENTS'
    return self.BuiltinCheckCase(pLog)
  of 'CHECKREPLACES'
    return self.BuiltinCheckReplaces(pLog)
  of 'CHECKREMOVES'
    return self.BuiltinCheckRemoves(pLog)
  of 'CHECKSPLITS'
    return self.BuiltinCheckSplits(pLog)
  of 'CHECKINLINE'
    return self.BuiltinCheckInLine(pLog)
  of 'CHECKCAT'
    return self.BuiltinCheckCat(pLog)
  of 'UNUSEDVARS'
    return self.BuiltinUnusedVars(pLog)
  of 'UNUSEDROUTINES'
    return self.BuiltinUnusedRoutines(pLog)
  of 'UNREACHABLECODE'
    return self.BuiltinUnreachableCode(pLog)
  of 'UNUSEDASSIGNMENTS'
    return self.BuiltinUnusedAssignments(pLog)
  of 'AUTOCHECK'
    return self.BuiltinAutoCheck(pLog)
  of 'HOISTCOMMONBRANCHCODE'
    return self.BuiltinHoistCommonBranchCode(pLog)
  of 'MERGEGUARDCHAIN'
    return self.BuiltinMergeGuardChain(pLog)                              ! consecutive single-line IFs setting the same thing
  of 'MERGEADJACENTCASE'
    return self.BuiltinMergeAdjacentCase(pLog)                            ! two tests of one expression, one after the other, become one CASE
  of 'IFCHAINTOCASE'
    return self.BuiltinIfChainToCase(pLog)                                ! `if E = a or E = b ... elsif E = c` -> `case E / of a orof b / of c`
  of 'FIRSTADDISSET'
    return self.BuiltinFirstAddIsSet(pLog)                                ! a first += on a zero-initialised local is an =, and the local goes AUTO
  of 'DIRECTREADEQUALS'
    return self.BuiltinDirectReadEquals(pLog)                             ! a compare with a side read straight from the buffer becomes equals()
  of 'DEADVALUEWRITE'
    return self.BuiltinDeadValueWrite(pLog)                               ! a value written to a StringTheory that nothing reads before the next write goes
  of 'DEADLINESWRITE'
    return self.BuiltinDeadLinesWrite(pLog)                               ! a split whose lines nothing reads before the next split or freeLines
  of 'CHECKDELETEINLOOP'
    return self.BuiltinCheckDeleteInLoop(pLog)                            ! REPORTS ONLY - deleteLine in a forward loop over the same lines
  of 'BYTELOOPTOCALL'
    return self.BuiltinByteLoopToCall(pLog)                               ! a byte-by-byte loop over the value is one call: count, containsChar or findChar
  of 'LINESEARCHTOINLINE'
    return self.BuiltinLineSearchToInLine(pLog)                           ! a loop searching the lines for a value, one line at a time, is one inLine() call
  of 'CHANGEBEFORESPLIT'
    return self.BuiltinChangeBeforeSplit(pLog)                            ! a per-line change in a loop over a split's lines is one change to the value, before the split
  of 'DROPVALUECOPY'
    return self.BuiltinDropValueCopy(pLog)                                ! a scratch that only holds a copy of a value is the value's object
  of 'TAKEOVERVALUE'
    return self.BuiltinTakeOverValue(pLog)                                ! a scratch loaded with a copy of a local nothing mentions again is that local
  of 'ALWAYSTRUETEST'
    return self.BuiltinAlwaysTrueTest(pLog)                               ! an IF on clip() or left() of a number is always true - marked, its own code kept
  of 'HOISTNEUTRALTEST'
    return self.BuiltinHoistNeutralTest(pLog)                             ! a test of the folded value against a literal with no letters moves above the fold
  of 'INLINESINGLEUSE'
    return self.BuiltinInlineSingleUse(pLog)                              ! `v = <expr>` then a statement reading v ONCE -> the expression moves to the read. MOVES CODE: own group, OFF
  of 'LOOPBLANKRECORDS'
    return self.BuiltinLoopBlankRecords(pLog)                             ! a loop that skips a split's blank records -> one clip before the split
  of 'CLIPATSPLIT'
    return self.BuiltinClipAtSplit(pLog)
  of 'DROPLINEBUFFER'
    return self.BuiltinDropLineBuffer(pLog)
  of 'DEADTRIM'
    return self.BuiltinDeadTrim(pLog)                                     ! a trim()/clip() of a line from a lone-space split is commented out
  of 'CUTTOSPLIT'
    return self.BuiltinCutToSplit(pLog)                                   ! a value cut at its first separator is a split: line 1 and the lines after it
  of 'SPLITINPLACE'
    return self.BuiltinSplitInPlace(pLog)                                 ! a scratch copied only to be split is the source split in place, joined back before it is read again
  of 'TRIMATSPLIT'
    return self.BuiltinTrimAtSplit(pLog)                                  ! every line read from a split is trimmed as it is loaded: the split trims them
  of 'MERGEDISJOINTLOCALS'
    return self.BuiltinMergeDisjointLocals(pLog)                          ! two StringTheory locals never in use at once are one
  of 'RESPLITTOLINES'
    return self.BuiltinResplitToLines(pLog)                               ! a joined range of lines split again is those lines: the copy folds into the object
  of 'REPAIRNOTES'
    return self.BuiltinRepairNotes(pLog)                                  ! a note glued onto a comment gets its own '!'
  of 'INCLUDEBRACKETS'
    return self.BuiltinIncludeBrackets(pLog)                              ! an INCLUDE written without brackets is written with them
  of 'CLIPPEDCOMPARE'
    return self.BuiltinClippedCompare(pLog)                               ! two clipped lines compare by length first
  of 'DEADGUARD'
    return self.BuiltinDeadGuard(pLog)
  of 'DEADLEFT'
    return self.BuiltinDeadLeft(pLog)                                     ! left() on a receiver trimmed above, read from character 1
  of 'KNOWNRANGES'
    return self.BuiltinKnownRanges(pLog)                                  ! retire a guard / a choose() that provably cannot go the other way
  of 'TRAILINGSPACES'
    return self.BuiltinTrailingSpaces(pLog)                               ! make "no trailing spaces" true, then retire the code that asks about them
  of 'KEYWORDCASE'
    return self.BuiltinKeywordCase(pLog)
  of 'SPLITSTATEMENTS'
    return self.BuiltinSplitStatements(pLog)
  of 'EXPANDONELINERS'
    return self.BuiltinExpandOneLiners(pLog)
  of 'REJOINWRAPPED'
    return self.BuiltinRejoinWrapped(pLog)
  of 'CHOOSECLIP'
    return self.BuiltinChooseClip(pLog)
  of 'INSTRINGTOST'
    return self.BuiltinInstringToST(pLog)
  of 'INSTRINGLITTOST'
    return self.BuiltinInstringToST(pLog, 1)                              ! the same, for a string literal to search - off by default
  of 'INSTRINGONECHARTOST'
    return self.BuiltinInstringToST(pLog, 2)                              ! the same, for a ONE-character search - on in optimised
  of 'INSTRINGSLICETOST'
    return self.BuiltinInstringSliceToST(pLog)                            ! instring() over a StringTheory's own buffer slice - always on
  of 'BRACKETANDOR'
    return self.BuiltinBracketAndOr(pLog)                                 ! brackets round an AND beside an OR - off by default
  of 'BLOCKENDSTYLE'
    return self.BuiltinBlockEndStyle(pLog)
  of 'CONTOP'
    return self.BuiltinContOp(pLog)                                       ! where the AND/OR/& of a wrapped line sits
  of 'REINDENT'
    return self.BuiltinReindent(pLog)
  else
    if self.curPass = 1
      pLog.append('BUILTIN ' & clip(self.rl.rules.builtinName) & ' is not a builtin this engine knows - skipped<13,10>')
    end
  end
  return 0

! ------------------------------------------------------------------------------------
! The names DoBuiltin dispatches, for a refusal to list. A rule file that names a builtin
! this engine does not have is refused before anything runs (CheckBuiltinNames), and a
! refusal that does not say what the right spellings are only moves the guessing.
! KEEP THIS IN STEP WITH THE CASE IN DoBuiltin: the build's namecheck preflight reads
! both and fails when either holds a name the other does not. A derived engine that adds
! builtins overrides this too, and appends its own names to the parent's.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinNames Procedure()
  code
  return 'AlignComments, AutoCheck, BlockEndStyle, ByteLoopToCall, ChangeBeforeSplit, '       & |
         'AlwaysTrueTest, '                                                                   & |
         'BracketAndOr, '                                                                     & |
         'CheckCaseStatements, CheckCat, CheckDeleteInLoop, CheckInLine, CheckRemoves, '      & |
         'CheckReplaces, CheckSplits, ChooseClip, ClipAtSplit, ClippedCompare, '              & |
         'CombineAdjacentLiterals, ContOp, CutToSplit, DeadGuard, DeadLeft, DeadLinesWrite, ' & |
         'DeadTrim, DeadValueWrite, DropLineBuffer, DropValueCopy, ExpandOneLiners, '         & |
         'DirectReadEquals, '                                                                 & |
         'FirstAddIsSet, HoistCommonBranchCode, HoistNeutralTest, IfChainToCase, '            & |
         'IncludeBrackets, InstringLitToST, InstringOneCharToST, '                            & |
         'InstringSliceToST, '                                                                & |
         'InlineSingleUse, InstringToST, KeywordCase, KnownRanges, LineSearchToInLine, '      & |
         'LoopBlankRecords, MergeAdjacentCase, MergeDisjointLocals, MergeGuardChain, '        & |
         'Reindent, RejoinWrapped, RemoveDoubledBrackets, RepairNotes, ResplitToLines, '      & |
         'SplitInPlace, SplitStatements, TakeOverValue, TrailingSpaces, TrimAtSplit, '        & |
         'UnreachableCode, UnusedAssignments, UnusedRoutines, UnusedVars'

! ------------------------------------------------------------------------------------
! 1 when BuiltinNames carries pName. A builtin name is matched in any case, as DoBuiltin
! matches it. Each name is looked for with its separators on both sides, so a name that
! is the front of a longer one (CheckCat, CheckCaseStatements) is not taken for it.
! ------------------------------------------------------------------------------------
VitEngine.KnownBuiltin Procedure(STRING pName)
  code
  if ~pName then return 0.
  return choose(instring(', ' & upper(clip(left(pName))) & ',', ', ' & upper(self.BuiltinNames()) & ',', 1, 1) > 0)

! ------------------------------------------------------------------------------------
! Every BUILTIN line whose name this engine does not know becomes a rule-file ERROR, on
! that line, before any file is read. Otherwise a misspelt name - or one a later version
! no longer has - does none of the work the line asked for, says so only in the report,
! and the run still finishes 0. Lines in groups that are switched OFF are checked too:
! the misspelling is just as wrong there, and it would be silent on the day the group is
! switched on. A line from a --userrules= file counts against that file's own errors,
! which is how a front end tells a broken user file from a broken shipped one.
! pBad gets one line per refused name, for the caller's message; it is not emptied first.
! ------------------------------------------------------------------------------------
VitEngine.CheckBuiltinNames Procedure(VitRules pRl, StringTheory pBad)
cbX   long,auto
cbN   long
cbUsr byte,auto
  code
  loop cbX = 1 to records(pRl.rules)
    get(pRl.rules, cbX)
    if errorcode() then break.
    if pRl.rules.kind <> vr:kindBuiltin or ~pRl.rules.builtinName then cycle.
    if self.KnownBuiltin(pRl.rules.builtinName) then cycle.
    pRl.AddIssue(pRl.rules.ruleId, vr:sevError, 'BUILTIN ' & clip(pRl.rules.builtinName) & ' is not a builtin this engine knows')
    cbUsr = choose(pRl.rules.ruleId >= vr:userBase)
    if cbUsr then pRl.userErrors += 1.
    pBad.append(choose(pBad._DataEnd = 0, '', '|') & '  line ' & pRl.rules.ruleId - choose(~cbUsr, 0, vr:userBase) & |
                choose(~cbUsr, '', ' of the --userrules= file') & ':  BUILTIN ' & clip(pRl.rules.builtinName))
    cbN += 1
  end
  return cbN

! ------------------------------------------------------------------------------------
! BUILTIN CombineAdjacentLiterals - port of the vtxaDiff009 routine (GCR 27Aug2021).
! Part 1: 'abc' & 'xyz' -> 'abcxyz', repeating along chains ('a' & 'b' & 'c').
!         Not combined when the & or the second literal starts a new line, so
!         continuations and comments are never lost. vtxaDiff checked only the
!         second literal and carried a TODO for the & token; both are checked
!         here - a deliberate deviation from vtxaDiff
!         Not combined either when an arithmetic operator stands on the far side of
!         either literal: ^ * / % + - all bind BEFORE &, so in 'a' & 'b' + x the second
!         literal is an operand of the +, and 'ab' + x would be a different expression.
! Part 2: inside one literal, '<13><10>' -> '<13,10>' when both bracket groups
!         are comma-separated integer lists 0-255 (vtxaDiff 15Oct2023 logic).
! Ported onto locals (vtxaDiff used globals stTmp/param/changes); the inner
! labelled loop is kept from vtxaDiff - labels and labelled
! CYCLE/BREAK are legal inside class methods (cf VitTokenize.FoldStr's L loop).
! Error stops became log lines that advance startTok (vtxaDiff's cycle without
! advancing would have spun forever after the stop).
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCombineLiterals Procedure(StringTheory pLog)
startTok      long(1)
chk           long,auto ! general check variable
pos           long,auto
x             long,auto
oldLen        long,auto
lineNo        long,auto
changes       long
stTmp         StringTheory
param         StringTheory
stB           StringTheory
stT           StringTheory
  code
  loop
    startTok = self.tk.FindSeq('|^  %''| &| %''', startTok)                   ! literal & literal (%' = literal-type wildcard)
    if ~startTok then break.
    chk = 0                                                                   ! an arithmetic operator against either literal: that
    if startTok > 1                                                           !   operator binds first, so the pair is not one operand
      get(self.tk.tokens, startTok - 1)
      if ~errorcode() then chk = choose(self.tk.tokens.type = vt:plusMinus or self.tk.tokens.type = vt:multiplication or self.tk.tokens.type = vt:exponentiation).
    end
    if ~chk
      get(self.tk.tokens, startTok + 3)
      if ~errorcode() then chk = choose(self.tk.tokens.type = vt:plusMinus or self.tk.tokens.type = vt:multiplication or self.tk.tokens.type = vt:exponentiation).
    end
    if chk
      startTok += 1
      cycle
    end
    stTmp.setValue(self.tk.getTok(startTok))
    lineNo = self.tk.tokens.lineNo
    chk = stTmp._DataEnd
    stTmp.UnQuote('''','''')
    if chk = stTmp._DataEnd                                                   ! token typed literal but does not unquote - should not happen
      pLog.append('BUILTIN CombineAdjacentLiterals line ' & self.tk.MapLine(lineNo) & ': unexpected non-literal token, skipped<13,10>')
      startTok += 1
      cycle
    end
    stTmp.freeLines()
    stTmp.setLine(1, stTmp.getValuePtr())                                     ! store first literal's content
    stTmp.setValue(self.tk.getTok(startTok+2))                                ! the token after the &
    chk = stTmp._DataEnd
    stTmp.UnQuote('''','''')
    if chk = stTmp._DataEnd
      pLog.append('BUILTIN CombineAdjacentLiterals line ' & self.tk.MapLine(lineNo) & ': unexpected non-literal token, skipped<13,10>')
      startTok += 1
      cycle
    end
    stTmp.setLine(2, stTmp.getValuePtr())
    self.tk.GetTok(startTok+1, stB, stT)                                      ! the &
    if ~stB.containsByte(10)                                                  ! <line feed>
      self.tk.GetTok(startTok+2, stB, stT)                                    ! the second literal
    end
    if stB.containsByte(10)                                                   ! & or literal on a continuation line - do NOT combine <line feed>
      startTok += 1
      cycle
    end
    stTmp.join('')                                                            ! recombine the two stored lines
    stTmp.enclose('''', '''')                                                 ! the outer quotes, always: quote() leaves a text that already begins and ends with a quote as it is
    self.tk.SetTok(startTok, stTmp.valuePtr[1 : stTmp._DataEnd])
    self.tk.DeleteToks(startTok+1, startTok+2)                                ! the & and the second literal (both glue-checked: no trivia lost)
    pLog.append('BUILTIN CombineAdjacentLiterals line ' & self.tk.MapLine(lineNo) & ': ==> ' & stTmp.getValue() & '<13,10>')
    changes += 1
  end                                                                         ! loop

  ! within a single literal change <13><10> style runs to <13,10> - only when both
  ! sides of the >< are comma-separated integer lists with every value 0-255
  startTok = 0
  loop
    startTok = self.tk.FindSeq('|^  %''', startTok+1)                         ! any literal
    if ~startTok then break.
    stTmp.setValue(self.tk.getTok(startTok))
    lineNo = self.tk.tokens.lineNo
    oldLen = stTmp._DataEnd
    pos = 0
L   loop
      pos += 1
      pos = stTmp.findchars('><<', pos)
      if ~pos then break.
      if pos+2 <= stTmp._DataEnd and stTmp.valuePtr[pos+2] = '<<' then cycle. ! doubled << = literal < char (a sub(pos+2)='<' test here would be a rest-of-string compare AND an un-doubled literal; vtxaDiff 2683)
      ! check <xxx> on the left
      chk = stTmp.instring('<<',-1,1,pos-1)
      if ~chk or                                                              |
         chk > 1 and stTmp.valuePtr[chk-1] = '<<'                             ! doubled << = literal < char (same fix as above; vtxaDiff 2687)
        cycle
      end
      param.setvalue(stTmp.slice(chk+1,pos-1))                                ! part between < and >
      if param._DataEnd < 1 then cycle.
      if not param.isAll('0123456789, ') then cycle.
      param.split(',',,,,st:clip,st:left)
      loop x = 1 to param.records()
        param.setValueFromLine(x)
        if not param.IsAllDigits() or param.getValue() > 255 then cycle L.
      end
      ! check <xxx> on the right
      chk = stTmp.findByte(62, pos+2)                                         ! '>'
      if ~chk then cycle.
      param.setvalue(stTmp.slice(pos+2,chk-1))                                ! part between < and >
      if param._DataEnd < 1 then cycle.
      if not param.isAll('0123456789, ') then cycle.
      param.split(',',,,,st:clip,st:left)
      loop x = 1 to param.records()
        param.setValueFromLine(x)
        if not param.IsAllDigits() or param.getValue() > 255 then cycle L.
      end
      ! all ok - replace '><' with ','
      stTmp.removeFromPosition(pos,1)
      stTmp.valueptr[pos] = ','
    end                                                                       ! loop
    if stTmp._DataEnd <> oldLen                                               ! were changes made? (>< to comma reduces size)
      self.tk.SetTok(startTok, stTmp.valuePtr[1 : stTmp._DataEnd])
      pLog.append('BUILTIN CombineAdjacentLiterals line ' & self.tk.MapLine(lineNo) & ': ==> ' & stTmp.getValue() & '<13,10>')
      changes += 1
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! BUILTIN CheckCaseStatements - port of TWO vtxaDiff009 routines under one name:
! checkCaseStatements (GCR 5Dec2023: case 'x' -> case val('x') when every
! of/orof/to operand at case level is a single char, at least one non-digit)
! and checkVals (GCR 20Sep2023: val(chr(x)) -> x, then val('x') -> integer
! everywhere, one generated end-of-line comment per line via a scratch
! tokenizer - '<tab> orof ''x''' style in case context, '120=''x''' otherwise).
! vtxaDiff runs them back-to-back; the rule file names only CheckCaseStatements
! so both live here. Level-mismatch stop()s became log lines (the case is then
! skipped via cycle P); the labelled P loop / 'cycle P' is kept from vtxaDiff;
! GetTok('') guards added (vtxaDiff sliced blind).
! A val after a '.' - Lookup.Val('x') - is that object's own method, not the runtime's VAL,
! and is left as written, in the code and in the generated comment.
! A bare digit beside quoted arms is a NUMBER, compared as one: a CASE with `of 0`, or with a
! range from a digit to a quoted character, is left alone (NumArm). A val( ) wrapped over a '|'
! is left alone too: the comment after the bar would go with the brackets.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckCase Procedure(StringTheory pLog)
startTok       long
endTok         long,auto
endBracket     long,auto
x              long,auto
allSingle      long,auto
numArm         byte
lev            long,auto
lineNo         long,auto
changes        long
prevValLineNo  long
cmtStartTok    long,auto
hdrEol         long,auto          ! EOL token of the CASE header line
cmtLastTok     long,auto
! #Removed as not used: cmtEB          long,auto    ! comment end bracket
cmtCaseFormat  byte,auto          ! case statement context -> name format, else int='x' format
selS           long,auto          ! selector span start/end (SelGuard)
selE           long,auto
selOk          byte               ! selector provably single-char
nlInsideCall   byte,auto          ! pass 2a: a line break inside val(chr(x)) - refused once the shape is proved
xTU            STRING(vs:maxName) ! pass 2a: the type of the x in val(chr(x))
xRf            byte
param          StringTheory
comment        StringTheory
cmtTk          VitTokenize        ! scratch tokenizer for building the comment
  code
  ! --- pass 1: case 'x' -> case val('x') (vtxaDiff checkCaseStatements) ---
P loop
    startTok = self.tk.FindSeq(',^  ^case', startTok+1)
    if ~startTok then break.
    if lower(self.tk.getTok(startTok+1)) = 'val' then cycle.                             ! already: case val('x')
    self.tk.GetTok(startTok)                                                             ! reget case (positions the queue for MatchLevel)
    endTok = self.tk.MatchLevel()                                                        ! find matching 'end'
    if ~endTok then cycle.                                                               ! no 'end' found for case statement

    ! between startTok and endTok every case-level of/orof/to operand must be a
    ! single char, and at least one must be a non-digit (a bare digit case could
    ! be a genuine numeric CASE on a long/byte)
    allSingle = false ; numArm = 0
    lev = 1
    loop x = startTok + 1 to endTok - 1
      get(self.tk.tokens, x)
      if errorcode() or self.tk.tokens.tok &= NULL then break.
      case val(self.tk.tokens.level)
      of 43                                                                              ! '+'
        lev += 1
        cycle
      of 45                                                                              ! '-'
        if ~lev
          pLog.append('BUILTIN CheckCaseStatements: mismatched level (end) at token ' & x & ' line ' & self.tk.MapLine(self.tk.tokens.lineNo) & ' - case skipped<13,10>')
          cycle P
        else
          lev -= 1
        end
        cycle
      end
      if lev > 1 then cycle.                                                             ! skip nested case/if levels
      ! A RANGE of characters follows the run-time collating sequence (CLACOLSEQ): under one, 'A' to 'Z'
      ! takes 'b' as well, and 65 to 90 never does - so under --colseq=custom a CASE with a range keeps its
      ! strings. The standard order is the character codes' own, and there the two are the same
      if self.colSeqCustom and lower(self.tk.tokens.tok) = 'to' then cycle P.

      case lower(self.tk.tokens.tok)
      of 'of' orof 'orof' orof 'to'
        ! *** THE OPERAND HAS TO END HERE. *** This wraps ONE token in val(), so an operand
        ! that is an expression had only its first token wrapped: `of 'a' & pad` came back as
        ! `val('a') & pad`, then `97 & pad` - a different comparison, and one that still
        ! compiles. The operand ends at an EOL, a ';', or the next arm of the same CASE.
        if ~self.IsEolTok(x+2)                                                           |
           and self.tk.GetTok(x+2) <> ';'                                                |
           and lower(self.tk.GetTok(x+2)) <> 'orof'                                      |
           and lower(self.tk.GetTok(x+2)) <> 'to'
          cycle P                                                                        ! the operand is an EXPRESSION - refuse the whole CASE:
        end                                                                              !   the wrap loop below wraps every arm unconditionally, so skipping just this arm converted of 'b' & pad to of 98 & pad
        x += 1
        param.setValue(self.tk.GetTok(x))
        if ~self.IsSingleChar(param.getValue()) then cycle P.
        do NumArm
        if param._DataEnd > 1
          allSingle = true                                                               ! at least one quoted/escaped char (not a bare digit)
        end
      end
    end
    if ~allSingle then cycle.

    hdrEol = startTok + 1                                                                ! a continued CASE header ('case foo |') would take the ')' into continuation trivia (invisible to the compiler) and desync endTok
    loop while hdrEol < endTok
      get(self.tk.tokens, hdrEol)
      if errorcode() then break.
      if not self.tk.tokens.tok &= NULL
        if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
      end
      hdrEol += 1
    end
    if self.SpanHasNL(startTok + 1, hdrEol - 1) then cycle.                              ! EXCLUDE the EOL token itself - SpanHasNL counts it as a newline, so including it skipped EVERY multi-line
                                                                                         !   CASE (a real continuation's LF lives in an EARLIER token's strBefore, still inside the span)

    ! SELECTOR guard: val() reads only the FIRST char, so the selector itself must be
    ! provably single-char - the operand test alone is not enough (vtxaDiff 982
    ! comment "do NOT use val() as token may be > 1 char"; and its 2321 "case param.getLine(1)"
    ! with quoted-digit operands would have treated crop(10) as crop(1) once converted).
    ! Provable forms: quoted literal passing IsSingleChar, single-index slice x[i] (a string
    ! char pick), or a variable declared STRING(1) via the symbol table. Anything
    ! else - function calls, bare vars of other/unknown type - is SKIPPED and logged.
    ! deliberate safe-direction deviation: vtxaDiff wraps these blind.
    selS = startTok + 1
    selE = hdrEol - 1
    do SelGuard
    if ~selOk
      if self.curPass = 1                                                                ! the site re-refuses every pass - log once
        pLog.append('BUILTIN CheckCaseStatements: case skipped (selector not provably 1-char) line ' & self.LogLineOf(startTok) & '<13,10>')
      end
      cycle
    end
    if numArm then do NumRefused ; cycle.

    ! all values single chars: wrap the case expression in val(...)
    self.tk.InsertStringAtEOL(startTok+1, ')', 3)                                        ! mode 3: real token, ';'/'THEN' count as EOL
    self.tk.addTok(startTok+2, self.tk.GetTok(startTok+1))                               ! move expression start over (no strBefore)
    self.tk.SetTok(startTok+1, 'val')                                                    ! keeps the existing strBefore
    get(self.tk.tokens, startTok+1)                                                      ! a glued source "case(" has an EMPTY
    if ~errorcode() and self.tk.tokens.strBefore &= NULL                                 !   strBefore, so 'val' would emit as
      self.tk.SetStrBefore(startTok+1, ' ')                                              !   "caseval(" - force one space
    end
    self.tk.addTok(startTok+2, '(')
    startTok += 2
    endTok += 3

    ! and wrap each of/orof/to operand in val() - pass 2 converts to integers
    lev = 1
    loop x = startTok + 1 to endTok - 1
      get(self.tk.tokens, x)
      if errorcode() or self.tk.tokens.tok &= NULL then break.
      case val(self.tk.tokens.level)
      of 43                                                                              ! '+'
        lev += 1
        cycle
      of 45                                                                              ! '-'
        if ~lev
          pLog.append('BUILTIN CheckCaseStatements: mismatched level (end) at token ' & x & ' line ' & self.tk.MapLine(self.tk.tokens.lineNo) & '<13,10>')
        else
          lev -= 1
        end
        cycle
      end
      if lev > 1 then cycle.

      case lower(self.tk.tokens.tok)
      of 'of' orof 'orof' orof 'to'
        self.tk.addTok(x+2, ')')
        if len(self.tk.GetTok(x+1)) = 1
          self.tk.addTok(x+2, '''' & self.tk.GetTok(x+1) & '''')                         ! quote a bare digit so pass 2 treats it as a char
        else
          self.tk.addTok(x+2, self.tk.GetTok(x+1))
        end
        self.tk.addTok(x+2, '(')
        self.tk.setTok(x+1, 'val')                                                       ! keeps spacing before
        endTok += 3
        x += 4
        changes += 1
      end
    end
  end

  ! --- pass 2a: val(chr(whatever)) -> whatever (vtxaDiff checkVals) ---
  startTok = 0
  loop
    startTok = self.tk.FindSeq(',^  ^val, (, ^chr, (', startTok+1)
    if ~startTok then break.
    if self.tk.GetTok(startTok - 1) = '.' then cycle.                                    ! obj.Val(...) is the object's own METHOD, not the runtime's VAL
    endBracket = self.tk.MatchLeftBracket('(',')',startTok+1)
    if self.tk.getTok(endBracket-1) <> ')' then cycle.                                   ! expect )) as in val(chr(xxx))
    if endBracket <> startTok + 6 then cycle.                                            ! ONE token inside chr(...) - the same arity guard pass 2b applies: dropping the
                                                                                         !   parens from val(chr(i + 1)) * 2 leaves i + 1 * 2, different arithmetic
    nlInsideCall = self.SpanHasNL(startTok + 1, endBracket)                              ! a '|' inside: the comment after the bar would be lost
    ! val(chr(x)) IS x ONLY FOR ONE BYTE: chr() keeps the low byte, so val(chr(300)) is 44, and a
    ! REAL arrives truncated. x must be an integer literal from 0 to 255, or a BYTE variable.
    get(self.tk.tokens, startTok + 4)
    if errorcode() then cycle.
    if self.tk.tokens.type = vt:Integer
      param.setValue(self.tk.getTok(startTok + 4))
      if ~param.IsAllDigits() or param._DataEnd > 3 then cycle.
      if param.getValue() > 255 then cycle.
    else
      if self.syms &= NULL then cycle.
      if ~self.syms.Lookup(self.tk.getTok(startTok + 4), startTok + 4, xTU, xRf) then cycle.
      if upper(xTU) <> 'BYTE' or xRf then cycle.
    end
    if nlInsideCall then do BarRefused ; cycle.
    self.tk.DeleteToks(endBracket-1, endBracket)
    self.tk.setTok(startTok, self.tk.getTok(startTok+4))                                 ! keeps spacing before
    self.tk.DeleteToks(startTok+1, startTok+4)
    changes += 1
  end

  ! --- pass 2b: val('x') -> integer, with one generated comment per line ---
  startTok = 0
  loop
    startTok = self.tk.FindSeq(',^  ^val, (', startTok+1)
    if ~startTok then break.
    if self.tk.GetTok(startTok - 1) = '.' then cycle.                                    ! obj.Val('x') is the object's own METHOD, not the runtime's VAL
    endBracket = self.tk.MatchLeftBracket('(',')',startTok+1)
    if endBracket <> startTok+3 then cycle.                                              ! want exactly val(tok)
    param.setValue(self.tk.GetTok(startTok+2))
    if ~self.IsSingleChar(param.getValue()) then cycle.
    if self.SpanHasNL(startTok + 1, endBracket) then do BarRefused ; cycle.              ! a '|' inside: the comment after the bar would be lost

    get(self.tk.tokens, startTok)                                                        ! the val token
    lineNo = self.tk.tokens.lineNo
    if lineNo <> prevValLineNo                                                           ! first val() on this line: build the line's comment
      prevValLineNo = lineNo
      self.tk.joinToks(comment, startTok, -1)                                            ! -1 = to end of current line, comments excluded
      comment.trim()
      if comment.instring(' orof ',,,,st:noCase) or comment.instring(' to ',,,,st:noCase) or |
         lower(self.tk.GetTok(startTok-1)) = 'of' or lower(self.tk.GetTok(startTok-1)) = 'orof'
        cmtCaseFormat = true
      else
        cmtCaseFormat = false
      end
      cmtTk.ParseText(comment)
      cmtStartTok = 0
      cmtLastTok = 0
      loop
        cmtStartTok = cmtTk.FindSeq(',^  ^val, (', cmtStartTok+1)
        if ~cmtStartTok then break.
        if cmtTk.GetTok(cmtStartTok - 1) = '.' then cycle.
        if cmtTk.MatchLeftBracket('(',')',cmtStartTok+1) <> cmtStartTok+3 then cycle.
        comment.setValue(cmtTk.GetTok(cmtStartTok+2))
        if ~comment._DataEnd or                                                          |
           comment.valuePtr[1] <> '''' or comment.valuePtr[comment._DataEnd] <> ''''
          cycle
        end
        if comment._DataEnd = 3 and ~cmtCaseFormat                                       ! plain context: 120='x'
          cmtTk.setTok(cmtStartTok, val(comment.valuePtr[2]) & '=' & comment.getValue())
        else                                                                             ! case context / escape form: pretty name
          cmtTk.setTok(cmtStartTok, self.CharName(comment.getValue()))
        end
        cmtLastTok = cmtStartTok
        cmtTk.deleteToks(cmtStartTok+1, cmtStartTok+3)                                   ! ('x')
      end
      if cmtLastTok
        cmtTk.joinToks(comment, 1, cmtLastTok)                                           ! up to the last val() replacement
        self.tk.InsertStringAtEOL(endBracket+1, comment.getValue(), 2)                   ! mode 2: comment, prepended
      end
      cmtTk.FreeToks()
    end

    case param._DataEnd
    of 1                                                                                 ! bare digit
      self.tk.setTok(startTok, val(param.valuePtr[1]))
    of 3                                                                                 ! 'x'
      self.tk.setTok(startTok, val(param.valuePtr[2]))
    else                                                                                 ! '<13>' / '''' / doubled pairs
      self.tk.setTok(startTok, self.GetSingleCharVal(param.getValue()))
    end
    self.tk.DeleteToks(startTok+1, endBracket)
    changes += 1
  end
  if changes
    pLog.append('BUILTIN CheckCaseStatements: ' & changes & ' change(s)<13,10>')
  end
  return changes

SelGuard routine
  data
hx   long,auto
dep  long,auto
  code
  ! is the selector span [selS,selE] provably ONE character? (see banner at the call site)
  selOk = 0
  dep = 0
  loop hx = selS to selE                              ! a one-liner "case x; of ..." puts the ';' tail in
    case self.tk.getTok(hx)                           !   the header span - the selector ends at the ';'
    of '(' orof '['
      dep += 1
    of ')' orof ']'
      dep -= 1
    of ';'
      if ~dep
        selE = hx - 1
        break
      end
    end
  end
  loop while selS < selE                                      ! unwrap enclosing brackets: case(x) -> x
    if self.tk.getTok(selS) <> '(' then break.
    if self.tk.MatchLeftBracket('(', ')', selS) <> selE then break.
    selS += 1
    selE -= 1
  end
  if selS > selE then exit.
  if selS = selE                                              ! single token
    if self.IsSingleChar(self.tk.GetTok(selS))                ! quoted single-char literal: 'x' / '<13>' / ''''
      selOk = 1
    else
      hx = val(upper(self.tk.getTok(selS)))
      case hx
      of 65 to 90 orof 95                                     ! identifier-shaped: STRING(1) variable?
        do String1Chk
      end
    end
    exit
  end
  ! slice form: <variable token> [ <single index> ] - a single-index pick of a STRING is one
  ! character, so a CASE on it may be compared against single-char literals.
  !
  ! *** UNLESS THE HEAD IS DIM'd, IN WHICH CASE THE PICK IS AN ELEMENT. *** `x STRING(5),DIM(3)`
  ! makes `x[2]` a five-character element, and `x LONG,DIM(3)` makes it a LONG - neither is the
  ! one character this arm is about to assume. The bare-identifier arm below has always tested
  ! for DIM; this one argued from the corpus instead, which is not an argument about
  ! soundness.
  !
  ! The proof is NameSliceOk, and it answers only YES or DON'T KNOW. DON'T KNOW refuses,
  ! because "is it DIM'd" says NO when it cannot find the declaration - which let an array
  ! PARAMETER and a plain-GROUP member through. It reads the LOGICAL declaration, since a
  ! ,DIM(3) may sit past a '|', and it FOLLOWS a LIKE, since LIKE carries no DIM of its own
  ! but inherits the target's.
  if self.tk.getTok(selE) <> ']' then exit.
  if self.tk.getTok(selS+1) <> '[' then exit.
  if self.tk.MatchLeftBracket('[', ']', selS+1) <> selE then exit.
  hx = val(upper(self.tk.getTok(selS)))
  if ~((hx >= 65 and hx <= 90) or hx = 95) then exit. ! head must be a variable token (merged dotted receiver ok)
  dep = 0
  loop hx = selS + 2 to selE - 1                      ! reject a top-level ':' (range slice = substring)
    case self.tk.getTok(hx)                           !   or ',' (2-D element) inside the [ ]
    of '(' orof '['
      dep += 1
    of ')' orof ']'
      dep -= 1
    of ':' orof ','
      if ~dep then exit.
    end
  end
  if self.ValuePtrPick(upper(self.tk.getTok(selS)), startTok)
    selOk = 1                                         ! st.valuePtr[i]: a StringTheory's buffer is a &STRING, never an array
    exit
  end
  if changes then self.syms.dirty = 1.                ! declTok may have shifted this run
  self.syms.EnsureFresh()
  if ~self.NameSliceOk(upper(self.tk.getTok(selS)), startTok) then exit.
  selOk = 1

String1Chk routine
  data
sy     long,auto
scr    long,auto
bestR  long,auto
bestSp long,auto
dTok   long,auto
tw     long,auto
nmU    string(vs:maxName),auto
  code
  ! bare-identifier selector - convert when it is declared STRING(1). The symtab
  ! canonical type drops the size (STRING(20) -> STRING), so find the INNERMOST enclosing
  ! symbol of that name (any type - shadowing must win), then read the size straight off the
  ! declaration tokens at declTok. Token positions may have shifted if this builtin already
  ! wrapped an earlier CASE this run - flag dirty so EnsureFresh re-Builds before we trust
  ! declTok (PrependStrBefore-only builtins never move a position, so they never need this).
  if changes
    self.syms.dirty = 1
  end
  self.syms.EnsureFresh()
  nmU = upper(self.tk.getTok(selS))
  bestR = 0
  bestSp = 0
  loop sy = 1 to records(self.syms.syms)
    get(self.syms.syms, sy)
    if errorcode() then break.
    if self.syms.syms.nameU <> nmU then cycle.
    scr = self.syms.syms.scopeId
    get(self.syms.scopes, scr)
    if errorcode() then cycle.
    if self.syms.scopes.startTok > startTok or self.syms.scopes.endTok < startTok then cycle. ! scope must contain this CASE
    if ~bestR or self.syms.scopes.endTok - self.syms.scopes.startTok < bestSp
      bestR  = sy
      bestSp = self.syms.scopes.endTok - self.syms.scopes.startTok
    end
  end
  if ~bestR then exit.
  get(self.syms.syms, bestR)
  if self.syms.syms.isRef or self.syms.syms.isLike or                                   |   ! &STRING / LIKE: size not provable here
     self.syms.syms.typeU <> 'STRING'
    exit
  end
  dTok = self.syms.syms.declTok
  loop tw = dTok to dTok + 2                                                            ! decl window: <label> STRING ( 1 ) - an unsized
    if upper(self.tk.getTok(tw)) = 'STRING'                                             !   STRING param never matches ( after STRING -> refuse
      if self.tk.getTok(tw+1) = '(' and self.tk.getTok(tw+3) = ')'
        if self.tk.getTok(tw+2) = '1'                                                   |                                                        ! STRING(1)
        or (val(self.tk.getTok(tw+2)) = 39 and self.IsSingleChar(self.tk.getTok(tw+2))) ! STRING('a')/STRING('<161>') - size = literal length = 1. The quote gate
                                                                                        !   (first char = 39) keeps STRING(9) out: IsSingleChar accepts bare digits
          if ~self.DeclHasAttr(dTok, 'DIM')                                             ! a DIM anywhere on it: the bare name is the ARRAY
            selOk = 1
          end
        end
      end
      break
    end
  end

! ---- the operand at x, in param: a bare digit is a NUMBER, and a CASE on a STRING compares
!      with a number as numbers, where a character that is not a digit counts as 0. So `of 0`
!      takes every such character, while val() and the code 48 take only '0'. A digit from 1 to 9
!      matches only itself either way, and so does a range whose two ends are both such digits.
!      A range with a digit at one end and a quoted character at the other mixes the two
!      compares, so that is left alone too. numArm = 1 refuses the CASE.
NumArm routine
  if param.getValue() = '0' then numArm = 1.
  if lower(self.tk.GetTok(x - 1)) <> 'to' then exit.
  if len(self.tk.GetTok(x - 2)) = 1 and param._DataEnd > 1 then numArm = 1.
  if len(self.tk.GetTok(x - 2)) > 1 and param._DataEnd = 1 then numArm = 1.

! ---- a val() of the shape a pass converts, written across lines: the comment or the words after the
!      bar would go with its brackets, so it is left as written, and said once ----
BarRefused routine
  if self.curPass = 1
    pLog.append('BUILTIN CheckCaseStatements: val() left alone line ' & self.LogLineOf(startTok))
    pLog.append(' - it is written across lines, and the change would lose the line break and any words after the bar<13,10>')
  end

NumRefused routine
  if self.curPass = 1
    pLog.append('BUILTIN CheckCaseStatements: case skipped (an arm compares with the number 0, or a range has a number at one end and a character at the other, and a number compares as a number, not as its digit) line ' & |
       self.LogLineOf(startTok) & '<13,10>')
  end

! ------------------------------------------------------------------------------------
! The arguments of a call, one to a line of pOut: the text between the commas that stand
! outside every bracket - ( [ { - in the tokens pS to pE, the ones inside the call's own
! brackets. A comma in a subscript, tbl[i, 1], or in a property, ?List{PROP:Text, 1}, belongs
! to that bracket and not to the call; one inside a string literal is in the literal's token.
! Each line keeps its spacing - the space in front of a comma stays with the argument before
! it - so pOut.join(',') gives back the text as it was written. An empty argument, as in
! (a,,b), is an empty line, and no tokens at all give no lines. pOut's value is left alone.
! ------------------------------------------------------------------------------------
VitEngine.SplitCallArgs Procedure(StringTheory pOut, LONG pS, LONG pE)
a    long,auto
c    long,auto
one  StringTheory
  code
  pOut.freeLines()
  if pS > pE then return.
  a = pS
  loop
    c = self.SpanTopWord(a, pE, ' , ')
    if c
      self.tk.JoinToks(one, a, c - 1)
      get(self.tk.tokens, c)
      if ~errorcode() and not self.tk.tokens.strBefore &= NULL
        one.append(self.tk.tokens.strBefore)
      end
    else
      self.tk.JoinToks(one, a, pE)
    end
    pOut.addLine(one.getValue())
    if ~c then break.
    a = c + 1
  end

! ------------------------------------------------------------------------------------
! BUILTIN CheckReplaces - port of the vtxaDiff009 routine (GCR 9Sep2021,
! byte forms 22Oct2023): drop trailing default args off st.replace(), map
! pNoCase 1 -> st:noCase, then single-char forms to removeByte ('x','') or
! replaceByte ('x','z') with a generated "replace all ..." comment.
! deviation: a call whose argument span crosses a line break is skipped
! (vtxaDiff rejoins the args and would flatten the continuation and lose any
! comment) - a deliberate deviation.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckReplaces Procedure(StringTheory pLog)
startTok     long,auto
endBracket   long
lChanges     long,auto
charVal      long,auto ! LONG not byte: invalid is -1
charVal2     long,auto
lineNo       long,auto
changes      long
param        StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ .,^replace, (', endBracket+1) ! look for .replace(
    if ~startTok then break.
    startTok += 2                                                ! FindSeq returns the '.' - move up to '('
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then endBracket = startTok; cycle.            ! shouldn't happen
    !
    ! *** AND ASK WHAT THE RECEIVER IS. *** This finds its work by METHOD NAME alone, while
    ! every textual rule in the rule file proves the receiver through a typed metavar. So a
    ! same-named method on another class was rewritten by StringTheory's prototype:
    ! `ob.replace('a','')` on a CStringClass came back as `ob.removeByte(97)`, which either
    ! does not compile or, worse, compiles and means something else.
    !
    ! Refuses what it can PROVE is another class. A receiver the symbol table cannot resolve
    ! is decided by --receiver= (RecvIsOtherClass): check, the default, refuses it when any
    ! method called on it in scope is not a StringTheory method; strict refuses it outright;
    ! assume converts it.
    !
    ! *** IT MUST SIT AFTER endBracket ADVANCES. *** Cycling before that leaves FindSeq
    ! searching from the same place, so a refused site is found again on the next turn and
    ! the loop never ends. It hung the transform on the first non-StringTheory receiver.
    if self.RecvIsOtherClass(startTok - 3) then cycle.
    if self.SpanHasNL(startTok+1, endBracket-1) then cycle.      ! keep comments/continuations intact
    get(self.tk.tokens, startTok)
    lineNo = self.tk.tokens.lineNo

    self.tk.JoinToks(param, startTok+1, endBracket-1)
    self.SplitCallArgs(param, startTok+1, endBracket-1)          ! no clip/left: preserve original spacing
    if param.records() > 7 then cycle.                           ! currently 7 parms

    lChanges = 0
    ! NB. no CASE on param.records(): deleteLine changes the count between tests
    if param.records() = 7
      case lower(left(param.getLine(7)))                         ! bool pRecursive
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(7)
      end
    end
    if param.records() > 5
      case lower(left(param.getLine(6)))                         ! long pNoCase=0
      of '1' orof 'true'
        param.setLine(6,'st:noCase')
        lChanges += 1
      of '0' orof 'false' orof ''
        if param.records() = 6                                   ! last parm?
          lChanges += 1
          param.deleteLine(6)
        end
      end
    end
    if param.records() = 5                                       ! last parm?
      case lower(left(param.getLine(5)))                         ! long pEnd=0
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(5)
      end
    end
    if param.records() = 4                                       ! last parm?
      case lower(left(param.getLine(4)))                         ! long pStart=1
      of '1' orof 'true' orof ''
        lChanges += 1
        param.deleteLine(4)
      end
    end
    if param.records() = 3                                       ! last parm?
      case lower(left(param.getLine(3)))                         ! long pCount=0
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(3)
      end
    end

    if param.records() = 2                                       ! removeByte / replaceByte?
      charVal = self.GetSingleCharVal(param.getLine(1))
      if charVal <> -1
        if left(param.getLine(2)) = ''''''                       ! replacing with '' = remove
          self.tk.setTok(startTok - 1, 'removeByte')
          self.tk.setTok(startTok + 1, charVal)
          self.tk.InsertStringAtEOL(endBracket+1, 'remove all ' & self.CharName(param.getLine(1)))
          self.tk.DeleteToks(startTok+2, endBracket-1)
          lChanges += 1
          changes += lChanges
          pLog.append('BUILTIN CheckReplaces line ' & self.tk.MapLine(lineNo) & ': ==> removeByte(' & charVal & ')<13,10>')
          endBracket = startTok+2
          cycle
        end
        charVal2 = self.GetSingleCharVal(param.getLine(2))
        if charVal2 <> -1
          self.tk.setTok(startTok - 1, 'replaceByte')
          self.tk.setTok(startTok + 1, charVal)
          self.tk.setTok(startTok + 3, charVal2)                 ! +2 is the comma
          self.tk.InsertStringAtEOL(endBracket+1, 'replace all ' & self.CharName(param.getLine(1)) & ' with ' & self.CharName(param.getLine(2)))
          self.tk.DeleteToks(startTok+4, endBracket-1)
          lChanges += 1
          changes += lChanges
          pLog.append('BUILTIN CheckReplaces line ' & self.tk.MapLine(lineNo) & ': ==> replaceByte(' & charVal & ',' & charVal2 & ')<13,10>')
          endBracket = startTok+4
          cycle
        end
      end
    end

    if lChanges
      changes += lChanges
      param.join(',')
      self.tk.DeleteToks(startTok+1, endBracket-1)
      self.tk.InsertString(startTok+1, param)
      pLog.append('BUILTIN CheckReplaces line ' & self.tk.MapLine(lineNo) & ': args ==> (' & param.getValue() & ')<13,10>')
      endBracket = startTok+1
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! BUILTIN CheckRemoves - port of the vtxaDiff009 routine (GCR 13Sep2023,
! removeByte 21-22Oct2023). Same shape as CheckReplaces for st.remove():
! drop trailing defaults, pNoCase 1 -> st:noCase, single-char -> removeByte.
! Keeps vtxaDiff's RETURN SELF.remove() guard (ST-internal overloads).
! Same line-break skip deviation as CheckReplaces.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckRemoves Procedure(StringTheory pLog)
startTok     long,auto
endBracket   long
lChanges     long,auto
charVal      long,auto
lineNo       long,auto
changes      long
param        StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ .,^remove, (', endBracket+1) ! look for .remove(
    if ~startTok then break.
    startTok += 2
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then endBracket = startTok; cycle.
    !
    ! *** AND ASK WHAT THE RECEIVER IS *** - the note above CheckReplaces' test covers every Check* builtin;
    ! this test must sit AFTER endBracket advances, or a refused site is found again for ever.
    if self.RecvIsOtherClass(startTok - 3) then cycle.
    if upper(self.tk.getTok(startTok-3)) = 'SELF' and upper(self.tk.getTok(startTok-4)) = 'RETURN' then cycle.
    if self.SpanHasNL(startTok+1, endBracket-1) then cycle.
    get(self.tk.tokens, startTok)
    lineNo = self.tk.tokens.lineNo

    self.tk.JoinToks(param, startTok+1, endBracket-1)
    self.SplitCallArgs(param, startTok+1, endBracket-1)
    if param.records() > 5 then cycle.                          ! currently 5 parms

    lChanges = 0
    if param.records() = 5
      case lower(left(param.getLine(5)))                        ! bool pCount
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(5)
      end
    end
    if param.records() = 4
      case lower(left(param.getLine(4)))                        ! bool pContentsOnly
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(4)
      end
    end
    if param.records() > 2
      case lower(left(param.getLine(3)))                        ! long pNoCase=0
      of '1' orof 'true'
        param.setLine(3,'st:noCase')
        lChanges += 1
      of '0' orof 'false' orof ''
        if param.records() = 3
          lChanges += 1
          param.deleteLine(3)
        end
      end
    end
    if param.records() = 2 and ~param.getLine(2)                ! string pRight
      lChanges += 1
      param.deleteLine(2)
    end

    if param.records() = 1                                      ! removeByte? (single char only)
      charVal = self.GetSingleCharVal(param.getLine(1))
      if charVal <> -1
        self.tk.setTok(startTok - 1, 'removeByte')
        self.tk.setTok(startTok + 1, charVal)
        self.tk.InsertStringAtEOL(endBracket+1, 'remove all ' & self.CharName(param.getLine(1)))
        self.tk.DeleteToks(startTok+2, endBracket-1)
        lChanges += 1
        changes += lChanges
        pLog.append('BUILTIN CheckRemoves line ' & self.tk.MapLine(lineNo) & ': ==> removeByte(' & charVal & ')<13,10>')
        endBracket = startTok+2
        cycle
      end
    end

    if lChanges
      changes += lChanges
      param.join(',')
      self.tk.DeleteToks(startTok+1, endBracket-1)
      self.tk.InsertString(startTok+1, param)
      pLog.append('BUILTIN CheckRemoves line ' & self.tk.MapLine(lineNo) & ': args ==> (' & param.getValue() & ')<13,10>')
      endBracket = startTok+1
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! ------------------------------------------------------------------------------------
! BUILTIN CheckSplits - port of the vtxaDiff009 routine.
! st.split()'s 5th and 6th parameters are booleans in the prototype but
! they have NAMES, and a trailing default is noise:
!     st.split(',', '''', '''', true, true, true)
!  -> st.split(',', '''', '''', true, st:clip, st:left)
!
! Split(pSplitStr, pQuoteStart, pQuoteEnd, pRemoveQuotes, pClip, pLeft, pSeparator, pNested)
!
! THE 4th PARAMETER IS LEFT ALONE ON PURPOSE. vtxaDiff names it st:removeQuotes (GCR
! 5May2025) but that equate exists ONLY IN A PRIVATE StringTheory and never reached the
! CapeSoft release - which this file's own StringTheory.inc confirms: it
! has st:clip, st:left, st:nested and st:noClip, and no st:removeQuotes. Emitting it would
! produce source that does not compile for anyone else. The code is below, commented out,
! ready for the day it ships.
!
! Two refinements kept from the original: a trailing DEFAULT is deleted rather than named,
! and when the split is on a SPACE with no quote arguments, clip and left are redundant -
! the split already discards the run - so they come off again.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckSplits Procedure(StringTheory pLog)
startTok     long,auto
endBracket   long
lChanges     long,auto
lineNo       long,auto
changes      long
param        StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ .,^split, (', endBracket+1) ! look for .split(
    if ~startTok then break.
    startTok += 2                                              ! FindSeq returns the '.' - move up to '('
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then endBracket = startTok; cycle.          ! shouldn't happen
    !
    ! *** AND ASK WHAT THE RECEIVER IS *** - the note above CheckReplaces' test covers every Check* builtin;
    ! this test must sit AFTER endBracket advances, or a refused site is found again for ever.
    if self.RecvIsOtherClass(startTok - 3) then cycle.
    if self.SpanHasNL(startTok+1, endBracket-1) then cycle.    ! keep comments/continuations intact
    get(self.tk.tokens, startTok)
    lineNo = self.tk.tokens.lineNo

    self.tk.JoinToks(param, startTok+1, endBracket-1)
    self.SplitCallArgs(param, startTok+1, endBracket-1)        ! no clip/left: preserve original spacing
    if param.records() < 4 or param.records() > 8 then cycle.  ! currently 8 parms

    lChanges = 0
    ! NB. no CASE on param.records(): deleteLine changes the count between tests
    if param.records() = 8
      case lower(left(param.getLine(8)))                       ! Long pNested=false
      of '0' orof 'false' orof ''
        lChanges += 1
        param.deleteLine(8)
      end
    end
    if param.records() = 7
      case lower(left(param.getLine(7)))                       ! <string pSeparator>
      of '' orof ''''''
        lChanges += 1
        param.deleteLine(7)
      end
    end
    if param.records() > 5
      case lower(left(param.getLine(6)))                       ! bool pLeft=false
      of '1' orof 'true'
        param.setLine(6,'st:left')
        lChanges += 1
      of '0' orof 'false' orof ''
        if param.records() = 6                                 ! last parm?
          lChanges += 1
          param.deleteLine(6)
        end
      end
    end
    ! splitting on a SPACE with no quote args: left is redundant (GCR 2May2025)
    if param.records() > 5 and (param.getLine(1) = ''' ''' or param.getLine(1) = '''<32>''') and ~param.getLine(2)
      if lower(left(param.getLine(6))) = 'st:left'
        if param.records() = 6
          param.deleteLine(6)
        else
          param.setLine(6,'')
        end
        lChanges += 1
      end
    end
    if param.records() > 4
      case lower(left(param.getLine(5)))                       ! bool pClip=false
      of '1' orof 'true'
        param.setLine(5,'st:clip')
        lChanges += 1
      of '0' orof 'false'
        if param.records() = 5                                 ! last parm?
          param.deleteLine(5)
        else
          param.setLine(5,'st:noClip')
        end
        lChanges += 1
      of '' orof 'st:noclip'
        if param.records() = 5                                 ! last parm?
          param.deleteLine(5)
          lChanges += 1
        end
      end
    end
    ! splitting on a SPACE with no quote args: clip is redundant too (GCR 2May2025)
    if param.records() > 4 and (param.getLine(1) = ''' ''' or param.getLine(1) = '''<32>''') and ~param.getLine(2)
      if lower(left(param.getLine(5))) = 'st:clip'
        if param.records() = 5
          param.deleteLine(5)
        else
          param.setLine(5,'st:noClip')
        end
        lChanges += 1
      end
    end
    if param.records() > 3
      case lower(left(param.getLine(4)))                       ! bool pRemoveQuotes=false
!     of '1' orof 'true'                                           ! st:removeQuotes is PRIVATE-ST ONLY - see the header.
!       param.setLine(4,'st:removeQuotes')                         !   Restore these two lines when it ships publicly.
!       lChanges += 1
      of '0' orof 'false' orof ''
        if param.records() = 4                                 ! last parm?
          lChanges += 1
          param.deleteLine(4)
        end
      end
    end
    if param.records() = 3 and ~param.getLine(3)               ! blank last parm?
      lChanges += 1
      param.deleteLine(3)
    end
    if param.records() = 2 and ~param.getLine(2)               ! blank last parm?
      lChanges += 1
      param.deleteLine(2)
    end

    if lChanges
      changes += lChanges
      param.join(',')
      self.tk.DeleteToks(startTok+1, endBracket-1)
      self.tk.InsertString(startTok+1, param)
      pLog.append('BUILTIN CheckSplits line ' & self.tk.MapLine(lineNo) & ': args ==> (' & param.getValue() & ')<13,10>')
      endBracket = startTok+1
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! BUILTIN CheckInLine - port of the vtxaDiff009 routine (GCR 30Oct2023), the twin of
! CheckSplits and missing for the same reason. st.inline()'s 5th to 8th parameters are
! numbers with names:
!     st.inline(x, 1, 0, 0, true, true, 1, true)
!  -> st.inline(x, 1, 0, 0, st:noCase, st:wholeLine, st:begins, st:clip)
!
! pWhere is a THREE-valued parameter, not a boolean: 0 st:anywhere, 1 st:begins,
! 2 st:ends. The seven equates this can emit (st:clip, st:noClip, st:anywhere,
! st:begins, st:ends, st:wholeLine, st:noCase) are all public in StringTheory.inc -
! unlike st:removeQuotes.
!
! No default-deletion here: the original does not do it for inline, and a trailing 0 on
! pWhere means st:anywhere, which is worth SAYING rather than dropping.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckInLine Procedure(StringTheory pLog)
startTok     long,auto
endBracket   long
lChanges     long,auto
lineNo       long,auto
changes      long
param        StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ .,^inline, (', endBracket+1) ! look for .inline(
    if ~startTok then break.
    startTok += 2                                               ! FindSeq returns the '.' - move up to '('
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then endBracket = startTok; cycle.           ! shouldn't happen
    !
    ! *** AND ASK WHAT THE RECEIVER IS *** - the note above CheckReplaces' test covers every Check* builtin;
    ! this test must sit AFTER endBracket advances, or a refused site is found again for ever.
    if self.RecvIsOtherClass(startTok - 3) then cycle.
    if self.SpanHasNL(startTok+1, endBracket-1) then cycle.     ! keep comments/continuations intact
    get(self.tk.tokens, startTok)
    lineNo = self.tk.tokens.lineNo

    self.tk.JoinToks(param, startTok+1, endBracket-1)
    self.SplitCallArgs(param, startTok+1, endBracket-1)         ! no clip/left: preserve original spacing
    if param.records() > 8 then cycle.                          ! currently 8 parms

    lChanges = 0
    if param.records() = 8
      case lower(left(param.getLine(8)))                        ! long pClip
      of '1' orof 'true'
        param.setLine(8,'st:clip')
        lChanges += 1
      of '0' orof 'false'
        param.setLine(8,'st:noClip')
        lChanges += 1
      end
    end
    if param.records() > 6
      case lower(left(param.getLine(7)))                        ! long pWhere - THREE-valued
      of '0' orof 'false'
        param.setLine(7,'st:anywhere')
        lChanges += 1
      of '1' orof 'true'
        param.setLine(7,'st:begins')
        lChanges += 1
      of '2'
        param.setLine(7,'st:ends')
        lChanges += 1
      end
    end
    if param.records() > 5
      case lower(left(param.getLine(6)))                        ! long pWholeLine
      of '1' orof 'true'
        param.setLine(6,'st:wholeLine')
        lChanges += 1
      end
    end
    if param.records() > 4
      case lower(left(param.getLine(5)))                        ! long pNoCase
      of '1' orof 'true'
        param.setLine(5,'st:noCase')
        lChanges += 1
      end
    end

    if lChanges
      changes += lChanges
      param.join(',')
      self.tk.DeleteToks(startTok+1, endBracket-1)
      self.tk.InsertString(startTok+1, param)
      pLog.append('BUILTIN CheckInLine line ' & self.tk.MapLine(lineNo) & ': args ==> (' & param.getValue() & ')<13,10>')
      endBracket = startTok+1
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! BUILTIN CheckCat - port of the vtxaDiff009 routine: st.cat(x) -> st.Append(x) when the argument is clearly a string
! expression (literal, &, slice, clip(, .getValue); st.cat('lit',n) ->
! st.Append('lit') with the literal truncated to n logical chars when n is
! shorter (escape-aware: '' << {{ <13,10> {n}).
! deviations: a non-numeric length argument is skipped (vtxaDiff read it
! as 0 and would truncate the literal to nothing); line-break skip as above.
! A single VARIABLE is converted only when it is proved to be a string (ByteArg):
! Cat takes a BYTE variable as one character, Append would add its number as text.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinCheckCat Procedure(StringTheory pLog)
startTok     long,auto
endBracket   long
litLen       long,auto
wantLen      long,auto
lineNo       long,auto
argN         long,auto
changes      long
catByte      byte
catMoved     byte
param        StringTheory
raw          StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ .,^Cat, (', endBracket+1)                           ! look for .cat(
    if ~startTok then break.
    startTok += 2
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then endBracket = startTok; cycle.
    !
    ! *** AND ASK WHAT THE RECEIVER IS *** - the note above CheckReplaces' test covers every Check* builtin;
    ! this test must sit AFTER endBracket advances, or a refused site is found again for ever.
    if self.RecvIsOtherClass(startTok - 3) then cycle.
    if self.SpanHasNL(startTok+1, endBracket-1) then cycle.
    get(self.tk.tokens, startTok)
    lineNo = self.tk.tokens.lineNo

    self.tk.JoinToks(param, startTok+1, endBracket-1)
    self.SplitCallArgs(param, startTok+1, endBracket-1)
    loop argN = 1 to param.records()
      param.setLine(argN, clip(left(param.getLine(argN))))
    end
    case param.records()
    of 1
      if param.containsByte(39) or param.containsByte(38) or param.containsByte(91) or | ! <single quote> '&' '['
         param.instring('clip(',,,,st:noCase)                                       or |
         param.instring('.getValue',,,,st:noCase)
        do ByteArg
        if catByte then cycle.
        self.tk.SetTok(startTok-1, 'Append')
        pLog.append('BUILTIN CheckCat line ' & self.tk.MapLine(lineNo) & ': cat ==> Append<13,10>')
        changes += 1
      end
    of 2
      raw.setValue(param.getLine(1))
      litLen = self.rw.m.LitLength(raw.getValue())
      if litLen < 0 then cycle.                                                        ! first arg not a quoted literal
      raw.setValue(param.getLine(2))
      if ~raw.IsAllDigits() then cycle.                                                ! length arg not a plain integer - vtxaDiff would truncate to 0
      wantLen = raw.getValue()
      raw.setValue(param.getLine(1))
      changes += 1
      if wantLen < litLen
        self.LitTruncate(raw, wantLen)
        self.tk.SetTok(startTok+1, raw.valuePtr[1 : raw._DataEnd])
      end
      ! if wantLen >= litLen cat caps at the literal anyway: just drop the length
      self.tk.SetTok(startTok-1, 'Append')
      self.tk.DeleteToks(startTok+2, endBracket-1)
      catMoved = 1
      pLog.append('BUILTIN CheckCat line ' & self.tk.MapLine(lineNo) & ': cat ==> Append(' & raw.getValue() & ')<13,10>')
      endBracket -= 2
    end
  end
  return changes

! ---- Is the one argument a single VARIABLE that may be a BYTE? catByte = 1 keeps the cat. ----
! StringTheory's Cat takes a BYTE variable by address and adds the CHARACTER; Append has no such
! form and adds the NUMBER as text, so with codes BYTE,DIM(3) st.cat(codes[1]) adds 'A' and
! st.Append(codes[1]) adds '65'. Only a variable can reach that form - a join, a literal, a call
! or a sum cannot. Brackets round the whole argument are looked through; it is a variable when it
! starts with a name and, outside its subscripts, holds only names and dots. A variable is a
! string when it is a slice s[a : b], one byte of a StringTheory's buffer, or a name declared
! STRING, CSTRING or PSTRING with one subscript or none; any other variable, such as a field after
! a subscript, or a name that does not resolve, is kept.
ByteArg routine
  data
bx   long,auto
bS   long,auto
bE   long,auto
bDep long,auto
bLst long,auto
bCol byte,auto
bC   long,auto
  code
  catByte = 0
  bS = startTok + 1
  bE = endBracket - 1
  loop while bS < bE
    if self.tk.getTok(bS) <> '(' then break.
    if self.tk.MatchLeftBracket('(', ')', bS) <> bE then break.
    bS += 1
    bE -= 1
  end
  if bS > bE then exit.
  bC = val(upper(self.tk.getTok(bS)))
  if ~((bC >= 65 and bC <= 90) or bC = 95) then exit.
  bDep = 0
  bLst = 0
  bCol = 0
  loop bx = bS + 1 to bE
    case self.tk.getTok(bx)
    of '['
      if ~bDep
        bLst = bx
        bCol = 0
      end
      bDep += 1
    of '('
      if ~bDep then exit.
      bDep += 1
    of ']' orof ')'
      bDep -= 1
    of ':'
      if bDep = 1 then bCol = 1.
    else
      if ~bDep and self.tk.getTok(bx) <> '.'
        bC = val(upper(self.tk.getTok(bx)))
        if ~((bC >= 65 and bC <= 90) or bC = 95) then exit.
      end
    end
  end
  catByte = 1
  if bLst and bCol and self.tk.getTok(bE) = ']'
    if self.tk.MatchLeftBracket('[', ']', bLst) = bE then catByte = 0 ; exit.
  end
  if bS <> bE
    if bLst <> bS + 1 then exit.
    if self.tk.MatchLeftBracket('[', ']', bLst) <> bE then exit.
  end
  if self.syms &= NULL then exit.
  if catMoved then self.syms.dirty = 1 ; catMoved = 0.
  if bS <> bE and self.ValuePtrPick(upper(self.tk.getTok(bS)), bS) then catByte = 0 ; exit.
  case self.HayType(self.tk.getTok(bS), bS)
  of 'STRING' orof 'CSTRING' orof 'PSTRING'
    catByte = 0
  end

! ------------------------------------------------------------------------------------
! BUILTIN UnusedVars - comment out declarations that are never referenced.
! Port of vtxaDiff009 CheckForUnusedVars + RemoveUnused, rebuilt on VitSymbols
! instead of GetData/vitWordStore (which are not in the workspace).
!
! One removal scan per invocation; if it commented anything it requests a
! rejoin/reparse (wantReparse) so the commented-out declarations - whole lines
! that are now '!' comments - disappear from the token stream. The engine
! fixpoint then re-invokes this builtin next pass, which is what drives the
! OVER-cascade (removing var A frees an OVER'd var B): B is only exposed as
! unused after A's line is gone. Running every pass (rather than once) also
! catches vars whose last use a later transform pass removes - matching
! vtxaDiff's final state, since it runs UnusedVars after its transforms settle.
!
! What is NOT removed (matching vtxaDiff): parameters and SELF (declTok is not
! a column-1 label), LIKE declarations (may use .property), structure blocks
! (GROUP/CLASS/QUEUE/... - VitSymbols never records these as symbols), and any
! name on the EXCLUDE list (procname/pn debugging vars by default).
! Multi-line (continuation) declarations: every physical line of the declaration
! gets its own comment marker (CommentOutSpan to DeclLastTok).
! Perf: one sweep of the token stream fills a (name, position) queue; each symbol
! is then a keyed lookup into it, with early exit on the first use in its span.
! The per-pass reparse shrinks the stream as declarations are removed.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinUnusedVars Procedure(StringTheory pLog)
prefix  StringTheory
exclU   StringTheory ! ' NAME1 NAME2 ' upper, space-delimited
raw     StringTheory
s       long,auto
changes long,AUTO
hasCode byte,auto
  code
  if self.syms &= NULL then return 0.

  ! an INCLUDE fragment - a file with NO CODE statement anywhere,
  ! e.g. an equates file INCLUDEd into other programs - can reference nothing, so
  ! EVERY declaration looks unused. The whole-file premise fails exactly as it did
  ! for module data in AutoCheck: the real references live in the INCLUDING
  ! programs, invisible here. No CODE statement in the stream -> skip the builtin.
  ! A real CODE statement: the single word CODE (caseless)
  ! starting in COLUMN > 1, followed by EOL or a trailing comment. A column-1
  ! CODE is a LABEL (a declaration named code) and must NOT count; col-1 test
  ! mirrors VitSymbols.IsColOneLabel (firstOnLine + NULL strBefore = column 1).
  ! A trailing '! comment' rides the EOL token's strBefore, so next-token-EOL
  ! covers both allowed followers. Anything unrecognised = treat as code present
  ! (under-skip = current behaviour, the safe direction).
  hasCode = 0
  loop s = 1 to self.tk.records()
    get(self.tk.tokens, s)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL          or |
       upper(self.tk.tokens.tok) <> 'CODE' or |
       ~self.tk.tokens.firstOnLine         or |   ! mid-line word - not the statement
       self.tk.BufColOne()                    ! column 1 = a label/declaration named code
      cycle
    end
    get(self.tk.tokens, s + 1)
    if errorcode()
      hasCode = 1                             ! CODE as the last token of the file
      break
    end
    if self.tk.tokens.tok &= NULL
      hasCode = 1                             ! trailing strBefore-only token = EOF after CODE
      break
    end
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      hasCode = 1                             ! genuine EOL - single-word CODE statement
      break
    end
  end
  if ~hasCode
    pLog.append('BUILTIN UnusedVars: no CODE statement in file (include fragment) - skipped<13,10>')
    return 0
  end

  prefix.setValue('! #Removed as not used: ') ! defaults (vtxaDiff hardcodes these)
  exclU.setValue(' PROCNAME PN ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      case upper(self.rl.rules.bparmQ.name)
      of 'PREFIX'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.unquote('''','''')
          prefix.setValue(raw)
        end
      of 'EXCLUDE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.upper()
          exclU.setValue(' ' & clip(raw.getValue()) & ' ')
        end
      end
    end
  end

  changes = self.RemoveUnusedPass(prefix, exclU, pLog)
  if changes
    self.wantReparse = true                   ! commented decls must vanish before the next scan; fixpoint drives the OVER cascade
    pLog.append('BUILTIN UnusedVars: ' & changes & ' commented this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! One scan of the symbol table: comment out each unreferenced removable
! declaration. PrependStrBefore on the column-1 label turns the whole line into
! a comment (the preceding <10> ends the previous line; the label's strBefore is
! empty for a column-1 label, so the prefix lands at line start). Token
! positions are unchanged by PrependStrBefore, so declTok stays valid across the
! whole scan.
! ------------------------------------------------------------------------------------
VitEngine.RemoveUnusedPass Procedure(StringTheory pPrefix, StringTheory pExclU, StringTheory pLog)
uvScopeS long          ! the scope this answer belongs to
uvScopeE long
uvScopeC long          ! and the answer: OMIT/COMPILE present
s        long,auto
sc       long,auto
declTok  long,auto
declLine long,auto
startT   long,auto
endT     long,auto
nameU    STRING(vs:maxName)
changes  long
used     byte          ! UsedChk verdict
ux       long,auto
dotP     long,auto     ! first '.' inside a merged dotted token
colP     long,auto     ! ... and the first ':', which means the same thing
isMember byte,auto     ! this file's module statement is MEMBER (module data is module-PRIVATE)
scKind   byte,auto     ! kind of the candidate's scope, captured at the scopes GET
extVis   byte          ! ExtVisChk verdict - decl carries an externally-visible attribute
modKept  long          ! module-scope decls withheld because they are not module-private
extKept  long          ! module-scope decls withheld for EXPORT/EXTERNAL/DLL
txaKept  long          ! decls withheld: owning scope spans .txa embed points (strict embed rule)
condKept long          ! decls withheld: the owning scope holds an OMIT or COMPILE block
incKept  long          ! decls withheld: the procedure INCLUDEs a file
objKept  long          ! decls withheld: an object, whose CONSTRUCT or DESTRUCT may be why it is declared
modInc   long          ! module-scope decls withheld: the file INCLUDEs text after them
lastInc  long          ! the last INCLUDE( token of the file, 0 = none
UseQ     QUEUE,PRE(uu) ! one token sweep -> keyed usage lookups (SymUsed rescanned the whole scope span PER SYMBOL)
nameU      string(vs:maxName)
pos        long
lineNo     long
         END
  code
  self.lmProcS = -1
  ! A field run once commented GlobalRequest / GlobalResponse / VCRRequest /
  ! SilentRunning out of a PROGRAM module. A whole-file usage scan is only
  ! sound for declarations that are PRIVATE to this file. Module-scope data is private
  ! ONLY in a MEMBER module - a PROGRAM's global section is visible to every MEMBER
  ! module of the program, and those references are invisible here. Same premise
  ! failure as with ,AUTO on static data and the include fragment; VitSymbols has a
  ! single vs:scModule kind covering BOTH sections, so the file's module statement is
  ! what decides. Detector mirrors the CODE spec: the single word MEMBER or PROGRAM
  ! (caseless) at COLUMN > 1 (firstOnLine + non-NULL strBefore; a column-1 word is a
  ! LABEL, i.e. a declaration named member/program). First one found wins - the module
  ! statement is the first statement of the file. Neither present (an include fragment
  ! that does have code) -> NOT member -> module scope withheld, the safe direction.
  ! Procedure/method/routine locals are unaffected in every file.
  isMember = 0
  loop ux = 1 to records(self.tk.tokens)
    get(self.tk.tokens, ux)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL  or                                      |
       ~self.tk.tokens.firstOnLine or                                      |
       self.tk.BufColOne()         or                                      |   ! column 1 = a label, not the module statement
       self.tk.tokens.type <> vt:reservedWord                              ! MEMBER/PROGRAM ARE reserved words ('r'), never 'b'=laBel; and TokenIsReservedWord
                                                                           !   already returns FALSE in column 1, so a label named member/program cannot reach here
      cycle
    end
    case upper(self.tk.tokens.tok)                                         ! no CLIP: tok is a &STRING sized to the token, and = ignores trailing blanks anyway (our own compare rules)
    of 'MEMBER'                                                            ! bare MEMBER and MEMBER('prog') both = module-private data
      isMember = 1
      break
    of 'PROGRAM'
      break                                                                ! global section - externally visible, isMember stays 0
    end
  end

  free(UseQ)
  loop ux = 1 to records(self.tk.tokens)                                   ! collect every content token once
    get(self.tk.tokens, ux)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or                                       |
       size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      cycle
    end
    uu:nameU = upper(self.tk.tokens.tok)
    uu:pos    = ux
    uu:lineNo = self.tk.tokens.lineNo
    add(UseQ)
    if uu:nameU = 'INCLUDE' and self.tk.GetTok(ux + 1) = '('
      lastInc = ux
    end
    ! the ParseText label-merge folds PROPERTY/FIELD references into ONE token
    ! (`st._DataEnd = 1` -> token 'st._DataEnd'; only a following '(' suppresses the
    ! merge - the 13Oct2021 NetMaps guard - so METHOD calls stay split). A var whose
    ! only references are property/field reads therefore had NO bare-name token and
    ! scanned as unused: UnusedVars commented `st  StringTheory` out of the demo while
    ! `st._DataEnd`/`st.valuePtr[1]` (a rule's rewrite) still referenced it. Credit
    ! the merged token's ROOT segment as a usage of the base variable.
    ! *** AND THE COLON SPELLING EARNS THE SAME CREDIT. *** A ':' may replace a '.', so a
    ! variable whose ONLY reference is `ga:x = 1` had no bare-name token and no dotted one
    ! either - it scanned as unused and its declaration was commented out. That output does
    ! not compile. False credit merely keeps a declaration, so it is the safe direction.
    dotP = pPrefix.findByte(46, 1,, uu:nameU)                              ! <dot>
    colP = pPrefix.findByte(58, 1,, uu:nameU)                              ! <colon>
    if colP and (~dotP or colP < dotP) then dotP = colP.
    if dotP > 1
      uu:nameU = sub(uu:nameU, 1, dotP - 1)
      add(UseQ)                                                            ! ('123.45' adds '123' - harmless, no symbol is named that)
    end
  end
  sort(UseQ, +uu:nameU, +uu:pos)
  loop s = 1 to records(self.syms.syms)
    get(self.syms.syms, s)
    if errorcode() then break.
    if self.syms.syms.isLike  or                                           |   ! LIKE may reference .property - do not remove
       self.syms.syms.isField                                              ! PRE:name structure field - its decl line is layout, never removable
      cycle
    end
    nameU   = self.syms.syms.nameU
    declTok = self.syms.syms.declTok
    if nameU = 'SELF' then cycle.                                          ! synthetic receiver
    if ~self.syms.IsColOneLabel(declTok) then cycle.                       ! parameter / non-declaration - never remove
    if pExclU.findChars(' ' & clip(nameU) & ' ') then cycle.               ! EXCLUDE list

    sc = self.syms.syms.scopeId
    get(self.syms.scopes, sc)
    if errorcode() then cycle.
    scKind = self.syms.scopes.kind                                         ! capture now - the scopes buffer is shared
  startT = self.syms.scopes.startTok
    endT   = self.syms.scopes.endTok
    if endT < startT then cycle.
    ! ONE ANSWER PER SCOPE, NOT PER SYMBOL. This loop walks SYMBOLS and a scope holds many of
    ! them, so asking here rescanned the same token range once for every variable declared in
    ! it - quadratic in a big file, and measurably so. The answer cannot differ between two
    ! symbols of one scope, so it is computed only when the scope changes.
    if startT <> uvScopeS or endT <> uvScopeE
      uvScopeS = startT
      uvScopeE = endT
      uvScopeC = self.ScopeIsConditional(startT, endT)
    end
    declLine = self.LineOfTok(declTok)

    do UsedChk                                                             ! keyed lookup replaces the per-symbol span scan
    if ~used and self.MayHaveLocalMethods(sc)
      if self.UsedInLocalMethods(nameU, startT, endT) then used = 1.
      if used and self.lmInc
        if ~self.lmNames.findChars(' ' & clip(nameU) & ' ') then incKept += 1.
      end
      get(self.syms.scopes, sc)
      get(self.syms.syms, s)
    end
    if ~used
      ! unused IN THIS FILE is only a verdict for a declaration this file owns
      ! privately. Module scope qualifies only in a MEMBER module, and never when the
      ! declaration is part of a cross-module contract. Checked here (not before
      ! UsedChk) so the reported counts mean 'would have been commented', and so the
      ! decl-line walk runs only for the handful of candidates. Scope-kind based: a
      ! procedure local in a PROGRAM file is still removable.
      !
      ! THE CONDITIONAL-SCOPE REFUSAL IS ASKED HERE FOR THE SAME REASON, AND IT IS
      ! COUNTED. Asked above the usage check instead, as a bare `cycle`, it would withhold
      ! declarations and say nothing at all - the one withheld reason with no counter
      ! beside the three below, in a routine whose own comment says a silent skip reads
      ! exactly like 'nothing was unused'. It withholds TWELVE declarations in
      ! TestData\r108all.clw, and that is the whole difference between the 3 that fixture
      ! reports and the 15 a count taken ahead of the usage check would give. Asking after
      ! UsedChk costs one keyed lookup per candidate and makes the count mean what the
      ! other three mean.
      if uvScopeC
        condKept += 1
        cycle
      end
      if self.isTxa
        ! The .txa embed rule, STRICT: decidable only when the owning
        ! procedure/routine is contained wholly inside ONE embed - generated code
        ! between embed points can reference a declaration this scan cannot see.
        if ~self.ScopeFullyEmbedded(startT, endT)
          txaKept += 1
          cycle
        end
      end
      if scKind <> vs:scModule and self.ScopeIncludes(sc)
        incKept += 1                                                       ! included code is not in this stream: it may be what uses it
        cycle
      end
      get(self.syms.syms, s)                                               ! the candidate's row, whatever the checks above moved
      if ~self.syms.syms.isRef and ~self.UvPlainType(self.syms.syms.typeU)
        objKept += 1                                                       ! an object: its CONSTRUCT or DESTRUCT may be why it is declared
        cycle
      end
      if scKind = vs:scModule
        if ~isMember
          modKept += 1
          cycle                                                            ! PROGRAM global / include fragment - other modules see it
        end
        do ExtVisChk
        if extVis
          extKept += 1
          cycle                                                            ! EXPORT/EXTERNAL/DLL - linked from other modules
        end
        ! A file INCLUDEd after the declaration is text this scan does not see: a procedure
        ! in it, or code included into a procedure of this file, can use module data. An
        ! INCLUDE above the declaration brings declarations only - the data follows it.
        if lastInc > declTok
          modInc += 1
          cycle
        end
      end
      ! *** COMMENT THE WHOLE DECLARATION, NOT ITS FIRST PHYSICAL LINE. *** Prepending to the
      ! label alone left everything past a '|' uncommented, so a declaration continued onto a
      ! second line came back as a comment followed by an orphaned `DIM(3)` - output that does
      ! not compile. CommentOutSpan gives every line of the span its own marker, and it works
      ! by PrependStrBefore too, so token positions are unchanged and declTok stays valid.
      self.CommentOutSpan(declTok, self.DeclLastTok(declTok), pPrefix.getValue())
      changes += 1
      if changes <= 500
        pLog.append('BUILTIN UnusedVars line ' & self.tk.MapLine(declLine) & ': ' & clip(nameU) & '<13,10>') ! log in SOURCE coords; declLine itself stays in stream coords for UsedChk
      end
    end
  end
  ! say what was withheld - a silent skip reads exactly like 'nothing was unused'.
  if modKept
    pLog.append('BUILTIN UnusedVars: ' & modKept & ' module-scope declaration(s) kept - not a MEMBER module, other modules can see them<13,10>')
  end
  if extKept
    pLog.append('BUILTIN UnusedVars: ' & extKept & ' module-scope declaration(s) kept - EXPORT/EXTERNAL/DLL, linked from other modules<13,10>')
  end
  if txaKept
    pLog.append('BUILTIN UnusedVars: ' & txaKept & ' declaration(s) kept - their procedure/routine spans .txa embed points, and generated code between embeds is not visible here<13,10>')
  end
  if condKept
    pLog.append('BUILTIN UnusedVars: ' & condKept & ' declaration(s) kept - their scope holds an OMIT or COMPILE block, and a reference from inside one is invisible to this scan<13,10>')
  end
  if incKept
    pLog.append('BUILTIN UnusedVars: ' & incKept & ' declaration(s) kept - their procedure INCLUDEs a file (in its data, its code or a method of a class it declares), and the included text is not visible here<13,10>')
  end
  if objKept
    pLog.append('BUILTIN UnusedVars: ' & objKept & ' object declaration(s) kept - an object''s CONSTRUCT or DESTRUCT runs without its name being used<13,10>')
  end
  if modInc
    pLog.append('BUILTIN UnusedVars: ' & modInc & ' module-scope declaration(s) kept - the file INCLUDEs text after them, which is not visible here<13,10>')
  end
  return changes

! is this declaration externally visible from OTHER modules? Module data carrying
! EXPORT (published from this module) or EXTERNAL/DLL (defined elsewhere, referenced
! here) is part of a cross-module contract - the whole-file scan cannot see the other
! side, so it is never removable. Walks the LOGICAL declaration statement: a '|'
! continuation produces NO <10> token (the CRLF rides in the next token's strBefore -
! vitTokenize), so the walk must run to the EOL token, not to the next lineNo, or an
! attribute parked on line 2 is missed. Bare tokens only (type 'b'), so EXPORT inside
! NAME('..EXPORT..') is a quoted literal and does not count.
ExtVisChk routine
  data
ex long,auto
  code
  extVis = 0
  ex = declTok
  loop
    ex += 1
    get(self.tk.tokens, ex)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break. ! end of the logical declaration
    if self.tk.tokens.type <> 'b' then cycle.
    case upper(self.tk.tokens.tok)                                              ! no CLIP: tok is a &STRING sized to the token, and = ignores trailing blanks anyway (our own compare rules)
    of 'EXPORT' orof 'EXTERNAL' orof 'DLL'
      extVis = 1
      break
    end
  end

UsedChk routine
  data
qx long,auto
  code
  ! same verdict as SymUsed: a token equal to nameU inside [startT,endT] on a line AFTER declLine.
  ! POSITION(queue) with a CLEARed buffer + the name set lower-bounds on the active
  ! (nameU,pos) sort order - first entry of the name's run, no walk-back needed.
  used = 0
  clear(UseQ)
  uu:nameU = upper(nameU)
  loop qx = position(UseQ) to records(UseQ)
    get(UseQ, qx)
    if uu:nameU <> upper(nameU) then break.
    if uu:pos < startT or uu:pos > endT then cycle.
    if uu:lineNo <= declLine and (uu:lineNo or uu:pos <= declTok) then cycle. ! line 0: inserted this pass, a use when it stands after the declaration
    used = 1
    exit
  end

! ------------------------------------------------------------------------------------
! Is pNameU referenced (as a whole token, caseless) anywhere in the scope span
! after its declaration line? Mirrors vtxaDiff findTokInLines(name, declLine+1,
! endLine): comments/string literals are trivia or distinct tokens, so a name
! that only appears in a comment or inside a literal counts as unused.
! ------------------------------------------------------------------------------------
VitEngine.SymUsed Procedure(STRING pNameU, LONG pStart, LONG pEnd, LONG pDeclLine)
i  long,auto
  code
  loop i = pStart to pEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.lineNo <= pDeclLine or |   ! only usages after the declaration line
       self.tk.tokens.tok &= NULL
      cycle
    end
    if upper(self.tk.tokens.tok) = pNameU then return true.
  end
  return false

! ====================================================================================
! BUILTIN UnusedRoutines - comment out ROUTINEs never invoked.
! Sibling of UnusedVars.  A Clarion ROUTINE is LOCAL to its procedure and reachable
! only by `DO <name>` from within that procedure (incl. its sibling routines), so a
! routine with no `DO <name>` anywhere in its owning proc's token span is dead.  Comment
! out its whole span (label line through last body line) and request a rejoin/reparse:
! the `DO` calls inside a removed routine then vanish, so a routine reachable ONLY from a
! now-removed routine becomes unused next pass - the same fixpoint cascade UnusedVars
! uses for OVER'd vars.
! Conservative (under-reach): KEEP a routine if `DO <name>` appears ANYWHERE in the proc
! span, including its own body (self-recursion) - a pure-recursive routine never called
! externally is a rare edge and keeping it is always safe.  Also keeps EXCLUDE names.
! v1 = ROUTINEs only (vs:scRoutine).  Local-MAP procedures/methods are a different
!     scope kind + reference shape (open Q-F) - not handled here.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinUnusedRoutines Procedure(StringTheory pLog)
prefix  StringTheory
exclU   StringTheory
raw     StringTheory
s       long,auto
changes long,AUTO
  code
  if self.syms &= NULL then return 0.

  prefix.setValue('! #Removed unused routine: ')
  exclU.setValue(' ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      case upper(self.rl.rules.bparmQ.name)
      of 'PREFIX'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.unquote('''','''')
          prefix.setValue(raw)
        end
      of 'EXCLUDE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.upper()
          exclU.setValue(' ' & clip(raw.getValue()) & ' ')
        end
      end
    end
  end

  changes = self.RemoveUnusedRoutinesPass(prefix, exclU, pLog)
  if changes
    self.wantReparse = true ! commented routines must vanish before the next scan; fixpoint drives the DO-cascade
    pLog.append('BUILTIN UnusedRoutines: ' & changes & ' routine(s) commented this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! One scan of the scope table: comment out each unreferenced ROUTINE scope.  Position
! indices (startTok/endTok) are unchanged by PrependStrBefore, so every scope row stays
! valid across the whole scan even as earlier routines are commented.
! ------------------------------------------------------------------------------------
VitEngine.RemoveUnusedRoutinesPass Procedure(StringTheory pPrefix, StringTheory pExclU, StringTheory pLog)
r         long,auto
parentId  long,auto
startT    long,auto
endT      long,auto
pStart    long,auto
pEnd      long,auto
nameU     STRING(vs:maxName),AUTO
annot     byte,auto ! .txa: the routine already carries the note
refM      byte,auto ! RoutineRefByMethod: 1 = a local class's method DOes it, 2 = a method of a class this file does not declare does
! fileCls is ' A B C ', every column-1 CLASS label in the file, built once per pass (FileClassList)
fileCls   StringTheory
j         long,auto
ownerless long      ! routines no PROCEDURE in this file owns - an include fragment
changes   long
  code
  self.lmProcS = -1
  self.FileClassList(fileCls)
  self.BuildDoIndex()                                                     ! one walk; the per-routine questions below are lookups
  self.doIdxOn = 1                                                        !   (14 Sep 2026: they walked the file once PER ROUTINE - 8 s of a 30 s run)
  loop r = 1 to records(self.syms.scopes)
    get(self.syms.scopes, r)
    if errorcode() then break.
    if self.syms.scopes.kind <> vs:scRoutine then cycle.
    startT   = self.syms.scopes.startTok
    endT     = self.syms.scopes.endTok
    parentId = self.syms.scopes.parentId
    if endT < startT then cycle.
    nameU = upper(self.tk.GetTok(startT))                                 ! routine label = scope startTok
    if ~nameU or                                                          |
       pExclU.findChars(' ' & clip(nameU) & ' ')
      cycle
    end

    if parentId
      get(self.syms.scopes, parentId)                                     ! owning proc/method span
      if errorcode() then cycle.
      pStart = self.syms.scopes.startTok
      pEnd   = self.syms.scopes.endTok
      if pEnd < pStart then cycle.
    else
      ! no recorded parent. On a .txa a ROUTINE under the SYNTHESISED procedure header
      ! arrives unparented and the annotate-only path below still wants a range: ROUTINEs
      ! are DO-only and a DO cannot cross a procedure, so the WHOLE stream is a safe
      ! SUPERSET range - it can only over-credit a reference, never convict one wrongly.
      ! In plain source an ownerless routine means the file is an INCLUDE FRAGMENT, the
      ! tail of a procedure in another file, and every DO that reaches it is there:
      ! nothing here can be judged, so count it and say so once below.
      if ~self.isTxa then ownerless += 1 ; cycle.
      pStart = 1
      pEnd   = self.tk.records()
    end

    refM = self.RoutineRefByMethod(nameU, pStart, pEnd, fileCls)
    if refM = 2 and ~self.RoutineReferenced(nameU, pStart, pEnd)
      pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & |
                  ' - kept, DOne from a method of a class this file does not declare (the class may be local to the procedure)<13,10>')
      cycle
    end
    if ~self.RoutineReferenced(nameU, pStart, pEnd) and refM <> 1
      if ~self.isTxa and self.ProcIncludes(pStart, pEnd)
        ! no DO in sight, but the owning procedure INCLUDEs a file after its CODE, and a DO in
        ! that file is not in this stream (--thorough splices includes for the TYPE registry only)
        pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & |
                    ' - kept, its procedure INCLUDEs a file this run does not see and a DO may be inside it<13,10>')
        cycle
      end
      ! The same for a method of a class the procedure declares: it shares the procedure's
      ! routines, and a file it INCLUDEs after its CODE may DO one. '#' begins no name, so the
      ! answer is yes only for such an INCLUDE.
      if ~self.isTxa and self.MayHaveLocalMethods(parentId) and self.UsedInLocalMethods('#', pStart, pEnd)
        pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & |
                    ' - kept, a method of a class its procedure declares INCLUDEs a file this run does not see and a DO may be inside it<13,10>')
        cycle
      end
      if ~self.isTxa and self.ScopeIsConditional(startT, endT)
        pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & |
                    ' - kept, it holds a COMPILE or OMIT block, whose closing line may lie past the routine''s own last line<13,10>')
        cycle
      end
      if self.isTxa
        ! The .txa embed rule: on a.txa NEVER comment a routine out - a
        ! template can DO a routine from generated code this file does not contain, so
        ! "no DO found" is not "unused" here. Annotate the header for the user to check
        ! instead. IDEMPOTENCE walks BACK over the EOL tokens above the label: the pass
        ! sets wantReparse, and after the reparse a full-line comment's text lives in
        ! the strBefore of ITS OWN <10> token, not the label's - testing only the label
        ! re-added the note every pass to maxPasses (the physical-line-start trap in its
        ! annotation flavour, and this fixture caught it at 20 notes deep).
        annot = 0
        j = startT + 1
        loop
          j -= 1
          if j < 1 then break.
          get(self.tk.tokens, j)
          if errorcode() then break.
          if not self.tk.tokens.strBefore &= NULL
            if pPrefix.findChars('possibly not used', 1,, self.tk.tokens.strBefore) then annot = 1 ; break.
          end
          if j = startT                 or                                |   ! the label itself - keep walking up
             self.tk.tokens.tok &= NULL or                                |   ! trailing-trivia row
             size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' ! a blank/comment line's EOL
            cycle
          end
          break                                                           ! previous CONTENT token - the note cannot be above it
        end
        if ~annot
          self.tk.PrependStrBefore(startT, '! possibly not used - no DO in the embedded source, but template-generated code is not visible here. Check, then delete this line or the routine.<13,10>')
          changes += 1
          pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & ' - possibly not used (annotated; a .txa never has the whole picture)<13,10>')
        end
      elsif self.CommentOutSpan(startT, endT, pPrefix.getValue())
        changes += 1
        pLog.append('BUILTIN UnusedRoutines line ' & self.LogLineOf(startT) & ': ' & clip(nameU) & '<13,10>')
      end
    end
  end
  if ownerless
    pLog.append('BUILTIN UnusedRoutines: ' & ownerless & ' routine(s) kept - no PROCEDURE in this file owns them (an include fragment), ' & |
                'so every DO that reaches them is in the file that INCLUDEs this one<13,10>')
  end
  self.doIdxOn = 0                                                        ! the index is stale as soon as anything else edits
  return changes

! ------------------------------------------------------------------------------------
! `DO <pNameU>` present anywhere in [pProcStart, pProcEnd]?  (whole-token DO immediately
! followed by the routine name, caseless; <10> EOL tokens skipped so `DO`/name split
! across a line still matches).  ROUTINEs are DO-only, so this is a complete usage test.
! ------------------------------------------------------------------------------------
VitEngine.RoutineReferenced Procedure(STRING pNameU, LONG pProcStart, LONG pProcEnd)
i      long,auto
prevU  string(vs:maxName),AUTO
tU     string(vs:maxName),auto
  code
  if self.doIdxOn                                                   ! the index: the rows of this name, sorted by name then position
    self.doRefs.drName = pNameU
    get(self.doRefs, self.doRefs.drName)
    if errorcode() then return false.
    i = pointer(self.doRefs)
    loop while i > 1                                                !   back to the first row of the name
      get(self.doRefs, i - 1)
      if self.doRefs.drName <> pNameU then break.
      i -= 1
    end
    loop
      get(self.doRefs, i)
      if errorcode() or self.doRefs.drName <> pNameU then break.
      if self.doRefs.drDo >= pProcStart and self.doRefs.drAt <= pProcEnd then return true.
      i += 1
    end
    return false
  end
  prevU = ''
  loop i = pProcStart to pProcEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or                                |
       size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' ! EOL trivia
      cycle
    end
    tU = upper(self.tk.tokens.tok)
    if tU = pNameU and prevU = 'DO' then return true.
    prevU = tU
  end
  return false

! ------------------------------------------------------------------------------------
! A DO can also reach the routine from a METHOD of a class declared in the owning
! procedure's DATA section: Clarion compiles a local class's methods inside that
! procedure's scope, and the ABC templates rely on it in every window procedure -
! ThisWindow.Init DOes DefineListboxStyle, a routine of the procedure, from a method
! body that follows the routines. Measured on the corpus: 135 of the
! 210 routines the builtin would have commented out were DOne exactly this way, and most
! of the rest cascaded from them. The methods of a local class stand between their
! procedure and the next one, so those are the spans searched. A method whose class is
! declared elsewhere in this file belongs to that class and is skipped. A method whose
! class this file declares NOWHERE (an export that left the declaration behind, a class
! module whose class lives in its .inc) may or may not be local: the answer is 2, and the
! caller keeps the routine and says why - the direction that cannot break a build.
!   pFileCls: ' A B C ', every column-1 CLASS label in the file (FileClassList), built
!   once per pass - a scan of the whole stream per method per routine went cubic on a
!   class module and never finished.
!   returns 1 = a local class's method DOes it; 2 = only a method of an undeclared class
!   does; 0 = neither.
! ------------------------------------------------------------------------------------
VitEngine.RoutineRefByMethod Procedure(STRING pNameU, LONG pProcStart, LONG pProcEnd, StringTheory pFileCls)
r      long,auto
nextP  long,auto
mStart long,auto
mEnd   long,auto
undecl byte
  code
  nextP = self.tk.records() + 1
  loop r = 1 to records(self.syms.scopes) ! the next PROCEDURE after the owner bounds the search
    get(self.syms.scopes, r)
    if errorcode() then break.
    if self.syms.scopes.kind = vs:scProc and self.syms.scopes.startTok > pProcEnd and self.syms.scopes.startTok < nextP
      nextP = self.syms.scopes.startTok
    end
  end
  loop r = 1 to records(self.syms.scopes)
    get(self.syms.scopes, r)
    if errorcode() then break.
    if self.syms.scopes.kind <> vs:scMethod then cycle.
    mStart = self.syms.scopes.startTok
    mEnd   = self.syms.scopes.endTok
    if mStart <= pProcEnd or mStart >= nextP or mEnd < mStart then cycle.
    if self.LocalClassDeclared(self.syms.scopes.selfClass, pProcStart, pProcEnd)
      if self.RoutineReferenced(pNameU, mStart, mEnd) then return 1.
    elsif ~pFileCls.findChars(' ' & clip(self.syms.scopes.selfClass) & ' ')
      if self.RoutineReferenced(pNameU, mStart, mEnd) then undecl = 1.
    end
  end
  return choose(~undecl, 0, 2)

! ------------------------------------------------------------------------------------
! Is `<pClsU> CLASS` a column-1 declaration in the span's DATA section - after the
! procedure header and before its CODE statement?
! ------------------------------------------------------------------------------------
VitEngine.LocalClassDeclared Procedure(STRING pClsU, LONG pProcStart, LONG pProcEnd)
i   long,auto
tU  string(vs:maxName),auto
  code
  if ~pClsU then return false.
  if self.doIdxOn                                              ! the index: a declaration inside the span, with no CODE between the span's start and it
    loop i = 1 to records(self.clsDecls)
      get(self.clsDecls, i)
      if errorcode() then break.
      if self.clsDecls.cdName <> pClsU then cycle.
      if self.clsDecls.cdPos > pProcStart and self.clsDecls.cdPos <= pProcEnd and self.clsDecls.cdCode <= pProcStart then return true.
    end
    return false
  end
  loop i = pProcStart + 1 to pProcEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or ~self.tk.tokens.firstOnLine then cycle.
    tU = upper(self.tk.tokens.tok)
    if tU = 'CODE' and ~self.syms.IsColOneLabel(i) then break. ! the data section ends at CODE
    if tU = pClsU and self.syms.IsColOneLabel(i) and upper(self.tk.GetTok(i + 1)) = 'CLASS' then return true.
  end
  return false

! =============================================================================================
! BUILTIN AlwaysTrueTest - an IF whose whole condition is clip(n) or left(n) on a NUMBER is always
! true: a number never converts to blank text, so the test is a bug in the input, not a choice.
! Ruled 17 Oct 2026: say so in the code, and keep what it does. The IF line, its ELSE or ELSIF
! side and the END are commented out behind a `! #Possible bug` mark, and the code the IF always
! runs stays live - the program does exactly what it did, and the suspect test is in plain view.
!
!     if clip(n)                       ! #Possible bug - always true: if clip(n)
!       Total += 1             ->        Total += 1
!     else                             ! #Possible bug - always true: else
!       Total = 0                      !   Total = 0
!     end                              !     end
!
! A one-line IF keeps its statements on a line of their own, below the commented-out IF.
! The same holds for `clip(n) <> ''` (or `~=`) against a blank literal, which is always true too. And
! `clip(n) = ''` is never true: then the IF line, the code it guards, the ELSE line and the END are
! commented out behind `! #Possible bug - never true:` and the ELSE code, which always runs, stays live;
! with no ELSE the whole IF goes, as none of it ever runs. That form refuses an ELSIF, which would have
! to become the IF, and code after the ELSE on the ELSE's own line, which is the code that always runs.
! Both forms refuse a label in the code that never runs - the ELSE or ELSIF side of an always-true IF,
! the guarded code of a never-true one - which a GOTO may jump to. A block IF may end its first line
! with THEN; it is the same block.
! REFUSED, and said: an IF that is an arm of an EXECUTE (the arm count would change), an IF whose
! code ends with the '.' that closes it on the same line (commenting that line would take live
! code with it), a block IF with code after its THEN, an ELSE that shares a line with code, and
! an END or closing '.' with another statement after it on its line
! (`if clip(n) then c = 1. ; c += 5` - the line is commented out whole, and `c += 5` runs whatever
! the test says). Anything else about the condition - a dotted name, a name that is not a number,
! more after the closing bracket than THEN - is not this shape and is left alone; NOTBOOL on rule
! 771 keeps that clip as written.
! =============================================================================================
VitEngine.BuiltinAlwaysTrueTest Procedure(StringTheory pLog)
i        long,auto
ifTok    long,auto
endTok   long,auto
sepTok   long,auto
ifEol    long,auto
dep      long,auto
k        long,auto
thenEnd  long,auto
ln       long,auto
lbFrom   long,auto
lbTo     long,auto
lbHit    byte,auto
changes  long
condEnd  long,auto
never    byte,auto
tU       STRING(vs:maxName)
rf       BYTE
numSet   StringTheory
prefix   StringTheory
what     StringTheory
cmp      StringTheory
lit      StringTheory
body     StringTheory
ind      StringTheory
  code
  if self.syms &= NULL then return 0.
  numSet.setValue(' BYTE SHORT USHORT LONG ULONG INT64 UINT64 DECIMAL PDECIMAL REAL SREAL BFLOAT4 BFLOAT8 SIGNED UNSIGNED ')
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.type <> 'r' or ~self.tk.tokens.firstOnLine or self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'IF' or self.tk.tokens.level <> '+' then cycle.
    ifTok = i
    ! ---- the shape: IF clip|left ( name ) and then THEN or the end of the line ----
    case upper(self.tk.GetTok(ifTok + 1))
    of 'CLIP' orof 'LEFT'
    else
      cycle
    end
    if self.tk.GetTok(ifTok + 2) <> '(' or self.tk.GetTok(ifTok + 4) <> ')' then cycle.
    if ~self.rl.IsLabelToken(self.tk.GetTok(ifTok + 3)) then cycle.             ! one plain name - a dotted one is not looked up here
    if ~self.syms.Lookup(self.tk.GetTok(ifTok + 3), ifTok + 3, tU, rf) then cycle.
    if ~numSet.findChars(' ' & clip(upper(tU)) & ' ') then cycle.               ! a number, by its declaration
    ! ---- after the bracket: THEN or the end of the line - the call alone, always true - or a compare
    !      with a blank literal: <> and ~= are always true as well, and = is never true ----
    condEnd = ifTok + 4 ; never = 0
    case self.tk.GetTok(ifTok + 5)
    of '=' orof '<<>' orof '~='
      cmp.setValue(self.tk.GetTok(ifTok + 6))
      if ~cmp._DataEnd or cmp.valuePtr[1] <> '''' then cycle.
      if ~self.LitBytes(cmp.getValue(), lit) then cycle.
      lit.clip()
      if lit._DataEnd then cycle.                                               ! not blank: a compare with text
      condEnd = ifTok + 6
      if self.tk.GetTok(ifTok + 5) = '=' then never = 1.
    end
    what.setValue(choose(~never, 'always true', 'never true'))
    prefix.setValue('! #Possible bug - ' & what.getValue() & ': ')
    get(self.tk.tokens, ifTok)
    endTok = self.tk.MatchLevel()
    if endTok <= ifTok then cycle.
    if self.ArmOfExecute(ifTok)
      pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - the IF is an arm' & |
                  ' of an EXECUTE, and taking it away would change the arm count. Its test is '           & |
                  what.getValue() & ': clip() or left() of a number'                                      & |
                  ' is never blank.<13,10>')
      i = endTok
      cycle
    end
    ! ---- the first ELSE or ELSIF of THIS IF: depth 1 ----
    sepTok = 0 ; dep = 1
    loop k = ifTok + 1 to endTok - 1
      get(self.tk.tokens, k)
      if errorcode() then break.
      case val(self.tk.tokens.level)
      of 43                                                                        ! '+'
        dep += 1
      of 45                                                                        ! '-'
        dep -= 1
      of 47                                                                        ! '/'
        if dep = 1 then sepTok = k ; break.
      end
    end
    if upper(self.tk.GetTok(condEnd + 1)) = 'THEN'
      do OneLine
    else
      do Block
    end
  end
  if changes
    self.wantReparse = true                                                        ! the commented lines must vanish before the next scan
  end
  return changes

! ---- a block IF: the IF line ends after the condition, or after a THEN that follows it (ThenBlock);
!      its own code stays, the rest goes ----
Block routine
  ifEol = self.FirstEolAfter(ifTok)
  if ifEol <> condEnd + 1 then exit.                                     ! more on the line than the condition
  if self.SpanHasNL(ifTok + 1, condEnd)
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - its test is carried over'           & |
                ' more than one line, and the rows after the first would be left as code. Its test is ' & what.getValue() & |
                ': clip() or left() of a number is never blank.<13,10>')
    i = endTok
    exit
  end
  if sepTok
    get(self.tk.tokens, sepTok)
    if ~self.tk.tokens.firstOnLine
      pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - its ELSE shares a' & |
                  ' line with code. Its test is ' & what.getValue() & ': clip() or left() of a number is never blank.<13,10>')
      i = endTok
      exit
    end
  end
  if ~sepTok or never
    get(self.tk.tokens, endTok)
    if ~self.tk.tokens.firstOnLine
      pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - the IF closes'      & |
                  ' with a ''.'' on a line of its own code. Its test is ' & what.getValue() & ': clip() or' & |
                  ' left() of a number is never blank.<13,10>')
      i = endTok
      exit
    end
  end
  if endTok < records(self.tk.tokens) and ~self.IsEolTok(endTok + 1) then do TailRefused ; exit.
  if never then do NeverBlock ; exit.
  if sepTok
    lbFrom = sepTok + 1 ; lbTo = endTok - 1 ; do LabelRefused
    if lbHit then exit.
  end
  self.CommentLineStart(ifTok, prefix.getValue())
  if sepTok
    self.CommentOutSpan(sepTok, endTok, prefix.getValue())               ! the ELSE or ELSIF side, which never runs
  else
    self.CommentLineStart(endTok, prefix.getValue())
  end
  changes += 1
  pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': the test is always true -'  & |
              ' clip() or left() of a number is never blank - so the IF is commented out and its own' & |
              ' code kept' & choose(~sepTok, '', ', and the side that never ran with it') & '.<13,10>')
  i = endTok                                                             ! the tokens stay until the reparse: step past them

! ---- a block IF that is never true: the test and the code it guards never run, the ELSE code always
!      does. An ELSIF would have to become the IF, and a label in the code that never runs may be a
!      GOTO's target, so both refuse. So does code after the ELSE on its own line: that line is
!      commented out with the IF, and the code on it is the code that always runs ----
NeverBlock routine
  if sepTok and upper(self.tk.GetTok(sepTok)) <> 'ELSE'
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - it has an ELSIF,' & |
                ' which would have to become the IF. Its test is never true: clip() or left() of a'     & |
                ' number is never blank.<13,10>')
    i = endTok
    exit
  end
  if sepTok and ~self.IsEolTok(sepTok + 1)
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - code follows its' & |
                ' ELSE on the same line, and would be commented out with the ELSE. Its test is never'   & |
                ' true: clip() or left() of a number is never blank.<13,10>')
    i = endTok
    exit
  end
  thenEnd = choose(~sepTok, endTok, sepTok)
  lbFrom = ifTok + 1 ; lbTo = thenEnd - 1 ; do LabelRefused
  if lbHit then exit.
  if sepTok
    self.CommentOutSpan(ifTok, sepTok, prefix.getValue())                     ! the test, the code it guards and the ELSE
    self.CommentLineStart(endTok, prefix.getValue())
  else
    self.CommentOutSpan(ifTok, endTok, prefix.getValue())                     ! none of it ever runs
  end
  changes += 1
  pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': the test is never true -' & |
              ' clip() or left() of a number is never blank - so the IF and the code it guards are' & |
              ' commented out' & choose(~sepTok, '', ', and its ELSE code kept') & '.<13,10>')
  i = endTok                                                                  ! the tokens stay until the reparse: step past them

! ---- a one-line IF: the code that runs goes on a line of its own, below the commented-out IF - its
!      THEN code when the test is always true, its ELSE code, if any, when it is never true ----
OneLine routine
  get(self.tk.tokens, ifTok)
  ln = self.tk.tokens.lineNo
  get(self.tk.tokens, endTok)
  if errorcode() then exit.
  if self.tk.tokens.lineNo <> ln then do ThenBlock ; exit.   ! not all on one line
  thenEnd = choose(~sepTok, endTok - 1, sepTok - 1)
  if thenEnd < condEnd + 2 then exit.                        ! nothing after THEN
  ifEol = self.FirstEolAfter(endTok)
  if ~ifEol or ifEol >= records(self.tk.tokens) then exit.   ! the last line of the file: nothing to insert before
  if ifEol <> endTok + 1 then do TailRefused ; exit.         ! a statement after the closing '.'
  body.free()
  if ~never
    self.IsuSpanText(condEnd + 2, thenEnd, body)
  elsif sepTok
    if upper(self.tk.GetTok(sepTok)) <> 'ELSE' then exit.    ! an ELSIF on one line: left alone
    if endTok - 1 > sepTok then self.IsuSpanText(sepTok + 1, endTok - 1, body).
  end
  body.trim()
  if ~body._DataEnd and ~never then exit.
  self.IndentOf(ifTok, ind)
  self.CommentLineStart(ifTok, prefix.getValue())
  if body._DataEnd then self.tk.InsertString(ifEol + 1, ind.getValue() & body.getValue() & '<13,10>').
  changes += 1
  if never
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': the test is never true -' & |
                ' clip() or left() of a number is never blank - so the IF is commented out'           & |
                choose(~body._DataEnd, ' with the code it guards', ', and its ELSE code kept on the line below') & '.<13,10>')
  else
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': the test is always true -'   & |
                ' clip() or left() of a number is never blank - so the IF is commented out and the code' & |
                ' it runs is kept, on the line below.<13,10>')
  end
  if body._DataEnd
    i = records(self.tk.tokens) + 1                            ! tokens were inserted: stop, and let the next pass go on
  else
    i = endTok
  end

! ---- an IF written with THEN whose END is on a later line. THEN alone at the end of the IF's line
!      is only another way to write a block IF, so Block takes it, THEN as the end of the test.
!      With more on that line - code after the THEN, or the test carried on with a '|' - the
!      line cannot be commented out whole, so it is refused ----
ThenBlock routine
  get(self.tk.tokens, condEnd + 1)
  if self.tk.tokens.lineNo = ln and self.IsEolTok(condEnd + 2)
    condEnd += 1
    do Block
    exit
  end
  pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - it is written with'     & |
              ' THEN and goes on below the IF''s line, which holds more than the test and THEN: commenting' & |
              ' that line out would take the rest with it. Its test is ' & what.getValue() & ': clip() or'  & |
              ' left() of a number is never blank.<13,10>')
  i = endTok

! ---- refused: a column-1 label in lbFrom..lbTo, code that never runs and would be commented out
!      with the IF - a GOTO may jump to it. lbHit says so ----
LabelRefused routine
  lbHit = 0
  loop k = lbFrom to lbTo
    if ~self.syms.IsColOneLabel(k) then cycle.
    pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - line '             &   |
                self.LogLineOf(k) & ', in the code that never runs, carries a label a GOTO may jump to.' &   |
                ' Its test is ' & what.getValue() & ': clip() or left() of a number is never blank.<13,10>')
    i = endTok
    lbHit = 1
    break
  end

! ---- refused: a statement follows the END or '.' that closes the IF, on the same line. The
!      line is commented out whole, so that statement would go with it.
TailRefused routine
  pLog.append('BUILTIN AlwaysTrueTest line ' & self.LogLineOf(ifTok) & ': REFUSED - more code follows'       & |
              ' the END or ''.'' that closes the IF, on the same line. Its test is ' & what.getValue() & ':' & |
              ' clip() or left() of a number is never blank.<13,10>')
  i = endTok

! =============================================================================================
! BUILTIN HoistNeutralTest - a test against a literal with no letters reads the same before a
! case fold as after it, so it can move above the fold:
!
!     v = upper(w)                         if w = '.' then return 1.
!     if v = '.' then return 1.      ->    v = upper(w)
!
! That puts the store next to the statement after it, for InlineSingleUse. On the path that
! jumps, v is no longer set, so the move is made only when nothing can read v there:
!   * v is a procedure local - not a parameter, a reference, STATIC or THREAD - and the jump is
!     a RETURN that does not mention v: RETURN ends the procedure and its locals;
!   * v is a local of the ROUTINE the two lines are in, and the jump is EXIT or RETURN: routine
!     data is fresh on every DO;
!   * or v is mentioned nowhere in its procedure - routines and the methods of a class it
!     declares included - but in its declaration, the store, the test and the line straight
!     after the test, which runs only on the path that does not jump - unless that line closes a
!     structure or opens a branch of one - `end ; message(v)` closes the LOOP a BREAK leaves, and `of 2 ;
!     message(v)` runs on a later pass after a CYCLE - and runs on that path too;
!     and nothing is INCLUDEd
!     there, since included code is not in this file and may mention v.
! The literal must decode to bytes with no letter, and nothing above 127, which upper() may
! fold ('<65>' is 'A'); w must be one name that reads data; the two lines must be consecutive
! single lines and not arms of an EXECUTE. A line that a '|' carries on from the line above is
! not a store: it is part of that statement, where `v = upper(w)` is a comparison. Every pair is
! decided before any is moved, and the moves are made from the bottom up.
! A RETURN on the test line carries its value and nothing else - no ELSE, no second statement -
! and the value does not read v: whatever else stands there runs when the test does not jump,
! and after the move it would run before the store. v is not declared OVER another variable:
! the store writes that variable too, under a name none of the three rules can follow.
! =============================================================================================
VitEngine.BuiltinHoistNeutralTest Procedure(StringTheory pLog)
x       long,auto
n       long,auto
s1      long,auto ! the store: v = upper(w)
s2      long,auto ! the test: if v = lit then <jump>.
e2      long,auto ! the test's EOL
dt      long,auto ! the test's terminating '.'
l3s     long,auto ! the line after the test
l3e     long,auto
k       long,auto
b       long,auto
sc      long,auto
rsc     long,auto
row     long,auto
decl    long,auto
hnN     long,auto ! the folded variable's declared width
hnW     long,auto !   and its source's
hnL     long,auto
ok      byte,auto
jw      string(8),auto
vU      string(vs:maxName),auto
fn      string(vs:maxName),auto
lit     StringTheory
changes long
HnQ     QUEUE,PRE(hn)
s1        LONG
s2        LONG
e2        LONG
ln        LONG
          END
  code
  free(HnQ)
  if self.tk &= NULL or self.syms &= NULL then return 0.
  n = records(self.tk.tokens)
  loop x = 1 to n - 8
    if ~self.IsFirstOnLine(x) or ~self.BeginsStmt(x) or self.syms.IsColOneLabel(x) then cycle.
    if self.tk.GetTok(x + 1) <> '=' then cycle.
    fn = upper(self.tk.GetTok(x + 2))
    if fn <> 'UPPER' and fn <> 'LOWER' then cycle.
    if self.tk.GetTok(x + 3) <> '(' or self.tk.GetTok(x + 5) <> ')' or ~self.IsEolTok(x + 6) then cycle.
    vU = upper(self.tk.GetTok(x))
    if ~vU or pLog.findByte(46, 1,, vU) then cycle.                             ! <dot>
    if ~self.CondNamesAreData(x + 4, x + 4) then cycle.
    s1 = x ; s2 = x + 7
    if upper(self.tk.GetTok(s2)) <> 'IF' or upper(self.tk.GetTok(s2 + 1)) <> vU or self.tk.GetTok(s2 + 2) <> '=' then cycle.
    if upper(self.tk.GetTok(s2 + 4)) <> 'THEN' then cycle.
    lit.setValue(self.tk.GetTok(s2 + 3))
    if ~lit._DataEnd or lit.valuePtr[1] <> '''' then cycle.
    if ~self.LitBytes(lit.getValue(), lit) then cycle.
    ok = 1
    loop k = 1 to lit._DataEnd
      b = val(lit.valuePtr[k])
      if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b > 127 then ok = 0 ; break.
    end
    if ~ok then cycle.
    jw = upper(self.tk.GetTok(s2 + 5))
    dt = 0
    case jw
    of 'CYCLE'  orof 'EXIT' orof 'BREAK'
      dt = s2 + 6
    of 'RETURN'
      loop k = s2 + 6 to n
        if self.IsEolTok(k) then break.
        dt = k
      end
    else
      cycle
    end
    if ~dt or self.tk.GetTok(dt) <> '.' or ~self.IsEolTok(dt + 1) then cycle.
    if jw = 'RETURN'
      do ReturnOnly
      if ~ok then cycle.
    end
    e2 = dt + 1
    if self.SpanHasNL(s1 + 1, s1 + 5) or self.SpanHasNL(s2 + 1, dt) then cycle. ! a continued line: not the shape (the EOL token itself counts as a newline there)
    if self.ArmOfExecute(s1) then cycle.
    ! ---- who could read v on the path that jumps? ----
    sc  = self.syms.ScopeContaining(s1, vs:scProc, vs:scMethod)
    rsc = self.syms.ScopeContaining(s1, vs:scRoutine, vs:scRoutine)
    row = 0
    if rsc then row = self.syms.FindOwn(vU, rsc).
    if row
      ok = choose(jw = 'EXIT' or jw = 'RETURN')                                 ! a routine local dies with its routine
    else
      if ~sc then cycle.
      row = self.syms.FindOwn(vU, sc)
      if ~row then cycle.
      ok = 0
      if jw = 'RETURN' and ~self.NameRefdInRange(vU, s2 + 6, dt - 1)
        ok = choose(self.AutoEligible(row, 0) <> 0)                             ! a plain local dies with its procedure
      end
    end
    if ~ok
      get(self.syms.syms, row)
      if errorcode() then cycle.
      decl = self.syms.syms.declTok
      if ~self.syms.IsColOneLabel(decl) then cycle.                             ! a parameter is the caller's: it reads it after a RETURN
      get(self.syms.scopes, self.syms.syms.scopeId)
      if errorcode() then cycle.
      l3s = e2 + 1
      l3e = self.FirstEolAfter(e2)
      if ~l3e then cycle.
      loop k = l3s to l3e                                                       ! a line that closes or branches a structure
        get(self.tk.tokens, k)                                                  !   runs on a jumping path too: nothing on it is excused
        if ~errorcode() and inlist(self.tk.tokens.level, '-', '/') then l3e = l3s - 1 ; break.
      end
      ok = 1                                                                    ! nothing else in the scope mentions v
      loop k = self.syms.scopes.startTok to self.syms.scopes.endTok
        if k = decl or k = s1 or k = s2 + 1 or (k >= l3s and k <= l3e) then cycle.
        if self.NameRefdInRange(vU, k, k) then ok = 0 ; break.
      end
      if ok and self.syms.scopes.kind <> vs:scRoutine and self.MayHaveLocalMethods(self.syms.scopes.scopeId)
        if self.UsedInLocalMethods(vU, self.syms.scopes.startTok, self.syms.scopes.endTok) then ok = 0.
      end
      if ~ok or self.ScopeIncludes(self.syms.syms.scopeId) then cycle.
    end
    if ~row then cycle.                                                         ! v holds upper(w) whole: a STRING at least as wide as w -
    get(self.syms.syms, row)                                                    !   a STRING(1) holds its first byte, a number compares
    if errorcode() or self.syms.syms.typeU <> 'STRING' or self.syms.syms.isRef then cycle. !   numerically, and w of unknown width may be longer
    decl = self.syms.syms.declTok
    if band(self.DeclAttrBits(decl), ab:over) then cycle.
    hnN = self.syms.DeclaredStrLen(self.syms.syms.nameU, self.syms.syms.declTok)
    hnW = 0 ; hnL = 0
    if self.IsuExprType(s1 + 4, s1 + 4, hnW, hnL) <> 'STRING' or ~hnW or ~hnN or hnW > hnN then cycle.
    clear(HnQ)
    hn:s1 = s1 ; hn:s2 = s2 ; hn:e2 = e2 ; hn:ln = self.LogLineOf(s1)
    add(HnQ)
  end
  ! ---- bottom up: a move shifts only the tokens after it ----
  loop k = records(HnQ) to 1 by -1
    get(HnQ, k)
    if errorcode() then cycle.
    self.tk.SetTok(hn:s2 + 1, self.tk.GetTok(hn:s1 + 4))                        ! the test reads w, not v
    self.MoveLinesAbove(hn:s2, hn:s1, hn:e2 - hn:s2 + 1)                        ! and its line goes above the store
    changes += 1
    pLog.append('BUILTIN HoistNeutralTest: line ' & hn:ln & ' the test of a literal with no letters moved above the fold<13,10>')
  end
  free(HnQ)
  if changes
    self.tk.SetLineNumbers()
    self.wantReparse = true
  end
  return changes

! ---- a RETURN: what follows it on the test line must be its own value and nothing more. An ELSE,
!      a ';' or a '.' that ends the IF early puts a statement on the path that does not jump, and
!      after the move that statement would run before the store. A value that reads v would read
!      it before the store too.
ReturnOnly routine
  ok = 1
  loop k = s2 + 6 to dt - 1
    case upper(self.tk.GetTok(k))
    of 'ELSE' orof 'ELSIF' orof 'END' orof ';'
      ok = 0
    of '.'
      if ~self.DgIsMemberDot(k) then ok = 0.
    end
    if ~ok then break.
  end
  if ok and self.NameRefdInRange(vU, s2 + 6, dt - 1) then ok = 0.
! ------------------------------------------------------------------------------------
! Is a declaration of this type plain DATA - declaring it runs nothing? A built-in data type, a
! structure, or a StringTheory, whose constructor and destructor only manage its own memory. An
! object of any other class may be declared for what its CONSTRUCT and DESTRUCT do - an
! hourglass, a lock, a log line - and is used without its name ever appearing again, so
! UnusedVars keeps it. A type this cannot place is not plain: a lost removal, never a wrong one.
! ------------------------------------------------------------------------------------
VitEngine.UvPlainType Procedure(STRING pTypeU)
td  long,auto
  code
  case upper(pTypeU)
  of   ''
  orof 'BYTE'  orof 'SHORT'  orof 'USHORT' orof 'LONG'    orof 'ULONG'   orof 'SIGNED'       orof 'UNSIGNED' orof 'BOOL'
  orof 'INT64' orof 'UINT64' orof 'REAL'   orof 'SREAL'   orof 'BFLOAT4' orof 'BFLOAT8'      orof 'DECIMAL'  orof 'PDECIMAL'
  orof 'DATE'  orof 'TIME'   orof 'STRING' orof 'CSTRING' orof 'PSTRING' orof 'ASTRING'      orof 'BSTRING'  orof 'USTRING'
  orof 'ANY'   orof 'GROUP'  orof 'QUEUE'  orof 'FILE'    orof 'VIEW'    orof 'WINDOW'       orof 'REPORT'   orof 'APPLICATION'
  orof 'KEY'   orof 'INDEX'  orof 'BLOB'   orof 'MEMO'    orof 'RECORD'  orof 'STRINGTHEORY'
    return 1
  end
  if self.syms &= NULL then return 0.
  td = self.syms.FindTypeDef(upper(pTypeU))                                    ! a NAMED type: a GROUP, QUEUE or RECORD type is data,
  if ~td then return 0.                                                        !   a CLASS is an object
  get(self.syms.types, td)
  if errorcode() then return 0.
  return choose(self.syms.types.kind <> vs:tkClass)


! ------------------------------------------------------------------------------------
! Can the object be read without being named? A parameter (the caller has a name for it), a reference
! taken on it or on its buffer (r &= st, r &= st.valuePtr), a method of a class the procedure declares
! (those share its data), or the object or its buffer handed whole to a call whose summary does not
! say it only reads it - which may keep a reference. 1 = it can.
! ------------------------------------------------------------------------------------
VitEngine.ObjEscapes Procedure(STRING pNameU, LONG pAtTok)
sc   long,auto
row  long,auto
k    long,auto
t    string(vs:maxName),auto
nx   string(vs:maxName),auto
  code
  if self.syms &= NULL then return 1.
  sc = self.syms.ScopeContaining(pAtTok, vs:scProc, vs:scMethod)
  if ~sc then return 1.
  row = self.syms.FindOwn(pNameU, sc)
  if ~row then return 1.
  get(self.syms.syms, row)
  if errorcode() or self.syms.syms.isRef then return 1.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 1.
  if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then return 1.             ! a parameter: the caller has a name for it
  if self.MayHaveLocalMethods(sc)
    if self.UsedInLocalMethods(pNameU, self.syms.scopes.startTok, self.syms.scopes.endTok) then return 1.
    self.syms.scopes.scopeId = sc
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if errorcode() then return 1.
  end
  loop k = self.syms.scopes.startTok to self.syms.scopes.endTok
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    t = upper(self.tk.tokens.tok)
    if t = '&='                                                                  ! a reference taken on it
      if self.NameRoot(self.tk.GetTok(k + 1)) = pNameU then return 1.
      cycle
    end
    if t = clip(pNameU) & '.VALUEPTR'                                            ! its buffer, as one token
      nx = self.tk.GetTok(k + 1)
      if nx <> ')' and nx <> ',' then cycle.
    elsif t <> pNameU
      cycle
    elsif self.tk.GetTok(k + 1) = '.'                                            ! the head of a split dotted call
      if upper(self.tk.GetTok(k + 2)) <> 'GETVALUEPTR' then cycle.
      if self.tk.GetTok(k + 4) <> ')' then cycle.
      nx = self.tk.GetTok(k + 5)
      if nx <> ')' and nx <> ',' then cycle.
    end
    if self.tk.GetTok(k - 1) <> '(' and self.tk.GetTok(k - 1) <> ',' then cycle.
    if ~inlist(self.ArgFact(k, ''), 'R', 'F') then return 1.                     ! handed whole to a call that may keep it
  end
  return 0

! ------------------------------------------------------------------------------------
! Can the object be reached under another name in the procedure or method holding pAt? Asked by a
! builtin that changes what the object holds, or when, where the input did not. pWhat adds up:
!   1  a reference taken on it or on a part of it (r &= st, r &= st.valuePtr, r &= st.getValuePtr()),
!      or the object or its buffer handed whole to a call that may keep a reference to it. A call is
!      no obstacle only when the summary of the body says it reads or writes that parameter and keeps
!      no reference to it, or it is a plain call on the pure list, or a StringTheory's own setValue or
!      append on a plain local, which only copies it (StCopyRecv, ruled 30 Oct 2026); a call the tool
!      cannot see into may keep one (ruled 28 Oct 2026). A call on pAt's own line is the site's, judged
!      by the caller.
!   2  the object is given Stream(): from then on each value it is given sends the one before to a
!      file, so a change to the values it holds, or to when it holds them, changes the file.
!   4  the caller has built the summaries already; else they are built here, once, when a call needs one.
!   8  only the object's LINES matter to the caller: its buffer, bound to a reference or handed to a
!      call, is no way to them.
! Answers why, as a phrase for the report, or blank when nothing reaches it. pNameU is a name, upper
! case, plain or a member such as SELF.BUF. For a member, a reference on anything with the same root
! counts - on SELF.BUF, on another member, or on SELF itself - which is wider than the member, never
! narrower; and an object that holds it, handed whole to a call, hands the member with it.
! ------------------------------------------------------------------------------------
VitEngine.ObjReach Procedure(STRING pNameU, LONG pAt, BYTE pWhat)
scF    long,auto
scL    long,auto
k      long,auto
ln     long,auto
sums   byte,auto
t      string(vs:maxName),auto
nx     string(vs:maxName),auto
selfU  string(vs:maxName),auto
  code
  if self.syms &= NULL then return 'the procedure around it cannot be read'.
  k = self.syms.ScopeContaining(pAt, vs:scProc, vs:scMethod)
  if ~k then return 'the procedure around it cannot be read'.
  self.syms.scopes.scopeId = k
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 'the procedure around it cannot be read'.
  scF   = self.syms.scopes.startTok
  scL   = self.syms.scopes.endTok
  selfU = self.syms.scopes.selfClass
  ln    = self.LineOfTok(pAt)
  sums  = band(pWhat, 4)
  loop k = scF to scL
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    t = upper(self.tk.tokens.tok)
    if t = '&='
      nx = self.tk.GetTok(k + 1)
      if ~band(pWhat, 1) or self.NameRoot(nx) <> self.NameRoot(pNameU) then cycle.
      if band(pWhat, 8)
        if upper(nx) = clip(pNameU) & '.VALUEPTR' then cycle.
        if self.tk.GetTok(k + 2) = '.' and upper(self.tk.GetTok(k + 3)) = 'GETVALUEPTR' then cycle.
      end
      return 'a reference to ' & clip(nx) & ' is taken on line ' & self.LogLineOf(k) & |
             ' - a second name for it, through which it can be reached unseen'
    end
    if t = clip(pNameU) & '.VALUEPTR'
      if band(pWhat, 8) then cycle.
      nx = self.tk.GetTok(k + 1)
      if nx <> ')' and nx <> ',' then cycle.
    elsif t <> pNameU
      if ~self.NameHolds(t, pNameU) then cycle.
      if self.tk.GetTok(k + 1) = '.' then cycle.
    elsif self.tk.GetTok(k + 1) = '.'
      nx = upper(self.tk.GetTok(k + 2))
      if band(pWhat, 2) and nx = 'STREAM'
        return clip(self.tk.GetTok(k)) & '.' & clip(self.tk.GetTok(k + 2)) & ' on line ' & self.LogLineOf(k) & |
               ' writes what it holds to a file each time its value is replaced, and this change alters what it is given, or when'
      end
      if nx <> 'GETVALUEPTR' or band(pWhat, 8) then cycle.
      if self.tk.GetTok(k + 4) <> ')' then cycle.
      nx = self.tk.GetTok(k + 5)
      if nx <> ')' and nx <> ',' then cycle.
    end
    if ~band(pWhat, 1) then cycle.
    nx = self.tk.GetTok(k - 1)
    if nx <> '(' and nx <> ',' then cycle.
    if self.LineOfTok(k) = ln then cycle.
    if ~sums then self.BuildSummaries() ; sums = 1.
    if inlist(self.ArgFact(k, selfU), 'R', 'W', 'P', 'F') then cycle.
    return clip(self.tk.GetTok(k)) & ' is handed whole to a call on line ' & self.LogLineOf(k) & |
           ', which may keep a reference to it and reach it later unseen'
  end
  return ''

! ------------------------------------------------------------------------------------
! Is pNameU a member of pOuterU, at any depth - SELF.BUF of SELF, GRP:A.ST of GRP? Both upper case.
! A '.' and a ':' qualify alike. An object that holds a member, handed whole, hands the member too.
! ------------------------------------------------------------------------------------
VitEngine.NameHolds Procedure(STRING pOuterU, STRING pNameU)
lo  long,auto
  code
  lo = len(clip(pOuterU))
  if ~lo or lo >= len(clip(pNameU)) then return 0.
  if pNameU[1 : lo] <> pOuterU[1 : lo] then return 0.
  return choose(pNameU[lo + 1] = '.' or pNameU[lo + 1] = ':')

! ------------------------------------------------------------------------------------
! Is the StringTheory named at pTok a PLAIN local - one that only the code around it can reach, and that
! nothing in that code marks, streams or hands on? Asked by the isPlain() rule guard, when it runs, so the
! answer is the code as it stands. The respellings of setValue as a call that works in place keep the
! base64 and encoding marks setValue clears, and on a streamed object they change what reaches the file,
! so they are exact only on such an object (ruled 29 Oct 2026). 1 = plain:
!   - one plain name, declared StringTheory in column 1 of the procedure or method around pTok - not a
!     parameter, a reference, STATIC or THREAD, and not in a PROGRAM's main code - or in the DATA of
!     the ROUTINE around pTok, which the compiler looks in first; its mentions are then the routine's own;
!   - no method of a class the procedure declares names it, and nothing is INCLUDEd there;
!   - no mention of it calls a member that sets the marks (fl:writers), _StealValue or Stream, takes a
!     reference on it or on its buffer, hands it whole to a call, or gives it another object's value with
!     setValue, append or prepend, which copies that object's marks, or a USTRING's with a
!     one-argument setValue, which marks it UTF-16.
! ------------------------------------------------------------------------------------
VitEngine.IsPlainAt Procedure(LONG pTok)
nm    STRING(vs:maxName)
t     STRING(vs:maxName)
m     STRING(vs:maxName)
tU    STRING(vs:maxName)
rf    BYTE
sc    long,auto
rsc   long,auto
row   long,auto
decl  long,auto
scF   long,auto
scL   long,auto
k     long,auto
n     long,auto
a     long ! no AUTO: may be read before it is set
  code
  if self.syms &= NULL then return 0.
  nm = upper(self.tk.GetTok(pTok))
  n = len(clip(nm))
  if ~n or n + 1 >= size(t) or instring('.', nm[1 : n], 1, 1) then return 0.
  sc = self.syms.ScopeContaining(pTok, vs:scProc, vs:scMethod)
  if ~sc then return 0.
  row = 0
  rsc = self.syms.ScopeContaining(pTok, vs:scRoutine, vs:scRoutine)
  if rsc then row = self.syms.FindSym(nm, rsc).
  if ~row then rsc = 0.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 0.
  if self.syms.scopes.kind = vs:scMain and ~rsc then return 0.
  scF = self.syms.scopes.startTok
  scL = self.syms.scopes.endTok
  if ~rsc then row = self.syms.FindOwn(nm, sc).
  if ~row then return 0.
  get(self.syms.syms, row)
  if errorcode() or self.syms.syms.isRef or upper(self.syms.syms.typeU) <> 'STRINGTHEORY' then return 0.
  decl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(decl) then return 0.
  if band(self.DeclAttrBits(decl), ab:static + ab:thread) then return 0.
  if self.ScopeIncludes(sc) then return 0.
  if self.MayHaveLocalMethods(sc) and self.UsedInLocalMethods(nm, scF, scL) then return 0.
  if rsc
    get(self.syms.scopes, rsc)
    if errorcode() then return 0.
    scF = self.syms.scopes.startTok
    scL = self.syms.scopes.endTok
  end
  loop k = scF to scL
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    t = upper(self.tk.tokens.tok)
    if t = nm and self.DgIsMemberDot(k + 1)
      m = upper(self.tk.GetTok(k + 2)) ; a = k + 3
    elsif t[1 : n + 1] = clip(nm) & '.'
      m = t[n + 2 : size(t)] ; a = k + 1
    elsif t = nm
      if self.tk.GetTok(k - 1) = '&=' or self.tk.GetTok(k + 1) = '&=' then return 0.
      if self.tk.GetTok(k - 1) <> '(' and self.tk.GetTok(k - 1) <> ',' then cycle.
      if self.tk.GetTok(k + 1) <> ')' and self.tk.GetTok(k + 1) <> ',' then cycle.
      return 0                                          ! handed whole to a call
    else
      cycle
    end
    if self.tk.GetTok(k - 1) = '&=' then return 0.      ! a reference on its buffer
    if m = 'STREAM' or m = '_STEALVALUE' then return 0.
    if ~self.ignoreMarks and instring(' ' & clip(m) & ' ', fl:writers, 1, 1) then return 0. ! --ignoremarks
    if m <> 'SETVALUE' and m <> 'APPEND' and m <> 'PREPEND' then cycle.
    if self.tk.GetTok(a) <> '(' then cycle.
    if self.tk.GetTok(a + 2) <> ')' and self.tk.GetTok(a + 2) <> ',' then cycle.
    get(self.tk.tokens, a + 1)
    if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    if ~self.syms.Lookup(self.tk.tokens.tok, a + 1, tU, rf) or upper(tU) = 'STRINGTHEORY' or ~self.UvPlainType(upper(tU)) then return 0.
    if m = 'SETVALUE' and upper(tU) = 'USTRING' and self.tk.GetTok(a + 2) = ')' then return 0.
  end
  return 1

! ------------------------------------------------------------------------------------
! The isPlain() rule guard asks the engine that owns this asker.
! ------------------------------------------------------------------------------------
VitEnginePlainAsk.IsPlain Procedure(LONG pTok)
  code
  if self.eng &= NULL then return 0.
  return self.eng.IsPlainAt(pTok)

! ------------------------------------------------------------------------------------
! The marksSafe() rule guard: under --ignoremarks the marks are the user's own risk, so any object
! answers 1; without it, the isPlain() answer - a plain local nothing marks.
! ------------------------------------------------------------------------------------
VitEnginePlainAsk.MarksSafe Procedure(LONG pTok)
  code
  if self.eng &= NULL then return 0.
  if self.eng.ignoreMarks then return 1.
  return self.eng.IsPlainAt(pTok)

! ------------------------------------------------------------------------------------
! Before a pass makes every later mention of the local pFromU name the local pToU instead - a
! take-over, a line buffer dropped onto its source, two locals merged into one - are the two
! declared with the same type? A class derived from StringTheory that only adds methods of its own
! is a StringTheory to every question asked of its type (ruled 30 Oct 2026), so both pass a pass's
! StringTheory test. But a method or property of that class, renamed onto a plain StringTheory,
! does not compile, and an object handed whole to a call may then reach another procedure of the
! same name. So both must be locals of the scope pSc, declared in column 1 with the same type word.
! Answers '' when they are, else the reason.
! ------------------------------------------------------------------------------------
VitEngine.RenameTypeWhy Procedure(STRING pFromU, STRING pToU, LONG pSc)
r    long,auto
fD   long
tD   long
fT   STRING(vs:maxName)
tT   STRING(vs:maxName)
  code
  if self.syms &= NULL or self.rl &= NULL then return 'the declarations cannot be read'.
  r = self.syms.FindOwn(pFromU, pSc)
  if r
    get(self.syms.syms, r)
    if ~errorcode() then fD = self.syms.syms.declTok.
  end
  r = self.syms.FindOwn(pToU, pSc)
  if r
    get(self.syms.syms, r)
    if ~errorcode() then tD = self.syms.syms.declTok.
  end
  if fD and self.syms.IsColOneLabel(fD)
    fT = self.tk.GetTok(fD + 1)
    if fT = '&' then fT = self.tk.GetTok(fD + 2).
  end
  if tD and self.syms.IsColOneLabel(tD)
    tT = self.tk.GetTok(tD + 1)
    if tT = '&' then tT = self.tk.GetTok(tD + 2).
  end
  if ~self.rl.IsLabelToken(fT) or ~self.rl.IsLabelToken(tT)
    return 'the declarations of ' & clip(pFromU) & ' and ' & clip(pToU) & ' cannot be read as two locals of one type'
  end
  if upper(fT) = upper(tT) then return ''.
  return clip(self.tk.GetTok(fD)) & ' is a ' & clip(fT) & ' and ' & clip(self.tk.GetTok(tD)) & ' a ' & clip(tT) &                          |
         ': renamed onto ' & clip(self.tk.GetTok(tD)) & ', its calls would be made on an object of another class, which may not have them'

! ------------------------------------------------------------------------------------
! Is pNameU used in a LOCAL DERIVED METHOD of the procedure [pProcStart, pProcEnd]? The
! methods of a class declared in a procedure's data section share its local data (the ABC
! ThisWindow.Init shape), and their bodies follow the procedure, outside its span - so a
! local read only there looks unread from inside it. A method whose class this file
! declares nowhere may be one of them and counts too: the direction that keeps the
! variable. The names those methods use are listed once per procedure, ' A B C ', and every
! later question about the same procedure is a lookup; a pass that asks resets the list.
! A use spelled `cfg.Color` or `ga:x` is ONE token (the tokenizer merges a field reference),
! so its root before the first '.' or ':' is listed too - the credit RemoveUnusedPass gives
! the same spelling inside the procedure. Without it a local used in a method only through
! its fields looked unused there, and UnusedVars commented out a declaration still in use.
! A method that INCLUDEs a file after its CODE may use any of the procedure's data in the
! text this stream does not have, so then every name counts as used.
! ------------------------------------------------------------------------------------
VitEngine.UsedInLocalMethods Procedure(STRING pNameU, LONG pProcStart, LONG pProcEnd)
r       long,auto
i       long,auto
nextP   long,auto
mStart  long,auto
mEnd    long,auto
mCls    string(vs:maxName),auto
dotP    long,auto
colP    long,auto
fileCls StringTheory
  code
  if pProcStart <> self.lmProcS or pProcEnd <> self.lmProcE
    self.lmProcS = pProcStart
    self.lmProcE = pProcEnd
    self.lmNames.setValue(' ')
    self.lmInc = 0
    self.FileClassList(fileCls)
    nextP = self.tk.records() + 1
    loop r = 1 to records(self.syms.scopes)
      get(self.syms.scopes, r)
      if errorcode() then break.
      if self.syms.scopes.kind = vs:scProc and self.syms.scopes.startTok > pProcEnd and self.syms.scopes.startTok < nextP
        nextP = self.syms.scopes.startTok
      end
    end
    loop r = 1 to records(self.syms.scopes)
      get(self.syms.scopes, r)
      if errorcode() then break.
      if self.syms.scopes.kind <> vs:scMethod then cycle.
      mStart = self.syms.scopes.startTok
      mEnd   = self.syms.scopes.endTok
      mCls   = self.syms.scopes.selfClass
      if mStart <= pProcEnd or mStart >= nextP or mEnd < mStart then cycle.
      if ~self.LocalClassDeclared(mCls, pProcStart, pProcEnd)
        if fileCls.findChars(' ' & clip(mCls) & ' ') then cycle.
      end
      if self.ProcIncludes(mStart, mEnd) then self.lmInc = 1.
      loop i = mStart to mEnd
        get(self.tk.tokens, i)
        if errorcode() then break.
        if self.tk.tokens.tok &= NULL then cycle.
        case upper(self.tk.tokens.tok[1])
        of 'A' to 'Z' orof '_'
          self.lmNames.append(upper(self.tk.tokens.tok) & ' ')
          dotP = fileCls.findByte(46, 1,, self.tk.tokens.tok)
          colP = fileCls.findByte(58, 1,, self.tk.tokens.tok)
          if colP and (~dotP or colP < dotP) then dotP = colP.
          if dotP > 1 then self.lmNames.append(upper(self.tk.tokens.tok[1 : dotP - 1]) & ' ').
        end
      end
    end
  end
  if self.lmInc then return 1.
  return self.lmNames.findChars(' ' & clip(pNameU) & ' ')

! ------------------------------------------------------------------------------------
! Every column-1 `<label> CLASS` in the file, as ' A B C ' - one scan, for the tests above.
! ------------------------------------------------------------------------------------
! ------------------------------------------------------------------------------------
! UnusedRoutines' index, one walk of the file per pass (14 Sep 2026). RoutineReferenced
! asked "is there a `DO name` in this span" by walking the span, once per routine and once
! per method the routine might be DOne from, and LocalClassDeclared walked the owner's data
! section for every method it was asked about: routines times file size - 8.2 s of
! VitEngine.clw's 30 s run, for 456 routines in 214 methods. The walk below lists every DO
! with both its tokens and every column-1 CLASS declaration with the CODE statement before
! it; the two questions become lookups that give the same answers (the same span test on the
! DO pair, the same data-section test on the declaration). Valid while doIdxOn is set: the
! pass only prefixes trivia, so no token moves while it runs.
! ------------------------------------------------------------------------------------
VitEngine.BuildDoIndex Procedure()
i        long,auto
prevDo   long,auto
lastCode long,auto
tU       STRING(vs:maxName),auto
  code
  free(self.doRefs) ; free(self.clsDecls)
  prevDo = 0 ; lastCode = 0
  loop i = 1 to records(self.tk.tokens)
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then cycle. ! EOL trivia: a DO and its name may sit on two lines
    tU = upper(self.tk.tokens.tok)
    if prevDo
      clear(self.doRefs)
      self.doRefs.drName = tU
      self.doRefs.drDo   = prevDo
      self.doRefs.drAt   = i
      add(self.doRefs)
      prevDo = 0
    end
    if tU = 'DO' then prevDo = i.
    if self.tk.tokens.firstOnLine
      if tU = 'CODE' and ~self.syms.IsColOneLabel(i)
        lastCode = i
      elsif self.syms.IsColOneLabel(i) and upper(self.tk.GetTok(i + 1)) = 'CLASS'
        clear(self.clsDecls)
        self.clsDecls.cdName = tU
        self.clsDecls.cdPos  = i
        self.clsDecls.cdCode = lastCode
        add(self.clsDecls)
      end
    end
  end
  sort(self.doRefs, self.doRefs.drName, self.doRefs.drDo)

VitEngine.FileClassList Procedure(StringTheory pOut)
i   long,auto
  code
  pOut.setValue(' ')
  loop i = 1 to self.tk.records()
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or ~self.tk.tokens.firstOnLine then cycle.
    if upper(self.tk.GetTok(i + 1)) <> 'CLASS' or ~self.syms.IsColOneLabel(i) then cycle.
    pOut.append(upper(self.tk.tokens.tok) & ' ')
  end


! ------------------------------------------------------------------------------------
! Does the procedure span [pStart, pEnd] INCLUDE a file after its CODE statement? A
! routines file spliced in there can hold the only DO of a routine declared here, and
! this stream does not have it (--thorough splices includes for the TYPE registry, not
! for the text that is analysed). An INCLUDE in the DATA section brings declarations,
! never a DO, and does not count here; a question about the scope's DATA asks
! ScopeIncludes, below. The CODE statement is found the way UnusedVars finds
! it: the word CODE first on its line and not in column 1 (a column-1 CODE is a label);
! a span with no CODE statement is searched from its first token, the safe direction.
! ------------------------------------------------------------------------------------
VitEngine.ProcIncludes Procedure(LONG pStart, LONG pEnd)
i     long,auto
from  long,auto
  code
  from = pStart
  loop i = pStart to pEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or ~self.tk.tokens.firstOnLine or self.tk.BufColOne() then cycle.
    if upper(self.tk.tokens.tok) = 'CODE' then from = i ; break.
  end
  loop i = from to pEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'INCLUDE' and self.tk.GetTok(i + 1) = '(' then return 1.
  end
  return 0

! ------------------------------------------------------------------------------------
! Can code this stream does not hold reach the data of scope pScopeId? An INCLUDE anywhere
! in the scope - its data section (a WINDOW control's USE(v), a declaration OVER(v)), its
! code or one of its routines - brings in text no walk here reads (--thorough splices
! includes for the TYPE registry, not for the text that is analysed). For a procedure, so
! does an INCLUDE in the body of a method of a class it declares: such a method shares the
! procedure's data, and its body follows the procedure. Every method between the procedure
! and the next procedure is looked in, whatever its class - the direction that keeps, and
! one walk of those tokens rather than a walk of the whole file per procedure. The scope
! rows follow the file, so the next procedure is the first one in a later row; a row out of
! that order could only make the walk longer. A proof about the scope's data drawn from its
! tokens alone does not hold when the answer is 1. The scopes buffer is left on the row of
! pScopeId.
! ------------------------------------------------------------------------------------
VitEngine.ScopeIncludes Procedure(LONG pScopeId)
i     long,auto
r     long,auto
s     long,auto
e     long,auto
last  long,auto
  code
  if self.syms &= NULL then return 1.
  get(self.syms.scopes, pScopeId)
  if errorcode() then return 1.
  s = self.syms.scopes.startTok
  e = self.syms.scopes.endTok
  last = e
  if self.syms.scopes.kind = vs:scProc
    last = self.tk.records()
    loop r = pScopeId + 1 to records(self.syms.scopes)
      get(self.syms.scopes, r)
      if errorcode() then break.
      if self.syms.scopes.kind <> vs:scProc or self.syms.scopes.startTok <= e then cycle.
      last = self.syms.scopes.startTok - 1
      break
    end
    get(self.syms.scopes, pScopeId)
  end
  loop i = s to last
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'INCLUDE' and self.tk.GetTok(i + 1) = '(' then return 1.
  end
  return 0

! ------------------------------------------------------------------------------------
! Must the scope pScopeId ask UsedInLocalMethods? Every caller asks this first (ruled 30 Oct 2026). A method of a class declared in a data
! section shares that section's data, and its body follows, outside the scope's span. A
! PROCEDURE is always asked. A METHOD is asked when its own data section declares a CLASS,
! or INCLUDEs a file that may declare one: a method has a data section of its own, and a class
! declared there has methods that share it the same way. Asking for every method would list
! every later method of a class this file does not declare, which in a file of one class's
! methods is all of them. Any other scope, or a row that cannot be read, is not asked. The
! scopes buffer is left on the row of pScopeId.
! ------------------------------------------------------------------------------------
VitEngine.MayHaveLocalMethods Procedure(LONG pScopeId)
i     long,auto
e     long,auto
  code
  if self.syms &= NULL then return 0.
  get(self.syms.scopes, pScopeId)
  if errorcode() then return 0.
  if self.syms.scopes.kind = vs:scProc then return 1.
  if self.syms.scopes.kind <> vs:scMethod then return 0.
  e = self.syms.scopes.endTok
  loop i = self.syms.scopes.startTok + 1 to e
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or ~self.tk.tokens.firstOnLine then cycle.
    if upper(self.tk.tokens.tok) = 'CODE' and ~self.syms.IsColOneLabel(i) then break.
    if self.syms.IsColOneLabel(i) and upper(self.tk.GetTok(i + 1)) = 'CLASS' then return 1.
    if upper(self.tk.GetTok(i)) = 'INCLUDE' and self.tk.GetTok(i + 1) = '(' then return 1.
  end
  return 0

! ------------------------------------------------------------------------------------
! Comment out a whole token span by '!'-prefixing the first-on-line token of every line
! it covers.  Each content line's first token carries only that line's indent in its
! strBefore (physical newlines are separate <10> tokens), so the '!' lands at line start.
! Blank / comment-only lines have no first-on-line CONTENT token (their sole token is the
! <10>), so are left as-is (already inert).  pHeader replaces '!' on the first line.
! PrependStrBefore leaves token positions unchanged -> caller indices stay valid.
! Returns lines commented (>=1 for a real routine).
! ABSORBED trivia lines: a token's strBefore can hold WHOLE PHYSICAL LINES with no
! tokens of their own (an OMIT block's prose, swallowed text), which the per-line '!'
! can therefore never reach - CommentTriviaLines gives each of those its own '!'
! skipping blank and already-comment lines. CommentLineStart's
! after-the-last-<10> insert covers the token's own line, so between them every
! physical line of the span comes back inert and visibly commented.
! ------------------------------------------------------------------------------------
VitEngine.CommentOutSpan Procedure(LONG pStartTok, LONG pEndTok, STRING pHeader)
i      long,auto
lines  long
  code
  loop i = pStartTok to pEndTok
    get(self.tk.tokens, i)
    if errorcode() then break.
    if i > pStartTok then self.CommentTriviaLines(i).               ! pStartTok's strBefore is the gap ABOVE the span - not ours
    if ~self.tk.tokens.firstOnLine or                               |
       self.tk.tokens.tok &= NULL  or                               |
       size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' ! EOL token - not real content
      cycle
    end
    if i = pStartTok
      self.CommentLineStart(i, pHeader)                             ! physical-line-start insert (continuation/OMIT text lives in strBefore)
    else
      self.CommentLineStart(i, '!')
    end
    lines += 1
  end
  return lines

! ------------------------------------------------------------------------------------
! Give every COMPLETE physical line inside pTok's strBefore its own '!' - the lines
! that exist only as absorbed trivia and so can never be reached by per-token
! commenting. A segment is a complete line when a <10> inside this strBefore
! TERMINATES it; the FINAL segment (after the last <10>) is the token's own line
! start and belongs to CommentLineStart. The FIRST segment (before any <10>) is
! banged only when the PREVIOUS token is an EOL token - then it genuinely starts a
! physical line (the absorbed-OMIT shape: the directive line itself heads the blob,
! and banging it dissolves the region so every line inside is a plain comment on the
! next parse). When the previous token is mid-line content, the first segment is the
! TAIL of the line above and a '!' there kills live code. Blank segments and segments
! already leading with '!' are skipped: comments stay single-banged, blanks blank.
! ------------------------------------------------------------------------------------
VitEngine.CommentTriviaLines Procedure(LONG pTok)
sb      StringTheory
out     StringTheory
k       long,auto
j       long,auto
lastN   long,auto
need    byte,auto
prevEol byte
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return.
  if self.tk.tokens.strBefore &= NULL then return.
  sb.setValue(self.tk.tokens.strBefore)
  lastN = 0
  loop k = 1 to sb._DataEnd
    if sb.valuePtr[k] = '<10>' then lastN = k.
  end
  if ~lastN then return.                    ! no line-break: nothing complete lives inside
  if pTok > 1
    get(self.tk.tokens, pTok - 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL
      if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then prevEol = 1.
    end
  end
  out.free()
  k = 1
  do SegNeed                                ! the first segment [1..first <10>)
  if prevEol and need then out.append('!'). !   is a line start only after an EOL token
  loop while k <= sb._DataEnd
    if sb.valuePtr[k] <> '<10>'
      out.append(sb.valuePtr[k])
      k += 1
      cycle
    end
    out.append(sb.valuePtr[k])              ! the <10> itself
    k += 1
    if k > lastN then break.                ! final segment - the token's own line start
    do SegNeed
    if need then out.append('!').
  end
  if k <= sb._DataEnd then out.append(sb.valuePtr[k : sb._DataEnd]).
  self.tk.SetStrBefore(pTok, out.getValue())

SegNeed routine                             ! does the segment starting at k earn a '!'?
  need = 0                                  ! blank or already-comment: no
  loop j = k to sb._DataEnd
    case val(sb.valuePtr[j])
    of 10                                   ! the segment ends
      break
    of 32 orof 9 orof 13                    ! space, tab, the CR of a CRLF - not content
      cycle
    end
    need = choose(sb.valuePtr[j] <> '!')
    break
  end

! ====================================================================================
! BUILTIN UnreachableCode - comment out code that can never execute:
! statements after an UNCONDITIONAL transfer of control (RETURN/EXIT/BREAK/CYCLE/GOTO)
! up to the next control-flow rejoin point.  Uses the same tokenizer level-mark walk as
! AutoCheck.  Comment-out (never delete), wantReparse so the commented dead lines vanish
! and a re-scan converges.
!
! Model - walk each proc/method main code + each routine body, tracking block-nesting
! DEPTH via level marks and a `dead` flag with the depth `deadDepth` at which the transfer
! occurred.  A whole-line transfer keyword sets dead for SUBSEQUENT lines.  `dead` clears
! (control can re-enter) at: a col-1 label (GOTO/jump target); a line that opens a block
! with a col-1 label inside it (a jump to that label runs on to the block's END, so the
! opener stays); a sibling branch of the transfer's own block (ELSE/ELSIF/OF/OROF, or a
! '/' level, at depth = deadDepth); the close of the transfer's enclosing block ('-'
! dropping depth below deadDepth).  A top-level transfer (deadDepth 0) kills everything
! until a label or the scope end.
! A transfer INSIDE a dead region starts nothing: the region it is in already runs to
! the end of its block, so its END, ELSE and OF are dead with the rest.
!
! Safety (a wrong comment = deleting LIVE code): heavily under-reach.  `if x then return`
! is CONDITIONAL - not detected (stmtKw is IF, not RETURN).  A level underflow bails the
! scope (tracking lost -> stop).  Any rejoin clears dead.  We only ever comment lines that
! strictly follow a whole-line transfer within its own branch.
! Edges: a MID-LINE transfer is never detected (stmtKw is the
!     line's first word, so `case n ; of 1 ; x = 1 ; return ; ...` starts no deadness -
!     under-reach, safe), and a DEAD line whose tail holds a rejoin - `x = 1 ; of 2 ;
!     x = 2`, or `y = 1 ; end` closing the enclosing block - is REFUSED whole rather
!     than commented, because '!' comments to end of line and would take the live arm
!     or the structure with it (TailRejoinChk; pinned in the fixture).
! ------------------------------------------------------------------------------------
VitEngine.BuiltinUnreachableCode Procedure(StringTheory pLog)
prefix  StringTheory
raw     StringTheory
s       long,auto
changes long,AUTO
  code
  if self.syms &= NULL then return 0.

  prefix.setValue('! #Unreachable: ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      if upper(self.rl.rules.bparmQ.name) = 'PREFIX' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        prefix.setValue(raw)
      end
    end
  end

  changes = self.RemoveUnreachablePass(prefix, pLog)
  if changes
    self.wantReparse = true ! commented dead lines must vanish before the next scan
    pLog.append('BUILTIN UnreachableCode: ' & changes & ' line(s) commented this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! Determine each executable range and walk it.  Proc/method: [CODE+1 .. before-first-
! child-routine].  Routine: [CODE+1 .. end] or, if no CODE keyword, [first line after the
! ROUTINE header .. end].  strBefore-only edits leave scope indices valid across the scan.
! ------------------------------------------------------------------------------------
VitEngine.RemoveUnreachablePass Procedure(StringTheory pPrefix, StringTheory pLog)
r        long,auto
rr       long,auto
kind     long,auto
scId     long,auto
startT   long,auto
endT     long,auto
mainEnd  long,auto
codeT    long,auto
exStart  long,auto
condKept long ! scopes not examined - they hold an OMIT or COMPILE block
changes  long
  code
  loop r = 1 to records(self.syms.scopes)
    get(self.syms.scopes, r)
    if errorcode() then break.
    kind   = self.syms.scopes.kind
    scId   = self.syms.scopes.scopeId
    startT = self.syms.scopes.startTok
    endT   = self.syms.scopes.endTok
    if endT < startT then cycle.
    if self.ScopeIsConditional(startT, endT)           ! OMIT/COMPILE - see the banner on it
      condKept += 1                                    !   and SAY SO at the end, like its two siblings
      cycle
    end

    if kind = vs:scProc or kind = vs:scMethod
      mainEnd = endT
      loop rr = 1 to records(self.syms.scopes)         ! stop main code before the first child routine
        get(self.syms.scopes, rr)
        if self.syms.scopes.kind = vs:scRoutine and self.syms.scopes.parentId = scId
          if self.syms.scopes.startTok > startT and self.syms.scopes.startTok - 1 < mainEnd
            mainEnd = self.syms.scopes.startTok - 1
          end
        end
      end
      codeT = self.CodeTokOfScope(startT, mainEnd)
      if codeT
        if self.LevelSpanBalanced(codeT + 1, mainEnd)
          changes += self.WalkUnreachable(codeT + 1, mainEnd, pPrefix, pLog)
        else
          pLog.append('BUILTIN UnreachableCode: scope at line ' & self.LogLineOf(startT) & ' is level-unbalanced - NOT examined (refusal over restructuring)<13,10>')
        end
      end
    elsif kind = vs:scRoutine
      codeT = self.CodeTokOfScope(startT, endT)
      if codeT
        exStart = codeT + 1
      else
        exStart = self.FirstTokAfterLine(startT)       ! simple routine (no DATA/CODE) - body starts next line
      end
      if exStart
        if self.LevelSpanBalanced(exStart, endT)
          changes += self.WalkUnreachable(exStart, endT, pPrefix, pLog)
        else
          pLog.append('BUILTIN UnreachableCode: routine at line ' & self.LogLineOf(startT) & ' is level-unbalanced - NOT examined (refusal over restructuring)<13,10>')
        end
      end
    end
  end
  ! SAY WHAT WAS NOT EXAMINED - this walks SCOPES, so the unit is scopes, not declarations.
  ! Third of the three passes that refused a conditional scope and said nothing about it.
  if condKept
    pLog.append('BUILTIN UnreachableCode: ' & condKept |
       & ' scope(s) NOT examined - each holds an OMIT or COMPILE block, so a line reached only from a compiled-out branch would read as unreachable<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! Net level balance of a token span: +1 per '+', -1 per '-' OR an unmarked vt:end
! (the inline-dot idiom). Returns 0 when opens outlive the span - the corruption
! case: a walk over it inflates its depth and never rejoins. Underflow is
! NOT a refusal: a range often ends inside its enclosing block, and every walk
! already bails safely on depth < 0.
! ------------------------------------------------------------------------------------
VitEngine.LevelSpanBalanced Procedure(LONG pS, LONG pE)
d  long
i  long,auto
  code
  loop i = pS to pE
    get(self.tk.tokens, i)
    if errorcode() then break.
    case val(self.tk.tokens.level)
    of 43
      d += 1
    of 45
      d -= 1
    else
      if self.tk.tokens.type = vt:end and self.tk.tokens.level <> '/' then d -= 1.
    end
  end
  return choose(d <= 0)

! ------------------------------------------------------------------------------------
! The dead-state walk over one contiguous code range.  Returns lines commented.
! ------------------------------------------------------------------------------------
VitEngine.WalkUnreachable Procedure(LONG pExecStart, LONG pExecEnd, StringTheory pPrefix, StringTheory pLog)
i         long,auto
fol       byte,auto
lvl       string(1),auto
tty       string(1),auto ! token TYPE, captured with lvl: the unmarked-vt:end belt reads it
isEol     byte,auto
txt       string(vs:maxName),auto
stmtKw    string(vs:maxName)
depth     long
dead      byte
deadDepth long
pendHead  byte
contLine  byte,auto      ! this token opens a '|' CONTINUATION of the line above
prevCmt   byte           !   ... and that line was commented out, so this one must be too
tailRj    byte           ! TailRejoinChk verdict: the dead line's tail holds a rejoin
lblIn     byte           ! LblGoneTo verdict: a GOTO in this code names the label at lgAt
lgAt      long,auto      ! the column-1 label LblGoneTo asks about
lines     long
execStk   BYTE,DIM(64)   ! execStk[depth]=1 when the opener at that depth is EXECUTE
  code
  if pExecStart < 1 or pExecEnd < pExecStart then return 0.
  loop i = pExecStart to pExecEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    fol = self.tk.tokens.firstOnLine
    lvl = self.tk.tokens.level
    tty = self.tk.tokens.type
    ! A '|' CONTINUATION LINE IS NOT A LINE OF ITS OWN, and reading it as one
    ! produced source that DOES NOT COMPILE. The tokenizer marks every continuation token
    ! firstOnLine=1 with the bar and the CRLF in its strBefore (the same trap the hoist
    ! builtin guards at TryEndHoist), so a RETURN whose expression runs over four physical
    ! lines looked like a transfer followed by three dead lines - and this pass commented
    ! the other three out, truncating the expression mid-air:
    !     Return( clip(choose(~L:Days, '', ...) & |
    !   ! #Unreachable:      choose(~L:Hours,'', ...) & |
    ! Clarion rejects that, and the tool had no way to know: VitTimer.clw and three sites
    ! in VitEngine.clw, found by BUILDING extreme-transformed source (bootstrap.bat) -
    ! which is why that check exists and why no text-level gate could have caught it.
    ! A continuation belongs to the statement above it, so it inherits that line's fate:
    ! commented only if the line it continues was commented, and never able to START a
    ! dead region or be read as a transfer keyword of its own.
    contLine = 0
    if fol and not self.tk.tokens.strBefore &= NULL
      if self.TriviaHasContinuation(self.tk.tokens.strBefore) then contLine = 1.
    end
    if self.tk.tokens.tok &= NULL
      txt   = '' ; isEol = 0
    else
      txt = self.tk.tokens.tok
      isEol = choose(size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>')
    end
    if fol and txt and ~isEol then stmtKw = upper(txt).

    ! ---- a.txa EMBED BOUNDARY clears the dead region (the embed rule:
    !      a transfer's deadness must not span embed points - the template-generated
    !      code between them is invisible here and can rejoin flow). The template lines
    !      between embeds survive the wrap as !<250>-marked comments, whose text lands
    !      in the TRIVIA of the tokens that follow them - including the EOL tokens - so
    !      the test runs on every token while dead, not only first-on-line ones. The
    !      byte is 250 SPECIFICALLY: 251 is the shift marker trailing every embedded
    !      code line and must not count. A mid-block PRIORITY group is 250-marked too,
    !      and that is correct - a different priority is a different injection point. ----
    if dead and self.isTxa
      if not self.tk.tokens.strBefore &= NULL
        if pPrefix.findByte(250, 1,, self.tk.tokens.strBefore) then dead = 0. ! '<250>'
      end
    end

    ! ---- control-flow REJOIN clears the dead region (before commenting this line) ----
    if fol and dead
      if self.syms.IsColOneLabel(i)                                           ! GOTO/jump target
        lgAt = i ; do LblGoneTo
        if lblIn or depth = deadDepth then dead = 0.
      elsif depth = deadDepth and (stmtKw = 'OF' or stmtKw = 'OROF' or stmtKw = 'ELSE' or stmtKw = 'ELSIF')
        dead = 0                                                              ! sibling branch of the transfer's own block
      end
    end

    ! ---- block nesting ----
    case val(lvl)
    of 43                                                                     ! '+'
      depth += 1
      if depth >= 1 and depth <= 64
        execStk[depth] = choose(upper(txt) = 'EXECUTE')                       ! is the opener at this depth an EXECUTE? - `Again  execute n`, `x = 1 ; execute n`
      end
    of 47                                                                     ! '/'
      if dead and depth = deadDepth then dead = 0.                            ! else/elsif/of separator (level-marked)
    of 45                                                                     ! '-'
      depth -= 1
      if depth < 0
        dead = 0 ; break                                                      ! level underflow - tracking lost, bail (safe)
      end
      if dead and depth < deadDepth then dead = 0.                            ! transfer's enclosing block closed
    end
    if tty = vt:end and lvl <> '-' and lvl <> '+' and lvl <> '/'
      depth -= 1                                                              ! the inline-dot idiom: a '.' terminator retyped vt:end but
      if depth < 0                                                            !   carrying NO '-' mark. Every sibling walk wears this belt
        dead = 0 ; break                                                      !   (TailRejoinChk here, SmDepthWalk, KrClose...) - this one
      end                                                                     !   lacked it, so depth stayed inflated and the rejoin at the
      if dead and depth < deadDepth then dead = 0.                            !   enclosing ELSE/END never fired: LIVE code was commented
    end

    ! ---- comment a dead content line - unless its TAIL holds a rejoin. The
    !      counterexample: '!' comments to END OF LINE, so a dead line
    !      spelled `x = 1 ; of 2 ; x = 2` would take the LIVE `of 2` arm with it, and
    !      `y = 1 ; end` would take the enclosing block's END. The comment decision
    !      happens HERE, before the loop reaches the tail's '/' and '-' tokens, so the
    !      tail is pre-scanned with a line-local depth (seeded 1 when this line's own
    !      first token opens a block, so a fully-dead `if p then p = 9.` still
    !      comments): an arm separator beyond the line's own opens, or a close that
    !      drops below them - inline dots included, they are retyped vt:end and may
    !      carry no '-' - REFUSES the line whole and deadness ends there. Refusal over
    !      restructuring, as everywhere else: the alternative is inserting a line
    !      break, and this tool does not reshape a line to make its own edit fit. ----
    if fol and dead and txt and ~isEol and contLine
      ! a continuation of the line above: it is not a statement, so it is not a candidate
      ! and not a rejoin. Comment it ONLY if the line it continues was commented, or half
      ! a dead statement is left live.
      if prevCmt
        self.CommentLineStart(i, '!')
        lines += 1
      end
    elsif fol and dead and txt and ~isEol
      do TailRejoinChk
      if tailRj
        dead = 0
        prevCmt = 0
      elsif pendHead
        prevCmt = 1
        self.CommentLineStart(i, pPrefix.getValue())              ! at the PHYSICAL line start - a plain prepend lands after a continuation '|' (prev line) leaving this line LIVE
        pendHead = 0
        lines += 1
      else
        prevCmt = 1
        self.CommentLineStart(i, '!')
        lines += 1
      end
    elsif fol and txt and ~isEol and ~contLine
      prevCmt = 0                                                 ! a live statement line - its continuations stay live
    end

    ! ---- a whole-line unconditional transfer makes SUBSEQUENT lines dead ----
    if fol and ~isEol and ~contLine and self.IsTransferKw(stmtKw) ! ~contLine: a continuation is not a statement of its own
      if depth >= 1 and depth <= 64 and execStk[depth] = 1        ! a transfer ARM of an EXECUTE - the following arms are LIVE alternatives, not dead code
        ! (skip)
      elsif ~dead                                                 ! ONE REGION AT A TIME: a transfer inside dead code is dead too. Starting
        dead = 1 ; deadDepth = depth ; pendHead = 1               !   again at its deeper level ended the region at that block's END, ELSE
      end                                                         !   or OF - left live, so the output did not compile
    end
  end
  return lines

! ---- does the CURRENT line's tail (tokens after i, to its EOL) rejoin control flow
!      beyond the line's own opens? See the refusal comment at the call site. ----
!      A block the line OPENS rejoins too when a column-1 label stands inside it: a GOTO
!      from elsewhere enters the block there and runs on to its END, so the line that opens
!      it must stay - commented out, it would leave that END with nothing to close.
TailRejoinChk routine
  data
tt   long,auto
ttd  long,auto
tlv  string(1),auto
tty  string(1),auto
ttU  string(vs:maxName),auto
bk   long,auto
bd   long,auto
  code
  tailRj = 0
  ttd = choose(lvl = '+')                                                        ! this line's OWN opener - its close in the tail is line-local
  tt = i
  loop
    tt += 1
    get(self.tk.tokens, tt)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.  ! the line ends
    tlv = self.tk.tokens.level
    tty = self.tk.tokens.type
    ttU = upper(self.tk.tokens.tok)
    if tlv = '+'
      ttd += 1
    elsif tlv = '/'
      if ~ttd then tailRj = 1 ; break.                                           ! arm separator beyond the line's own opens
    elsif tlv = '-' or (tty = vt:end and tlv <> '+')                             ! inline '.' terminators are retyped vt:end, often with no '-'
      ttd -= 1
      if ttd < 0 then tailRj = 1 ; break.                                        ! closes the ENCLOSING block
    elsif ~ttd and (ttU = 'OF' or ttU = 'OROF' or ttU = 'ELSE' or ttU = 'ELSIF')
      tailRj = 1 ; break                                                         ! belt: an arm word the level pass left unmarked
    end
  end
  if tailRj then exit.
  tt = i - 1
  loop
    tt += 1
    get(self.tk.tokens, tt)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if self.tk.tokens.level <> '+' then cycle.
    bd = 0
    loop bk = tt to pExecEnd
      get(self.tk.tokens, bk)
      if errorcode() then break.
      tlv = self.tk.tokens.level
      tty = self.tk.tokens.type
      if tlv = '+'
        bd += 1
      elsif tlv = '-' or tty = vt:end
        bd -= 1
        if bd <= 0 then break.
      elsif self.syms.IsColOneLabel(bk)
        lgAt = bk ; do LblGoneTo
        if lblIn then tailRj = 1 ; exit.
      end
    end
  end

! ---- is the column-1 label at lgAt a way into dead code? Only when a GOTO in this code names
!      it - above the label or below it, since a GOTO further down can jump back up. A label no
!      GOTO names cannot be reached, so the dead code around it is dead too and is commented out
!      with it (ruled 28 Oct 2026). A label at the dead stretch's own level still ends it. ----
LblGoneTo routine
  data
lg   long,auto
lk   long,auto
lgU  string(vs:maxName),auto
  code
  lblIn = 0
  lgU = upper(self.tk.GetTok(lgAt))
  loop lg = pExecStart to pExecEnd
    get(self.tk.tokens, lg)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'GOTO' then cycle.
    loop lk = lg + 1 to pExecEnd
      get(self.tk.tokens, lk)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      if upper(self.tk.tokens.tok) = lgU then lblIn = 1.
      break
    end
    if lblIn then break.
  end
  get(self.tk.tokens, lgAt)

! ------------------------------------------------------------------------------------
VitEngine.IsTransferKw Procedure(STRING pKwU)
  code
  case pKwU
  of 'RETURN' orof 'EXIT' orof 'BREAK' orof 'CYCLE' orof 'GOTO'
    return 1
  end
  return 0

! ------------------------------------------------------------------------------------
VitEngine.FirstTokAfterLine Procedure(LONG pTok)
i   long,auto
ln  long,auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  i  = pTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.lineNo > ln then return i.
  end

! ====================================================================================
! BUILTIN UnusedAssignments - "unnecessary code": a variable set up
! then never subsequently used.  v1 = WRITE-ONLY locals: a simple scalar local that is
! ASSIGNED (>=1 whole-var write) but READ nowhere in its scope -> every such assignment is
! a dead store.  Comment each, wantReparse; the var then has no references so UnusedVars
! (if also enabled) removes the declaration next - a clean two-builtin cascade.
!
! Safety (a wrong comment could drop a side effect): heavily under-reach.
!   * eligibility reuses AutoEligible (simple scalar local, not param/ref/like/over/dim,
!     NOT touched in any routine) - so scanning the scope code is a complete usage test.
!   * ANY non-assignment occurrence (RHS, condition, arg, x.field, x[i], even a same-named
!     member of another object) counts as a READ -> the var is kept.  0 reads is required.
!   * only STRICT single-token, no-'(' , line-ending RHS is commented (RhsSingleSafe): `a = 5`,
!     `c = ''`, `x = y` - never a call `d = f()` (side effect) nor a compound/continued RHS.
!   * NO line inside an EXECUTE is touched (InExecute). An EXECUTE runs ONE of the
!     statements between it and its END, picked by the value it is given, so they are
!     alternatives: none overwrites the one above it, and commenting one out RENUMBERS
!     every arm below it.
!   * v1 is variable-level (write-only), NOT per-store liveness (`x=1; ...read x...; x=2` -
!     the x=1 dead store is NOT caught here; that is the flow-sensitive follow-on).
! ------------------------------------------------------------------------------------
VitEngine.BuiltinUnusedAssignments Procedure(StringTheory pLog)
prefix  StringTheory
raw     StringTheory
s       long,auto
changes long,AUTO
  code
  if self.syms &= NULL then return 0.
  prefix.setValue('! #Unused assignment (never read): ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      if upper(self.rl.rules.bparmQ.name) = 'PREFIX' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        prefix.setValue(raw)
      end
    end
  end
  changes = self.RemoveDeadStoresPass(prefix, pLog)
  if changes
    self.wantReparse = true
    pLog.append('BUILTIN UnusedAssignments: ' & changes & ' assignment(s) commented this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! Per eligible local: classify every occurrence in the scope code as a whole-var WRITE
! (fol + next '=') or a READ (anything else).  0 reads + >=1 write -> comment the writes.
! ------------------------------------------------------------------------------------
VitEngine.RemoveDeadStoresPass Procedure(StringTheory pPrefix, StringTheory pLog)
uvScopeS long ! the scope this answer belongs to
uvScopeE long
uvScopeC long ! and the answer: OMIT/COMPILE present
condKept long ! symbols not examined because that answer was yes
s        long,auto
sc       long,auto
startT   long,auto
endT     long,auto
codeT    long,auto
declTok  long,auto
allowEnd byte,auto
i        long,auto
w        long,auto
nameU    string(vs:maxName),auto
prevU    string(vs:maxName),auto
nextU    string(vs:maxName),auto
fol      byte,auto
contLn   byte,auto
reads    long,auto
changes  long
WriteQ QUEUE,PRE(wr)
wtok      long
       END
  code
  self.lmProcS = -1
  loop s = 1 to records(self.syms.syms)
    get(self.syms.syms, s)
    if errorcode() then break.
    ! A PERSISTENT LOCAL CAN BE UNUSED LIKE ANY OTHER. AutoEligible is shared with AutoCheck,
    ! where refusing STATIC and THREAD is right - ,AUTO is uninitialised stack memory. This
    ! builtin asks whether anything READS the variable, and a procedure-local is visible only
    ! inside that procedure whatever its storage, so the scope scan answers it completely. The 1
    ! says which question is being asked. It also makes the STATIC/THREAD arm below reachable:
    ! `allowEnd` has always known that a persistent local's LAST store may be read on the next
    ! call, and nothing persistent ever got this far to find out.
    if ~self.AutoEligible(s, 1) then cycle.
    nameU   = self.syms.syms.nameU
    declTok = self.syms.syms.declTok
    sc      = self.syms.syms.scopeId
    get(self.syms.scopes, sc)
    if errorcode() then cycle.
    startT = self.syms.scopes.startTok
    endT   = self.syms.scopes.endTok
    codeT  = self.CodeTokOfScope(startT, endT)
    if ~codeT then cycle.
    ! ONE ANSWER PER SCOPE, NOT PER SYMBOL. This loop walks SYMBOLS and a scope holds many of
    ! them, so asking here rescanned the same token range once for every variable declared in
    ! it - quadratic in a big file, and measurably so. The answer cannot differ between two
    ! symbols of one scope, so it is computed only when the scope changes.
    if startT <> uvScopeS or endT <> uvScopeE
      uvScopeS = startT
      uvScopeE = endT
      uvScopeC = self.ScopeIsConditional(startT, endT)
    end
    if uvScopeC
      condKept += 1
      cycle
    end

    free(WriteQ)
    reads = 0
    loop i = codeT + 1 to endT
      get(self.tk.tokens, i)
      if errorcode() then break.
      if self.tk.tokens.type <> 'b' or                          |
         self.tk.tokens.tok &= NULL
        cycle
      end
      if upper(self.tk.tokens.tok) <> nameU then cycle.
      fol = self.tk.tokens.firstOnLine                          ! capture before prev/next gets clobber the buffer
      contLn = 0                                                ! the same continuation guard AutoVerdict carries.
      if not self.tk.tokens.strBefore &= NULL                   !   firstOnLine is ALSO 1 on a '|' continuation line (the CRLF
        if self.TriviaHasContinuation(self.tk.tokens.strBefore) !   lives in strBefore), so `IF a = 1 AND |` / `x = 5` reads as
          contLn = 1                                            !   a write and the REAL store gets commented out. Wrong output.
        end
      end
      prevU = '' ; nextU = ''
      if i > codeT + 1
        get(self.tk.tokens, i - 1)
        if not self.tk.tokens.tok &= NULL then prevU = upper(self.tk.tokens.tok).
      end
      get(self.tk.tokens, i + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL then nextU = upper(self.tk.tokens.tok).
      if fol and ~contLn and nextU = '=' and prevU <> '.'
        clear(WriteQ) ; wr:wtok = i ; add(WriteQ)               ! whole-var assignment target = write
      else
        reads += 1                                              ! any other occurrence = a use (conservative)
      end
    end

    if ~reads
      if records(WriteQ) > 0                                    ! v1: write-only var - every store is dead
        loop w = 1 to records(WriteQ)
          get(WriteQ, w)
          if self.RhsSingleSafe(wr:wtok) and ~self.InExecute(wr:wtok, codeT)
            self.CommentLineStart(wr:wtok, pPrefix.getValue())  ! at the PHYSICAL line start. A raw prepend goes in front of ALL the trivia, so a preceding full-line comment (or a continuation) puts the '!'
                                                                !   on the PREVIOUS line and leaves this one live - counted as a change, nothing commented, and the next pass prepends another to maxPasses.
            changes += 1
            if changes <= 500
              pLog.append('BUILTIN UnusedAssignments line ' & self.LogLineOf(wr:wtok) & ': ' & clip(nameU) & '<13,10>')
            end
          end
        end
      end
    else                                                        ! v2: var IS read somewhere - hunt per-store dead stores
      ! scope-end deadness assumes the local dies on return; a STATIC/THREAD local persists,
      ! so its FINAL store may be read on a later call -> disallow the scope-end case for those
      ! (the overwrite-before-read case stays valid: the value is clobbered within this call).
      allowEnd = choose(~(self.DeclHasAttr(declTok, 'STATIC') or self.DeclHasAttr(declTok, 'THREAD')))
      changes += self.PerStoreDeadStores(codeT, endT, nameU, allowEnd, pPrefix, pLog)
    end
  end
  ! SAY WHAT WAS NOT EXAMINED. The sibling reason in UnusedVars is worded 'kept', because
  ! there the refusal is asked AFTER the usage check and so means 'would have been
  ! commented'. Here it is asked BEFORE the write/read scan - deliberately, that scan is the
  ! expensive part - so all this can honestly claim is that the symbol was never looked at.
  ! Both say so, because a silent skip reads exactly like 'nothing was dead'.
  if condKept
    pLog.append('BUILTIN UnusedAssignments: ' & condKept & ' declaration(s) NOT examined - their scope holds an OMIT or COMPILE block, so a read from inside one is invisible to this scan<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! v2 per-store liveness (overwritten-before-read).  For a var that IS read somewhere
! (so v1's write-only test skipped it), an INDIVIDUAL store `x = <safe>` is still dead if
! its value is never read before x is overwritten or the scope ends.  Flow-sensitive but
! deliberately straight-line only: ANY control structure (level +/'/'/'- mark) or jump
! label between a store and its overwrite/scope-end clears the pending store (we cannot
! prove deadness across branches) -> under-reach, never a wrong comment.
!
! Statement walk (mirrors WalkUnreachable's firstOnLine segmentation):
!   pendW = token of a pending commentable store to x whose value has not yet been read.
!   per statement, in order:
!     * has a control-flow level mark OR is a jump label  -> pendW = 0 (bail across flow)
!     * holds BREAK or CYCLE anywhere, after a ';' too    -> pendW = 0 (the jump carries the
!         value to code that may read it: `n += 1 ; break` takes x out of the loop, and the
!         line after it never runs); RETURN or EXIT does the same for a STATIC or THREAD
!         local, whose value the next call sees. Any other local is gone after RETURN, and
!         routine data after EXIT (a procedure local stored in a routine is never eligible).
!     * whole-var write `x = RHS`, RHS does NOT read x     -> the PREVIOUS pendW is dead
!         (overwritten before read) => comment it; pendW = this store (iff RhsSingleSafe
!         and not inside an EXECUTE)
!     * whole-var write whose RHS reads x (`x = x + 1`)    -> old value used => pendW = 0
!     * any other read of x                                -> pendW = 0 (value is live)
!     * statement doesn't mention x                        -> pendW unchanged
!   at scope end a surviving pendW is a store never read before end -> comment it.
! A store inside an EXECUTE is never pended at all: its arms are alternatives, so the store
! below it never overwrites it, and commenting one arm out renumbers the rest (InExecute).
! A store is only ever set into pendW when RhsSingleSafe, so every commented store is the
! same single-token side-effect-free form v1 touches (never a call / compound / continuation).
! Continuation lines (fol set, logically one statement) can only over-split -> add a spurious
! read/bail, never suppress one -> safe.
! ------------------------------------------------------------------------------------
VitEngine.PerStoreDeadStores Procedure(LONG pCodeT, LONG pEndT, STRING pNameU, BYTE pAllowEnd, StringTheory pPrefix, StringTheory pLog)
i        long,auto
fol      byte,auto
contLn   byte,auto
lvl      string(1)
isEol    byte,auto
ty       string(1)
txt      string(vs:maxName)
tU       string(vs:maxName)
prevU    string(vs:maxName),auto
nextU    string(vs:maxName),auto
isWrite  byte,auto
pendW    long
stActive byte
stHasCF  byte
stWriteT long
stReadsX byte
changes  long
  code
  if pCodeT < 1 or pEndT < pCodeT then return 0.
  loop i = pCodeT to pEndT                                      ! ANY GOTO defeats straight-line liveness (a forward jump skips the overwrite; a backward jump re-enters) - the same bail AutoVerdict takes
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'GOTO' then return 0.
  end
  loop i = pCodeT + 1 to pEndT + 1                              ! +1 sentinel forces the final statement's finalize
    if i > pEndT
      fol = 1 ; isEol = 0 ; contLn = 0                          ! sentinel: force finalize, then break
    else
      get(self.tk.tokens, i)
      if errorcode() then break.
      fol = self.tk.tokens.firstOnLine
      contLn = 0                                                ! see RemoveDeadStoresPass - fol=1 on a '|' continuation
      if not self.tk.tokens.strBefore &= NULL                   !   line too, and the token after it is a COMPARISON operand
        if self.TriviaHasContinuation(self.tk.tokens.strBefore)
          contLn = 1
        end
      end
      lvl = self.tk.tokens.level
      ty  = self.tk.tokens.type                                 ! capture now: finalize's PrependStrBefore clobbers the buffer
      if self.tk.tokens.tok &= NULL
        txt = '' ; isEol = 0
      else
        txt = self.tk.tokens.tok
        isEol = choose(size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>')
      end
      tU = upper(txt)
    end

    ! ---- finalize the previous statement at a new-statement boundary (or the sentinel) ----
    ! ~contLn: fol=1 on a '|' continuation line too, and finalizing there treats the
    ! fragment before the bar (`k = j +`) as a COMPLETE statement - a write with zero
    ! reads - convicting the pending store above as overwritten-before-read while the
    ! real statement reads it on the next physical line. The write classifier below
    ! has carried this guard all along; the boundary needs it for the same reason.
    if (fol and ~isEol and ~contLn and stActive) or i > pEndT
      if stHasCF
        pendW = 0                                               ! bail: cannot track deadness across control flow
      elsif stWriteT and ~stReadsX
        if pendW                                                ! previous store overwritten before any read -> dead
          self.CommentLineStart(pendW, pPrefix.getValue())      ! physical-line-start insert - see RemoveDeadStoresPass
          changes += 1
          if changes <= 500
            pLog.append('BUILTIN UnusedAssignments line ' & self.LogLineOf(pendW) & ': ' & clip(pNameU) & ' (overwritten before read)<13,10>')
          end
        end
        if self.RhsSingleSafe(stWriteT) and ~self.InExecute(stWriteT, pCodeT)
          pendW = stWriteT                                      ! commentable, and not one arm of an EXECUTE
        else
          pendW = 0                                             ! a call, a compound RHS - or an arm of an EXECUTE, which the line below it does not overwrite
        end
      elsif stWriteT and stReadsX
        pendW = 0                                               ! `x = ...x...` reads the old value -> live
      elsif stReadsX
        pendW = 0                                               ! plain read -> value is live
      end
      stHasCF = 0 ; stWriteT = 0 ; stReadsX = 0
    end

    if i > pEndT                                                ! scope end: a store still pending was never read
      if pendW and pAllowEnd
        self.CommentLineStart(pendW, pPrefix.getValue())        ! physical-line-start insert - see RemoveDeadStoresPass
        changes += 1
        if changes <= 500
          pLog.append('BUILTIN UnusedAssignments line ' & self.LogLineOf(pendW) & ': ' & clip(pNameU) & ' (last store, never read)<13,10>')
        end
      end
      break
    end

    if fol and ~isEol then stActive = 1.

    case val(lvl)
    of 43 orof 47 orof 45                                       ! '+' orof '/' orof '-'
      stHasCF = 1
    end
    if fol and ~isEol
      if self.syms.IsColOneLabel(i) then stHasCF = 1.           ! jump target -> flow join, bail
    end
    case tU                                                     ! a jump anywhere in the statement, after a ';' too:
    of 'BREAK'  orof 'CYCLE'                                    !   BREAK and CYCLE go on to code that may read it,
      stHasCF = 1
    of 'RETURN' orof 'EXIT'                                     !   and a STATIC or THREAD value outlives the call
      if ~pAllowEnd then stHasCF = 1.
    end

    if ~isEol and ty = 'b' and txt and tU = upper(pNameU)
      isWrite = 0
      if fol and ~contLn                                        ! whole-var write target is first on its line (never a continuation)
        prevU = '' ; nextU = ''
        if i > pCodeT + 1
          get(self.tk.tokens, i - 1)
          if not self.tk.tokens.tok &= NULL then prevU = upper(self.tk.tokens.tok).
        end
        get(self.tk.tokens, i + 1)
        if ~errorcode() and not self.tk.tokens.tok &= NULL then nextU = upper(self.tk.tokens.tok).
        if nextU = '=' and prevU <> '.' then isWrite = 1.
      end
      if isWrite
        stWriteT = i
      else
        stReadsX = 1
      end
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! 1 = the RHS of the `<var> = <RHS>` at pAssignTok is a SINGLE token that is not '(' and
! the statement ends right after it (the next token is the <10> EOL on the same line).
! This proves side-effect-free (a lone literal/identifier read) with no call, no compound
! expression, and no line continuation.  Anything else -> 0 (keep the assignment).
! ------------------------------------------------------------------------------------
VitEngine.RhsSingleSafe Procedure(LONG pAssignTok)
ln  long,auto
tU  STRING(vs:maxName),auto
rf  BYTE,auto
rhs STRING(vs:maxName),auto
dp  long,auto
  code
  get(self.tk.tokens, pAssignTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  get(self.tk.tokens, pAssignTok + 1)         ! must be a plain '='
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '=' then return 0.
  get(self.tk.tokens, pAssignTok + 2)         ! the single RHS token
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok = '(' then return 0.
  get(self.tk.tokens, pAssignTok + 3)         ! must be the EOL on the same line = RHS was one token
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.lineNo <> ln then return 0.
  if ~(size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>') then return 0.
  ! A BARE NAME MAY BE A CALL. Clarion calls a procedure with no parameters by its label alone, and
  ! a method with none as one merged dotted token - `Ticket = NextTicketNo`, `x = obj.Advance` - and
  ! that call goes with the line. Only a literal, a number, or a name the symbol table resolves to a
  ! declared variable is a plain read.
  get(self.tk.tokens, pAssignTok + 2)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  case self.tk.tokens.type
  of vt:literal orof vt:Integer orof vt:NumericWithDecPt
  else
    if self.syms &= NULL then return 0.
    rhs = upper(self.tk.GetTok(pAssignTok + 2))
    if ~self.syms.Lookup(rhs, pAssignTok + 2, tU, rf)         ! not a declared name: maybe root.field, one
      dp = instring('.', rhs, 1, 1)                           !   merged token - read only when the root is
      if dp < 2 then return 0.                                !   declared and the tail is a FIELD of it
      if instring('.', rhs, 1, dp + 1) then return 0.
      if ~self.syms.Lookup(rhs[1 : dp - 1], pAssignTok + 2, tU, rf) then return 0.
      if upper(tU) = 'STRINGTHEORY'
        if self.stMeth.findChars(' ' & clip(rhs[dp + 1 : len(clip(rhs))]) & ' ') then return 0. ! a StringTheory METHOD
      elsif ~self.UvPlainType(tU) or ~tU
        return 0                                              ! a class: its tail may be a method
      end
    end
  end
  return 1

! ------------------------------------------------------------------------------------
! The token of the nearest enclosing EXECUTE between pTok and pFromT, or 0 for none. Any
! non-zero answer is the test - the line at pTok is one of that EXECUTE's arms, or inside one -
! and the token itself is what lets a refusal name the line.
!
! AN EXECUTE IS NOT A SEQUENCE. It runs ONE of the statements between it and its END,
! picked by the value it is given, so those statements are ALTERNATIVES: none of them
! overwrites the one above it, and commenting one out does not just drop a store - it
! RENUMBERS every arm below it, so a different value then runs a different line. No line
! inside an EXECUTE is commented by this builtin, in either of its two directions.
! A CASE says OF and an IF says ELSE, and both separators carry a level mark, which is why
! the straight-line walk already stopped at those; an EXECUTE arm carries no separator at
! all, so five arms of one EXECUTE read as one store overwriting the next and four live
! lines were commented out. Found 15 Sep 2026.
!
! The walk goes OUTWARDS from pTok. A '-' met on the way back closed a block that ended
! before pTok, so the '+' matching it is not enclosing and is counted off against it; a '+'
! met with none of those outstanding IS enclosing, and is the one asked. Every uncertainty
! leans to answering 1, which can only refuse an edit.
! ------------------------------------------------------------------------------------
! ------------------------------------------------------------------------------------
! Is pTok in a block that is an EXECUTE itself - so the statement it starts is one of the
! EXECUTE's ARMS? Only the innermost block counts: a statement inside an IF that is an arm,
! or inside a BEGIN block, is in a sequence of its own. Returns the EXECUTE token, 0 = no.
! The walk stops at the CODE or ROUTINE that starts the body, so it costs the distance to
! the enclosing opener, not the distance to the top of the file.
! ------------------------------------------------------------------------------------
VitEngine.ArmOfExecute Procedure(LONG pTok)
closed long
x      long,auto
  code
  loop x = pTok - 1 to 1 by -1
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      closed += 1
    of '+'
      if closed
        closed -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE' then return x.
        return 0
      end
    else
      if ~closed
        case upper(self.tk.tokens.tok)
        of 'CODE' orof 'ROUTINE'
          return 0
        end
      end
    end
  end
  return 0

VitEngine.InExecute Procedure(LONG pTok, LONG pFromT)
closed long ! blocks that closed before pTok - their openers are not enclosing
x      long,auto
  code
  if pTok <= pFromT then return 0.
  loop x = pTok - 1 to pFromT by -1
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      closed += 1
    of '+'
      if closed
        closed -= 1
      elsif upper(self.tk.tokens.tok) = 'EXECUTE'
        return x ! an enclosing opener, and it is an EXECUTE - answer with the token, so the caller can name its line
      end
    end
  end
  return 0

! ====================================================================================
! BUILTIN HoistCommonBranchCode - common statement(s) at the END of both
! branches of a clean IF/ELSE/END are moved to AFTER the END (unconditionally
! safe: trailing common code runs after whichever branch, and after the IF either way).
!
! Strategy: BATCHED - ONE walk hoists from every clean IF it finds, rather than one
! statement per pass. Each splice still moves a single physical line, which keeps the token
! surgery small and reviewable, and order is preserved: each hoisted line is inserted
! immediately after the END, so the second peel lands before the first.
! BOTH directions are implemented. END-hoist is tried first because it is the safe one;
! START-hoist is tried second and is gated. The walk below is the exact order -
! read it there rather than trusting this summary.
!
! Heavy under-reach - a wrong MOVE silently corrupts code, so every uncertainty skips:
!   * only a clean IF / ELSE / END (exactly one depth-1 separator, and it is ELSE - never
!     ELSIF/OF; MatchLevel gives the matching END; no-ELSE and one-liner IFs are skipped).
!   * the two trailing statements must each be a SINGLE physical line at branch level (no
!     block marks on the line), sit immediately before ELSE / END, and be token-for-token
!     identical. Their comments must MATCH as text: two lines that say the same thing keep
!     their comment on the moved line and nothing is lost, and refusing those cost hoists
!     that were plainly safe. Anything else about a comment - one line commented and the
!     other not, or two different texts - still skips, because the move would put a comment
!     on a line it was not written about.
!   * comment-out is impossible for a motion; instead we relocate the exact tokens (MoveToks
!     preserves tok+strBefore refs - lossless) and re-indent the moved line to the IF's level.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinHoistCommonBranchCode Procedure(StringTheory pLog)
changes long,AUTO
  code
  if ~self.LevelSpanBalanced(1, records(self.tk.tokens))
    pLog.append('BUILTIN HoistCommonBranchCode: token stream level-unbalanced - pass refused (a mispaired IF/END hoists a statement across the wrong branch)<13,10>')
    return 0
  end
  changes = self.HoistOnePass(pLog)
  if changes
    self.wantReparse = true
    pLog.append('BUILTIN HoistCommonBranchCode: ' & changes & ' hoist(s) this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! Find every clean IF/ELSE/END with an identical trailing (END-hoist) or leading
! (START-hoist) statement in both branches and hoist it.  END-hoist is tried first
! (unconditionally safe); START-hoist second (gated).  BATCHED - after a
! successful hoist the scan resumes AT THE SAME IF (multi-peel in one invocation; the
! walk is token-structural, so stale lineNos are harmless) instead of returning for a
! full engine reparse per hoist.  Returns the number of hoists.
! ------------------------------------------------------------------------------------
! ------------------------------------------------------------------------------------
! 1 = there is not one statement between pFromTok and pToTok. Trivia does not count: a
! comment on the ELSE is not something the arm DOES, and the corpus has several of those.
! ------------------------------------------------------------------------------------
VitEngine.HoistArmEmpty Procedure(LONG pFromTok, LONG pToTok)
i long,auto
  code
  if pToTok <= pFromTok then return 1.
  loop i = pFromTok + 1 to pToTok - 1
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then cycle.
    return 0
  end
  return 1

! ------------------------------------------------------------------------------------
! 1 only when the IF's test is ONE token that PROVABLY names data - a local, a parameter,
! or a dotted chain every hop of which resolves to a FIELD.
!
! THE DOT IS TESTED BEFORE THE PLAIN-LABEL SHAPE, and the order matters: the tokenizer
! merges `a.b.c` into a SINGLE token, and a label test accepts only label characters, so
! a dotted name never passes one. Each hop is proved against the type registry instead.
!
! WHY IT HAS TO BE A PROOF. The caller comments the IF out, and a commented-out test is
! never evaluated. So anything that might DO something has to stay, and the hard case is
! not the obvious one: Clarion spells a PARAMETERLESS METHOD CALL exactly like a field
! read, `if self.IsReady`, so shape alone can never tell a read from a call. Only the type
! registry can, which is why an unresolved name refuses. Under --thorough a class declared
! in an include resolves; without it, it does not, and then the IF is left alone.
!
! Deliberately narrow, and it refuses far more than it needs to - a comparison, a bracket
! of any kind, an equate, a suffixed implicit. That matches this pass's own posture: a
! wrong edit is silent, a missed one costs nothing.
! ------------------------------------------------------------------------------------
VitEngine.CondIsPureRead Procedure(LONG pIfTok)
eol   long,auto
i     long,auto
n     long,auto
only  long,auto
dotP  long,auto
rf    byte
head  STRING(vs:maxName),AUTO
tU    STRING(vs:maxName)
txt   StringTheory
segs  StringTheory
  code
  self.hoistWhy = ''
  if self.syms &= NULL then self.hoistWhy = 'there is no symbol table' ; return 0.
  eol = self.FirstEolAfter(pIfTok)
  if ~eol then self.hoistWhy = 'the IF line has no end' ; return 0.
  n = 0 ; only = 0
  loop i = pIfTok + 1 to eol - 1
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'THEN' then break.
    n += 1
    if n > 1
      self.hoistWhy = 'the test is more than one token - only ONE can be proved a plain read'
      return 0
    end
    only = i
  end
  if n <> 1 or ~only
    self.hoistWhy = 'the test is ' & n & ' token(s), and only ONE can be proved a plain read'
    return 0
  end
  txt.setValue(self.tk.GetTok(only))
  if ~txt._DataEnd then self.hoistWhy = 'the test token is blank' ; return 0.
  dotP = txt.findByte(46) ! <dot>
  if ~dotP and ~self.rl.IsLabelToken(txt.getValue())
    self.hoistWhy = 'the test is not a name: ' & txt.getValue()
    return 0
  end
  if ~dotP
    if ~self.syms.Lookup(txt.getValue(), only, tU, rf)
      self.hoistWhy = 'the name does not resolve: ' & txt.getValue()
      return 0
    end
    return 1
  end
  if dotP < 2 or dotP >= txt._DataEnd then self.hoistWhy = 'a dot at one end' ; return 0.
  head = upper(txt.sub(1, dotP - 1))
  if ~self.syms.Lookup(head, only, tU, rf)
    self.hoistWhy = 'the receiver does not resolve: ' & head
    return 0
  end
  segs.setValue(txt.slice(dotP + 1))
  segs.replaceByte(46, 124)
  if ~self.syms.LookupChain(tU, segs.getValue(), only)
    self.hoistWhy = 'not every part of ' & clip(txt.getValue()) & ' is a data field - it may be a call'
    return 0
  end
  return 1

! ------------------------------------------------------------------------------------
! A hoist can take the last statement out of BOTH arms, leaving `if cond / else / end`
! with nothing in it. It is COMMENTED OUT, never deleted.
!
! Commenting rather than deleting is the whole point. Where both arms held the same
! statement the author had almost certainly meant the ELSE to do something else, and the
! empty IF is the only remaining sign of it - deleting it would tidy the evidence away.
! So the lines stay, visible and inert, and the report says what happened.
!
! IT ONLY FIRES WHEN THE TEST PROVABLY READS DATA. A commented-out test is not evaluated,
! so a test that CALLS something must be left live: in the corpus,
! `if self._ProcessSplitReturned(loc:SplitStr) = 201` is the only thing still making that
! call, and commenting it out would change the program. See CondIsPureRead.
!
! CommentOutSpan works by prepending to trivia, so every token index the caller holds
! stays valid and the walk can carry on.
! ------------------------------------------------------------------------------------
VitEngine.HoistDeadIf Procedure(LONG pIfTok, LONG pEndTok)
ifEol    long,auto
elseEol  long,auto
pElseTok long,auto
  code
  pElseTok = self.HoistFindElse(pIfTok, pEndTok)          ! the caller has it, but naming it in the
  if ~pElseTok then return 0.                             !   prototype pushed the line past the width
                                                          !   this file lays its comments out at
  ifEol = self.FirstEolAfter(pIfTok)
  if ~ifEol or ifEol >= pElseTok then return 0.
  if ~self.HoistArmEmpty(ifEol, pElseTok) then return 0.
  elseEol = self.FirstEolAfter(pElseTok)
  if ~elseEol or elseEol > pEndTok then return 0.
  if ~self.HoistArmEmpty(elseEol, pEndTok) then return 0.
  if ~self.CondIsPureRead(pIfTok) then return 2.          ! arms empty, but the test may DO something
  if ~self.CommentOutSpan(pIfTok, pEndTok, '! both arms empty - ') then return 0.
  return 1

! ------------------------------------------------------------------------------------
! 1 = the ELSE of [pIfTok..pEndTok] was empty and is gone. The caller asks only about an IF this run
! has just peeled, so the empty ELSE is one the hoist made - never one the author wrote. The IF half
! must still hold a statement (both empty is HoistDeadIf's), the ELSE must stand alone on its line,
! and there must be NO comment anywhere from the ELSE to the END: one above the ELSE, on it, or
! under it would go with the line or end up in the other half.
! ------------------------------------------------------------------------------------
VitEngine.HoistDropElse Procedure(LONG pIfTok, LONG pEndTok)
elseTok  long,auto
ifEol    long,auto
elseEol  long,auto
i        long,auto
sb       StringTheory
  code
  elseTok = self.HoistFindElse(pIfTok, pEndTok)
  if ~elseTok then return 0.
  if upper(self.tk.GetTok(elseTok)) <> 'ELSE' then return 0.     ! an ELSIF carries a test
  get(self.tk.tokens, elseTok)
  if errorcode() or ~self.tk.tokens.firstOnLine then return 0.
  ifEol = self.FirstEolAfter(pIfTok)
  if ~ifEol or ifEol >= elseTok then return 0.
  if self.HoistArmEmpty(ifEol, elseTok) then return 0.
  elseEol = self.FirstEolAfter(elseTok)
  if elseEol <> elseTok + 1 then return 0.                       ! ELSE alone on its line
  if ~self.HoistArmEmpty(elseEol, pEndTok) then return 0.
  loop i = elseTok to pEndTok
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.strBefore &= NULL then cycle.
    sb.setValue(self.tk.tokens.strBefore)
    if sb.containsByte(33) then return 0.                        ! <bang>
  end
  self.LineBlocks(elseTok, elseEol, sb)                          ! an OMIT block in front of the ELSE stays, above the END
  self.tk.DeleteToks(elseTok, elseEol)
  if sb._DataEnd then self.tk.PrependStrBefore(elseTok, sb.getValue()).
  return 1

VitEngine.HoistOnePass Procedure(StringTheory pLog)
i       long,auto
ifTok   long,auto
endTok  long,auto
elseTok long,auto
peeled  long
dead    long,auto
changes long
  code
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.                                           ! live bound: counts shift after each hoist
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.type <> 'r'        or                                              |
       ~self.tk.tokens.firstOnLine       or                                              |
       self.tk.tokens.tok &= NULL        or                                              |
       upper(self.tk.tokens.tok) <> 'IF' or                                              |
       self.tk.tokens.level <> '+'
      cycle
    end
    ifTok = i
    get(self.tk.tokens, ifTok)                                                           ! position the queue for MatchLevel
    endTok = self.tk.MatchLevel()                                                        ! matching '-' (END / '.')
    if endTok <= ifTok then cycle.
    elseTok = self.HoistFindElse(ifTok, endTok)
    if ~elseTok then cycle.
    if self.ArmOfExecute(ifTok) then cycle.
    if self.TryEndHoist(ifTok, elseTok, endTok, pLog)
      changes += 1
      peeled = ifTok                                                                     ! this run emptied arms HERE, if it emptied any
      i = ifTok - 1                                                                      ! re-scan this IF: another statement pair may now be peelable
      cycle
    end
    ! NOTHING MORE TO PEEL FROM THIS IF. If this run is what emptied both its arms, the IF
    ! now does nothing, and it is COMMENTED OUT rather
    ! than deleted - where both arms held the same statement the ELSE was probably meant to
    ! do something else, and the empty IF is the last sign of it.
    ! `peeled` is what keeps this off an IF that was ALREADY empty in the author's source.
    ! There are four of those in the corpus and none of them is ours to touch.
    if peeled = ifTok
      peeled = 0
      dead = self.HoistDeadIf(ifTok, endTok)
      if dead = 1
        changes += 1
        pLog.append('BUILTIN HoistCommonBranchCode line ' & self.LogLineOf(ifTok)         & |
                    ': both arms became empty, so the IF is commented out rather than'    & |
                    ' deleted - its test only reads data, so nothing is lost by not'      & |
                    ' evaluating it. Both arms held the SAME statement, which is worth a' & |
                    ' look: the ELSE may have been meant to do something else.<13,10>')
        cycle
      end
      if dead = 2
        pLog.append('BUILTIN HoistCommonBranchCode line ' & self.LogLineOf(ifTok)      & |
                    ': both arms are now empty, and the IF is LEFT EXACTLY AS IT IS'   & |
                    ' because its test is not provably a plain read - it may do'       & |
                    ' something, and a commented-out test would never run: '           & |
                    clip(self.hoistWhy) & '. Check whether the two arms were meant to' & |
                    ' differ.<13,10>')
      end
      if dead = 0 and self.HoistDropElse(ifTok, endTok)                                  ! only the ELSE emptied: it goes, and the
        changes += 1                                                                     !   IF keeps its one half
        pLog.append('BUILTIN HoistCommonBranchCode line ' & self.LogLineOf(ifTok) & ': the ELSE is empty now that its statements are below the END, so it goes<13,10>')
        cycle
      end
    end
    if self.TryStartHoist(ifTok, elseTok, endTok, pLog)
      changes += 1
      i = ifTok - 1                                                                      ! (after a START-hoist the IF sits further on - the forward walk re-finds it)
      cycle
    end
  end
  return changes

! ------------------------------------------------------------------------------------
! For the IF block [pIfTok..pEndTok], return the single depth-1 ELSE token, or 0 if the
! block is not a clean two-branch IF (no separator, an ELSIF, more than one separator,
! or an OF - i.e. anything we cannot hoist across safely).
! ------------------------------------------------------------------------------------
VitEngine.HoistFindElse Procedure(LONG pIfTok, LONG pEndTok)
i     long,auto
depth long,AUTO
cnt   long
sep   long
  code
  depth = 1
  loop i = pIfTok + 1 to pEndTok - 1
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    case val(self.tk.tokens.level)
    of 43                                      ! '+'
      depth += 1
    of 45                                      ! '-'
      depth -= 1
      if depth < 1 then return 0.
    of 47                                      ! '/'
      if depth = 1
        cnt += 1
        if cnt > 1                    or       |   ! ELSIF chain / multiple separators
           self.tk.tokens.tok &= NULL or       |
           upper(self.tk.tokens.tok) <> 'ELSE' ! ELSIF/OF/OROF
          return 0
        end
        sep = i
      end
    end
  end
  if cnt <> 1 then return 0.
  return sep

! ------------------------------------------------------------------------------------
! Attempt the END-hoist for one clean IF/ELSE/END.  Returns 1 if performed, 0 if skipped.
! ------------------------------------------------------------------------------------
VitEngine.TryEndHoist Procedure(LONG pIfTok, LONG pElseTok, LONG pEndTok, StringTheory pLog)
tEol      long,auto
tFirst    long,auto
tCEnd     long,auto
sEol      long,auto
sFirst    long,auto
sCEnd     long,auto
sLine     long,auto
firstTxt  string(vs:maxName),AUTO
hoCmtA    StringTheory ! the two lines' comment TEXT - identical is allowed, different is not
hoCmtB    StringTheory
endIndent StringTheory
  code
  ! ELSE and END must each begin their own physical line
  if ~self.IsFirstOnLine(pElseTok) then return 0.
  if ~self.IsFirstOnLine(pEndTok)  then return 0.
  ! the token just before ELSE / END is that line's EOL
  tEol = pElseTok - 1
  sEol = pEndTok  - 1
  if ~self.IsEolTok(tEol) then return 0.
  if ~self.IsEolTok(sEol) then return 0.
  ! END must own its line and have room after it to receive the hoisted line
  if ~self.IsEolTok(pEndTok + 1) then return 0.
  if pEndTok + 2 > records(self.tk.tokens) then return 0.
  ! each trailing statement's first-on-line token
  tFirst = self.LineStartOf(tEol)
  sFirst = self.LineStartOf(sEol)
  if ~tFirst or ~sFirst then return 0.
  tCEnd = tEol - 1
  sCEnd = sEol - 1
  if tCEnd < tFirst or sCEnd < sFirst then return 0.                   ! blank line - no statement
  ! a '|'-continued trailing statement: every continuation token carries firstOnLine=1
  ! with the bar+CRLF in its strBefore, so LineStartOf stopped at the LAST physical
  ! line and tFirst/sFirst name only the TAIL. Hoisting that relocates half a
  ! statement, SetStrBefore destroys the bar, and BOTH branches are left truncated
  ! mid-statement - one continuing straight into ELSE. LineHasComment cannot see it
  ! ('!' only), so test the tail's own leading trivia. A '|' inside an absorbed
  ! comment refuses too - under-reach, the safe direction (KrTriviaClean's rule).
  get(self.tk.tokens, tFirst)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(124, 1,, self.tk.tokens.strBefore) then return 0. ! '|'
  end
  get(self.tk.tokens, sFirst)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(124, 1,, self.tk.tokens.strBefore) then return 0. ! '|'
  end
  ! single simple statement each (no block marks), no interior/trailing comment, identical
  if self.LineHasLevelMark(tFirst, tEol) then return 0.
  if self.LineHasLevelMark(sFirst, sEol) then return 0.
  ! IDENTICAL COMMENTS DO NOT BLOCK A HOIST. A hoist would MOVE or LOSE a comment, which is
  ! an information-loss argument, so it only bites when the two DIFFER: when they say the
  ! same thing the copy that goes is redundant and nothing is lost, which is the same
  ! reasoning that already requires the statements to be token-for-token identical.
  ! Compared as TEXT, so the column may differ - in real code it always does. A line with a
  ! comment and one without still refuse, because '' <> the other's text.
  self.LineCommentText(tFirst, tEol, hoCmtA)
  self.LineCommentText(sFirst, sEol, hoCmtB)
  if ~hoCmtA.equals(hoCmtB, st:clip) then return 0.
  if ~self.SpanTokEqual(tFirst, tCEnd, sFirst, sCEnd) then return 0.
  ! an OMIT block folded in front of either copy (the tokenizer puts a plain OMIT('***') block in
  ! the strBefore of the token after it) would go with the deleted copy, or with the moved line's
  ! re-indent - SetStrBefore replaces the whole trivia. Refuse, and say so.
  if self.HasAbsorbedBlock(tFirst) or self.HasAbsorbedBlock(sFirst)
    pLog.append('BUILTIN HoistCommonBranchCode END-hoist REFUSED line ' & self.LogLineOf(sFirst) & ': an OMIT block sits in front of a copy<13,10>')
    return 0
  end

  ! ---- capture what we need BEFORE the edits clobber the token buffer ----
  self.IndentOf(pEndTok, endIndent)                                  ! indent of the END line = the IF's level: the trivia after its last line feed, so a block folded in front of END stays with END
  get(self.tk.tokens, sFirst)
  if self.tk.tokens.tok &= NULL
    firstTxt = ''
  else
    firstTxt = self.tk.tokens.tok
  end
  sLine = self.LogLineOf(sFirst)                                     ! log-only var - source coords in preview

  ! ---- the splice: relocate the false-branch line after END, drop the true-branch copy ----
  do DbgReindentE                                                    ! re-indent moved line to the IF's level
  self.tk.MoveToks(sFirst, pEndTok + 2, sEol - sFirst + 1)           ! move [sFirst..sEol] to just after the END line
  self.tk.DeleteToks(tFirst, tEol)                                   ! remove the now-redundant true-branch copy
  if not self.syms &= NULL then self.syms.dirty = 1.                 ! the two edits above RENUMBER the queue, so every position the symbol table holds is stale.

  pLog.append('BUILTIN HoistCommonBranchCode END-hoist line ' & sLine & ': ' & clip(firstTxt) & ' ...<13,10>')
  return 1

DbgReindentE routine
  ! A COLUMN-1 '?' IS ITS COLUMN. The LRM gives a lone '?' in column one as "execute the statement
  ! that follows in DEBUG mode only", so the marker is not the character alone - it is the character
  ! AT column one. Writing the new indent in front of it, as every other moved line gets, would put
  ! the '?' in the middle of the whitespace and unmake it: either the module stops compiling, or an
  ! ASSERT the author confined to debug builds runs in every build. So the '?' keeps its own place -
  ! being in column one, its strBefore already holds the line break and nothing else - and the indent
  ! goes on the token AFTER it, one column shorter because the '?' occupies the first. The statement
  ! then lands in the column it would have had without the marker. wbhits.clw is the one site in the
  ! 1,400-file corpus where this arises, found by the review of all 414 hoists.
  if self.HoistDbgMarker(sFirst)
    self.tk.SetStrBefore(sFirst + 1, self.HoistDbgPad(endIndent))
  else
    self.tk.SetStrBefore(sFirst, endIndent.getValue())
  end

! ------------------------------------------------------------------------------------
! Attempt the START-hoist: a statement common to the START of both branches is
! moved to BEFORE the IF.  This flips execution order from [eval C -> run S] to [run S ->
! eval C], so it is GATED - only when reordering cannot change behaviour:
!   (1) S is a plain assignment `lhs = ...` with no call (its only effect is writing lhs);
!   (2) the condition C contains no call - no bracket in it, AND every name in it provably reads
!       data, because Clarion spells a call to a parameterless procedure exactly like reading a
!       field, so `if IsReady` is a call with nothing to recognise it by;
!   (3) S's lhs is not read by C (so running S first cannot change C's value).
! Returns 1 if performed, 0 if skipped.  The false copy is dropped and the true copy moved
! (a backward per-token relocation via StartMove) to just before the IF, re-indented.
! ------------------------------------------------------------------------------------
VitEngine.TryStartHoist Procedure(LONG pIfTok, LONG pElseTok, LONG pEndTok, StringTheory pLog)
ifEol    long,auto
elseEol  long,auto
tFirst   long,auto
tEol     long,auto
tCEnd    long,auto
fFirst   long,auto
fEol     long,auto
fCEnd    long,auto
lhsU     string(vs:maxName),AUTO
hoCmtA   StringTheory ! as TryEndHoist
hoCmtB   StringTheory
tLine    long,auto
hx       long,auto    ! scan index over the IF header line
ifIndent StringTheory
  code
  ! the IF line and the ELSE line each end at their own EOL (single physical line)
  ifEol   = self.FirstEolAfter(pIfTok)
  elseEol = self.FirstEolAfter(pElseTok)
  if ~ifEol or ~elseEol or                                                     |
     ifEol >= pElseTok  or                                                     |
     elseEol >= pEndTok or                                                     |
     elseEol <> pElseTok + 1                                                   ! 'else <stmt>' inline - the line after is NOT the branch's first statement; hoisting reorders around the uninspected inline one
    return 0
  end
  loop hx = pIfTok + 1 to ifEol - 1                                            ! 'if c then <stmt>' inline - same trap on the true side (THEN must be the last token of the IF line)
    get(self.tk.tokens, hx)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'THEN' and hx < ifEol - 1 then return 0.
  end
  ! first statement of each branch = the line immediately after the IF / ELSE line
  tFirst = ifEol + 1
  fFirst = elseEol + 1
  if ~self.IsFirstOnLine(tFirst) or ~self.IsFirstOnLine(fFirst) then return 0.
  if self.IsEolTok(tFirst) or self.IsEolTok(fFirst) then return 0.             ! blank first line
  if tFirst >= pElseTok or fFirst >= pEndTok then return 0.                    ! empty branch
  tEol = self.FirstEolAfter(tFirst)
  fEol = self.FirstEolAfter(fFirst)
  if ~tEol or ~fEol or                                                         |
     tEol >= pElseTok or fEol >= pEndTok                                       ! first stmt must lie within its branch
    return 0
  end
  tCEnd = tEol - 1
  fCEnd = fEol - 1
  if tCEnd < tFirst or fCEnd < fFirst then return 0.
  ! single simple statement each, no marks/comments, identical
  if self.LineHasLevelMark(tFirst, tEol) then return 0.
  if self.LineHasLevelMark(fFirst, fEol) then return 0.
  ! IDENTICAL COMMENTS DO NOT BLOCK A HOIST - the same test as TryEndHoist, for the same reason.
  self.LineCommentText(tFirst, tEol, hoCmtA)
  self.LineCommentText(fFirst, fEol, hoCmtB)
  if ~hoCmtA.equals(hoCmtB, st:clip) then return 0.
  if ~self.SpanTokEqual(tFirst, tCEnd, fFirst, fCEnd) then return 0.
  ! ---- the gate ----
  if ~self.StmtIsPlainAssign(tFirst, tCEnd) then return 0.                     ! (1) plain no-call assignment
  if self.SpanHasParen(pIfTok + 1, ifEol - 1) then return 0.                   ! (2) condition has no call: no bracket, and
  if ~self.CondNamesAreData(pIfTok + 1, ifEol - 1) then return 0.              !     every name in it provably reads data - a call to a parameterless procedure carries no bracket
  get(self.tk.tokens, tFirst)
  if self.tk.tokens.tok &= NULL then return 0.
  lhsU = upper(self.tk.tokens.tok)                                             ! the first target, for the log line only
  ! (3) NO target on the line is read by C, nor read through an ALIAS of one - see below
  if ~self.HoistTargetsClear(tFirst, tCEnd, pIfTok + 1, ifEol - 1) then return 0.

  ! ---- the OMIT-block refusal (see TryEndHoist), then capture, then splice ----
  if self.HasAbsorbedBlock(tFirst) or self.HasAbsorbedBlock(fFirst)
    pLog.append('BUILTIN HoistCommonBranchCode START-hoist REFUSED line ' & self.LogLineOf(tFirst) & ': an OMIT block sits in front of a copy<13,10>')
    return 0
  end
  self.IndentOf(pIfTok, ifIndent)                                              ! the IF's own indent: the trivia after its last line feed
  tLine = self.LogLineOf(tFirst)                                               ! log-only var - source coords in preview

  self.tk.DeleteToks(fFirst, fEol)                                             ! drop the false-branch copy (higher indices - IF/true unaffected)
  do DbgReindentS                                                              ! re-indent the moved line to the IF's level
  self.MoveLinesAbove(tFirst, pIfTok, tEol - tFirst + 1)                       ! relocate [tFirst..tEol] to just before the IF
  if not self.syms &= NULL then self.syms.dirty = 1.                           ! as the END-hoist: this splice renumbers the queue and stales the table

  pLog.append('BUILTIN HoistCommonBranchCode START-hoist line ' & tLine & ': ' & clip(lhsU) & ' ...<13,10>')
  return 1

DbgReindentS routine
  ! The same marker at the START of both arms - see DbgReindentE for why the '?' keeps column one.
  if self.HoistDbgMarker(tFirst)
    self.tk.SetStrBefore(tFirst + 1, self.HoistDbgPad(ifIndent))
  else
    self.tk.SetStrBefore(tFirst, ifIndent.getValue())
  end

! 1 = NO statement on the line [pFirst..pCEnd] writes something the condition [pCS..pCE] reads,
! nor anything aliasing it. The line is moved WHOLE, so every target on it has to clear the
! condition - taking the first statement's target alone was the hole: `x = 1 ; y = 1` above an
! IF that reads y put the write in front of the read and the other arm ran.
! A PARAMETER is a name not declared in column 1: it sits in the header's brackets, on the
! header's first line or on a line a '|' carries the header on to.
! A TARGET can be the storage the condition reads under another name as well. A reference
! writes what it points at, which may be any variable, so a target whose root is one refuses,
! and so does a condition that reads a reference declared outside the procedure. A parameter,
! and SELF, is the caller's: it cannot be one of the procedure's own locals, made fresh for
! this call, but it may be anything else - so such a target refuses when the condition reads
! a parameter, a name from outside the procedure, or a STATIC or THREAD local. A STATIC or
! THREAD target refuses when the condition reads a parameter, which may point at it.
VitEngine.HoistTargetsClear Procedure(LONG pFirst, LONG pCEnd, LONG pCS, LONG pCE)
j    long,auto
open long,auto
lhsU string(vs:maxName),AUTO
cPar byte ! the condition reads a parameter
cFar byte ! the condition reads a name from outside the procedure, or a STATIC one
k    long,auto
sc   long,auto
row  long,auto
root string(vs:maxName),AUTO
tU   string(vs:maxName)
rf   byte,auto
  code
  if self.syms &= NULL then return 0.
  sc = self.syms.ScopeContaining(pCS, vs:scProc, vs:scMethod)
  if ~sc then return 0.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 0.
  loop k = pCS to pCE                 ! the condition: a reference reads storage another name writes
    get(self.tk.tokens, k)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    lhsU = upper(self.tk.tokens.tok)
    j = instring('.', lhsU, 1, 1)
    if j > 1 then lhsU = lhsU[1 : j - 1].
    row = self.syms.FindOwn(lhsU, sc)
    if ~row
      cFar = 1
      rf = 0
      if self.syms.Lookup(lhsU, k, tU, rf)
        if rf then return 0.
      end
      cycle
    end
    get(self.syms.syms, row)
    if errorcode() then return 0.
    if self.syms.syms.isRef then return 0.
    if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then cPar = 1.
    if band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread) then cFar = 1.
  end
  open = 1
  loop j = pFirst to pCEnd
    get(self.tk.tokens, j)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = ';'
      open = 1
      cycle
    end
    if ~open then cycle.
    lhsU = upper(self.tk.tokens.tok)
    root = self.NameRoot(lhsU)
    rf = 0
    if root <> 'SELF' and self.syms.Lookup(root, j, tU, rf)
      if rf then return 0.
    end
    row = self.syms.FindOwn(root, sc)
    if row
      get(self.syms.syms, row)
      if errorcode() then return 0.
      if root = 'SELF' or ~self.syms.IsColOneLabel(self.syms.syms.declTok)
        if cPar or cFar then return 0.
      elsif cPar and band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread)
        return 0
      end
    end
    if self.SpanHasName(lhsU, pCS, pCE) then return 0.
    if self.HoistAliasRisk(j, lhsU) then return 0.
    row = self.syms.FindOwn(lhsU, sc)    ! not the procedure's own: a by-address parameter in the condition may be it
    if ~row and cPar then return 0.
    loop k = self.syms.scopes.startTok to self.syms.scopes.endTok
      get(self.tk.tokens, k)             ! a reference taken on the target reads it under another name
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL or self.tk.tokens.tok <> '&=' then cycle.
      if upper(self.tk.GetTok(k + 1)) = lhsU then return 0.
    end
    open = 0
  end
  return 1

! 1 = the line starting at pTok begins with a '?' of its own - Clarion's DEBUG marker. The LRM gives
! a '?' alone in column one as "execute the statement that follows in DEBUG mode only", so the marker
! IS its column. A hoist relocates the line and re-indents it to the IF's level, which puts the '?'
! somewhere in the middle of the indent and stops it being a marker at all: either the module will not
! compile, or an ASSERT the author confined to debug builds starts running in every build. Reindent
! makes this same refusal (its firstDbg); the hoist has to make it too. Found by the review of all 414
! corpus hoists - wbhits.clw is the single site in 1,400 files where a hoist meets one, so the refusal
! costs exactly one hoist and buys back a line the tool was silently rewriting the meaning of.
VitEngine.HoistDbgMarker Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '?' then return 1.
  return 0

! The indent a moved line carries when its first token is the column-1 '?' debug marker: the block's
! indent less the one column the '?' itself occupies, so the statement after it lands where it would
! have landed without the marker. An indent of nothing, or of one space, leaves nothing to give back.
VitEngine.HoistDbgPad Procedure(StringTheory pIndent)
  code
  if pIndent._DataEnd < 2 then return ''.
  return all(' ', pIndent._DataEnd - 1)

!===============================================================================================
! BUILTIN ContOp - where the AND, OR or '&' of a WRAPPED line sits.
!   BUILTIN ContOp, STYLE('keep'|'end'|'front'|'flush')   keep = the default, and rewrites NOTHING;
!                                                          flush = front, with the continuation lined
!                                                          up under the word that opens the statement
!
! THE BAR IS TRIVIA, NOT A TOKEN. That is the whole reason this pass is small. A continuation
! bar lives in the strBefore of the token that FOLLOWS it, so the two spellings
!
!     a = 1 or |              a = 1 |
!        b = 2                   or b = 2
!
! hold the SAME tokens in the SAME order - `1`, `or`, `b` - and differ only in which side of the
! operator the bar-carrying trivia sits on. Nothing is moved, inserted or deleted: one run of
! trivia changes hands. That is also why the axis has a true inverse, and why the acceptance test
! can demand the file back byte for byte.
!
! WHAT IS REFUSED, and every refusal leaves the line exactly as the author wrote it:
!   * a comment between the operator and the bar - moving the operator past it would change which
!     line the comment documents;
!   * a bar in COLUMN 1 inside the continuation - that is a commented-out line, not a continuation
!     (a line inside a continuation is commented with '|' in column 1, never with '!'), so the
!     shape is not this shape;
!   * an operator that is not at bracket depth 0 - an `or` inside a call's argument list is not
!     the continuation operator;
!   * AND, OR and '&' only. XOR is out, deliberately: padPrev knows those same three, and if the
!     two disagreed about what a continuation operator is they would fight over the same lines.
!===============================================================================================
VitEngine.BuiltinContOp Procedure(StringTheory pLog)
i        long,auto
nTok     long,auto
changes  long,auto
mode     byte,auto ! 0 keep (no-op), 1 end, 2 front, 3 flush
styleU   string(8) ! not AUTO: blank to start, so the summary cannot print garbage
nm       string(vs:maxName),AUTO
bx       long,auto
raw      StringTheory
  code
  mode = 0
  if self.rl.rules.bparmQ &= NULL then return 0.            ! no parameters at all: nothing to select
  loop i = 1 to records(self.rl.rules.bparmQ)
    get(self.rl.rules.bparmQ, i)
    if errorcode() then break.
    if ~self.rl.rules.bparmQ.name then cycle.               ! a fixed STRING, never NULL - a blank test
    nm = upper(self.rl.rules.bparmQ.name)
    if nm = 'STYLE' and not self.rl.rules.bparmQ.value &= NULL
      raw.setValue(self.rl.rules.bparmQ.value)              ! the value arrives WITH its quotes -
      raw.unquote('''','''')                                !   'end' is not END until they come off
      styleU = upper(raw.getValue())
      if styleU = 'END'   then mode = 1.
      if styleU = 'FRONT' then mode = 2.
      if styleU = 'FLUSH' then mode = 3.                    ! front, and lined up under the word that opens
      if styleU = 'KEEP'  then mode = 0.                    !   the statement rather than under the wrap
    end
  end
  self.tk.contOp = mode                                     ! ONE answer for all three: the pass moves the operator, and the splitter and the aligner
                                                            !   have to spell a break the same way or they undo each other
  if ~mode then return 0.                                   ! keep: the default member rewrites nothing
  changes = 0
  nTok = records(self.tk.tokens)
  loop i = 2 to nTok
    bx = self.ContOpBarTok(i)                               ! i carries a usable continuation bar, or 0
    if ~bx then cycle.
    if mode = 1                                             ! END: in FRONT form the bar sits in the operator's
      if ~self.ContOpIsOp(i) then cycle.                    !   OWN trivia, so it moves to the token after it
      if self.ContOpMove(i, i + 1, pLog) then changes += 1.
    else                                                    ! FRONT: the operator is the token BEFORE the
      if self.ContOpIsOp(i - 1)                             !   bar, and the bar has to go in front of it.
        if self.ContOpMove(i, i - 1, pLog) then changes += 1.
      elsif mode = 3 and self.ContOpIsOp(i)                 !   An operator ALREADY at the front is not
        if self.ContOpFlushOnly(i) then changes += 1.
      end                                                   !   moved by front - but flush still owes it
    end                                                     !   a column, or the member would depend on
                                                            !   the spelling it was handed
  end
  if changes then pLog.append('BUILTIN ContOp (' & clip(styleU) & '): ' & changes & ' operator(s) this pass<13,10>').
  return changes

! The position of a REAL continuation bar in token pTok's leading trivia, or 0. The bar is trivia,
! not a token, so this is where a wrapped line's break actually lives. Refuses, in order:
!   * no bar at all;
!   * a '!' anywhere before the bar - a comment sits between the operator and the bar, and moving
!     the operator past it would change which line the comment documents;
!   * a bar that begins a line - that is a commented-out row inside the continuation, which
!     Clarion writes with '|' in column 1, and it is not a continuation bar.
! A bar inside a string LITERAL never reaches here: a literal is one token, so its bar is in the
! token's own text and not in anybody's trivia.
VitEngine.ContOpBarTok Procedure(LONG pTok)
j    long,auto
sz   long,auto
sawN long,auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.strBefore &= NULL then return 0.
  sz = size(self.tk.tokens.strBefore)
  sawN = 0                   ! the trivia begins MID-LINE - it continues from the
                             !   previous token, so the first bar it meets is the real
                             !   continuation bar. Only a bar after a NEWLINE in here
                             !   starts a line, and that one is a commented-out row.
  ! THE FIRST BAR IS THE ONE THAT MATTERS, and the scan stops there. What condition 1 forbids is
  ! MISTAKING a column-1 comment bar FOR the continuation bar - not the presence of one further
  ! down. A commented-out row inside a continuation is skipped by the compiler whichever side of
  ! the break the operator sits on, so a statement that reads `a = 1 or b = 2` before the move
  ! still reads `a = 1 or b = 2` after it, and the move reverses byte for byte. The operator lands
  ! at the start of the OPERAND's line, never on the commented row, because the whole run of
  ! trivia - bar, commented row, indent - travels as one piece.
  !
  ! sawN is what condition 1 is really for: where the FIRST bar follows a newline, this is not a
  ! continuation at all but a plain commented-out line between two statements, and there is no
  ! continuation operator to move.
  loop j = 1 to sz
    case val(self.tk.tokens.strBefore[j])
    of 33                    ! '!' before the bar: a comment sits between
      return 0               !   the operator and the bar
    of 124                   ! '|'
      if sawN then return 0. !   it starts a line: not a continuation bar
      return j               !   the real one
    of 10 orof 13
      sawN = 1
    of 32 orof 9
      ! spaces and tabs do not end the start-of-line run
    else
      sawN = 0
    end
  end
  return 0

! 1 = token pTok is a continuation operator at bracket depth 0. AND, OR and '&' only - the same
! three padPrev knows, so the two passes cannot disagree about what a continuation operator is.
! XOR is deliberately absent from both.
VitEngine.ContOpIsOp Procedure(LONG pTok)
u    string(8),auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if size(self.tk.tokens.tok) > 3 then return 0.
  u = upper(self.tk.tokens.tok)
  if u <> 'AND' and u <> 'OR' and u <> '&' then return 0.
  if self.ContOpDepth(pTok) then return 0. ! inside a call's arguments: not the one
  return 1

! The bracket depth of token pTok within its own logical line: the number of '(' still open in
! front of it since the line began. An `or` inside f(x or y) sits at depth 1 and is an argument of
! the call, not the operator that joins the two halves of a wrapped statement.
!
! READ THE DIRECTION OFF THE LOOP, not off the count. The walk runs BACKWARDS, from pTok towards
! the start of the statement, so a '(' met on the way is a bracket still OPEN at pTok and counts
! UP, while a ')' met on the way closes a group that opened further back and counts DOWN. The
! clamp at the end is for a stream holding more ')' than '(' behind pTok, which well-formed source
! does not produce.
!
! The line test asks ContOpBarTok about token j's OWN leading trivia, because that is where the
! bar belonging to the line j STARTS lives; and the buffer is read back straight after, because
! that call leaves it on the row it read.
VitEngine.ContOpDepth Procedure(LONG pTok)
j    long,auto
d    long,auto
  code
  d = 0
  loop j = pTok - 1 to 1 by -1
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine
      if ~self.ContOpBarTok(j) then break. ! a line that no bar continues starts afresh
      get(self.tk.tokens, j)
      if errorcode() then break.
    end
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) <> 1 then cycle.
    if self.tk.tokens.tok = '(' then d += 1.
    if self.tk.tokens.tok = ')' then d -= 1.
  end
  if d < 0 then d = 0.
  return d

! Hand the bar-carrying trivia from pFrom's leading trivia to pTo's, so the operator changes sides
! of the break. NOTHING is inserted or deleted: the run of trivia up to and including the bar, the
! line break and the continuation line's own indent moves whole, and the token it came from is left
! with a single space in front of it. That is what makes the axis a
! true inverse of itself.
! The run REPLACES pTo's own trivia, so pTo may hold nothing there but spaces and tabs. An
! operator alone between two bars - `a = 1 | ! first` / `or | ! second` / `b = 2` - carries a
! bar, a line break and a comment of its own on each side, and moving one run over the other
! would lose a comment: that move is refused and the lines stay as written.
VitEngine.ContOpMove Procedure(LONG pFrom, LONG pTo, StringTheory pLog)
! #Removed as not used: bx   long,auto
nl   long,auto
k    long,auto
sb   StringTheory
head StringTheory
ind  StringTheory
  code
  if ~self.ContOpBarTok(pFrom) then return 0.
  get(self.tk.tokens, pTo)
  if errorcode() then return 0.
  if not self.tk.tokens.strBefore &= NULL
    loop k = 1 to size(self.tk.tokens.strBefore)
      case val(self.tk.tokens.strBefore[k])
      of 32 orof 9
      else
        return 0
      end
    end
  end
  get(self.tk.tokens, pFrom)
  if errorcode() or self.tk.tokens.strBefore &= NULL then return 0.
  sb.setValue(self.tk.tokens.strBefore)
  head.setValue(sb.valuePtr[1 : sb._DataEnd]) ! the whole run: spaces, bar, break, indent
  ! FLUSH replaces the indent the run ends with. Everything up to and including the line
  ! feed is carried across unchanged - the spaces before the bar, the bar, the break - and
  ! only the trailing indent is swapped for the one belonging to the line the operator is
  ! leaving, so the operator lands under the word that opened the statement.
  if self.tk.contOp = 3
    self.ContOpStmtIndent(pTo, ind)
    nl = 0
    loop k = 1 to head._DataEnd
      if head.valuePtr[k] = '<10>' then nl = k.
    end
    if nl then head.setValue(head.valuePtr[1 : nl] & ind.getValue()).
  end
  self.tk.SetStrBefore(pTo, head.getValue())  ! ... goes in front of the operator
  self.tk.SetStrBefore(pFrom, ' ')            ! ... and one space is left behind it
  pLog.append('BUILTIN ContOp line ' & self.LogLineOf(pTo) & ': the operator changed sides of the break<13,10>')
  return 1

! The indent of the PHYSICAL LINE that pTok sits on - the spaces in front of the token that
! OPENS that line, not in front of pTok itself. This is what `flush` lines an operator up
! with: the word that opened the statement.
!
! The line start is found by looking for the LINE FEED, never by trusting the firstOnLine
! flag. Moving a bar changes which token opens a line, and the flags are stamped by
! SetLineNumbers - so after the first move of a pass they describe the file as it was, not
! as it is. A file break is spelled two ways, inside trivia and as a token of its own, and
! both have to be answered here.
! pTok is an operator that ALREADY opens a continuation line, so there is nothing to move -
! only the indent in front of it to re-set. Without this, flush would re-column the operators
! it moves and leave alone the ones the author had already put at the front, and the member
! would then depend on the spelling it was handed rather than deciding one.
!
! The no-change test is on LENGTH, not on the text. The prefix up to the line feed is carried
! over unaltered and everything after it is spaces in both, so equal lengths mean equal runs -
! and a text compare could not say so anyway, because = ignores trailing spaces and would call
! every indent equal to every other.
VitEngine.ContOpFlushOnly Procedure(LONG pTok)
nl   long,auto
k    long,auto
sb   StringTheory
ind  StringTheory
head StringTheory
  code
  get(self.tk.tokens, pTok)
  if errorcode() or self.tk.tokens.strBefore &= NULL then return 0.
  sb.setValue(self.tk.tokens.strBefore)
  nl = 0
  loop k = 1 to sb._DataEnd
    if sb.valuePtr[k] = '<10>' then nl = k.
  end
  if ~nl then return 0.
  self.ContOpStmtIndent(pTok - 1, ind)
  head.setValue(sb.valuePtr[1 : nl] & ind.getValue())
  if head._DataEnd = sb._DataEnd then return 0.
  self.tk.SetStrBefore(pTok, head.getValue())
  return 1

VitEngine.ContOpStmtIndent Procedure(LONG pTok, StringTheory pOut)
x long,auto
  code
  x = pTok
  loop while x > 1
    if self.IsEolTok(x)                                              ! a break spelled as a TOKEN: the line opens after it
      x += 1
      break
    end
    get(self.tk.tokens, x)
    if errorcode() then break.
    if not self.tk.tokens.strBefore &= NULL                          ! a break spelled inside TRIVIA: this token opens it
      if pOut.findByte(10, 1,, self.tk.tokens.strBefore) then break. ! <line feed>
    end
    x -= 1
  end
  self.IndentOf(x, pOut)

! Backward block relocation: move the pNum tokens [pSrc..pSrc+pNum-1] to just before pDst
! (pDst < pSrc).  MoveTok(pSrc+k, pDst+k) is net-neutral on tokens above the source, so the
! block's own indices stay put as each token peels off in order.  (MoveToks does not advance
! its source for backward moves, so it cannot be used here.)
VitEngine.StartMove Procedure(LONG pSrc, LONG pDst, LONG pNum)
k long,auto
  code
  if pNum < 1 then return.
  loop k = 0 to pNum - 1
    self.tk.MoveTok(pSrc + k, pDst + k)
  end

! The whole lines [pSrc..pSrc+pNum-1] moved in front of the line that starts at pDst (pDst < pSrc),
! as StartMove moves them, with an OMIT block folded into pDst's trivia kept ABOVE the moved lines,
! where it stood - above both, as InsertLinesAbove keeps it above a new line (ruled 30 Oct 2026).
! The line at pDst keeps only its indent. With no block, or where pDst does not begin a line, this
! is StartMove exactly.
VitEngine.MoveLinesAbove Procedure(LONG pSrc, LONG pDst, LONG pNum)
blk  StringTheory
ind  StringTheory
  code
  if pNum < 1 then return.
  if pDst > 1 and ~self.IsEolTok(pDst - 1)
    self.StartMove(pSrc, pDst, pNum)
    return
  end
  self.AbsorbedBlockOf(pDst, blk)
  if ~blk._DataEnd
    self.StartMove(pSrc, pDst, pNum)
    return
  end
  self.IndentOf(pDst, ind)
  self.StartMove(pSrc, pDst, pNum)
  self.tk.SetStrBefore(pDst + pNum, ind.getValue())
  self.tk.PrependStrBefore(pDst, blk.getValue())

! First <10> (EOL) token at an index greater than pTok, or 0.
VitEngine.FirstEolAfter Procedure(LONG pTok)
x long,auto
  code
  loop x = pTok+1 to records(self.tk.tokens)
    if self.IsEolTok(x) then return x.
  end
  return 0

! 1 = a '(' token appears anywhere in [pS..pE] (a call or grouping - conservatively a skip).
VitEngine.SpanHasParen Procedure(LONG pS, LONG pE)
i long,auto
  code
  if pE < pS then return 0.
  loop i = pS to pE
    get(self.tk.tokens, i)
    if errorcode() then return 1.
    if not self.tk.tokens.tok &= NULL
      if self.tk.tokens.tok = '(' then return 1.
    end
  end
  return 0

! How tightly the operator token at pTok binds, by the levels the compiler uses: 4 '^'; 5 '*'
! '/' '%'; 6 '+' '-'; 7 '&'; 8 a comparison; 9 '~' and NOT; 10 AND; 11 OR and XOR, which share
! one level and are read left to right. A smaller number binds tighter. 0 = not an operator.
! AND binds tighter than OR - `a or b and c` is `a or (b and c)` - as the language reference's
! Logical Expressions table says and the compiler does; its Expression Evaluation table, which
! puts NOT, AND and OR on one level, does not match the compiler. A '-' or '+' is given its
! binary level here; a caller that meets one in front of a term treats it as a sign, which
! binds tighter than everything.
VitEngine.OpLevel Procedure(LONG pTok)
u    string(3),auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type = vt:Literal then return 0.
  if size(self.tk.tokens.tok) > 3 then return 0.
  u = upper(self.tk.tokens.tok)
  case u
  of '^'
    return 4
  of '*'   orof '/'   orof '%'
    return 5
  of '+'   orof '-'
    return 6
  of '&'
    return 7
  of '='   orof '<<>' orof '~=' orof '<<' orof '>' orof '<<=' orof '>=' orof '=<<' orof '=>' orof '~<<' orof '~>'
    return 8
  of '~'   orof 'NOT'
    return 9
  of 'AND'
    return 10
  of 'OR'  orof 'XOR'
    return 11
  end
  return 0

! The loosest operator in [pS..pE] that stands outside every bracket - ( [ { - as OpLevel
! numbers it; 0 = none, the span is one term: a name, a constant, a call, a subscript. An
! operator inside a call's arguments or a subscript binds there and is not counted.
VitEngine.SpanTopLevel Procedure(LONG pS, LONG pE)
j    long,auto
d    long,auto
lv   long,auto
top  long,auto
  code
  d = 0
  top = 0
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1
      case self.tk.tokens.tok
      of '(' orof '[' orof '{{'
        d += 1
        cycle
      of ')' orof ']' orof '}'
        d -= 1
        cycle
      end
    end
    if d then cycle.
    lv = self.OpLevel(j)
    if lv > top then top = lv.
  end
  return top

! The first token in [pS..pE] that stands outside every bracket - ( [ { - and whose text, in
! capitals, is one of the words of pWordsU, written with a space either side of each word
! (' OR XOR '); 0 = none. A word inside a call's arguments or a subscript belongs there.
VitEngine.SpanTopWord Procedure(LONG pS, LONG pE, STRING pWordsU)
j    long,auto
d    long,auto
  code
  d = 0
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1
      case self.tk.tokens.tok
      of '(' orof '[' orof '{{'
        d += 1
        cycle
      of ')' orof ']' orof '}'
        d -= 1
        cycle
      end
    end
    if d then cycle.
    if self.tk.tokens.type = vt:Literal then cycle.
    if instring(' ' & upper(self.tk.tokens.tok) & ' ', pWordsU, 1, 1) then return j.
  end
  return 0

! 1 = every NAME in [pS..pE] provably reads DATA, so the span cannot CALL anything.
!
! A '(' is not the question this answers. Clarion spells a call to a parameterless procedure or
! method exactly like reading a field - `if IsReady` carries no bracket at all - so a bracket test
! passes one straight through, and the START-hoist would then move a write in front of a call that
! reads it. This makes the proof CondIsPureRead makes for a one-token test, for every name in the
! span: a plain name has to resolve in the symbol table to data, and a dotted name has to resolve
! hop by hop to FIELDS. A name that does not resolve REFUSES - it may be a procedure declared in
! an include this run did not read, and a label may legally hold a colon, so an equate-looking
! spelling proves nothing either.
!
! Reserved words, operators, literals and numbers are not names and are stepped over.
! Keep this and CondIsPureRead's one-token proof in step: they answer the same question.
VitEngine.CondNamesAreData Procedure(LONG pCS, LONG pCE)
i     long,auto
dotP  long,auto
rf    byte
head  STRING(vs:maxName),AUTO
tU    STRING(vs:maxName)
txt   StringTheory
segs  StringTheory
  code
  if self.syms &= NULL then return 0.
  if pCE < pCS then return 1.
  loop i = pCS to pCE
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    txt.setValue(self.tk.tokens.tok)
    if ~txt._DataEnd then return 0.
    dotP = txt.findByte(46) ! <dot>
    if ~dotP
      if ~self.syms.Lookup(txt.getValue(), i, tU, rf) then return 0.
      cycle
    end
    if dotP < 2 or dotP >= txt._DataEnd then return 0.
    head = upper(txt.sub(1, dotP - 1))
    if ~self.syms.Lookup(head, i, tU, rf) then return 0.
    segs.setValue(txt.slice(dotP + 1))
    segs.replaceByte(46, 124)
    if ~self.syms.LookupChain(tU, segs.getValue(), i) then return 0.
  end
  return 1

! 1 = the name at pTok may be a CALL with no brackets: Clarion calls a parameterless procedure or
! method by its label alone, so a name with no '(' after it is a call unless the symbol table
! places it as data (CondNamesAreData). Not a call: a name followed by '(' (the call is made with
! brackets and is found by them), '[' or '.', the tail of a member, a column-1 label, TRUE and
! FALSE, and a name holding a colon - an equate such as st:clip or a prefixed field, which the
! table may not hold when the include that declares it is not read. A '.' counts only when it
! joins a receiver to a member (DgIsMemberDot): the '.' that ends `if a then f = Bump.` is
! not one, and Bump there is still a call.
VitEngine.BareNameIsCall Procedure(LONG pTok)
t   STRING(vs:maxName),AUTO
  code
  if self.syms &= NULL then return 1.
  get(self.tk.tokens, pTok)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type <> vt:label then return 0.
  t = upper(self.tk.tokens.tok)
  if t = 'TRUE' or t = 'FALSE' then return 0.
  if instring(':', t, 1, 1) then return 0.
  case self.tk.GetTok(pTok + 1)
  of '(' orof '['
    return 0
  of '.'
    if self.DgIsMemberDot(pTok + 1) then return 0.
  end
  if self.DgIsMemberDot(pTok - 1) then return 0.
  if self.syms.IsColOneLabel(pTok) then return 0.
  return choose(~self.CondNamesAreData(pTok, pTok))

! 1 = the name at pTok may be a call with no brackets, as BareNameIsCall answers - except that a
! StringTheory's own _DataEnd or valuePtr is data, whether or not the symbol table holds the fields
! of StringTheory: it does not when the include that declares them was not read.
VitEngine.BareCallAt Procedure(LONG pTok)
t   STRING(vs:maxName),AUTO
n   long,auto
d   long,auto
  code
  if ~self.BareNameIsCall(pTok) then return 0.
  t = upper(self.tk.GetTok(pTok))
  n = len(clip(t))
  d = self.DgLastDot(t)
  if d > 1 and d < n
    case t[d + 1 : n]
    of '_DATAEND' orof 'VALUEPTR'
      if self.HayType(t[1 : d - 1], pTok) = 'STRINGTHEORY' then return 0.
    end
  end
  return 1

! 1 = a label token (type 'b') in [pS..pE] names the same STORAGE as pNameU.
!
! *** COMPARED BY ROOT, NOT BY SPELLING. *** The tokenizer merges a dotted name into ONE token,
! so a whole-token compare for `GRP` never matches the token `GRP.X` - and the caller is asking
! whether a statement it wants to move writes something the condition reads. A GROUP appears in
! an expression as a string over its members, so `grp` and `grp.x` ARE the same bytes; and a
! colon is a second spelling of the same qualification, so `pq:a` and `pq.a` are one field.
! Comparing the text saw none of that, and HoistCommonBranchCode moved `grp = 1` above
! `if grp.x = 2` - the condition then read what the hoist had just written, and the other arm
! ran.
!
! So both sides are cut at the first '.' or ':' and the roots compared. That over-refuses two
! genuinely-independent members of one structure (`pq:a` against `pq:b`), which is the same cut
! MgQualClash takes for the same reason: a refusal costs one hoist, and the alternative is
! teaching this the storage model.
VitEngine.SpanHasName Procedure(STRING pNameU, LONG pS, LONG pE)
i    long,auto
  code
  if pE < pS then return 0.
  loop i = pS to pE
    get(self.tk.tokens, i)
    if errorcode() then return 1.
    if self.tk.tokens.type <> 'b' or |
       self.tk.tokens.tok &= NULL
      cycle
    end
    if self.NameRoot(self.tk.tokens.tok) = self.NameRoot(pNameU) then return 1.
    if self.PreOf(self.tk.tokens.tok) = self.NameRoot(pNameU) or self.PreOf(pNameU) = self.NameRoot(self.tk.tokens.tok) then return 1.
  end
  return 0

! The label of the structure whose PRE a prefixed name carries - `pg:a` to G - or blank. A GROUP
! reads as a string over its fields, so a write to `pg:a` is a write to g, which NameRoot cannot
! see: PG and G are two roots for one storage. The label is read from the declaration that
! carries `PRE(pg)`, in this scope or above it.
!===============================================================================================
VitEngine.PreOf Procedure(STRING pNameU)
p    long,auto
k    long,auto
preU string(vs:maxName),auto
  code
  p = instring(':', pNameU, 1, 1)
  if p < 2 then return ''.
  preU = upper(pNameU[1 : p - 1])
  loop k = 1 to records(self.tk.tokens)
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or upper(self.tk.tokens.tok) <> 'PRE' then cycle.
    if self.tk.GetTok(k + 1) <> '(' or upper(self.tk.GetTok(k + 2)) <> preU then cycle.
    loop p = k - 1 to 1 by -1
      if self.IsEolTok(p) then break.
    end
    get(self.tk.tokens, p + 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.syms.IsColOneLabel(p + 1) then return upper(self.tk.tokens.tok).
    return ''
  end
  return ''

! The part of a name before any qualification - `grp.x` and `pq:a` both have the root that
! names the storage. Upper-cased, because Clarion labels are not case sensitive.
VitEngine.NameRoot Procedure(STRING pName)
p  long,auto
q  long,auto
t  StringTheory
  code
  t.setValue(pName)
  t.trim()
  t.upper()
  if ~t._DataEnd then return ''.
  ! *** WHICHEVER COMES FIRST, not the dot in preference to the colon. *** The two are
  ! interchangeable (LRM: a ':' may replace a '.' for any structure except CLASS), so a
  ! name may be spelt `grp:x.m` - and looking for the dot first roots that at GRP:X, which
  ! is not the storage. Measured: `grp = 1` hoisted above `if grp:x.m = 2`, the same wrong
  ! branch this routine was written to stop.
  p = t.findByte(46) ! '.'
  q = t.findByte(58) ! ':'
  if q and (~p or q < p) then p = q.
  if p > 1 then t.setLength(p - 1).
  return choose(t._DataEnd < 1, '', t.valuePtr[1 : t._DataEnd])

! 1 = the statement [pFirst..pCEnd] is a plain `label = ...` assignment with no call: first
! token is a label, second is '=', no '(' anywhere, and every name on the right-hand side
! provably reads data.  So its only effect is writing lhs.
!
! THE BRACKET TEST ALONE IS NOT THE CALL TEST. Clarion calls a parameterless procedure or
! method by its label alone - `seq = NextSeq` runs NextSeq - so a right-hand side with no
! '(' in it can still call something, and if that call writes what the condition reads the
! hoist has moved it in front of the test. The right-hand side of every statement on the
! line therefore goes through CondNamesAreData, the proof the condition itself gets: a name
! that does not resolve to data refuses. The left-hand side is not asked - a write target is
! storage whatever it resolves to.
VitEngine.StmtIsPlainAssign Procedure(LONG pFirst, LONG pCEnd)
j    long,auto
open long,auto ! 1 = the next real token STARTS a statement
rhsS long,auto ! the first token after the '=' of the statement in hand
  code
  ! EVERY statement on the line, not just the first. A Clarion line holds as many
  ! `;`-separated statements as the author likes, and the caller moves the whole LINE - so a
  ! line is a plain assignment only when each of its statements is one. Checking the first
  ! alone let `s = 1 ; do Init` past a gate that had just proved the condition call-free.
  if pCEnd < pFirst + 1 then return 0.               ! need at least `lhs = rhs`
  if self.SpanHasParen(pFirst, pCEnd) then return 0. ! a call anywhere -> not a pure assignment
  open = 1
  rhsS = 0
  loop j = pFirst to pCEnd
    get(self.tk.tokens, j)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = ';'                      ! a separator: the next real token opens a statement
      if ~open and ~self.CondNamesAreData(rhsS, j - 1) then return 0.
      open = 1
      cycle
    end
    if ~open then cycle.                             ! inside a statement already judged
    if self.tk.tokens.type <> 'b' then return 0.     ! it does not start with a label, so not `lhs = ...`
    get(self.tk.tokens, j + 1)
    if errorcode() or self.tk.tokens.tok &= NULL then return 0.
    if self.tk.tokens.tok <> '=' then return 0.
    rhsS = j + 2
    open = 0
  end
  if open then return 0.                             ! a trailing `;` with nothing after it
  return self.CondNamesAreData(rhsS, pCEnd)          ! the last statement's right-hand side names data only

! ------------------------------------------------------------------------------------
! Small token-geometry helpers used by the hoist builtins.
! ------------------------------------------------------------------------------------
VitEngine.IsFirstOnLine Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.firstOnLine then return 1.
  return 0

! ------------------------------------------------------------------------------------
! Does token pTok begin a STATEMENT? It does when the token before it ends a line, or is a ';',
! THEN or ELSE, or is a column-1 label standing in front of its statement (`Again  x = 1`).
! A token that a '|' continuation puts at the start of a line does NOT: its statement began on
! the line above, so in `if a = 1 or |` / `b = 2` the `b = 2` is a comparison. Being first on
! a line is therefore not the test - firstOnLine is set on a continuation line as well.
! The buffer is left on pTok.
! ------------------------------------------------------------------------------------
VitEngine.BeginsStmt Procedure(LONG pTok)
ans  long,auto
  code
  ans = 0
  if pTok <= 1
    ans = 1
  else
    get(self.tk.tokens, pTok - 1)
    if errorcode() or self.tk.tokens.tok &= NULL
      ans = 1
    elsif self.tk.tokens.tok = ';' or self.tk.tokens.tok[1] = '<10>'
      ans = 1
    else
      case upper(self.tk.tokens.tok)
      of 'THEN' orof 'ELSE'
        ans = 1
      end
    end
    if ~ans and not self.syms &= NULL
      if self.syms.IsColOneLabel(pTok - 1) then ans = 1.
    end
  end
  get(self.tk.tokens, pTok)
  return ans

! ------------------------------------------------------------------------------------
! Does `=` after the name at pTok STORE into it, rather than compare? 1 = it does: the name
! begins its statement (BeginsStmt), or it is the counter of a LOOP that begins one - both
! `loop n = 1 to k` and `Again  loop n = 1 to k` write n as the loop starts and on every pass.
! 2 = it does, on a line the DEBUG mark begins: a '?' alone in column 1 makes the whole line,
! every statement on it, run in debug builds only (measured 3 Nov 2026), so a store there
! happens in one build and not in the other. The name right after the mark begins its
! statement too. 0 = it compares. The operator after the name is the caller's to test. The
! buffer is left on pTok.
! ------------------------------------------------------------------------------------
VitEngine.StoreHead Procedure(LONG pTok)
ans  long,auto
dbg  long,auto
  code
  ans = self.BeginsStmt(pTok)
  dbg = self.DebugLine(pTok)
  if ~ans and dbg and self.IsFirstOnLine(pTok - 1) then ans = 1.
  if ~ans and upper(self.tk.GetTok(pTok - 1)) = 'LOOP'
    if self.BeginsStmt(pTok - 1) then ans = 1.
    if dbg and self.IsFirstOnLine(pTok - 2) then ans = 1.
  end
  get(self.tk.tokens, pTok)
  if ans and dbg then return 2.
  return ans

! ------------------------------------------------------------------------------------
! Is the token at pTok on a line the DEBUG mark begins - a '?' alone, first on its line? Such a
! line runs in debug builds only. The mark belongs to the PHYSICAL line: the first token of a
! '|' continuation is first on a line of its own, so the walk stops there and the continuation
! is not marked, which is how the compiler reads it. The buffer is left where the walk stopped.
! ------------------------------------------------------------------------------------
VitEngine.DebugLine Procedure(LONG pTok)
k  long,auto
  code
  loop k = pTok to 1 by -1
    get(self.tk.tokens, k)
    if errorcode() then return 0.
    if ~self.tk.tokens.firstOnLine then cycle.
    if self.tk.tokens.tok &= NULL then return 0.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok[1] = '?' then return 1.
    return 0
  end
  return 0

! ------------------------------------------------------------------------------------
! Is token pTok the end-of-line token - a single byte 10.
!
! A line ending is its OWN token in this model rather than trivia, which is what makes "the
! end of this line" a position that can be found rather than inferred. Answers 0 rather than
! raising on a bad index.
! ------------------------------------------------------------------------------------
VitEngine.IsEolTok Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then return 1.
  return 0

! The trivia after the LAST line feed of pTok's strBefore - the line's own indent and nothing
! else. A first-on-line token's strBefore is normally just its indent, but the tokenizer folds a
! plain OMIT('***') block into the strBefore of the token AFTER it, whole, line feeds and all;
! a caller that copies "the indent" from such a token would copy the block with it.
VitEngine.IndentOf Procedure(LONG pTok, StringTheory pOut)
lf  long,auto
  code
  pOut.free()
  get(self.tk.tokens, pTok)
  if errorcode() then return.
  if self.tk.tokens.strBefore &= NULL then return.
  lf = size(self.tk.tokens.strBefore)
  loop while lf >= 1
    if self.tk.tokens.strBefore[lf] = '<10>' then break.
    lf -= 1
  end
  if lf < size(self.tk.tokens.strBefore) then pOut.setValue(self.tk.tokens.strBefore[lf + 1 : size(self.tk.tokens.strBefore)]).

! Does pTok's strBefore hold a line feed - an OMIT block folded in front of it (see IndentOf)?
! A caller about to REPLACE that strBefore, or delete the token, would lose the block.
VitEngine.HasAbsorbedBlock Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.strBefore &= NULL then return 0.
  return choose(instring('<10>', self.tk.tokens.strBefore, 1, 1) > 0)

! The rest of pTok's strBefore - everything up to and including its LAST line feed: an OMIT block
! the tokenizer folded in front of the token's line, or nothing. IndentOf gives the part after it.
! A caller that deletes the line, or puts new lines in front of it, keeps this part where the line
! stood (DropLinesKeepCmts, InsertLinesAbove); the block is the author's text, never compiled.
VitEngine.AbsorbedBlockOf Procedure(LONG pTok, StringTheory pOut)
lf  long,auto
  code
  pOut.free()
  get(self.tk.tokens, pTok)
  if errorcode() then return.
  if self.tk.tokens.strBefore &= NULL then return.
  lf = size(self.tk.tokens.strBefore)
  loop while lf >= 1
    if self.tk.tokens.strBefore[lf] = '<10>' then break.
    lf -= 1
  end
  if lf then pOut.setValue(self.tk.tokens.strBefore[1 : lf]).

! Put the whole lines in pTxt, each closed by CR/LF, in front of the line that starts at pTok. An
! OMIT block folded into pTok's trivia stays ABOVE the new lines, where it stood, and pTok keeps
! only its indent - the shape TsApplyInsert gives a comment parked above a statement (14 Sep 2026).
! A plain InsertString would put the new lines between the block and the code it was written
! against. With no block, or where pTok does not begin a line, this is InsertString exactly.
VitEngine.InsertLinesAbove Procedure(LONG pTok, StringTheory pTxt)
blk  StringTheory
ind  StringTheory
k    long,auto
  code
  if pTok > 1 and ~self.IsEolTok(pTok - 1)
    self.tk.InsertString(pTok, pTxt)
    return
  end
  self.AbsorbedBlockOf(pTok, blk)
  if ~blk._DataEnd
    self.tk.InsertString(pTok, pTxt)
    return
  end
  self.IndentOf(pTok, ind)
  k = records(self.tk.tokens)
  self.tk.InsertString(pTok, pTxt)
  k = records(self.tk.tokens) - k
  if k < 1 then return.
  self.tk.SetStrBefore(pTok + k, ind.getValue())
  self.tk.PrependStrBefore(pTok, blk.getValue())

! Every OMIT block folded in front of a line that starts between pFirst and pLast, in order, into
! pOut. A caller deleting those lines puts pOut back on the token that begins the spot after the
! delete (PrependStrBefore), so the author's text stays where the lines stood, as DropLinesKeepCmts
! keeps it. A token that carries on a line after a `|` begins no line, and its trivia is the bar's.
VitEngine.LineBlocks Procedure(LONG pFirst, LONG pLast, StringTheory pOut)
one  StringTheory
x    long,auto
  code
  pOut.free()
  loop x = pFirst to pLast
    if x > 1 and ~self.IsEolTok(x - 1) then cycle.
    self.AbsorbedBlockOf(x, one)
    pOut.append(one)
  end

! Walk back from an EOL token to the first-on-line token of that same line.  Returns 0 if
! the line is blank (another EOL is hit first) or on any error.
VitEngine.LineStartOf Procedure(LONG pEolTok)
i  long,auto
  code
  i = pEolTok - 1
  loop while i >= 1
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if self.tk.tokens.firstOnLine then return i.
    if not self.tk.tokens.tok &= NULL
      if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then return 0.
    end
    i -= 1
  end
  return 0

! ------------------------------------------------------------------------------------
! Does any token between pFirst and pEol carry a block mark - '+', '-' or '/'.
!
! Used to leave structural lines alone: a line that opens or closes a block is not a plain
! statement, and several transforms are only safe on plain statements.
!
! IT ANSWERS 1 ON ERROR, ON PURPOSE. "I could not tell" has to mean "assume it is structural",
! because the failure that matters is treating a block line as ordinary and splicing it.
! ------------------------------------------------------------------------------------
VitEngine.LineHasLevelMark Procedure(LONG pFirst, LONG pEol)
i   long,auto
! #Removed as not used: lvl string(1),auto
  code
  loop i = pFirst to pEol
    get(self.tk.tokens, i)
    if errorcode() then return 1.  ! treat trouble as "has mark" -> skip (safe)
    case val(self.tk.tokens.level)
    of 43 orof 47 orof 45          ! '+' orof '/' orof '-'
      return 1
    end
  end
  return 0

! A comment anywhere in the line's trivia - leading (before pFirst's token), interior,
! or trailing (in the EOL's strBefore): a '!', or words written after a continuation bar,
! which the tokenizer keeps in the next token's trivia.  Under-reach: a hoist could move or drop it.
VitEngine.LineHasComment Procedure(LONG pFirst, LONG pEol)
i   long,auto
b   long,auto
  code
  loop i = pFirst to pEol
    get(self.tk.tokens, i)
    if errorcode() then return 1.
    if not self.tk.tokens.strBefore &= NULL
      if instring('!', self.tk.tokens.strBefore, 1, 1) then return 1.
      b = instring('|', self.tk.tokens.strBefore, 1, 1)
      if b
        loop b = b + 1 to size(self.tk.tokens.strBefore)
          case self.tk.tokens.strBefore[b]
          of '<13>' orof '<10>'
            break
          of ' '    orof '<9>'
          else
            return 1
          end
        end
      end
    end
  end
  return 0

! ------------------------------------------------------------------------------------
! The COMMENT TEXT carried by a line, all of it, normalised and concatenated - everything
! AFTER the '!', from every token's trivia across [pFirst..pEol]. '' when the line carries none.
! It is the TEXT, deliberately, not the trivia bytes, and the normalising is deliberately
! generous: the '!' itself, the column it sits in, tabs, and runs of spaces all drop out, so
! two lines that SAY the same thing compare equal however they are laid out. Layout is exactly
! what differs between two branches of an IF in real code - one arm is indented further, or the
! comments were aligned to different columns - and refusing those would make the flexibility
! worthless. Only the words are compared.
! ------------------------------------------------------------------------------------
VitEngine.LineCommentText Procedure(LONG pFirst, LONG pEol, StringTheory pOut)
x   long,auto
bp  long,auto
sb  StringTheory
  code
  pOut.free()
  loop x = pFirst to pEol
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.strBefore &= NULL then cycle.
    sb.setValue(self.tk.tokens.strBefore)
    bp = sb.findByte(33)              ! '!'
    if ~bp then cycle.
    sb.RemoveFromPosition(1,bp)       ! keep everything AFTER the '!'
    sb.replaceByte(9, 32)             ! a tab is white space like any other here  ! replace all <tab> with <space>
    sb.trim()                         ! trim first - thanks Carl
    loop while sb.replace('  ', ' '). ! runs of spaces collapse: only the WORDS are the text
    if pOut._DataEnd then pOut.append(' ').
    pOut.append(sb)
  end

! Caseless token-for-token equality of two spans [pAF..pAE] and [pBF..pBE].
VitEngine.SpanTokEqual Procedure(LONG pAF, LONG pAE, LONG pBF, LONG pBE)
k   long,auto
o   long,auto
ta  StringTheory ! holds token A while token B is fetched - no fixed width to overflow
lit byte,auto    ! token A is a string literal, so its case is data and must match exactly
  code
  if pAE - pAF <> pBE - pBF then return 0.
  o = pBF - pAF
  loop k = pAF to pAE
    get(self.tk.tokens, k)
    if errorcode() then return 0. ! BOTH gets are checked. A failed fetch leaves the queue
    ! buffer on the PREVIOUS record, so an unchecked get compares a token with itself and
    ! answers 1 - the spans are the same length, so nothing else catches it. `ta` HOLDS the
    ! first token's text while the second is fetched, because the get below overwrites the
    ! queue buffer. It is a StringTheory rather than a fixed STRING so that a long token
    ! cannot be held as its PREFIX: two different long tokens sharing one would compare
    ! EQUAL, and this answer feeds the hoists, which MOVE code on the strength of it. A
    ! StringTheory has no length to guess and nothing to truncate, so the comparison is
    ! simply always right and no over-long token has to be refused.
    if self.tk.tokens.tok &= NULL
      ta.free()
      lit = 0
    else
      ta.setValue(self.tk.tokens.tok)
      lit = choose(self.tk.tokens.type = vt:literal)
      if ~lit then ta.upper().    ! a name is caseless in Clarion; a string literal is not
    end
    get(self.tk.tokens, k + o)    !   the second get, checked for the reason above
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL
      if ta._DataEnd then return 0.
    elsif lit or self.tk.tokens.type = vt:literal
      ! A STRING LITERAL IS DATA, NOT A NAME, so the two are compared byte for byte. Clarion
      ! identifiers and keywords carry no meaning in their case and stay caseless above.
      ! 'abc' and 'ABC' hold different characters, and answering "same" for them tells the
      ! callers that two branches run the same statement when they do not - the hoists then
      ! move one copy out and delete the other, and the branch that stored the other spelling
      ! silently stores this one instead. The closing quote is part of the token, so two
      ! literals differing only in trailing spaces do not compare equal here either.
      if choose(ta._DataEnd < 1, '', ta.valuePtr[1 : ta._DataEnd]) <> self.tk.tokens.tok then return 0.
    else
      if choose(ta._DataEnd < 1, '', ta.valuePtr[1 : ta._DataEnd]) <> upper(self.tk.tokens.tok) then return 0.
    end
  end
  return 1

!===============================================================================================
! INLINE A TEMPORARY THAT IS USED ONCE.
!
!     wU = upper(self.rl.rules.patQ.tok)          case upper(self.rl.rules.patQ.tok)
!     case wU                             ==>
!
! The variable existed only to carry a value to the very next line, so the expression moves to
! where it is read and the store line goes with it.
!
! *** THIS IS THE ONLY BUILTIN THAT MOVES CODE RATHER THAN RESPELLING IT, and a wrong inline is
! SILENT - the result still compiles and still runs. Everything below is written to refuse
! rather than to convert. ***
!
! WHY THE NEXT STATEMENT AND ONLY THE NEXT. "Nothing between the write and the read changes what
! the expression reads" is trivially true when there is nothing between them. Copy propagation
! over any distance needs a clobber analysis this tool does not have, so the narrow form is not a
! first cut - it is the form that can be proved with what is here.
!
! CONVERT ONLY WHEN ALL OF THESE HOLD. Each maps to a refusal below and to a pinned case in
! tests\inline_singleuse\in.clw:
!   1  the scope has no GOTO / COMPILE / OMIT       - AutoScopePrep's acBail already answers this
!   2  the target is a plain local of that scope    - AutoEligible already answers this: not a
!                                                     parameter, not STATIC/THREAD/OVER/EXTERNAL,
!                                                     not DIM, not reference, not routine-touched
!   3  the store is a whole statement `v = <expr>`, v the ENTIRE left side, and v STARTS the
!      statement: the token before it is a line end. A row after a '|' is first on its
!      physical line but in the middle of the statement above - in `until cnt > 10 or |`
!      / `b = 0` that row compares b, and taking it for a store deletes half the condition
!   4  the store line carries NO trailing comment   - the line is deleted and the comment with it
!   5  a statement CONTINUED with a bar is read as the single statement it is, and inlined
!      whole - A BAR IS TRIVIA AND NOT A TOKEN, so nothing here needs to see it. The
!      inlinesu fixture pins it
!   6  the next statement reads v EXACTLY ONCE and never writes it. ONCE is essential: twice
!      would evaluate <expr> twice, which is a different program even when <expr> is pure
!   7  <expr> does not mention v itself
!   8  <expr> calls nothing outside IfCasePureList - the same list IfChainToCase uses, so
!      upper() is allowed and a side-effecting call is refused
!   9  the next statement is not a jump label
!  10  nothing AFTER the read still needs the store: inlining also DELETES the store, so a
!      later read of the variable would see whatever was there before.
!
! The next statement MAY open a block: `case v` and `if v` are the shapes this exists for.
!
! WHAT IT DOES NOT DO. The variable may be written again later and each store/read pair is judged
! on its own - this pass never reasons about the variable's whole life. If every pair ends up
! inlined the declaration becomes unused, and UnusedVars is what removes it, on its own evidence.
!
! NO PURE(...) PARAMETER, deliberately, unlike IfChainToCase. Widening the purity list is how a
! side-effecting call gets into an inline, and this pass has less margin for that than any other.
! The built-in list is the whole of it until someone asks for more with a case to go with it.
!
! THE SPLICE. Highest position first, the established order - a delete shifts every index above
! it, so right-to-left is the only order in which staged positions stay valid. The read token is
! overwritten with the expression's text and the store statement is deleted; then wantReparse
! re-lexes, which restores level marks and line numbers instead of this pass maintaining them.
! That is what keeps the whole MoveToks class of index bug out of it. Note the expression text is
! rendered AT APPLY TIME rather than stored: entries are applied highest-first, so when an entry
! is reached nothing at or below its own indices has been touched yet and its span is still there.
!
! OPT-IN, OWN GROUP, OFF. A pass that moves code does not run on someone else's source because
! they typed no switches. vitrules.txt declares it inside `GROUP inline-singleuse, OFF`.

!===============================================================================================
! BUILTIN LoopBlankRecords - the trailing-blank-record loop. The SameReport shape, step 2.
!
!     a.split('<10>')                           a.clip('<32,10>')
!     na = a.records()                          a.split('<10>')
!     loop while na > 0                  ==>    na = a.records()
!       la.setValue(a.getLine(na),st:clip)
!       if la._DataEnd then break.
!       na -= 1
!     end
!
! The split may sit anywhere earlier in the procedure (guard G1 finds it and reads its
! separator - a string literal: a line feed, or any other single byte, gives the one-line clip
! above; a longer separator such as '<<13,10>' gives a short loop that strips WHOLE separators
! off the end, never characters, so a lone trailing carriage return stays as the walk keeps it
! (14 Sep 2026; proved on 21 shapes by looplim\LoopEq2.clw) - and G4 sees that nothing touches
! the object between the split and the loop). The st:clip lands on the split later, from ClipAtSplit, once every
! read of the lines is proved to clip. The read line has a second, scratch-free spelling that
! an author may write directly and that DropLineBuffer writes when it makes the scratch the
! object itself (14 Sep 2026):
!
!       a.setValueFromLine(na)
!       a.clip()                                <- optional when the split already clips
!       if a._DataEnd then break.
!
! EVERY AUTO LOCAL HERE IS WRITTEN BEFORE IT IS READ - CHECK THAT FIRST when the walk goes
! dead. Three times (10 Sep 2026, and twice on 14 Sep) every site failed its shape tests with
! nothing reported, each time right after an edit that could not have caused it, and twice a
! bisection blamed the last edit made - a method called on a local object from a routine, a
! local passed by reference from a routine - and a workaround shipped with a story about the
! compiler. The cause was LbPrevLine reading scFirst, an AUTO local, before LbScope had set
! it: it held whatever the stack held, and every edit to this procedure moved the stack. The
! scope is found first now. The methods the workarounds left behind (LbClipLineAt,
! LbValueReadOK, and later LbSepAt, LbEmitAt) stay - they are sound - but the rule they were
! written under was not.
!
! THE REWRITE IS PROVEN. looplim\LoopEq.clw builds and RUNS both spellings against the real
! StringTheory over eighteen shapes - with and without a final newline, one and two trailing
! blanks, trailing spaces, a blank record in the MIDDLE, all-blank, CRLF pairs, trailing tabs, a
! trailing CR - and they agree on every one. That was never the hard part.
!
! *** ONE SITE IS REWRITTEN PER PASS, AND ONLY AFTER ALL SEVEN GUARDS PASS. *** The guards
! are the whole value of it and
! they are worth reading against TestData\loopblank.clw before a token is moved: a wrong
! conversion here is SILENT. It compiles, it runs, and the program answers differently.
!
! WHY A BUILTIN AND NOT A RULE, measured rather than assumed. The shape-only rule was run over
! the fixture (loopguard.bat): it converted SIX of the eight procedures and five of those it had
! to refuse. It caught the two guards visible in the SHAPE and missed all five that depend on
! what happens elsewhere in the procedure. No WHERE the rule language has - isCallFree, isSimple,
! isOneChar, isNonNull, isPure, isConst, isBoolExpr, isByte, isCaseNeutral, len - describes
! anything but the matched text itself, apart from returnsRef and returnsValue, which read only
! what the procedure around it is prototyped to return.
!
! THE SHAPE TESTS DO NOT ASSUME HOW A DOTTED NAME TOKENISES. `la.setValue` may arrive as one
! token or as three; every test here asks for the tail after the last dot and takes the head from
! in front of it, whichever way it came. Guessing that cost two build cycles on 10 Sep.
!===============================================================================================
VitEngine.BuiltinLoopBlankRecords Procedure(StringTheory pLog)
i          long,auto
lbFrom     long,auto
lbNext     long,auto
lbX        long,auto
lbY        long,auto
lbD        long,auto
lbN        long,auto
loopTok    long,auto
cntTok     long,auto
endTok     long,auto
splitTok   long,auto
sc         long,auto
scFirst    long,auto
scLast     long,auto
scCode     long,auto          ! the end of the procedure's header: a declaration inside it is a parameter
lbOwn      long,auto          ! G0Own: the object's row in the symbol table
lbWant     STRING(64)         ! input to LbFind  - the dot-TAIL to look for
lbFound    long               ! output of LbFind - lbQ row, 0 = not there
lbHeadIx   long               ! input to LbHead  - an lbQ row
lbHead     STRING(vs:maxName) ! output of LbHead - the receiver in front of it
lbHitTok   long               ! the FIRST convertible site, remembered so the walk can finish
lbHitSplit long
lbHitEnd   long
lbHitSep   long               ! the remembered site's separator token (G1), for LbEmitAt
lbHitLine  long
lbHitKind  byte
vName      STRING(vs:maxName),AUTO
sName      STRING(vs:maxName)
bName      STRING(vs:maxName)
why        STRING(200)
gFrom      long,auto          ! the guard walks step a LINE at a time
gHit       long,auto
gDep       long               ! G4Dom: depth walking from the split to the count line
gQrm       byte               ! G1: the split removes quotes
gQuo       byte               !   or has a quote start: an unclosed quote holds the trailing separators in its record
gArg       long               !   and its call's token; G5Read: the first row of a getLine call
gRow       long
gTail      STRING(96)
lbSepTok   long               ! G1: the separator's token, the split's first argument; LbSepAt reads the literal
lbSplitAl  byte               ! G1: 1 = the split is its whole line, 2 = it shares it with ;-joined statements
lbSplitHd  long               ! G1: the split statement's first token, its receiver - the clip goes in front of it
lbFree     byte,auto          ! the read line is the scratch-free spelling: <s>.setValueFromLine(<v>)
lbClipLn   byte,auto          !   with <s>.clip() on the line after it
lbSplitHas byte               ! the split already carries st:clip (G1 reads it)
gNext      long,auto          ! the G5 walk's next line, past a clip line it stepped over
gTop       long               ! the first token of the outermost loop around the walk-back loop, 0 = none
gStop      long               ! the last token a G3 or G5 walk looks at
gDom       long               ! G3: the depth of the shallowest write of the buffer in force
gArgEnd    long               ! G3: a write's closing bracket - it runs once its arguments are read
gLvl       long               ! block or bracket depth, scratch
gPre       byte               ! G3: walking the outer loop's lines above the walk-back loop
lbQ       QUEUE,PRE(lb)
tx          STRING(96)
tk          long
          END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'LOOP' then cycle.
    loopTok = i
    ! ---- LOOP WHILE <v> > 0
    lbFrom = loopTok ; do LbFill
    if records(lbQ) <> 5 then cycle.
    get(lbQ, 2) ; if lbQ.tx <> 'WHILE' then cycle.
    get(lbQ, 4) ; if lbQ.tx <> '>'     then cycle.
    get(lbQ, 5) ; if lbQ.tx <> '0'     then cycle.
    get(lbQ, 3) ; vName = lbQ.tx
    ! ---- <b>.setValue( <s>.getLine( <v> ), st:clip )       the scratch spelling, or
    ! ---- <s>.setValueFromLine( <v> ) [ <s>.clip() ]         the scratch-free one (14 Sep 2026)
    lbFrom = lbNext ; do LbFill
    lbFree = 0 ; lbClipLn = 0
    lbWant = 'SETVALUEFROMLINE' ; do LbFind
    if lbFound
      lbHeadIx = lbFound ; do LbHead ; sName = lbHead ; bName = sName
      lbWant = vName ; do LbFind ; if ~lbFound then cycle.
      if ~sName then cycle.
      if records(lbQ) <> 4 and records(lbQ) <> 6 then cycle.                         ! EXACTLY <s>.setValueFromLine(<v>), alone
      get(lbQ, records(lbQ)) ; if lbQ.tx <> ')' then cycle.
      get(lbQ, records(lbQ) - 1) ; if lbQ.tx <> vName then cycle.
      get(lbQ, records(lbQ) - 2) ; if lbQ.tx <> '(' then cycle.
      if lbHeadIx <> records(lbQ) - 3 then cycle.
      get(lbQ, 2) ; if lbHeadIx = 3 and lbQ.tx <> '.' then cycle.
      lbFree = 1
      lbClipLn = self.LbClipLineAt(lbNext, sName)                                    ! <s>.clip() on the next line?
      if lbClipLn then lbNext = self.lbClipNext.                                     !   then the IF is the line after it
    else
      lbWant = 'SETVALUE' ; do LbFind ; if ~lbFound then cycle.
      gRow = lbFound
      lbHeadIx = lbFound ; do LbHead ; bName = lbHead
      lbWant = 'GETLINE'  ; do LbFind ; if ~lbFound then cycle.
      lbHeadIx = lbFound ; do LbHead ; sName = lbHead
      lbWant = 'ST:CLIP'  ; do LbFind ; if ~lbFound then cycle.
      lbWant = vName      ; do LbFind ; if ~lbFound then cycle.
      if ~bName or ~sName then cycle.
      if records(lbQ) <> 9 and records(lbQ) <> 11 and records(lbQ) <> 13 then cycle. ! EXACTLY the clipping read, alone: <b>.setValue(
      get(lbQ, records(lbQ)) ; if lbQ.tx <> ')' then cycle.                          !   <s>.getLine(<v>), st:clip) in its 9, 11 or 13
      get(lbQ, records(lbQ) - 1) ; if lbQ.tx <> 'ST:CLIP' then cycle.                !   rows - nothing in front of it, nothing
      get(lbQ, records(lbQ) - 2) ; if lbQ.tx <> ',' then cycle.                      !   after, and v the whole index
      get(lbQ, records(lbQ) - 3) ; if lbQ.tx <> ')' then cycle.
      get(lbQ, records(lbQ) - 4) ; if lbQ.tx <> vName then cycle.
      get(lbQ, records(lbQ) - 5) ; if lbQ.tx <> '(' then cycle.
      if gRow <> 1 and gRow <> 3 then cycle.
      get(lbQ, 2) ; if gRow = 3 and lbQ.tx <> '.' then cycle.
      get(lbQ, gRow + 1) ; if lbQ.tx <> '(' then cycle.
      if lbHeadIx <> gRow + 2 and lbHeadIx <> gRow + 4 then cycle.
      if lbHeadIx <> records(lbQ) - 6 then cycle.
    end
    lbFrom = lbNext ; do LbFill                                                      ! the IF line
    ! ---- if <b>._DataEnd then break.
    get(lbQ, 1) ; if lbQ.tx <> 'IF' then cycle.
    lbWant = 'BREAK'    ; do LbFind ; if ~lbFound then cycle.
    lbWant = '~'        ; do LbFind ; if lbFound then cycle.                         ! `if ~b._DataEnd then break.`
    lbWant = 'NOT'      ; do LbFind ; if lbFound then cycle.                         !   is the OPPOSITE loop - it walks
                                                                                     !   back over NON-blank records. Both
                                                                                     !   spellings of the negation refuse.
    lbWant = '_DATAEND' ; do LbFind ; if ~lbFound then cycle.
    lbHeadIx = lbFound  ; do LbHead ; if lbHead <> bName then cycle.
    if records(lbQ) <> 5 or lbFound <> 2 then cycle.                                 ! EXACTLY `if <b>._DataEnd then break.` - a test
    get(lbQ, 3) ; if lbQ.tx <> 'THEN' then cycle.                                    !   such as `<b>._DataEnd = 0` walks the OTHER way
    get(lbQ, 4) ; if lbQ.tx <> 'BREAK' then cycle.
    get(lbQ, 5) ; if lbQ.tx <> '.' then cycle.
    ! ---- <v> -= 1
    lbFrom = lbNext ; do LbFill
    if records(lbQ) <> 3 then cycle.
    get(lbQ, 1) ; if lbQ.tx <> vName then cycle.
    get(lbQ, 2) ; if lbQ.tx <> '-='  then cycle.
    get(lbQ, 3) ; if lbQ.tx <> '1'   then cycle.
    ! ---- END
    lbFrom = lbNext ; do LbFill
    if records(lbQ) <> 1 then cycle.
    get(lbQ, 1) ; if lbQ.tx <> 'END' then cycle.
    endTok = lbFrom
    do LbScope                                                                    ! the scope FIRST: LbPrevLine stops at its start
    do LbPrevLine                                                                 ! the line ABOVE the loop must be
    if ~cntTok then cycle.                                                        !   <v> = <s>.records() - it is part
    lbFrom = cntTok ; do LbFill                                                   !   of the idiom, not a bystander, and
    lbWant = 'RECORDS' ; do LbFind                                                !   G4 must not trip over it
    if ~lbFound then cycle.
    lbHeadIx = lbFound ; do LbHead
    if lbHead <> sName then cycle.
    get(lbQ, 1) ; if lbQ.tx <> vName then cycle.
    get(lbQ, 2) ; if lbQ.tx <> '=' then cycle.                                    ! EXACTLY `<v> = <s>.records()` - the count is
    if lbFound <> 3 and lbFound <> 5 then cycle.                                  !   kept by the rewrite, so `- 1` after it
    if records(lbQ) <> lbFound + 2 then cycle.                                    !   would come out one lower
    get(lbQ, lbFound + 1) ; if lbQ.tx <> '(' then cycle.
    get(lbQ, lbFound + 2) ; if lbQ.tx <> ')' then cycle.
    !------------------------------------------------------------------------------------------
    ! THE SHAPE IS RIGHT. Now the guards - each one a reason a conversion would be WRONG rather
    ! than merely unproven. G6 (inverted test) and G7 (step not one) are already refused above by
    ! the shape tests, which is why only five appear here.
    !------------------------------------------------------------------------------------------
    why = ''
    if ~scFirst then why = 'the procedure it sits in cannot be identified'.
    if ~why and self.syms.ScopeContaining(loopTok, vs:scRoutine, vs:scRoutine)    ! the walks after the loop stop at the procedure's end,
      why = 'the loop is in a routine, and the code that runs after its DO, which may read the lines, is not walked here'
    end                                                                           !   so the code after a DO above them is never seen
    if ~why then do G0Own.
    if ~why then do G1Separator.
    ! the separator as the author wrote it must be a string literal, or the loop's answer cannot be known here
    if ~why and ~self.LbSepAt(lbSepTok)
      why = 'the split''s separator is not a string literal this pass can read - a code in angle brackets must be written in decimal - so what the loop skips cannot be known here'
    end
    if ~why and self.lbSepN > 1 and (instring(' ', clip(self.lbSepTxt), 1, 1) or pLog.findChars('32', 1,, self.lbSepTxt))
      why = 'the separator ' & clip(self.lbSepTxt) & ' holds a space, which the clip that strips the blank records would eat'
    end
    if ~why and gQrm
      why = 'the split removes quotes, so a quoted blank field is blank to the loop but not to the clip'
    end
    if ~why and gQuo
      why = 'the split has a quote argument, and a quote left open keeps the separators at the end inside the last' & |
            ' record, which the loop keeps and the clip in front of the split would cut'
    end
    if ~why and lbFree and ~lbClipLn and ~lbSplitHas                                     ! neither the read nor the split clips: the loop
      why = 'its read does not clip and neither does the split, so the loop skips only' & |   !   skips EMPTY records only, and the clip of
            ' EMPTY records, and a clip of spaces and line feeds would take records of' & |   !   spaces and line feeds would take more
            ' spaces too'
    end
    if ~why then do G4Between.
    if ~why then do G4Dom.
    if ~why and ~self.LbValueReadOK(sName, endTok, scLast) then why = self.lbWhy.        ! G2, a method: a value read after the loop
    if ~why then do LbLoopTop.                                                           ! an outer loop runs its lines above this one again
    if ~why and gTop and gTop < splitTok then do G2Above.                                !   G2 on those lines, above the split
    if ~why and ~lbFree then do G3BufferRead.                                            ! scratch-free: the buffer IS the object - G2 covers it
    if ~why then do G5Unclipped.
    if why
      if self.curPass = 1                                                                ! the site re-refuses every pass - log once
        pLog.append('BUILTIN LoopBlankRecords line ' & self.LogLineOf(loopTok) &         |
                    ': REFUSED - ' & clip(why) & '.<13,10>')
      end
      cycle
    end
    !------------------------------------------------------------------------------------------
    ! A CONVERTIBLE SITE. It is REMEMBERED, not converted here, and the walk carries on.
    !
    ! Converting on the spot and returning would end pass 1 at the FIRST site, so every refusal
    ! below it would go unreported - and the refusals are the point of this pass. Finishing the
    ! walk first means one pass logs the whole picture and converts one site; the fixpoint
    ! brings the next site round. Two sites in a procedure converge in two passes.
    !------------------------------------------------------------------------------------------
    if ~lbHitTok
      lbHitTok   = loopTok
      lbHitSplit = lbSplitHd
      lbHitEnd   = endTok
      lbHitLine  = self.LogLineOf(loopTok)                                               ! before the splices move it
      lbHitSep   = lbSepTok
      lbHitKind  = lbSplitAl
    end
  end
  !--------------------------------------------------------------------------------------------
  ! THE EDIT. Both splices RENUMBER the token queue, so every position held above - and every
  ! position the symbol table holds - is stale afterwards. That is why it happens here, once,
  ! after the walk has finished reading.
  !
  ! THE DELETE GOES FIRST, inside LbEmitAt, because it sits ABOVE the insert: taking the loop
  ! out does not move the split, but inserting a line at the split would move the loop.
  !--------------------------------------------------------------------------------------------
  if lbHitTok
    if lbHitKind = 2 then do LbReline ; return 1.
    lbFrom = lbHitEnd ; do LbFill                                                        ! lbNext is the first token PAST the END's own
    self.LbEmitAt(lbHitSplit, lbHitSep, lbHitTok, lbNext, lbHitLine, pLog)               !   line; the edit itself is a method
    if not self.syms &= NULL then self.syms.dirty = 1.
    return 1
  end
  ! Nothing convertible left: every site either refused, or was rewritten by an earlier pass and
  ! is no longer the shape this looks for.
  return 0

! ---- the remembered site's split shares its line with plain statements joined by ';' (G1): each
!      goes on a line of its own now, and the next pass, which finds the split alone on its line,
!      rewrites the loop. Every guard has already passed, and moving the statements changes none
!      of their answers: nothing after the split on its line names the object.
LbReline routine
  self.RelineSplitLine(lbHitSplit)
  if not self.syms &= NULL then self.syms.dirty = 1.
  pLog.append('BUILTIN LoopBlankRecords line ' & lbHitLine & ': the split this loop reads shares its line with' &      |
              ' other statements, so each is put on a line of its own first - the loop goes on the next pass.<13,10>')

! ---- the tokens of ONE physical line, uppercased, into lbQ; lbNext = first token of the next
LbFill routine
  free(lbQ)
  lbNext = 0
  loop lbX = lbFrom to records(self.tk.tokens)
    get(self.tk.tokens, lbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      lbNext = lbX + 1 ; break
    end
    if lbX > lbFrom and self.tk.tokens.firstOnLine
      lbNext = lbX ; break
    end
    lbQ.tx = upper(self.tk.tokens.tok)
    lbQ.tk = lbX
    add(lbQ)
  end
  if ~lbNext then lbNext = records(self.tk.tokens) + 1.

! ---- lbFound = the lbQ row whose DOT-TAIL is lbWant, or 0. A merged `LA.SETVALUE` and a split
!      `LA . SETVALUE` both answer here, which is the point.
LbFind routine
  lbFound = 0
  loop lbY = 1 to records(lbQ)
    get(lbQ, lbY)
    if errorcode() then break.
    lbN = len(clip(lbQ.tx))
    if ~lbN then cycle.
    lbD = instring('.', lbQ.tx[1 : lbN], 1, 1)
    if lbD and lbD < lbN
      if lbQ.tx[lbD + 1 : lbN] = lbWant then lbFound = lbY ; break.
    else
      if lbQ.tx = lbWant then lbFound = lbY ; break.
    end
  end

! ---- lbHead = the RECEIVER in front of the token at lbHeadIx: the part before its own dot when
!      the name was merged, or the token two back when the tokenizer split it as `A . GETLINE`.
LbHead routine
  lbHead = ''
  get(lbQ, lbHeadIx)
  if errorcode() then exit.
  lbN = len(clip(lbQ.tx))
  if ~lbN then exit.
  lbD = instring('.', lbQ.tx[1 : lbN], 1, 1)
  if lbD > 1
    lbHead = lbQ.tx[1 : lbD - 1]
    exit
  end
  if lbHeadIx < 3 then exit.
  get(lbQ, lbHeadIx - 1)
  if errorcode() or lbQ.tx <> '.' then exit.
  get(lbQ, lbHeadIx - 2)
  if ~errorcode() then lbHead = lbQ.tx.

! ---- cntTok = the first token of the physical line ABOVE the loop, 0 if there is none in
!      this scope. The count line is PART of the idiom, so the between-guard must stop at it.
LbPrevLine routine
  cntTok = 0
  loop lbX = loopTok - 1 to scFirst by -1
    if lbX < 1 then break.
    get(self.tk.tokens, lbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then cycle.
    if self.tk.tokens.firstOnLine then cntTok = lbX ; break.
  end

! ---- the procedure or method this loop sits in
LbScope routine
  scFirst = 0 ; scLast = 0 ; scCode = 0
  sc = self.syms.ScopeContaining(loopTok, vs:scProc, vs:scMethod)
  if ~sc then exit.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  scFirst = self.syms.scopes.startTok
  scLast  = self.syms.scopes.endTok
  gDep = 0
  loop lbOwn = scFirst to records(self.tk.tokens)
    get(self.tk.tokens, lbOwn)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      gDep += 1
    elsif self.tk.tokens.tok = ')'
      gDep -= 1
      if ~gDep then scCode = lbOwn ; break.
    elsif ~gDep and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      scCode = lbOwn ; break
    end
  end
  if ~scCode then scCode = scFirst.

! ---- G0: THE OBJECT MUST BE THIS PROCEDURE'S OWN - declared here (or, in a PROGRAM's main CODE,
!      program-level and mentioned nowhere else), not a parameter, a reference, or STATIC or THREAD.
!      The rewrite clips the object's VALUE and leaves its trailing blank records out, and both stay
!      in it: the caller of a parameter, every procedure that sees a global, every method of a class
!      and the next call of a STATIC read them where the walks here never look (ruled 18 Oct 2026).
!      So does a method of a class the procedure declares: it shares the procedure's data, and its
!      body follows the procedure, past the end of every walk. So do a reference taken on the object
!      and a call that may keep one - a second name the walks cannot follow - and the object's
!      Stream(), whose file receives the values the rewrite gives it.
!      So may code the procedure INCLUDEs. And it must be a StringTheory: the shape is read by its
!      method names alone, and the clip written in front of the split is StringTheory's. The line
!      buffer of the scratch spelling is asked the same questions (G0Buf).
G0Own routine
  lbOwn = self.syms.FindOwn(sName, sc)
  if ~lbOwn
    why = clip(sName) & ' is not declared in this procedure, so what reads its value and records afterwards cannot be told from here'
    exit
  end
  get(self.syms.syms, lbOwn)
  if errorcode() then why = 'the declaration of ' & clip(sName) & ' could not be read' ; exit.
  if self.syms.syms.declTok > scFirst and self.syms.syms.declTok <= scCode
    why = clip(sName) & ' is a PARAMETER, and its value and records are the caller''s to read as they were'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then why = clip(sName) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then why = clip(sName) & ' is a reference - what it points at is not this procedure''s' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    why = clip(sName) & ' is STATIC or THREAD - its value lasts to the next call, which would see it clipped'
  end
  if ~why and self.MayHaveLocalMethods(sc) and self.UsedInLocalMethods(upper(sName), scFirst, scLast)
    why = clip(sName) & ' is used in a method of a class this procedure declares, which can read its value and records after the walks here end'
  end
  if ~why and self.ScopeIncludes(sc)
    why = clip(sName) & '''s value and records may be read by code the procedure INCLUDEs, which this file does not hold'
  end
  if ~why then why = self.ObjReach(upper(sName), loopTok, 3).
  if ~why and ~lbFree then do G0Buf.

! ---- G0, the line buffer of the scratch spelling: the loop leaves in it the last line it looked
!      at, and the rewrite never loads it, so nothing the walks here do not read may read it after.
!      It must be this procedure's own StringTheory, as the object must - declared here, not a
!      parameter, whose caller reads it, not a reference, and not STATIC or THREAD, whose value
!      lasts to the next call - and reached under no other name: a reference taken on it anywhere
!      in the procedure, or a call that may keep one, reads the line the loop put there without
!      naming it, and its Stream() file receives each line the loop loads.
G0Buf routine
  lbOwn = self.syms.FindOwn(bName, sc)
  if ~lbOwn
    why = clip(bName) & ' is not declared in this procedure, so what reads the line the loop leaves in it cannot be told from here'
    exit
  end
  get(self.syms.syms, lbOwn)
  if errorcode() then why = 'the declaration of ' & clip(bName) & ' could not be read' ; exit.
  if self.syms.syms.declTok > scFirst and self.syms.syms.declTok <= scCode
    why = clip(bName) & ' is a PARAMETER, and the caller reads the line the loop leaves in it'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then why = clip(bName) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then why = clip(bName) & ' is a reference - what it points at is not this procedure''s' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    why = clip(bName) & ' is STATIC or THREAD - the line the loop leaves in it lasts to the next call'
    exit
  end
  why = self.ObjReach(upper(bName), loopTok, 3)

! ---- G1: THE RECORDS MUST HAVE COME FROM A SPLIT ON A LINE FEED ---------------------------
!      Rewriting to split('<10>') re-splits on something else entirely when they did not, and
!      clip('<32,10>') then trims the wrong characters. Unknown provenance REFUSES: a split we
!      cannot see is a split we cannot vouch for. The split's own call is read wherever it stands
!      on its line (SplitLineKind): its arguments by depth, over a '|' if they run on; a split
!      that is the whole of its line is judged, and one that shares it with plain statements
!      joined by ';' is judged the same way and, when it would convert, put on a line of its own
!      first. A split behind a one-line IF, THEN, ELSE or OF - which may not run - or after a
!      label is refused.
G1Separator routine
  splitTok = 0 ; lbSplitHas = 0 ; lbSepTok = 0 ; gQrm = 0 ; gQuo = 0 ; lbSplitAl = 0 ; lbSplitHd = 0
  gFrom = scFirst
  loop while gFrom > 0 and gFrom < loopTok
    lbFrom = gFrom ; do LbFill
    loop gRow = 1 to records(lbQ)
      get(lbQ, gRow)
      lbN = len(clip(lbQ.tx))
      if ~lbN then cycle.
      lbD = instring('.', lbQ.tx[1 : lbN], 1, 1)
      if lbD and lbD < lbN
        if lbQ.tx[lbD + 1 : lbN] <> 'SPLIT' then cycle.
      elsif lbQ.tx <> 'SPLIT'
        cycle
      end
      gHit = lbQ.tk
      lbHeadIx = gRow ; do LbHead
      if lbHead <> sName then cycle.
      splitTok = gFrom
      gArg = gHit
    end
    gFrom = lbNext
  end
  if ~splitTok
    why = 'no split on ' & clip(sName) & ' can be seen in this procedure, so where the records' & |
          ' came from is unknown'
    exit
  end
  lbSplitAl = self.SplitLineKind(gArg, sName)
  if ~lbSplitAl then why = self.slWhy ; exit.
  lbSplitHd = self.slStmt
  lbSepTok = self.scSepTok
  lbSplitHas = self.scClip
  gQrm = self.scQrm
  gQuo = self.scQuo

! ---- G4: NOTHING MAY TOUCH THE STRING BETWEEN THE SPLIT AND THE LOOP -----------------------
!      The rewrite re-splits it, so anything done in between lands on a different string, or
!      happens twice. Deliberately blunt - ANY mention refuses. A precise version needs a
!      write-versus-read classifier and is not worth it for the handful of sites this costs.
G4Between routine
  gFrom = splitTok
  lbFrom = gFrom ; do LbFill
  gFrom = lbNext
  loop while gFrom > 0 and gFrom < cntTok
    lbFrom = gFrom ; do LbFill
    loop gHit = 1 to records(lbQ)
      lbHeadIx = gHit ; do LbHead
      ! LbHead leaves the buffer on an earlier row: read this one back
      get(lbQ, gHit)
      if lbHead = sName or lbQ.tx = sName
        why = clip(sName) & ' is touched between the split and the loop, and the rewrite' & |
              ' re-splits it'
        break
      end
      if lbQ.tx = 'DO'
        why = 'a routine is called on line ' & self.LogLineOf(gFrom) & ', between the split of ' & clip(sName) & |
              ' and the loop, and what it does to ' & clip(sName) & ' is not read here'
        break
      end
    end
    if why then break.
    gFrom = lbNext
  end

! ---- G4, the path: the split must run on every way to the count line - no structure that holds it ends
!      before the count, no other branch of it begins. A split in one branch of an IF leaves the others
!      unclipped, and the loop served them all.
!      Nor may the split or the loop be one arm of an EXECUTE. Its arms carry no mark between them, so
!      the walk below cannot see that a split one arm above the count did not run when the count did;
!      and the edit takes the loop out and puts the clip in front of the split, which would make every
!      later arm answer to a different value.
G4Dom routine
  gHit = self.ArmOfExecute(splitTok)
  if gHit
    why = 'the split of ' & clip(sName) & ' is one arm of the EXECUTE on line ' & self.LogLineOf(gHit) & |
          ', so it does not run with the loop, and the clip put in front of it would be another arm'
    exit
  end
  gHit = self.ArmOfExecute(loopTok)
  if gHit
    why = 'the loop is one arm of the EXECUTE on line ' & self.LogLineOf(gHit) &       |
          ', and taking it out would make every later arm answer to a different value'
    exit
  end
  gDep = 0
  lbFrom = splitTok ; do LbFill
  loop gHit = lbNext to cntTok - 1
    get(self.tk.tokens, gHit)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      gDep += 1
    elsif self.tk.tokens.level = '-'
      gDep -= 1
    elsif self.tk.tokens.level = '/' and gDep <= 0
      gDep = -1
    end
    if gDep < 0 or self.syms.IsColOneLabel(gHit)
      why = 'the split of ' & clip(sName) & ' on line ' & self.LogLineOf(splitTok) & ' is not on every path to the loop, and the clip would serve that split alone'
      break
    end
  end

! ---- an outer loop: gTop = the first token of the line of the outermost LOOP or ACCEPT around
!      the walk-back loop, 0 = none. That loop runs its lines above the walk-back loop again after
!      it, on its next turn, so G2, G3 and G5 walk those lines as well as the ones after the END.
!      A GOTO below the split that jumps back to a label at or above it does the same from that
!      label (GotoBackTop), so the earlier of the two is the top.
LbLoopTop routine
  gTop = 0 ; gLvl = 0
  loop gHit = loopTok - 1 to scFirst by -1
    if gHit < 1 then break.
    get(self.tk.tokens, gHit)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      gLvl += 1
    of '+'
      if gLvl
        gLvl -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        gTop = gHit
      end
    end
  end
  gHit = self.GotoBackTop(splitTok, scFirst, scLast)
  if gHit and (~gTop or gHit < gTop) then gTop = gHit.
  if ~gTop then exit.
  loop gHit = gTop to scFirst by -1
    get(self.tk.tokens, gHit)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then gTop = gHit ; break.
  end

! ---- G2: THE STRING'S VALUE MUST NOT BE READ AFTERWARDS, UNLESS A WRITE COMES FIRST ---------
!      Lives in the method LbValueReadOK (see its note); called from the guard sequence above.
!      G2Above asks it about the outer loop's lines above the split, which run again after the
!      walk-back loop. That walk starts at the line feed in front of the loop's own line, so the
!      loop's line is read too: `loop while a.records() > 1` counts the records on every turn.
G2Above routine
  if ~self.LbValueReadOK(sName, gTop - 1, lbSplitHd - 1)
    why = 'in the loop around the split, ' & self.lbWhy
  end

! ---- G3: THE LINE BUFFER MUST NOT BE READ AFTERWARDS ---------------------------------------
!      The loop leaves it holding the last line it looked at. The rewrite never writes it, so it
!      keeps whatever it had before. A read of it after the loop is safe only when a WRITE of it
!      (setValue) is certain to have run first: one earlier in the same block or in a block
!      enclosing the read, kept by depth as G2 keeps it - a write inside an IF does not cover a
!      read after the IF's END, and an ELSE or a ROUTINE header puts a write out of force. A write
!      runs once its own arguments are read, so `b.setValue(b.getValue() & x)` reads b first. The
!      buffer named BARE - handed whole to a call, or a reference pointed at it - is a read of it;
!      the head of a split call `b . method` is judged at its method. The lines of an outer loop
!      above the walk-back loop run again after it, and are walked the same way from the outer
!      loop's own line. A method of a class the procedure declares may read the buffer too, after
!      the walks end. A write that is one arm of an EXECUTE covers nothing - the arms are
!      alternatives - and a column-1 label puts every write out of force: a GOTO may arrive there
!      without it.
G3BufferRead routine
  if self.MayHaveLocalMethods(sc) and self.UsedInLocalMethods(upper(bName), scFirst, scLast)
    why = clip(bName) & ' is used in a method of a class this procedure declares, which can read it after the loop'
    exit
  end
  if gTop
    gPre = 1 ; gFrom = gTop ; gStop = loopTok - 1
    do G3Walk
    if why then exit.
  end
  gPre = 0
  lbFrom = endTok ; do LbFill
  gFrom = lbNext ; gStop = scLast
  do G3Walk

! ---- G3's walk: token by token from gFrom to gStop, the depth kept from the level marks
G3Walk routine
  gDep = 0 ; gDom = 9999 ; gArgEnd = 0
  loop gHit = gFrom to gStop
    get(self.tk.tokens, gHit)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if gArgEnd and gHit > gArgEnd
      if gDep < gDom then gDom = gDep.
      gArgEnd = 0
    end
    case self.tk.tokens.level
    of '+' ; gDep += 1
    of '-' ; gDep -= 1 ; if gDep < gDom then gDom = 9999.
    of '/' ; if gDom >= gDep then gDom = 9999.
    end
    gTail = upper(self.tk.tokens.tok)
    lbN = len(clip(gTail))
    if ~lbN then cycle.
    if self.tk.tokens.firstOnLine and upper(self.tk.GetTok(gHit + 1)) = 'ROUTINE'
      gDep = 0 ; gDom = 9999
      cycle
    end
    if self.syms.IsColOneLabel(gHit) then gDom = 9999.
    lbD = instring('.', gTail[1 : lbN], 1, 1)
    if lbD > 1 and lbD < lbN
      if gTail[1 : lbD - 1] <> bName then cycle.
      gTail = gTail[lbD + 1 : lbN]
    elsif ~lbD and gTail = bName
      gTail = ''
      if self.tk.GetTok(gHit + 1) = '.' then gTail = upper(self.tk.GetTok(gHit + 2)).
    else
      cycle
    end
    if gTail = 'SETVALUE'
      if self.ArmOfExecute(gHit) then cycle.
      do G3ArgEnd
      cycle
    end
    if gDom <= gDep then cycle.
    do G3Why
    break
  end

! ---- gArgEnd = the ')' that closes the call named at gHit, or gHit itself when no bracket follows
G3ArgEnd routine
  gArgEnd = gHit
  lbD = choose(self.tk.GetTok(gHit + 1) = '.', gHit + 3, gHit + 1)
  if self.tk.GetTok(lbD) <> '(' then exit.
  gLvl = 0
  loop lbN = lbD to gStop
    get(self.tk.tokens, lbN)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if self.tk.tokens.tok = '(' then gLvl += 1.
    if self.tk.tokens.tok = ')' then gLvl -= 1.
    if ~gLvl then gArgEnd = lbN ; break.
  end

! ---- G3's reason: gTail blank is the buffer named bare
G3Why routine
  if gTail
    why = clip(bName) & ' is read'
  else
    why = clip(bName) & ' is used whole'
  end
  if gPre
    why = clip(why) & ' in the loop around this one, above it,'
  else
    why = clip(why) & ' after the loop'
  end
  why = clip(why) & ' before anything writes it, and the loop is what put its value there'

! ---- G5: EVERY LATER READ OF A LINE MUST ALREADY CLIP --------------------------------------
!      The rewrite clips spaces and the separator off the END of the value before the split, so
!      the last line left comes back without its trailing spaces; and ClipAtSplit, on a later
!      pass, may give that split st:clip, which clips EVERY line. A later getLine that does not
!      clip would see different text. THIS IS THE DEPENDENCY ON THE STEP 1 and the easiest of
!      the seven to miss. A clip line that is the next arm of an
!      EXECUTE does not clip the read one arm above it: those two never run together. The lines
!      of an outer loop above the split run again after the walk-back loop, so they are walked
!      first, the same way. EVERY getLine of the object on a line is judged, each by the read it
!      sits in (G5Read): a st:clip elsewhere on the line is not its clip.
G5Unclipped routine
  if gTop and gTop < splitTok
    gFrom = gTop ; gStop = lbSplitHd - 1
    do G5Walk
    if why then exit.
  end
  gFrom = endTok
  lbFrom = gFrom ; do LbFill
  gFrom = lbNext ; gStop = scLast
  do G5Walk

! ---- G5's walk: the lines that start from gFrom to gStop
G5Walk routine
  loop while gFrom > 0 and gFrom <= gStop
    lbFrom = gFrom ; do LbFill
    gNext = lbNext
    loop gRow = 1 to records(lbQ)
      do G5Read
      if why then break.
    end
    if why then break.
    lbWant = 'SETVALUEFROMLINE' ; do LbFind                        ! the scratch-free read: clipped by the line
    if lbFound                                                     !   after it, or by the split itself
      lbHeadIx = lbFound ; do LbHead
      if lbHead = sName and ~lbSplitHas
        do G5After
        if why then break.
        if ~self.LbClipLineAt(gNext, sName)
          why = 'a later setValueFromLine on ' & clip(sName) & ' has no clip after it, and the' & |
                ' rewrite would make every line come back clipped'
          break
        end
        gNext = self.lbClipNext                                    ! past the clip line
        gHit = self.ArmOfExecute(gNext)
        if gHit
          why = 'the clip after a later setValueFromLine on ' & clip(sName) & ' is another arm of' & |
                ' the EXECUTE on line ' & self.LogLineOf(gHit) & ', so that line is read unclipped'
          break
        end
      end
    end
    gFrom = gNext
  end

! ---- G5, row gRow of the line in lbQ: a getLine of the object there must be the whole first
!      argument of a setValue, append or prepend whose second and last argument is st:clip -
!      `<x>.setValue(<s>.getLine(<n>), st:clip)`, x a StringTheory (G5Reader). A st:clip anywhere
!      else on the line clips something else: the end of a longer value, or another statement's.
G5Read routine
  get(lbQ, gRow)
  if errorcode() then exit.
  lbN = len(clip(lbQ.tx))
  if ~lbN then exit.
  lbD = instring('.', lbQ.tx[1 : lbN], 1, 1)
  if lbD and lbD < lbN
    if lbQ.tx[lbD + 1 : lbN] <> 'GETLINE' then exit.
    gArg = gRow
  elsif lbQ.tx = 'GETLINE'
    gArg = gRow - 2
  else
    exit
  end
  lbHeadIx = gRow ; do LbHead
  if lbHead <> sName then exit.
  get(lbQ, gArg - 1)
  if errorcode() or lbQ.tx <> '(' then do G5Why ; exit.
  get(lbQ, gArg - 2)
  if errorcode() then do G5Why ; exit.
  lbN = len(clip(lbQ.tx))
  if ~lbN then do G5Why ; exit.
  lbD = instring('.', lbQ.tx[1 : lbN], 1, 1)
  if lbD and lbD < lbN
    gTail = lbQ.tx[lbD + 1 : lbN]
  else
    gTail = lbQ.tx
    get(lbQ, gArg - 3)
    if errorcode() or lbQ.tx <> '.' then do G5Why ; exit.
  end
  case gTail
  of 'SETVALUE' orof 'APPEND' orof 'PREPEND'
  else
    do G5Why ; exit
  end
  get(lbQ, gRow + 1)
  if errorcode() or lbQ.tx <> '(' then do G5Why ; exit.
  gLvl = 0
  loop gHit = gRow + 1 to records(lbQ)
    get(lbQ, gHit)
    if lbQ.tx = '(' then gLvl += 1.
    if lbQ.tx = ')' then gLvl -= 1.
    if ~gLvl then break.
  end
  if gLvl then do G5Why ; exit.
  get(lbQ, gHit + 1)
  if errorcode() or lbQ.tx <> ',' then do G5Why ; exit.
  get(lbQ, gHit + 2)
  if errorcode() or lbQ.tx <> 'ST:CLIP' then do G5Why ; exit.
  get(lbQ, gHit + 3)
  if errorcode() or lbQ.tx <> ')' then do G5Why ; exit.
  do G5Reader

! ---- G5's reason for a getLine of the object that is not clipped as it is read
G5Why routine
  why = 'a later getLine on ' & clip(sName) & ' is not itself clipped as it is read, and the rewrite' & |
        ' would make every line come back clipped'

! ---- G5, the read in hand clips as it loads, so the object it loads, x, must be a StringTheory: its
!      setValue, append and prepend clip when they are given st:clip. On a class of the author's own a
!      method of that name may not clip at all, and the rewrite would then hand it a line clipped
!      already. One that does not resolve to a StringTheory (HayType), or that the symbol table cannot
!      place, refuses
G5Reader routine
  lbHeadIx = gArg - 2 ; do LbHead
  get(lbQ, gArg)
  if errorcode() then exit.
  if self.HayType(lbHead, lbQ.tk) = 'STRINGTHEORY' then exit.
  why = 'a later getLine on ' & clip(sName) & ' is loaded into ' & clip(lbHead) & ', which is not known' & |
        ' here to be a StringTheory, so whether that load clips cannot be told'

! ---- G5, a scratch-free read `<s>.setValueFromLine(<n>)` at row lbFound of the line in lbQ, on a split
!      that does not clip: nothing after it on its line may use the object, which would see the line
!      before the clip on the next line runs
G5After routine
  get(lbQ, lbFound + 1)
  if errorcode() or lbQ.tx <> '(' then exit.
  gLvl = 0
  loop gRow = lbFound + 1 to records(lbQ)
    get(lbQ, gRow)
    if lbQ.tx = '(' then gLvl += 1.
    if lbQ.tx = ')' then gLvl -= 1.
    if ~gLvl then break.
  end
  loop gHit = gRow + 1 to records(lbQ)
    lbHeadIx = gHit ; do LbHead
    get(lbQ, gHit)
    if lbHead <> sName and lbQ.tx <> sName then cycle.
    why = 'a later setValueFromLine on ' & clip(sName) & ' is followed on its line by another use of it,' & |
          ' which reads the line before the clip on the next line runs'
    break
  end

! ------------------------------------------------------------------------------------
! LoopBlankRecords' shape walk and its G5: is the physical line starting at pFrom exactly
! `<pNameU>.clip()`? 1 = yes, and lbClipNext is the first token past that line. A method, so
! that G5 and the shape walk ask the same question of the same code.
! ------------------------------------------------------------------------------------
VitEngine.LbClipLineAt Procedure(LONG pFrom, STRING pNameU)
x     long,auto
n     long
d     long,auto
L     long,auto
t1    STRING(96)
t2    STRING(96)
t3    STRING(96)
t4    STRING(96)
t5    STRING(96)
  code
  self.lbClipNext = records(self.tk.tokens) + 1
  loop x = pFrom to records(self.tk.tokens)
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      self.lbClipNext = x + 1 ; break
    end
    if x > pFrom and self.tk.tokens.firstOnLine
      self.lbClipNext = x ; break
    end
    n += 1
    if n > 5 then return 0.
    case n
    of 1 ; t1 = upper(self.tk.tokens.tok)
    of 2 ; t2 = upper(self.tk.tokens.tok)
    of 3 ; t3 = upper(self.tk.tokens.tok)
    of 4 ; t4 = upper(self.tk.tokens.tok)
    of 5 ; t5 = upper(self.tk.tokens.tok)
    end
  end
  if n = 3            ! NAME.CLIP ( ) - the name merged
    L = len(clip(t1))
    d = instring('.', t1[1 : L], 1, 1)
    if d > 1 and d < L and t1[1 : d - 1] = pNameU and t1[d + 1 : L] = 'CLIP' and t2 = '(' and t3 = ')' then return 1.
    return 0
  end
  if n = 5 and t1 = pNameU and t2 = '.' and t3 = 'CLIP' and t4 = '(' and t5 = ')' then return 1. ! NAME . CLIP ( ) - split
  return 0

! ------------------------------------------------------------------------------------
! LoopBlankRecords' G2 (14 Sep 2026): the object's VALUE must not be read after the loop
! unless a write of it is certain to have run first. The rewrite leaves a different value
! behind - the scratch loop only read it and the rewrite clips it; the scratch-free loop left
! the last line looked at in it and the rewrite leaves the clipped whole. A getLine answers
! the same either way; a count or a whole read of the records (records, getLines, join and the
! like) does not, since the trailing blank ones are gone, and is safe only after a new split -
! which makes new lines only when a write of the value ran before it, since a split reads the
! value the rewrite clipped (18 Oct 2026). A change of the lines - addLine, setLine,
! setLineFromValue, deleteLine, removeLines, filter, swap, or an append or prepend given
! st:lines, or an option that may hold it (LinesOptAt) - is safe only after a new split too: it
! starts from lines that are fewer after the
! rewrite, so a line it adds or moves lands at another number, and a getLine after it reads
! another line. Refusing every such change that comes before a new split is what keeps a getLine
! the same either way. A write of the value (setValue) leaves the lines as they were. Any other
! touch is a read, safe only when
! a write (setValue, setValueFromLine) sits earlier in the same block or in a block enclosing
! the read: the walk keeps a depth from the tokens' level marks (+ opens, - closes, / is an
! ELSE) and the depth of the shallowest write still in force; a block closing below it, an
! ELSE, a ROUTINE header or a column-1 label - where a GOTO may arrive without it - puts the
! write out of force. A write inside an IF never covers a
! read after the IF's END. A write or a split that is one arm of an EXECUTE covers nothing: the
! arms are alternatives, so a read in another arm may run without it, and the depth walk has no
! mark between arms to tell it so. A bare mention of the name - the object handed whole to a call -
! may read both, and is safe only after a write and a new split (18 Oct 2026).
! A write or a split takes effect once its own arguments are read: Clarion reads the
! arguments before the call runs, so `a.setValue(a.getValue() & x)` reads the value the
! rewrite left before it writes a new one, and the walk judges those arguments first.
! Walks from the line after the one holding pEndTok to pTo: after the loop's END, or - when
! pEndTok is the line feed in front of an outer loop's line - over that loop's lines above
! the split. 1 = fine, 0 = refused with the reason in lbWhy.
! ------------------------------------------------------------------------------------
VitEngine.LbValueReadOK Procedure(STRING pNameU, LONG pEndTok, LONG pTo)
i        long,auto
depth    long,auto
dom      long,auto
domL     long,auto
started  byte,auto
first    byte,auto
d        long,auto
n        long,auto
argEnd   long
argKind  byte
argDep   long
lnWr     byte
tU       STRING(vs:maxName)
tail     STRING(vs:maxName)
  code
  depth = 0 ; dom = 9999 ; domL = 9999 ; started = 0
  loop i = pEndTok to pTo
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if argEnd and i > argEnd                                                  ! past a write's own arguments: it has run now
      if argKind = 1 and depth < dom then dom = depth.
      if argKind = 2 and dom <= depth and depth < domL then domL = depth.
      argEnd = 0
    end
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      started = 1                                                             ! past the END's own line
      cycle
    end
    if ~started then cycle.
    first = self.tk.tokens.firstOnLine
    case self.tk.tokens.level
    of '+' ; depth += 1
    of '-' ; depth -= 1 ; if depth < dom then dom = 9999. ; if depth < domL then domL = 9999.
    of '/' ; if dom >= depth then dom = 9999. ; if domL >= depth then domL = 9999.
    end
    tU = upper(self.tk.tokens.tok)
    n = len(clip(tU))
    if ~n then cycle.
    if first and upper(self.tk.GetTok(i + 1)) = 'ROUTINE'                     ! a routine runs when it is DOne, not here
      depth = 0 ; dom = 9999 ; domL = 9999
      cycle
    end
    if first and self.syms.IsColOneLabel(i) then dom = 9999 ; domL = 9999.
    d = instring('.', tU[1 : n], 1, 1)
    if d > 1 and d < n                                                        ! NAME.tail merged
      if tU[1 : d - 1] <> pNameU then cycle.
      tail = tU[d + 1 : n]
    elsif ~d and tU = pNameU                                                  ! NAME . tail split, or a bare mention
      if self.tk.GetTok(i + 1) = '.'
        tail = upper(self.tk.GetTok(i + 2))
      else                                                                    ! a bare mention: the object handed whole to a call,
        if dom <= depth and domL <= depth then cycle.                         !   which may read its value and its records alike
        self.lbWhy = clip(pNameU) & ' is handed whole to a call after the loop, before anything writes it and splits it' & |
                     ' again, and the rewrite leaves a different value and fewer records there'
        return 0
      end
    else
      cycle
    end
    if tail = 'GETLINE' then cycle.                                           ! one line: the same either way (past the end, '')
    if tail[1 : 5] = 'SPLIT' and self.ArmOfExecute(i) then cycle.
    if tail[1 : 5] = 'SPLIT'                                                  ! new lines - but split from the VALUE, which the rewrite
      argKind = 2 ; do LvArgEnd                                               !   clipped, so they are fresh only after a write of it
      cycle
    end
    if instring(' ' & clip(tail) & ' ', ' RECORDS GETLINES INLINE JOIN SORT LINES FREELINES ', 1, 1)
      if domL <= depth then cycle.                                            ! a split in this block or an enclosing one ran first
      self.lbWhy = clip(pNameU) & '.' & lower(clip(tail)) & ' after the loop reads its records, and the rewrite leaves out the trailing blank ones'
      return 0
    end
    lnWr = 0
    if instring(' ' & clip(tail) & ' ', ' ADDLINE INSERTLINE SETLINE SETLINEFROMVALUE DELETELINE REMOVELINES FILTER SWAP ', 1, 1) then lnWr = 1.
    if tail = 'APPEND' or tail = 'PREPEND' then do LvLinesArg.
    if lnWr                                                                   ! a change of the lines
      if domL <= depth then cycle.                                            ! fresh lines: a split in this block or an enclosing one ran first
      self.lbWhy = clip(pNameU) & '.' & lower(clip(tail)) & ' after the loop changes its lines, which the rewrite leaves without the trailing blank ones'
      if lnWr = 2 then self.lbWhy = clip(pNameU) & '.' & lower(clip(tail)) & ' after the loop is given an option that may hold st:lines, and so may change its lines, which the rewrite leaves without the trailing blank ones'.
      return 0
    end
    case tail
    of 'SETVALUE' orof 'SETVALUEFROMLINE'                                     ! a write of the value
      if self.ArmOfExecute(i) then cycle.
      argKind = 1 ; do LvArgEnd
      cycle
    end
    if dom <= depth then cycle.                                               ! a write in this block or an enclosing one ran first
    self.lbWhy = clip(pNameU) & ' is used as ' & clip(tail) & ' after the loop before anything' & |
                 ' writes it, and the rewrite leaves a different value there'
    return 0
  end
  return 1

! ---- argEnd = the ')' that closes the call named at token i, or i itself when no bracket follows
LvArgEnd routine
  argEnd = i
  d = choose(self.tk.GetTok(i + 1) = '.', i + 3, i + 1)
  if self.tk.GetTok(d) <> '(' then exit.
  argDep = 0
  loop n = d to pTo
    get(self.tk.tokens, n)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if self.tk.tokens.tok = '(' then argDep += 1.
    if self.tk.tokens.tok = ')' then argDep -= 1.
    if ~argDep then argEnd = n ; break.
  end

! ---- lnWr = 1 when the call named at token i is given st:lines, 2 when an option there may hold it
!      (LinesOptAt): an append or prepend given it adds the other object's lines to these
LvLinesArg routine
  d = choose(self.tk.GetTok(i + 1) = '.', i + 3, i + 1)
  lnWr = self.LinesOptAt(d)


! ------------------------------------------------------------------------------------
! LoopBlankRecords' G1: the split's separator as the author wrote it - pTok is its token, the
! split's first argument when that is one token (SplitOwnArgs' scSepTok). 1 = a string
! literal: lbSepTxt is the token text, lbSepN its length in bytes, lbSepByte that byte when
! there is only one (a line feed is 10; the clip form needs the number). The bytes are read with
! the whole literal grammar (LitBytes): '{{' is one brace, '-{2}' two dashes, '<<13,10>' two
! bytes. 0 = anything else - a variable, a st:* constant - and the loop's answer cannot be known
! here. A method, so the guard and the edit (LbEmitAt) read the literal through the same code.
! ------------------------------------------------------------------------------------
VitEngine.LbSepAt Procedure(LONG pTok)
t     StringTheory
dec   StringTheory
  code
  self.lbSepTxt = '' ; self.lbSepN = 0 ; self.lbSepByte = 0
  if pTok < 1 then return 0.
  get(self.tk.tokens, pTok)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  t.setValue(self.tk.tokens.tok,st:clip)
  if t._DataEnd < 3 or t.valuePtr[1] <> '''' or t.valuePtr[t._DataEnd] <> '''' then return 0.
  if t._DataEnd > size(self.lbSepTxt) then return 0.
  self.lbSepTxt = t.getValue()
  if ~self.LitBytes(t.getValue(), dec) then return 0.
  self.lbSepN = dec._DataEnd
  if self.lbSepN < 1 then return 0.
  if self.lbSepN = 1
    self.lbSepByte = val(dec.valuePtr[1])
    if self.lbSepByte < 1 then return 0.
  end
  return 1

! ------------------------------------------------------------------------------------
! LoopBlankRecords' edit, as a method so the walk above only ever reads: the loop from
! pLoopTok to the token before pPastTok goes, and in front of the split statement at pSplitTok
! - its receiver, the first token of its line - goes either the one-line clip - one-byte
! separator - or the strip loop (14 Sep 2026), at the split line's indent. pSepTok is the
! separator's token, read again here through LbSepAt so the members hold THIS site's
! separator. The receiver is spelled as the author spelled it, from the split's own head. A
! comment at the end of one of the loop's lines stays, on a line of its own where the loop was
! (DropLinesKeepCmts, ruled 14 Sep 2026). The loop's lines are matched one physical line at a
! time, so a loop wrapped over a '|' is not this shape and never reaches here.
! ------------------------------------------------------------------------------------
VitEngine.LbEmitAt Procedure(LONG pSplitTok, LONG pSepTok, LONG pLoopTok, LONG pPastTok, LONG pLogLine, StringTheory pLog)
txt    StringTheory
ind    StringTheory
recv   STRING(vs:maxName),AUTO
x      long,auto
y      long,auto
n      long,auto
d      long,auto
kept   long,auto
  code
  if ~self.LbSepAt(pSepTok) then return.
  get(self.tk.tokens, pSplitTok)
  if errorcode() then return.
  if not self.tk.tokens.strBefore &= NULL        ! the split line's own indent: what follows the
    y = 0                                        !   last line feed of its leading trivia
    loop x = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[x] = '<10>' then y = x.
    end
    if y < size(self.tk.tokens.strBefore) then ind.setValue(self.tk.tokens.strBefore[y + 1 : size(self.tk.tokens.strBefore)]).
  end
  recv = ''
  if not self.tk.tokens.tok &= NULL              ! the receiver AS THE AUTHOR SPELLED IT - a.split
    n = len(clip(self.tk.tokens.tok))            !   merged, or a bare a when the dot stands apart
    if n
      d = instring('.', self.tk.tokens.tok[1 : n], 1, 1)
      if d > 1
        recv = self.tk.tokens.tok[1 : d - 1]
      elsif ~d
        recv = self.tk.tokens.tok[1 : n]
      end
    end
  end
  if ~recv then return.
  txt.setValue(ind)
  if self.lbSepN = 1                                 ! ONE BYTE: <recv>.clip('<32,B>') - spaces and the
    txt.append(clip(recv) & '.clip(' & chr(39) & '<<32,' & self.lbSepByte & '>' & chr(39) & ')<13,10>') ! separator in any order
  else                                               ! LONGER: whole separators off the end, never
    txt.append('loop<13,10>')                        !   characters (looplim\LoopEq2.clw, 21 shapes)
    txt.append(ind) ; txt.append('  ' & clip(recv) & '.clip()<13,10>')
    txt.append(ind) ; txt.append('  if ' & clip(recv) & '._DataEnd << ' & self.lbSepN & ' or ~' & clip(recv) & '.endsWith(' & clip(self.lbSepTxt) & ') then break.<13,10>')
    txt.append(ind) ; txt.append('  ' & clip(recv) & '._DataEnd -= ' & self.lbSepN & '<13,10>')
    txt.append(ind) ; txt.append('end<13,10>')
  end
  self.TxaMarkLines(txt, self.TxaShiftOf(pSplitTok))
  ! the loop goes first: it sits below the split. Its comments come back where it was.
  kept = self.DropLinesKeepCmts(pLoopTok, pPastTok - 1)
  self.InsertLinesAbove(pSplitTok, txt)
  pLog.append('BUILTIN LoopBlankRecords line ' & pLogLine & ': the trailing-blank-record loop over ' & clip(recv) & ' passed' & |
              ' all seven guards - it is ' & choose(self.lbSepN = 1, 'a clip', 'a strip of the trailing separators')          & |
              ' and a re-split now' & choose(~kept, '', ' - its comments stay, on lines of their own') & '.<13,10>')

! ------------------------------------------------------------------------------------
! LoopBlankRecords, ClipAtSplit and TrimAtSplit: the arguments of the split call whose method
! name is the token pTail - `a.split` merged, or the `split` of `a . split` - read by DEPTH from
! the call's own '(' to the ')' that closes it. A '|' continuation is trivia, not a line end, so
! arguments wrapped onto the next line are read with the rest. scOpen and scClose are the two
! brackets, scArgN the number of arguments (0 for `()`), scSepTok the first argument's token
! when it is a single token, scQrm the fourth (pRemoveQuotes) given and not 0 or false, scClip
! st:clip as the fifth (pClip), scSpace a lone space - ' ' or '<<32>' - as any argument. 1 =
! read; 0 = no '(' after the name, or a line end before its ')'.
! ------------------------------------------------------------------------------------
VitEngine.SplitOwnArgs Procedure(LONG pTail)
x     long,auto
dp    long
arg   long,auto
cnt   long
seen  byte
tU    STRING(96),AUTO
  code
  self.scOpen = 0 ; self.scClose = 0 ; self.scArgN = 0 ; self.scSepTok = 0
  self.scQrm = 0 ; self.scClip = 0 ; self.scSpace = 0 ; self.scQuo = 0
  if self.tk.GetTok(pTail + 1) <> '(' then return 0.
  self.scOpen = pTail + 1
  arg = 1
  loop x = pTail + 1 to records(self.tk.tokens)
    if self.IsEolTok(x) then return 0.
    get(self.tk.tokens, x)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    tU = upper(self.tk.tokens.tok)
    if tU = '(' or tU = '[' or tU = '{{'
      dp += 1
      if dp = 1 then cycle.
    elsif tU = ')' or tU = ']' or tU = '}'
      dp -= 1
      if ~dp then break.
    elsif dp = 1 and tU = ','
      arg += 1 ; cnt = 0
      cycle
    end
    seen = 1
    cnt += 1
    if arg = 1
      if cnt = 1 then self.scSepTok = x else self.scSepTok = 0.
    end
    if dp > 1 then cycle.
    if tU = ''' ''' or tU = '''<<32>''' then self.scSpace = 1.
    if arg = 2 and tU <> '''''' and tU <> ''' ''' and tU <> '''<<32>''' then self.scQuo = 1.
    if arg = 4 and tU <> '0' and tU <> 'FALSE' then self.scQrm = 1.
    if arg = 5 and tU = 'ST:CLIP' then self.scClip = 1.
  end
  if dp then return 0.
  self.scClose = x
  if seen or arg > 1 then self.scArgN = arg.
  return 1

! ------------------------------------------------------------------------------------
! LoopBlankRecords, ClipAtSplit and TrimAtSplit: how the split call whose method name is the
! token pTail sits on its LOGICAL line - from the line end before it to the line end after its
! closing bracket, a '|' continuation and all. Those three put new code in front of the split
! statement and start their walks on the line after it, so the answer is
!   1  the split is the whole line: its receiver first, its ')' last - its arguments may run on
!      over a '|';
!   2  it shares the line only with plain statements joined by ';': no IF, THEN, ELSE, OF, END
!      or other structure word anywhere on the line, no line break beside a ';' that is not a
!      '|' continuation (folded OMIT text), no doubled ';', and pRecvU not named after the split.
!      Once every other check has passed, the caller puts each statement on a line of its own
!      (RelineSplitLine) and converts on the next pass, when the split is the whole line;
!   0  anything else, with the reason in slWhy. Behind a one-line IF, THEN, ELSE or OF the split
!      may not run, and the lines read after it may come from an earlier split.
! slStmt is the split statement's first token - its receiver, the token two back when the name
! arrives as `a . split` - and slLine the logical line's first token; scOpen, scClose and the
! argument facts are SplitOwnArgs'.
! ------------------------------------------------------------------------------------
VitEngine.SplitLineKind Procedure(LONG pTail, STRING pRecvU)
x      long,auto
dp     long
semis  long
pre    long
semiAt long
fin    long,auto
n      long,auto
d      long,auto
tU     STRING(vs:maxName)
triv   StringTheory
  code
  self.slWhy = '' ; self.slStmt = pTail ; self.slLine = 0
  if ~self.SplitOwnArgs(pTail)
    self.slWhy = 'the split of ' & clip(pRecvU) & ' has no closing bracket this pass can find'
    return 0
  end
  if self.tk.GetTok(pTail - 1) = '.' then self.slStmt = pTail - 2.
  x = self.slStmt - 1
  loop while x > 0 and ~self.IsEolTok(x)
    x -= 1
  end
  self.slLine = x + 1
  fin = self.FirstEolAfter(self.scClose)
  if ~fin then fin = records(self.tk.tokens) + 1.
  loop x = self.slLine to fin - 1
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '+' orof '-' orof '/'
      if x < self.slStmt
        self.slWhy = 'the split of ' & clip(pRecvU) & ' on line ' & self.LogLineOf(self.slStmt) & ' comes after IF, THEN, ELSE, OF or' & |
                     ' END on its line, so it may not run when the code after it does, and the lines read there may come from an earlier split'
      else
        self.slWhy = 'the split of ' & clip(pRecvU) & ' on line ' & self.LogLineOf(self.slStmt) & ' shares its line with a structure' & |
                     ' after it, and only plain statements are moved to lines of their own'
      end
      return 0
    end
    if x < self.slStmt then pre = x.
    if x >= self.slStmt and x <= self.scClose then cycle.
    tU = upper(self.tk.tokens.tok)
    if tU = '(' then dp += 1.
    if tU = ')' then dp -= 1.
    if tU = ';' and ~dp
      semis += 1
      if x < self.slStmt then semiAt = x.
      if self.tk.GetTok(x + 1) = ';'
        self.slWhy = 'the split of ' & clip(pRecvU) & ' shares line ' & self.LogLineOf(x) & ' with a doubled ";", which is not moved here'
        return 0
      end
      if self.IsEolTok(x + 1)
        get(self.tk.tokens, x)
        if not self.tk.tokens.strBefore &= NULL
          if triv.findByte(124, 1,, self.tk.tokens.strBefore) or triv.findByte(10, 1,, self.tk.tokens.strBefore)
            self.slWhy = 'the split of ' & clip(pRecvU) & ' shares line ' & self.LogLineOf(x) & ' with a ";" on a continued line, which cannot be moved'
            return 0
          end
        end
      elsif self.SemiTriviaBad(x, triv)
        self.slWhy = 'the split of ' & clip(pRecvU) & ' shares line ' & self.LogLineOf(x) & ' with text beside a ";" that is not a' & |
                     ' comment, so the statements cannot be put on lines of their own'
        return 0
      end
      cycle
    end
    if x < self.slStmt then cycle.
    n = len(clip(tU))
    if ~n then cycle.
    d = instring('.', tU[1 : n], 1, 1)
    if d > 1 and tU[1 : d - 1] = pRecvU or ~d and tU = pRecvU
      self.slWhy = clip(pRecvU) & ' is named again after its split on line ' & self.LogLineOf(x) & ', on the same line, which' & |
                   ' this pass does not read'
      return 0
    end
  end
  if pre and pre <> semiAt
    self.slWhy = 'the split of ' & clip(pRecvU) & ' on line ' & self.LogLineOf(self.slStmt) & ' follows a label or other code' & |
                 ' on its line, which this pass does not read'
    return 0
  end
  x = self.scClose + 1
  if x < fin and self.tk.GetTok(x) <> ';'
    self.slWhy = 'the split of ' & clip(pRecvU) & ' on line ' & self.LogLineOf(self.slStmt) & ' is followed by more of its' & |
                 ' statement, which this pass does not read'
    return 0
  end
  if semis then return 2.
  return 1

! ------------------------------------------------------------------------------------
! LoopBlankRecords, ClipAtSplit and TrimAtSplit: put each statement of the logical line that
! holds the token pTok on a line of its own, the way SplitStatements does: each top-level ';'
! becomes the line break (SemiToBreak), the next statement takes the line's indent, and a ';'
! that ends the line goes. Called only once SplitLineKind has answered 2 for the split on that
! line, so every ';' on it is one that can be moved. Answers the number of changes; the tokens
! are re-read before the next pass.
! ------------------------------------------------------------------------------------
VitEngine.RelineSplitLine Procedure(LONG pTok)
x      long,auto
ln     long,auto
dp     long
n      long
trail  long
ind    StringTheory
triv   StringTheory
  code
  x = pTok - 1
  loop while x > 0 and ~self.IsEolTok(x)
    x -= 1
  end
  ln = x + 1
  self.LineIndent(ln, ind)
  loop x = ln to records(self.tk.tokens)
    if self.IsEolTok(x) then break.
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.tok
    of '('
      dp += 1
    of ')'
      if dp then dp -= 1.
    of ';'
      if ~dp
        if self.IsEolTok(x + 1)
          trail = x
        else
          self.SemiToBreak(x, ind, triv)
          n += 1
        end
      end
    end
  end
  if trail
    self.tk.DeleteTok(trail)
    n += 1
  end
  if n then self.wantReparse = true.
  return n

! ------------------------------------------------------------------------------------
! LoopBlankRecords, ClipAtSplit, TrimAtSplit, DropLineBuffer, CutToSplit and ChangeBeforeSplit: a
! GOTO after pAt that names a column-1 label at or above pAt jumps back over it, so the lines from
! that label run again after pAt's - the back edge a LOOP around pAt makes, spelled another way.
! The answer is a FIXED POINT: from each new start, the outermost LOOP or ACCEPT around it and any
! GOTO from it to pLast that names a label above it move it again - a GOTO between the start and
! pAt that jumps higher still runs those lines after pAt too. Answers the first token of the line
! the earliest start reached lies on, 0 = no GOTO reaches above pAt (a LOOP alone the callers find
! themselves). A label is looked for from pFirst, a GOTO up to pLast.
! ------------------------------------------------------------------------------------
VitEngine.GotoBackTop Procedure(LONG pAt, LONG pFirst, LONG pLast)
x     long,auto
y     long,auto
top   long,auto
at    long,auto
lv    long,auto
via   byte
nm    STRING(vs:maxName),AUTO
  code
  at = pAt
  loop
    lv = 0                              ! the outermost LOOP or ACCEPT around the start
    loop x = at - 1 to pFirst by -1
      if x < 1 then break.
      get(self.tk.tokens, x)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      case self.tk.tokens.level
      of '-'
        lv += 1
      of '+'
        if lv
          lv -= 1
        elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
          at = x
        end
      end
    end
    top = 0                             ! the earliest label a GOTO from there on names
    loop x = at + 1 to pLast
      get(self.tk.tokens, x)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      if upper(self.tk.tokens.tok) <> 'GOTO' then cycle.
      nm = upper(self.tk.GetTok(x + 1))
      if ~nm then cycle.
      loop y = pFirst to at
        if top and y >= top then break.
        if ~self.syms.IsColOneLabel(y) then cycle.
        if upper(self.tk.GetTok(y)) = nm then top = y ; break.
      end
    end
    if ~top then break.
    if via and top >= at then break.
    via = 1
    if top >= at then at = top ; break.                    ! a label on the start's own line: no higher
    at = top
  end
  if ~via then return 0.
  loop x = at to pFirst by -1                              ! the first token of its line
    if x < 1 then break.
    get(self.tk.tokens, x)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then return x.
  end
  return at

!===============================================================================================
! ClipAtSplit - when EVERY read of a split's lines clips, the clip belongs on the SPLIT.
!
! A read is `line.setValue(src.getLine(x), st:clip)`, or the scratch-free spelling that
! DropLineBuffer writes and an author may write directly - `src.setValueFromLine(x)` with
! `src.clip()` on the line after it (14 Sep 2026). Once the split clips, a read gives its
! own clip up: the `, st:clip` goes from the first spelling, the clip line from the second
! (a comment on that line stays where the line was).
!
!     a.split('<10>')                          ->   a.split('<10>',,,,st:clip)
!     la.setValue(a.getLine(i), st:clip)            la.setValue(a.getLine(i))
!
! StringTheory.Split with pClip stores each line ALREADY CLIPPED: it allocates the line at
! clipLen() and copies only that many bytes, and a line that is blank once clipped is stored as
! a single space with Lines.Empty set. So this is not a display option - it changes what every
! later read of that receiver returns, and it is safe only where every one of those reads wanted
! clipped text anyway.
!
! THE GUARD IS A WHITELIST, NOT A BLACKLIST, and deliberately so. StringTheory has a dozen
! methods that read the line index - getLines, setValueFromLine, setLine, addLine, deleteLine,
! inLine, sort, CSVEncode - and any of them would see different bytes. Rather than list what is
! unsafe and be wrong about the next one added, this walks the whole procedure and refuses
! unless EVERY line mentioning the receiver, after the split, is one of these:
!
!     <x>.setValue(<recv>.getLine(<n>), st:clip)   the clipping read this exists to absorb, x
!                                                  a StringTheory, whose st:clip is the one
!                                                  that moves (or without its st:clip once the
!                                                  split clips)
!     <recv>.setValueFromLine(<n>)                 the same read, scratch-free, with
!                                                  <recv>.clip() on the next line (or without
!                                                  the clip line once the split clips) - a
!                                                  line that is not the next arm of an EXECUTE
!     <recv>.records()                             a count, which pClip does not change - a
!                                                  blank line is still stored, just Empty
!     a value-only read of the receiver            getValue, length, _DataEnd, valuePtr,
!                                                  setValue - the value, never the lines;
!                                                  but not a setValue given st:lines, or an
!                                                  option that may hold it, which copies
!                                                  another object's lines in
!
! EVERY MENTION ON A LINE IS JUDGED, not the first one found: `last = s.getLine(s.records())`
! holds a count AND an unclipped read, and the read is what decides. A line that reads the
! lines twice refuses outright - which read a st:clip belongs to is not read here.
!
! A SPLIT INSIDE A LOOP RUNS AGAIN after every line of that loop's body, the lines ABOVE it
! included, so the walk starts at the first line of the outermost loop around the split. A line
! there that reads the lines refuses: it would see the previous pass's lines clipped. Whatever
! else is done to the object before the split remakes its lines is no concern of the flag.
!
! ONE EDIT PER PASS, IN A DELIBERATE ORDER. The clip goes ONTO the split first; only once it is
! there does a pass start taking ', st:clip' off the reads. A run stopped at any point then has
! clipped lines read with a redundant clip, which is correct, and never unclipped lines read
! without one, which would not be.
!
! THE RECEIVER MUST BE THIS PROCEDURE'S OWN StringTheory - declared here, or in a PROGRAM's main
! CODE program-level and mentioned nowhere else - not a parameter, not a reference, not STATIC
! or THREAD. The walk above sees only this procedure, and the clipped lines stay in the object
! after it: the caller of a parameter, every procedure that sees a global, every method of a
! class and the next call of a STATIC could read them later (ruled 18 Oct 2026).
!===============================================================================================
VitEngine.BuiltinClipAtSplit Procedure(StringTheory pLog)
i          long,auto
caFrom     long,auto
caNext     long,auto
caX        long,auto
caY        long,auto
caD        long,auto
caN        long,auto
caDepth    long,auto
caLineTok  long,auto          ! first token of the line being looked at
caSplitTok long,auto          ! first token of the SPLIT's own line
caClose    long,auto          ! the ')' that closes split(
caScFirst  long,auto
caScLast   long,auto
caScCode   long,auto          ! the end of the procedure's header: a declaration inside it is a parameter
caSc       long,auto
caHitTok   long               ! a read still carrying ', st:clip'; 0 = none
caHitCm    long               !   its comma, and
caHitCl    long               !   its st:clip
caWant     STRING(64)         ! input to CaFind  - the dot-TAIL to look for
caFound    long               ! output of CaFind - caQ row, 0 = not there
caHeadIx   long               ! input to CaHead  - a caQ row
caHead     STRING(vs:maxName) ! output of CaHead - the receiver in front of it
caRecv     STRING(vs:maxName) ! the receiver of the split, folded, for matching
caRecvTxt  STRING(vs:maxName) ! the same name AS THE AUTHOR SPELLED IT, for the log
caSplitHas byte,auto          ! the split already carries st:clip
caLine1    long               ! the first token of the line in hand - NOT caD, which CaHead and CaFind both use as scratch, and NOT caY for the same reason
caReads    long               ! clipping reads seen
caWhy      STRING(200)
caRpt      byte               ! the report-only scan
caEdited   byte               ! the editing scan converted a site
caHitKind  byte               ! 2 = the marked read is the scratch-free one: caHitCm..caHitCl is its clip LINE
caLine2    long               ! the line after a scratch-free read
caClipA    long               ! that line's first token and its EOL when it is <recv>.clip(); 0 = it is not
caClipB    long
caTail     STRING(96)         ! the dot-tail of one mention, for CaValueOnly
caLnReads  long               ! CaValueOnly out: the mentions that are neither a value accessor nor a count
caLnArg    byte               ! CaLinesArg out: the call may be given st:lines
caShOk     byte               ! CaReadShape / CaFromLineShape out: the line is exactly the read
caSplitRow long               ! the caQ row of the split call
caSplitTl  long               ! the split call's own name token, and its statement's first token
caSplitHd  long
caLnKind   byte               ! SplitLineKind: 1 = the split is its whole line, 2 = ;-joined statements to re-line first
caR1       long               ! shape scratch: rows of the call, of getLine, of its closing bracket
caR2       long
caR3       long
caDp       long               !   bracket depth
caPre      byte               ! the line is at or above the split, inside a loop that runs the split again
caLoopTok  long               ! the outermost LOOP opener around the split, 0 = none
caOffTok   long               ! CaDom: the first token the split is no longer on every path to, 0 = none
caDmX      long               !   its walk
caDmD      long               !   and the depth there
caCmt      StringTheory       ! a comment on a clip line being removed - it stays on a line of its own
caIndSt    StringTheory       !   at the line's indent
caBlk      StringTheory       ! an OMIT block folded in front of a line that goes - it stays
caQ        QUEUE,PRE(ca)
tx           STRING(96)
tk           long
           END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  caEdited = 0
  if self.curPass = 1     ! a REPORT-ONLY scan first: every site seen, every refusal
    caRpt = 1 ; do CaScan !   logged, nothing edited - the editing scan below stops at
  end                     !   its first edit, and a refusal past that would go unsaid
  caRpt = 0 ; do CaScan
  return caEdited

! ---- every split in the file: the guard, then - unless this is the report-only scan - the edit
CaScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    caLineTok = i
    caFrom = caLineTok ; do CaFill
    caWant = 'SPLIT' ; do CaFind
    if ~caFound then cycle.
    caSplitRow = caFound
    get(caQ, caSplitRow) ; caSplitTl = caQ.tk
    caHeadIx = caFound ; do CaHead
    if ~caHead then cycle.
    caRecv = caHead
    caSplitTok = caLineTok
    ! ---- the split's own call, read wherever it stands on its line (SplitLineKind): its
    !      arguments by depth, over a '|' if they run on, and whether its line is its own, plain
    !      statements joined by ';' to move to lines of their own first, or refused - behind a
    !      one-line IF, THEN, ELSE or OF the split may not run. The split clips already when
    !      st:clip is its own FIFTH argument, pClip: in split(',', '"', '"', st:clip) it is
    !      pRemoveQuotes, and a st:clip after a ';' belongs to another statement.
    caLnKind = self.SplitLineKind(caSplitTl, caRecv)
    caSplitHd = self.slStmt
    caSplitHas = self.scClip
    ! ---- ONE argument only. Anything with more is a quote / separator / nested split whose
    !      parameter positions this does not read, and guessing where the fifth one goes is how
    !      a silent wrong edit happens.
    if ~caSplitHas and self.scArgN <> 1 then cycle.
    ! A split on one space already drops the spaces at both ends of every line, so a st:clip added
    ! there adds nothing - CheckSplits takes it off again, and the two passes would undo each other
    ! until the pass limit, as TrimAtSplit says of st:clip and st:left.
    if ~caSplitHas and self.scSpace then cycle.
    do CaScope
    if ~caScFirst then cycle.
    caWhy = '' ; caReads = 0 ; caHitTok = 0 ; caHitKind = 0
    do CaOwn
    if ~caWhy and ~caLnKind then caWhy = self.slWhy.
    if ~caWhy then do CaGuard.
    if caWhy
      if caRpt                                                                  ! the report-only scan says why; the editing scan is silent
        pLog.append('BUILTIN ClipAtSplit line ' & self.LogLineOf(caSplitTok) &  |
                    ': REFUSED - ' & clip(caWhy) & '.<13,10>')
      end
      cycle
    end
    if ~caReads then cycle.                                                     ! nothing to absorb: leave it alone
    if caRpt then cycle.                                                        ! seen and sound - the editing scan does the rest
    do CaRecvText
    if ~caSplitHas
      if caLnKind = 2 then do CaReline ; exit.
      do CaCloser                                                               ! STEP ONE: the clip goes on the split
      if ~caClose then cycle.
      self.tk.InsertString(caClose, ',,,,st:clip', 1)                           ! pMid=1: a FRAGMENT, not the start of a line
      if not self.syms &= NULL then self.syms.dirty = 1.
      pLog.append('BUILTIN ClipAtSplit line ' & self.LogLineOf(caSplitTok) &    |
                  ': every read of ' & clip(caRecvTxt)                     &    |
                  ' clips, so the clip is on the split now.<13,10>')
      caEdited = 1
      exit
    end
    if caHitTok                                                                 ! STEP TWO: a read gives its own up
      caN = self.LogLineOf(caHitTok)
      if caHitKind = 2                                                          !   the scratch-free read: its clip line goes
        self.MgCmtText(caHitCl, caCmt)
        self.LineBlocks(caHitCm, caHitCl, caBlk)
        if caCmt._DataEnd                                                       !   a comment on it stays, on a line of its own
          self.IndentOf(caHitCm, caIndSt)
          self.tk.DeleteToks(caHitCm, caHitCl - 1)
          self.tk.SetStrBefore(caHitCm, caIndSt.getValue() & caCmt.getValue())
        else
          self.tk.DeleteToks(caHitCm, caHitCl)
        end
        if caBlk._DataEnd then self.tk.PrependStrBefore(caHitCm, caBlk.getValue()).
        if not self.syms &= NULL then self.syms.dirty = 1.
        pLog.append('BUILTIN ClipAtSplit line ' & caN                        &  |
                    ': the split clips now, so the clip after this read of ' &  |
                    clip(caRecvTxt) & ' goes.<13,10>')
        caEdited = 1
        exit
      end
      self.LineBlocks(caHitCm, caHitCl, caBlk)
      self.tk.DeleteToks(caHitCm, caHitCl)
      if caBlk._DataEnd then self.tk.PrependStrBefore(caHitCm, caBlk.getValue()).
      if not self.syms &= NULL then self.syms.dirty = 1.
      pLog.append('BUILTIN ClipAtSplit line ' & caN                           & |
                  ': the split clips now, so this read of ' & clip(caRecvTxt) & |
                  ' does not have to.<13,10>')
      caEdited = 1
      exit
    end
  end

! ---- the tokens of ONE physical line, uppercased, into caQ; caNext = first token of the next
CaFill routine
  free(caQ)
  caNext = 0
  loop caX = caFrom to records(self.tk.tokens)
    get(self.tk.tokens, caX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      caNext = caX + 1 ; break
    end
    if caX > caFrom and self.tk.tokens.firstOnLine
      caNext = caX ; break
    end
    caQ.tx = upper(self.tk.tokens.tok)
    caQ.tk = caX
    add(caQ)
  end
  if ~caNext then caNext = records(self.tk.tokens) + 1.

! ---- caFound = the caQ row whose DOT-TAIL is caWant, or 0. A merged `A.SPLIT` and a split
!      `A . SPLIT` both answer here, which is the point.
CaFind routine
  caFound = 0
  loop caY = 1 to records(caQ)
    get(caQ, caY)
    if errorcode() then break.
    caN = len(clip(caQ.tx))
    if ~caN then cycle.
    caD = instring('.', caQ.tx[1 : caN], 1, 1)
    if caD and caD < caN
      if caQ.tx[caD + 1 : caN] = caWant then caFound = caY ; break.
    else
      if caQ.tx = caWant then caFound = caY ; break.
    end
  end

! ---- caHead = the RECEIVER in front of the token at caHeadIx
CaHead routine
  caHead = ''
  get(caQ, caHeadIx)
  if errorcode() then exit.
  caN = len(clip(caQ.tx))
  if ~caN then exit.
  caD = instring('.', caQ.tx[1 : caN], 1, 1)
  if caD > 1
    caHead = caQ.tx[1 : caD - 1]
    exit
  end
  if caHeadIx < 3 then exit.
  get(caQ, caHeadIx - 1)
  if errorcode() or caQ.tx <> '.' then exit.
  get(caQ, caHeadIx - 2)
  if ~errorcode() then caHead = caQ.tx.

! ---- the procedure or method the split sits in, and the end of its header
CaScope routine
  caScFirst = 0 ; caScLast = 0 ; caScCode = 0
  caSc = self.syms.ScopeContaining(caSplitTok, vs:scProc, vs:scMethod)
  if ~caSc then exit.
  self.syms.scopes.scopeId = caSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  caScFirst = self.syms.scopes.startTok
  caScLast  = self.syms.scopes.endTok
  caDepth = 0
  loop caX = caScFirst to records(self.tk.tokens)
    get(self.tk.tokens, caX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      caDepth += 1
    elsif self.tk.tokens.tok = ')'
      caDepth -= 1
      if ~caDepth then caScCode = caX ; break.
    elsif ~caDepth and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      caScCode = caX ; break
    end
  end
  if ~caScCode then caScCode = caScFirst.

! ---- the receiver must be this procedure's own StringTheory: declared here (or, in a PROGRAM's
!      main CODE, program-level and mentioned nowhere else), not a parameter, not a reference, not
!      STATIC or THREAD - the clipped lines stay in the object for whoever reads it next (ruled
!      18 Oct 2026). Nor named in a method of a class the procedure declares: such a method shares
!      the procedure's data and its body follows the procedure, outside the walk below. Nor reached
!      under another name - a reference taken on it, a call that may keep one - which reads the lines
!      where the walk below never looks.
!      Nor may the procedure INCLUDE a file: the included code is not in this file, and it may
!      read the lines.
CaOwn routine
  caX = self.syms.FindOwn(caRecv, caSc)
  if ~caX
    caWhy = clip(caRecv) & ' is not declared in this procedure, so whose lines they are cannot be told from here'
    exit
  end
  get(self.syms.syms, caX)
  if errorcode() then caWhy = 'the declaration of ' & clip(caRecv) & ' could not be read' ; exit.
  if self.syms.syms.declTok > caScFirst and self.syms.syms.declTok <= caScCode
    caWhy = clip(caRecv) & ' is a PARAMETER, and its lines are the caller''s to read as they were'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then caWhy = clip(caRecv) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then caWhy = clip(caRecv) & ' is a reference - what it points at is not this procedure''s' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    caWhy = clip(caRecv) & ' is STATIC or THREAD - its lines last to the next call, whose code above the split this pass does not read'
  end
  if ~caWhy and self.MayHaveLocalMethods(caSc) and self.UsedInLocalMethods(upper(caRecv), caScFirst, caScLast)
    caWhy = clip(caRecv) & ' is used in a method of a class this procedure declares, which can read its lines after this pass''s walk ends'
  end
  if ~caWhy and self.ScopeIncludes(caSc)
    caWhy = clip(caRecv) & '''s lines may be read by code the procedure INCLUDEs, which this file does not hold'
  end
  if ~caWhy then caWhy = self.ObjReach(caRecv, caSplitTok, 9).

! ---- the receiver as the AUTHOR spelled it: caQ holds a folded copy for matching, and writing
!      that into a message would rename a to A in the report if not in the code. It is read from
!      the split statement's own first token, which need not begin the line.
CaRecvText routine
  caRecvTxt = caRecv
  get(self.tk.tokens, caSplitHd)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  caN = len(clip(self.tk.tokens.tok))
  if ~caN then exit.
  caD = instring('.', self.tk.tokens.tok[1 : caN], 1, 1)
  if caD > 1
    caRecvTxt = self.tk.tokens.tok[1 : caD - 1]
  elsif ~caD
    caRecvTxt = self.tk.tokens.tok[1 : caN]
  end

! ---- caClose = the ')' that closes the split's OWN '(' - by depth from that bracket, in the real
!      token stream and across a '|' continuation (SplitOwnArgs), never the first bracket pair on
!      the line, which may be another call's
CaCloser routine
  caClose = 0
  if self.SplitOwnArgs(caSplitTl) then caClose = self.scClose.

! ---- STEP ONE when the split shares its line with plain statements joined by ';': each goes on a
!      line of its own first, and the next pass, which finds the split alone on its line, puts the
!      clip on it. Every check has passed, and moving the statements changes none of the answers:
!      nothing after the split on its line names the receiver (SplitLineKind).
CaReline routine
  self.RelineSplitLine(caSplitTl)
  if not self.syms &= NULL then self.syms.dirty = 1.
  pLog.append('BUILTIN ClipAtSplit line ' & self.LogLineOf(caSplitTok) & ': the split of ' & clip(caRecvTxt) & |
              ' shares its line with other statements, so each is put on a line of its own first.<13,10>')
  caEdited = 1

! ---- THE GUARD. From the split to the end of the procedure - and from the first line of the
!      outermost loop around the split, when it sits in one - every line that mentions the
!      receiver must be one of the allowed shapes, every mention on it judged. It also remembers
!      the FIRST read that still carries ', st:clip', which is what step two takes off.
CaGuard routine
  if self.syms.ScopeContaining(caSplitTok, vs:scRoutine, vs:scRoutine)
    caWhy = 'the split is in a routine, and the code that runs after its DO, which may read the lines, is not walked here'
    exit
  end
  do CaDom                                                                               ! caOffTok: where another path joins the split's
  do CaLoopTop                                                                           ! caFrom: the loop's first line, or the line after the split
  loop while caFrom > 0 and caFrom < caScLast
    caLine1 = caFrom
    caPre = choose(caLine1 <= caSplitTok)                                                ! at or above the split: this line runs again after it
    do CaFill
    do CaValueOnly                                                                       ! every mention a VALUE accessor - _DataEnd, valuePtr,
    if caY <> 2                                                                          !   getValue, length, a setValue - or a count: the value,
      caFrom = caNext ; cycle                                                            !   never the lines, so the split's flag cannot reach it.
    end                                                                                  !   Or no mention at all
    if caPre
      caWhy = 'the lines of ' & clip(caRecv) & ' are read on line ' & self.LogLineOf(caLine1) & |
              ', above a split a loop runs again, so the lines of the pass before would come back clipped'
      break
    end
    if caLnReads > 1
      caWhy = clip(caRecv) & '''s lines are read more than once on line ' & self.LogLineOf(caLine1) & |
              ', and which read a st:clip belongs to is not read here'
      break
    end
    caWant = 'SETVALUEFROMLINE' ; do CaFind                                       ! the scratch-free read: the object loads its own line
    if caFound
      caHeadIx = caFound ; do CaHead
      if caHead = caRecv
        do CaFromLineShape                                                        !   and it is the whole line
        if ~caShOk
          caWhy = 'a setValueFromLine on ' & clip(caRecv) & ' shares its line with other code, which this pass does not read'
          break
        end
        caLine2 = caNext
        do CaClipLine                                                             !   <recv>.clip() on the line after it?
        if caWhy then break.
        if caClipA
          do CaOffPath ; if caWhy then break.
          caReads += 1
          if ~caHitTok then caHitTok = caLine1 ; caHitKind = 2 ; caHitCm = caClipA ; caHitCl = caClipB.
          caFrom = caNext ; cycle                                                 !   past the clip line
        end
        if caSplitHas                                                             !   the split clips already: the line comes back clipped
          caFrom = caLine2 ; cycle
        end
        caWhy = 'a later setValueFromLine on ' & clip(caRecv) & ' has no clip after it, so moving' & |
                ' the clip to the split would make that line come back clipped when it does not today'
        break
      end
    end
    ! the clipping read this exists to absorb
    caWant = 'GETLINE' ; do CaFind
    if ~caFound
      caWhy = clip(caRecv) & ' is used on this line in a way this pass does not read, so its' & |
              ' lines may be wanted unclipped'
      break
    end
    caHeadIx = caFound ; do CaHead
    if caHead <> caRecv
      caWhy = clip(caRecv) & '''s lines are read on line ' & self.LogLineOf(caLine1) & ' beside a read of another object''s, which this pass does not read' ! the FIRST getLine is another object's; the receiver's own read on the line is not judged
      break
    end
    do CaReadShape
    if ~caShOk
      caWhy = 'a later read of ' & clip(caRecv) & ' is not exactly <<x>.setValue(' & lower(clip(caRecv)) & '.getLine(<<n>), st:clip),' & |
              ' so whether it wanted every line clipped cannot be told from here'
      break
    end
    do CaReader
    if caWhy then break.
    do CaOffPath ; if caWhy then break.
    caReads += 1
    if ~caHitTok then do CaMarkClip.
    caFrom = caNext
  end

! ---- the path: a read the clip is taken off must be one the split runs before on every way to it. Past the end
!      of the structure that holds the split, past another branch of it, or past a label a GOTO may jump to, the
!      read may be served by another split, or by none, and that one does not clip
CaDom routine
  caOffTok = 0 ; caDmD = 0
  if ~self.SplitOwnArgs(caSplitTl) then exit.  ! CaCloser sets caClose later
  caDmX = self.FirstTokAfterLine(self.scClose)
  if ~caDmX then exit.
  loop caDmX = caDmX to caScLast
    get(self.tk.tokens, caDmX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      caDmD += 1
    elsif self.tk.tokens.level = '-'
      caDmD -= 1
    elsif self.tk.tokens.level = '/' and caDmD <= 0
      caDmD = -1
    end
    if caDmD < 0 or self.syms.IsColOneLabel(caDmX) then caOffTok = caDmX ; break.
  end

CaOffPath routine
  if caOffTok and caLine1 >= caOffTok
    caWhy = 'the split of ' & clip(caRecv) & ' on line ' & self.LogLineOf(caSplitTok) & ' is not on every path to the read on line ' & |
            self.LogLineOf(caLine1) & ', which another split, or none, may serve'
  end

! ---- the read in hand, `<x>.setValue(<recv>.getLine(<n>), st:clip)`, clips as it loads, and the clip
!      moves to the split and then off this line: the line x ends with stays the same only when x is a
!      StringTheory, whose setValue clips when it is given st:clip. On a class of the author's own a
!      setValue of that name may not clip at all, and step two changes its call. So x must resolve to a
!      StringTheory (HayType); one that does not, or that the symbol table cannot place, refuses. A read
!      with no st:clip of its own, on a split that clips already, is neither edited nor relied on
CaReader routine
  get(caQ, records(caQ) - 1)
  if errorcode() or caQ.tx <> 'ST:CLIP' then exit.
  caHeadIx = caR1 ; do CaHead
  get(caQ, 1)
  if errorcode() then exit.
  if self.HayType(caHead, caQ.tk) = 'STRINGTHEORY' then exit.
  caWhy = 'a later read of ' & clip(caRecv) & ' loads its line into ' & clip(caHead) & |
          ', which is not known here to be a StringTheory, so what its setValue does with st:clip cannot be told'

! ---- THE CLIPPING READ'S SHAPE, EXACTLY: `<x>.setValue(<recv>.getLine(<n>), st:clip)` and nothing
!      else on the line. Three names anywhere on it are not that read: `out.setValue(a.getLine(i) &
!      '<<13,10>', st:clip)` clips the whole value, and a st:clip after a ';' belongs to another
!      statement. Once the split clips, the same read without its own `, st:clip` - one a pass
!      has already taken it off, or one written so - is that read too: the line it loads is
!      clipped already. caShOk = the line in caQ is the read.
CaReadShape routine
  caShOk = 0
  get(caQ, 1) ; if errorcode() then exit.
  if pLog.findByte(46, 1,, caQ.tx) then caR1 = 1 else caR1 = 3.   ! <x>.setValue: one row, or three  ! <dot>
  if caR1 = 3
    get(caQ, 2) ; if errorcode() or caQ.tx <> '.' then exit.
    get(caQ, 3) ; if errorcode() or caQ.tx <> 'SETVALUE' then exit.
  else
    caN = len(clip(caQ.tx))
    caD = instring('.', caQ.tx[1 : caN], 1, 1)
    if caQ.tx[caD + 1 : caN] <> 'SETVALUE' then exit.
  end
  get(caQ, caR1 + 1) ; if errorcode() or caQ.tx <> '(' then exit.
  get(caQ, caR1 + 2) ; if errorcode() then exit.                  ! <recv>.getLine directly
  if pLog.findByte(46, 1,, caQ.tx)                                ! <dot>
    caR2 = caR1 + 2
  else
    caR2 = caR1 + 4
    get(caQ, caR1 + 3) ; if errorcode() or caQ.tx <> '.' then exit.
  end
  caHeadIx = caR2 ; do CaHead
  if caHead <> caRecv then exit.
  get(caQ, caR2)
  caN = len(clip(caQ.tx))
  caD = instring('.', caQ.tx[1 : caN], 1, 1)
  if caQ.tx[caD + 1 : caN] <> 'GETLINE' then exit.
  get(caQ, caR2 + 1) ; if errorcode() or caQ.tx <> '(' then exit.
  caDp = 0
  loop caR3 = caR2 + 1 to records(caQ)                            ! getLine's own ')'
    get(caQ, caR3)
    if errorcode() then exit.
    if caQ.tx = '(' then caDp += 1.
    if caQ.tx = ')'
      caDp -= 1
      if ~caDp then break.
    end
  end
  if caDp then exit.
  if caSplitHas and caR3 + 1 = records(caQ)                       ! the split clips: no st:clip of its own
    get(caQ, caR3 + 1)
    if ~errorcode() and caQ.tx = ')' then caShOk = 1.
    exit
  end
  if caR3 + 3 <> records(caQ) then exit.                          ! then exactly `, st:clip )`, and the line ends
  get(caQ, caR3 + 1) ; if errorcode() or caQ.tx <> ',' then exit.
  get(caQ, caR3 + 2) ; if errorcode() or caQ.tx <> 'ST:CLIP' then exit.
  get(caQ, caR3 + 3) ; if errorcode() or caQ.tx <> ')' then exit.
  caShOk = 1

! ---- <recv>.setValueFromLine(<n>) is the whole line: the call starts it, its ')' ends it
CaFromLineShape routine
  caShOk = 0
  if caFound <> 1 and caFound <> 3 then exit.
  if caFound = 3
    get(caQ, 2) ; if errorcode() or caQ.tx <> '.' then exit.
  end
  get(caQ, caFound + 1) ; if errorcode() or caQ.tx <> '(' then exit.
  caDp = 0
  loop caR3 = caFound + 1 to records(caQ)
    get(caQ, caR3)
    if errorcode() then exit.
    if caQ.tx = '(' then caDp += 1.
    if caQ.tx = ')'
      caDp -= 1
      if ~caDp then break.
    end
  end
  if ~caDp and caR3 = records(caQ) then caShOk = 1.

! ---- the ',' and the 'st:clip' of THIS read, in the real token stream, so step two can take
!      them out. The pair is found by walking the line and stopping at the first st:clip.
CaMarkClip routine
  caX = caLine1
  loop while caX < records(self.tk.tokens)
    get(self.tk.tokens, caX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL
      caX += 1 ; cycle
    end
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if upper(self.tk.tokens.tok) = 'ST:CLIP'
      if caX > caLine1
        get(self.tk.tokens, caX - 1)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = ','
          caHitTok = caLine1 ; caHitCm = caX - 1 ; caHitCl = caX
        end
      end
      break
    end
    caX += 1
  end

! ---- caY: 0 = the line does not mention the receiver, 1 = every mention is a value accessor or a
!      count, 2 = something else touches it; caLnReads counts those. A bare mention is the head of
!      `b . tail` when a '.' follows it, and unknown otherwise (an argument, say). At or above the
!      split, inside a loop that runs it again (caPre), only the LINES count as something else:
!      the split remakes them, so whatever else is done to the object before it does not matter.
!      After the split a setValue given st:lines, or an option that may hold it, is something else
!      too: it puts another object's lines in place of the split's, and the reads after it would
!      lose their own clip.
CaValueOnly routine
  caY = 0 ; caLnReads = 0
  loop caX = 1 to records(caQ)
    get(caQ, caX)
    if caQ.tx = caRecv
      if caX < records(caQ)
        get(caQ, caX + 1)
        if caQ.tx = '.' then cycle.
      end
      caY = 2 ; caLnReads += 1 ; cycle
    end
    caHeadIx = caX ; do CaHead
    if caHead <> caRecv then cycle.
    get(caQ, caX)
    caN = len(clip(caQ.tx))
    caD = instring('.', caQ.tx[1 : caN], 1, 1)
    caTail = caQ.tx
    if caD and caD < caN then caTail = caQ.tx[caD + 1 : caN].
    if caTail = 'SETVALUE' and ~caPre
      do CaLinesArg
      if caLnArg
        caY = 2 ; caLnReads += 1 ; cycle
      end
    end
    case caTail
    of '_DATAEND' orof 'VALUEPTR' orof 'GETVALUE'         orof 'LENGTH' orof 'SETVALUE' orof 'RECORDS'
      if ~caY then caY = 1.
    of 'GETLINE'  orof 'GETLINES' orof 'SETVALUEFROMLINE' orof 'INLINE' orof 'JOIN'     orof 'SORT'
      caY = 2 ; caLnReads += 1
    else
      if caPre and caTail[1 : 5] <> 'LINES' ! not the lines, which the split remakes
        if ~caY then caY = 1.
      else
        caY = 2 ; caLnReads += 1
      end
    end
  end

! ---- caLnArg = the call named at caQ row caX is given st:lines, or an option that may hold it
!      (LinesOptAt, which reads the call to its own ')' in the token stream)
CaLinesArg routine
  caLnArg = 0
  get(caQ, caX)
  if ~errorcode() then caLnArg = self.LinesOptAt(caQ.tk).

! ---- caFrom = where the guard starts: the first token of the outermost LOOP around the split,
!      when it sits in one - the loop runs the split again after every line of its body, the lines
!      above the split included - and otherwise the line after the split. A GOTO below the split
!      that jumps back to a label at or above it is the same back edge (GotoBackTop): the guard
!      then starts at the label, when that is earlier.
CaLoopTop routine
  caLoopTok = 0 ; caDepth = 0
  loop caX = caSplitTok - 1 to caScFirst by -1
    if caX < 1 then break.
    get(self.tk.tokens, caX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      caDepth += 1
    of '+'
      if caDepth
        caDepth -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        caLoopTok = caX
      end
    end
  end
  caX = self.GotoBackTop(caSplitTok, caScFirst, caScLast)
  if caX and (~caLoopTok or caX < caLoopTok) then caLoopTok = caX.
  caFrom = caNext
  if ~caLoopTok then exit.
  loop caX = caLoopTok to caScFirst by -1 ! back to the first token of the loop's own line
    get(self.tk.tokens, caX)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then caFrom = caX ; break.
  end

CaClipLine routine
  caClipA = 0 ; caClipB = 0
  caFrom = caLine2 ; do CaFill          ! the line after the read; caNext moves past it
  caWant = 'CLIP' ; do CaFind
  if ~caFound then exit.
  get(caQ, 2) ; if caFound <> 1 and (caFound <> 3 or caQ.tx <> '.') then exit.
  caHeadIx = caFound ; do CaHead
  if caHead <> caRecv or records(caQ) <> caFound + 2 then exit.
  get(caQ, caFound + 1)
  if caQ.tx <> '(' then exit.
  get(caQ, caFound + 2)
  if caQ.tx <> ')' then exit.
  caClipB = self.FirstEolAfter(caLine2) ! the line whole, EOL included
  if caClipB then caClipA = caLine2.
  ! The clip line is `<recv>.clip()` and nothing else: the call starts it - row 1, or rows 1-3 when
  ! the name arrives split - and its ')' ends it. A line that does more, or starts with a label,
  ! is not one step two can take out whole.
  ! A CLIP LINE THAT IS THE NEXT ARM OF AN EXECUTE does not clip the read one arm above it - the
  ! two never run together - and taking it out would make every later arm answer to a different
  ! value. caWhy says so, and the caller stops there.
  if ~caClipA then exit.
  caX = self.ArmOfExecute(caClipA)
  if ~caX then exit.
  caWhy = 'the clip after the setValueFromLine on line ' & self.LogLineOf(caLine1) & ' is another' & |
          ' arm of the EXECUTE on line ' & self.LogLineOf(caX) & ', so the two never run together'
!===============================================================================================

!===============================================================================================
! BUILTIN TrimAtSplit - when EVERY line read from a split is trimmed the moment it is loaded, the
! trimming belongs on the SPLIT.
!
!     a.split('<10>')                       ->   a.split('<10>',,,,st:clip,st:left)
!     la.setValue(a.getLine(i))                  la.setValue(a.getLine(i))
!     la.trim()                                  la.trim()          <- dead now: DeadTrim comments it out
!
! StringTheory.Split with pClip stores each line without its trailing spaces, and with pLeft
! without its leading ones, so a line that every reader trims anyway is stored trimmed once
! instead of being trimmed once per read. Ruled 13 Sep 2026. A clip() on every read asks for
! st:clip alone; a trim() asks for both; the readers must agree, since a clip-only reader would
! see its leading spaces gone. The trims themselves are DeadTrim's to remove, on the pass after:
! a trim of a line the split already stripped has nothing to strip, and DeadTrim reads the flags.
!
! THE GUARD IS THE SAME WHITELIST AS ClipAtSplit's. From the split to the end of the procedure -
! and from the first line of the outermost loop around the split, when it sits in one, since that
! loop runs the split again after the lines above it - every line that mentions the receiver,
! every mention on it judged, must be <recv>.records(), or a load
! <x>.setValue(<recv>.getLine(<n>)) with no flag of its own whose next code line is <x>.trim()
! or <x>.clip(), bare and alone, x a StringTheory, whose trim the split's flags do the work of - or
! the object as its own line buffer, <recv>.setValueFromLine(<n>)
! followed the same way by <recv>.trim(). That next line must not be the next arm of an EXECUTE,
! which never runs with the load. Anything else - a getLines, a join, a read
! of the lines queue, a pass to a call - refuses, because it would see different bytes. The
! receiver must be this procedure's own: a parameter's lines are the caller's, who would see
! them trimmed. The split takes one argument, as ClipAtSplit asks. One edit per pass; the
! report-only scan on pass 1 says why each site refused.
!===============================================================================================
VitEngine.BuiltinTrimAtSplit Procedure(StringTheory pLog)
i          long,auto
taFrom     long,auto
taNext     long,auto
taX        long,auto
taY        long,auto
taD        long,auto
taN        long,auto
taDepth    long,auto
taLineTok  long,auto          ! first token of the line being looked at
taSplitTok long,auto          ! first token of the SPLIT's own line
taSplitRow long               ! the taQ row of the split call
taSplitTl  long               ! the split call's own name token, and its statement's first token
taSplitHd  long
taLnKind   byte               ! SplitLineKind: 1 = the split is its whole line, 2 = ;-joined statements to re-line first
taClose    long,auto          ! the ')' that closes split(
taScFirst  long,auto
taScLast   long,auto
taScCode   long,auto          ! the end of the procedure's header: a declaration inside it is a parameter
taSc       long,auto
taWant     STRING(64)         ! input to TaFind - the dot-TAIL to look for; TaTrimNext's answer
taFound    long               ! output of TaFind - taQ row, 0 = not there
taHeadIx   long               ! input to TaHead - a taQ row
taHead     STRING(vs:maxName) ! output of TaHead - the receiver in front of it
taRecv     STRING(vs:maxName) ! the receiver of the split, folded
taRecvTxt  STRING(vs:maxName) ! the same name as the author spelled it, for the log
taBuf      STRING(vs:maxName) ! the buffer a load fills, folded
taMention  byte               ! TaValueOnly out: the line mentions the receiver
taValOnly  byte               ! TaValueOnly out: the line reads the receiver's value only, or counts its lines
taLnReads  long               ! TaValueOnly out: the mentions that are neither a value read nor a count
taShOk     byte               ! TaReadShape / TaFromLineShape out: the line is exactly the load
taR1       long               ! shape scratch: rows of the call, of getLine, of its closing bracket
taR2       long
taR3       long
taDp       long               !   bracket depth
taPre      byte               ! the line is at or above the split, inside a loop that runs the split again
taLoopTok  long               ! the outermost LOOP opener around the split, 0 = none
taTail     STRING(96)         ! the dot-tail of one mention, for TaValueOnly
taValReads EQUATE(            |
  ' _DATAEND LENGTH GETVALUE GETVALUEPTR VALUEPTR SLICE SUB INSTRING CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS STARTSWITH ENDSWITH EQUALS CLIPLENGTH ISALL ISALLDIGITS COUNT RECORDS ')
taLineUse  EQUATE(' GETLINE GETLINES SETVALUEFROMLINE INLINE JOIN SORT LINES ')
taLine1    long
taReads    long               ! trimmed loads seen
taKind     STRING(8)          ! 'TRIM' or 'CLIP' - what every reader does; '' until the first
taWhy      STRING(200)
taRpt      byte               ! the report-only scan
taEdited   byte
taQ        QUEUE,PRE(ta)
tx           STRING(96)
tk           long
           END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  taEdited = 0
  if self.curPass = 1
    taRpt = 1 ; do TaScan
  end
  taRpt = 0 ; do TaScan
  return taEdited

! ---- every split in the file: the guard, then - unless this is the report-only scan - the edit
TaScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    taLineTok = i
    taFrom = taLineTok ; do TaFill
    taWant = 'SPLIT' ; do TaFind
    if ~taFound then cycle.
    taSplitRow = taFound
    get(taQ, taSplitRow) ; taSplitTl = taQ.tk
    taHeadIx = taFound ; do TaHead
    if ~taHead then cycle.
    taRecv = taHead
    taSplitTok = taLineTok
    ! the split's own call, read wherever it stands on its line, as ClipAtSplit reads it
    ! (SplitLineKind): its arguments by depth, and whether its line is its own, plain statements
    ! joined by ';' to move to lines of their own first, or refused
    taLnKind = self.SplitLineKind(taSplitTl, taRecv)
    taSplitHd = self.slStmt
    if self.scArgN <> 1 then cycle.
    ! A split on one space already drops the spaces at both ends of every line, so st:clip and
    ! st:left add nothing there - CheckSplits takes them off again, and the two passes would undo
    ! each other until the pass limit. Whether such a split's trims can go is DeadTrim's call.
    if self.scSpace then cycle.
    do TaScope
    if ~taScFirst then cycle.
    taWhy = '' ; taReads = 0 ; taKind = ''
    do TaOwn
    if ~taWhy and ~taLnKind then taWhy = self.slWhy.
    if ~taWhy then do TaGuard.
    if taWhy
      if taRpt
        pLog.append('BUILTIN TrimAtSplit line ' & self.LogLineOf(taSplitTok) & ': REFUSED - ' & clip(taWhy) & '.<13,10>')
      end
      cycle
    end
    if ~taReads then cycle. ! nothing trimmed: nothing to move
    if taRpt then cycle.
    do TaRecvText
    if taLnKind = 2 then do TaReline ; exit.
    do TaCloser
    if ~taClose then cycle.
    self.tk.InsertString(taClose, choose(taKind = 'TRIM', ',,,,st:clip,st:left', ',,,,st:clip'), 1) ! pMid=1: a fragment, not a line start
    if not self.syms &= NULL then self.syms.dirty = 1.
    pLog.append('BUILTIN TrimAtSplit line ' & self.LogLineOf(taSplitTok) & ': every line read from ' & clip(taRecvTxt) & |
                ' is ' & choose(taKind = 'TRIM', 'trimmed', 'clipped') & ' as it is loaded, so the split does it now.<13,10>')
    taEdited = 1
    exit
  end

! ---- the tokens of ONE physical line, uppercased, into taQ; taNext = first token of the next
TaFill routine
  free(taQ)
  taNext = 0
  loop taX = taFrom to records(self.tk.tokens)
    get(self.tk.tokens, taX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      taNext = taX + 1 ; break
    end
    if taX > taFrom and self.tk.tokens.firstOnLine
      taNext = taX ; break
    end
    taQ.tx = upper(self.tk.tokens.tok)
    taQ.tk = taX
    add(taQ)
  end
  if ~taNext then taNext = records(self.tk.tokens) + 1.

! ---- taMention = the line mentions the receiver; taValOnly = every mention reads its VALUE - a
!      length, a slice, a search - or counts its lines, which the flags cannot touch: they change
!      only what the split put in its lines; taLnReads = the mentions that are something else. A
!      bare mention (the object handed to a call) is one, and so is any other method - except at or
!      above the split, inside a loop that runs it again (taPre), where only a read of the LINES
!      is: the split remakes them.
TaValueOnly routine
  taMention = 0 ; taValOnly = 0 ; taLnReads = 0
  loop taX = 1 to records(taQ)
    get(taQ, taX)
    if errorcode() then break.
    if taQ.tx = taRecv
      get(taQ, taX + 1)
      if ~errorcode() and taQ.tx = '.' then cycle. ! the head of a split call: judged at its method
      taMention = 1 ; taLnReads += 1 ; cycle       ! handed whole to a call
    end
    taHeadIx = taX ; do TaHead
    if taHead <> taRecv then cycle.
    taMention = 1
    get(taQ, taX)
    taN = len(clip(taQ.tx))
    taD = instring('.', taQ.tx[1 : taN], 1, 1)
    taTail = taQ.tx
    if taD and taD < taN then taTail = taQ.tx[taD + 1 : taN].
    if instring(' ' & clip(taTail) & ' ', taValReads, 1, 1) then cycle.
    if taPre and ~instring(' ' & clip(taTail) & ' ', taLineUse, 1, 1) and taTail[1 : 5] <> 'LINES' then cycle.
    taLnReads += 1
  end
  if taMention and ~taLnReads then taValOnly = 1.

! ---- taFrom = where the guard starts: the first token of the outermost LOOP around the split, when
!      it sits in one - the loop runs the split again after every line of its body, the lines above
!      the split included - and otherwise the line after the split. A GOTO below the split that
!      jumps back to a label at or above it is the same back edge (GotoBackTop): the guard then
!      starts at the label, when that is earlier.
TaLoopTop routine
  taLoopTok = 0 ; taDepth = 0
  loop taX = taSplitTok - 1 to taScFirst by -1
    if taX < 1 then break.
    get(self.tk.tokens, taX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      taDepth += 1
    of '+'
      if taDepth
        taDepth -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        taLoopTok = taX
      end
    end
  end
  taX = self.GotoBackTop(taSplitTok, taScFirst, taScLast)
  if taX and (~taLoopTok or taX < taLoopTok) then taLoopTok = taX.
  taFrom = taNext
  if ~taLoopTok then exit.
  loop taX = taLoopTok to taScFirst by -1 ! back to the first token of the loop's own line
    get(self.tk.tokens, taX)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then taFrom = taX ; break.
  end

! ---- taFound = the taQ row whose DOT-TAIL is taWant, or 0
TaFind routine
  taFound = 0
  loop taY = 1 to records(taQ)
    get(taQ, taY)
    if errorcode() then break.
    taN = len(clip(taQ.tx))
    if ~taN then cycle.
    taD = instring('.', taQ.tx[1 : taN], 1, 1)
    if taD and taD < taN
      if taQ.tx[taD + 1 : taN] = taWant then taFound = taY ; break.
    else
      if taQ.tx = taWant then taFound = taY ; break.
    end
  end

! ---- taHead = the RECEIVER in front of the token at taHeadIx
TaHead routine
  taHead = ''
  get(taQ, taHeadIx)
  if errorcode() then exit.
  taN = len(clip(taQ.tx))
  if ~taN then exit.
  taD = instring('.', taQ.tx[1 : taN], 1, 1)
  if taD > 1
    taHead = taQ.tx[1 : taD - 1]
    exit
  end
  if taHeadIx < 3 then exit.
  get(taQ, taHeadIx - 1)
  if errorcode() or taQ.tx <> '.' then exit.
  get(taQ, taHeadIx - 2)
  if ~errorcode() then taHead = taQ.tx.

! ---- the procedure the split sits in, and the end of its header
TaScope routine
  taScFirst = 0 ; taScLast = 0 ; taScCode = 0
  taSc = self.syms.ScopeContaining(taSplitTok, vs:scProc, vs:scMethod)
  if ~taSc then exit.
  self.syms.scopes.scopeId = taSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  taScFirst = self.syms.scopes.startTok
  taScLast  = self.syms.scopes.endTok
  taDepth = 0
  loop taX = taScFirst to records(self.tk.tokens)
    get(self.tk.tokens, taX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      taDepth += 1
    elsif self.tk.tokens.tok = ')'
      taDepth -= 1
      if ~taDepth then taScCode = taX ; break.
    elsif ~taDepth and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      taScCode = taX ; break
    end
  end
  if ~taScCode then taScCode = taScFirst.

! ---- the receiver must be this procedure's own StringTheory: declared here (or, in a PROGRAM's
!      main CODE, program-level and mentioned nowhere else), not a parameter, not a reference, not
!      STATIC or THREAD. The flags change the lines KEPT IN THE OBJECT, and the caller of a
!      parameter, every procedure that sees a global, every method of a class and the next call
!      of a STATIC read those lines after this one (ruled 18 Oct 2026). So does a method of a class
!      the procedure declares: it shares the procedure's data, and its body lies outside the walk. So
!      does a second name for it - a reference taken on it, a call that may keep one.
!      So may code the procedure INCLUDEs, which is not in this file.
TaOwn routine
  taX = self.syms.FindOwn(taRecv, taSc)
  if ~taX
    taWhy = clip(taRecv) & ' is not declared in this procedure, so whose lines they are cannot be told from here'
    exit
  end
  get(self.syms.syms, taX)
  if errorcode() then taWhy = 'the declaration of ' & clip(taRecv) & ' could not be read' ; exit.
  if self.syms.syms.declTok > taScFirst and self.syms.syms.declTok <= taScCode
    taWhy = clip(taRecv) & ' is a PARAMETER, and its lines are the caller''s to read as they were'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then taWhy = clip(taRecv) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then taWhy = clip(taRecv) & ' is a reference - what it points at is not this procedure''s' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    taWhy = clip(taRecv) & ' is STATIC or THREAD - its lines last to the next call, whose code above the split this pass does not read'
  end
  if ~taWhy and self.MayHaveLocalMethods(taSc) and self.UsedInLocalMethods(upper(taRecv), taScFirst, taScLast)
    taWhy = clip(taRecv) & ' is used in a method of a class this procedure declares, which can read its lines after this pass''s walk ends'
  end
  if ~taWhy and self.ScopeIncludes(taSc)
    taWhy = clip(taRecv) & '''s lines may be read by code the procedure INCLUDEs, which this file does not hold'
  end
  if ~taWhy then taWhy = self.ObjReach(taRecv, taSplitTok, 9).

! ---- the receiver as the AUTHOR spelled it, from the split statement's own first token
TaRecvText routine
  taRecvTxt = taRecv
  get(self.tk.tokens, taSplitHd)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  taN = len(clip(self.tk.tokens.tok))
  if ~taN then exit.
  taD = instring('.', self.tk.tokens.tok[1 : taN], 1, 1)
  if taD > 1
    taRecvTxt = self.tk.tokens.tok[1 : taD - 1]
  elsif ~taD
    taRecvTxt = self.tk.tokens.tok[1 : taN]
  end

! ---- taClose = the ')' that closes the split's OWN '(' - by depth from that bracket, in the real
!      token stream and across a '|' continuation (SplitOwnArgs), never the first bracket pair on
!      the line, which may be another call's
TaCloser routine
  taClose = 0
  if self.SplitOwnArgs(taSplitTl) then taClose = self.scClose.

! ---- the split shares its line with plain statements joined by ';': each goes on a line of its
!      own first, and the next pass, which finds the split alone on its line, puts the flags on it.
!      Every check has passed, and moving the statements changes none of the answers: nothing
!      after the split on its line names the receiver (SplitLineKind).
TaReline routine
  self.RelineSplitLine(taSplitTl)
  if not self.syms &= NULL then self.syms.dirty = 1.
  pLog.append('BUILTIN TrimAtSplit line ' & self.LogLineOf(taSplitTok) & ': the split of ' & clip(taRecvTxt) & |
              ' shares its line with other statements, so each is put on a line of its own first.<13,10>')
  taEdited = 1

! ---- THE GUARD. From the split to the end of the procedure - and from the first line of the
!      outermost loop around the split, when it sits in one - every line that mentions the
!      receiver is a count, a read of its value, or a load whose next code line trims the buffer it
!      filled - the object itself, when it is its own line buffer. Every mention on the line is
!      judged, and a line that reads the lines twice refuses: the trim after a load is judged one
!      load at a time.
TaGuard routine
  if self.syms.ScopeContaining(taSplitTok, vs:scRoutine, vs:scRoutine)
    taWhy = 'the split is in a routine, and the code that runs after its DO, which may read the lines, is not walked here'
    exit
  end
  do TaLoopTop                            ! taFrom: the loop's first line, or the line after the split
  loop while taFrom > 0 and taFrom < taScLast
    taLine1 = taFrom
    taPre = choose(taLine1 <= taSplitTok) ! at or above the split: this line runs again after it
    do TaFill
    do TaValueOnly                        ! a count, or a read of the receiver's VALUE, sees nothing of the flags
    if ~taMention or taValOnly
      taFrom = taNext ; cycle
    end
    if taPre
      taWhy = 'the lines of ' & clip(taRecv) & ' are read on line ' & self.LogLineOf(taLine1) & ', above a split a loop runs again, so the lines of the pass before would come back trimmed'
      break
    end
    if taLnReads > 1
      taWhy = clip(taRecv) & '''s lines are read more than once on line ' & self.LogLineOf(taLine1) & ', and the trim after a load is judged one load at a time'
      break
    end
    ! the object as its own line buffer: <recv>.setValueFromLine(n), then <recv>.trim()
    taWant = 'SETVALUEFROMLINE' ; do TaFind
    if taFound
      taHeadIx = taFound ; do TaHead
      if taHead = taRecv
        do TaFromLineShape
        if ~taShOk
          taWhy = 'the setValueFromLine on line ' & self.LogLineOf(taLine1) & ' shares its line with other code, which this pass does not read'
          break
        end
        taBuf = taRecv
        do TaTrimNext
        if taWhy then break.
        if ~taWant
          taWhy = 'the line loaded on line ' & self.LogLineOf(taLine1) & ' is not trimmed as it is loaded, so the split must not trim it'
          break
        end
        if ~taKind then taKind = taWant.
        if taKind <> taWant
          taWhy = 'the loads do not agree - one trims and one clips - and a split can do only one thing to every line'
          break
        end
        taReads += 1
        taFrom = taNext
        cycle
      end
    end
    taWant = 'GETLINE' ; do TaFind
    if ~taFound
      taWhy = clip(taRecv) & ' is used on line ' & self.LogLineOf(taLine1) & ' in a way this pass does not read, so its lines may be wanted as they are'
      break
    end
    taHeadIx = taFound ; do TaHead
    if taHead <> taRecv
      taWhy = clip(taRecv) & '''s lines are read on line ' & self.LogLineOf(taLine1) & ' beside a read of another object''s, which this pass does not read'
      break
    end
    do TaReadShape                            ! exactly <buf>.setValue(<recv>.getLine(<n>)), alone on its line
    if ~taShOk
      taWhy = 'the read of ' & clip(taRecv) & ' on line ' & self.LogLineOf(taLine1) & ' is not exactly a load of one line, alone, so what it wanted cannot be told'
      break
    end
    taWant = 'SETVALUE' ; do TaFind
    if ~taFound
      taWhy = 'a getLine on ' & clip(taRecv) & ' on line ' & self.LogLineOf(taLine1) & ' is read by something other than a setValue, so what it wanted cannot be told'
      break
    end
    taHeadIx = taFound ; do TaHead
    taBuf = taHead
    if ~taBuf
      taWhy = 'the setValue on line ' & self.LogLineOf(taLine1) & ' has no receiver this pass can read'
      break
    end
    taWant = 'ST:CLIP' ; do TaFind
    if taFound
      taWhy = 'the load on line ' & self.LogLineOf(taLine1) & ' clips as it loads, which is ClipAtSplit''s shape'
      break
    end
    do TaTrimNext                             ! the next code line: <buf>.trim() or <buf>.clip(), alone
    if taWhy then break.
    if ~taWant
      taWhy = 'the line loaded on line ' & self.LogLineOf(taLine1) & ' is not trimmed as it is loaded, so the split must not trim it'
      break
    end
    do TaReader
    if taWhy then break.
    if ~taKind then taKind = taWant.
    if taKind <> taWant
      taWhy = 'the loads do not agree - one trims and one clips - and a split can do only one thing to every line'
      break
    end
    taReads += 1
    taFrom = taNext
  end

! ---- the load in hand fills taBuf, and the trim or clip on the line after it is taBuf's: moving it to
!      the split keeps the line taBuf ends with the same only when taBuf is a StringTheory, whose
!      setValue loads the line as it is and whose trim() and clip() strip spaces. On a class of the
!      author's own those names may do something else. So taBuf must resolve to a StringTheory
!      (HayType); one that does not, or that the symbol table cannot place, refuses. taQ holds the
!      trim line here, whose first row is taBuf
TaReader routine
  get(taQ, 1)
  if errorcode() then exit.
  if self.HayType(taBuf, taQ.tk) = 'STRINGTHEORY' then exit.
  taWhy = 'the line loaded on line ' & self.LogLineOf(taLine1) & ' goes into ' & clip(taBuf) &                          |
          ', which is not known here to be a StringTheory, so what its ' & lower(clip(taWant)) & ' does cannot be told'

! ---- THE LOAD'S SHAPE, EXACTLY: `<buf>.setValue(<recv>.getLine(<n>))` and nothing else on the line.
!      Names anywhere on it are not that load: `fld.setValue(sub(a.getLine(i), 6, 10))` reads fixed
!      COLUMNS, which a trimmed line no longer has where they were. taShOk = the line is the load.
TaReadShape routine
  taShOk = 0
  get(taQ, 1) ; if errorcode() then exit.
  if pLog.findByte(46, 1,, taQ.tx) then taR1 = 1 else taR1 = 3.   ! <dot>
  if taR1 = 3
    get(taQ, 2) ; if errorcode() or taQ.tx <> '.' then exit.
    get(taQ, 3) ; if errorcode() or taQ.tx <> 'SETVALUE' then exit.
  else
    taN = len(clip(taQ.tx))
    taD = instring('.', taQ.tx[1 : taN], 1, 1)
    if taQ.tx[taD + 1 : taN] <> 'SETVALUE' then exit.
  end
  get(taQ, taR1 + 1) ; if errorcode() or taQ.tx <> '(' then exit.
  get(taQ, taR1 + 2) ; if errorcode() then exit.
  if pLog.findByte(46, 1,, taQ.tx)                                ! <dot>
    taR2 = taR1 + 2
  else
    taR2 = taR1 + 4
    get(taQ, taR1 + 3) ; if errorcode() or taQ.tx <> '.' then exit.
  end
  taHeadIx = taR2 ; do TaHead
  if taHead <> taRecv then exit.
  get(taQ, taR2)
  taN = len(clip(taQ.tx))
  taD = instring('.', taQ.tx[1 : taN], 1, 1)
  if taQ.tx[taD + 1 : taN] <> 'GETLINE' then exit.
  get(taQ, taR2 + 1) ; if errorcode() or taQ.tx <> '(' then exit.
  taDp = 0
  loop taR3 = taR2 + 1 to records(taQ)
    get(taQ, taR3)
    if errorcode() then exit.
    if taQ.tx = '(' then taDp += 1.
    if taQ.tx = ')'
      taDp -= 1
      if ~taDp then break.
    end
  end
  if taDp then exit.
  if taR3 + 1 <> records(taQ) then exit.                          ! then only setValue's own ')'
  get(taQ, taR3 + 1) ; if errorcode() or taQ.tx <> ')' then exit.
  taShOk = 1

! ---- <recv>.setValueFromLine(<n>) is the whole line: the call starts it, its ')' ends it
TaFromLineShape routine
  taShOk = 0
  if taFound <> 1 and taFound <> 3 then exit.
  if taFound = 3
    get(taQ, 2) ; if errorcode() or taQ.tx <> '.' then exit.
  end
  get(taQ, taFound + 1) ; if errorcode() or taQ.tx <> '(' then exit.
  taDp = 0
  loop taR3 = taFound + 1 to records(taQ)
    get(taQ, taR3)
    if errorcode() then exit.
    if taQ.tx = '(' then taDp += 1.
    if taQ.tx = ')'
      taDp -= 1
      if ~taDp then break.
    end
  end
  if ~taDp and taR3 = records(taQ) then taShOk = 1.

! ---- the next code line after the load: <buf>.trim() or <buf>.clip(), bare, alone. taWant = the
!      call, or '' when it is anything else; taNext then points past that line
TaTrimNext routine
  taWant = ''
  taFrom = taNext
  loop
    if ~taFrom or taFrom > records(self.tk.tokens) then exit.
    do TaFill
    if records(taQ) then break.
    taFrom = taNext
  end
  if records(taQ) <> 5 then exit. ! `buf . trim ( )` - a method CALL arrives split
  get(taQ, 1)
  if taQ.tx <> taBuf then exit.
  get(taQ, 2)
  if taQ.tx <> '.' then exit.
  get(taQ, 3)
  if taQ.tx <> 'TRIM' and taQ.tx <> 'CLIP' then exit.
  get(taQ, 4)
  if taQ.tx <> '(' then exit.
  get(taQ, 5)
  if taQ.tx <> ')' then exit.
  get(taQ, 3)
  taWant = taQ.tx
  ! A TRIM LINE THAT IS THE NEXT ARM OF AN EXECUTE does not trim the load one arm above it: the
  ! two never run together. taWhy says so, and the caller stops there.
  taX = self.ArmOfExecute(taFrom)
  if taX
    taWhy = 'the ' & lower(clip(taWant)) & ' after the load on line ' & self.LogLineOf(taLine1) & ' is another' & |
            ' arm of the EXECUTE on line ' & self.LogLineOf(taX) & ', so the two never run together'
  end

!===============================================================================================
! DropLineBuffer - a scratch object that only ever holds ONE LINE is the source object itself.
!
!     la.setValue(a.getLine(i))        ->   a.setValueFromLine(i)
!     ... la._DataEnd ... la.valuePtr        ... a._DataEnd ... a.valuePtr
!
! SetValueFromLine overwrites the receiver's VALUE and LEAVES ITS LINE INDEX ALONE - SetValue
! calls the no-argument Free(), which either sets _DataEnd to 0 or calls free(false,false), and
! FreeLines runs only when pLines is asked for. So the source can be its own line buffer.
! WHETHER IT MAY BE is three separate questions, ruled on 11 Sep 2026:
!
!   RULE 1  THE BUFFER MUST NEVER BE SPLIT, and its lines never used. If the code goes on to
!           split the buffer itself it needs to be its own object with its own lines.
!   RULE 2  THE SOURCE MUST BE A LOCAL COPY. You cannot overwrite an object the caller owns:
!           `a.setValue(pA)` is what makes `a` ours to clobber. Not even a parameter whose lines
!           are joined back before the caller gets it: the caller may have given it Stream(),
!           and its file would receive each line the drop loads into it (ruled 29 Oct 2026).
!   RULE 3  THE SOURCE'S VALUE MUST BE DEAD AFTERWARDS - OR REBUILT FROM THE LINES. The second
!           half is the half that matters. Split / change / JOIN is a common pattern, and in it
!           the value is deliberately thrown away and rebuilt, so a later join() on the source
!           DISCHARGES this rule rather than raising it. A guard that only asked "is the value
!           read later" would refuse the commonest safe case.
!
! A LOAD THAT CLIPS KEEPS ITS CLIP. SetValueFromLine does not clip, so a read written
! la.setValue(a.getLine(i), st:clip) comes out one of two ways - ruled 12 Sep 2026: when a's split
! already carries st:clip the lines sit clipped in the queue and the st:clip on the read was doing
! nothing, so it simply goes; otherwise the object is clipped after the load,
!     a.setValueFromLine(i) ; a.clip()
! which is the value the clipping read gave the buffer. A read that does not clip converts as it
! is, whatever the split does: getLine and setValueFromLine both hand back the stored line as it is.
!
! THE EDIT RENAMES FIRST AND REWRITES SECOND. SetTok changes a token's text and nothing moves,
! so every other mention of the buffer can be renamed without recomputing anything; the
! structural rewrite of the setValue line renumbers, so it goes last. A run stopped between the
! two would otherwise leave reads of a buffer that nothing writes.
!===============================================================================================
VitEngine.BuiltinDropLineBuffer Procedure(StringTheory pLog)
i           long,auto
dbFrom      long,auto
dbNext      long,auto
dbX         long,auto
dbY         long,auto
dbZ         long,auto          ! a THIRD index: dbX and dbY are both taken by the helpers
dbD         long,auto          ! instring scratch - the helpers use it, nothing else may
dbN         long,auto          ! length scratch - likewise
dbLine1     long,auto          ! first token of the SITE - the line being rewritten
dbWalk      long,auto          ! first token of the line a GUARD is looking at. Its own,
dbSiteNext  long,auto          !   because a guard walk must not move the site
dbSetTok    long,auto          ! the <buf>.setValue token, in the real stream
dbGetTok    long,auto          ! the <recv>.getLine token
dbOpen      long,auto          ! the '(' of getLine
dbClose     long,auto          ! the ')' that closes setValue
dbScFirst   long,auto
dbScLast    long,auto
dbScCode    long,auto          ! the last token of the procedure HEADER: anything declared
dbSc        long,auto          !   at or before it is a PARAMETER, not a local
dbWant      STRING(64)         ! input to DbFind  - the dot-TAIL to look for
dbFound     long               ! output of DbFind - dbQ row, 0 = not there
dbHeadIx    long               ! input to DbHead  - a dbQ row
dbHead      STRING(vs:maxName) ! output of DbHead - the receiver in front of it
dbBuf       STRING(vs:maxName) ! the scratch object, folded
dbRecv      STRING(vs:maxName) ! the source object, folded
dbBufTxt    STRING(vs:maxName) ! and as the author spelled them
dbRecvTxt   STRING(vs:maxName)
dbHeadTok   long,auto          ! the token carrying the BUFFER's name on the site line
dbGetHead   long,auto          ! and the token carrying the SOURCE's name
dbMerged    byte               ! the dotted names arrived as ONE token, not three
dbReadClips byte               ! the READ carries st:clip - the load keeps its clip, one of two ways
dbSplitClip byte               ! the source's split carries st:clip - its lines sit clipped already
dbGetClose  long,auto          ! the ')' that closes getLine; up to dbClose after it is `, st:clip`
dbBufDecl   long               ! the buffer's own DECLARATION token. The rename must NOT touch it:
                               !   renaming it makes a SECOND declaration of the source and the
                               !   file stops compiling. Left alone, UnusedVars sweeps it next.
dbMention   byte               ! this line mentions the name being checked - its OWN flag
dbJoined    byte               ! a later join() rebuilds the value, which DISCHARGES rule 3
dbJoinAt    long               !   the first token of that join's line
dbJoinUsed  byte               !   and a value read after it was let through because of it
dbJoinTk    long               !   the JOIN itself: a one-line IF in front of it is a structure
dbRt        long               ! DbRtRead: the routine a value read lies in, 0 = none,
dbRtX       long               !   a token of the walk for its DOs
dbRtN       STRING(vs:maxName) !   and its name
dbOwnN      long               ! mentions of the source on the load's own line
dbLoopS     long               ! the outermost LOOP or ACCEPT around the load, or a label above it a GOTO below jumps back to: the lines above the load run again
dbLoopLd    byte               !   and a load of the buffer has been passed inside it
dbWhy       STRING(200)
dbTail      STRING(96)
dbInd       StringTheory       ! DbClipLine out: the line's trailing comment, a line break and the indent - empty when the load shares its line
dbTmpSt     StringTheory       ! IndentOf's answer
dbArgs      byte               ! DbCallArgs: the call after this row has at least one argument
dbLinesOpt  byte               !   ... and it is given st:lines (1) or an option that may hold it (2)
dbBareOk    byte               ! DbStoreBack: this bare mention is the source's own setLine(n, buf)
dbRptOnly   byte               ! this scan logs every refusal and edits nothing - pass 1 only
dbEdited    byte               ! the editing scan converted a site
dbLastRd    long               ! first token of the LAST line after the site that mentions the buffer -
dbNextLd    long               !   before the buffer is LOADED again, which is a site of its own
dbSeenLd    byte               ! walking up to the site: a load of the buffer has been passed - a read after one is that load's
dbDepth     long,auto          ! DbRuns: structure depth, counted from the site
dbLinesWr   EQUATE(' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN SORT ADDLINE SETLINE INSERTLINE DELETELINE REMOVELINES FREELINES SWAP LINES SETLINEFROMVALUE START FILTER WRAPTEXT ')
dbQ        QUEUE,PRE(db)
tx           STRING(96)
tk           long              ! the token this row came from
           END
dbSelfU    STRING(vs:maxName)  ! the scope's class when it is a method, for the summaries
dbSRow     long                ! the dbQ row of setValue
dbGRow     long                !   and of getLine
dbShapeOk  byte                ! DbShape: the load is exactly buf.setValue(recv.getLine(...)), with or without st:clip
dbSpAny    byte                ! DbSplitClips: a split of the source was seen
dbSpAll    byte                !   and every one clips by its own pClip
dbSpOk     byte                !   this one does
dbSpI      long                !   its rows, bracket depth and commas
dbSpD      long
dbSpC      long
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  self.BuildSummaries()   ! which bodies only READ a parameter - a call to one is no obstacle (ruled 14 Sep 2026)
  ! Two scans. The editing scan has to stop at its first conversion, because the edit shifts
  ! every token after it and the scope bounds with them - so on its own it would never reach
  ! a site further down the file to report a refusal there. The report-only scan runs first,
  ! on pass 1, and sees every site.
  dbEdited = 0
  if self.curPass = 1
    dbRptOnly = 1 ; do DbScan
  end
  dbRptOnly = 0 ; do DbScan
  return dbEdited

! ---- every line of the file: the shape, the rules, and - unless this is the report-only scan - the edit
DbScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    dbLine1 = i
    dbFrom = dbLine1 ; do DbFill
    dbSiteNext = dbNext
    ! ---- <buf>.setValue( <recv>.getLine( <ix> ) ) and nothing else on the line
    dbWant = 'SETVALUE' ; do DbFind ; if ~dbFound then cycle.
    dbSRow = dbFound
    dbHeadIx = dbFound ; do DbHead ; dbBuf = dbHead
    if ~dbBuf then cycle.
    dbWant = 'GETLINE'  ; do DbFind ; if ~dbFound then cycle.
    dbGRow = dbFound
    dbHeadIx = dbFound ; do DbHead ; dbRecv = dbHead
    if ~dbRecv or dbRecv = dbBuf then cycle.
    dbWant = 'ST:CLIP'  ; do DbFind ; dbReadClips = choose(dbFound > 0)           ! a clipping read: the edit keeps the clip
    do DbShape ; if ~dbShapeOk then cycle.                                        ! the line itself, and nothing else, is loaded
    !------------------------------------------------------------------------------------------
    ! THE SHAPE IS RIGHT. Now the rules, cheapest first.
    !------------------------------------------------------------------------------------------
    dbWhy = ''
    do DbScope
    if ~dbScFirst then cycle.
    do DbNamesAsWritten                                                           ! the names as the author spelled them, for every message below
    do DbParamCheck                                                               ! RULE 2
    do DbLoopSpan                                                                 ! the LOOP around the load, if there is one
    if ~dbWhy then do DbBufCheck.                                                 ! RULE 1, and the buffer is written only here
    if ~dbWhy and dbNextLd then do DbNextLoop.                                    !   and no loop around the next load alone brings a read back after it
    if ~dbWhy then do DbValueCheck.                                               ! RULE 3
    if ~dbWhy then do DbRuns.                                                     ! RULE 4: the load RUNS before every read
    if ~dbWhy and dbNextLd then do DbNextRuns.                                    !   and a read past the next load is that load's
    if dbWhy
      if dbRptOnly                                                                ! every site is SEEN by the report-only scan, so the
        pLog.append('BUILTIN DropLineBuffer line ' & self.LogLineOf(dbLine1) & |  !   reason logged is the one still true at the end
                    ': REFUSED - ' & clip(dbWhy) & '.<13,10>')
      end
      cycle
    end
    if dbRptOnly then cycle.                                                   ! seen and sound - the editing scan does the rest
    do DbMarkEdit
    if ~dbSetTok or ~dbGetTok or ~dbOpen or ~dbClose or ~dbGetClose or ~dbHeadTok then cycle.
    !------------------------------------------------------------------------------------------
    ! THE EDIT. Rename first - SetTok moves nothing - then the structural rewrite, highest
    ! token first so an earlier splice does not move a later one.
    !------------------------------------------------------------------------------------------
    do DbRename
    dbSplitClip = 0 ; if dbReadClips then do DbSplitClips.                     ! a clipping read: does the split clip too?
    if dbReadClips and ~dbSplitClip                                            ! it does not, so the object is clipped after
      do DbClipLine                                                            !   the load: on a line of its own when the load
      if ~dbInd._DataEnd                                                       !   stands alone on its line, else on the same
        dbTail = ' ; ' & clip(dbRecvTxt) & '.clip()'                           !   line - a FRAGMENT, not a line start
        self.tk.InsertString(dbClose + 1, clip(dbTail), 1)                     !   (pMid = 1), clipped: dbTail is fixed-length
      else
        dbInd.append(clip(dbRecvTxt) & '.clip()')
        self.tk.InsertString(dbClose + 1, dbInd, 1)
      end
    end
    self.tk.DeleteToks(dbGetClose + 1, dbClose)                                ! the ')' setValue no longer needs, and the
    self.tk.DeleteToks(dbGetHead, dbOpen)                                      !   `, st:clip` before it; then the source's
    if dbMerged                                                                !   name, its dot, getLine and its '('
      self.tk.SetTok(dbSetTok, clip(dbRecvTxt) & '.setValueFromLine')          ! one token carried both halves
    else
      self.tk.SetTok(dbSetTok, 'setValueFromLine')                             ! three tokens: the tail here, and
      self.tk.SetTok(dbHeadTok, clip(dbRecvTxt))                               !   the head two back
    end
    if not self.syms &= NULL then self.syms.dirty = 1.
    dbTail = choose(~dbReadClips, '', choose(dbSplitClip = 1,                  |
             ' - its split clips already, so the st:clip on the load went',    |
             ' - clipped after the load, since its split does not clip'))
    pLog.append('BUILTIN DropLineBuffer line ' & self.LogLineOf(dbSetTok) &    |
                ': ' & clip(dbBufTxt) & ' only ever held one line of '    &    |
                clip(dbRecvTxt) & ', so ' & clip(dbRecvTxt)               &    |
                ' holds it itself now' & clip(dbTail) & '.<13,10>')
    dbEdited = 1
    exit
  end

! ---- THE SHAPE, EXACTLY: `buf.setValue(` then `recv.getLine(...)` then `)` or `, st:clip)`. Finding
!      the two names somewhere on the line is not enough: `line.setValue('[' & clip(src.getLine(x)) &
!      ']')` holds both, and the edit below would cut the expression around the line away. A load of
!      anything but the line itself is not this shape, and the line is passed over as any other is.
DbShape routine
  dbShapeOk = 0
  loop dbX = 1 to dbSRow - 1                                                      ! no IF, LOOP, CASE, OF or ELSE in front of the load
    get(dbQ, dbX)                                                                 !   on its line: in a one-line IF it may not run
    if errorcode() then break.
    get(self.tk.tokens, dbQ.tk)
    if ~errorcode() and (self.tk.tokens.level = '+' or self.tk.tokens.level = '/') then exit.
  end
  get(dbQ, dbSRow + 1)
  if errorcode() or dbQ.tx <> '(' then exit.
  get(dbQ, dbGRow)
  if errorcode() then exit.
  if pLog.findByte(46,1,,dbQ.tx)                                                  ! recv.getLine as one token  ! <dot>
    if dbGRow <> dbSRow + 2 then exit.
  else                                                                            ! recv . getLine
    if dbGRow <> dbSRow + 4 then exit.
  end
  get(dbQ, dbGRow + 1)
  if errorcode() or dbQ.tx <> '(' then exit.
  dbZ = 0
  loop dbX = dbGRow + 1 to records(dbQ)                                           ! getLine's own ')'
    get(dbQ, dbX)
    if errorcode() then exit.
    if dbQ.tx = '(' then dbZ += 1.
    if dbQ.tx = ')'
      dbZ -= 1
      if ~dbZ then break.
    end
  end
  if dbZ then exit.
  get(dbQ, dbX + 1)
  if errorcode() then exit.
  if dbQ.tx = ')'                       ! THE SHAPE SAYS WHETHER THE LOAD CLIPS: a st:clip elsewhere on
    dbShapeOk = 1 ; dbReadClips = 0     !   the line - `; lb.setValue(name, st:clip)` - is another
    exit                                !   statement's, and the load does not clip
  end
  if dbQ.tx <> ',' then exit.
  get(dbQ, dbX + 2)
  if errorcode() or dbQ.tx <> 'ST:CLIP' then exit.
  get(dbQ, dbX + 3)
  if errorcode() or dbQ.tx <> ')' then exit.
  dbShapeOk = 1 ; dbReadClips = 1

! ---- the tokens of ONE physical line, uppercased, into dbQ
DbFill routine
  free(dbQ)
  dbNext = 0
  loop dbX = dbFrom to records(self.tk.tokens)
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dbNext = dbX + 1 ; break
    end
    if dbX > dbFrom and self.tk.tokens.firstOnLine
      dbNext = dbX ; break
    end
    dbQ.tx = upper(self.tk.tokens.tok)
    dbQ.tk = dbX
    add(dbQ)
  end
  if ~dbNext then dbNext = records(self.tk.tokens) + 1.

! ---- dbFound = the dbQ row whose DOT-TAIL is dbWant, or 0
DbFind routine
  dbFound = 0
  loop dbY = 1 to records(dbQ)
    get(dbQ, dbY)
    if errorcode() then break.
    dbN = len(clip(dbQ.tx))
    if ~dbN then cycle.
    dbD = instring('.', dbQ.tx[1 : dbN], 1, 1)
    if dbD and dbD < dbN
      if dbQ.tx[dbD + 1 : dbN] = dbWant then dbFound = dbY ; break.
    else
      if dbQ.tx = dbWant then dbFound = dbY ; break.
    end
  end

! ---- dbHead = the RECEIVER in front of the token at dbHeadIx
DbHead routine
  dbHead = ''
  get(dbQ, dbHeadIx)
  if errorcode() then exit.
  dbN = len(clip(dbQ.tx))
  if ~dbN then exit.
  dbD = instring('.', dbQ.tx[1 : dbN], 1, 1)
  if dbD > 1
    dbHead = dbQ.tx[1 : dbD - 1]
    exit
  end
  if dbHeadIx < 3 then exit.
  get(dbQ, dbHeadIx - 1)
  if errorcode() or dbQ.tx <> '.' then exit.
  get(dbQ, dbHeadIx - 2)
  if ~errorcode() then dbHead = dbQ.tx.

! ---- the procedure, and the end of its HEADER. A name declared at or before dbScCode came out
!      of the parameter list; one declared after it is a local. Depth-matching the header's
!      brackets rather than stopping at its first line feed is what makes a WRAPPED prototype
!      answer the same as a single-line one.
DbScope routine
  dbScFirst = 0 ; dbScLast = 0 ; dbScCode = 0
  dbSc = self.syms.ScopeContaining(dbLine1, vs:scProc, vs:scMethod)
  if ~dbSc then exit.
  self.syms.scopes.scopeId = dbSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  dbScFirst = self.syms.scopes.startTok
  dbScLast  = self.syms.scopes.endTok
  dbSelfU   = self.syms.scopes.selfClass
  dbZ = 0
  loop dbX = dbScFirst to records(self.tk.tokens)
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      dbZ += 1
    elsif self.tk.tokens.tok = ')'
      dbZ -= 1
      if ~dbZ then dbScCode = dbX ; break.
    elsif ~dbZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dbScCode = dbX ; break ! a prototype with no bracket at all
    end
  end
  if ~dbScCode then dbScCode = dbScFirst.

! ---- RULE 2: neither name may be a PARAMETER. The source may not be a reference either (its value
!      is the object's it points at), and neither may be named in a method of a class the procedure
!      declares: such a method shares the procedure's data and runs where the walks here never look.
!      Nor may the source be reached under another name - a reference taken on it, a call that may
!      keep one - which could read its value while it holds one line, or be given Stream(), whose file
!      would receive each line the drop loads into it.
!      Nor may the procedure INCLUDE a file: the included code is not in this file either.
!      Nor may the buffer be given Stream(): after the drop its file would be the source's, and
!      would receive the values the source holds as well as the lines.
DbParamCheck routine
  dbZ = self.syms.FindOwn(dbRecv, dbSc)
  if ~dbZ
    dbWhy = clip(dbRecv) & ' is not declared in this procedure, so whether it belongs to the' & |
            ' caller cannot be told from here'
    exit
  end
  get(self.syms.syms, dbZ)
  if errorcode() then dbWhy = clip(dbRecv) & ' is not declared in this procedure' ; exit.
  if self.syms.syms.declTok > dbScFirst and self.syms.syms.declTok <= dbScCode
    dbWhy = clip(dbRecvTxt) & ' is a parameter, and the caller may have given it Stream() - then its file would receive each line the drop loads into it'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then dbWhy = clip(dbRecvTxt) & ' is not a StringTheory' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    dbWhy = clip(dbRecvTxt) & ' is STATIC or THREAD - its value lasts to the next call, which would find one line in it'
    exit
  end
  if self.syms.syms.isRef
    dbWhy = clip(dbRecvTxt) & ' is a reference - its value belongs to the object it points at, which this procedure does not own'
    exit
  end
  if self.MayHaveLocalMethods(dbSc) and self.UsedInLocalMethods(upper(dbRecv), dbScFirst, dbScLast)
    dbWhy = clip(dbRecvTxt) & ' is used in a method of a class this procedure declares, which could read its value after the drop'
    exit
  end
  if ~dbWhy then dbWhy = self.ObjReach(dbRecv, dbLine1, 7).
  if dbWhy then exit.
  dbZ = self.syms.FindOwn(dbBuf, dbSc)
  dbBufDecl = 0
  if ~dbZ then dbWhy = clip(dbBuf) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, dbZ)
  dbBufDecl = self.syms.syms.declTok
  if errorcode() or (self.syms.syms.declTok > dbScFirst and self.syms.syms.declTok <= dbScCode)
    dbWhy = clip(dbBuf) & ' is a PARAMETER, so it is not this procedure''s to remove'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then dbWhy = clip(dbBufTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then dbWhy = clip(dbBufTxt) & ' is a reference - what it points at is not this procedure''s to leave unloaded'.
  if ~dbWhy and self.MayHaveLocalMethods(dbSc) and self.UsedInLocalMethods(upper(dbBuf), dbScFirst, dbScLast)
    dbWhy = clip(dbBufTxt) & ' is used in a method of a class this procedure declares, which would find it never loaded'
  end
  if ~dbWhy then dbWhy = self.RenameTypeWhy(dbBuf, dbRecv, dbSc).
  if ~dbWhy and self.ScopeIncludes(dbSc)
    dbWhy = clip(dbRecvTxt) & ' and ' & clip(dbBufTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
  end
  if ~dbWhy then dbWhy = self.ObjReach(dbBuf, dbLine1, 2).

! ---- RULE 1: the buffer may READ and CHANGE its VALUE freely - after the drop that value is the
!      source's, and rule 3 makes it free to clobber. What it may not do is anything that reaches its
!      LINES QUEUE, which after the drop would be the source's queue and the loop's own truth: the
!      splits, sort, addLine, setLine, deleteLine, removeLines, freeLines, free with a lines argument,
!      setValue with st:lines or an option that may hold it (LinesOptAt), swap, and the lines
!      property itself. Nor may it be handed BARE to a
!      call, which could split it, or be assigned by reference - except as the last argument of the
!      source's own setLine(n, buf), the store that closes the load / change / store shape: the
!      rename makes that src.setLine(n, src), and a rule spells it setLineFromValue(n). Reads of the
!      queue are not refused: a queue nothing wrote to is empty, and a read of it is code nobody
!      writes. The rule of 11 Sep 2026.
DbBufCheck routine
  dbLastRd = 0 ; dbNextLd = 0 ; dbSeenLd = 0 ; dbLoopLd = 0
  dbFrom = dbScFirst
  loop while dbFrom > 0 and dbFrom < dbScLast
    dbWalk = dbFrom
    do DbFill
    if dbWalk = dbBufDecl then dbFrom = dbNext ; cycle. ! its own declaration is its name, bare, and not a use of it
    dbMention = 0
    loop dbX = 1 to records(dbQ)
      dbHeadIx = dbX ; do DbHead
      get(dbQ, dbX)
      if dbHead = dbBuf or dbQ.tx = dbBuf then dbMention = 1 ; break.
    end
    if ~dbMention
      dbFrom = dbNext ; cycle
    end
    if dbWalk < dbLine1                                 ! a read before the load would see the source's value, not the last line -
      do DbIsLoad                                       !   unless a load of its own came first, whose read it is (SameReport loads
      if dbMention                                      !   its buffer in three loops; the second's reads are not the third's hazard)
        dbSeenLd = 1
        if dbLoopS and dbWalk >= dbLoopS then dbLoopLd = 1.
      elsif ~dbSeenLd
        dbWhy = clip(dbBufTxt) & ' is used before the load, on line ' & self.LogLineOf(dbWalk)
        exit
      elsif dbLoopS and dbWalk >= dbLoopS and ~dbLoopLd
        dbWhy = clip(dbBufTxt) & ' is used on line ' & self.LogLineOf(dbWalk) & ', above the load in its loop, which runs it again after the load'
        exit
      end
    end
    if dbWalk > dbLine1 and ~dbNextLd                   ! DbRuns walks from the site to the last of these - up to the
      do DbIsLoad                                       !   next LOAD of the buffer, whose reads are that site's, not this
      if dbMention                                      ! a load is a SITE of its own only when it loads a LINE: any other
        dbWant = 'GETLINE' ; do DbFind                  !   set - `of 'ANY' ; buf.setValue('?')` - changes this load's value,
        if ~dbFound then dbMention = 0.                 !   and the rename has to follow it
      end
      if dbMention                                      !   one's (SameReport loads its buffer in three loops)
        dbNextLd = dbWalk
      else
        dbLastRd = dbWalk
      end
    end
    if dbWalk = dbLine1 or dbWalk = dbNextLd
      do DbAhead
      if dbWhy then exit.
    end
    do DbBufTail
    if dbWhy then break.
    dbFrom = dbNext
  end

! ---- dbMention = the line in hand LOADS the buffer: <buf>.setValue(...) as its first call
!      - and not one that reads the buffer itself: `buf.setValue(upper(buf.getValue()))` CHANGES the value the
!      load gave it, so the reads after it are still this load's, and the rename has to reach them
DbIsLoad routine
  dbMention = 0
  dbWant = 'SETVALUE' ; do DbFind ! either spelling: lb.setValue or lb . setValue
  if ~dbFound then exit.
  dbHeadIx = dbFound ; do DbHead
  if dbHead = dbBuf then dbMention = 1.
  if ~dbMention then exit.
  loop dbY = dbFound + 1 to records(dbQ)
    dbHeadIx = dbY ; do DbHead
    get(dbQ, dbY)
    if errorcode() then break.
    if dbHead = dbBuf or dbQ.tx = dbBuf then dbMention = 0 ; break.
  end

! ---- a load's own line - the site's, or the next load's: the buffer named IN FRONT OF the load,
!      after a ';', runs before it. On the site's line that is a read before the load, which the
!      lines above are refused for too; on the next load's line it reads this load's line, and the
!      rename that follows the drop stops short of that line, so it would read a buffer nothing
!      loads any more
DbAhead routine
  dbWant = 'SETVALUE' ; do DbFind
  if ~dbFound then exit.
  get(dbQ, dbFound)
  if pLog.findByte(46, 1,, dbQ.tx) then dbZ = dbFound else dbZ = dbFound - 2.
  loop dbY = 1 to dbZ - 1
    dbHeadIx = dbY ; do DbHead
    get(dbQ, dbY)
    if errorcode() then break.
    if dbHead <> dbBuf and dbQ.tx <> dbBuf then cycle.
    if dbWalk = dbLine1
      dbWhy = clip(dbBufTxt) & ' is used before the load, on line ' & self.LogLineOf(dbWalk)
    else
      dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbWalk) & ' in front of the next load there,' & |
              ' which the rename after the drop does not reach'
    end
    break
  end

! ---- every mention of the buffer on this line, judged by rule 1
DbBufTail routine
  loop dbX = 1 to records(dbQ)
    dbHeadIx = dbX ; do DbHead                        ! (repositions dbQ - so the row is fetched AFTER it)
    get(dbQ, dbX)
    if errorcode() then break.
    dbN = len(clip(dbQ.tx))
    if ~dbN then cycle.
    if dbHead = dbBuf                                 ! <buf>.<tail> - a method or a property
      dbD = instring('.', dbQ.tx[1 : dbN], 1, 1)
      if dbD and dbD < dbN
        dbTail = dbQ.tx[dbD + 1 : dbN]
      else
        dbTail = dbQ.tx                               ! split dotted form: the tail is this token
      end
      do DbCallArgs
      if dbTail = 'FREE'
        if ~dbArgs then cycle.                        ! free() clears the value; free(true) frees the lines
        dbTail = 'FREE(...)'
      elsif dbTail = 'SETVALUE' or dbTail = 'APPEND' or dbTail = 'PREPEND'
        if ~dbLinesOpt then cycle.                    ! setValue(x, st:lines) copies x's lines in
        dbTail = clip(dbTail) & choose(dbLinesOpt = 1, '(..., ST:LINES)', '(..., AN OPTION THAT MAY BE ST:LINES)')
      elsif ~instring(' ' & clip(dbTail) & ' ', dbLinesWr, 1, 1)
        cycle                                         ! a read or a change of the VALUE - allowed
      end
      dbWhy = clip(dbBufTxt) & '.' & lower(clip(dbTail)) & ' on line ' & self.LogLineOf(dbWalk) & |
              ' writes its lines, and after the drop those would be ' & clip(dbRecvTxt) & '''s lines'
      exit
    end
    if dbQ.tx <> dbBuf then cycle.                    ! neither dotted nor bare
    get(dbQ, dbX + 1)
    if ~errorcode() and dbQ.tx = '.' then cycle.      ! the head of a split dotted form - its tail is judged above
    if ~errorcode() and dbQ.tx = '&='
      dbWhy = clip(dbBufTxt) & ' is assigned by reference on line ' & self.LogLineOf(dbWalk)
      exit
    end
    get(dbQ, dbX - 1)
    if ~errorcode() and dbQ.tx = '&='
      dbWhy = 'something is assigned by reference to ' & clip(dbBufTxt) & ' on line ' & self.LogLineOf(dbWalk)
      exit
    end
    do DbStoreBack
    if dbBareOk then cycle.                           ! <recv>.setLine(n, <buf>) - the store that closes the shape
    ! the callee only reads it, by its summary (ruled 14 Sep 2026)
    get(dbQ, dbX)
    if self.ArgReadsOnly(dbQ.tk, dbSelfU) then cycle.
    dbWhy = clip(dbBufTxt) & ' is passed bare to a call on line ' & self.LogLineOf(dbWalk) & |
            ' - the callee could write its lines'
    exit
  end

! ---- the argument list of the call whose name sits at dbX: is there one at all, and may it carry
!      st:lines - the word, or an option that may hold it (LinesOptAt: 1, 2)? dbX is the row holding
!      the TAIL, in either spelling, so the '(' is next. The list is read from the token stream to
!      its own ')': dbQ holds one physical line, and a call wrapped with '|' carries its arguments on
!      to the next
DbCallArgs routine
  dbArgs = 0 ; dbLinesOpt = 0
  get(dbQ, dbX)
  if errorcode() or self.tk.GetTok(dbQ.tk + 1) <> '(' then exit.
  dbZ = 1
  loop dbY = dbQ.tk + 2 to records(self.tk.tokens)
    case upper(self.tk.GetTok(dbY))
    of ''
      cycle
    of '<10>'
      break
    of '('
      dbZ += 1
    of ')'
      dbZ -= 1
      if ~dbZ then break.
    end
    dbArgs = 1
  end
  if dbArgs then dbLinesOpt = self.LinesOptAt(dbQ.tk).

! ---- dbBareOk = 1 when the bare mention at dbX is the LAST argument of the source's own setLine:
!      <recv>.setLine( n , <buf> ) - the row before it a comma, the row after it the closing
!      bracket, and the nearest call name before it setLine on the source. The rename makes it
!      src.setLine(n, src), which a shipped rule spells src.setLineFromValue(n).
DbStoreBack routine
  dbBareOk = 0
  get(dbQ, dbX - 1)
  if errorcode() or dbQ.tx <> ',' then exit.
  get(dbQ, dbX + 1)
  if errorcode() or dbQ.tx <> ')' then exit.
  loop dbZ = dbX - 2 to 1 by -1
    get(dbQ, dbZ)
    if errorcode() then break.
    dbN = len(clip(dbQ.tx))
    if ~dbN then cycle.
    dbD = instring('.', dbQ.tx[1 : dbN], 1, 1)
    if dbD and dbD < dbN
      dbTail = dbQ.tx[dbD + 1 : dbN]
    else
      dbTail = dbQ.tx
    end
    if dbTail <> 'SETLINE' then cycle.
    dbHeadIx = dbZ ; do DbHead
    if dbHead = dbRecv then dbBareOk = 1.
    break
  end

! ---- does the source's split carry st:clip? Then its lines sit clipped in the queue already, and a
!      clipping read's own st:clip was doing nothing. EVERY split of the source must clip, and each
!      by its OWN fifth argument, pClip: in split(',', '"', '"', st:clip) it is pRemoveQuotes, and a
!      st:clip after a ';' on the split's line belongs to another statement.
DbSplitClips routine
  dbSplitClip = 0 ; dbSpAny = 0 ; dbSpAll = 1
  dbFrom = dbScFirst
  loop while dbFrom > 0 and dbFrom < dbScLast
    do DbFill
    dbWant = 'SPLIT' ; do DbFind
    if dbFound
      dbHeadIx = dbFound ; do DbHead
      if dbHead = dbRecv
        dbSpAny = 1
        dbSpOk = 0 ; dbSpD = 0 ; dbSpC = 0
        loop dbSpI = dbFound + 1 to records(dbQ)
          get(dbQ, dbSpI)
          if errorcode() then break.
          if dbQ.tx = '('
            dbSpD += 1
          elsif dbQ.tx = ')'
            dbSpD -= 1
            if dbSpD <= 0 then break.
          elsif dbSpD = 1 and dbQ.tx = ','
            dbSpC += 1
          elsif dbSpD = 1 and dbQ.tx = 'ST:CLIP' and dbSpC = 4
            dbSpOk = 1
          end
        end
        if ~dbSpOk then dbSpAll = 0.
      end
    end
    dbFrom = dbNext
  end
  dbSplitClip = choose(dbSpAny = 1 and dbSpAll = 1)

! ---- RULE 3: the source's VALUE must be dead from here on, OR rebuilt by a later join(). A join
!      the later reads rely on must be sure to run: at the procedure's top level, not in a routine,
!      and with no GOTO from the top of the loop around the load to the join, which could jump past
!      it (a BREAK or CYCLE leads to it; a RETURN ends the local)
DbValueCheck routine
  dbJoined = 0 ; dbJoinAt = 0 ; dbJoinUsed = 0
  dbFrom = dbLine1 ; do DbFill                                                     ! the load's own line: nothing after the load reads it
  dbOwnN = 0 ; dbZ = 0
  loop dbX = dbSRow + 1 to records(dbQ)                                            ! the statements after it: the load is done
    get(dbQ, dbX)                                                                  !   by the first ; that follows it
    if dbQ.tx = ';' then dbZ = dbX ; break.
  end
  loop dbX = dbZ + 1 to records(dbQ)
    if ~dbZ then break.
    dbHeadIx = dbX ; do DbHead
    get(dbQ, dbX)
    if dbHead = dbRecv then dbOwnN += 1 ; cycle.
    if dbQ.tx <> dbRecv or dbHead then cycle.
    get(dbQ, dbX + 1)
    if errorcode() or dbQ.tx <> '.' then dbOwnN += 1.                              !   a bare mention, not the head of a split form
  end
  if dbOwnN
    dbWhy = clip(dbRecvTxt) & ' is used again on the load''s own line, which after the drop would read the line'
    exit
  end
  dbFrom = choose(~dbLoopS, dbSiteNext, dbLoopS)                                   ! in a loop, from its top: the next pass runs it
  loop while dbFrom > 0 and dbFrom < dbScLast
    if dbFrom = dbLine1 then dbFrom = dbSiteNext.
    do DbFill
    loop dbX = 1 to records(dbQ)
      dbHeadIx = dbX ; do DbHead
      get(dbQ, dbX)
      if dbQ.tx = dbRecv and ~dbHead                                               ! the source bare: handed whole, its value read
        get(dbQ, dbX + 1)
        if ~errorcode() and dbQ.tx = '.' then cycle.                               !   (or the head of a split dotted form)
        if dbFrom < dbLine1 or dbFrom <= dbLastRd or ~dbJoined
          dbWhy = clip(dbRecvTxt) & ' is handed whole on line ' & self.LogLineOf(dbFrom) & ', and after the drop its value would be one line'
          exit
        end
        do DbRtRead ; if dbWhy then exit.
        dbJoinUsed = 1
        cycle
      end
      if dbHead <> dbRecv then cycle.
      get(dbQ, dbX)
      dbN = len(clip(dbQ.tx))
      if ~dbN then cycle.
      dbD = instring('.', dbQ.tx[1 : dbN], 1, 1)
      if dbD and dbD < dbN
        dbTail = dbQ.tx[dbD + 1 : dbN]
      else
        dbTail = dbQ.tx                                                            ! SPLIT dotted form: the TAIL is this token
      end
      if dbTail = 'SETVALUEFROMLINE' and dbFrom <= dbLastRd and ~dbJoined          ! after the drop its value is the buffer's
        dbWhy = clip(dbRecvTxt) & '.setValueFromLine on line ' & self.LogLineOf(dbFrom) & ' loads its value before the last read of ' & clip(dbBufTxt) & ', which after the drop would read that line'
        exit
      end
      case dbTail
      of 'RECORDS' orof 'GETLINE' orof 'GETLINES' orof 'INLINE' orof 'SETVALUEFROMLINE' orof 'SETLINE' orof 'ADDLINE' orof 'DELETELINE' orof 'REMOVELINES' orof 'SORT' orof 'FREELINES' ! line reads: the value does not matter
      of 'JOIN'
        if dbFrom < dbLine1 or dbFrom <= dbLastRd
          dbWhy = clip(dbRecvTxt) & ' is joined on line ' & self.LogLineOf(dbFrom) & ', where after the drop it would change what ' & clip(dbBufTxt) & ' reads'
          exit
        end
        if ~dbJoined then dbJoinAt = dbFrom ; dbJoinTk = dbQ.tk.
        dbJoined = 1                                                               ! split / change / JOIN: the value is
      else                                                                         !   rebuilt from the lines, so clobbering
        if ~dbJoined or dbFrom < dbLine1 or dbFrom <= dbLastRd                     !   it in between is the POINT
          dbWhy = 'the value of ' & clip(dbRecv) & ' is used as ' & clip(dbTail) & |
                  ' after this, and nothing joins it back from its lines'
          exit
        end
        do DbRtRead ; if dbWhy then exit.
        dbJoinUsed = 1
      end
    end
    if dbWhy then break.
    dbFrom = dbNext
  end
  if dbWhy or ~dbJoinUsed then exit.
  if self.syms.ScopeContaining(dbLine1, vs:scRoutine, vs:scRoutine) or self.syms.ScopeContaining(dbJoinAt, vs:scRoutine, vs:scRoutine)
    dbWhy = 'the join on line ' & self.LogLineOf(dbJoinAt) & ' or the load is in a routine, so the reads of ' & clip(dbRecvTxt) & ' after it may run without it'
    exit
  end
  dbDepth = 0
  loop dbX = dbScCode + 1 to dbJoinTk - 1                                          ! a join the later reads rely on must be sure
    get(self.tk.tokens, dbX)                                                       !   to run: at the procedure's top level
    if errorcode() then break.
    if self.tk.tokens.level = '+' then dbDepth += 1.
    if self.tk.tokens.level = '-' then dbDepth -= 1.
  end
  if dbDepth
    dbWhy = 'the join of ' & clip(dbRecvTxt) & ' on line ' & self.LogLineOf(dbJoinAt) & ' is inside a structure, and a read of its value after it may run without it'
  end
  if dbWhy then exit.
  loop dbX = choose(~dbLoopS, dbLine1, dbLoopS) to dbJoinAt - 1
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'GOTO' then cycle.
    dbWhy = 'line ' & self.LogLineOf(dbX) & ' can jump past the join of ' & clip(dbRecvTxt) & ' on line ' & |
            self.LogLineOf(dbJoinAt) & ', and a read of its value after the join would then see one line'
    break
  end

! ---- a value read in a routine runs where the routine's DO is, not where its body lies: it is after the join only
!      when every DO of that routine is past the join and in no routine itself (a routine DOne from another one runs
!      wherever that one's DO is)
DbRtRead routine
  dbRt = self.syms.ScopeContaining(dbFrom, vs:scRoutine, vs:scRoutine)
  if ~dbRt then exit.
  self.syms.scopes.scopeId = dbRt
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then dbWhy = 'a read of ' & clip(dbRecvTxt) & ' on line ' & self.LogLineOf(dbFrom) & ' is in a routine that cannot be placed' ; exit.
  dbRtN = upper(self.tk.GetTok(self.syms.scopes.startTok))
  loop dbRtX = dbScCode + 1 to dbScLast - 1
    get(self.tk.tokens, dbRtX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'DO' then cycle.
    if upper(self.tk.GetTok(dbRtX + 1)) <> dbRtN then cycle.
    if dbRtX < dbJoinTk or self.syms.ScopeContaining(dbRtX, vs:scRoutine, vs:scRoutine)
      dbWhy = clip(dbRecvTxt) & '''s value is read on line ' & self.LogLineOf(dbFrom) & ' in ' & clip(dbRtN) &                        |
              ', DOne on line ' & self.LogLineOf(dbRtX) & ', where it may run before the join; after the drop it would read one line'
      exit
    end
  end

! ---- past the next load of the buffer, every read must be one the load before it is sure to have run for:
!      the rename stops at that load, so a read it may skip still saw THIS load's line, which the drop takes away
DbNextRuns routine
  dbZ = dbNextLd   ! the load the reads below it belong to
  dbFrom = dbNextLd ; do DbFill
  dbFrom = dbNext
  loop while dbFrom > 0 and dbFrom < dbScLast
    dbWalk = dbFrom
    do DbFill
    dbMention = 0
    loop dbX = 1 to records(dbQ)
      dbHeadIx = dbX ; do DbHead
      get(dbQ, dbX)
      if dbHead = dbBuf or dbQ.tx = dbBuf then dbMention = 1 ; break.
    end
    if dbMention
      do DbIsLoad
      if dbMention
        dbZ = dbWalk
      else
        do DbNextDom
        if dbWhy then exit.
      end
    end
    dbFrom = dbNext
  end

! ---- a LOOP or ACCEPT that holds the next load but not the site runs its lines above the next load
!      again after it. A read of the buffer there, renamed to the source by the drop, would read
!      this load's line on every turn, where it read the line the next load left in the buffer -
!      and the next load, which is not always the shape the drop converts, keeps filling the buffer
DbNextLoop routine
  dbDepth = 0 ; dbZ = 0
  loop dbX = dbNextLd - 1 to dbLine1 by -1
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      dbDepth += 1
    of '+'
      if dbDepth
        dbDepth -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        dbZ = dbX
      end
    end
  end
  if ~dbZ or ~dbLastRd then exit.
  if self.FirstEolAfter(dbLastRd) < dbZ then exit.
  dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbLastRd) & ' inside the loop on line ' & self.LogLineOf(dbZ)  & |
          ', which runs it again after the next load on line ' & self.LogLineOf(dbNextLd) & ' - after the drop it would still' & |
          ' read this load''s line there'

! ---- the load at dbZ runs before the read at dbWalk: same routine, its block never ends between, no other
!      branch begins, no label offers a way in - and the load is not one arm of an EXECUTE, whose next
!      arm carries no mark the walk could see and runs without it
DbNextDom routine
  if self.syms.ScopeContaining(dbZ, vs:scRoutine, vs:scRoutine) <> self.syms.ScopeContaining(dbWalk, vs:scRoutine, vs:scRoutine)
    dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbWalk) & ' in another routine from its load on line ' & self.LogLineOf(dbZ)
    exit
  end
  dbX = self.ArmOfExecute(dbZ)
  if dbX
    dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbWalk) & ', and the load on line ' & self.LogLineOf(dbZ) & |
            ' is one arm of the EXECUTE on line ' & self.LogLineOf(dbX) & ', so the read may run without it'
    exit
  end
  dbDepth = 0                                   ! the load's own line first: dbZ is its
  loop dbX = dbZ to self.FirstEolAfter(dbZ) - 1 !   first token, and an IF, CASE or LOOP
    get(self.tk.tokens, dbX)                    !   opened on it is a one-line structure
    if errorcode() then break.                  !   the load may sit in
    if self.tk.tokens.level = '+' then dbDepth = 1 ; break.
  end
  if dbDepth > 0
    dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbWalk) & ', and the load on line ' & self.LogLineOf(dbZ) & ' is inside a one-line IF, CASE or LOOP, so it may not run'
    exit
  end
  dbDepth = 0
  loop dbX = self.FirstEolAfter(dbZ) + 1 to dbWalk - 1
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      dbDepth += 1
    elsif self.tk.tokens.level = '-'
      dbDepth -= 1
    elsif self.tk.tokens.level = '/' and dbDepth <= 0
      dbDepth = -1
    elsif self.syms.IsColOneLabel(dbX)
      dbDepth = -1
    end
    if dbDepth < 0
      dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbWalk) & ', which the load on line ' & self.LogLineOf(dbZ) & ' may not run before - it still reads this load''s line'
      exit
    end
  end

! ---- the outermost LOOP or ACCEPT around the load, or 0. A GOTO below the load that jumps back to
!      a label at or above it is the same back edge, spelled another way (GotoBackTop): the lines
!      from that label run again after the load, so the label is the top when it is the earlier
!      of the two, and the walks that start at the loop's top - rule 1's reads above the load,
!      rule 3's reads of the source - start there
DbLoopSpan routine
  dbLoopS = 0
  dbDepth = 0
  loop dbX = dbLine1 - 1 to dbScCode + 1 by -1
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.level = '-' then dbDepth += 1 ; cycle.
    if self.tk.tokens.level <> '+' then cycle.
    if dbDepth then dbDepth -= 1 ; cycle.
    if not self.tk.tokens.tok &= NULL and (upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT') then dbLoopS = dbX.
  end
  dbX = self.GotoBackTop(dbLine1, dbScFirst, dbScLast)
  if dbX and (~dbLoopS or dbX < dbLoopS) then dbLoopS = dbX.

! ---- RULE 4: the load must RUN before every read of the buffer. The reads lie between the site and
!      the last of them, so: the last read is in the site's own routine (or, like it, in none); walking
!      from the site to it, the structure holding the site never ends, no other branch of it begins, no
!      column-1 label offers a way in, and no `do` calls a routine that could change the source (a DO
!      anywhere on a line - after THEN, ELSE or a ';' as well as at its start, the load's own line
!      included); and the site is not itself one arm of an EXECUTE. Without this a load inside an IF
!      with the read after the END converted, and the read then saw the source where it had seen an
!      empty buffer.
DbRuns routine
  if ~dbLastRd
    ! Nothing reads the buffer after the load, but the edit may still ADD a statement: a load that
    ! clips, from a split that does not, has the object clipped after it. When the load is one arm
    ! of an EXECUTE that clip is another arm, and every later arm would answer to a different value.
    if dbReadClips
      dbZ = self.ArmOfExecute(dbLine1)
      if dbZ
        do DbSplitClips
        if ~dbSplitClip
          dbWhy = 'the load is one arm of the EXECUTE on line ' & self.LogLineOf(dbZ) & |
                  ', and the clip the edit puts after it would be another'
        end
      end
    end
    exit
  end
  if self.syms.ScopeContaining(dbLine1, vs:scRoutine, vs:scRoutine) <> self.syms.ScopeContaining(dbLastRd, vs:scRoutine, vs:scRoutine)
    dbWhy = clip(dbBufTxt) & ' is read on line ' & self.LogLineOf(dbLastRd) & ' in a different routine from the load, so the read may run first'
    exit
  end
  dbDepth = 0
  dbZ = self.FirstEolAfter(dbLastRd)
  loop dbX = dbLine1 + 1 to dbZ
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      dbDepth += 1
    elsif self.tk.tokens.level = '-'
      dbDepth -= 1
      if dbDepth < 0
        dbWhy = 'the structure holding the load ends on line ' & self.LogLineOf(dbX) & ', before ' & clip(dbBufTxt) & '''s read on line ' & |
                self.LogLineOf(dbLastRd) & ' - the read can run without the load'
        exit
      end
    elsif self.tk.tokens.level = '/' and ~dbDepth
      dbWhy = 'line ' & self.LogLineOf(dbX) & ' begins another branch of the structure holding the load, so ' & clip(dbBufTxt) & '''s read on line ' & |
              self.LogLineOf(dbLastRd) & ' can run without it'
      exit
    elsif self.syms.IsColOneLabel(dbX)
      dbWhy = 'a label on line ' & self.LogLineOf(dbX) & ' lies between the load and ' & clip(dbBufTxt) & '''s read on line ' & |
              self.LogLineOf(dbLastRd) & ' - the read can be reached without the load'
      exit
    elsif not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'DO'
      dbWhy = 'line ' & self.LogLineOf(dbX) & ' calls a routine between the load and ' & clip(dbBufTxt) & '''s read on line ' & |
              self.LogLineOf(dbLastRd) & ', and a routine could change ' & dbRecvTxt
      exit
    end
  end
  dbDepth = 0                                                                           ! the opener the site sits DIRECTLY inside
  loop dbX = dbLine1 - 1 to dbScCode + 1 by -1
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      dbDepth += 1
    of '+'
      if dbDepth
        dbDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          dbWhy = 'the load is one arm of the EXECUTE on line ' & self.LogLineOf(dbX) & ', and a read of ' & clip(dbBufTxt) & ' is another'
        end
        break
      end
    end
  end

! ---- the two names as the AUTHOR spelled them, for the message and for what is written back
DbNamesAsWritten routine
  dbBufTxt = dbBuf ; dbRecvTxt = dbRecv
  dbFrom = dbLine1
  loop dbX = dbFrom to records(self.tk.tokens)
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    dbN = len(clip(self.tk.tokens.tok))
    if ~dbN then cycle.
    dbD = instring('.', self.tk.tokens.tok[1 : dbN], 1, 1)
    if dbD > 1
      if upper(self.tk.tokens.tok[1 : dbD - 1]) = dbBuf  then dbBufTxt  = self.tk.tokens.tok[1 : dbD - 1].
      if upper(self.tk.tokens.tok[1 : dbD - 1]) = dbRecv then dbRecvTxt = self.tk.tokens.tok[1 : dbD - 1].
    else
      if upper(self.tk.tokens.tok[1 : dbN]) = dbBuf  then dbBufTxt  = self.tk.tokens.tok[1 : dbN].
      if upper(self.tk.tokens.tok[1 : dbN]) = dbRecv then dbRecvTxt = self.tk.tokens.tok[1 : dbN].
    end
  end

! ---- the token positions the structural rewrite needs, in the REAL stream. BOTH SPELLINGS of a
!      dotted name are handled, because both turn up: `la.setValue` can arrive as one token or as
!      `la` `.` `setValue`, and which one it is decides whether the receiver is rewritten by
!      setting the same token or a different one. Guessing that wrong renames half a call.
DbMarkEdit routine
  dbSetTok = 0 ; dbGetTok = 0 ; dbOpen = 0 ; dbClose = 0 ; dbGetClose = 0 ; dbZ = 0
  dbHeadTok = 0 ; dbGetHead = 0 ; dbMerged = 0
  loop dbX = dbLine1 to records(self.tk.tokens)
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    dbN = len(clip(self.tk.tokens.tok))
    if ~dbN then cycle.
    dbD = instring('.', self.tk.tokens.tok[1 : dbN], 1, 1)
    if ~dbSetTok
      if dbD > 1 and upper(self.tk.tokens.tok[dbD + 1 : dbN]) = 'SETVALUE' ! merged: one token carries both
        dbSetTok = dbX ; dbHeadTok = dbX ; dbMerged = 1 ; cycle
      end
      if ~dbD and upper(self.tk.tokens.tok[1 : dbN]) = 'SETVALUE' and dbX >= dbLine1 + 2
        dbSetTok = dbX ; dbHeadTok = dbX - 2 ; cycle                       ! split: head, '.', tail
      end
      cycle
    end
    if ~dbGetTok
      if dbD > 1 and upper(self.tk.tokens.tok[dbD + 1 : dbN]) = 'GETLINE'
        dbGetTok = dbX ; dbGetHead = dbX ; cycle
      end
      if ~dbD and upper(self.tk.tokens.tok[1 : dbN]) = 'GETLINE'
        dbGetTok = dbX ; dbGetHead = dbX - 2 ; cycle
      end
    end
    if dbGetTok and ~dbOpen and self.tk.tokens.tok = '(' then dbOpen = dbX ; cycle.
    if self.tk.tokens.tok = '(' then dbZ += 1.
    if self.tk.tokens.tok = ')'
      dbZ -= 1
      if dbZ < 0 then dbClose = dbX ; break.
    end
  end
  if dbGetHead < 1 then dbGetTok = 0.
  if dbHeadTok < 1 then dbSetTok = 0.
  if dbOpen then dbGetClose = self.tk.MatchLeftBracket('(', ')', dbOpen).  ! getLine's own ')': the read's st:clip, if any, follows it

! ---- every OTHER mention of the buffer becomes the source. SetTok changes text only, so
!      nothing moves and no position computed above has to be recomputed.
! ---- the clip of the loaded value goes on a line of its own, indented like the load, when the load
!      stands alone on its line: the buffer's name begins the line and the token after the setValue's
!      ')' is the line end. A trailing comment stays on the load's line, moved from the line end's
!      trivia into the text ahead of the break. dbInd is left empty when the load shares its line - a
!      one-line IF around it, a statement after it - and the clip then follows on the same line.
DbClipLine routine
  dbInd.free()
  get(self.tk.tokens, choose(~dbMerged, dbHeadTok, dbSetTok))
  if errorcode() or ~self.tk.tokens.firstOnLine then exit.
  get(self.tk.tokens, dbClose + 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok[1] <> '<10>' then exit.
  if not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(33, 1,, self.tk.tokens.strBefore) ! '!'
      dbInd.setValue(self.tk.tokens.strBefore)
      self.tk.SetStrBefore(dbClose + 1, '')
    end
  end
  self.IndentOf(choose(~dbMerged, dbHeadTok, dbSetTok), dbTmpSt)
  dbInd.append('<10>')
  dbInd.append(dbTmpSt)

DbRename routine
  ! FROM THE SITE TO THE NEXT LOAD, not the whole procedure: a buffer loaded in two loops is two
  ! sites, and renaming the second load's line made it `src.setValue(src.getLine(x))` - a shape
  ! nothing converts. Mentions before the site belong to the site before it, which renamed them.
  loop dbX = dbLine1 to choose(~dbNextLd, dbScLast, dbNextLd - 1)
    if dbX = dbBufDecl then cycle.                   ! the declaration stays for UnusedVars
    if dbX >= dbLine1 and dbX <= dbClose then cycle. ! the line being rewritten
    get(self.tk.tokens, dbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    dbN = len(clip(self.tk.tokens.tok))
    if ~dbN then cycle.
    dbD = instring('.', self.tk.tokens.tok[1 : dbN], 1, 1)
    if dbD > 1
      if upper(self.tk.tokens.tok[1 : dbD - 1]) = dbBuf
        self.tk.SetTok(dbX, clip(dbRecvTxt) & self.tk.tokens.tok[dbD : dbN])
      end
    elsif ~dbD
      if upper(self.tk.tokens.tok[1 : dbN]) = dbBuf then self.tk.SetTok(dbX, clip(dbRecvTxt)).
    end
  end
!===============================================================================================
! BUILTIN DeadTrim - a trim(), clip(), setLeft() or setRight() that has nothing to strip is
! commented out, with a marker in front of it and a line in the report saying why. The facts it
! reads: the value is a line of a split on a SINGLE SPACE with no quote argument, so it cannot
! hold a space - Split leaves nothing but the pieces between the separators, and a no-argument
! trim() or clip() strips spaces only; or the value is a line of a split that carries st:clip
! and/or st:left, which already stripped the side(s) the call would strip. Ruled 12 Sep 2026.
!
!     toks.split(' ')                          toks.split(' ')
!     loop i = 1 to toks.records()             loop i = 1 to toks.records()
!       kv.setValue(toks.getLine(i))    ->       kv.setValue(toks.getLine(i))
!       kv.trim()                              ! #Removed as unnecessary:   kv.trim()
!
! THE SITE is a load and the line right after it: kv.setValue(toks.getLine(i)), with or
! without st:clip, or toks.setValueFromLine(i); then, on the very next line and alone on it,
! kv.trim(), kv.clip(), kv.setLeft() or kv.setRight(), with no argument or the lone space as the
! alphabet. Anything else
! between them, or sharing either line, is not a site, and nothing is said about a trim that
! is not of a line just loaded. Where the source IS split on a lone space it refuses, with the
! reason: the split REMOVES the quotes (the text inside them, which can begin or end with a space,
! is then the line); the split has a quote argument at all and the call is a trim, clip or
! setRight (a quote that is never closed takes the rest of the value into the last line, its
! trailing spaces with it - a setLeft stays, as a line still never begins with a space); the
! source is split more than once (which split filled the lines cannot be told); something
! other than that split writes its lines (addLine, setLine, insertLine, the other splits, swap,
! setValue with st:lines or an option that may hold it); it is handed whole to a call (which could
! split it again); it is not
! declared in this procedure, or is a parameter (the caller's object, which a call can reach under
! another name); the source or the buffer is not a StringTheory (a class of the author's own may
! give those method names another meaning); or the trim's alphabet is not the space. A quote of
! spaces alone, or an empty one, is no quote at all, as Split reads it. A split on anything but
! the lone space is a site only when it carries st:clip or st:left. The line is commented out
! where it stands, never deleted.
!===============================================================================================
VitEngine.BuiltinDeadTrim Procedure(StringTheory pLog)
i           long,auto
s           long,auto
changes     long
dtFrom      long,auto
dtNext      long,auto
dtX         long,auto
dtY         long,auto
dtD         long,auto          ! instring scratch
dtZ         long,auto          ! DtShapeChk: the getLine row the shape expects
dtCallRow   long               ! DtShapeChk input: the dtQ row of setValue or setValueFromLine
dtGetRow    long               !   and of getLine
dtFromLine  byte               !   the load is setValueFromLine
dtShOk      byte               !   output: the load is exactly that shape
dtN         long,auto          ! length scratch
dtLine1     long,auto          ! first token of the LOAD line
dtLine2     long,auto          ! first token of the TRIM line
dtWalk      long,auto          ! first token of the line a guard is looking at
dtSplits    long               ! how many splits of the source the procedure holds
dtSplitAt   long,auto          ! the split line's first token, once the scan has passed it
dtSplitTk   long,auto          ! and the split's own token
dtMarkAt    long,auto          ! the first mention that can set the buffer's base64 flag or encoding (MarkSetterAt)
dtMarkEnc   byte,auto          !   and whether it sets the encoding
dtRt        long               ! DtSplitDom: the routine holding the load, when the split is not in it
dtRtName    STRING(vs:maxName) !   its name
dtDoN       long               !   the DOs of it
dtTo        long               ! DtDomTo: the token the split must run before
dtSpace     byte               ! one of them is on the lone space
dtUnquote   byte               ! ... and REMOVES the quotes: the text inside them, spaces and all, is the line
dtClipF     byte               ! the split carries st:clip (pClip): every line is stored without trailing spaces
dtLeftF     byte               ! ... and st:left (pLeft): without leading ones
dtQuoted    byte               ! ... and it has a quote argument: an unclosed quote keeps trailing spaces
dtArgs      STRING(96),DIM(8)  ! the split's arguments, tokens run together, for the reading
dtArgN      long
dtDepth     long
dtDecl      long               ! the source's declaration token - a bare mention that is not a use
dtSrcRef    byte               ! the source is a reference: another name for its object can write the lines
dtScFirst   long,auto
dtScLast    long,auto
dtSc        long,auto
dtWant      STRING(64)         ! DtFind input: the dot-tail to look for
dtFound     long               !   output: the dtQ row, 0 = not there
dtHeadIx    long               ! DtHead input: a dtQ row
dtHead      STRING(vs:maxName) !   output: the receiver in front of it
dtBuf       STRING(vs:maxName) ! the object trimmed, folded
dtSrc       STRING(vs:maxName) ! the object split, folded
dtBufTxt    STRING(vs:maxName) !   and as the author spelled them
dtSrcTxt    STRING(vs:maxName)
dtCall      STRING(8)          ! TRIM or CLIP
dtBufTk     long               !   and the first token of its line, the receiver, for its class
dtArg       STRING(96)         ! the trim's argument as written, blank when there is none
dtWhy       STRING(200)
dtExec      long,auto          ! the enclosing EXECUTE, when the strip line is one of its arms
dtTail      STRING(96)
prefix      StringTheory
raw         StringTheory
dtLinesWr   EQUATE(' SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN ADDLINE SETLINE INSERTLINE SWAP SETLINEFROMVALUE WRAPTEXT ')
dtQ        QUEUE,PRE(dt)
tx           STRING(96)
tk           long              ! the token this row came from
           END
dtSelfU    STRING(vs:maxName)  ! the scope's class when it is a method, for the summaries
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  self.BuildSummaries()                                                                  ! which bodies only READ a parameter - a call to one is no obstacle (ruled 14 Sep 2026)
  prefix.setValue('! #Removed as unnecessary: ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      if upper(self.rl.rules.bparmQ.name) = 'PREFIX' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        prefix.setValue(raw)
      end
    end
  end
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    dtLine1 = i
    dtFrom = dtLine1 ; do DtFill
    dtLine2 = dtNext
    do DtLoad                                                                            ! the load, and the two names
    if ~dtBuf then cycle.
    dtFrom = dtLine2                                                                     ! the next line that holds a token: a
    loop                                                                                 !   comment-only line has an EOL of its own
      do DtFill
      if records(dtQ) or ~dtNext or dtNext > records(self.tk.tokens) then break.
      dtFrom = dtNext
    end
    dtLine2 = dtFrom
    do DtTrim                                                                            ! the next line: <buf>.trim() or .clip(), alone
    if ~dtCall then cycle.
    dtWhy = ''
    do DtScope
    if ~dtScFirst then cycle.
    do DtSplitScan                                                                       ! the source's splits, and what else writes its lines
    if ~dtSpace and ~dtClipF and ~dtLeftF then cycle.                                    ! no lone-space split and no clipping one: not a site, nothing to say
    if ~dtWhy and ~dtSpace                                                               ! a flagged split: the flags must cover what the call strips
      if dtCall = 'TRIM' and ~(dtClipF and dtLeftF)
        dtWhy = 'the split of ' & clip(dtSrcTxt) & ' carries ' & choose(dtClipF = 1, 'st:clip but not st:left', 'st:left but not st:clip') & |
                ', so ' & clip(dtBufTxt) & '.trim() still has a side to strip'
      elsif (dtCall = 'CLIP' or dtCall = 'SETRIGHT') and ~dtClipF
        ! setRight() with no argument right-justifies the value in its own length: it moves trailing
        ! spaces to the front and leaves a value with none as it was, so st:clip is all it needs
        dtWhy = 'the split of ' & clip(dtSrcTxt) & ' carries st:left but not st:clip, so ' & clip(dtBufTxt) & '.' & |
                choose(dtCall = 'CLIP', 'clip() still has trailing spaces to strip', 'setRight() still has trailing spaces to move')
      elsif dtCall = 'SETLEFT' and ~dtLeftF
        dtWhy = 'the split of ' & clip(dtSrcTxt) & ' carries st:clip but not st:left, so ' & clip(dtBufTxt) & '.setLeft() still has leading spaces to strip'
      end
    end
    if ~dtWhy and dtSplits > 1
      dtWhy = clip(dtSrcTxt) & ' is split more than once in this procedure, so which split filled its lines cannot be told'
    end
    if ~dtWhy then do DtSplitDom.
    if ~dtWhy and dtUnquote
      dtWhy = 'the split of ' & clip(dtSrcTxt) & ' removes the quotes, so a line may begin or end with a space that was inside them'
    end
    if ~dtWhy and dtSpace and dtQuoted and ~dtClipF and dtCall <> 'SETLEFT'
      dtWhy = 'the split of ' & clip(dtSrcTxt) & ' has a quote argument, and a quote that is never closed' & |
              ' takes the rest of the value into the last line, trailing spaces and all'
    end
    if ~dtWhy and (dtCall = 'SETLEFT' or dtCall = 'SETRIGHT') and dtFromLine
      dtMarkAt = self.MarkSetterAt(dtBuf, dtScFirst, dtScLast, dtMarkEnc)
      if dtMarkAt
        dtWhy = clip(dtBufTxt) & '.' & choose(dtCall = 'SETLEFT', 'setLeft', 'setRight') & '() is a setValue, which clears the base64 flag and the encoding that line ' & |
                self.LogLineOf(dtMarkAt) & ' can set - and on an empty line the load keeps them'
      end
    end
    if ~dtWhy and (dtCall = 'SETLEFT' or dtCall = 'SETRIGHT') and dtArg
      dtWhy = clip(dtBufTxt) & '.' & choose(dtCall = 'SETLEFT', 'setLeft', 'setRight') & '(' & clip(dtArg) & |
         ') is not the bare call - an argument gives it a length or a padding, and only the bare call strips spaces alone'
    end
    if ~dtWhy and dtArg and dtArg <> ''' ''' and dtArg <> '''<<32>'''
      dtWhy = clip(dtBufTxt) & '.' & lower(clip(dtCall)) & '(' & clip(dtArg) & ') strips more than spaces, which a line of a lone-space split can hold'
    end
    ! NOT ONE ARM OF AN EXECUTE - the same rule again: the load above is an ALTERNATIVE to this
    ! strip, so the strip is not working on a line that load made, and commenting it out
    ! RENUMBERS every arm below it. Found 15 Sep 2026.
    if ~dtWhy
      dtExec = self.InExecute(dtLine2, dtScFirst)
      if dtExec
        dtWhy = 'the line is one arm of the EXECUTE on line ' & self.LogLineOf(dtExec) & ', and the load it would be stripping is another'
      end
    end
    if dtWhy
      pLog.append('BUILTIN DeadTrim line ' & self.LogLineOf(dtLine2) & ': REFUSED - ' & clip(dtWhy) & '.<13,10>')
      cycle
    end
    self.CommentLineStart(dtLine2, prefix.getValue())
    changes += 1
    pLog.append('BUILTIN DeadTrim line ' & self.LogLineOf(dtLine2) & ': ' & clip(dtBufTxt) & '.' & choose(dtCall = 'SETLEFT', 'setLeft', choose(dtCall = 'SETRIGHT', 'setRight', lower(clip(dtCall)))) & |
                '() has nothing to strip - ' & clip(dtBufTxt) & ' holds a line of ' & clip(dtSrcTxt)                                                                                                   & |
                choose(dtSpace = 1, ', split on a single space, so it cannot hold one.',                                                                                                                 |
                ', split with ' & choose(dtClipF = 1 and dtLeftF = 1, 'st:clip and st:left', choose(dtClipF = 1, 'st:clip', 'st:left')) & ', so it has none to strip.') & '<13,10>')
  end
  if changes then self.wantReparse = true.                                               ! the commented lines must vanish before the next scan
  if changes then pLog.append('BUILTIN DeadTrim: ' & changes & ' line(s) commented out this pass<13,10>').
  return changes

! ---- the LOAD line, in dtQ: <buf>.setValue(<src>.getLine(...)) with or without st:clip, or
!      <src>.setValueFromLine(...), and nothing else on the line. dtBuf blank = not a load.
DtLoad routine
  dtBuf = '' ; dtSrc = '' ; dtBufTxt = '' ; dtSrcTxt = ''
  dtWant = ';' ; do DtFind ; if dtFound then exit. ! two statements: the load may not be the last
  dtWant = 'SETVALUEFROMLINE' ; do DtFind
  if dtFound
    dtHeadIx = dtFound ; do DtHead
    if ~dtHead then exit.
    dtBuf = dtHead ; dtSrc = dtHead
    dtCallRow = dtFound ; dtFromLine = 1 ; do DtShapeChk
    if ~dtShOk then dtBuf = '' ; dtSrc = '' ; exit.
    do DtNames
    exit
  end
  dtWant = 'SETVALUE' ; do DtFind ; if ~dtFound then exit.
  dtCallRow = dtFound
  dtHeadIx = dtFound ; do DtHead ; if ~dtHead then exit.
  dtBuf = dtHead
  dtWant = 'GETLINE' ; do DtFind ; if ~dtFound then dtBuf = '' ; exit.
  dtGetRow = dtFound
  dtHeadIx = dtFound ; do DtHead ; if ~dtHead or dtHead = dtBuf then dtBuf = '' ; exit.
  dtSrc = dtHead
  dtFromLine = 0 ; do DtShapeChk
  if ~dtShOk then dtBuf = '' ; dtSrc = '' ; exit.
  do DtNames

! ---- THE LOAD'S SHAPE, EXACTLY: the call starts the line and is the whole of it - <buf>.setValue(
!      <src>.getLine(...) ) or the same with `, st:clip`, or <src>.setValueFromLine(...). Two names
!      anywhere on the line are not a load: `kv.setValue(left(toks.getLine(i), 20))` pads with
!      spaces, and a load inside `if c then ... .` does not always run. dtBuf blank = not a load.
DtShapeChk routine
  dtShOk = 0
  get(dtQ, 1) ; if errorcode() then exit.
  if pLog.findByte(46, 1,, dtQ.tx) then dtY = 1 else dtY = 3.             ! the call: merged row 1, or rows 1-3  ! <dot>
  if dtY = 3
    get(dtQ, 2) ; if errorcode() or dtQ.tx <> '.' then exit.
  end
  if dtY <> dtCallRow then exit.                                          ! the call is not the start of the line
  get(dtQ, dtY + 1) ; if errorcode() or dtQ.tx <> '(' then exit.
  dtD = 0                                                                 ! the call's own ')' must be the last row
  loop dtX = dtY + 1 to records(dtQ)
    get(dtQ, dtX)
    if errorcode() then exit.
    if dtQ.tx = '(' then dtD += 1.
    if dtQ.tx = ')'
      dtD -= 1
      if ~dtD then break.
    end
  end
  if dtD or dtX <> records(dtQ) then exit.
  if dtFromLine then dtShOk = 1 ; exit.                                   ! setValueFromLine(...): that is the whole shape
  get(dtQ, dtY + 2)                                                       ! setValue( then <src>.getLine( ... ) directly
  if errorcode() then exit.
  if pLog.findByte(46, 1,, dtQ.tx) then dtZ = dtY + 2 else dtZ = dtY + 4. ! <dot>
  if dtZ <> dtGetRow then exit.
  get(dtQ, dtZ + 1) ; if errorcode() or dtQ.tx <> '(' then exit.
  dtD = 0
  loop dtX = dtZ + 1 to records(dtQ)
    get(dtQ, dtX)
    if errorcode() then exit.
    if dtQ.tx = '(' then dtD += 1.
    if dtQ.tx = ')'
      dtD -= 1
      if ~dtD then break.
    end
  end
  if dtD then exit.
  if dtX + 1 = records(dtQ) then dtShOk = 1 ; exit.                       ! getLine( ... ) )
  if dtX + 3 = records(dtQ)                                               ! getLine( ... ) , st:clip )
    get(dtQ, dtX + 1) ; if errorcode() or dtQ.tx <> ',' then exit.
    get(dtQ, dtX + 2) ; if errorcode() or dtQ.tx <> 'ST:CLIP' then exit.
    dtShOk = 1
  end

! ---- the two names as the author spelled them, from the load line's own tokens
DtNames routine
  loop dtX = dtLine1 to dtLine2 - 1
    get(self.tk.tokens, dtX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    dtN = len(clip(self.tk.tokens.tok))
    if ~dtN then cycle.
    dtD = instring('.', self.tk.tokens.tok[1 : dtN], 1, 1)
    if dtD > 1
      dtTail = upper(self.tk.tokens.tok[1 : dtD - 1])
      if dtTail = dtBuf and ~dtBufTxt then dtBufTxt = self.tk.tokens.tok[1 : dtD - 1].
      if dtTail = dtSrc and ~dtSrcTxt then dtSrcTxt = self.tk.tokens.tok[1 : dtD - 1].
    elsif ~dtD
      dtTail = upper(self.tk.tokens.tok[1 : dtN])
      if dtTail = dtBuf and ~dtBufTxt then dtBufTxt = self.tk.tokens.tok[1 : dtN].
      if dtTail = dtSrc and ~dtSrcTxt then dtSrcTxt = self.tk.tokens.tok[1 : dtN].
    end
  end
  if ~dtBufTxt then dtBufTxt = dtBuf.
  if ~dtSrcTxt then dtSrcTxt = dtSrc.

! ---- the TRIM line, in dtQ: <buf>.trim() / <buf>.clip(), one optional argument, alone on the
!      line. dtCall blank = not a site.
DtTrim routine
  dtCall = '' ; dtArg = ''
  dtWant = 'TRIM' ; do DtFind
  if ~dtFound then dtWant = 'CLIP' ; do DtFind.
  if ~dtFound then dtWant = 'SETLEFT' ; do DtFind.
  if ~dtFound then dtWant = 'SETRIGHT' ; do DtFind.
  if ~dtFound then exit.
  dtHeadIx = dtFound ; do DtHead
  if dtHead <> dtBuf then exit.
  get(dtQ, dtFound)
  dtN = len(clip(dtQ.tx))
  dtD = instring('.', dtQ.tx[1 : dtN], 1, 1)
  if dtD and dtD < dtN                        ! merged: obj.trim is one token, the head row is this one
    if dtFound <> 1 then exit.
  else                                        ! split: obj . trim - three rows
    if dtFound <> 3 then exit.
  end
  get(dtQ, dtFound + 1)
  if errorcode() or dtQ.tx <> '(' then exit.
  get(dtQ, dtFound + 2)
  if errorcode() then exit.
  if dtQ.tx = ')'
    if records(dtQ) <> dtFound + 2 then exit. ! something after the call: not alone
  else
    dtArg = dtQ.tx
    get(dtQ, dtFound + 3)
    if errorcode() or dtQ.tx <> ')' then exit.
    if records(dtQ) <> dtFound + 3 then exit.
  end
  dtCall = dtWant
  get(dtQ, 1) ; dtBufTk = dtQ.tk

! ---- the procedure holding the site. What the site reads is StringTheory's own: the pieces its
!      Split makes, and a trim, clip, setLeft or setRight that strips spaces and nothing else. So the
!      source, declared here, must be a StringTheory, and the buffer whose call goes must be one by
!      the rule every receiver found by its method name answers to (RecvIsOtherClass, --receiver=);
!      a class of the author's own with methods of those names may do anything. Either refuses,
!      reported once the site is known to be one
DtScope routine
  dtScFirst = 0 ; dtScLast = 0
  dtSc = self.syms.ScopeContaining(dtLine1, vs:scProc, vs:scMethod)
  if ~dtSc then exit.
  self.syms.scopes.scopeId = dtSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  dtScFirst = self.syms.scopes.startTok
  dtScLast  = self.syms.scopes.endTok
  dtSelfU   = self.syms.scopes.selfClass
  dtDecl = 0 ; dtSrcRef = 0
  dtX = self.syms.FindOwn(dtSrc, dtSc)
  if dtX
    get(self.syms.syms, dtX)
    if ~errorcode() then dtDecl = self.syms.syms.declTok ; dtSrcRef = self.syms.syms.isRef.
    if dtDecl and self.syms.syms.typeU <> 'STRINGTHEORY' then dtWhy = clip(dtSrcTxt) & ' is not a StringTheory'.
  end
  if ~dtWhy and self.RecvIsOtherClass(dtBufTk)
    dtWhy = clip(dtBufTxt) & ' cannot be shown to be a StringTheory, whose trim, clip, setLeft and setRight strip spaces alone'
  end

! ---- every split of the source in the procedure, and everything else that reaches its lines. Two
!      writers never spell the source's name where they write: a reference taken on it with &=, which
!      outlives its statement, and a method of a class the procedure declares, which shares its data
!      and whose body lies outside this walk. Either refuses, wherever it is. So does a source that is
!      itself a reference: the object it points at has other names, and any of them can write its lines.
!      So does a parameter, for the same reason: the object is the caller's, and anything the caller
!      shares it with - a global, a call this walk does not look into - can write its lines between
!      the split and the load. So does an INCLUDE in the procedure: the included code is not in this file.
DtSplitScan routine
  dtSplits = 0 ; dtSpace = 0 ; dtUnquote = 0 ; dtClipF = 0 ; dtLeftF = 0 ; dtSplitAt = 0 ; dtSplitTk = 0
  dtQuoted = 0
  if ~dtDecl then dtWhy = clip(dtSrcTxt) & ' is not declared in this procedure, so what else writes its lines cannot be told from here'.
  if ~dtWhy and dtSrcRef then dtWhy = clip(dtSrcTxt) & ' is a reference - the object it points at has other names, and any of them can write its lines'.
  if ~dtWhy and ~self.syms.IsColOneLabel(dtDecl)
    dtWhy = clip(dtSrcTxt) & ' is a PARAMETER - the object is the caller''s, which may have other names for it, and any of them can write its lines'
  end
  if ~dtWhy and self.MayHaveLocalMethods(dtSc) and self.UsedInLocalMethods(upper(dtSrc), dtScFirst, dtScLast)
    dtWhy = clip(dtSrcTxt) & ' is used in a method of a class this procedure declares, which can write its lines from outside this walk'
  end
  if ~dtWhy and self.ScopeIncludes(dtSc)
    dtWhy = clip(dtSrcTxt) & '''s lines may be written by code the procedure INCLUDEs, which this file does not hold'
  end
  loop dtX = dtScFirst to dtScLast
    if dtWhy then break.
    get(self.tk.tokens, dtX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '&=' then cycle.
    if upper(self.tk.GetTok(dtX + 1)) = dtSrc then dtWhy = 'a reference is taken on ' & clip(dtSrcTxt) & ' on line ' & self.LogLineOf(dtX) & ', and it can write the lines without the name'.
  end
  dtFrom = dtScFirst
  loop while dtFrom > 0 and dtFrom < dtScLast
    dtWalk = dtFrom
    do DtFill
    if dtWalk = dtDecl then dtFrom = dtNext ; cycle. ! its declaration: the name, bare, and not a use
    loop dtX = 1 to records(dtQ)
      dtHeadIx = dtX ; do DtHead
      get(dtQ, dtX)
      if errorcode() then break.
      dtN = len(clip(dtQ.tx))
      if ~dtN then cycle.
      if dtHead = dtSrc                              ! <src>.<tail>
        dtD = instring('.', dtQ.tx[1 : dtN], 1, 1)
        if dtD and dtD < dtN
          dtTail = dtQ.tx[dtD + 1 : dtN]
        else
          dtTail = dtQ.tx
        end
        if dtTail = 'SPLIT'
          dtSplits += 1
          dtSplitAt = dtWalk
          dtSplitTk = dtQ.tk
          do DtSplitArgs
        elsif dtTail = 'LINES' or dtTail[1 : 6] = 'LINES.'
          if ~dtWhy then dtWhy = clip(dtSrcTxt) & '.lines on line ' & self.LogLineOf(dtWalk) & ' reaches the lines queue itself, which a statement can write'.
        elsif instring(' ' & clip(dtTail) & ' ', dtLinesWr, 1, 1)
          if ~dtWhy then dtWhy = clip(dtSrcTxt) & '.' & lower(clip(dtTail)) & ' on line ' & self.LogLineOf(dtWalk) & ' writes a line the split did not make'.
        elsif dtTail = 'SETVALUE' or dtTail = 'APPEND' or dtTail = 'PREPEND'
          get(dtQ, dtX)
          dtFound = self.LinesOptAt(dtQ.tk)
          if dtFound = 2 then dtWant = ' may copy lines in - its option may hold st:lines' else dtWant = ' copies lines in'.
          if dtFound and ~dtWhy then dtWhy = clip(dtSrcTxt) & '.' & lower(clip(dtTail)) & ' on line ' & self.LogLineOf(dtWalk) & clip(dtWant) & ', which the split did not make'.
        end
        cycle
      end
      if dtQ.tx <> dtSrc then cycle.                 ! neither dotted nor bare
      get(dtQ, dtX + 1)
      if ~errorcode() and dtQ.tx = '.' then cycle.   ! the head of a split dotted form
      ! BEFORE the split, the split then makes the lines afresh: a mention not handed to a call cannot have
      ! touched them, and a call that only reads the object or only changes it is no obstacle - but a call
      ! that may KEEP a reference to it can write the lines after the split, without the name, and so can a
      ! call the tool cannot see into (ruled 28 Oct 2026). After the split the callee must only read it, by
      ! its summary (ruled 14 Sep 2026). The token in front of the object is read from the token stream,
      ! not this line's rows: a call wrapped over a '|' puts the object first on a line of its own.
      if ~dtSplitAt
        get(dtQ, dtX)
        dtTail = self.tk.GetTok(dtQ.tk - 1)
        if dtTail <> '(' and dtTail <> ',' then cycle.
        if inlist(self.ArgFact(dtQ.tk, dtSelfU), 'R', 'W', 'P') then cycle.
        if ~dtWhy then dtWhy = clip(dtSrcTxt) & ' is handed whole to a call on line ' & self.LogLineOf(dtWalk) & ' before the split, which may keep a reference to it and write its lines later'.
        cycle
      end
      get(dtQ, dtX)
      if self.ArgReadsOnly(dtQ.tk, dtSelfU) then cycle.
      if ~dtWhy then dtWhy = clip(dtSrcTxt) & ' is handed whole to a call on line ' & self.LogLineOf(dtWalk) & ', which could split it again'.
    end
    dtFrom = dtNext
  end

! ---- the split must run before the load on every path to it: above it, no structure holding it ending
!      before the load, no other branch of one beginning, no label offering a way in - the lines the load
!      reads are then the split's, whatever came before it
DtSplitDom routine
  if ~dtSplitAt then exit.
  dtRt = self.syms.ScopeContaining(dtLine1, vs:scRoutine, vs:scRoutine)                ! a load in a routine runs where it is DOne:
  if dtRt and dtRt <> self.syms.ScopeContaining(dtSplitAt, vs:scRoutine, vs:scRoutine) !   the split must come first at every DO
    self.syms.scopes.scopeId = dtRt
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if errorcode() then dtWhy = 'the routine holding the load cannot be read' ; exit.
    dtRtName = upper(self.tk.GetTok(self.syms.scopes.startTok))
    dtDoN = 0
    loop dtY = dtScFirst to dtScLast
      get(self.tk.tokens, dtY)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL or upper(self.tk.tokens.tok) <> 'DO' then cycle.
      if upper(self.tk.GetTok(dtY + 1)) <> dtRtName then cycle.
      dtDoN += 1
      dtTo = dtY ; do DtDomTo
      if dtWhy then exit.
    end
    if ~dtDoN then dtWhy = 'nothing in this procedure DOes the routine the load is in'.
    exit
  end
  dtTo = dtLine1 ; do DtDomTo

! ---- the split runs before dtTo on every path to it
DtDomTo routine
  if dtSplitAt > dtTo
    dtWhy = 'the split of ' & clip(dtSrcTxt) & ' is on line ' & self.LogLineOf(dtSplitAt) & ', after the load, so the lines the load reads came from somewhere else'
    exit
  end
  dtDepth = 0                                                                   ! the split's own line first: an IF, CASE
  loop dtX = dtSplitTk - 1 to 1 by -1                                           !   or LOOP opened before it there and
    if self.IsEolTok(dtX) then break.                                           !   not closed is a one-line structure
    get(self.tk.tokens, dtX)                                                    !   the split may not run in
    if errorcode() then break.
    if self.tk.tokens.level = '+' then dtDepth += 1.
    if self.tk.tokens.level = '-' then dtDepth -= 1.
  end
  if dtDepth > 0
    dtWhy = 'the split of ' & clip(dtSrcTxt) & ' on line ' & self.LogLineOf(dtSplitAt) & ' is inside a one-line IF, CASE or LOOP, so it may not run'
    exit
  end
  dtDepth = 0
  loop dtX = self.FirstEolAfter(dtSplitAt) + 1 to dtTo - 1
    get(self.tk.tokens, dtX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      dtDepth += 1
    elsif self.tk.tokens.level = '-'
      dtDepth -= 1
    elsif self.tk.tokens.level = '/' and dtDepth <= 0
      dtDepth = -1
    end
    if dtDepth < 0 or self.syms.IsColOneLabel(dtX)
      dtWhy = 'the split of ' & clip(dtSrcTxt) & ' on line ' & self.LogLineOf(dtSplitAt) & ' is not on every path to the load, so its lines may come from somewhere else'
      exit
    end
  end

! ---- the arguments of the split at dtQ row dtX, read positionally: the lone space as the first;
!      the fourth, when it is given and not false, removes the quotes; a quote of spaces alone, or
!      an empty one, is no quote at all, as Split reads it, and with no quote nothing is removed. A
!      comma inside ( ), [ ] or { } is that bracket's, not one between the arguments: seps[1, 2] is
!      one argument. dtQ holds one physical line, so a split whose arguments run on over a '|' has
!      some this does not see: refused, with a reason, when the split is one this pass would
!      otherwise read the lines of
DtSplitArgs routine
  data
qb   StringTheory
  code
  clear(dtArgs) ; dtArgN = 1 ; dtDepth = 0
  get(dtQ, dtX + 1)
  if errorcode() or dtQ.tx <> '(' then exit.
  loop dtY = dtX + 2 to records(dtQ)
    get(dtQ, dtY)
    if errorcode() then break.
    if dtQ.tx = ')' and ~dtDepth then break.
    if dtQ.tx = ',' and ~dtDepth
      dtArgN += 1
      if dtArgN > 8 then break.
      cycle
    end
    case dtQ.tx
    of '(' orof '[' orof '{{'
      dtDepth += 1
    of ')' orof ']' orof '}'
      dtDepth -= 1
    end
    dtArgs[dtArgN] = clip(dtArgs[dtArgN]) & dtQ.tx
  end
  if dtY > records(dtQ) and ~dtWhy
    dtWhy = 'the split of ' & clip(dtSrcTxt) & ' on line ' & self.LogLineOf(dtWalk) & ' runs on to the next line,' & |
            ' and its arguments there - a quote that removes or keeps spaces among them - are not read here'
  end
  ! a quote of spaces is no quote: Split takes a quote start that compares equal to '' as none, and
  ! any run of spaces does, so the split is the plain one - its bytes are read, escapes and all
  if dtArgs[2] and self.LitBytes(dtArgs[2], qb)
    if ~qb.clipLength() then dtArgs[2] = ''.
  end
  if dtArgs[5] = 'ST:CLIP' or dtArgs[5] = 'TRUE' or dtArgs[5] = '1' then dtClipF = 1. ! a split that clips its lines (ruled 13 Sep 2026: a trim of
  if dtArgs[6] = 'ST:LEFT' or dtArgs[6] = 'TRUE' or dtArgs[6] = '1' then dtLeftF = 1. !   such a line strips nothing either - TrimAtSplit writes these)
  if dtArgs[1] <> ''' ''' and dtArgs[1] <> '''<<32>'''                                ! not the lone space
    if ~dtClipF and ~dtLeftF then exit.                                               !   and no flag: not this pass's split
  else
    dtSpace = 1
  end
  if dtArgs[2] and dtArgs[2] <> '''''' then dtQuoted = 1.
  if dtQuoted and dtArgs[4] and dtArgs[4] <> 'FALSE' and dtArgs[4] <> '0' then dtUnquote = 1.

! ---- the tokens of ONE physical line, uppercased, into dtQ
DtFill routine
  free(dtQ)
  dtNext = 0
  loop dtX = dtFrom to records(self.tk.tokens)
    get(self.tk.tokens, dtX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dtNext = dtX + 1 ; break
    end
    if dtX > dtFrom and self.tk.tokens.firstOnLine
      dtNext = dtX ; break
    end
    dtQ.tx = upper(self.tk.tokens.tok)
    dtQ.tk = dtX
    add(dtQ)
  end
  if ~dtNext then dtNext = records(self.tk.tokens) + 1.

! ---- dtFound = the dtQ row whose DOT-TAIL is dtWant, or 0
DtFind routine
  dtFound = 0
  loop dtY = 1 to records(dtQ)
    get(dtQ, dtY)
    if errorcode() then break.
    dtN = len(clip(dtQ.tx))
    if ~dtN then cycle.
    dtD = instring('.', dtQ.tx[1 : dtN], 1, 1)
    if dtD and dtD < dtN
      if dtQ.tx[dtD + 1 : dtN] = dtWant then dtFound = dtY ; break.
    else
      if dtQ.tx = dtWant then dtFound = dtY ; break.
    end
  end

! ---- dtHead = the RECEIVER in front of the token at dtHeadIx, in either spelling
DtHead routine
  dtHead = ''
  get(dtQ, dtHeadIx)
  if errorcode() then exit.
  dtN = len(clip(dtQ.tx))
  if ~dtN then exit.
  dtD = instring('.', dtQ.tx[1 : dtN], 1, 1)
  if dtD > 1
    dtHead = dtQ.tx[1 : dtD - 1]
    exit
  end
  if dtHeadIx < 3 then exit.
  get(dtQ, dtHeadIx - 1)
  if errorcode() or dtQ.tx <> '.' then exit.
  get(dtQ, dtHeadIx - 2)
  if ~errorcode() then dtHead = dtQ.tx.

! ------------------------------------------------------------------------------------
! May the call around the tokens pS..pE write through them? They are an object's buffer, a slice
! of it, its _DataEnd or its getValuePtr(): a callee that takes the parameter by address changes
! the object's value through it as surely as a method of the object does. Only a WHOLE argument
! counts, between '(' or ',' and ')' or ','; an expression around them hands on a copy. No
! obstacle: no call around them (a subscript, or a word such as CHOOSE that passes a value on);
! a call that only reads what it is handed - StringTheory's setValue, append, prepend and the
! rest of ReadOnlyCallAt's short list, on a StringTheory, or the runtime's MESSAGE and the like;
! a method of a StringTheory named in pRd (' SLICE SUB FINDBYTE ... '), which only reads its
! arguments; a body of this file whose summary says it only reads that parameter; a plain call on
! the pure list. The summaries are built here when a call needs one and pSm is 0, and pSm is then
! set. 1 = the call may write them.
! ------------------------------------------------------------------------------------
VitEngine.ArgMayWrite Procedure(LONG pS, LONG pE, STRING pRd, *BYTE pSm)
k    long,auto
d    long,auto
t    STRING(vs:maxName),auto
sU   STRING(vs:maxName)
rf   BYTE
  code
  t = self.tk.GetTok(pS - 1)
  if t <> '(' and t <> ',' then return 0.
  t = self.tk.GetTok(pE + 1)
  if t <> ')' and t <> ',' then return 0.
  d = 0
  loop k = pS - 1 to 1 by -1
    t = self.tk.GetTok(k)
    case t
    of '<10>'
      return 0
    of ')'    orof ']'
      d += 1
    of '('    orof '['
      if ~d then break.
      d -= 1
    end
  end
  if k < 1 or t <> '(' then return 0.
  get(self.tk.tokens, k - 1)
  if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then return 0.
  if self.ReadOnlyCallAt(k) then return 0.
  if self.tk.GetTok(k - 2) = '.' and self.syms.Lookup(self.tk.GetTok(k - 3), k - 3, t, rf)
    if upper(t) = 'STRINGTHEORY'
      t = upper(self.tk.GetTok(k - 1))
      if pRd and instring(' ' & clip(t) & ' ', pRd, 1, 1) then return 0.
    end
  end
  d = self.syms.ScopeContaining(pS, vs:scProc, vs:scMethod)
  if d
    self.syms.scopes.scopeId = d
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if ~errorcode() then sU = self.syms.scopes.selfClass.
  end
  if ~pSm then self.BuildSummaries() ; pSm = 1.
  if inlist(self.ArgFact(pS, sU), 'R', 'P') then return 0.
  return 1

! ------------------------------------------------------------------------------------
! The call whose '(' is at pParen: 1 = it only READS what it is handed, in every place, and keeps
! none of it, so a buffer, a slice of one or a length handed to it by address comes back as it
! went. Two short lists, each checked against its source:
!   - the runtime's MESSAGE, STOP, HALT and SETCLIPBOARD, whose prototypes take values only, called
!     by name alone - and not when this file gives a procedure that name (PureOwnList, as PureProc
!     asks), which may take its argument by address and write it;
!   - StringTheory 3.90's SetValue, Append, Prepend, Cat, Insert, AddLine, SetLine, ReplaceSlice,
!     Instring, Equals, StartsWith and EndsWith, each form of which takes its text by value or as a
!     *STRING it only copies or reads, and none of which writes a parameter - called on a receiver
!     that resolves to a StringTheory (HayType). A method of one of those names on another class may
!     write what it is handed.
! Most of them change their receiver: whether that matters is the caller's question.
! ------------------------------------------------------------------------------------
VitEngine.ReadOnlyCallAt Procedure(LONG pParen)
nmU  STRING(vs:maxName),auto
one  StringTheory
own  StringTheory
  code
  if self.syms &= NULL then return 0.
  if pParen < 2 or self.tk.GetTok(pParen) <> '(' then return 0.
  get(self.tk.tokens, pParen - 1)
  if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then return 0.
  nmU = upper(self.tk.tokens.tok)
  if self.tk.GetTok(pParen - 2) = '.'
    one.setValue(' SETVALUE APPEND PREPEND CAT INSERT ADDLINE SETLINE REPLACESLICE INSTRING EQUALS STARTSWITH ENDSWITH ')
    if ~one.findChars(' ' & clip(nmU) & ' ') then return 0.
    if pParen < 4 then return 0.
    return choose(self.HayType(self.tk.GetTok(pParen - 3), pParen - 3) = 'STRINGTHEORY')
  end
  if ~inlist(nmU, 'MESSAGE', 'STOP', 'HALT', 'SETCLIPBOARD') then return 0.
  one.setValue(' ' & clip(nmU) & ' ')
  self.PureOwnList(one, own)
  return choose(~own.findChars(' ' & clip(nmU) & ' '))

! ------------------------------------------------------------------------------------
! The object named at pTok stands whole as an argument: what may the call it is handed to do with its
! LINES? A StringTheory setValue, append or prepend - `<recv>.setValue(<obj>, ...)` - copies them only
! with st:lines, which LinesOptAt reads: its answer. Any other call, a procedure of the file or not, may
! read them, and so may a mention in no call at all: 2. The call is the nearest bracket the object stands
! inside, read back across a '|' continuation to the start of the line.
! ------------------------------------------------------------------------------------
VitEngine.BareArgLines Procedure(LONG pTok)
x    long,auto
dp   long
t    STRING(vs:maxName),auto
nm   STRING(vs:maxName),auto
  code
  loop x = pTok - 1 to 1 by -1
    if self.IsEolTok(x) then return 2.
    t = self.tk.GetTok(x)
    case t
    of ')' orof ']'
      dp += 1
    of '(' orof '['
      if ~dp then break.
      dp -= 1
    end
  end
  if x < 3 or self.tk.GetTok(x) <> '(' then return 2.
  t = upper(self.tk.GetTok(x - 1))
  dp = instring('.', t, -1, len(clip(t))) ! a dotted name may be one token
  if ~dp and self.tk.GetTok(x - 2) <> '.' then return 2.
  if dp = len(clip(t)) then return 2.
  if dp then nm = t[dp + 1 : len(clip(t))] else nm = t.
  if nm <> 'SETVALUE' and nm <> 'APPEND' and nm <> 'PREPEND' then return 2.
  return self.LinesOptAt(x)

! ------------------------------------------------------------------------------------
! May the setValue, append or prepend at pAt be given st:lines? Given another object and an option
! holding st:lines (4) as its second argument, each of them copies that object's lines in as well
! as its value (StringTheory 3.90). The option may be the word itself, or a variable, a parameter
! or an expression holding it, so only an option read here as a number counts as not holding it:
! a number, a string literal with no digit in it (Clarion reads that as 0), st:clip, st:noClip,
! st:noBlanks, true or false, or a sum of those joined by +. An option left out is st:noClip. The
! word st:lines anywhere among the call's own arguments counts as well. pAt is the call's '(', the
! method's name in front of it, or the receiver in front of `.name(` - a line queue that joins a
! dotted call into one row keeps the receiver's token. The arguments are read from the token stream
! to the call's own ')', so a call wrapped with '|' is read whole, and a statement after it on the
! line is not read. 0 = no st:lines, or no call there; 1 = st:lines is written, or the option is a
! number holding it; 2 = an option not read here, which may hold it.
! ------------------------------------------------------------------------------------
VitEngine.LinesOptAt Procedure(LONG pAt)
k    long,auto
q    long,auto
p    long,auto
pos  long,auto
d    long
n    long
v    long
ok   byte,auto
trm  byte,auto
t    STRING(vs:maxName),auto
  code
  p = pAt
  if self.tk.GetTok(p) <> '('
    if self.tk.GetTok(p + 1) = '('
      p += 1
    elsif self.tk.GetTok(p + 1) = '.' and self.tk.GetTok(p + 3) = '('
      p += 3
    else
      return 0
    end
  end
  pos = 1 ; ok = 1 ; trm = 1
  loop k = p + 1 to records(self.tk.tokens)
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    t = upper(self.tk.tokens.tok)
    if t = 'ST:LINES' then return 1.
    if t = ')' and ~d then break.
    if t = ',' and ~d then pos += 1 ; cycle.
    case t
    of '(' orof '[' orof '{{'
      d += 1
    end
    if (t = ')' or t = ']' or t = '}') and d then d -= 1.
    if pos <> 2 or ~ok then cycle.
    n += 1
    do LoTerm
  end
  if pos < 2 or ~n then return 0.
  if ~ok or trm then return 2.
  return choose(band(v, 4))

! ---- the token in hand is the option's next one: a term of the sum, or the + between two
LoTerm routine
  if ~trm
    if t = '+' then trm = 1 else ok = 0.
    exit
  end
  trm = 0
  case t
  of 'ST:CLIP'     orof 'TRUE'
    v += 1
  of 'ST:NOBLANKS'
    v += 2
  of 'ST:NOCLIP'   orof 'FALSE'
    ! 0
  else
    case self.tk.tokens.type
    of vt:Integer
      if numeric(clip(t)) and len(clip(t)) < 10 then v += t else ok = 0.
    of vt:literal
      if size(self.tk.tokens.tok) > size(t) then ok = 0 ; exit.
      loop q = 1 to len(clip(t))
        if t[q] >= '0' and t[q] <= '9' then ok = 0 ; break.
      end
    else
      ok = 0
    end
  end
!===============================================================================================
! BUILTIN CutToSplit - cutting a value at its first separator into a head and a tail is a
! split: the head is line 1 and the tail is the lines after it, joined again. 13 Sep 2026,
! from the rewrite of ParseSettingsLine.
!
!     p = x.findByte(32)                             x.split(' ')
!     if ~p then return.                             if x.records() < 2 then return.
!     a.setValue(x.valuePtr[1 : p - 1])        ->    a.setValue(x.getLine(1))
!     b.setValue(x.valuePtr[p + 1 : x._DataEnd])     b.setValue(x.getLines(2, 0, ' '))
!
! EXACT, from the library: findByte finds the first separator and the split cuts at every one,
! so line 1 is the text before the first and the lines from 2 on, joined by the separator with
! the empty pieces kept, are the text after it, byte for byte. No separator means one piece
! (an empty value makes one empty piece), so the test of p is a test of records(). Where the
! separator is the first or the last character the original slices have their end before their
! start, which Clarion does not allow; the rewrite answers an empty piece there.
!
! THE SITE is the cut - p = x.findByte(n) or p = x.findChar('c') - and every mention of p in
! the procedure, each of which must be one of: a test of p alone (~p, not p, p = 0, and the
! positive p, p <> 0, p > 0), the head read x.valuePtr[1 : p - 1], or the tail read
! x.valuePtr[p + 1 : x._DataEnd] (or x.slice(p + 1)). The head is never x.slice(1, p - 1) or
! x.sub(1, p - 1): with the separator first, p - 1 is 0, and an end of 0 there means "to the
! end", the whole value, where line 1 is empty. A read that is WRITTEN - the target of an
! assignment, or a whole argument a call may write through - refuses, since the line the split
! makes is a copy.
! Anything else p does - arithmetic, a second write, a call - refuses, with the line. x must be
! a StringTheory local (a parameter's lines are the caller's), its own lines not in use
! anywhere in the procedure, and its value unchanged between the cut and the last read - a change
! inside a loop that brings control back to a read counts from the top of that loop, a change with a
! GOTO after it back to a label at or above a read counts from that label, and a routine that
! changes x counts where it is called; a store through x's buffer (x.valuePtr[k] = 'c',
! x._DataEnd = n), or the buffer, a slice of it or x._DataEnd handed whole to a call that may write
! it, is a change too; p a
! LONG, ULONG, SIGNED or UNSIGNED local - a BYTE, SHORT or USHORT is too narrow for a long value's
! positions, and refuses; every read in the block the
! test guards, not in a routine, which may run before the cut. A separator that is the quote
! character cannot be spelt and refuses, and so does findByte(n) with n past 255: findByte takes a
! BYTE, and no character is code 256 or more.
! The edit rewrites the cut, the tests and the reads in place, highest position first; nothing
! moves. Two scans on pass 1, as DropLineBuffer does: the editing scan stops at its first site.
!===============================================================================================
VitEngine.BuiltinCutToSplit Procedure(StringTheory pLog)
i           long,auto
csX         long,auto
csY         long,auto
csZ         long,auto
csD         long,auto          ! instring scratch
csN         long,auto          ! length scratch
csLine1     long,auto          ! first token of the cut line
csEol       long,auto
csFrom      long,auto          ! CsFill: first token of the line in hand
csNext      long,auto          !   and of the next
csHeadIx    long               ! CsHead input
csHead      STRING(vs:maxName) !   output
csP         STRING(vs:maxName) ! the position local, folded
csX0        STRING(vs:maxName) ! the object, folded
csPTxt      STRING(vs:maxName) !   and as spelled
csXTxt      STRING(vs:maxName)
csSep       STRING(32)         ! the separator as the split will spell it: ' ' or '<n>' or the findChar literal
csScFirst   long,auto
csScLast    long,auto
csScCode    long,auto
csSc        long,auto
csLastRd    long               ! first token of the last line reading p
csWhy       STRING(200)
csRpt       byte
csEdited    byte
csSums      byte               ! CsSiteUse: the summaries are built for this call
csKind      byte               ! CsClassify: 0 = not p's, 1 = negative test, 2 = positive test, 3 = head, 4 = tail, 9 = refuse
csS         long               !   its first and last TOKEN in the real stream
csE         long
csAfter     long               ! CsClassify2: only a mention after this token counts
csLineNo    long               ! the cut line's number, read BEFORE the edit replaces its tokens
csPDecl     long               ! the declaration tokens of p and x: their names, bare, and not a use
csXDecl     long
csChgAt     long               ! the change of x after the cut that counts first - its line, or the top of a loop around it
csChgTxt    STRING(96)
csChgLn     long               !   its own line, for the report
csChgTmp    STRING(96)         ! CsChange input: what the change on the line in hand does
csEff       long               ! CsEffOf: where the line counts from - itself, or the top of a loop around it opened after the cut
csInRtn     byte               ! CsUses: the walk is in a routine after the cut
csRtnChg    byte               !   and one of those routines changes x
csDoAt      long               ! the line after the cut that calls a routine, the one counting first
csDoEff     long               !   and where it counts from
csTxt       StringTheory       ! the replacement text
csSb        StringTheory       ! the strBefore carried across a replacement
csReads     EQUATE(' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH LEN SLICE SUB CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS COUNT CLIPLENGTH ')
csLinesU    EQUATE(                                                                                                |
  ' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE ' & |
    'SETLINEFROMVALUE SETLINE ADDLINE INSERTLINE DELETELINE REMOVELINES SORT FREELINES JOIN LINES SWAP ')
csSites     QUEUE,PRE(cst)     ! every site to rewrite, in token order
kind          byte
s             long
e             long
            END
csQuoteSep  byte               ! the separator is the quote character, which a split cannot spell (1), or past 255 (2)
csGuardOk   byte               ! CsGuard: the line after the cut leaves when p is 0
csGuardEnd  long               !   the last token of that test
csBlkEnd    long               !   and the END or ELSE closing the block it guards
csIfTk      long               !   the test's IF
csNeg       byte               !   1 = the test is true when p is 0
csEndTk     long               !   a block test's own END
csLast      long               !   and the first token of its last line
csQ         QUEUE,PRE(cs)
tx            STRING(96)
tk            long             ! the real token index of this row
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  csEdited = 0
  if self.curPass = 1
    csRpt = 1 ; do CsScan
  end
  csRpt = 0 ; do CsScan
  return csEdited

! ---- every line of the file: the cut, the guards, the sites, and - unless report-only - the edit
CsScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    csLine1 = i
    csFrom = csLine1 ; do CsFill
    do CsShape
    if ~csP then cycle.
    csWhy = choose(csQuoteSep = 1, 'the separator is the quote character, which a split cannot spell', '')
    if csQuoteSep = 2 then csWhy = 'findByte(' & clip(csSep) & ') asks for a byte past 255, which no separator can spell'.
    do CsScope
    if ~csScFirst then cycle.
    do CsNames
    do CsDeclCheck
    if ~csP then cycle.        ! not a StringTheory local and an integer local: no site
    if ~csWhy then do CsUses.  ! every mention of p and of x, and the sites
    if ~csWhy then do CsGuard. ! tested at once, and every read after the test
    if csWhy
      if csRpt
        pLog.append('BUILTIN CutToSplit line ' & self.LogLineOf(csLine1) & ': REFUSED - ' & clip(csWhy) & '.<13,10>')
      end
      cycle
    end
    if csRpt then cycle.
    csLineNo = self.LogLineOf(csLine1)
    do CsEdit
    pLog.append('BUILTIN CutToSplit line ' & csLineNo & ': ' & clip(csXTxt) & ' is cut at its first ' & |
                clip(csSep) & ' - that is a split: the head is line 1 and the tail is the lines after it.<13,10>')
    csEdited = 1
    exit
  end

! ---- p = x.findByte(n) | x.findChar('c') and nothing else on the line
CsShape routine
  csP = '' ; csX0 = '' ; csSep = '' ; csQuoteSep = 0
  if records(csQ) <> 6 then exit.           ! p = x.findByte ( n )
  get(csQ, 2) ; if csQ.tx <> '=' then exit.
  get(csQ, 1)
  csN = len(clip(csQ.tx))
  if ~csN or instring('.', csQ.tx[1 : csN], 1, 1) then exit.
  if ~((csQ.tx[1] >= 'A' and csQ.tx[1] <= 'Z') or csQ.tx[1] = '_') then exit.
  csP = csQ.tx
  csHeadIx = 3 ; do CsHead
  if ~csHead then csP = '' ; exit.
  get(csQ, 3)
  csN = len(clip(csQ.tx))
  csD = instring('.', csQ.tx[1 : csN], 1, 1)
  if ~csD or csD >= csN then csP = '' ; exit.
  get(csQ, 4) ; if csQ.tx <> '(' then csP = '' ; exit.
  get(csQ, 6) ; if csQ.tx <> ')' then csP = '' ; exit.
  get(csQ, 5)
  csN = len(clip(csQ.tx))
  get(csQ, 3)
  csD = instring('.', csQ.tx[1 : len(clip(csQ.tx))], 1, 1)
  case csQ.tx[csD + 1 : len(clip(csQ.tx))]
  of 'FINDBYTE'                             ! a number: 32 is the space, 39 and past 255 cannot be spelt
    get(csQ, 5)
    if ~csN or csN > 3 then csP = '' ; exit.
    loop csY = 1 to csN
      if csQ.tx[csY] < '0' or csQ.tx[csY] > '9' then csP = '' ; exit.
    end
    case csQ.tx[1 : csN] + 0
    of 32
      csSep = ''' '''
    of 39
      csQuoteSep = 1
      csSep = ''''
    of 256 to 999
      csQuoteSep = 2
      csSep = csQ.tx[1 : csN]
    else
      csSep = '''<<' & csQ.tx[1 : csN] & '>'''
    end
  of 'FINDCHAR'                             ! a one-character literal, as written
    get(csQ, 5)
    if csN <> 3 or csQ.tx[1] <> '''' or csQ.tx[3] <> '''' then csP = '' ; exit.
    csSep = self.tk.GetTok(csQ.tk)
  else
    csP = ''
    exit
  end
  csX0 = csHead

! ---- the procedure, and the end of its header
CsScope routine
  csScFirst = 0 ; csScLast = 0 ; csScCode = 0
  csSc = self.syms.ScopeContaining(csLine1, vs:scProc, vs:scMethod)
  if ~csSc then exit.
  self.syms.scopes.scopeId = csSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  csScFirst = self.syms.scopes.startTok
  csScLast  = self.syms.scopes.endTok
  csZ = 0
  loop csX = csScFirst to records(self.tk.tokens)
    get(self.tk.tokens, csX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      csZ += 1
    elsif self.tk.tokens.tok = ')'
      csZ -= 1
      if ~csZ then csScCode = csX ; break.
    elsif ~csZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      csScCode = csX ; break
    end
  end
  if ~csScCode then csScCode = csScFirst.

! ---- x a StringTheory LOCAL, not a reference; p an integer LOCAL, not a reference
CsDeclCheck routine
  csZ = self.syms.FindOwn(csX0, csSc)
  if ~csZ then csP = '' ; exit.
  get(self.syms.syms, csZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then csP = '' ; exit.
  csXDecl = self.syms.syms.declTok
  if (self.syms.syms.declTok > csScFirst and self.syms.syms.declTok <= csScCode)
    csWhy = clip(csXTxt) & ' is a PARAMETER - its lines are the caller''s, and a split would write them'
    exit
  end
  if self.syms.syms.isRef then csWhy = clip(csXTxt) & ' is a reference - what it points at may have lines of its own' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    csWhy = clip(csXTxt) & ' is STATIC or THREAD - the lines the split gives it last to the next call, whose tests would read them'
    exit
  end
  csZ = self.syms.FindOwn(csP, csSc)
  if ~csZ then csP = '' ; exit.
  get(self.syms.syms, csZ)
  if errorcode() then csP = '' ; exit.
  case self.syms.syms.typeU
  of 'LONG'  orof 'ULONG'  orof 'SIGNED' orof 'UNSIGNED'
  of 'SHORT' orof 'USHORT' orof 'BYTE'
    if ~csWhy then csWhy = clip(csPTxt) & ' is a ' & clip(self.syms.syms.typeU) & ', too narrow for every position findByte can answer: past its range it wraps, where the split cuts at the true position'.
  else
    csP = ''
    exit
  end
  csPDecl = self.syms.syms.declTok
  if (self.syms.syms.declTok > csScFirst and self.syms.syms.declTok <= csScCode) or self.syms.syms.isRef then csP = ''.
  if csP and (self.DeclHasAttr(csPDecl, 'STATIC') or self.DeclHasAttr(csPDecl, 'THREAD'))
    csWhy = clip(csPTxt) & ' is STATIC or THREAD - it keeps its value to the next call, where the lines that stand for it start afresh'
  end
  if csP and (band(self.DeclAttrBits(csPDecl), ab:over) or self.HasSiblingOver(csZ, csP))
    csWhy = clip(csPTxt) & ' shares its storage with another variable through OVER, so it can change under the other name'
  end

! ---- every line of the procedure: p's mentions are the tests and the two reads and nothing
!      else; x's lines are in use nowhere; x's value does not change between the cut and the
!      last read. The sites are collected in token order as they are met. A method of a class the
!      procedure declares shares its data, and its body follows the procedure, outside this walk:
!      p or x named there refuses. So does x reached under another name - a reference taken on it, a
!      call that may keep one - through which its value can change, or its new lines be read, unseen.
!      So does an INCLUDE in the procedure, whose code is not in this file.
CsUses routine
  free(csSites) ; csLastRd = 0 ; csChgAt = 0 ; csChgTxt = '' ; csChgLn = 0
  csInRtn = 0 ; csRtnChg = 0 ; csDoAt = 0 ; csDoEff = 0
  if self.MayHaveLocalMethods(csSc) and self.UsedInLocalMethods(upper(csP), csScFirst, csScLast)
    csWhy = clip(csPTxt) & ' is used in a method of a class this procedure declares, which can read it after the cut'
    exit
  end
  if self.MayHaveLocalMethods(csSc) and self.UsedInLocalMethods(upper(csX0), csScFirst, csScLast)
    csWhy = clip(csXTxt) & ' is used in a method of a class this procedure declares, which can read it after the cut'
    exit
  end
  if self.ScopeIncludes(csSc)
    csWhy = clip(csXTxt) & ' and ' & clip(csPTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  if ~csWhy then csWhy = self.ObjReach(csX0, csLine1, 1).
  if csWhy then exit.
  csFrom = csScFirst
  loop while csFrom > 0 and csFrom < csScLast
    do CsFill
    if csFrom = csLine1 then csInRtn = 0.
    if csFrom = csLine1 or csFrom = csPDecl or csFrom = csXDecl then csFrom = csNext ; cycle.
    do CsClassify                               ! p on this line: csKind, csS, csE
    if csKind = 9 then exit.
    if csKind
      if csFrom < csLine1
        csWhy = clip(csPTxt) & ' is used on line ' & self.LogLineOf(csFrom) & ', before the cut'
        exit
      end
      cst:kind = csKind ; cst:s = csS ; cst:e = csE ; add(csSites)
      csLastRd = csFrom
      do CsClassify2                            ! a line may hold both reads
      if csKind = 9 then exit.
      if csKind
        cst:kind = csKind ; cst:s = csS ; cst:e = csE ; add(csSites)
        do CsClassify2                          ! a THIRD mention on the line is one the rewrite would leave reading a p nothing assigns
        if csKind = 9 then exit.
        if csKind
          csWhy = clip(csPTxt) & ' is used three times on line ' & self.LogLineOf(csFrom) & ', and the rewrite covers two reads on a line'
          exit
        end
      end
    end
    loop csX = 1 to records(csQ)                ! x on this line
      csHeadIx = csX ; do CsHead
      get(csQ, csX)
      if errorcode() then break.
      if csHead = csX0
        csN = len(clip(csQ.tx))
        csD = instring('.', csQ.tx[1 : csN], 1, 1)
        if csD and csD < csN
          csHead = csQ.tx[csD + 1 : csN]
        else
          csHead = csQ.tx
        end
        if instring(' ' & clip(csHead) & ' ', csLinesU, 1, 1)
          csWhy = clip(csXTxt) & '''s own lines are in use on line ' & self.LogLineOf(csFrom) & ' (' & lower(clip(csHead)) & '), and the split would replace them'
          exit
        end
        if (csFrom > csLine1 or csInRtn) and ~instring(' ' & clip(csHead) & ' ', csReads, 1, 1)
          csChgTmp = lower(csHead) ; do CsChange
        end
        if (csFrom > csLine1 or csInRtn) and instring(' ' & clip(csHead) & ' ', ' VALUEPTR _DATAEND GETVALUEPTR ', 1, 1)
          do CsBufWrite
          if csZ then do CsChange.
        end
      elsif csQ.tx = csX0
        get(csQ, csX + 1)
        if errorcode() or csQ.tx <> '.'
          get(csQ, csX)
          if (csFrom > csLine1 or csInRtn) and self.BareArgLines(csQ.tk)
            csWhy = clip(csXTxt) & ' is handed whole on line ' & self.LogLineOf(csFrom) & ' to a call that may read its lines, which the split gives it'
            exit
          end
          if csFrom > csLine1 or csInRtn then csChgTmp = 'handed whole to a call' ; do CsChange.
        end
      end
    end
    if csWhy then exit.
    do CsRoutineAt
    csFrom = csNext
  end
  if ~records(csSites) then csWhy = clip(csPTxt) & ' is never read after the cut, so there is nothing to rewrite'.
  if ~csWhy and csChgAt and csChgAt <= csLastRd ! a change of x after the last read is its own business
    csWhy = clip(csXTxt) & ' is changed on line ' & self.LogLineOf(csChgLn) & ' (' & clip(csChgTxt) & '), between the cut and the last read, so its lines would not be its text'
    if csChgAt < csChgLn
      if self.GotoBackTop(csChgLn, csLine1 + 1, csScLast) = csChgAt
        csWhy = clip(csWhy) & ' - a GOTO back to line ' & self.LogLineOf(csChgAt) & ' runs the read again'
      else
        csWhy = clip(csWhy) & ' - the loop on line ' & self.LogLineOf(csChgAt) & ' runs the read again'
      end
    end
  end
  if ~csWhy and csRtnChg and csDoAt and csDoEff <= csLastRd
    csWhy = clip(csXTxt) & ' is changed in a routine, and line ' & self.LogLineOf(csDoAt) & ' calls a routine between the cut and the last read, so its lines would not be its text'
  end

! ---- csZ = 1 when the mention of x in the csQ row csX - x.valuePtr, x._DataEnd or x.getValuePtr(), its
!      tail in csHead - WRITES x, though the same words elsewhere only read it: it is stored into
!      (StoreHead: it begins its statement, follows the DEBUG mark, or is a LOOP's counter - never the
!      first word of a '|' continuation line), so it is the target of an assignment; or the buffer, a slice of it, or the
!      length is handed whole to a call that may write through it (ArgMayWrite) - a slice reaches the
!      same bytes, and a *LONG parameter given _DataEnd sets the length. Both are read from the token
!      stream, which a '|' does not break, so a call wrapped over two lines is seen whole. The mention
!      runs to its last token: the name itself, or the bracket that closes a slice or a call - one the
!      statement never closes counts as a change. A method of a StringTheory that only reads is no
!      obstacle: x.slice(p + 1, x._DataEnd) is the tail read itself. csChgTmp names it
CsBufWrite routine
  data
s    long,auto
e    long,auto
k    long,auto
d    long,auto
t    STRING(vs:maxName),auto
  code
  csZ = 0
  get(csQ, csX) ; s = csQ.tk
  e = s
  if self.tk.GetTok(s + 1) = '.' then e = s + 2.
  if csHead <> 'GETVALUEPTR'
    csChgTmp = 'a store into its ' & lower(csHead)
    if self.StoreHead(s) then csZ = 1 ; exit.
  end
  t = self.tk.GetTok(e + 1)
  case t
  of '[' orof '('
    d = 0
    loop k = e + 1 to records(self.tk.tokens)
      t = self.tk.GetTok(k)
      if t = '<10>' then break.
      if t = '[' or t = '(' then d += 1.
      if t = ']' or t = ')' then d -= 1.
      if ~d then break.
    end
    if d then csChgTmp = 'its ' & lower(clip(csHead)) & ', whose bracket does not close' ; csZ = 1 ; exit.
    e = k
  end
  csZ = self.ArgMayWrite(s, e, csReads, csSums)
  csChgTmp = choose(csHead = '_DATAEND', 'its _dataend', 'its buffer') & ' handed to a call that may write it'

! ---- csEff = where the line at csFrom counts from when x changes there: the first token of the outermost
!      LOOP or ACCEPT around it that opens after the cut - its next pass brings control back to the reads
!      above the change - or the line itself. A GOTO after the line that names a column-1 label after the
!      cut and at or above the line is the same back edge spelled another way (GotoBackTop): the line then
!      counts from that label, when it is earlier. A label on the cut line runs the cut again, as a loop
!      around the cut does, so it is not looked for
CsEffOf routine
  csEff = csFrom ; csZ = 0
  loop csY = csFrom - 1 to csLine1 + 1 by -1
    get(self.tk.tokens, csY)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      csZ += 1
    of '+'
      if csZ
        csZ -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        csEff = csY
      end
    end
  end
  csY = self.GotoBackTop(csFrom, csLine1 + 1, csScLast)
  if csY and csY < csEff then csEff = csY.
  if csEff = csFrom then exit.
  loop csY = csEff to csLine1 by -1
    get(self.tk.tokens, csY)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then csEff = csY ; break.
  end

! ---- a change of x on the line at csFrom, doing csChgTmp. After the cut, in the procedure's code (or the
!      routine holding the cut), it counts from csEff, and the one that counts first is kept; in another
!      routine body it marks the routines as changing x, and then a DO after the cut counts as a change
CsChange routine
  if csInRtn then csRtnChg = 1 ; exit.
  do CsEffOf
  if ~csChgAt or csEff < csChgAt
    csChgAt = csEff ; csChgLn = csFrom ; csChgTxt = csChgTmp
  end

! ---- the line at csFrom: a ROUTINE header starts a routine body, where what is done to x counts where
!      the routine is called - every body but the stretch of the one holding the cut from the cut on,
!      where the walk turns positional again at the cut line. A DO after the cut, outside those bodies,
!      is remembered by where it counts from, as a change is
CsRoutineAt routine
  get(csQ, 2)
  if ~errorcode() and csQ.tx = 'ROUTINE' then csInRtn = 1 ; exit.
  if csInRtn or csFrom < csLine1 then exit.
  loop csX = 1 to records(csQ)
    get(csQ, csX)
    if errorcode() then break.
    if csQ.tx <> 'DO' then cycle.
    do CsEffOf
    if ~csDoAt or csEff < csDoEff then csDoAt = csFrom ; csDoEff = csEff.
    break
  end

! ---- THE CUT MUST BE TESTED AT ONCE, AND EVERY READ MUST COME AFTER THE TEST. The split agrees
!      with the slices only when the separator was found: with none, p is 0 and a tail read
!      x.valuePtr[p + 1 : x._DataEnd] or x.slice(p + 1) is the WHOLE value, where the lines after
!      the first are nothing. So the next line must leave when p is 0 - `if ~p then return.`,
!      `if p = 0 then exit.`, with CYCLE or BREAK in a loop - and every read must lie after it in
!      the same block, up to the END or ELSE that closes the block the cut stands in. The test may
!      also be a block IF: one that leaves as its last statement, or `if p` holding every read.
!      The cut must not be one arm of an EXECUTE: the test and the reads after it would then be
!      other arms, which run without it, and the arms carry no mark the walk below could see.
CsGuard routine
  csX = self.ArmOfExecute(csLine1)
  if csX
    csWhy = 'the cut is one arm of the EXECUTE on line ' & self.LogLineOf(csX) &      |
            ', so the test and the reads after it run without it'
    exit
  end
  csFrom = csLine1 ; do CsFill
  csFrom = csNext
  loop while csFrom > 0 and csFrom < csScLast
    do CsFill
    if records(csQ) then break.
    csFrom = csNext
  end
  csGuardOk = 0
  csY = 1
  get(csQ, csY) ; if errorcode() or csQ.tx <> 'IF' then do CsGuardWhy ; exit.
  csIfTk = csQ.tk
  csNeg = 1
  csY += 1
  get(csQ, csY) ; if errorcode() then do CsGuardWhy ; exit.
  if csQ.tx = '~' or csQ.tx = 'NOT'
    csY += 1
    get(csQ, csY) ; if errorcode() or csQ.tx <> csP then do CsGuardWhy ; exit.
  elsif csQ.tx = csP
    csY += 1
    get(csQ, csY)
    if errorcode() or csQ.tx = 'THEN'
      csNeg = 0 ; csY -= 1                                                            ! if p: the test that holds the reads
    elsif csQ.tx = '=' or csQ.tx = '>' or csQ.tx = '<<>'
      csNeg = choose(csQ.tx = '=')
      csY += 1
      get(csQ, csY) ; if errorcode() or csQ.tx <> '0' then do CsGuardWhy ; exit.
    else
      do CsGuardWhy ; exit
    end
  else
    do CsGuardWhy ; exit
  end
  if records(csQ) = csY then do CsGuardBlock ; exit.                                  ! the test ends the line: a block IF
  if ~csNeg then do CsGuardWhy ; exit.
  csY += 1
  get(csQ, csY) ; if errorcode() or csQ.tx <> 'THEN' then do CsGuardWhy ; exit.
  csY += 1
  get(csQ, csY) ; if errorcode() then do CsGuardWhy ; exit.
  case csQ.tx
  of 'RETURN' orof 'EXIT' orof 'CYCLE' orof 'BREAK'
  else
    do CsGuardWhy ; exit
  end
  get(csQ, records(csQ)) ; if errorcode() or csQ.tx <> '.' then do CsGuardWhy ; exit.
  if records(csQ) > csY + 2 then do CsGuardWhy ; exit.                                ! at most a returned value before the '.'
  get(csQ, records(csQ)) ; csGuardEnd = csQ.tk
  do CsGuardAfter

! ---- the reads lie after the test, in the block the cut stands in: forward to its END or ELSE, or to
!      the first ROUTINE after it - a routine runs when it is DOne, which may be before the cut
CsGuardAfter routine
  csBlkEnd = csScLast
  csD = 0
  loop csX = csGuardEnd + 1 to csScLast
    get(self.tk.tokens, csX)
    if errorcode() then break.
    case self.tk.tokens.level
    of '+'
      csD += 1
    of '-'
      if ~csD then csBlkEnd = csX ; break.
      csD -= 1
    of '/'
      if ~csD then csBlkEnd = csX ; break.
    end
    if self.tk.tokens.firstOnLine and upper(self.tk.GetTok(csX + 1)) = 'ROUTINE' then csBlkEnd = csX ; break.
  end
  do CsGuardReads

! ---- every read lies after csGuardEnd and before csBlkEnd
CsGuardReads routine
  loop csX = 1 to records(csSites)
    get(csSites, csX)
    if errorcode() then break.
    if cst:kind < 3 then cycle. ! the tests are rewritten wherever they stand
    if cst:s <= csGuardEnd or cst:e >= csBlkEnd
      csWhy = clip(csPTxt) & ' is read on line ' & self.LogLineOf(cst:s) & ' outside the block its test guards, so a read could run with no separator found'
      exit
    end
  end
  csGuardOk = 1

! ---- a block IF: `if ~p` or `if p = 0` must leave as its last statement, and the reads come after
!      its END; `if p`, `if p > 0` or `if p <> 0` must hold every read. Neither may have an ELSE.
CsGuardBlock routine
  csEndTk = 0 ; csLast = 0 ; csD = 1
  loop csX = csIfTk + 1 to csScLast
    get(self.tk.tokens, csX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then cycle.
    if csD = 1
      if self.tk.tokens.level = '-' then csEndTk = csX ; break.
      if self.tk.tokens.level = '/' then break.            ! an ELSE: the other side runs as well
      if self.tk.tokens.firstOnLine then csLast = csX.     ! the first token of the block's last line
    end
    case self.tk.tokens.level
    of '+'
      csD += 1
    of '-'
      csD -= 1
    end
  end
  if ~csEndTk then do CsGuardWhy ; exit.
  get(csQ, records(csQ)) ; csGuardEnd = csQ.tk
  if ~csNeg
    csBlkEnd = csEndTk
    do CsGuardReads
    exit
  end
  if ~csLast then do CsGuardWhy ; exit.
  get(self.tk.tokens, csLast)
  if errorcode() or self.tk.tokens.tok &= NULL then do CsGuardWhy ; exit.
  case upper(self.tk.tokens.tok)
  of 'RETURN' orof 'EXIT' orof 'CYCLE' orof 'BREAK'
  else
    do CsGuardWhy ; exit
  end
  csGuardEnd = csEndTk
  do CsGuardAfter

CsGuardWhy routine
  csWhy = 'the line after the cut does not leave when ' & clip(csPTxt) & ' is 0 (if ~' & lower(clip(csPTxt)) & ' then return.), so a read could run with no separator found'

! ---- p on the line in hand: which allowed shape it is, or 9 for one the split does not cover.
!      Rows are matched on csQ; csS/csE are the real tokens of the span to rewrite.
CsClassify routine
  csKind = 0 ; csS = 0 ; csE = 0
  loop csX = 1 to records(csQ)
    get(csQ, csX)
    if errorcode() then break.
    if csQ.tx <> csP then cycle.
    do CsAtRow
    exit
  end

! ---- a SECOND mention of p on the same line, after the first site
CsClassify2 routine
  csAfter = csE
  csKind = 0 ; csS = 0 ; csE = 0
  loop csX = 1 to records(csQ)
    get(csQ, csX)
    if errorcode() then break.
    if csQ.tx <> csP or csQ.tk <= csAfter then cycle.
    do CsAtRow
    exit
  end

! ---- the mention of p at csQ row csX: a test, the head read, the tail read, or anything else
CsAtRow routine
  csKind = 9
  ! the tests, and only inside a condition - after IF, ELSIF, WHILE, UNTIL, AND, OR or CHOOSE( - because the
  ! rewrite is a comparison, which cannot be assigned: ~p, not p, p = 0 (negative); p, p <> 0, p > 0 (positive)
  if csX >= 2
    get(csQ, csX - 1)
    case csQ.tx
    of '~' orof 'NOT'
      csY = csX - 2 ; do CsCondCtx
      if csZ
        get(csQ, csX + 1)
        if errorcode() or csQ.tx = 'THEN' or csQ.tx = 'AND' or csQ.tx = 'OR' or csQ.tx = ')'
          get(csQ, csX - 1) ; csS = csQ.tk
          get(csQ, csX) ; csE = csQ.tk
          csKind = 1
          exit
        end
      end
    else
      csY = csX - 1 ; do CsCondCtx
      if csZ
        get(csQ, csX + 1)
        if ~errorcode() and (csQ.tx = '=' or csQ.tx = '<<>' or csQ.tx = '>')
          csHead = csQ.tx
          get(csQ, csX + 2)
          if ~errorcode() and csQ.tx = '0'
            get(csQ, csX + 3)
            if errorcode() or csQ.tx = 'THEN' or csQ.tx = 'AND' or csQ.tx = 'OR' or csQ.tx = ')'
              get(csQ, csX) ; csS = csQ.tk
              get(csQ, csX + 2) ; csE = csQ.tk
              csKind = choose(csHead = '=', 1, 2)
              exit
            end
          end
        elsif errorcode() or csQ.tx = 'THEN' or csQ.tx = 'AND' or csQ.tx = 'OR' or csQ.tx = ')'
          get(csQ, csX) ; csS = csQ.tk ; csE = csQ.tk
          csKind = 2
          exit
        end
      end
    end
  end
  ! the head read: X.VALUEPTR [ 1 : p - 1 ]   or   X.SLICE|X.SUB ( 1 , p - 1 )
  if csX >= 5
    get(csQ, csX - 4)
    csN = len(clip(csQ.tx))
    csD = instring('.', csQ.tx[1 : csN], 1, 1)
    if csD > 1 and csD < csN and csQ.tx[1 : csD - 1] = csX0
      csHead = csQ.tx[csD + 1 : csN]
      get(csQ, csX - 3)
      if csHead = 'VALUEPTR' and csQ.tx = '[' ! not slice() or sub(): with the separator FIRST, p - 1 is 0, and an end of 0 there means "to the end"
        csTxt.setValue(csQ.tx)
        get(csQ, csX - 2)
        if csQ.tx = '1'
          get(csQ, csX - 1)
          if (csTxt.getValue() = '[' and csQ.tx = ':') or (csTxt.getValue() = '(' and csQ.tx = ',')
            get(csQ, csX + 1)
            if csQ.tx = '-'
              get(csQ, csX + 2)
              if csQ.tx = '1'
                get(csQ, csX + 3)
                if (csTxt.getValue() = '[' and csQ.tx = ']') or (csTxt.getValue() = '(' and csQ.tx = ')')
                  get(csQ, csX - 4) ; csS = csQ.tk
                  get(csQ, csX + 3) ; csE = csQ.tk
                  csKind = 3
                  do CsSiteUse
                  exit
                end
              end
            end
          end
        end
      end
    end
  end
  ! the tail read: X.VALUEPTR [ p + 1 : X._DATAEND ]   or   X.SLICE ( p + 1 )   or   X.SLICE ( p + 1 , X._DATAEND )
  if csX >= 3
    get(csQ, csX - 2)
    csN = len(clip(csQ.tx))
    csD = instring('.', csQ.tx[1 : csN], 1, 1)
    if csD > 1 and csD < csN and csQ.tx[1 : csD - 1] = csX0
      csHead = csQ.tx[csD + 1 : csN]
      get(csQ, csX - 1)
      if (csHead = 'VALUEPTR' and csQ.tx = '[') or (csHead = 'SLICE' and csQ.tx = '(')
        csTxt.setValue(csQ.tx)
        get(csQ, csX + 1)
        if csQ.tx = '+'
          get(csQ, csX + 2)
          if csQ.tx = '1'
            get(csQ, csX + 3)
            if csTxt.getValue() = '(' and csQ.tx = ')'
              get(csQ, csX - 2) ; csS = csQ.tk
              get(csQ, csX + 3) ; csE = csQ.tk
              csKind = 4
              exit
            end
            if (csTxt.getValue() = '[' and csQ.tx = ':') or (csTxt.getValue() = '(' and csQ.tx = ',')
              get(csQ, csX + 4)
              if csQ.tx = clip(csX0) & '._DATAEND'
                get(csQ, csX + 5)
                if (csTxt.getValue() = '[' and csQ.tx = ']') or (csTxt.getValue() = '(' and csQ.tx = ')')
                  get(csQ, csX - 2) ; csS = csQ.tk
                  get(csQ, csX + 5) ; csE = csQ.tk
                  csKind = 4
                  if csHead = 'VALUEPTR' then do CsSiteUse.
                  exit
                end
              end
            end
          end
        end
      end
    end
  end
  csWhy = clip(csPTxt) & ' is used on line ' & self.LogLineOf(csFrom) & ' in a way the split does not cover'

! ---- a head or tail read of x.valuePtr at [csS, csE] that is WRITTEN is not a read the split can
!      stand for: the line it becomes is a copy. As the target of an assignment it would read
!      `x.getLine(1) = ...`, which does not compile; as a whole argument a callee may write
!      through, the write would no longer reach x. It is the target when it is stored into
!      (StoreHead: it begins its statement or follows the DEBUG mark; first on a '|' continuation
!      line it is a comparison, a read). A whole argument may go to setValue, append or
!      prepend on a StringTheory, to a call the summaries show only reads it, or to a function on
!      the pure list (ArgMayWrite); anything else refuses, with the line.
CsSiteUse routine
  data
nx   STRING(vs:maxName),auto
  code
  nx = upper(self.tk.GetTok(csE + 1))
  if nx = '=' or instring(' ' & clip(nx) & ' ', isu:cmpdOps, 1, 1)
    if self.StoreHead(csS)
      csKind = 9
      csWhy = clip(csXTxt) & '.valuePtr is assigned on line ' & self.LogLineOf(csFrom) & ' - as a line of the split it would be a copy, which cannot be assigned'
      exit
    end
  end
  if ~self.ArgMayWrite(csS, csE, '', csSums) then exit.
  csKind = 9
  csWhy = clip(csXTxt) & '.valuePtr is handed on line ' & self.LogLineOf(csFrom) & ' to a call that may write it - the line the split makes is a copy, which the write would not reach'

! ---- csZ = 1 when the csQ row csY opens a condition: IF, ELSIF, WHILE, UNTIL, AND, OR, or the ( of CHOOSE
CsCondCtx routine
  csZ = 0
  if csY < 1 then exit.
  get(csQ, csY)
  if errorcode() then exit.
  if csQ.tx = 'IF' or csQ.tx = 'ELSIF' or csQ.tx = 'WHILE' or csQ.tx = 'UNTIL' or csQ.tx = 'AND' or csQ.tx = 'OR' then csZ = 1 ; exit.
  if csQ.tx = '(' and csY >= 2
    get(csQ, csY - 1)
    if ~errorcode() and csQ.tx = 'CHOOSE' then csZ = 1.
  end

! ---- THE EDIT: every site from the last to the first, so no earlier position moves; then the cut
CsEdit routine
  loop csX = records(csSites) to 1 by -1
    get(csSites, csX)
    case cst:kind
    of 1 ; csTxt.setValue(clip(csXTxt) & '.records() << 2')
    of 2 ; csTxt.setValue(clip(csXTxt) & '.records() >= 2')
    of 3 ; csTxt.setValue(clip(csXTxt) & '.getLine(1)')
    of 4 ; csTxt.setValue(clip(csXTxt) & '.getLines(2, 0, ' & clip(csSep) & ')')
    end
    do CsReplace
  end
  csEol = self.FirstEolAfter(csLine1)
  cst:kind = 5 ; cst:s = csLine1 ; cst:e = csEol - 1 ! the cut line itself: a line start, not a fragment
  csTxt.setValue(clip(csXTxt) & '.split(' & clip(csSep) & ')')
  do CsReplace
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- replace the tokens cst:s..cst:e with csTxt, keeping the first token's strBefore
CsReplace routine
  csSb.free()
  get(self.tk.tokens, cst:s)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL then csSb.setValue(self.tk.tokens.strBefore).
  self.tk.DeleteToks(cst:s, cst:e)
  self.tk.InsertString(cst:s, csTxt, choose(cst:kind <> 5))
  self.tk.SetStrBefore(cst:s, csSb.getValue())

! ---- the two names as the author spelled them, from the cut line's own tokens
CsNames routine
  csPTxt = csP ; csXTxt = csX0
  loop csX = csLine1 to records(self.tk.tokens)
    get(self.tk.tokens, csX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    csN = len(clip(self.tk.tokens.tok))
    if ~csN then cycle.
    csD = instring('.', self.tk.tokens.tok[1 : csN], 1, 1)
    if csD > 1
      if upper(self.tk.tokens.tok[1 : csD - 1]) = csX0 then csXTxt = self.tk.tokens.tok[1 : csD - 1].
    elsif ~csD
      if upper(self.tk.tokens.tok[1 : csN]) = csP then csPTxt = self.tk.tokens.tok[1 : csN].
      if upper(self.tk.tokens.tok[1 : csN]) = csX0 then csXTxt = self.tk.tokens.tok[1 : csN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into csQ with their token index; a split
!      dotted CALL (x . findByte) joined into one row, as TakeOverValue does
CsFill routine
  free(csQ)
  csNext = 0
  loop csX = csFrom to records(self.tk.tokens)
    get(self.tk.tokens, csX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      csNext = csX + 1 ; break
    end
    if csX > csFrom and self.tk.tokens.firstOnLine
      csNext = csX ; break
    end
    csQ.tx = upper(self.tk.tokens.tok) ; csQ.tk = csX
    add(csQ)
  end
  if ~csNext then csNext = records(self.tk.tokens) + 1.
  csX = 2
  loop while csX < records(csQ)
    get(csQ, csX)
    if errorcode() then break.
    if csQ.tx <> '.' then csX += 1 ; cycle.
    get(csQ, csX - 1)
    if errorcode() or ~((csQ.tx[1] >= 'A' and csQ.tx[1] <= 'Z') or csQ.tx[1] = '_') then csX += 1 ; cycle.
    csHead = csQ.tx ; csZ = csQ.tk
    get(csQ, csX + 1)
    if errorcode() or ~((csQ.tx[1] >= 'A' and csQ.tx[1] <= 'Z') or csQ.tx[1] = '_') then csX += 1 ; cycle.
    csTxt.setValue(csQ.tx)
    delete(csQ)
    get(csQ, csX)
    delete(csQ)
    get(csQ, csX - 1)
    csQ.tx = clip(csHead) & '.' & csTxt.getValue() ; csQ.tk = csZ
    put(csQ)
  end

! ---- csHead = the RECEIVER in front of the csQ row at csHeadIx
CsHead routine
  csHead = ''
  get(csQ, csHeadIx)
  if errorcode() then exit.
  csN = len(clip(csQ.tx))
  if ~csN then exit.
  csD = instring('.', csQ.tx[1 : csN], 1, 1)
  if csD > 1 then csHead = csQ.tx[1 : csD - 1].

!===============================================================================================
! BUILTIN SplitInPlace - a scratch copied from a local only to be split is that local, split in
! place; where the local's value is read after the lines were loaded into it, join(separator)
! gives the value back first. 13 Sep 2026, from the rewrite of ParseSettingsLine.
!
!     toks.setValue(rest)                         rest.split(' ')
!     toks.split(' ')                             loop i = 1 to rest.records()
!     loop i = 1 to toks.records()          ->      rest.setValueFromLine(i)
!       toks.setValueFromLine(i)                    ...
!       ...                                       end
!     end                                         rest.join(' ')
!     ... rest.getValue()                         ... rest.getValue()
!
! The copy exists because the loop overwrites the value line by line and the original is wanted
! afterwards. EXACT, from the library: a split leaves the value alone, and join(sep) after a
! plain split(sep) - one literal argument, no quote, clip or left - gives the value back byte
! for byte when the lines were not changed. So: the copy goes, the scratch's later mentions
! name the source, and a join goes in front of the source's first later mention, after the
! structure holding the scratch's last mention, when the scratch wrote the value at all - a store
! through its buffer (toks._DataEnd = 0, toks.valuePtr[1] = 'x'), or the buffer, a slice of it or
! its length handed whole to a call that may write it, is a write of the value too.
!
! WHAT IT REFUSES, each with its reason: the scratch is a parameter, a reference, or mentioned
! before the copy; the source is a parameter or a reference (its lines and value are not this
! procedure's), or its own lines are in use anywhere in the procedure; the source is mentioned
! between the copy and the scratch's last use; a reference to the source is taken anywhere in
! the procedure, or it is handed to a call that may keep one - a second name for it that no walk
! here can follow; either object is given Stream(); a routine mentions the
! source and a DO lies where the routine would find the source's value on loan - between the
! copy and the join, or the scratch's last use when there is no join - since a routine shares
! the locals; the scratch writes its lines (setLine, addLine, deleteLine, sort, a second split,
! freeLines, free(true), setValue with st:lines or an option that may hold it, swap), is handed
! whole to a call, or assigned
! by reference; a reference is taken on the scratch or its buffer, or the buffer is handed to a
! call that may keep one; the split is not plain; the copy could run more than once, or a later mention
! could run without it (TakeOverValue's walks); with a join, a GOTO between the copy and the
! join (it would jump past the join), or a label a GOTO names between the scratch's last use
! and the join (the jump would reach the join without the copy).
! The join takes the indent of the line it goes in front of - the copy line's, when that line
! begins with a label. A comment on the copy line stays, on a line of
! its own (14 Sep 2026). TakeOverValue, which runs first, takes the case where the source is
! never mentioned again; this one takes the rest.
!===============================================================================================
VitEngine.BuiltinSplitInPlace Procedure(StringTheory pLog)
i           long,auto
spX         long,auto
spY         long,auto
spZ         long,auto
spD         long,auto
spN         long,auto
spLine1     long,auto          ! first token of the copy line
spLine2     long,auto          !   and of the split line
spEol       long,auto
spKept      long               ! comments kept from the copy line (log)
spFrom      long,auto
spNext      long,auto
spHeadIx    long
spHead      STRING(vs:maxName)
spTail      STRING(96)
spBuf       STRING(vs:maxName) ! the scratch, folded
spSrc       STRING(vs:maxName) ! the source, folded
spBufTxt    STRING(vs:maxName)
spSrcTxt    STRING(vs:maxName)
spSep       STRING(96)         ! the split's literal, as written
spScFirst   long,auto
spScLast    long,auto
spByVal     byte,auto          ! SpShape: the copy is getValue() / getValuePtr() - the text, not the marks
spMarkAt    long,auto          ! the first mention that can set the source's marks (MarkSetterAt)
spMarkEnc   byte,auto
spScCode    long,auto
spSc        long,auto
spLast      long               ! first token of the scratch's last mention
spSrcAfter  long               ! first token of the source's first mention after that
spSrcRout   long               ! first token of the source's first mention inside a routine
spValWr     byte               ! the scratch wrote its value at least once
spSums      byte               ! SpBufWrite: the summaries are built for this call
spJoinAt    long               ! the token the join line goes in front of, 0 = no join
spBufDecl   long
spSrcDecl   long
spLineNo    long               ! the copy line's number, read BEFORE the edit deletes it
spWhy       STRING(200)
spRpt       byte
spEdited    byte
spDepth     long,auto
spInd       StringTheory
spShf       byte
spTxt       StringTheory
spReads     EQUATE(                                                                                              |
  ' RECORDS GETLINE GETLINES INLINE _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH LEN SLICE SUB CONTAINSCHAR ' & |
    'CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS COUNT CLIPLENGTH ')
spLinesWr   EQUATE(' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN SORT ADDLINE SETLINE INSERTLINE DELETELINE REMOVELINES FREELINES SWAP LINES SETLINEFROMVALUE START FILTER WRAPTEXT ')
spLinesAny  EQUATE(                                                                                                |
  ' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE ' & |
    'SETLINEFROMVALUE SETLINE ADDLINE INSERTLINE DELETELINE REMOVELINES SORT FREELINES JOIN LINES SWAP ')
spQ         QUEUE,PRE(sp)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  spEdited = 0
  if self.curPass = 1
    spRpt = 1 ; do SpScan
  end
  spRpt = 0 ; do SpScan
  return spEdited

! ---- every line of the file
SpScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    spLine1 = i
    spFrom = spLine1 ; do SpFill
    do SpShape                                                                      ! <buf>.setValue(<src>) and nothing else
    if ~spBuf then cycle.
    spFrom = spNext                                                                 ! the next line that holds a token: a
    loop                                                                            !   comment-only line has an EOL of its own
      do SpFill
      if records(spQ) or ~spNext or spNext > records(self.tk.tokens) then break.
      spFrom = spNext
    end
    spLine2 = spFrom
    do SpSplitLine                                                                  ! <buf>.split('lit') and nothing else
    if ~spSep then cycle.
    spWhy = ''
    do SpScope
    if ~spScFirst then cycle.
    do SpNames
    do SpDeclCheck
    if ~spBuf then cycle.
    if ~spWhy and spByVal
      spMarkAt = self.MarkSetterAt(spSrc, spScFirst, spScLast, spMarkEnc)
      if spMarkAt then spWhy = 'the copy takes ' & clip(spSrcTxt) & '''s text and not its base64 flag or encoding, which line ' & self.LogLineOf(spMarkAt) & ' can set - split in place, ' & clip(spBufTxt) & '''s uses would run on them'.
    end
    if ~spWhy then do SpUses.
    if ~spWhy then do SpOnce.
    if ~spWhy then do SpRuns.
    if ~spWhy then do SpJoinPoint.
    if ~spWhy then do SpGotoCheck.
    if ~spWhy then do SpDoCheck.
    if spWhy
      if spRpt
        pLog.append('BUILTIN SplitInPlace line ' & self.LogLineOf(spLine1) & ': REFUSED - ' & clip(spWhy) & '.<13,10>')
      end
      cycle
    end
    if spRpt then cycle.
    spLineNo = self.LogLineOf(spLine1)
    do SpEdit
    pLog.append('BUILTIN SplitInPlace line ' & spLineNo & ': ' & clip(spBufTxt) & ' only ever holds a copy of ' & |
                clip(spSrcTxt) & ' to split it, so ' & clip(spSrcTxt) & ' is split in place'                    & |
                choose(~spJoinAt, '', ' and joined back before it is read again')                               & |
                choose(~spKept, '', ' - its comment stays, on a line of its own') & '.<13,10>')
    spEdited = 1
    exit
  end

! ---- <buf>.setValue( <src> | <src>.getValue() | <src>.getValuePtr() ) and nothing else
SpShape routine
  spBuf = '' ; spSrc = '' ; spByVal = 0
  if records(spQ) < 4 then exit.
  spHeadIx = 1 ; do SpHead
  get(spQ, 1)
  spN = len(clip(spQ.tx))
  spD = instring('.', spQ.tx[1 : spN], 1, 1)
  if ~spHead or ~spD or spD >= spN or spQ.tx[spD + 1 : spN] <> 'SETVALUE' then exit.
  get(spQ, 2)
  if spQ.tx <> '(' then exit.
  get(spQ, 3)
  spN = len(clip(spQ.tx))
  spD = instring('.', spQ.tx[1 : spN], 1, 1)
  if spD > 1 and spD < spN
    if spQ.tx[spD + 1 : spN] <> 'GETVALUE' and spQ.tx[spD + 1 : spN] <> 'GETVALUEPTR' then exit.
    if records(spQ) <> 6 then exit.
    get(spQ, 4) ; if spQ.tx <> '(' then exit.
    get(spQ, 5) ; if spQ.tx <> ')' then exit.
    get(spQ, 6) ; if spQ.tx <> ')' then exit.
    get(spQ, 3)
    spSrc = spQ.tx[1 : spD - 1]
    spByVal = 1
  else
    if records(spQ) <> 4 then exit.
    get(spQ, 4) ; if spQ.tx <> ')' then exit.
    get(spQ, 3)
    if spD then exit.
    spSrc = spQ.tx
  end
  if ~((spSrc[1] >= 'A' and spSrc[1] <= 'Z') or spSrc[1] = '_') then exit.
  spBuf = spHead
  if spSrc = spBuf then spBuf = ''.

! ---- the next line: <buf>.split( 'literal' ) and nothing else - a PLAIN split
SpSplitLine routine
  spSep = ''
  if records(spQ) <> 4 then exit.
  spHeadIx = 1 ; do SpHead
  if spHead <> spBuf then exit.
  get(spQ, 1)
  spN = len(clip(spQ.tx))
  spD = instring('.', spQ.tx[1 : spN], 1, 1)
  if ~spD or spD >= spN or spQ.tx[spD + 1 : spN] <> 'SPLIT' then exit.
  get(spQ, 2) ; if spQ.tx <> '(' then exit.
  get(spQ, 4) ; if spQ.tx <> ')' then exit.
  get(spQ, 3)
  if spQ.tx[1] <> '''' then exit.
  spSep = self.tk.GetTok(spQ.tk)  ! as written, not folded

! ---- the procedure and the end of its header
SpScope routine
  spScFirst = 0 ; spScLast = 0 ; spScCode = 0
  spSc = self.syms.ScopeContaining(spLine1, vs:scProc, vs:scMethod)
  if ~spSc then exit.
  self.syms.scopes.scopeId = spSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  spScFirst = self.syms.scopes.startTok
  spScLast  = self.syms.scopes.endTok
  spZ = 0
  loop spX = spScFirst to records(self.tk.tokens)
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      spZ += 1
    elsif self.tk.tokens.tok = ')'
      spZ -= 1
      if ~spZ then spScCode = spX ; break.
    elsif ~spZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      spScCode = spX ; break
    end
  end
  if ~spScCode then spScCode = spScFirst.

! ---- both StringTheory LOCALS, neither a reference. The source is not STATIC or THREAD either: the
!      loop borrows its value and gives it back only for a read in this call, and the next call would
!      find it borrowed. Neither may be named in a method of a class the procedure declares - such a
!      method shares the procedure's data, and its body lies outside every walk here. Nor may the
!      source be reached under another name - a reference taken on it, a call that may keep one - which
!      could read it while the loop has its value; and neither may be given Stream(), whose file
!      receives each value it holds, which the change moves from one object to the other. Nor may a
!      reference be taken on the scratch or its buffer (p &= toks.getValuePtr()), or the buffer be
!      handed to a call that may keep one: a store through it after the rename lands on the source.
!      Nor may the procedure INCLUDE a file: the included code is not in this file either.
SpDeclCheck routine
  spBufDecl = 0 ; spSrcDecl = 0
  spZ = self.syms.FindOwn(spSrc, spSc)
  if ~spZ then spBuf = '' ; exit.
  get(self.syms.syms, spZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then spBuf = '' ; exit.
  spSrcDecl = self.syms.syms.declTok
  if (self.syms.syms.declTok > spScFirst and self.syms.syms.declTok <= spScCode)
    spWhy = clip(spSrcTxt) & ' is a PARAMETER - its lines and its value are the caller''s'
    exit
  end
  if self.syms.syms.isRef then spWhy = clip(spSrcTxt) & ' is a reference - what it points at is not this procedure''s to split' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    spWhy = clip(spSrcTxt) & ' is STATIC or THREAD - its value lasts to the next call, which would find it split'
    exit
  end
  if self.MayHaveLocalMethods(spSc) and self.UsedInLocalMethods(upper(spSrc), spScFirst, spScLast)
    spWhy = clip(spSrcTxt) & ' is used in a method of a class this procedure declares, which could read it while the loop has it'
    exit
  end
  if ~spWhy then spWhy = self.ObjReach(upper(spSrc), spLine1, 3).
  if spWhy then exit.
  spZ = self.syms.FindOwn(spBuf, spSc)
  if ~spZ then spWhy = clip(spBufTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, spZ)
  spBufDecl = self.syms.syms.declTok
  if errorcode() or (self.syms.syms.declTok > spScFirst and self.syms.syms.declTok <= spScCode)
    spWhy = clip(spBufTxt) & ' is a PARAMETER, so it is not this procedure''s to rename'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then spWhy = clip(spBufTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then spWhy = clip(spBufTxt) & ' is a reference - what it points at is not this procedure''s to rename'.
  if ~spWhy and self.MayHaveLocalMethods(spSc) and self.UsedInLocalMethods(upper(spBuf), spScFirst, spScLast)
    spWhy = clip(spBufTxt) & ' is used in a method of a class this procedure declares, which the rename would not reach'
  end
  if ~spWhy and self.ScopeIncludes(spSc)
    spWhy = clip(spSrcTxt) & ' and ' & clip(spBufTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
  end
  if ~spWhy then spWhy = self.ObjReach(upper(spBuf), spLine1, 3).

! ---- every line of the procedure, routines included
SpUses routine
  spLast = 0 ; spSrcAfter = 0 ; spSrcRout = 0 ; spValWr = 0
  spFrom = spScFirst
  loop while spFrom > 0 and spFrom < spScLast        ! pass 1: the scratch's mentions
    do SpFill
    if spFrom = spBufDecl or spFrom = spLine1 or spFrom = spLine2 then spFrom = spNext ; cycle.
    loop spX = 1 to records(spQ)
      spHeadIx = spX ; do SpHead
      get(spQ, spX)
      if errorcode() then break.
      if spHead = spBuf
        if spFrom < spLine1
          spWhy = clip(spBufTxt) & ' is mentioned before the copy, on line ' & self.LogLineOf(spFrom)
          exit
        end
        spLast = spFrom
        spN = len(clip(spQ.tx))
        spD = instring('.', spQ.tx[1 : spN], 1, 1)
        spTail = spQ.tx[spD + 1 : spN]
        if instring(' ' & clip(spTail) & ' ', spLinesWr, 1, 1)
          spWhy = clip(spBufTxt) & '.' & lower(clip(spTail)) & ' on line ' & self.LogLineOf(spFrom) & ' writes its lines, which after the change are ' & clip(spSrcTxt) & '''s'
          exit
        end
        if spTail = 'FREE'
          get(spQ, spX + 2)
          if ~errorcode() and spQ.tx <> ')' then spWhy = clip(spBufTxt) & '.free(...) on line ' & self.LogLineOf(spFrom) & ' frees its lines' ; exit.
        elsif spTail = 'SETVALUE' or spTail = 'APPEND' or spTail = 'PREPEND'
          get(spQ, spX)
          spY = self.LinesOptAt(spQ.tk)
          if spY then spWhy = clip(spBufTxt) & '.' & lower(clip(spTail)) & ' on line ' & self.LogLineOf(spFrom) & choose(spY = 1, ' copies lines in', ' may copy lines in - its option may hold st:lines') ; exit.
          spValWr = 1
        elsif spTail = '_DATAEND' or spTail = 'VALUEPTR' or spTail = 'GETVALUEPTR'
          do SpBufWrite
        elsif ~instring(' ' & clip(spTail) & ' ', spReads, 1, 1)
          spValWr = 1                                ! a change of the VALUE - allowed, the join restores it
        end
      elsif spQ.tx = spBuf
        get(spQ, spX + 1)
        if errorcode() or spQ.tx <> '.'
          if spFrom < spLine1
            spWhy = clip(spBufTxt) & ' is mentioned before the copy, on line ' & self.LogLineOf(spFrom)
          elsif ~errorcode() and spQ.tx = '&='
            spWhy = clip(spBufTxt) & ' is assigned by reference on line ' & self.LogLineOf(spFrom)
          else
            spWhy = clip(spBufTxt) & ' is handed whole to a call on line ' & self.LogLineOf(spFrom) & ', which could split it'
          end
          exit
        end
      end
    end
    if spWhy then exit.
    spFrom = spNext
  end
  if ~spLast then spWhy = clip(spBufTxt) & ' is never used after the split, so there is nothing to take over' ; exit.
  spFrom = spScFirst
  loop while spFrom > 0 and spFrom < spScLast        ! pass 2: the source's mentions
    do SpFill
    if spFrom = spLine1 or spFrom = spSrcDecl then spFrom = spNext ; cycle.
    loop spX = 1 to records(spQ)
      spHeadIx = spX ; do SpHead
      get(spQ, spX)
      if errorcode() then break.
      if spHead <> spSrc and spQ.tx <> spSrc then cycle.
      if spHead = spSrc
        spN = len(clip(spQ.tx))
        spD = instring('.', spQ.tx[1 : spN], 1, 1)
        spTail = spQ.tx[spD + 1 : spN]
        if instring(' ' & clip(spTail) & ' ', spLinesAny, 1, 1)
          spWhy = clip(spSrcTxt) & '''s own lines are in use on line ' & self.LogLineOf(spFrom) & ' (' & lower(clip(spTail)) & '), and after the change its lines are ' & clip(spBufTxt) & '''s'
          exit
        end
        if spTail = 'FREE'
          get(spQ, spX + 2)
          if ~errorcode() and spQ.tx <> ')' then spWhy = clip(spSrcTxt) & '.free(...) on line ' & self.LogLineOf(spFrom) & ' frees its lines' ; exit.
        end
      elsif spQ.tx = spSrc
        get(spQ, spX + 1)
        if ~errorcode() and spQ.tx = '.' then cycle.
        if spX > 1                                                                   ! r &= src: a second name for the source, which
          get(spQ, spX - 1)                                                          !   none of these walks can follow
          if ~errorcode() and spQ.tx = '&='
            spWhy = 'a reference to ' & clip(spSrcTxt) & ' is taken on line ' & self.LogLineOf(spFrom) & ' - a second name for it, through which it can be read or changed unseen'
            exit
          end
        end
        get(spQ, spX)
        if spFrom > spLine1 and self.BareArgLines(spQ.tk)
          spWhy = clip(spSrcTxt) & ' is handed whole on line ' & self.LogLineOf(spFrom) & ' to a call that may read its lines, which after the change are the split''s'
          exit
        end
      end
      if spFrom > spLine1 and spFrom <= spLast
        spWhy = clip(spSrcTxt) & ' is mentioned on line ' & self.LogLineOf(spFrom) & ', between the copy and ' & clip(spBufTxt) & '''s last use on line ' & self.LogLineOf(spLast)
        exit
      end
      if spFrom > spLast and ~spSrcAfter then spSrcAfter = spFrom.
      if ~spSrcRout and self.syms.ScopeContaining(spFrom, vs:scRoutine, vs:scRoutine) then spSrcRout = spFrom.
    end
    if spWhy then exit.
    spFrom = spNext
  end

! ---- the spQ row spX names the scratch's valuePtr, _DataEnd or getValuePtr(), its tail in spTail. The
!      same words that read the value WRITE it when they are stored into (StoreHead: they begin their
!      statement, follow the DEBUG mark, or are a LOOP's counter - never the first word of a '|'
!      continuation line) - the target of an assignment, `toks._DataEnd = 0` - or when the buffer, a slice of it or the length
!      is handed whole to a call that may write through it (ArgMayWrite). Both are read from the token
!      stream, which a '|' does not break; a bracket the statement never closes counts as a write.
!      Either is a write of the scratch's value, which after the rename is the source's: spValWr, so
!      the join gives the value back before the source is read again
SpBufWrite routine
  data
s    long,auto
e    long,auto
k    long,auto
d    long,auto
t    STRING(vs:maxName),auto
  code
  get(spQ, spX) ; s = spQ.tk
  e = s
  if self.tk.GetTok(s + 1) = '.' then e = s + 2.
  if spTail <> 'GETVALUEPTR' and self.StoreHead(s) then spValWr = 1 ; exit.
  t = self.tk.GetTok(e + 1)
  case t
  of '[' orof '('
    d = 0
    loop k = e + 1 to records(self.tk.tokens)
      t = self.tk.GetTok(k)
      if t = '<10>' then break.
      if t = '[' or t = '(' then d += 1.
      if t = ']' or t = ')' then d -= 1.
      if ~d then break.
    end
    if d then spValWr = 1 ; exit.
    e = k
  end
  if self.ArgMayWrite(s, e, spReads, spSums) then spValWr = 1.

! ---- the copy runs at most once per call
SpOnce routine
  if self.syms.ScopeContaining(spLine1, vs:scRoutine, vs:scRoutine)
    spWhy = 'the copy is in a routine, which may run more than once'
    exit
  end
  spDepth = 0
  loop spX = spLine1 - 1 to spScCode + 1 by -1
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.firstOnLine and upper(self.tk.tokens.tok) = 'CODE' then break.
    if self.syms.IsColOneLabel(spX)
      spWhy = 'a label on line ' & self.LogLineOf(spX) & ' lies before the copy, so it can be reached again'
      exit
    end
    case self.tk.tokens.level
    of '-'
      spDepth += 1
    of '+'
      if spDepth
        spDepth -= 1
      else
        spN = len(clip(self.tk.tokens.tok))
        if spN and (upper(self.tk.tokens.tok[1 : spN]) = 'LOOP' or upper(self.tk.tokens.tok[1 : spN]) = 'ACCEPT')
          spWhy = 'the copy is inside the loop on line ' & self.LogLineOf(spX) & ', so it may run more than once'
          exit
        end
      end
    end
  end

! ---- the copy must RUN before every later mention of the scratch
SpRuns routine
  if self.syms.ScopeContaining(spLast, vs:scRoutine, vs:scRoutine)
    spWhy = clip(spBufTxt) & ' is used on line ' & self.LogLineOf(spLast) & ' in a routine, which may run before the copy'
    exit
  end
  spDepth = 0
  spEol = self.FirstEolAfter(spLine1)
  spY = self.FirstEolAfter(spLast)
  loop spX = spEol + 1 to spY
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      spDepth += 1
    elsif self.tk.tokens.level = '-'
      spDepth -= 1
      if spDepth < 0
        spWhy = 'the structure holding the copy ends on line ' & self.LogLineOf(spX) & ', before ' & clip(spBufTxt) & '''s use on line ' & self.LogLineOf(spLast)
        exit
      end
    elsif self.tk.tokens.level = '/' and ~spDepth
      spWhy = 'line ' & self.LogLineOf(spX) & ' begins another branch of the structure holding the copy, so ' & clip(spBufTxt) & '''s use on line ' & self.LogLineOf(spLast) & ' can run without it'
      exit
    elsif self.syms.IsColOneLabel(spX)
      spWhy = 'a label on line ' & self.LogLineOf(spX) & ' lies between the copy and ' & clip(spBufTxt) & '''s use on line ' & self.LogLineOf(spLast)
      exit
    end
  end
  spDepth = 0
  loop spX = spLine1 - 1 to spScCode + 1 by -1
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      spDepth += 1
    of '+'
      if spDepth
        spDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          spWhy = 'the copy is one arm of the EXECUTE on line ' & self.LogLineOf(spX) & ', and a use of ' & clip(spBufTxt) & ' is another'
        end
        break
      end
    end
  end

! ---- where the join goes: the source is read again after the scratch's last use, and the
!      scratch wrote the value - so in front of the first line, after the structures holding
!      that last use have closed, at the copy's own depth. No later read, or no write: no join.
!      When the structure holding the copy closes first there is no such line, and the site is
!      refused: a join past that close would run where the copy may not have - after an IF the
!      copy sits in, or as a new arm of an EXECUTE whose BEGIN arm holds the copy.
SpJoinPoint routine
  spJoinAt = 0
  if ~spSrcAfter or ~spValWr then exit.
  spDepth = 0
  spEol = self.FirstEolAfter(spLine1)
  spY = self.FirstEolAfter(spLast)
  loop spX = spEol + 1 to spY                                                  ! the depth of the last use, relative to the copy
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.level = '+' then spDepth += 1.
    if self.tk.tokens.level = '-' then spDepth -= 1.
  end
  loop spX = spY + 1 to spScLast                                               ! walk on until it closes
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.level = '+' then spDepth += 1.
    if self.tk.tokens.level = '-' then spDepth -= 1.
    if ~spDepth and self.tk.tokens.firstOnLine and self.tk.tokens.level <> '-' ! the first line at the copy's depth
      if ~self.IsEolTok(spX - 1) then cycle.                                   !   that starts a statement, not a | row
      spJoinAt = spX                                                           !   that is not the closer itself
      break
    end
    if spDepth < 0
      spWhy = 'the structure holding the copy ends on line ' & self.LogLineOf(spX) & ', before ' & |
              clip(spSrcTxt) & ' is read again, so the join would run where the copy may not have'
      exit
    end
  end
  if ~spJoinAt then spWhy = 'no line was found after ' & clip(spBufTxt) & '''s last use for the join to go in front of' ; exit.
  if spSrcAfter < spJoinAt
    spWhy = clip(spSrcTxt) & ' is read on line ' & self.LogLineOf(spSrcAfter) & ', inside the structure that holds ' & clip(spBufTxt) & '''s last use - the join would come too late'
  end

! ---- the join gives the source its value back, so every path from the copy must pass it, and no
!      path may reach it without the copy. No label lies between the copy and the scratch's last use
!      (SpRuns), and a label a GOTO names may not lie between that use and the join either - a jump
!      to it reaches the join without the copy. So a GOTO anywhere between the copy and the join
!      jumps past the join, and refuses.
SpGotoCheck routine
  if ~spJoinAt then exit.
  spY = self.FirstEolAfter(spLast)
  loop spX = spLine1 to spJoinAt - 1
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'GOTO'
      spWhy = 'line ' & self.LogLineOf(spX) & ' jumps with GOTO while ' & clip(spSrcTxt) & '''s value is on loan to ' &   |
              clip(spBufTxt) & ', past the join that gives it back'
      exit
    end
    if spX > spY and self.syms.IsColOneLabel(spX)
      spTail = upper(self.tk.GetTok(spX))
      loop spZ = spScFirst to spScLast
        if upper(self.tk.GetTok(spZ)) <> 'GOTO' or upper(self.tk.GetTok(spZ + 1)) <> spTail then cycle.
        spWhy = 'the label on line ' & self.LogLineOf(spX) & ' lies between ' & clip(spBufTxt) & '''s last use and the' & |
                ' join, and the GOTO on line ' & self.LogLineOf(spZ) & ' can reach the join through it without the copy'
        exit
      end
    end
  end

! ---- a routine shares the locals, so one that mentions the source would find its value on
!      loan if it ran between the copy and the join - or the scratch's last use, when there is
!      no join. The source's mentions all lie in the main code or in routines; a DO on a line of
!      that stretch, when some routine mentions the source, refuses. A DO before the copy, or on
!      the join line itself or after it, runs with the value whole.
SpDoCheck routine
  if ~spSrcRout then exit.
  spY = spLast + 1
  if spJoinAt then spY = spJoinAt.
  spFrom = spLine1 ; do SpFill
  spFrom = spNext
  loop while spFrom > 0 and spFrom < spY
    do SpFill
    loop spX = 1 to records(spQ)
      get(spQ, spX)
      if errorcode() then break.
      if spQ.tx = 'DO'
        spWhy = 'line ' & self.LogLineOf(spFrom) & ' calls a routine while ' & clip(spSrcTxt) & '''s value is on loan to ' & clip(spBufTxt) & ' - a routine mentions ' & clip(spSrcTxt) & ' on line ' & self.LogLineOf(spSrcRout)
        exit
      end
    end
    spFrom = spNext
  end

! ---- THE EDIT: the rename (SetTok moves nothing, and the scope bounds still hold), then the join line
!      (it lies after everything), then the copy line goes
SpEdit routine
  do SpRename
  if spJoinAt
    spInd.free()
    get(self.tk.tokens, spJoinAt)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      spY = 0
      loop spX = 1 to size(self.tk.tokens.strBefore)
        if self.tk.tokens.strBefore[spX] = '<10>' then spY = spX.
      end
      if spY < size(self.tk.tokens.strBefore)
        spInd.setValue(self.tk.tokens.strBefore[spY + 1 : size(self.tk.tokens.strBefore)])
      end
    end
    ! a comment-only line is an EOL token of its own, its comment in that token's strBefore: copied
    ! as an indent it would put the join INSIDE the comment, so the join takes the copy line's indent
    if self.IsEolTok(spJoinAt) then spInd.free().
    ! a line that starts in column 1 starts with a label: the join takes the copy line's indent,
    ! as column 1 would make it a label too
    spShf = self.TxaShiftOf(spJoinAt)
    if ~spInd._DataEnd then self.IndentOf(spLine1, spInd) ; spShf = self.TxaShiftOf(spLine1).
    spTxt.setValue(spInd)
    spTxt.append(clip(spSrcTxt) & '.join(' & clip(spSep) & ')<13,10>')
    self.TxaMarkLines(spTxt, spShf)
    self.InsertLinesAbove(spJoinAt, spTxt)
  end
  spEol = self.FirstEolAfter(spLine1)
  if spEol then spKept = self.DropLinesKeepCmts(spLine1, spEol).
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- every mention of the scratch after the copy line names the source
SpRename routine
  spEol = self.FirstEolAfter(spLine1)
  loop spX = spEol + 1 to spScLast
    if spX = spBufDecl then cycle.
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    spN = len(clip(self.tk.tokens.tok))
    if ~spN then cycle.
    spD = instring('.', self.tk.tokens.tok[1 : spN], 1, 1)
    if spD > 1
      if upper(self.tk.tokens.tok[1 : spD - 1]) = spBuf
        self.tk.SetTok(spX, clip(spSrcTxt) & self.tk.tokens.tok[spD : spN])
      end
    elsif ~spD
      if upper(self.tk.tokens.tok[1 : spN]) = spBuf then self.tk.SetTok(spX, clip(spSrcTxt)).
    end
  end

! ---- the two names as the author spelled them
SpNames routine
  spBufTxt = spBuf ; spSrcTxt = spSrc
  loop spX = spLine1 to records(self.tk.tokens)
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    spN = len(clip(self.tk.tokens.tok))
    if ~spN then cycle.
    spD = instring('.', self.tk.tokens.tok[1 : spN], 1, 1)
    if spD > 1
      if upper(self.tk.tokens.tok[1 : spD - 1]) = spBuf then spBufTxt = self.tk.tokens.tok[1 : spD - 1].
      if upper(self.tk.tokens.tok[1 : spD - 1]) = spSrc then spSrcTxt = self.tk.tokens.tok[1 : spD - 1].
    else
      if upper(self.tk.tokens.tok[1 : spN]) = spBuf then spBufTxt = self.tk.tokens.tok[1 : spN].
      if upper(self.tk.tokens.tok[1 : spN]) = spSrc then spSrcTxt = self.tk.tokens.tok[1 : spN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into spQ with their token index; a split
!      dotted CALL joined into one row
SpFill routine
  free(spQ)
  spNext = 0
  loop spX = spFrom to records(self.tk.tokens)
    get(self.tk.tokens, spX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      spNext = spX + 1 ; break
    end
    if spX > spFrom and self.tk.tokens.firstOnLine
      spNext = spX ; break
    end
    spQ.tx = upper(self.tk.tokens.tok) ; spQ.tk = spX
    add(spQ)
  end
  if ~spNext then spNext = records(self.tk.tokens) + 1.
  spX = 2
  loop while spX < records(spQ)
    get(spQ, spX)
    if errorcode() then break.
    if spQ.tx <> '.' then spX += 1 ; cycle.
    get(spQ, spX - 1)
    if errorcode() or ~((spQ.tx[1] >= 'A' and spQ.tx[1] <= 'Z') or spQ.tx[1] = '_') then spX += 1 ; cycle.
    spHead = spQ.tx ; spZ = spQ.tk
    get(spQ, spX + 1)
    if errorcode() or ~((spQ.tx[1] >= 'A' and spQ.tx[1] <= 'Z') or spQ.tx[1] = '_') then spX += 1 ; cycle.
    spTail = spQ.tx
    delete(spQ)
    get(spQ, spX)
    delete(spQ)
    get(spQ, spX - 1)
    spQ.tx = clip(spHead) & '.' & spTail ; spQ.tk = spZ
    put(spQ)
  end

! ---- spHead = the RECEIVER in front of the spQ row at spHeadIx
SpHead routine
  spHead = ''
  get(spQ, spHeadIx)
  if errorcode() then exit.
  spN = len(clip(spQ.tx))
  if ~spN then exit.
  spD = instring('.', spQ.tx[1 : spN], 1, 1)
  if spD > 1 then spHead = spQ.tx[1 : spD - 1].
!===============================================================================================
! BUILTIN ResplitToLines - a joined range of one object's lines, split again on the same
! separator, is those lines: the copy folds into the object. 13 Sep 2026, the last step
! of the one-object ParseSettingsLine.
!
!     rest.setValue(full.getLines(2, 0, ' '))         full.deleteLine(1)
!     rest.trim()                                     loop i = 1 to full.records()
!     rest.split(' ')                                   full.setValueFromLine(i)
!     loop i = 1 to rest.records()              ->      if ~full._DataEnd then cycle.
!       rest.setValueFromLine(i)                        ...
!       if ~rest._DataEnd then cycle.                 end
!       ...                                           full.join(' ')
!     end                                             full.trim()
!     rest.join(' ')                                  ... full.getValue()
!     ... rest.getValue()
!
! EXACT, from the library, when the object's lines are the pieces of a plain split on that same
! separator, so that none of them holds it: joining lines 2 to the end with the separator and
! splitting the result on it gives those lines back, empty pieces included - a split and a join
! with one separator are each other's inverse - so the copy's lines ARE the object's lines from 2
! on, and deleting line 1 makes them lines 1 on. A range from line 1 folds with nothing to delete.
!
! THE TRIM. A trim() or clip() of the copy between the copy and the split only ever removes EMPTY
! PIECES at the ends: each edge space is an empty piece when the separator is the space, and with
! the separator itself as the alphabet the same holds for any separator. So it is allowed to
! stand there, and it moves: when every loop over the lines throws an empty piece away as its
! first act (setValueFromLine, then `if ~x._DataEnd then cycle.`), the loop does the same work
! with or without those pieces - only its index counts them, so the index may be read nowhere
! but the loop's own line and the load - and the trim is written again after the join, where it
! gives the stored value back byte for byte. The move is made ONLY as part of a fold that goes
! through; there is no rule that moves a trim on its own. Ruled 13 Sep 2026.
!
! The library deletes one line at a time, so a range from line n is n - 1 deletions of line 1 - never
! a numbered range, which would shift under its own feet (13 Sep 2026).
!
! WHAT IT REFUSES, each with its reason: the range not running to the end; the object's lines not
! made by a plain split on the separator that runs on every path to the copy, with nothing writing
! them after it; for a range from line 1 with no trim, the object's value changed after that split,
! so that it is no longer its lines joined; the object's value changed between the copy and the
! split (a store through its buffer, or the buffer handed to a call that may write it, is a change);
! the object STATIC or THREAD, or reachable without its name (a reference, a method
! of a class the procedure declares, a call it is handed to); the copy named in such a method;
! the copy mentioned before the copy line, or between
! the copy and the split except for that one trim; the object's lines read after the copy, or the
! object mentioned at all after the split (its value is the copy's from then on); the copy
! writing its lines, handed whole to a call, assigned by reference, or a parameter or reference;
! the object a parameter or a reference; either named in a method of a class the procedure
! declares; the object reached under another name - a reference taken on it, a call that may keep
! one; either given Stream(); the split not plain, or on another separator; a trim
! whose alphabet is not the separator; with a trim, any read of the lines outside a loop that
! skips empty pieces first, a read of the value between the split and the first loop, a join on
! another separator, a read of the value after the loops with no join before it, or a loop index
! that is not a local of the procedure or is read outside its loop's own line and load; with no
! trim and a range from line 2 or later, the same but for the join, where any join will do - those
! lines may be one empty line, which gives the copy no lines and the object one (ruled 29 Oct 2026),
! and the copy holds those lines joined where the object keeps its own value; a line that
! goes carrying a comment; the copy able to run twice or a use able to run without it. A copy that
! is never split is not this shape at all, and nothing is said of it, whatever else is wrong.
!===============================================================================================
VitEngine.BuiltinResplitToLines Procedure(StringTheory pLog)
i           long,auto
rsX         long,auto
rsY         long,auto
rsZ         long,auto
rsD         long,auto
rsN         long,auto
rsLine1     long,auto          ! first token of the copy line
rsLine2     long               !   of the trim line, 0 = none
rsLine3     long               !   of the split line
rsEol       long,auto
rsFrom      long,auto
rsNext      long,auto
rsHeadIx    long
rsHead      STRING(vs:maxName)
rsTail      STRING(96)
rsBuf       STRING(vs:maxName) ! the copy, folded
rsSrc       STRING(vs:maxName) ! the object, folded
rsBufTxt    STRING(vs:maxName)
rsSrcTxt    STRING(vs:maxName)
rsSep       STRING(96)         ! the separator literal, as written
rsA         long               ! the range's first line: 1 or 2
rsTrimCall  STRING(8)          ! TRIM or CLIP, as folded; blank = no trim line
rsTrimTxt   STRING(96)         ! the call as written, with its argument: `trim()` or `clip(',')`
rsScFirst   long,auto
rsScLast    long,auto
rsMarkAt    long,auto          ! the first mention that can set the copy's marks (MarkSetterAt)
rsMarkEnc   byte,auto
rsScCode    long,auto
rsSc        long,auto
rsLast      long               ! first token of the copy's last mention
rsJoinLine  long               !   of the join line after the loops, 0 = none
rsValAfter  long               !   of the first read of the copy's VALUE after the loops
rsJDep      long               ! RsTrimGuard: the depth outside the loops, from the level marks
rsJd        long               !   the depth of the join that carries the moved trim, in force; 9999 = none
rsJPend     long               !   that join on the line in hand, in force from the next line
rsLoopHdr   long               ! RsSkipLoop: the loop header in hand
rsLoopIx    STRING(vs:maxName) !   its index, folded
rsLoadAt    long               !   and its load line
rsSkipWhy   STRING(120)        ! RsTrimGuard: why the lines must be read in a loop that skips an empty piece first
rsBodyRd    STRING(60)         !   and the line reads a loop's body may not make: rsLineRd with a trim, none without
rsValWhy    STRING(120)        ! RsTrimGuard: why the copy's value differs there, between the split and a loop
rsValAft    STRING(120)        !   and after the loops
rsBufDecl   long
rsSrcDecl   long
rsLineNo    long
rsWhy       STRING(200)
rsRpt       byte
rsEdited    byte
rsSums      byte               ! RsBufWrite: the summaries are built for this call
rsDepth     long,auto
rsInd       StringTheory
rsShf       byte
rsDlInd     StringTheory       ! a line break and the indent, between the deleteLines
rsCmt       StringTheory       ! the first line's trailing comment, kept on it
rsTxt       StringTheory
rsSb        StringTheory
rsReads     EQUATE(' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH LEN SLICE SUB CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS COUNT CLIPLENGTH ')
rsLineRd    EQUATE(' RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE ')
rsNotVal    EQUATE(' RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE SETVALUE FREE SPLIT JOIN ')
rsLinesWr   EQUATE(' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN SORT ADDLINE SETLINE INSERTLINE DELETELINE REMOVELINES FREELINES SWAP LINES SETLINEFROMVALUE START FILTER WRAPTEXT ')
rsLinesAny  EQUATE(                                                                                                |
  ' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE ' & |
    'SETLINEFROMVALUE SETLINE ADDLINE INSERTLINE DELETELINE REMOVELINES SORT FREELINES JOIN LINES SWAP ')
rsQ         QUEUE,PRE(rs)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  rsEdited = 0
  if self.curPass = 1
    rsRpt = 1 ; do RsScan
  end
  rsRpt = 0 ; do RsScan
  return rsEdited

! ---- every line of the file
RsScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    rsLine1 = i
    rsFrom = rsLine1 ; do RsFill
    do RsShape                                                             ! <buf>.setValue(<src>.getLines(a, 0, 'sep'))
    if ~rsBuf then cycle.
    do RsScope
    if ~rsScFirst then cycle.
    do RsNames
    do RsDeclCheck
    if ~rsBuf then cycle.
    do RsBetween                                                           ! the split first, then the optional trim and the object's reads
    if ~rsLine3 then cycle.                                                ! no split of the copy: not this pass's shape, refused or not
    if ~rsWhy then do RsUses.                                              ! the copy's later mentions, and the object's
    if ~rsWhy then do RsOnce.
    if ~rsWhy then do RsRuns.
    if ~rsWhy then do RsSplitDom.                                          ! the object's lines are a plain split's, on the separator
    if ~rsWhy and (rsTrimCall or rsA > 1) then do RsTrimGuard.             ! the value read only where it is the object's
    if rsWhy
      if rsRpt
        pLog.append('BUILTIN ResplitToLines line ' & self.LogLineOf(rsLine1) & ': REFUSED - ' & clip(rsWhy) & '.<13,10>')
      end
      cycle
    end
    if rsRpt then cycle.
    rsLineNo = self.LogLineOf(rsLine1)
    do RsEdit
    pLog.append('BUILTIN ResplitToLines line ' & rsLineNo & ': ' & clip(rsBufTxt) & ' only ever holds '                   &                                                                   |
                choose(rsA = 1, 'all', 'lines ' & rsA & ' on') & ' of ' & clip(rsSrcTxt) & '''s lines, split again, so '  &                                                                   |
                clip(rsSrcTxt) & '''s own lines are used' & choose(rsA = 1, '', choose(rsA = 2, ' and line 1 is deleted',                                                                     |
                ' and the ' & (rsA - 1) & ' lines before them are deleted, line 1 each time'))                            &                                                                   |
                choose(~rsTrimCall, '', choose(rsValAfter > 0, ' - the '                                                  &                                                                   |
                                                choose(rsTrimCall = 'SETLEFT', 'setLeft', choose(rsTrimCall = 'SETRIGHT', 'setRight', lower(clip(rsTrimCall)))) & ' moved to after the join', |
                                                ' - the ' & choose(rsTrimCall = 'SETLEFT', 'setLeft',                                                                                         |
                                                choose(rsTrimCall = 'SETRIGHT', 'setRight', lower(clip(rsTrimCall)))) & ' had nothing left to do and went')) & '.<13,10>')
    rsEdited = 1
    exit
  end

! ---- <buf>.setValue( <src>.getLines( a , b , 'sep' ) ) and nothing else on the line
RsShape routine
  rsBuf = '' ; rsSrc = '' ; rsSep = '' ; rsA = 0 ; rsWhy = '' ! a refusal found here must survive
  if records(rsQ) <> 11 then exit.
  rsHeadIx = 1 ; do RsHead
  get(rsQ, 1)
  rsN = len(clip(rsQ.tx))
  rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
  if ~rsHead or ~rsD or rsD >= rsN or rsQ.tx[rsD + 1 : rsN] <> 'SETVALUE' then exit.
  rsBuf = rsHead
  get(rsQ, 2) ; if rsQ.tx <> '(' then rsBuf = '' ; exit.
  rsHeadIx = 3 ; do RsHead
  get(rsQ, 3)
  rsN = len(clip(rsQ.tx))
  rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
  if ~rsHead or ~rsD or rsD >= rsN or rsQ.tx[rsD + 1 : rsN] <> 'GETLINES' then rsBuf = '' ; exit.
  rsSrc = rsHead
  if rsSrc = rsBuf then rsBuf = '' ; exit.
  get(rsQ, 4) ; if rsQ.tx <> '(' then rsBuf = '' ; exit.
  get(rsQ, 6) ; if rsQ.tx <> ',' then rsBuf = '' ; exit.
  get(rsQ, 8) ; if rsQ.tx <> ',' then rsBuf = '' ; exit.
  get(rsQ, 10) ; if rsQ.tx <> ')' then rsBuf = '' ; exit.
  get(rsQ, 11) ; if rsQ.tx <> ')' then rsBuf = '' ; exit.
  get(rsQ, 9)
  if rsQ.tx[1] <> '''' then rsBuf = '' ; exit.
  rsSep = self.tk.GetTok(rsQ.tk)
  get(rsQ, 5)
  rsN = len(clip(rsQ.tx))
  if ~rsN or rsN > 4 then rsBuf = '' ; exit.
  loop rsY = 1 to rsN
    if rsQ.tx[rsY] < '0' or rsQ.tx[rsY] > '9' then rsBuf = '' ; exit.
  end
  rsA = rsQ.tx
  if rsA < 1 then rsBuf = '' ; exit.
  get(rsQ, 7)
  if rsQ.tx <> '0' and ~rsWhy then rsWhy = 'the range does not run to the end of the lines (' & clip(rsQ.tx) & ' as its last), so it is not the object''s remaining lines'.

! ---- the procedure and the end of its header
RsScope routine
  rsScFirst = 0 ; rsScLast = 0 ; rsScCode = 0
  rsSc = self.syms.ScopeContaining(rsLine1, vs:scProc, vs:scMethod)
  if ~rsSc then exit.
  self.syms.scopes.scopeId = rsSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  rsScFirst = self.syms.scopes.startTok
  rsScLast  = self.syms.scopes.endTok
  rsZ = 0
  loop rsX = rsScFirst to records(self.tk.tokens)
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      rsZ += 1
    elsif self.tk.tokens.tok = ')'
      rsZ -= 1
      if ~rsZ then rsScCode = rsX ; break.
    elsif ~rsZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      rsScCode = rsX ; break
    end
  end
  if ~rsScCode then rsScCode = rsScFirst.

! ---- both StringTheory LOCALS, neither a reference. Neither may be named in a method of a class the
!      procedure declares - such a method shares the procedure's data, and its body lies outside every
!      walk here. Nor may the object be reached under another name - a reference taken on it, a call
!      that may keep one - through which its lines and value, which the fold changes, are read unseen;
!      and neither may be given Stream(), whose file receives each value it holds.
RsDeclCheck routine
  rsBufDecl = 0 ; rsSrcDecl = 0
  rsZ = self.syms.FindOwn(rsSrc, rsSc)
  if ~rsZ then rsBuf = '' ; exit.
  get(self.syms.syms, rsZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then rsBuf = '' ; exit.
  rsSrcDecl = self.syms.syms.declTok
  if (self.syms.syms.declTok > rsScFirst and self.syms.syms.declTok <= rsScCode)
    rsWhy = clip(rsSrcTxt) & ' is a PARAMETER - its lines are the caller''s, and the fold deletes one'
    exit
  end
  if self.syms.syms.isRef then rsWhy = clip(rsSrcTxt) & ' is a reference - what it points at is not this procedure''s' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    rsWhy = clip(rsSrcTxt) & ' is STATIC or THREAD - its lines last to the next call, which would find line 1 gone'
    exit
  end
  if self.MayHaveLocalMethods(rsSc) and self.UsedInLocalMethods(upper(rsSrc), rsScFirst, rsScLast)
    rsWhy = clip(rsSrcTxt) & ' is used in a method of a class this procedure declares, which can read its lines and value after the fold'
    exit
  end
  if ~rsWhy then rsWhy = self.ObjReach(upper(rsSrc), rsLine1, 3).
  rsZ = self.syms.FindOwn(rsBuf, rsSc)
  if ~rsZ then rsWhy = clip(rsBufTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, rsZ)
  rsBufDecl = self.syms.syms.declTok
  if errorcode() or (self.syms.syms.declTok > rsScFirst and self.syms.syms.declTok <= rsScCode)
    rsWhy = clip(rsBufTxt) & ' is a PARAMETER, so it is not this procedure''s to fold away'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then rsWhy = clip(rsBufTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then rsWhy = clip(rsBufTxt) & ' is a reference - what it points at is not this procedure''s to fold away'.
  if ~rsWhy and self.MayHaveLocalMethods(rsSc) and self.UsedInLocalMethods(upper(rsBuf), rsScFirst, rsScLast)
    rsWhy = clip(rsBufTxt) & ' is used in a method of a class this procedure declares, which the fold would not reach'
  end
  if ~rsWhy then rsWhy = self.ObjReach(upper(rsBuf), rsLine1, 2).

! ---- where the object's lines come from. Joined and split again, a line comes back as itself only
!      when it does not hold the separator, and that is known only of the pieces of a plain split on
!      that same separator. So such a split of the object must run on every path to the copy: in
!      the main code above it, at its level or an enclosing one - not in an arm of an IF, CASE or
!      EXECUTE that has closed - with no label after it, and nothing after it writing the object's
!      lines, handing the object whole to a call, or calling a routine.
!      THE VALUE. Right after a plain split the object's value is its lines joined on the separator,
!      and a range from line 1 with no trim folds on that alone: the copy's value reads become the
!      object's. So for that fold nothing after the split may change the object's value either - a
!      method that is not a read, a store through its buffer, the buffer, a slice of it or the length
!      handed to a call that may write it (RsBufWrite). A range from line 2 on, or a trim, has every
!      read of the copy's value judged by RsTrimGuard instead.
RsSplitDom routine
  data
sdAt    long
sdDepth long
sdLevel long
sdWr    byte,auto
sdR     long,auto
sdK     long,auto
sdVal   long
  code
  rsFrom = self.CodeTokOfScope(rsScFirst, rsScLast)
  if ~rsFrom or rsFrom >= rsLine1 then rsFrom = rsLine1.
  do RsFill
  rsFrom = rsNext
  loop while rsFrom > 0 and rsFrom < rsLine1
    do RsFill
    if self.syms.IsColOneLabel(rsFrom) then sdAt = 0.
    sdWr = 0
    loop sdR = 1 to records(rsQ)
      rsHeadIx = sdR ; do RsHead
      get(rsQ, sdR)
      if errorcode() then break.
      if rsHead = rsSrc and rsD < rsN
        rsTail = rsQ.tx[rsD + 1 : rsN]
        if instring(' ' & clip(rsTail) & ' ', rsLinesWr, 1, 1) then sdWr = 1.
        case rsTail
        of 'FREE'
          get(rsQ, sdR + 2)
          if ~errorcode() and rsQ.tx <> ')' then sdWr = 1.
        of 'SETVALUE' orof 'APPEND' orof 'PREPEND'
          get(rsQ, sdR)
          if self.LinesOptAt(rsQ.tk) then sdWr = 1.
        end
        if sdAt and ~sdVal
          if rsTail = '_DATAEND' or rsTail = 'VALUEPTR' or rsTail = 'GETVALUEPTR'
            rsX = sdR ; do RsBufWrite
            if rsZ then sdVal = rsFrom.
          elsif ~instring(' ' & clip(rsTail) & ' ', rsReads & 'RECORDS GETLINE GETLINES INLINE ', 1, 1)
            sdVal = rsFrom
          end
        end
      elsif rsQ.tx = rsSrc or rsQ.tx = 'DO'
        sdWr = 1
      end
    end
    if sdWr
      sdAt = 0 ; sdVal = 0
      if records(rsQ) = 4 and ~self.ArmOfExecute(rsFrom)
        get(rsQ, 1) ; rsTail = rsQ.tx
        get(rsQ, 3)
        if rsTail = clip(rsSrc) & '.SPLIT' and self.tk.GetTok(rsQ.tk) = rsSep then sdAt = rsFrom ; sdDepth = sdLevel.
      end
    end
    loop sdK = rsFrom to rsNext - 1
      get(self.tk.tokens, sdK)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      case self.tk.tokens.level
      of '+'
        sdLevel += 1
      of '-'
        sdLevel -= 1
        if sdLevel < sdDepth then sdAt = 0.
      of '/'
        if sdLevel = sdDepth then sdAt = 0.
      end
    end
    rsFrom = rsNext
  end
  if ~sdAt
    rsWhy = 'the lines of ' & clip(rsSrcTxt) & ' are not all from a plain split on ' & clip(rsSep) &           |
            ' that runs on every path to the copy - another line may hold the separator, and come back as two'
  elsif sdVal and rsA = 1 and ~rsTrimCall
    rsWhy = clip(rsSrcTxt) & '''s value is changed on line ' & self.LogLineOf(sdVal) & ' after its split'
    rsWhy = clip(rsWhy) & ', so it is no longer its lines joined, which ' & clip(rsBufTxt) & ' holds'
  end

! ---- rsZ = how the rsQ row rsX - the object's valuePtr, _DataEnd or getValuePtr(), its tail in rsTail -
!      writes the object's value, though the same words elsewhere only read it: 2 a store (StoreHead:
!      it begins its statement, follows the DEBUG mark, or is a LOOP's counter - never the first word
!      of a '|' continuation line); 1 the buffer, a slice of it or the length handed whole to a
!      call that may write through it (ArgMayWrite), or a bracket the statement never closes; 0
!      neither. Both are read from the token stream, which a '|' does not break
RsBufWrite routine
  data
s    long,auto
e    long,auto
k    long,auto
d    long,auto
t    STRING(vs:maxName),auto
  code
  rsZ = 0
  get(rsQ, rsX) ; s = rsQ.tk
  e = s
  if self.tk.GetTok(s + 1) = '.' then e = s + 2.
  if rsTail <> 'GETVALUEPTR' and self.StoreHead(s) then rsZ = 2 ; exit.
  t = self.tk.GetTok(e + 1)
  case t
  of '[' orof '('
    d = 0
    loop k = e + 1 to records(self.tk.tokens)
      t = self.tk.GetTok(k)
      if t = '<10>' then break.
      if t = '[' or t = '(' then d += 1.
      if t = ']' or t = ')' then d -= 1.
      if ~d then break.
    end
    if d then rsZ = 1 ; exit.
    e = k
  end
  rsZ = self.ArgMayWrite(s, e, rsReads, rsSums)

! ---- from the copy line to the split line: the optional trim right after the copy, then any
!      lines that mention neither, or the object as a value read only; then the split. The split
!      is found first, whatever was found wrong before: a copy that is never split is not this
!      pass's shape, and nothing is said of it. A refusal found before stands once it is
RsBetween routine
  rsLine2 = 0 ; rsLine3 = 0 ; rsTrimCall = '' ; rsTrimTxt = ''
  rsFrom = rsLine1 ; do RsFill
  rsFrom = rsNext
  loop while rsFrom > 0 and rsFrom < rsScLast ! first: is the copy split at all? Else silence
    do RsFill
    rsHeadIx = 1 ; do RsHead
    if rsHead = rsBuf
      get(rsQ, 1)
      rsN = len(clip(rsQ.tx))
      rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
      if rsD and rsD < rsN and rsQ.tx[rsD + 1 : rsN] = 'SPLIT' then rsLine3 = rsFrom ; break.
    end
    rsFrom = rsNext
  end
  if ~rsLine3 then exit.
  if rsWhy then exit.
  rsFrom = rsLine1 ; do RsFill
  rsFrom = rsNext
  loop while rsFrom > 0 and rsFrom <= rsLine3
    do RsFill
    rsHeadIx = 1 ; do RsHead
    if rsHead = rsBuf and records(rsQ) >= 3
      get(rsQ, 1)
      rsN = len(clip(rsQ.tx))
      rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
      rsTail = rsQ.tx[rsD + 1 : rsN]
      if rsTail = 'SPLIT'                     ! the split: plain, on the same separator, alone
        if records(rsQ) <> 4 then rsWhy = 'the split of ' & clip(rsBufTxt) & ' on line ' & self.LogLineOf(rsFrom) & ' is not plain, so its pieces are not the lines' ; exit.
        get(rsQ, 3)
        if self.tk.GetTok(rsQ.tk) <> rsSep then rsWhy = clip(rsBufTxt) & ' is split on line ' & self.LogLineOf(rsFrom) & |
           ' on a different separator from the one it was joined with, so its pieces are not the lines' ; exit.
        exit
      end
      if (rsTail = 'TRIM' or rsTail = 'CLIP' or rsTail = 'SETLEFT' or rsTail = 'SETRIGHT') and ~rsLine2 ! the one trim, and only right after the copy
        do RsTrimShape
        if rsWhy then exit.
        if rsTrimCall then rsFrom = rsNext ; cycle.
      end
      rsWhy = clip(rsBufTxt) & ' is used on line ' & self.LogLineOf(rsFrom) & ' before the split, so at the split it no longer holds the joined lines'
      exit
    end
    loop rsX = 1 to records(rsQ)              ! the object between the copy and the split: value reads only
      rsHeadIx = rsX ; do RsHead
      get(rsQ, rsX)
      if errorcode() then break.
      if rsHead = rsBuf or rsQ.tx = rsBuf
        rsWhy = clip(rsBufTxt) & ' is used on line ' & self.LogLineOf(rsFrom) & ' before the split, so at the split it no longer holds the joined lines'
        exit
      end
      if rsHead = rsSrc
        rsN = len(clip(rsQ.tx))
        rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
        rsTail = rsQ.tx[rsD + 1 : rsN]
        if instring(' ' & clip(rsTail) & ' ', rsLinesAny, 1, 1)
          rsWhy = clip(rsSrcTxt) & '''s lines are read on line ' & self.LogLineOf(rsFrom) & ' after the copy (' & lower(clip(rsTail)) & '), and the fold deletes line 1'
          exit
        end
        if ~instring(' ' & clip(rsTail) & ' ', rsReads, 1, 1)
          rsWhy = clip(rsSrcTxt) & ' is changed on line ' & self.LogLineOf(rsFrom) & ' (' & lower(clip(rsTail)) & ') between the copy and the split'
          exit
        end
        case rsTail
        of '_DATAEND' orof 'VALUEPTR' orof 'GETVALUEPTR'
          do RsBufWrite
          if rsZ
            rsWhy = clip(rsSrcTxt) & ' is changed on line ' & self.LogLineOf(rsFrom) & ' (its ' & lower(clip(rsTail)) & ') between the copy and the split'
            exit
          end
        end
      elsif rsQ.tx = rsSrc
        rsWhy = clip(rsSrcTxt) & ' is handed whole to a call on line ' & self.LogLineOf(rsFrom) & ' between the copy and the split'
        exit
      end
    end
    if rsWhy then exit.
    rsFrom = rsNext
  end

! ---- the trim line in rsQ: <buf>.trim() / .clip() bare (separator the space) or with the
!      separator as its alphabet; rsTrimCall blank when it is something else
RsTrimShape routine
  rsTrimCall = ''
  get(rsQ, 2) ; if rsQ.tx <> '(' then exit.
  case records(rsQ)
  of 3
    get(rsQ, 3) ; if rsQ.tx <> ')' then exit.
    if rsSep <> ''' ''' and rsSep <> '''<<32>'''
      rsWhy = clip(rsBufTxt) & '.' & lower(clip(rsTail)) & '() on line ' & self.LogLineOf(rsFrom) & |
         ' strips spaces, which are not the separator ' & clip(rsSep) & ' - the pieces it removes are not empty ones'
      exit
    end
    rsTrimTxt = choose(rsTail = 'SETLEFT', 'setLeft', choose(rsTail = 'SETRIGHT', 'setRight', lower(clip(rsTail)))) & '()'
  of 4
    get(rsQ, 4) ; if rsQ.tx <> ')' then exit.
    get(rsQ, 3)
    if self.tk.GetTok(rsQ.tk) <> rsSep
      rsWhy = clip(rsBufTxt) & '.' & lower(clip(rsTail)) & '(' & self.tk.GetTok(rsQ.tk) & ') on line ' & self.LogLineOf(rsFrom) & |
         ' strips something other than the separator ' & clip(rsSep) & ' - the pieces it removes are not empty ones'
      exit
    end
    case rsTail
    of 'SETLEFT' orof 'SETRIGHT'
      rsWhy = clip(rsBufTxt) & '.' & choose(rsTail = 'SETLEFT', 'setLeft', 'setRight') & '(...) on line ' & |
         self.LogLineOf(rsFrom) & ' is not the bare call - an argument gives it a length or a padding, not an alphabet'
      exit
    end
    rsTrimTxt = lower(clip(rsTail)) & '(' & clip(rsSep) & ')'
  else
    exit
  end
  if rsTail <> 'CLIP'            ! clip() shortens in place; the other three reach SetValue
    rsMarkAt = self.MarkSetterAt(rsBuf, rsScFirst, rsScLast, rsMarkEnc)
    if rsMarkAt
      rsWhy = clip(rsBufTxt) & '.' & lower(clip(rsTail)) & '() on line ' & self.LogLineOf(rsFrom) & ' is a setValue, which clears the base64 flag and the encoding that line ' & |
              self.LogLineOf(rsMarkAt) & ' can set - moved after the join it would clear them later'
      exit
    end
  end
  rsTrimCall = rsTail
  rsLine2 = rsFrom

! ---- the copy's mentions: none before the copy; after the split only reads of the lines, loads
!      from them, and changes of the value; the object mentioned nowhere after the split. Code the
!      procedure INCLUDEs is not in this file, so an INCLUDE refuses: it may mention either.
RsUses routine
  rsLast = 0 ; rsJoinLine = 0 ; rsValAfter = 0
  if self.ScopeIncludes(rsSc)
    rsWhy = clip(rsSrcTxt) & ' and ' & clip(rsBufTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  rsFrom = rsScFirst
  loop while rsFrom > 0 and rsFrom < rsScLast
    do RsFill
    if rsFrom = rsBufDecl or rsFrom = rsSrcDecl or rsFrom = rsLine1 or rsFrom = rsLine2 or rsFrom = rsLine3 then rsFrom = rsNext ; cycle.
    loop rsX = 1 to records(rsQ)
      rsHeadIx = rsX ; do RsHead
      get(rsQ, rsX)
      if errorcode() then break.
      if rsHead = rsBuf
        if rsFrom < rsLine1
          rsWhy = clip(rsBufTxt) & ' is mentioned before the copy, on line ' & self.LogLineOf(rsFrom)
          exit
        end
        rsLast = rsFrom
        rsN = len(clip(rsQ.tx))
        rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
        rsTail = rsQ.tx[rsD + 1 : rsN]
        if instring(' ' & clip(rsTail) & ' ', rsLinesWr, 1, 1)
          rsWhy = clip(rsBufTxt) & '.' & lower(clip(rsTail)) & ' on line ' & self.LogLineOf(rsFrom) & ' writes its lines, which after the fold are ' & clip(rsSrcTxt) & '''s'
          exit
        end
        case rsTail
        of 'FREE'
          get(rsQ, rsX + 2)
          if ~errorcode() and rsQ.tx <> ')' then rsWhy = clip(rsBufTxt) & '.free(...) on line ' & self.LogLineOf(rsFrom) & ' frees its lines' ; exit.
        of 'SETVALUE' orof 'APPEND' orof 'PREPEND'
          get(rsQ, rsX)
          rsY = self.LinesOptAt(rsQ.tk)
          if rsY then rsWhy = clip(rsBufTxt) & '.' & lower(clip(rsTail)) & ' on line ' & self.LogLineOf(rsFrom) & choose(rsY = 1, ' copies lines in', ' may copy lines in - its option may hold st:lines') ; exit.
        of 'JOIN'
          get(rsQ, rsX + 2)
          if errorcode() or self.tk.GetTok(rsQ.tk) <> rsSep
            rsWhy = clip(rsBufTxt) & '.join on line ' & self.LogLineOf(rsFrom) & ' joins with something other than the separator, so a moved trim would not give the value back'
            exit
          end
          if ~rsJoinLine then rsJoinLine = rsFrom.
        end
      elsif rsQ.tx = rsBuf
        get(rsQ, rsX + 1)
        if errorcode() or rsQ.tx <> '.'
          if rsFrom < rsLine1
            rsWhy = clip(rsBufTxt) & ' is mentioned before the copy, on line ' & self.LogLineOf(rsFrom)
          elsif ~errorcode() and rsQ.tx = '&='
            rsWhy = clip(rsBufTxt) & ' is assigned by reference on line ' & self.LogLineOf(rsFrom)
          else
            rsWhy = clip(rsBufTxt) & ' is handed whole to a call on line ' & self.LogLineOf(rsFrom) & ', which could split it'
          end
          exit
        end
      elsif rsFrom > rsLine3 and (rsHead = rsSrc or rsQ.tx = rsSrc)
        rsWhy = clip(rsSrcTxt) & ' is mentioned on line ' & self.LogLineOf(rsFrom) & ' after the split - after the fold its value is ' & clip(rsBufTxt) & '''s, line by line'
        exit
      end
    end
    if rsWhy then exit.
    rsFrom = rsNext
  end
  if ~rsLast then rsWhy = clip(rsBufTxt) & ' is never used after the split, so there is nothing to fold'.

! ---- with a trim: every read of the copy's lines is a loop that skips an empty piece first;
!      no read of the value between the split and the first such loop; after the loops, a
!      value read only behind the join the moved trim is written after, certain to have run:
!      at the read's depth or one around it - a join inside an IF covers nothing after the IF's
!      END, and an ELSE puts it out of force - with no loop over the lines and no other join
!      since, each of which leaves the value without the trim. The trim lands on the line after
!      the join, so the join covers from the next line on.
!      With no trim, for a range that starts after line 1: the copy's value is those lines
!      joined, and the object keeps its own, so the same two value tests hold, and any join counts.
!      The lines are the same lines but in one case: lines n on that are one empty line join to
!      nothing, which splits into no lines, and the object keeps its one empty line. So, as with the
!      trim, every read of the lines is a loop that skips an empty piece first, and its index is its
!      own (ruled 29 Oct 2026).
RsTrimGuard routine
  rsFrom = rsScFirst
  rsLoopHdr = 0 ; rsJDep = 0 ; rsJd = 9999 ; rsJPend = 9999
  if rsTrimCall
    rsValWhy = 'the trim made a difference'
    rsValAft = 'so the moved trim could not give it back'
    rsSkipWhy = 'the trim cannot move past it'
    rsBodyRd = rsLineRd
  else
    rsValWhy = 'it holds lines ' & rsA & ' on, joined, and ' & clip(rsSrcTxt) & ' its own value'
    rsValAft = 'so after the fold it would read ' & clip(rsSrcTxt) & '''s own value, which can differ'
    rsSkipWhy = 'lines ' & rsA & ' on that are one empty line give the copy no lines and ' & clip(rsSrcTxt) & ' one'
    rsBodyRd = ''
  end
  loop while rsFrom > 0 and rsFrom < rsScLast
    do RsFill
    if rsFrom <= rsLine3 then rsFrom = rsNext ; cycle.
    rsHeadIx = 1 ; do RsHead
    get(rsQ, 1)
    if rsQ.tx = 'LOOP' and records(rsQ) >= 6 ! loop i = 1 to <buf>.records()
      get(rsQ, 3) ; rsTail = rsQ.tx          ! each row read into its own holder: a
      get(rsQ, 4) ; rsTxt.setValue(rsQ.tx)   !   later get() overwrites the buffer
      get(rsQ, 5) ; rsSb.setValue(rsQ.tx)
      rsHeadIx = 6 ; do RsHead
      get(rsQ, 6)
      rsN = len(clip(rsQ.tx))
      rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
      if rsTail = '=' and rsTxt.getValue() = '1' and rsSb.getValue() = 'TO' and rsHead = rsBuf and rsD and rsQ.tx[rsD + 1 : rsN] = 'RECORDS'
        rsLoopHdr = rsFrom
        do RsSkipLoop
        if rsWhy then exit.
        rsJd = 9999
        rsFrom = rsNext ; cycle
      end
    end
    loop rsX = 1 to records(rsQ)
      do RsTrimLevel
      rsHeadIx = rsX ; do RsHead
      get(rsQ, rsX)
      if errorcode() then break.
      if rsHead <> rsBuf then cycle.
      rsN = len(clip(rsQ.tx))
      rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
      rsTail = rsQ.tx[rsD + 1 : rsN]
      if rsTail = 'JOIN'
        ! with the trim, only the join it is written after gives the value back; with none, any join
        if rsFrom = rsJoinLine or ~rsTrimCall then rsJPend = rsJDep else rsJd = 9999.
        cycle
      end
      if instring(' ' & clip(rsTail) & ' ', rsLineRd, 1, 1) and rsFrom <> rsLoopHdr and ~rsDepth
        rsWhy = 'line ' & self.LogLineOf(rsFrom) & ' reads ' & clip(rsBufTxt) & '''s lines (' & lower(clip(rsTail)) & ') outside a loop that skips empty pieces first, so ' & rsSkipWhy
        exit
      end
      if ~rsLoopHdr and ~instring(' ' & clip(rsTail) & ' ', rsNotVal, 1, 1)             ! any method but a line one or one that
        rsWhy = 'line ' & self.LogLineOf(rsFrom) & ' reads ' & clip(rsBufTxt) & '''s value between the split and the loop, where ' & rsValWhy
        exit
      end
      if rsLoopHdr and ~rsDepth and ~instring(' ' & clip(rsTail) & ' ', rsNotVal, 1, 1) !   replaces the value reads it
        if rsJd > rsJDep
          rsWhy = 'line ' & self.LogLineOf(rsFrom) & ' reads ' & clip(rsBufTxt) & '''s value after the loop with no join before it, ' & rsValAft
          exit
        end
        if ~rsValAfter then rsValAfter = rsFrom.
      end
    end
    if rsWhy then exit.
    if rsJPend <= rsJDep and rsJPend < rsJd and ~self.IsEolTok(rsNext - 1) then rsFrom = rsNext ; cycle. ! the join's statement carries on with |: not in force yet
    if rsJPend <= rsJDep and rsJPend < rsJd then rsJd = rsJPend.
    rsJPend = 9999
    rsFrom = rsNext
  end
  ! The trim is written again on the line after the join. When the join is one arm of an EXECUTE
  ! that line would be one more arm, and every later arm would answer to a different value.
  if rsTrimCall and rsJoinLine and rsValAfter
    rsX = self.ArmOfExecute(rsJoinLine)
    if rsX
      rsWhy = 'the join on line ' & self.LogLineOf(rsJoinLine) & ' is one arm of the EXECUTE on line ' & |
              self.LogLineOf(rsX) & ', and the trim written after it would be another'
    end
  end

! ---- the level mark on the token of the rsQ row rsX, outside the loops: the depth, and the join in force
RsTrimLevel routine
  get(rsQ, rsX)
  if errorcode() then exit.
  get(self.tk.tokens, rsQ.tk)
  if errorcode() then exit.
  case self.tk.tokens.level
  of '+'
    rsJDep += 1
  of '-'
    rsJDep -= 1
    if rsJDep < rsJd then rsJd = 9999.
    if rsJDep < rsJPend then rsJPend = 9999.
  of '/'
    if rsJd >= rsJDep then rsJd = 9999.
    if rsJPend >= rsJDep then rsJPend = 9999.
  end

! ---- the loop whose header is at rsLoopHdr: its body must load a line and skip an empty one
!      as its first two statements, and the walk marks its body with rsDepth; its index is its own
RsSkipLoop routine
  rsFrom = rsLoopHdr ; do RsFill
  get(rsQ, 2) ; rsLoopIx = rsQ.tx
  rsFrom = rsNext ; do RsFillCode       ! the load: <buf>.setValueFromLine(i)
  rsLoadAt = rsFrom                     ! its first token, for RsIndexUse
  rsHeadIx = 1 ; do RsHead
  get(rsQ, 1)
  rsN = len(clip(rsQ.tx))
  rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
  if rsHead <> rsBuf or ~rsD or rsQ.tx[rsD + 1 : rsN] <> 'SETVALUEFROMLINE'
    rsWhy = 'the loop on line ' & self.LogLineOf(rsLoopHdr) & ' does not load a line into ' & clip(rsBufTxt) & ' first, so whether it skips an empty piece cannot be seen - ' & rsSkipWhy
    exit
  end
  rsFrom = rsNext ; do RsFillCode       ! the skip: if ~<buf>._DataEnd then cycle.
  rsTxt.free()                          ! the line as the tool reads it, for the message
  loop rsX = 1 to records(rsQ)
    get(rsQ, rsX)
    if errorcode() then break.
    rsTxt.append(choose(rsX = 1, '', ' ') & clip(rsQ.tx))
  end
  rsY = 0                               ! the row holding <buf>._DataEnd negated: the
  loop rsX = 2 to records(rsQ)          !   tilde may be its own row or glued in front
    get(rsQ, rsX)
    if errorcode() then break.
    rsN = len(clip(rsQ.tx))
    if rsN > 1 and rsQ.tx[1] = '~' and rsQ.tx[2 : rsN] = clip(rsBuf) & '._DATAEND' then rsY = rsX ; break.
    if rsQ.tx = clip(rsBuf) & '._DATAEND'
      get(rsQ, rsX - 1)
      if rsQ.tx = '~' or rsQ.tx = 'NOT' then rsY = rsX.
      break
    end
  end
  get(rsQ, 1) ; rsTail = rsQ.tx
  if rsTail <> 'IF' or ~rsY
    rsWhy = 'the loop on line ' & self.LogLineOf(rsLoopHdr) & ' does not skip an empty piece first (its second line reads: ' & rsTxt.getValue() & '), so ' & rsSkipWhy
    exit
  end
  get(rsQ, rsY + 1) ; rsSb.setValue(rsQ.tx)
  get(rsQ, rsY + 2)
  if errorcode() or rsSb.getValue() <> 'THEN' or rsQ.tx <> 'CYCLE'
    rsWhy = 'the loop on line ' & self.LogLineOf(rsLoopHdr) & ' does not skip an empty piece first (its second line reads: ' & rsTxt.getValue() & '), so ' & rsSkipWhy
    exit
  end
  rsDepth = 1                           ! inside the loop body until its END: the level of EVERY
  rsZ = rsNext                          !   token of every line is counted, so a one-line IF and
  loop while rsZ > 0 and rsZ < rsScLast !   its dot balance, and the END is seen wherever it sits
    rsFrom = rsZ ; do RsFill            ! RsFill moves rsZ on a split dotted form: count from rsFrom
    loop rsX = rsFrom to rsNext - 1
      get(self.tk.tokens, rsX)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.level = '+' then rsDepth += 1.
      if self.tk.tokens.level = '-' then rsDepth -= 1.
      if ~rsDepth then break.
    end
    if ~rsDepth then break.             ! the END line: rsNext is past the loop
    loop rsX = 1 to records(rsQ)        ! with a trim, the body may not read the lines by number
      rsHeadIx = rsX ; do RsHead
      get(rsQ, rsX)
      if errorcode() then break.
      if rsHead <> rsBuf then cycle.
      rsN = len(clip(rsQ.tx))
      rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
      rsTail = rsQ.tx[rsD + 1 : rsN]
      if instring(' ' & clip(rsTail) & ' ', rsBodyRd, 1, 1)
        rsWhy = 'line ' & self.LogLineOf(rsFrom) & ' reads ' & clip(rsBufTxt) & '''s lines (' & lower(clip(rsTail)) & ') inside the loop, past the skip, so ' & rsSkipWhy
        exit
      end
    end
    if rsWhy then exit.
    rsZ = rsNext
  end
  rsDepth = 0
  do RsIndexUse

! ---- without the trim before the split, the loop also runs over the empty pieces it took away and skips
!      them, so its INDEX counts them: line 2 for the first piece that was line 1, and one past a
!      different count when the loop ends. So the index must be the loop's alone - a local of the
!      procedure, named in no method of a class it declares, and mentioned nowhere but the loop's
!      own line, its load, its declaration, and the line and load of another loop of this shape,
!      which sets it afresh. With no trim, for a range from line 2 on, lines that are one empty line
!      give the loop one pass more than the copy had, which it skips: the body counts the same lines,
!      so it may read the index, but the index ends one higher, so nothing after the loop may.
!      RsTrimGuard goes on from the line after this loop: rsNext is kept
RsIndexUse routine
  data
keepNext  long,auto
ixDecl    byte,auto
ixWhy     STRING(200),AUTO
  code
  keepNext = rsNext
  ixWhy = choose(~rsTrimCall, 'when lines ' & rsA & ' on are one empty line the loop on line ' & self.LogLineOf(rsLoopHdr) & ' runs once more than over the copy, so the index ends one higher', |
                 'without ' & clip(rsTrimTxt) & ' before the split the loop on line ' & self.LogLineOf(rsLoopHdr) & ' would count the empty pieces it took away')
  if self.MayHaveLocalMethods(rsSc) and self.UsedInLocalMethods(upper(rsLoopIx), rsScFirst, rsScLast)
    rsWhy = lower(clip(rsLoopIx)) & ' is used in a method of a class this procedure declares, and ' & ixWhy
    exit
  end
  rsZ = self.syms.FindOwn(rsLoopIx, rsSc)
  if rsZ then get(self.syms.syms, rsZ).
  if ~rsZ or errorcode() or (self.syms.syms.declTok > rsScFirst and self.syms.syms.declTok <= rsScCode)
    rsWhy = lower(clip(rsLoopIx)) & ' is not a local of this procedure, so code elsewhere may read it, and ' & ixWhy
    exit
  end
  rsFrom = rsScFirst
  loop while rsFrom > 0 and rsFrom < rsScLast
    do RsFill
    ixDecl = 0
    if self.syms.IsColOneLabel(rsFrom)
      get(rsQ, 1)
      if ~errorcode() and rsQ.tx = rsLoopIx then ixDecl = 1.
    end
    if rsFrom = rsLoopHdr or rsFrom = rsLoadAt or ixDecl then rsFrom = rsNext ; cycle.
    if ~rsTrimCall and rsFrom > rsLoopHdr and rsFrom < keepNext then rsFrom = rsNext ; cycle. ! no trim: the body counts the same lines
    do RsIxLine
    if rsY then rsFrom = rsNext ; cycle.
    loop rsX = 1 to records(rsQ)
      rsHeadIx = rsX ; do RsHead
      get(rsQ, rsX)
      if errorcode() then break.
      if rsHead = rsLoopIx or rsQ.tx = rsLoopIx
        rsWhy = lower(clip(rsLoopIx)) & ' is used on line ' & self.LogLineOf(rsFrom) & ', and ' & ixWhy
        exit
      end
    end
    rsFrom = rsNext
  end
  rsNext = keepNext

! ---- rsY = 1 when the line in rsQ is `loop <ix> = 1 to <copy>.records()` or `<copy>.setValueFromLine(<ix>)`
!      with the index in hand: the header of a loop of the shape RsSkipLoop judges, which sets the index
!      afresh, or the load that follows one - RsTrimGuard and RsSkipLoop refuse a load anywhere else
RsIxLine routine
  rsY = 0
  case records(rsQ)
  of 8
    get(rsQ, 1) ; if rsQ.tx <> 'LOOP' then exit.
    get(rsQ, 2) ; if rsQ.tx <> rsLoopIx then exit.
    get(rsQ, 3) ; if rsQ.tx <> '=' then exit.
    get(rsQ, 4) ; if rsQ.tx <> '1' then exit.
    get(rsQ, 5) ; if rsQ.tx <> 'TO' then exit.
    get(rsQ, 6) ; if rsQ.tx <> clip(rsBuf) & '.RECORDS' then exit.
    get(rsQ, 7) ; if rsQ.tx <> '(' then exit.
    get(rsQ, 8) ; if rsQ.tx <> ')' then exit.
    rsY = 1
  of 4
    get(rsQ, 1) ; if rsQ.tx <> clip(rsBuf) & '.SETVALUEFROMLINE' then exit.
    get(rsQ, 2) ; if rsQ.tx <> '(' then exit.
    get(rsQ, 3) ; if rsQ.tx <> rsLoopIx then exit.
    get(rsQ, 4) ; if rsQ.tx <> ')' then exit.
    rsY = 1
  end

! ---- the copy runs at most once per call
RsOnce routine
  if self.syms.ScopeContaining(rsLine1, vs:scRoutine, vs:scRoutine)
    rsWhy = 'the copy is in a routine, which may run more than once'
    exit
  end
  rsDepth = 0
  loop rsX = rsLine1 - 1 to rsScCode + 1 by -1
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.firstOnLine and upper(self.tk.tokens.tok) = 'CODE' then break.
    if self.syms.IsColOneLabel(rsX)
      rsWhy = 'a label on line ' & self.LogLineOf(rsX) & ' lies before the copy, so it can be reached again'
      exit
    end
    case self.tk.tokens.level
    of '-'
      rsDepth += 1
    of '+'
      if rsDepth
        rsDepth -= 1
      else
        rsN = len(clip(self.tk.tokens.tok))
        if rsN and (upper(self.tk.tokens.tok[1 : rsN]) = 'LOOP' or upper(self.tk.tokens.tok[1 : rsN]) = 'ACCEPT')
          rsWhy = 'the copy is inside the loop on line ' & self.LogLineOf(rsX) & ', so it may run more than once'
          exit
        end
      end
    end
  end
  rsDepth = 0

! ---- the copy must RUN before every later mention of the copy object. And none of the lines the
!      fold takes out - the copy, the trim, the split - may be one arm of an EXECUTE: its arms are
!      alternatives with no mark between them, so the walk below would read the next arm as code
!      that runs after the copy, and taking a line out would make every later arm answer to a
!      different value.
RsRuns routine
  rsX = self.ArmOfExecute(rsLine1)
  if ~rsX and rsLine2 then rsX = self.ArmOfExecute(rsLine2).
  if ~rsX then rsX = self.ArmOfExecute(rsLine3).
  if rsX
    rsWhy = 'a line the fold takes out is one arm of the EXECUTE on line ' & self.LogLineOf(rsX) & |
            ', and every later arm would answer to a different value'
    exit
  end
  if self.syms.ScopeContaining(rsLast, vs:scRoutine, vs:scRoutine)
    rsWhy = clip(rsBufTxt) & ' is used on line ' & self.LogLineOf(rsLast) & ' in a routine, which may run before the copy'
    exit
  end
  rsDepth = 0
  rsEol = self.FirstEolAfter(rsLine1)
  rsY = self.FirstEolAfter(rsLast)
  loop rsX = rsEol + 1 to rsY
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      rsDepth += 1
    elsif self.tk.tokens.level = '-'
      rsDepth -= 1
      if rsDepth < 0
        rsWhy = 'the structure holding the copy ends on line ' & self.LogLineOf(rsX) & ', before ' & clip(rsBufTxt) & '''s use on line ' & self.LogLineOf(rsLast)
        exit
      end
    elsif self.tk.tokens.level = '/' and ~rsDepth
      rsWhy = 'line ' & self.LogLineOf(rsX) & ' begins another branch of the structure holding the copy, so ' & clip(rsBufTxt) & '''s use on line ' & self.LogLineOf(rsLast) & ' can run without it'
      exit
    elsif self.syms.IsColOneLabel(rsX)
      rsWhy = 'a label on line ' & self.LogLineOf(rsX) & ' lies between the copy and ' & clip(rsBufTxt) & '''s use on line ' & self.LogLineOf(rsLast)
      exit
    end
  end
  rsDepth = 0

! ---- the lines that go may carry no comment: the trim line, the split line, and the copy line
!      when a range from line 1 leaves nothing to write in its place
! ---- THE EDIT: rename (nothing moves); the trim written after the join; the split line and the
!      trim line go; the copy line becomes the delete, or goes
RsEdit routine
  do RsRename
  if rsTrimCall and rsJoinLine and rsValAfter
    rsX = self.FirstEolAfter(rsJoinLine) + 1               ! the line after the join
    rsInd.free()
    get(self.tk.tokens, rsX)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      rsY = 0
      loop rsZ = 1 to size(self.tk.tokens.strBefore)
        if self.tk.tokens.strBefore[rsZ] = '<10>' then rsY = rsZ.
      end
      if rsY < size(self.tk.tokens.strBefore)
        rsInd.setValue(self.tk.tokens.strBefore[rsY + 1 : size(self.tk.tokens.strBefore)])
      end
    end
    ! a comment-only line is an EOL token of its own, its comment in that token's strBefore: copied
    ! as an indent it would put the trim INSIDE the comment, so the trim takes the join line's indent
    if self.IsEolTok(rsX) then rsInd.free().
    ! a line that starts in column 1 starts with a label: the trim takes the join line's indent,
    ! as column 1 would make it a label too
    rsShf = self.TxaShiftOf(rsX)
    if ~rsInd._DataEnd then self.IndentOf(rsJoinLine, rsInd) ; rsShf = self.TxaShiftOf(rsJoinLine).
    rsTxt.setValue(rsInd)
    rsTxt.append(clip(rsSrcTxt) & '.' & clip(rsTrimTxt) & '<13,10>')
    self.TxaMarkLines(rsTxt, rsShf)
    self.InsertLinesAbove(rsX, rsTxt)
  end
  rsEol = self.FirstEolAfter(rsLine3)
  if rsEol then self.DropLinesKeepCmts(rsLine3, rsEol).
  if rsLine2
    rsEol = self.FirstEolAfter(rsLine2)
    if rsEol then self.DropLinesKeepCmts(rsLine2, rsEol).
  end
  rsEol = self.FirstEolAfter(rsLine1)
  if rsA = 1
    if rsEol then self.DropLinesKeepCmts(rsLine1, rsEol).
  else
    rsSb.free()
    get(self.tk.tokens, rsLine1)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL then rsSb.setValue(self.tk.tokens.strBefore).
    self.tk.DeleteToks(rsLine1, rsEol - 1)
    rsDlInd.setValue('<10>')                               ! each deleteLine on a line of its own, indented like the first
    rsY = rsSb._DataEnd
    loop while rsY > 0
      if rsSb.valuePtr[rsY] = '<10>' then break.
      rsY -= 1
    end
    if rsY < rsSb._DataEnd then rsDlInd.append(rsSb.valuePtr[rsY + 1 : rsSb._DataEnd]).
    rsCmt.free()
    if rsA > 2                                             ! a trailing comment stays on the FIRST line: it moves from the
      get(self.tk.tokens, rsLine1)                         !   line end's trivia into the text, ahead of the first break
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok[1] = '<10>' and not self.tk.tokens.strBefore &= NULL
        if pLog.findByte(33, 1,, self.tk.tokens.strBefore) ! '!'
          rsCmt.setValue(self.tk.tokens.strBefore)
          self.tk.SetStrBefore(rsLine1, '')
        end
      end
    end
    rsTxt.free()                                           ! the library deletes ONE line at a time: line 1,
    loop rsY = 2 to rsA                                    !   once for every line before the range (13 Sep 2026)
      if rsY > 2
        if rsY = 3 then rsTxt.append(rsCmt).
        rsTxt.append(rsDlInd)
      end
      rsTxt.append(clip(rsSrcTxt) & '.deleteLine(1)')
    end
    self.tk.InsertString(rsLine1, rsTxt, 0)
    self.tk.SetStrBefore(rsLine1, rsSb.getValue())
  end
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- every mention of the copy after the split line names the object
RsRename routine
  rsEol = self.FirstEolAfter(rsLine3)
  loop rsX = rsEol + 1 to rsScLast
    if rsX = rsBufDecl then cycle.
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    rsN = len(clip(self.tk.tokens.tok))
    if ~rsN then cycle.
    rsD = instring('.', self.tk.tokens.tok[1 : rsN], 1, 1)
    if rsD > 1
      if upper(self.tk.tokens.tok[1 : rsD - 1]) = rsBuf
        self.tk.SetTok(rsX, clip(rsSrcTxt) & self.tk.tokens.tok[rsD : rsN])
      end
    elsif ~rsD
      if upper(self.tk.tokens.tok[1 : rsN]) = rsBuf then self.tk.SetTok(rsX, clip(rsSrcTxt)).
    end
  end

! ---- the two names as the author spelled them
RsNames routine
  rsBufTxt = rsBuf ; rsSrcTxt = rsSrc
  loop rsX = rsLine1 to records(self.tk.tokens)
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    rsN = len(clip(self.tk.tokens.tok))
    if ~rsN then cycle.
    rsD = instring('.', self.tk.tokens.tok[1 : rsN], 1, 1)
    if rsD > 1
      if upper(self.tk.tokens.tok[1 : rsD - 1]) = rsBuf then rsBufTxt = self.tk.tokens.tok[1 : rsD - 1].
      if upper(self.tk.tokens.tok[1 : rsD - 1]) = rsSrc then rsSrcTxt = self.tk.tokens.tok[1 : rsD - 1].
    else
      if upper(self.tk.tokens.tok[1 : rsN]) = rsBuf then rsBufTxt = self.tk.tokens.tok[1 : rsN].
      if upper(self.tk.tokens.tok[1 : rsN]) = rsSrc then rsSrcTxt = self.tk.tokens.tok[1 : rsN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into rsQ with their token index; a split
!      dotted CALL joined into one row
RsFill routine
  free(rsQ)
  rsNext = 0
  loop rsX = rsFrom to records(self.tk.tokens)
    get(self.tk.tokens, rsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      rsNext = rsX + 1 ; break
    end
    if rsX > rsFrom and self.tk.tokens.firstOnLine
      rsNext = rsX ; break
    end
    rsQ.tx = upper(self.tk.tokens.tok) ; rsQ.tk = rsX
    add(rsQ)
  end
  if ~rsNext then rsNext = records(self.tk.tokens) + 1.
  rsX = 2
  loop while rsX < records(rsQ)
    get(rsQ, rsX)
    if errorcode() then break.
    if rsQ.tx <> '.' then rsX += 1 ; cycle.
    get(rsQ, rsX - 1)
    if errorcode() or ~((rsQ.tx[1] >= 'A' and rsQ.tx[1] <= 'Z') or rsQ.tx[1] = '_') then rsX += 1 ; cycle.
    rsHead = rsQ.tx ; rsZ = rsQ.tk
    get(rsQ, rsX + 1)
    if errorcode() or ~((rsQ.tx[1] >= 'A' and rsQ.tx[1] <= 'Z') or rsQ.tx[1] = '_') then rsX += 1 ; cycle.
    rsTail = rsQ.tx
    delete(rsQ)
    get(rsQ, rsX)
    delete(rsQ)
    get(rsQ, rsX - 1)
    rsQ.tx = clip(rsHead) & '.' & rsTail ; rsQ.tk = rsZ
    put(rsQ)
  end

! ---- RsFill, stepping over lines that hold no token: a comment-only line has an EOL of its own
RsFillCode routine
  loop
    do RsFill
    if records(rsQ) or ~rsNext or rsNext > rsScLast then break.
    rsFrom = rsNext
  end

! ---- rsHead = the RECEIVER in front of the rsQ row at rsHeadIx
RsHead routine
  rsHead = ''
  get(rsQ, rsHeadIx)
  if errorcode() then exit.
  rsN = len(clip(rsQ.tx))
  if ~rsN then exit.
  rsD = instring('.', rsQ.tx[1 : rsN], 1, 1)
  if rsD > 1 then rsHead = rsQ.tx[1 : rsD - 1].
!===============================================================================================
! BUILTIN MergeAdjacentCase - two tests of one expression, one after the other, become one CASE.
!   BUILTIN MergeAdjacentCase
!
!     case E                       case E
!     of '~' orof 'NOT'            of '~' orof 'NOT'
!       return true                  return true
!     end                    ->    of '('
!     if E = '(' and k > 0           if k > 0
!       ...                            ...
!     end                            end
!                                  end
!
! THE SHAPE. A CASE with no ELSE, and the very next statement is another test of the same
! expression: a second CASE on it (its arms join the first), or an IF whose condition is
! `E = c`, an OR list of them (the head becomes an `of` line and the IF's own END closes the
! CASE), or `E = c and R` (an `of c` line is written in front, the IF keeps R alone, two in,
! and an `end` is written after it for the CASE). Block IFs and one-line IFs both.
!
! WHY IT IS THE SAME PROGRAM. The second test runs only when control reaches it, and it
! reaches it from the END of the first CASE. An arm whose last statement is a RETURN, EXIT,
! CYCLE or BREAK never gets there, so its values may overlap the second test's: in both
! spellings the first matching arm runs and leaves. An arm that falls through must (a) share
! no value with the second test - proved on constants only, string against string by the
! BYTES each spelling stands for, so '<9>' and '<09>' are one value and so are 'A{2}' and
! 'AA', with trailing spaces ignored as a Clarion compare ignores them, integer against
! integer by value; anything else, a spelling that cannot be read included, is "not proved"
! and refuses. String against string by the bytes only when the expression is proved to be
! a string: against a number a quoted constant compares as a NUMBER, so with a LONG '1' and
! '01' are one value, and there two quoted constants are apart only when both are whole
! numbers that differ - and (b) leave the expression alone: no variable of it is so much as mentioned
! in the arm, no routine is DOne there (a routine shares the locals and may write one), and
! when a variable of it is not a plain local of the procedure - a global, a field reached
! through SELF, a parameter - the arm calls nothing but known readers, since any other call,
! with brackets or without, may write it. Then in the original the second test finds the
! value the CASE tested and matches nothing; in the merged CASE the arm ran and the later
! arms were never tried, which is the same thing. The expression itself must be one
! IfChainToCase would take - a name that resolves to data, a pure call, a subscript - because
! the merged CASE evaluates it ONCE where the original evaluated it twice, and a call to a
! parameterless procedure is spelled exactly like a name. A call with no object in front is a
! known reader, in the expression or in an arm, only as one of the runtime's own functions that
! the file gives no procedure of its own (PureProc): a program's own Size is the one size(s) calls.
!
! WHAT REFUSES, silently, as IfChainToCase's refusals are: an ELSE in either structure (it
! would catch what the other tests); an ELSIF; a GOTO in the first CASE; a comment inside
! the first CASE's header (one at its end stays with the line, which the merge keeps), or on
! a line that goes (the first CASE's END, the second CASE's head, the IF head); on a fall-through
! arm, a value that is not a plain constant or a range; an `and` on an OR list (`E = a or
! E = b and R` binds as `E = a or (E = b and R)`); an OR or XOR in R outside brackets (`E = c
! and R or S` binds as `(E = c and R) or S`, so S is tested whatever E holds); a one-line IF
! with two statements or an ELSE. Three tests in a row merge one pair per pass and finish in
! the next.
!===============================================================================================
VitEngine.BuiltinMergeAdjacentCase Procedure(StringTheory pLog)
i          long,auto
caseTok    long         ! the first CASE
caseEol    long
endTok     long         ! its END, alone on its line
endEol     long
selS       long         ! its selector
selE       long
selLen     long
nxt        long         ! the statement after that END: the second CASE, or the IF
nxtEol     long
nxtIsIf    byte
nxtOne     byte         ! ... a one-line IF, `if C then S.`
nxtThen    long         ! its THEN or ';' (a block IF may carry a bare THEN too)
nxtDot     long         ! a one-liner's terminating '.'
end2       long         ! the second CASE's or the block IF's END
end2Eol    long
condE      long         ! the IF condition's last token
andTok     long         ! `E = c and R`: the AND (0 = an OR list)
merged     byte
bail       byte
mcPure     byte         ! McPure out
mcJump     byte         ! McArmJumps out
mcMention  byte         ! McArmMentions out
mcDisj     byte         ! McDisjoint out
mcSame     byte         ! McSameConst out
mcLocal    byte         ! McNames out: every variable of the selector is a plain local, out of any call's reach
mcAlias    byte         ! McNames out: a variable of the selector has another name - an OVER, a reference
mcStr      byte         ! McSelStr out: the selector is a STRING, so quoted constants compare by their bytes
mcS        long         ! a token range handed to a routine
mcE        long
vEnd       long         ! McValues: the END the values must stay in front of
cur        long         ! McArms / McValues: the ArmQ row being filled (0 = the second structure's values)
curArm     long         ! McSafe / McDisjoint: the arm being checked
ta         long         ! McSameConst in: two constant tokens
tb         long
w          long         ! McArms / McValues cursor
logLn      long
changes    long
pureU      StringTheory
mcOwn      StringTheory ! the names on pureU this file gives a procedure of its own, which a plain call may run
namesU     StringTheory ! ' NAME NAME ' - the heads of the selector's variables, for the mention test
indentSt   StringTheory ! the first CASE's indent
ofLine     StringTheory ! the `of c` line written in front of `if E = c and R`
litA       StringTheory
litB       StringTheory
decA       StringTheory ! McSameConst: the bytes litA and litB stand for
decB       StringTheory
nxPos      long         ! McPush staging
nxPos2     long
nxKind     byte
nxTxt      string(8)
ArmQ  QUEUE,PRE(mq)     ! the first CASE's arms
armOf     long          ! its OF
armBodyS  long          ! its body (0 = none)
armBodyE  long
armJumps  byte          ! the body's last statement is RETURN, EXIT, CYCLE or BREAK
      END
ValQ  QUEUE,PRE(vq)     ! every OF value of both structures
valTok    long          ! the constant token (0 = not a constant: a variable, a call, a range bound)
valArm    long          ! the ArmQ row (first CASE), 0 for the second structure
      END
EqQ   QUEUE,PRE(eq2)    ! the IF condition, `E = c` by `E = c`
eqExpS    long
eqEq      long
eqVal     long
eqOr      long          ! the OR in front of this one (0 for the first)
      END
EdQ   QUEUE,PRE(ed2)    ! staged edits, applied highest position first
pos       long
pos2      long
kind      byte          ! 1 SetTok txt; 2 DeleteToks; 5 THEN -> line break; 6 body indent; 7 '.' -> end; 8 the `of c` line; 9 an `end` line; 10 two more spaces of indent
txt       string(8)
      END
  code
  free(ArmQ)
  free(ValQ)
  free(EqQ)
  free(EdQ)
  self.IfCasePureList(pureU)                     ! the calls IfChainToCase takes; PURE(...) on that builtin is its own
  self.PureOwnList(pureU, mcOwn)
  if records(self.tk.tokens) < 1 then return 0.
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.   ! LIVE bound: the stream shrinks as CASEs merge
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.type <> vt:reservedWord or |
       ~self.tk.tokens.firstOnLine            or |
       self.tk.tokens.tok &= NULL             or |
       upper(self.tk.tokens.tok) <> 'CASE'    or |
       self.tk.tokens.level <> '+'
      cycle
    end
    caseTok = i
    if self.ArmOfExecute(caseTok)                ! an EXECUTE runs ONE arm by position: joining the IF after it into
      pLog.append('BUILTIN MergeAdjacentCase line ' & self.LogLineOf(caseTok) & ': REFUSED - the CASE is an arm of an EXECUTE, and joining the next arm into it would renumber the arms below.<13,10>')
      cycle                                      !   the CASE would take one arm away and renumber every one below it
    end
    do McTryOne
    if ~merged then cycle.
    changes += 1
    if changes = 501
      pLog.append('BUILTIN MergeAdjacentCase: further detail lines suppressed (500 shown)<13,10>')
    end
    if changes <= 500
      pLog.append('BUILTIN MergeAdjacentCase line ' & logLn & ': the next test of the same expression joined the CASE<13,10>')
    end
    i = caseTok                                  ! carry on past the merged CASE: its level marks are stale until the reparse
  end
  if changes
    self.wantReparse = true                      ! structure changed; later builtins must see one CASE
    pLog.append('BUILTIN MergeAdjacentCase: ' & changes & ' merge(s) this pass<13,10>')
  end
  free(ArmQ)
  free(ValQ)
  free(EqQ)
  free(EdQ)
  return changes

! ---- try the CASE at caseTok; sets merged / logLn ----
McTryOne routine
  merged = 0
  bail   = 0
  free(ArmQ)
  free(ValQ)
  free(EqQ)
  free(EdQ)
  get(self.tk.tokens, caseTok)                       ! position the queue for MatchLevel
  if errorcode() then exit.
  endTok = self.tk.MatchLevel()
  if endTok <= caseTok then exit.
  caseEol = self.FirstEolAfter(caseTok)
  if ~caseEol then exit.
  if caseEol >= endTok then exit.
  if self.LineHasComment(caseTok, caseEol - 1) then exit.
  selS = caseTok + 1
  selE = caseEol - 1
  if selE < selS then exit.
  selLen = selE - selS + 1
  mcS = selS
  mcE = selE
  do McPure                                          ! a name, a pure call, a subscript: evaluated once now, twice before
  if ~mcPure then exit.
  do McNames
  if mcAlias then exit.                              ! the selector has another name an arm may write it through
  do McSelStr
  if ~self.IsFirstOnLine(endTok) then exit.          ! the END goes, so it must be alone on its line, with no comment
  endEol = self.FirstEolAfter(endTok)
  if ~endEol then exit.
  if endEol <> endTok + 1 then exit.
  if self.LineHasComment(endTok, endEol) then exit.
  do McArms                                          ! the first CASE's arms and their values; an ELSE refuses
  if bail then exit.
  if ~records(ArmQ) then exit.
  do McNext                                          ! the statement after the END: a CASE or an IF on the same expression
  if bail then exit.
  do McSafe                                          ! every arm jumps, or shares no value with the second test and leaves the selector alone
  if bail then exit.
  do McIndent
  do McStage
  if bail then exit.
  logLn = self.LogLineOf(caseTok)                    ! captured BEFORE the edits - log coordinates only
  do McApply
  if not self.syms &= NULL then self.syms.dirty = 1. ! the edits renumber the queue; the next CASE's name proofs rebuild the table through Lookup
  merged = 1

! ---- is [mcS..mcE] an expression IfChainToCase would take? As there, a method on the pure list
!      counts only on a StringTheory: a GetLine of the author's own class may answer the next line
!      at every call, so the selector would not be the same value twice. mcPure ----
McPure routine
  data
z2    long,auto
dep   long,auto
tU    string(vs:maxName),auto
tTy   string(1),auto
nmU   string(vs:maxName),auto
callU string(vs:maxName),auto
nLen  long,auto
dotAt long,auto
d     long,auto
  code
  mcPure = 0
  dep = 0
  loop z2 = mcS to mcE
    get(self.tk.tokens, z2)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    tU  = upper(self.tk.tokens.tok)
    tTy = self.tk.tokens.type
    case tU
    of '(' orof '['
      if z2 = mcS then exit.                        ! nothing in front of the bracket
      get(self.tk.tokens, z2 - 1)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then exit.
      if self.tk.tokens.type <> vt:label then exit. ! a grouping bracket - not modelled, as IfChainToCase does not model it
      if tU = '('                                   ! a call: its callee must be on the pure list
        nmU  = upper(self.tk.tokens.tok)
        nLen = len(clip(nmU))
        dotAt = 0
        loop d = 1 to nLen
          if nmU[d] = '.' then dotAt = d.
        end
        if dotAt >= nLen then exit.
        if dotAt
          callU = nmU[dotAt + 1 : nLen]
        else
          callU = nmU
        end
        if ~pureU.findChars(' ' & clip(callU) & ' ') then exit.
        if dotAt then exit.
        if self.tk.GetTok(z2 - 2) = '.' and ~self.PureMethodAt(z2, pureU) then exit.
        if self.tk.GetTok(z2 - 2) <> '.' and ~self.PureProc(callU, pureU, mcOwn) then exit.
      end
      dep += 1
      cycle
    of ')' orof ']'
      dep -= 1
      if dep < 0 then exit.
      cycle
    end
    if tTy = vt:label                               ! a name that is not a callee must resolve to DATA - a parameterless call is spelled the same way
      if z2 < mcE
        get(self.tk.tokens, z2 + 1)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '(' then cycle.
      end
      if ~self.CondNamesAreData(z2, z2) then exit.
      cycle
    end
    if self.tk.tokens.tok = '.'                     ! a member dot between a receiver and its method
      if self.tk.tokens.level = '-' then exit.
      cycle
    end
    if dep < 1 then exit.                           ! an operator or a constant at the top: not a plain expression
    if tTy = vt:Literal or tTy = vt:Integer or tTy = vt:NumericWithDecPt then cycle.
    case tU
    of ',' orof '+' orof '-' orof '*' orof '/' orof ':'
      cycle
    end
    exit
  end
  if dep then exit.
  mcPure = 1

! ---- the heads of the selector's variables, ' NT SELF ', for the mention test. A callee is not one.
!      mcLocal: every one is a plain local of this procedure, which no call can reach. mcAlias is set
!      too when the procedure INCLUDEs a file: the included code, not in this file, may write the
!      selector in an arm or name it in a declaration ----
McNames routine
  data
z2     long,auto
nm     string(vs:maxName),auto
h      long,auto
d      long,auto
isCall byte,auto
sc     long,auto
row    long,auto
  code
  namesU.setValue(' ')
  mcLocal = 1 ; mcAlias = 0
  if not self.syms &= NULL then self.syms.EnsureFresh().
  loop z2 = selS to selE
    get(self.tk.tokens, z2)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    nm = upper(self.tk.tokens.tok)
    isCall = 0
    if z2 < selE
      get(self.tk.tokens, z2 + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '(' then isCall = 1.
    end
    if isCall then cycle.
    h = len(clip(nm))
    loop d = 1 to h
      if nm[d] = '.' then h = d - 1 ; break.
    end
    if h < 1 then cycle.
    namesU.append(nm[1 : h] & ' ')
    if ~self.DgRecvIsLocal(nm[1 : h], z2) then mcLocal = 0 ; cycle.
    sc = self.syms.ScopeContaining(z2, vs:scProc, vs:scMethod)      ! a local can still change through another name: an
    if ~sc then mcLocal = 0 ; cycle.                                !   OVER, a reference taken on it, a method of a class
    row = self.syms.FindOwn(nm[1 : h], sc)                          !   the procedure declares
    if ~row then mcLocal = 0 ; cycle.
    get(self.syms.syms, row)
    if errorcode() or self.syms.syms.isRef or self.NameShared(z2, nm[1 : h]) then mcAlias = 1 ; cycle. ! an OVER either way or a reference writes it unseen
    self.syms.scopes.scopeId = sc
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if errorcode() then mcLocal = 0 ; cycle.
    loop d = self.syms.scopes.startTok to self.syms.scopes.endTok   ! a reference taken on it: r &= k
      if self.tk.GetTok(d) = '&=' and upper(self.tk.GetTok(d + 1)) = nm[1 : h] then mcAlias = 1 ; break.
    end
    if mcAlias then cycle.
    if self.MayHaveLocalMethods(sc) and self.UsedInLocalMethods(nm[1 : h], self.syms.scopes.startTok, self.syms.scopes.endTok) then mcLocal = 0.
  end
  if not self.syms &= NULL
    sc = self.syms.ScopeContaining(selS, vs:scProc, vs:scMethod)
    if sc and self.ScopeIncludes(sc) then mcAlias = 1.
  end

! ---- the first CASE's arms: ArmQ, their values into ValQ. An ELSE or a GOTO refuses ----
McArms routine
  data
dep  long,auto
lv   string(1),auto
tyv  string(1),auto
wU   string(vs:maxName),auto
  code
  dep  = 0
  cur  = 0
  vEnd = endTok
  w    = caseEol
  loop
    w += 1
    if w >= endTok then break.
    get(self.tk.tokens, w)
    if errorcode() then bail = 1 ; exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '+'
      dep += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep -= 1          ! an INLINE '.' terminator is retyped vt:end and carries no '-' - see IfChainToCase
      if dep < 0 then bail = 1 ; exit.
    elsif lv = '/'
      if dep > 0 then cycle.
      if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
      wU = upper(self.tk.tokens.tok)
      case wU
      of 'OF'
        if ~self.IsFirstOnLine(w) then bail = 1 ; exit.
        if cur then do McCloseArm.
        if bail then exit.
        clear(ArmQ)
        mq:armOf = w
        add(ArmQ)
        cur = records(ArmQ)
        do McValues
        if bail then exit.
        cycle
      of 'OROF'
        if ~cur then bail = 1 ; exit.
        do McValues
        if bail then exit.
        cycle
      else
        bail = 1 ; exit ! ELSE - it would catch what the second test tests
      end
    end
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = 'GOTO' then bail = 1 ; exit.
    ! a label inside the CASE: a GOTO from outside reaches an arm with any value
    if self.syms &= NULL then bail = 1 ; exit.
    if self.syms.IsColOneLabel(w) then bail = 1 ; exit.
  end
  if dep then bail = 1 ; exit.
  if ~cur then bail = 1 ; exit.
  do McCloseArm

! ---- the values after the OF (or OROF) at w, up to the end of its line or a ';' body. Leaves w on the
!      line's EOL, or on the ';'. cur = 0 reads the second structure's values ----
McValues routine
  data
v     long,auto
vU    string(vs:maxName),auto
want  byte,auto
rng   byte,auto ! the value just read, or the next, is a range bound - not a constant to compare
  code
  want = 1
  rng  = 0
  v = w
  loop
    v += 1
    if v >= vEnd then bail = 1 ; exit.
    get(self.tk.tokens, v)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok[1] = '<10>'             ! the end of the values line
      if want then bail = 1 ; exit.
      if cur
        get(ArmQ, cur)
        if errorcode() then bail = 1 ; exit.
        if ~mq:armBodyS then mq:armBodyS = v + 1. ! the body starts after the OF line: control falls into an OROF's statements
        put(ArmQ)
      end
      w = v
      exit
    end
    vU = upper(self.tk.tokens.tok)
    if vU = ';'                                   ! `of 'X' ; r = 6` - the body is the rest of the line
      if want then bail = 1 ; exit.
      if cur
        get(ArmQ, cur)
        if errorcode() then bail = 1 ; exit.
        if ~mq:armBodyS then mq:armBodyS = v + 1.
        put(ArmQ)
      end
      w = v
      exit
    end
    if want
      clear(ValQ)
      vq:valArm = cur
      vq:valTok = 0
      if ~rng and (self.tk.tokens.type = vt:Literal or self.tk.tokens.type = vt:Integer) then vq:valTok = v.
      add(ValQ)
      want = 0
      rng  = 0
    elsif vU = 'OROF'
      want = 1
    elsif vU = 'TO'                          ! `of lo to hi`: neither bound is a value of its own
      get(ValQ, records(ValQ))
      if errorcode() then bail = 1 ; exit.
      vq:valTok = 0
      put(ValQ)
      want = 1
      rng  = 1
    else
      bail = 1 ; exit                        ! `of a + 1` - not a values line this reads
    end
  end

! ---- the arm in ArmQ row cur ends in front of w: its body range, and whether it jumps ----
McCloseArm routine
  get(ArmQ, cur)
  if errorcode() then bail = 1 ; exit.
  mq:armBodyE = w - 1
  if ~mq:armBodyS or mq:armBodyS > mq:armBodyE then mq:armBodyS = 0.
  mq:armJumps = 0
  if mq:armBodyS
    mcS = mq:armBodyS
    mcE = mq:armBodyE
    do McArmJumps
    mq:armJumps = mcJump
  end
  put(ArmQ)

! ---- is the LAST statement at the top of [mcS..mcE] a RETURN, EXIT, CYCLE or BREAK? mcJump ----
McArmJumps routine
  data
z2   long,auto
dep  long,auto
st   long,auto ! first token of the statement being read (0 = between statements)
last long,auto ! ... of the last statement that started at depth 0
lv   string(1),auto
tyv  string(1),auto
tU   string(vs:maxName),auto
  code
  mcJump = 0
  dep = 0
  st = 0
  last = 0
  loop z2 = mcS to mcE
    get(self.tk.tokens, z2)
    if errorcode() then exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok[1] = '<10>' then st = 0 ; cycle.
    if self.tk.tokens.tok = ';' and ~dep then st = 0 ; cycle.
    if ~st
      st = z2
      if ~dep then last = z2.
    end
    if lv = '+'
      dep += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep -= 1
      if dep < 0 then exit.
    end
  end
  if dep then exit.
  if ~last then exit.
  get(self.tk.tokens, last)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  tU = upper(self.tk.tokens.tok)
  case tU
  of 'RETURN' orof 'EXIT' orof 'CYCLE' orof 'BREAK'
    mcJump = 1
  end

! ---- the statement after the first CASE's END: a CASE on the same expression, or an IF on it ----
McNext routine
  data
tU   string(vs:maxName),auto
  code
  nxtIsIf = 0
  nxtOne  = 0
  nxtThen = 0
  nxtDot  = 0
  end2    = 0
  end2Eol = 0
  andTok  = 0
  nxt = self.IsuNextStmt(endEol)
  if ~nxt then bail = 1 ; exit.
  get(self.tk.tokens, nxt)
  if errorcode() then bail = 1 ; exit.
  if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
  if self.tk.tokens.type <> vt:reservedWord or ~self.tk.tokens.firstOnLine or self.tk.tokens.level <> '+' then bail = 1 ; exit.
  tU = upper(self.tk.tokens.tok)
  nxtEol = self.FirstEolAfter(nxt)
  if ~nxtEol then bail = 1 ; exit.
  if self.LineHasComment(nxt, nxtEol) then bail = 1 ; exit.
  if tU = 'CASE'
    if ~self.SpanTokEqual(selS, selE, nxt + 1, nxtEol - 1) then bail = 1 ; exit.
    get(self.tk.tokens, nxt)
    end2 = self.tk.MatchLevel()
    if end2 <= nxt then bail = 1 ; exit.
    do McNextArms    ! its values into ValQ; an ELSE refuses
    exit
  end
  if tU <> 'IF' then bail = 1 ; exit.
  nxtIsIf = 1
  do McIfShape       ! one-liner or block; a bare THEN; the condition's end; its END
  if bail then exit.
  do McIfCond        ! `E = c [or E = c]...` or `E = c and R`

! ---- the second CASE's OF values (cur = 0); an ELSE refuses ----
McNextArms routine
  data
dep  long,auto
lv   string(1),auto
tyv  string(1),auto
wU   string(vs:maxName),auto
  code
  dep  = 0
  cur  = 0
  vEnd = end2
  w    = nxtEol
  loop
    w += 1
    if w >= end2 then break.
    get(self.tk.tokens, w)
    if errorcode() then bail = 1 ; exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '+'
      dep += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep -= 1
      if dep < 0 then bail = 1 ; exit.
    elsif lv = '/'
      if dep > 0 then cycle.
      if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
      wU = upper(self.tk.tokens.tok)
      if wU <> 'OF' and wU <> 'OROF' then bail = 1 ; exit. ! an ELSE would catch what the first CASE's fall-through arms leave
      do McValues
      if bail then exit.
    end
  end
  if dep then bail = 1.

! ---- the IF at nxt: `if C then S.`, `if C; S.`, a block head, a block head with a bare THEN ----
McIfShape routine
  data
z2     long,auto
thenC  long,auto
semiC  long,auto
sepP   long,auto
lastT  long,auto
plusC  long,auto
slashC long,auto
tU     string(vs:maxName),auto
  code
  thenC = 0
  semiC = 0
  sepP  = 0
  lastT = 0
  plusC = 0
  slashC = 0
  loop z2 = nxt + 1 to nxtEol - 1
    get(self.tk.tokens, z2)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.level = '+' then plusC += 1.
    if self.tk.tokens.level = '/' then slashC += 1.
    if self.tk.tokens.tok &= NULL then cycle.
    lastT = z2
    tU = upper(self.tk.tokens.tok)
    if tU = 'THEN' then thenC += 1 ; sepP = z2.
    if tU = ';'
      semiC += 1
      if ~sepP then sepP = z2.
    end
  end
  if plusC or slashC then bail = 1 ; exit.     ! a nested block, or an ELSE on the line
  if ~lastT then bail = 1 ; exit.
  get(self.tk.tokens, lastT)
  if errorcode() then bail = 1 ; exit.
  if thenC + semiC = 0                         ! a block IF
    condE = nxtEol - 1
  elsif thenC + semiC > 1
    bail = 1 ; exit                            ! `if C then S ; T.` - two statements
  elsif self.tk.tokens.tok = '.' and self.tk.tokens.type = vt:end
    if lastT <= sepP + 1 then bail = 1 ; exit. ! an empty body
    loop z2 = sepP + 1 to lastT - 1            ! `S..` closes more than the IF: not this shape
      get(self.tk.tokens, z2)
      if errorcode() then bail = 1 ; exit.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.type = vt:end then bail = 1 ; exit.
    end
    nxtOne  = 1
    nxtThen = sepP
    nxtDot  = lastT
    condE   = sepP - 1
    end2    = lastT
    end2Eol = nxtEol
  elsif thenC = 1 and lastT = sepP             ! `if C then` on a block head: the THEN goes with the head
    nxtThen = sepP
    condE   = sepP - 1
  else
    bail = 1 ; exit
  end
  if condE < nxt + 1 then bail = 1 ; exit.
  if nxtOne then exit.
  get(self.tk.tokens, nxt)
  end2 = self.tk.MatchLevel()
  if end2 <= nxt then bail = 1 ; exit.
  end2Eol = self.FirstEolAfter(end2)
  if ~end2Eol then bail = 1 ; exit.
  do McNoElse

! ---- no ELSIF or ELSE at the IF's own depth ----
McNoElse routine
  data
z2   long,auto
dep  long,auto
lv   string(1),auto
tyv  string(1),auto
  code
  dep = 0
  loop z2 = nxt + 1 to end2 - 1
    get(self.tk.tokens, z2)
    if errorcode() then bail = 1 ; exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '+'
      dep += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep -= 1
      if dep < 0 then bail = 1 ; exit.
    elsif lv = '/'
      if ~dep then bail = 1 ; exit.
    end
  end
  if dep then bail = 1.

! ---- the IF condition [nxt+1..condE]: `E = c`, an OR list of them, or `E = c and R` ----
McIfCond routine
  data
p     long,auto
eqP   long,auto
cP    long,auto
orP   long,auto
tU    string(vs:maxName),auto
  code
  p   = nxt + 1
  orP = 0
  loop
    if p + selLen - 1 > condE then bail = 1 ; exit.
    if ~self.SpanTokEqual(selS, selE, p, p + selLen - 1) then bail = 1 ; exit.
    eqP = p + selLen
    if eqP > condE then bail = 1 ; exit.
    get(self.tk.tokens, eqP)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
    if self.tk.tokens.tok <> '=' then bail = 1 ; exit.
    cP = eqP + 1
    if cP > condE then bail = 1 ; exit.
    get(self.tk.tokens, cP)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
    if self.tk.tokens.type <> vt:Literal and self.tk.tokens.type <> vt:Integer then bail = 1 ; exit.
    clear(EqQ)
    eq2:eqExpS = p
    eq2:eqEq   = eqP
    eq2:eqVal  = cP
    eq2:eqOr   = orP
    add(EqQ)
    clear(ValQ)
    vq:valTok = cP
    vq:valArm = 0
    add(ValQ)
    if cP = condE then break.
    get(self.tk.tokens, cP + 1)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.tok &= NULL then bail = 1 ; exit.
    tU = upper(self.tk.tokens.tok)
    if tU = 'OR'
      orP = cP + 1
      p   = cP + 2
      cycle
    end
    if tU = 'AND'
      if records(EqQ) <> 1 then bail = 1 ; exit.  ! `E = a or E = b and R` binds as `E = a or (E = b and R)`
      andTok = cP + 1
      if andTok + 1 > condE then bail = 1 ; exit. ! an `and` with nothing after it
      do McAndRest
      break
    end
    bail = 1 ; exit
  end

! ---- `E = c and R`: R may hold no OR or XOR outside brackets. AND binds tighter than both,
!      so `E = c and R or S` is `(E = c and R) or S`, and S is tested whatever E holds; the
!      merged CASE would test it only under `of c` ----
McAndRest routine
  if self.SpanTopWord(andTok + 1, condE, ' OR XOR ') then bail = 1.

! ---- every arm of the first CASE: it jumps, or it shares no value with the second test and
!      never mentions the selector's variables ----
McSafe routine
  data
a  long,auto
  code
  loop a = 1 to records(ArmQ)
    get(ArmQ, a)
    if errorcode() then bail = 1 ; exit.
    if mq:armJumps then cycle.
    curArm = a
    do McDisjoint
    if ~mcDisj then bail = 1 ; exit.
    if mq:armBodyS
      mcS = mq:armBodyS
      mcE = mq:armBodyE
      do McArmMentions
      if mcMention then bail = 1 ; exit.
    end
  end

! ---- do arm curArm's values and the second test's share none? Constants only; mcDisj ----
McDisjoint routine
  data
x  long,auto
y  long,auto
  code
  mcDisj = 1
  loop x = 1 to records(ValQ)
    get(ValQ, x)
    if errorcode() then mcDisj = 0 ; exit.
    if vq:valArm <> curArm then cycle.
    ta = vq:valTok
    if ~ta then mcDisj = 0 ; exit.
    loop y = 1 to records(ValQ)
      get(ValQ, y)
      if errorcode() then mcDisj = 0 ; exit.
      if vq:valArm then cycle.
      tb = vq:valTok
      if ~tb then mcDisj = 0 ; exit.
      do McSameConst
      if mcSame then mcDisj = 0 ; exit.
    end
  end

! ---- could the constants at ta and tb be the same value? "the same" is the safe answer; mcSame ----
McSameConst routine
  data
tyA string(1),auto
tyB string(1),auto
nA  real,auto
nB  real,auto
  code
  mcSame = 1
  get(self.tk.tokens, ta)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  tyA = self.tk.tokens.type
  litA.setValue(self.tk.tokens.tok)
  get(self.tk.tokens, tb)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  tyB = self.tk.tokens.type
  litB.setValue(self.tk.tokens.tok)
  if tyA <> tyB then exit. ! `of 1` against `of '1'` - not compared, so not proved apart
  if tyA = vt:Integer
    nA = litA.getValue()
    nB = litB.getValue()
    if nA <> nB then mcSame = 0.
    exit
  end
  ! a spelling that cannot be read is not proved apart
  if ~self.LitBytes(litA.getValue(), decA) or ~self.LitBytes(litB.getValue(), decB) then exit.
  ! *** AGAINST A NUMBER A QUOTED CONSTANT IS COMPARED AS A NUMBER. *** With `case n` on a LONG,
  ! '1' and '01' are one value, and two constants that are not numbers at all both read as 0. So
  ! unless the selector is proved a string, only two whole numbers of up to nine digits that
  ! differ are apart.
  if ~mcStr
    if ~decA._DataEnd or ~decB._DataEnd then exit.
    if decA._DataEnd > 9 or decB._DataEnd > 9 then exit.
    if ~decA.IsAllDigits() or ~decB.IsAllDigits() then exit.
    nA = decA.getValue()
    nB = decB.getValue()
    if nA <> nB then mcSame = 0.
    exit
  end
  ! the bytes each spelling stands for; trailing spaces do not count, as in a Clarion compare
  if ~decA.equals(decB, st:clip) then mcSame = 0.

! ---- is the selector [selS..selE] provably a STRING? mcStr. A name declared STRING, CSTRING or
!      PSTRING, or one subscript or slice of one; one byte of a StringTheory's buffer; a call to
!      UPPER, LOWER, CLIP, LEFT, RIGHT, CENTER, SUB, CHR or FORMAT; getValue, slice or getLine on
!      a StringTheory. Anything else - a number, a type not found - leaves it 0 ----
McSelStr routine
  data
hU  string(vs:maxName),auto
  code
  mcStr = 0
  if self.syms &= NULL then exit.
  hU = upper(self.tk.getTok(selS))
  if selS < selE
    case self.tk.getTok(selS + 1)
    of '['
      if self.tk.MatchLeftBracket('[', ']', selS + 1) <> selE then exit.
      if self.ValuePtrPick(hU, selS) then mcStr = 1 ; exit.
    of '('
      if self.tk.MatchLeftBracket('(', ')', selS + 1) <> selE then exit.
      case hU
      of 'UPPER' orof 'LOWER' orof 'CLIP'   orof 'LEFT' orof 'RIGHT' orof 'CENTER'
        mcStr = 1
      of 'SUB'   orof 'CHR'   orof 'FORMAT'
        mcStr = 1
      end
      exit
    of '.'
      if self.tk.getTok(selS + 3) <> '(' then exit.
      if self.tk.MatchLeftBracket('(', ')', selS + 3) <> selE then exit.
      case upper(self.tk.getTok(selS + 2))
      of 'GETVALUE' orof 'SLICE' orof 'GETLINE'
        if self.HayType(hU, selS) = 'STRINGTHEORY' then mcStr = 1.
      end
      exit
    else
      exit
    end
  end
  case self.HayType(hU, selS)
  of 'STRING' orof 'CSTRING' orof 'PSTRING'
    mcStr = 1
  end

! ---- could [mcS..mcE] change the selector? A mention of one of its variables; a DO, since the
!      routine shares the locals; and, when a variable of it is not a plain local, any call that is
!      not a known reader - with brackets, or a name that does not resolve to data, which may be a
!      call without them. A method on the pure list is a known reader only on a StringTheory: a
!      GetLine of the author's own class may move on, or write the selector, at every call. mcMention ----
McArmMentions routine
  data
z2    long,auto
nm    string(vs:maxName),auto
d     long,auto
h     long,auto
callU string(vs:maxName),auto
  code
  mcMention = 0
  loop z2 = mcS to mcE
    get(self.tk.tokens, z2)
    if errorcode() then mcMention = 1 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = vt:reservedWord
      if upper(self.tk.tokens.tok) = 'DO' then mcMention = 1 ; exit.
      cycle
    end
    if self.tk.tokens.type <> vt:label then cycle.
    nm = upper(self.tk.tokens.tok)
    h = len(clip(nm))
    loop d = 1 to h
      if nm[d] = '.' then h = d - 1 ; break.
    end
    if h < 1 then cycle.
    if namesU.findChars(' ' & nm[1 : h] & ' ') then mcMention = 1 ; exit.
    if mcLocal then cycle.
    if z2 < mcE
      get(self.tk.tokens, z2 + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '('
        h = len(clip(nm))                                        ! a call: the callee, after the last dot, must be a known reader
        d = h
        loop while d > 0 and nm[d] <> '.'
          d -= 1
        end
        if d >= h then mcMention = 1 ; exit.
        callU = nm[d + 1 : h]
        if ~pureU.findChars(' ' & clip(callU) & ' ') then mcMention = 1 ; exit.
        if d then mcMention = 1 ; exit.
        if self.tk.GetTok(z2 - 1) = '.' and ~self.PureMethodAt(z2 + 1, pureU) then mcMention = 1 ; exit.
        if self.tk.GetTok(z2 - 1) <> '.' and ~self.PureProc(callU, pureU, mcOwn) then mcMention = 1 ; exit.
        cycle
      end
    end
    if ~self.CondNamesAreData(z2, z2) then mcMention = 1 ; exit. ! not known data: it may be a call to a parameterless procedure
  end

! ---- the first CASE's indent: the trailing whitespace run of its strBefore ----
McIndent routine
  data
k2     long,auto
sbLen2 long,auto
ch2    string(1),auto
  code
  indentSt.free()
  get(self.tk.tokens, caseTok)
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL then exit.
  sbLen2 = size(self.tk.tokens.strBefore)
  k2 = sbLen2
  loop while k2 >= 1
    ch2 = self.tk.tokens.strBefore[k2]
    case val(ch2)
    of 32 orof 9
      k2 -= 1
    else
      break
    end
  end
  if k2 < sbLen2 then indentSt.setValue(sub(self.tk.tokens.strBefore, k2 + 1, sbLen2 - k2)).

! ---- stage the edits (nothing applied yet) ----
McStage routine
  data
k  long,auto
  code
  nxPos = endTok ; nxPos2 = endEol ; nxKind = 2 ; nxTxt = ''         ! the first CASE's END line goes
  do McPush
  if ~nxtIsIf
    nxPos = nxt ; nxPos2 = nxtEol ; nxKind = 2 ; nxTxt = ''          ! the second `case E` line goes; its arms and END stay
    do McPush
    exit
  end
  if andTok                                                          ! `if E = c and R`: an `of c` line in front, `if R` two in, an `end` after
    get(EqQ, 1)
    if errorcode() then bail = 1 ; exit.
    get(self.tk.tokens, eq2:eqVal)
    if errorcode() then bail = 1 ; exit.
    ofLine.setValue(indentSt)
    ofLine.append('of ')
    ofLine.append(self.tk.tokens.tok)
    ofLine.append('<13,10>')
    nxPos = nxt ; nxPos2 = 0 ; nxKind = 8 ; nxTxt = ''
    do McPush
    nxPos = eq2:eqExpS ; nxPos2 = andTok ; nxKind = 2 ; nxTxt = ''   ! `E = c and` goes: the IF tests R alone
    do McPush
    if nxtOne
      nxPos = nxt ; nxPos2 = 0 ; nxKind = 10 ; nxTxt = ''            ! the one-liner stays one line, two in
      do McPush
      nxPos = nxtEol + 1 ; nxPos2 = 0 ; nxKind = 9 ; nxTxt = ''      ! the merged CASE's `end` after it
      do McPush
      exit
    end
    loop k = nxt to end2                                             ! every line of the block IF moves two in
      get(self.tk.tokens, k)
      if errorcode() then bail = 1 ; exit.
      if ~self.tk.tokens.firstOnLine then cycle.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.tok[1] = '<10>' then cycle.                  ! a blank or comment-only line keeps its column
      nxPos = k ; nxPos2 = 0 ; nxKind = 10 ; nxTxt = ''
      do McPush
    end
    nxPos = end2Eol + 1 ; nxPos2 = 0 ; nxKind = 9 ; nxTxt = ''
    do McPush
    exit
  end
  nxPos = nxt ; nxPos2 = 0 ; nxKind = 1 ; nxTxt = 'of'               ! an OR list: the IF head becomes the OF line, in place
  do McPush
  loop k = 1 to records(EqQ)
    get(EqQ, k)
    if errorcode() then bail = 1 ; exit.
    nxPos = eq2:eqExpS ; nxPos2 = eq2:eqEq ; nxKind = 2 ; nxTxt = '' ! `E =` goes, the value stays
    do McPush
    if eq2:eqOr
      nxPos = eq2:eqOr ; nxPos2 = 0 ; nxKind = 1 ; nxTxt = 'orof'
      do McPush
    end
  end
  if nxtOne                                                          ! `then S.` -> S on its own line, `end` on its own
    nxPos = nxtThen ; nxPos2 = 0 ; nxKind = 5 ; nxTxt = ''
    do McPush
    nxPos = nxtThen + 1 ; nxPos2 = 0 ; nxKind = 6 ; nxTxt = ''
    do McPush
    nxPos = nxtDot ; nxPos2 = 0 ; nxKind = 7 ; nxTxt = ''
    do McPush
  elsif nxtThen
    nxPos = nxtThen ; nxPos2 = nxtThen ; nxKind = 2 ; nxTxt = ''     ! a bare THEN on the block head goes with the head
    do McPush
  end

! ---- append one staged edit (dataless routine -> no CODE section) ----
McPush routine
  clear(EdQ)
  ed2:pos  = nxPos
  ed2:pos2 = nxPos2
  ed2:kind = nxKind
  ed2:txt  = nxTxt
  add(EdQ)

! ---- apply HIGHEST POSITION FIRST, and at one position the indent before the insert. The `end` a
!      one-liner's '.' becomes is given the level mark a parse gives an END: SetTok types the word
!      afresh and leaves it none, and a later CASE of this same pass reads the marks to find an
!      EXECUTE around it - one mark short, the walk would stop at a BEGIN and miss the EXECUTE ----
McApply routine
  data
e  long,auto
sb StringTheory
  code
  sort(EdQ, -ed2:pos, -ed2:kind)
  loop e = 1 to records(EdQ)
    get(EdQ, e)
    if errorcode() then break.
    case ed2:kind
    of 1
      self.tk.SetTok(ed2:pos, clip(ed2:txt))                          ! strBefore omitted = the existing trivia stays
    of 2
      self.tk.DeleteToks(ed2:pos, ed2:pos2)
    of 5
      self.tk.SetTok(ed2:pos, '<10>', '')                             ! THEN (or ';') becomes the line break after the OF list
    of 6
      self.tk.SetStrBefore(ed2:pos, indentSt.getValue() & '  ')       ! the body on a line of its own, two in
    of 7
      self.tk.SetTok(ed2:pos, 'end', '<13,10>' & indentSt.getValue()) ! the one-liner's '.' becomes the CASE's `end`
      get(self.tk.tokens, ed2:pos)
      if errorcode() then cycle.
      self.tk.tokens.type = vt:end
      self.tk.tokens.level = '-'
      put(self.tk.tokens)
    of 8
      self.tk.InsertString(ed2:pos, ofLine.getValue())
    of 9
      self.tk.InsertString(ed2:pos, indentSt.getValue() & 'end<13,10>')
    of 10
      get(self.tk.tokens, ed2:pos)
      if errorcode() then cycle.
      if self.tk.tokens.strBefore &= NULL
        self.tk.SetStrBefore(ed2:pos, '  ')
      else
        sb.setValue(self.tk.tokens.strBefore)
        sb.append('  ')
        self.tk.SetStrBefore(ed2:pos, sb.getValue())
      end
    end
  end

!===============================================================================================
! BUILTIN MergeDisjointLocals - two StringTheory locals that can never be in use at once are one.
!
!     rep  StringTheory                        rep  StringTheory
!     res  StringTheory                        ! #Merged into rep: res  StringTheory
!       code                                     code
!       if pOutput._DataEnd                      if pOutput._DataEnd
!         ctk.JoinToks(res)            ->          ctk.JoinToks(rep)
!         ...                                      ...
!         return                                   return
!       end                                      end
!       m.MatchAll(rep)                          m.MatchAll(rep)
!
! Ruled 13 Sep 2026. An IF at the procedure's own level whose last statement is a RETURN cuts the
! procedure in two: the block runs and leaves, or it is skipped and what follows runs. No single
! call sees both halves. A local mentioned only inside such a block and another mentioned only
! after it are never both in use, and a StringTheory starts empty whichever half runs first, so
! one object serves both. The one declared first keeps its name; the other's mentions take it,
! and its declaration is commented out - UnusedVars' spelling, so a reader sees what happened.
!
! WHAT IS CHECKED, every time: both are StringTheory locals of this procedure - declared in its
! data, not parameters, not references; the IF sits at the procedure's own level, has no ELSE or
! ELSIF, and its last statement at its own depth is RETURN; neither local is mentioned before
! the IF, in another top-level block, on the other side, in a routine (a routine shares the
! locals and can run from either half), or beside `&=`; and the scope has no GOTO, no COMPILE or
! OMIT (AutoScopePrep's bail); nor does it INCLUDE a file - in its data, its code or a method
! that follows it - whose text could name either local. One merge per pass, so every later pair
! is judged on the merged text.
!===============================================================================================
VitEngine.BuiltinMergeDisjointLocals Procedure(StringTheory pLog)
s         long,auto
i         long,auto
j         long,auto
k         long,auto
sc        long,auto
kind      byte,auto
ifTok     long               ! the top-level IF that ends in RETURN
ifEnd     long               !   and its END
ifEol     long
dep       long
lv        string(1),auto
tyv       string(1),auto
! #Removed as not used: tU        string(vs:maxName),auto
mdName    STRING(vs:maxName) ! MdWhere in: the name, folded
mdWhere   long               ! MdWhere out: 0 nowhere, 1 inside the block only, 2 after it only, 3 anywhere else as well
mdWhereA  long
mdWhereB  long
declA     long               ! the two declaration tokens
declB     long
txtA      STRING(vs:maxName) ! the surviving name as the author spelled it
txtB      STRING(vs:maxName)
rowA      long
rowB      long
merged    byte
changes   long
logLn     long
LocQ  QUEUE,PRE(lq)          ! the StringTheory locals of the scope, in declaration order
row       long
nameU     STRING(vs:maxName)
declTok   long
      END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  free(LocQ)
  changes = 0
  loop s = 1 to records(self.syms.scopes)
    get(self.syms.scopes, s)
    if errorcode() then break.
    kind = self.syms.scopes.kind
    if kind <> vs:scProc and kind <> vs:scMethod and kind <> vs:scMain then cycle.
    sc = self.syms.scopes.scopeId
    do MdLocals
    if records(LocQ) < 2 then cycle.
    self.AutoScopePrep(sc)
    if self.acBail then cycle.
    if self.urInc then cycle.
    do MdScope
    if merged then break.   ! one merge per pass
  end
  if changes
    self.wantReparse = true ! a declaration line became a comment
    pLog.append('BUILTIN MergeDisjointLocals: ' & changes & ' merge(s) this pass<13,10>')
  end
  free(LocQ)
  return changes

! ---- the StringTheory locals declared in the scope's data section, in declaration order. A
!      parameter is a row of the scope too, declared in the header and not in column 1: it is the
!      caller's object, and a local merged into it would write the caller's value
MdLocals routine
  free(LocQ)
  loop i = 1 to records(self.syms.syms)
    get(self.syms.syms, i)
    if errorcode() then break.
    if self.syms.syms.scopeId <> sc then cycle.
    if self.syms.syms.typeU <> 'STRINGTHEORY' then cycle.
    if self.syms.syms.isRef or self.syms.syms.isLike or self.syms.syms.isField then cycle.
    if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then cycle.
    if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD') then cycle.
    clear(LocQ)
    lq:row     = i
    lq:nameU   = self.syms.syms.nameU
    lq:declTok = self.syms.syms.declTok
    add(LocQ, lq:declTok)
  end

! ---- every IF at the scope's own level whose last statement is RETURN; for each, every pair
MdScope routine
  merged = 0
  dep = 0
  i = self.acCodeT
  loop
    i += 1
    if i >= self.acMainEnd then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if self.tk.tokens.tok &= NULL then cycle.
    if lv = '+'
      if ~dep and self.tk.tokens.firstOnLine and upper(self.tk.tokens.tok) = 'IF'
        ifTok = i
        do MdBlock             ! sets ifEnd when the block qualifies, else 0
        if ifEnd
          do MdPairs
          if merged then exit.
          i = ifEnd            ! carry on after it
          cycle
        end
      end
      dep += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep -= 1
      if dep < 0 then exit.
    end
  end

! ---- does the IF at ifTok qualify? No ELSE/ELSIF at its depth, last statement at its depth a RETURN
MdBlock routine
  data
d2   long,auto
st   long,auto
last long,auto
  code
  ifEnd = 0
  get(self.tk.tokens, ifTok)
  if errorcode() then exit.
  k = self.tk.MatchLevel()
  if k <= ifTok then exit.
  ifEol = self.FirstEolAfter(ifTok)
  if ~ifEol or ifEol >= k then exit.
  d2 = 0 ; st = 0 ; last = 0
  loop j = ifEol + 1 to k - 1
    get(self.tk.tokens, j)
    if errorcode() then exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok[1] = '<10>' then st = 0 ; cycle.
    if self.tk.tokens.tok = ';' and ~d2 then st = 0 ; cycle.
    if ~st
      st = j
      if ~d2 then last = j.
    end
    if lv = '+'
      d2 += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      d2 -= 1
      if d2 < 0 then exit.
    elsif lv = '/'
      if ~d2 then exit. ! an ELSE or ELSIF of this IF: two ways out, not one
    end
  end
  if d2 then exit.
  if ~last then exit.
  get(self.tk.tokens, last)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if upper(self.tk.tokens.tok) <> 'RETURN' then exit.
  ifEnd = k

! ---- every pair of locals: one only inside the block, the other only after it
MdPairs routine
  loop i = 1 to records(LocQ) - 1
    get(LocQ, i)
    if errorcode() then exit.
    rowA = lq:row ; declA = lq:declTok ; mdName = lq:nameU
    do MdWhere
    mdWhereA = mdWhere
    if mdWhereA <> 1 and mdWhereA <> 2 then cycle.
    loop j = i + 1 to records(LocQ)
      get(LocQ, j)
      if errorcode() then exit.
      rowB = lq:row ; declB = lq:declTok ; mdName = lq:nameU
      do MdWhere
      mdWhereB = mdWhere
      if mdWhereA + mdWhereB <> 3 then cycle. ! one inside, one after - either way round
      do MdMerge
      exit
    end
  end

! ---- where is mdName mentioned? Only inside [ifTok..ifEnd] (1), only in the tail after it up to the
!      end of the main code (2), nowhere (0), or anywhere else as well - before the IF, in a routine,
!      beside &= - (3). A dotted mention counts by its head. A mention in a method of a class the
!      procedure declares is (3) as well: such a method shares the procedure's data. Asking that walks
!      the scope list, so the scope is read again after it.
MdWhere routine
  data
q     long,auto
h     long,auto
d     long,auto
nmU   STRING(vs:maxName),auto
inB   long,auto
inT   long,auto
bad   long,auto
cE    long,auto
  code
  mdWhere = 0 ; inB = 0 ; inT = 0 ; bad = 0
  cE = ifTok
  loop                                           ! the IF's own line: its condition runs on both paths
    cE += 1
    get(self.tk.tokens, cE)
    if errorcode() or cE >= ifEnd then break.
    if not self.tk.tokens.tok &= NULL and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
  end
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then mdWhere = 3 ; exit.
  if self.MayHaveLocalMethods(sc) and self.UsedInLocalMethods(mdName, self.syms.scopes.startTok, self.syms.scopes.endTok) then mdWhere = 3 ; exit.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then mdWhere = 3 ; exit.
  loop q = self.syms.scopes.startTok to self.syms.scopes.endTok
    get(self.tk.tokens, q)
    if errorcode() then mdWhere = 3 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    nmU = upper(self.tk.tokens.tok)
    h = len(clip(nmU))
    loop d = 1 to h
      if nmU[d] = '.' then h = d - 1 ; break.
    end
    if h < 1 then cycle.
    if nmU[1 : h] <> mdName then cycle.
    if q = declA or q = declB then cycle.        ! its own declaration
    if q < self.acCodeT then bad += 1 ; cycle.   ! a second declaration line, an OVER, a LIKE
    if q > self.acMainEnd then bad += 1 ; cycle. ! a routine
    if q + 1 <= records(self.tk.tokens)
      get(self.tk.tokens, q + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '&=' then bad += 1 ; cycle.
    end
    if q > 1
      get(self.tk.tokens, q - 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '&=' then bad += 1 ; cycle.
    end
    if q >= ifTok and q < cE
      bad += 1                                   ! in the condition: alive on both sides
    elsif q >= ifTok and q <= ifEnd
      inB += 1
    elsif q > ifEnd
      inT += 1
    else
      bad += 1                                   ! before the IF: alive on both sides
    end
  end
  if bad then mdWhere = 3 ; exit.
  if inB and ~inT then mdWhere = 1 ; exit.
  if inT and ~inB then mdWhere = 2 ; exit.
  if inB and inT then mdWhere = 3.

! ---- THE EDIT: the local declared first keeps its name, every mention of the other takes it, and
!      the other's declaration line is commented out
MdMerge routine
  data
q      long,auto
h      long,auto
d      long,auto
nmU    STRING(vs:maxName),auto
keepU  STRING(vs:maxName),auto
goU    STRING(vs:maxName),auto
goDecl long,auto
mdWhy  STRING(200),AUTO
  code
  if declA < declB
    keepU = ''
    get(LocQ, i) ; keepU = lq:nameU
    get(LocQ, j) ; goU = lq:nameU ; goDecl = declB
  else
    get(LocQ, j) ; keepU = lq:nameU
    get(LocQ, i) ; goU = lq:nameU ; goDecl = declA
  end
  mdWhy = self.RenameTypeWhy(goU, keepU, sc)               ! two declared types the one cannot stand in for
  if mdWhy
    if self.curPass = 1
      pLog.append('BUILTIN MergeDisjointLocals line ' & self.LogLineOf(goDecl) & ': REFUSED - ' & clip(mdWhy) & '.<13,10>')
    end
    exit
  end
  get(self.tk.tokens, choose(declA < declB, declA, declB)) ! the surviving name as the author spelled it
  if errorcode() then exit.
  txtA = self.tk.tokens.tok
  get(self.tk.tokens, goDecl)
  if errorcode() then exit.
  txtB = self.tk.tokens.tok
  logLn = self.LogLineOf(goDecl)
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  loop q = self.syms.scopes.endTok to self.acCodeT by -1   ! backwards: SetTok moves nothing, but the habit is safe
    get(self.tk.tokens, q)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    nmU = upper(self.tk.tokens.tok)
    h = len(clip(nmU))
    loop d = 1 to h
      if nmU[d] = '.' then h = d - 1 ; break.
    end
    if h < 1 or nmU[1 : h] <> goU then cycle.
    if h = len(clip(nmU))
      self.tk.SetTok(q, clip(txtA))
    else
      self.tk.SetTok(q, clip(txtA) & self.tk.tokens.tok[h + 1 : len(clip(self.tk.tokens.tok))])
    end
  end
  self.CommentLineStart(goDecl, '! #Merged into ' & clip(txtA) & ': ')
  if not self.syms &= NULL then self.syms.dirty = 1.
  pLog.append('BUILTIN MergeDisjointLocals line ' & logLn & ': ' & clip(txtB) & ' and ' & clip(txtA) & |
              ' are never in use at once - one only inside the IF on line ' & self.LogLineOf(ifTok)  & |
              ', which returns, the other only after it - so ' & clip(txtB) & ' is ' & clip(txtA) & ' now.<13,10>')
  changes += 1
  merged = 1

!===============================================================================================
! BUILTIN RepairNotes - a note this tool wrote onto the end of a comment with no '!' of its own
! gets one. The "replace all <x> with <y>" and "remove all <x>" notes of the Check builtins can
! sit after a comment with one space and no '!', reading as more words of the comment. This
! looks for "replace all <", "replace all '", "remove all <" and "remove all '" inside a
! comment, each with one space in front of it and something other than '!' before that (spaces
! between do not count), and then asks that the WHOLE note is there, as the tool writes it:
! each character a name from the tool's table, such as <tab>, or the one-character literal the
! tool would print, such as '|', and nothing after the note but spaces, the line end, a '!' or
! the tool's next note. An author's own words in that shape - "here we replace all '<9>' with
! spaces" - are not a note, and are left. Each note found gets '  !' put in front, so it stands
! as a comment of its own. Comment text only - it can change nothing else - and a second run
! finds nothing.
!===============================================================================================
VitEngine.BuiltinRepairNotes Procedure(StringTheory pLog)
i        long,auto
n        long,auto ! notes repaired on this token's text
changes  long
txt      StringTheory
  code
  loop i = 1 to records(self.tk.tokens)
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if ~pLog.findByte(33, 1,, self.tk.tokens.strBefore) then cycle.              ! '!'
    txt.setValue(self.tk.tokens.strBefore)
    n = self.RepairNoteText(txt)
    if ~n then cycle.
    self.tk.SetStrBefore(i, txt.getValue())
    changes += n
    pLog.append('BUILTIN RepairNotes line ' & self.tk.tokens.lineNo & ': ' & n & |
                ' note(s) glued onto a comment now stand as comments of their own.<13,10>')
  end
  return changes

! ---- the repair itself, on one piece of comment text: every glued note gets '  !' in front.
!      Returns how many. A phrase is glued when walking back over spaces from it does not reach '!',
!      and it is a note when NoteEnd finds the whole of one there.
VitEngine.RepairNoteText Procedure(StringTheory pTxt)
k        long,auto
p        long,auto
q        long,auto
w        long,auto
e        long,auto
n        long
phrase   STRING(16),DIM(4)
  code
  phrase[1] = ' replace all <<'
  phrase[2] = ' replace all '''
  phrase[3] = ' remove all <<'
  phrase[4] = ' remove all '''
  loop k = 1 to 4
    p = 1
    loop
      p = pTxt.findChars(clip(phrase[k]), p)
      if ~p then break.
      q = p - 1
      loop while q > 0 and pTxt.valuePtr[q] = ' '
        q -= 1
      end
      if q > 0 and pTxt.valuePtr[q] <> '!'
        do NoteEnd
        if e
          pTxt.insert(p, '  !')
          n += 1
          p += 3
        end
      end
      p += 1
    end
  end
  return n

! ---- e = the last character of the whole note that phrase k at p begins, or 0 when the text there
!      is not one: "replace all X with Y" or "remove all X", each character as the tool spells it,
!      followed by nothing but spaces and then the end of the text, the line end, a '!' or the
!      tool's next note
NoteEnd routine
  w = p + len(clip(phrase[k])) - 1
  do NoteChar
  if ~e then exit.
  if k <= 2
    if e + 6 > pTxt._DataEnd then e = 0 ; exit.
    if pTxt.valuePtr[e + 1 : e + 6] <> ' with ' then e = 0 ; exit.
    w = e + 7
    do NoteChar
    if ~e then exit.
  end
  w = e + 1
  loop while w <= pTxt._DataEnd and pTxt.valuePtr[w] = ' '
    w += 1
  end
  if w > pTxt._DataEnd then exit.
  case val(pTxt.valuePtr[w])
  of 10 orof 13 orof 33
    exit
  end
  if w + 11 <= pTxt._DataEnd and pTxt.valuePtr[w : w + 11] = 'replace all ' then exit.
  if w + 10 <= pTxt._DataEnd and pTxt.valuePtr[w : w + 10] = 'remove all ' then exit.
  e = 0

! ---- e = the last character of the one character spelled at w the way CharName spells it, or 0.
!      Byte 60, a '<', opens a name from the tool's table (<tab>); byte 39, a quote, opens a
!      one-character literal the table has no name for ('|', '<253>'); a lone digit is itself.
!      '<9>' is not one: the tool writes <tab> for it.
NoteChar routine
  data
b     long,auto
z     long,auto
nm    STRING(24)
  code
  e = 0
  if w > pTxt._DataEnd then exit.
  case val(pTxt.valuePtr[w])
  of 60
    z = pTxt.findByte(62, w + 1)
    if ~z or z - w >= size(nm) then exit.
    nm = pTxt.valuePtr[w : z]
    loop b = 0 to 255
      if self.tk.CharNameOfByte(b) = nm then e = z ; break.
    end
  of 39
    z = pTxt.findByte(39, w + 1)
    if ~z or z - w >= size(nm) then exit.
    nm = pTxt.valuePtr[w : z]
    if self.GetSingleCharVal(nm) <> -1 and self.CharName(nm) = nm then e = z.
  of 48 to 57
    nm = pTxt.valuePtr[w]
    if self.CharName(nm) = nm then e = w.
  end
!===============================================================================================
! BUILTIN IncludeBrackets - an INCLUDE written without brackets is written with them:
!     INCLUDE 'KeyCodes.CLW'        ==>      INCLUDE('KeyCodes.CLW')
! The spelling without brackets is one older compilers accepted and the current compiler does
! not (ruled 17 Sep 2026), so the line is REWRITTEN, not only read. ONLY THE ONE-ARGUMENT FORM:
! the keyword first on its line, one string literal, and nothing after it but the line end -
! a trailing comment is trivia on the line-end token, so it neither blocks the rewrite nor
! moves. A line carrying a comma - a section name, or ONCE - is left exactly as written,
! because what those look like without brackets is not something to guess at; the bracketed
! form is not touched; and a label that merely starts with the keyword (INCLUDEFILE) is in
! column 1 and never a directive. The keyword keeps the author's spelling, and the gap that
! stood between it and the quote is what the '(' replaces.
!===============================================================================================
VitEngine.BuiltinIncludeBrackets Procedure(StringTheory pLog)
i        long,auto
n        long,auto ! the token after the literal - the line end - or 0 when the literal ends the file
changes  long
  code
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or ~self.tk.tokens.firstOnLine or self.tk.BufColOne() then cycle.
    if upper(self.tk.tokens.tok) <> 'INCLUDE' then cycle.
    get(self.tk.tokens, i + 1)                                            ! the one argument: a string literal
    if errorcode() or self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:literal then cycle.                      ! '(' - already bracketed - or anything else
    n = i + 2                                                             ! and nothing after it but the line end
    get(self.tk.tokens, n)
    if errorcode()
      n = 0                                                               ! the literal is the last token in the file
    elsif self.tk.tokens.tok &= NULL or size(self.tk.tokens.tok) <> 1 or self.tk.tokens.tok <> '<10>'
      cycle                                                               ! a comma, or anything else: left as written
    end
    self.tk.AddTok(i + 1, '(')                                            ! INCLUDE( - the bracket takes no gap
    self.tk.SetStrBefore(i + 2, '')                                       !   and the literal gives up the space that stood in for it
    self.tk.AddTok(choose(~n, 0, n + 1), ')')                             ! after the literal, which the '(' moved one along - or on the end of the file
    get(self.tk.tokens, i)
    changes += 1
    pLog.append('BUILTIN IncludeBrackets line ' & self.tk.tokens.lineNo & ': INCLUDE ' & |
                'written with brackets - the spelling without them is not one the current compiler accepts<13,10>')
    i += 3                                                                               ! past the ( literal ) just written
  end
  if changes then self.wantReparse = true.                                               ! three new tokens carry no line numbers or levels: re-lex before the next pass
  return changes
!===============================================================================================
! BUILTIN ClippedCompare - a comparison of two StringTheory values that are both clipped lines
! of a split tests the lengths first:
!     if a.getValue() <> b.getValue() then return false.
!     if a._DataEnd <> b._DataEnd or (a._DataEnd and a.valuePtr[1 : a._DataEnd] <> b.valuePtr[1 : b._DataEnd]) then return false.
! Both spellings of a value read are recognised - getValue() and the direct read that
! st-getvalue-slice-all writes - and = as well as <>. Clarion's own compare ignores trailing
! spaces and the length test does not, so the two agree only when neither value can carry one.
! That is what the guard establishes: each side was loaded, in the same loop as the compare and
! above it - in the loop's body itself, not inside a branch the iteration may skip - by
! setValueFromLine from a split that clips, by setValueFromLine followed on its own line by the
! object's clip(), or by setValue(x.getLine(n), st:clip) - a load is that one statement, and a
! split clips by its own arguments; the split that gives the lines is the
! last one sure to have run before the loop, and any split that may or may not have run by the
! time of the compare - inside the loop, or after it inside a loop around it - clips as well;
! nothing writes those lines after that split (a setLine, an addLine and the like, a swap, the
! lines queue named directly, setValue, append or prepend given st:lines or an option that may
! hold it, the object handed whole to a call, or a routine called); nothing that could change
! either value lies between its load
! and the compare - what follows the load on its own line included - a routine called, a store
! into its valuePtr or _DataEnd, or either of them, getValuePtr(), or a slice of the buffer,
! handed whole to a call that may write it; both sides, and the objects their lines come from,
! are StringTheory objects; one that a call can reach without its name - a parameter, a
! reference, a STATIC or THREAD object, one declared outside the procedure - has no call that
! could change it unseen between its load and the compare, or after the split that clips its
! lines; no reference is taken on
! either object or on a member of one, its valuePtr among them, or kept by a call it is handed
! to, and no method of a class the procedure declares uses one; and the compare is the whole
! condition, on one line - the rewrite replaces it whole, and a compare wrapped with a bar would
! lose the line break and any comment after the bar. Unequal lengths are settled by one integer
! compare and no value is copied. The empty case is exact: two empty values have equal lengths,
! so <> answers false and = answers true, as before, and the slices sit behind an AND that
! Clarion never evaluates past a false.
! Neither side, nor the object a side's line is read from, may be a member of an object, such as
! self.ka: a method of the class, or a procedure handed the object, can change it out of sight.
! While the group st-equals runs it STANDS ASIDE for every compare it reads: the group's rules
! take getValue() on both sides, and its BUILTIN DirectReadEquals takes the direct read on either
! side, and both write a.equals(b, st:clip), exact from StringTheory 3.90 on (ruled 28 Oct 2026,
! and for the direct read 3 Nov 2026). So it rewrites only with a rule file that lacks the group,
! with the group not selected, or with --stversion= older than 3.90. Like DropLineBuffer it scans twice on pass 1: a
! report-only scan that sees every site, then the editing scan, which stops at its first edit
! because the splice moves every later token.
!===============================================================================================
VitEngine.BuiltinClippedCompare Procedure(StringTheory pLog)
i          long,auto
ccX        long,auto
ccY        long,auto
ccZ        long,auto
ccD        long,auto          ! instring scratch
ccN        long,auto          ! length scratch
ccIf       long,auto          ! the IF token - the line being rewritten
ccS1       long,auto          ! the left value read, first and last token
ccE1       long,auto
ccS2       long,auto          ! and the right
ccE2       long,auto
ccOp       STRING(2)          ! the comparator as written
ccA        STRING(vs:maxName) ! the two receivers, folded
ccB        STRING(vs:maxName)
ccATxt     STRING(vs:maxName) !   and as the author spelled them
ccBTxt     STRING(vs:maxName)
ccLoop     long,auto          ! the LOOP token enclosing the compare
ccDepth    long,auto
ccLvl      long,auto          ! CcLineDepth: the depth the line in hand starts at, 0 = outside any structure
ccLoopD    long,auto          ! CcSplitOf: the depth the loop header starts at
ccTk       long,auto          ! CcSureSplit input: the split's first token
ccSure     byte               !   output: the split is sure to have run when the loop is reached
ccBack     long,auto          !   its own depth count
ccBad      long               ! CcSplitOf: the split that leaves the lines unclipped, for the reason
ccLnW      long               !   a write of the lines no sure clipping split follows, for the reason
ccTopL     long               !   the first token of the outermost loop around the compare's loop
ccCondA    long               ! CcLoads: a's first load inside a branch of the body, 0 = none
ccCondB    long
ccFrom     long,auto          ! CcFill: first token of the line in hand
ccNext     long,auto          !   and of the next
ccHeadIx   long               ! CcHead input: a ccQ row
ccHead     STRING(vs:maxName) !   output: the receiver in front of it
ccTail     STRING(96)
ccLoadA    byte               ! a has been loaded in this loop, above the compare
ccLoadB    byte
ccNeedA    byte               ! ... by setValueFromLine, so a's own split must clip
ccNeedB    byte
ccSrcA     STRING(vs:maxName) ! or by setValue(x.getLine(n)) with no st:clip, so x's split must
ccSrcB     STRING(vs:maxName) !   (blank when the load itself clips)
ccSeen     byte
ccLdr      STRING(vs:maxName) ! CcStmtHead: the receiver of the line's first statement
ccSrc      STRING(vs:maxName) ! CcLoadSource: the object a getLine load reads, blank when the load clips
ccStmt     long               ! CcStmtHead: the ccQ row holding the statement's method name
ccScFirst  long,auto          ! the procedure, for the split scan
ccScLast   long,auto
ccSc       long,auto
ccWhy      STRING(200)
ccRpt      byte               ! the report-only scan
ccEdited   byte
ccAside    byte               ! CcStandAside: the rule group st-equals runs, so the compare it takes is left to it
ccSums     byte               ! CcPassedOn: the summaries are built for this call
ccArgS     long               ! CcArgs input: the ccQ row holding a call's '('
ccArgE     long               !   output: the row of its ')', 0 = it does not close on the line
ccArgLin   byte               !   and it is given st:lines, or an option that may hold it (LinesOptAt)
ccMent     long               ! CcLoads: the first ccQ row the mention test reads - past the load on a load line
ccDoW      long               ! CcSplitOf: a DO after the split that clips the lines, for the reason
ccFarW     long               !   a line after it whose call can write them unseen, for the reason
ccFarNm    STRING(vs:maxName) !   and that call
ccFarK     byte               ! CcFarKind: how a call reaches ccTok unseen - 0 none, 1 parameter, 2 reference, 3 STATIC or THREAD, 4 not this procedure's
ccFarA     byte               !   kept for a
ccFarB     byte               !   and for b
ccCall     STRING(vs:maxName) ! CcFarCall: a call on the line that may change ccTok unseen, blank = none
ccCallRow  long               !   input: the first ccQ row it reads
ccPure     StringTheory       ! ' NAME NAME ' - the calls that only read, as IfChainToCase lists them
ccOwn      StringTheory       !   the names on it this file gives a procedure of its own (PureOwnList)
ccNew      StringTheory       ! the condition as rewritten
ccTok      STRING(vs:maxName)
ccReads    EQUATE(' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH LEN SLICE SUB CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS ')
ccLinesWr  EQUATE(' SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN ADDLINE SETLINE INSERTLINE SETLINEFROMVALUE WRAPTEXT ')
ccQ        QUEUE,PRE(cc)
tx           STRING(96)
tk           long             ! the row's token in the real stream
           END
  code
  if self.syms &= NULL then return 0.
  do CcStandAside
  self.syms.EnsureFresh()
  self.IfCasePureList(ccPure)
  self.PureOwnList(ccPure, ccOwn)
  ccEdited = 0
  if self.curPass = 1
    ccRpt = 1 ; do CcScan
  end
  ccRpt = 0 ; do CcScan
  return ccEdited

! ---- the rule group st-equals writes the same compare as a.equals(b, st:clip), which from StringTheory
!      3.90 on compares the clipped lengths first and is exact, so while any rule of that group runs this
!      builtin stands aside, without a word (ruled 28 Oct 2026) - for every spelling it reads: the rules
!      take getValue() on both sides and DirectReadEquals the direct read (3 Nov 2026). Whether it runs is the question RunPass
!      asks of every rule (PassVisits): the group selected, --stversion= not holding it back, the rule
!      not skipped, and no --only= naming another. A rule file without the group runs this builtin as
!      before. The rules queue is left on the row it was on, which RunPass reads after the builtin
CcStandAside routine
  data
g     long,auto
r     long,auto
here  long,auto
  code
  ccAside = 0
  if self.rl &= NULL then exit.
  g = self.rl.FindGroup('st-equals')
  if ~g then exit.
  here = pointer(self.rl.rules)
  loop r = 1 to records(self.rl.rules)
    get(self.rl.rules, r)
    if errorcode() then break.
    if self.rl.rules.groupId <> g then cycle.
    if self.PassVisits(r) then ccAside = 1 ; break.
  end
  if here then get(self.rl.rules, here).

! ---- every IF in the file whose whole condition is <value read> <op> <value read>
CcScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'IF' then cycle.
    ccIf = i
    ccS1 = ccIf + 1
    if ~self.CcValueAt(ccS1, ccA, ccE1) then cycle.
    ccTok = self.tk.GetTok(ccE1 + 1)
    if ccTok <> '<<>' and ccTok <> '=' and ccTok <> '~=' then cycle.
    ccOp = ccTok
    ccS2 = ccE1 + 2
    if ~self.CcValueAt(ccS2, ccB, ccE2) then cycle.
    if ccA = ccB then cycle.
    if ccAside then cycle.
    ccWhy = ''
    ccTok = upper(self.tk.GetTok(ccE2 + 1))
    if ccTok <> 'THEN' and ccTok <> '<10>'
      ccWhy = 'the compare is not the whole condition'
    end
    if ~ccWhy and self.SpanHasNL(ccS1, ccE2)
      ccWhy = 'the compare is written across lines, and the rewrite would lose the line break and any words after the bar'
    end
    if ~ccWhy then do CcFindLoop.
    if ~ccWhy then ccTok = ccA ; do CcMember.
    if ~ccWhy then ccTok = ccB ; do CcMember.
    if ~ccWhy then do CcLoads.
    if ~ccWhy then do CcSplitClips.
    if ccWhy
      if ccRpt
        pLog.append('BUILTIN ClippedCompare line ' & self.LogLineOf(ccIf) & ': REFUSED - ' & clip(ccWhy) & '.<13,10>')
      end
      cycle
    end
    if ccRpt then cycle.
    ! ---- THE EDIT: the two value reads and the comparator become the length-first condition
    do CcNames
    if ccOp = '='
      ccNew.setValue(' ' & clip(ccATxt) & '._DataEnd = ' & clip(ccBTxt) & '._DataEnd and (~' & clip(ccATxt) & '._DataEnd or ' &  |
                     clip(ccATxt) & '.valuePtr[1 : ' & clip(ccATxt) & '._DataEnd] = ' & clip(ccBTxt) & '.valuePtr[1 : ' & clip(ccBTxt) & '._DataEnd])')
    else
      ccNew.setValue(' ' & clip(ccATxt) & '._DataEnd <<> ' & clip(ccBTxt) & '._DataEnd or (' & clip(ccATxt) & '._DataEnd and ' & |
                     clip(ccATxt) & '.valuePtr[1 : ' & clip(ccATxt) & '._DataEnd] <<> ' & clip(ccBTxt) & '.valuePtr[1 : ' & clip(ccBTxt) & '._DataEnd])')
    end
    self.tk.DeleteToks(ccS1, ccE2)
    self.tk.InsertString(ccS1, ccNew, 1)
    if not self.syms &= NULL then self.syms.dirty = 1.
    pLog.append('BUILTIN ClippedCompare line ' & self.LogLineOf(ccIf) & ': ' & clip(ccATxt) & ' and ' & clip(ccBTxt) &           |
                ' are clipped lines, so the compare tests the length first.<13,10>')
    ccEdited = 1
    exit
  end

! ---- the LOOP whose body holds the compare: walk back over balanced blocks to the first
!      unmatched opener
CcFindLoop routine
  ccLoop = 0 ; ccDepth = 0
  loop ccX = ccIf - 1 to 1 by -1
    get(self.tk.tokens, ccX)
    if errorcode() then break.
    case self.tk.tokens.level
    of '-'
      ccDepth += 1
    of '+'
      if ~ccDepth then ccLoop = ccX ; break.
      ccDepth -= 1
    end
  end
  if ~ccLoop or upper(self.tk.GetTok(ccLoop)) <> 'LOOP'
    ccWhy = 'the compare is not inside a loop over the lines'
  end

! ---- the loads of a and b between the loop header and the compare, and nothing changing either
!      after its load. A load inside a branch of the body is no load: on an iteration that skips
!      the branch the value is whatever it held before. Before the load proper that is overwritten;
!      after it, the branch's load is a change like any other, and the mention test says so. A load
!      is one statement, to its own closing bracket: what follows it on the line - after a ';' - goes
!      through the mention test like any later line (ccMent), and `; <obj>.clip()` after
!      setValueFromLine is the object clipping itself. A side that a call can reach without its name
!      - a parameter, a reference, a STATIC or THREAD object, one declared outside the procedure - may
!      not have a call after its load that could change it unseen (CcFarCall)
CcLoads routine
  ccLoadA = 0 ; ccLoadB = 0 ; ccNeedA = 0 ; ccNeedB = 0 ; ccSrcA = '' ; ccSrcB = ''
  ccCondA = 0 ; ccCondB = 0 ; ccDepth = 0
  ccSc = self.syms.ScopeContaining(ccIf, vs:scProc, vs:scMethod)
  ccTok = ccA ; do CcFarKind ; ccFarA = ccFarK
  ccTok = ccB ; do CcFarKind ; ccFarB = ccFarK
  ccFrom = ccLoop
  loop while ccFrom > 0 and ccFrom < ccIf
    do CcFill
    if ccFrom = ccLoop then ccFrom = ccNext ; cycle.
    do CcLineDepth                                                  ! ccLvl: 0 = the body itself, else a branch in it
    do CcStmtHead                                                   ! the line's first statement: ccLdr.ccTail, ccStmt = its tail row
    do CcDoLine ; if ccWhy then exit.                               ! a DO with a load above it or on its line could change the value
    ccMent = 1                                                      ! the mention test reads the whole line, unless a load ends before it
    if (ccLdr = ccA or ccLdr = ccB) and ccTail = 'SETVALUEFROMLINE' ! <obj>.setValueFromLine(n): its own split must clip -
      if ccLvl then do CcCondLoad.                                  !   unless the line goes on `; <obj>.clip()`, which clips it
      if ~ccLvl
        do CcClipAfter
        if ccLdr = ccA then ccLoadA = 1 ; ccNeedA = choose(ccSeen = 0) ; ccSrcA = ''.
        if ccLdr = ccB then ccLoadB = 1 ; ccNeedB = choose(ccSeen = 0) ; ccSrcB = ''.
      end
    end
    if (ccLdr = ccA or ccLdr = ccB) and ccTail = 'SETVALUE'         ! <obj>.setValue(x.getLine(n) [, st:clip])
      do CcLoadSource
      if ccSeen and ccLvl then ccMent = 1 ; do CcCondLoad.
      if ccSeen and ~ccLvl
        if ccLdr = ccA then ccLoadA = 1 ; ccNeedA = 0 ; ccSrcA = ccSrc.
        if ccLdr = ccB then ccLoadB = 1 ; ccNeedB = 0 ; ccSrcB = ccSrc.
      end
    end
    loop ccX = ccMent to records(ccQ)                               ! any other mention after a load is a change, unless it reads
      ccHeadIx = ccX ; do CcHead
      get(ccQ, ccX)
      if errorcode() then break.
      if ccHead = ccA and ccLoadA or ccHead = ccB and ccLoadB
        ccN = len(clip(ccQ.tx))
        ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
        if ccD and ccD < ccN
          ccTail = ccQ.tx[ccD + 1 : ccN]
        else
          ccTail = ccQ.tx
        end
        if ~instring(' ' & clip(ccTail) & ' ', ccReads, 1, 1)
          ccWhy = lower(clip(ccHead)) & ' is changed between its load and the compare - ' & lower(clip(ccTail)) & ' on line ' & self.LogLineOf(ccFrom)
          exit
        end
        if ccTail = 'VALUEPTR' or ccTail = '_DATAEND' then do CcStoreTo.
        if ~ccWhy then do CcPassedOn.
        if ccWhy then exit.
      end
      if ccQ.tx = ccA and ccLoadA or ccQ.tx = ccB and ccLoadB       ! a bare mention: a call could change it
        ccTok = ccQ.tx
        get(ccQ, ccX + 1)
        if errorcode() or ccQ.tx <> '.'
          ccWhy = lower(clip(ccTok)) & ' is changed between its load and the compare - it is handed to a call on line ' & self.LogLineOf(ccFrom)
          exit
        end
      end
    end
    if ccFarA and ccLoadA
      ccTok = ccA ; ccFarK = ccFarA ; ccCallRow = ccMent ; do CcFarCall
      if ccCall then do CcFarSideWhy ; exit.
    end
    if ccFarB and ccLoadB
      ccTok = ccB ; ccFarK = ccFarB ; ccCallRow = ccMent ; do CcFarCall
      if ccCall then do CcFarSideWhy ; exit.
    end
    ccFrom = ccNext
  end
  if ~ccWhy and ~ccLoadA then ccTok = ccA ; ccZ = ccCondA ; do CcNoLoad.
  if ~ccWhy and ~ccLoadB then ccTok = ccB ; ccZ = ccCondB ; do CcNoLoad.

! ---- ccTok, a side or the object a side's line is read from, is a member of an object - self.ka, obj.ka:
!      a method of the class, or a procedure the object was handed to, can change it out of sight, so the
!      compare is left alone
CcMember routine
  ccD = pLog.findByte(46,,, ccTok) ! <dot>
  if ccD > 1
    ccWhy = lower(clip(ccTok)) & ' is a member of ' & lower(ccTok[1 : ccD - 1]) & ', and code outside this procedure can change it'
  end

! ---- the load at ccFrom sits inside a branch: the first such is kept for the reason when no load
!      in the body proper is found
CcCondLoad routine
  if ccLdr = ccA and ~ccLoadA and ~ccCondA then ccCondA = ccFrom.
  if ccLdr = ccB and ~ccLoadB and ~ccCondB then ccCondB = ccFrom.

! ---- ccTok is not loaded in the body proper; ccZ = its load inside a branch, 0 = none
CcNoLoad routine
  if ccZ
    ccWhy = lower(clip(ccTok)) & ' is loaded only inside a branch of the loop, on line ' & self.LogLineOf(ccZ) & ' - on an iteration that skips the branch the compare runs on whatever it held before'
  else
    ccWhy = lower(clip(ccTok)) & ' is not loaded from a line in this loop'
  end

! ---- the load line is <obj>.setValueFromLine(n), which ends at its own ')': ccMent = the row after
!      it. When the line goes on `; <obj>.clip()` - the object clips itself after the load, in either
!      spelling of the call - its split need not clip: ccSeen = 1, and ccMent moves past the clip
CcClipAfter routine
  ccSeen = 0
  ccArgS = ccStmt + 1 ; do CcArgs
  if ~ccArgE then ccMent = records(ccQ) + 1 ; exit.
  ccMent = ccArgE + 1
  loop ccY = ccMent to records(ccQ)
    get(ccQ, ccY)
    if errorcode() then break.
    if ccQ.tx <> ';' then cycle.
    ccZ = 0                          ! the row holding '(' once obj.clip is seen
    ccHeadIx = ccY + 1 ; do CcHead   ! merged: one token, obj.clip
    get(ccQ, ccY + 1)
    if ~errorcode() and ccHead = ccLdr
      ccN = len(clip(ccQ.tx))
      ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
      if ccD and ccD < ccN and ccQ.tx[ccD + 1 : ccN] = 'CLIP' then ccZ = ccY + 2.
    end
    if ~ccZ                          ! split: obj . clip
      ccHeadIx = ccY + 3 ; do CcHead
      get(ccQ, ccY + 3)
      if ~errorcode() and ccHead = ccLdr and ccQ.tx = 'CLIP' then ccZ = ccY + 4.
    end
    if ccZ
      get(ccQ, ccZ)
      if ~errorcode() and ccQ.tx = '('
        get(ccQ, ccZ + 1)
        if ~errorcode() and ccQ.tx = ')' then ccSeen = 1 ; ccMent = ccZ + 2.
      end
    end
    break
  end

! ---- the line's first statement in ccQ: receiver ccLdr and tail ccTail, from row 1 when it is
!      dotted (a.setValue) or rows 1-3 when split (a . setValue); ccStmt = the tail's row
CcStmtHead routine
  ccLdr = '' ; ccTail = '' ; ccStmt = 0
  ccHeadIx = 1 ; do CcHead
  if ccHead
    ccStmt = 1
  else
    ccHeadIx = 3 ; do CcHead
    if ccHead then ccStmt = 3.
  end
  if ~ccStmt then exit.
  ccLdr = ccHead
  get(ccQ, ccStmt)
  ccN = len(clip(ccQ.tx))
  ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
  if ccD and ccD < ccN
    ccTail = ccQ.tx[ccD + 1 : ccN]
  else
    ccTail = ccQ.tx
  end

! ---- the load line is <obj>.setValue( ... ): ccSeen = 1 when the call is setValue(x.getLine(n)) or
!      setValue(x.getLine(n), st:clip) exactly - the getLine its whole first argument, and nothing but
!      st:clip after it - and then ccSrc = x, or blank when the load clips by itself, and ccMent = the
!      row after the setValue's own ')'. Anything else - `x.getLine(i) & ' '`, a st:clip that belongs to
!      another statement on the line - is no load
CcLoadSource routine
  ccSeen = 0 ; ccSrc = '' ; ccMent = 1
  ccArgS = ccStmt + 1 ; do CcArgs
  if ~ccArgE then exit.
  ccY = 0
  ccHeadIx = ccStmt + 2 ; do CcHead
  get(ccQ, ccStmt + 2)
  if ~errorcode() and ccHead
    ccN = len(clip(ccQ.tx))
    ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
    if ccD and ccD < ccN and ccQ.tx[ccD + 1 : ccN] = 'GETLINE' then ccY = ccStmt + 2.
  end
  if ~ccY
    ccHeadIx = ccStmt + 4 ; do CcHead
    get(ccQ, ccStmt + 4)
    if ~errorcode() and ccHead and ccQ.tx = 'GETLINE' then ccY = ccStmt + 4.
  end
  if ~ccY then exit.
  ccSrc = ccHead
  ccZ = ccArgE
  ccArgS = ccY + 1 ; do CcArgs
  if ~ccArgE then ccSrc = '' ; exit.
  get(ccQ, ccArgE + 1)
  if errorcode() then ccSrc = '' ; exit.
  if ccArgE + 1 = ccZ
    ccSeen = 1
  elsif ccQ.tx = ','
    get(ccQ, ccArgE + 2)
    if ~errorcode() and ccQ.tx = 'ST:CLIP' and ccArgE + 3 = ccZ then ccSeen = 1 ; ccSrc = ''.
  end
  if ~ccSeen then ccSrc = '' ; exit.
  ccMent = ccZ + 1

! ---- the splits that must clip: the object itself after setValueFromLine, or the source of a
!      getLine load that does not clip - anywhere in the procedure before the loop. Code the
!      procedure INCLUDEs is not in this file and may split or pad either: an INCLUDE refuses. Nor
!      may either object be handed to a call that may keep a reference to it, anywhere in the
!      procedure: a later call could change the value through it, unseen
CcSplitClips routine
  ccSc = self.syms.ScopeContaining(ccIf, vs:scProc, vs:scMethod)
  if ~ccSc then ccWhy = 'the compare is not inside a procedure' ; exit.
  self.syms.scopes.scopeId = ccSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then ccWhy = 'the compare is not inside a procedure' ; exit.
  ccScFirst = self.syms.scopes.startTok
  ccScLast  = self.syms.scopes.endTok
  ccTok = ccA ; do CcIsSt
  if ~ccWhy then ccTok = ccB ; do CcIsSt.
  if ~ccWhy and ccSrcA then ccTok = ccSrcA ; do CcIsSt.
  if ~ccWhy and ccSrcB then ccTok = ccSrcB ; do CcIsSt.
  if ccWhy then exit.
  do CcTopLoop
  ccTok = ccA ; do CcEscapes
  if ~ccWhy then ccTok = ccB ; do CcEscapes.
  if ~ccWhy then ccWhy = self.ObjReach(ccA, ccIf, 1).
  if ~ccWhy then ccWhy = self.ObjReach(ccB, ccIf, 1).
  if ccWhy then exit.
  if self.ScopeIncludes(ccSc)
    ccWhy = lower(clip(ccA)) & ' and ' & lower(clip(ccB)) & ' may be changed by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  if ccNeedA then ccTok = ccA ; do CcSplitOf.
  if ~ccWhy and ccNeedB then ccTok = ccB ; do CcSplitOf.
  if ~ccWhy and ccSrcA then ccTok = ccSrcA ; do CcSplitOf.
  if ~ccWhy and ccSrcB then ccTok = ccSrcB ; do CcSplitOf.

! ---- do the lines ccTok carries when the compare runs come from a split that clips? The last
!      split before the loop that is sure to have run - no structure holding it closes, and no
!      other branch of one begins, before the loop; no label between - gives the lines, and it
!      decides. A split that may or may not have run by then (one inside such a structure, or
!      inside the loop itself, which comes round again) must clip as well as what it would replace.
!      No split sure to have run is a refusal, and so is a member of an object, such as self.ka, whose
!      lines code outside the procedure can write. Every statement on a line is read, and a split
!      clips by its own arguments - a st:clip after a ';' belongs to another statement. After the split
!      that clips, these write the lines: a lines writer (ccLinesWr), swap, the lines queue named
!      directly, setValue, append or prepend given st:lines or an option that may hold it (which
!      copies another object's lines in), the object handed whole to a call, a DO - the routine
!      shares the procedure's data - and,
!      when a call can reach the object without its name (CcFarKind), any call CcFarCall does not clear
CcSplitOf routine
  ccSeen = 0 ; ccBad = 0 ; ccDepth = 0 ; ccLoopD = 0
  ccLnW = 0 ; ccDoW = 0 ; ccFarW = 0
  do CcMember
  if ~ccWhy then do CcEscapes.
  if ccWhy then exit.
  do CcFarKind
  ccFrom = ccScFirst
  loop while ccFrom > 0 and ccFrom < ccScLast
    do CcFill
    do CcLineDepth
    if ccFrom = ccTopL then ccLoopD = ccLvl.
    if ccFrom > ccTopL and ccLvl <= ccLoopD then break.                                ! the first line after the loop's END
    loop ccX = 1 to records(ccQ)
      ccHeadIx = ccX ; do CcHead
      get(ccQ, ccX)
      if errorcode() then break.
      ccN = len(clip(ccQ.tx))
      ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
      if ccD and ccD < ccN
        ccTail = ccQ.tx[ccD + 1 : ccN]
      else
        ccTail = ccQ.tx
      end
      if ccHead = ccTok and instring(' ' & clip(ccTail) & ' ', ccLinesWr, 1, 1) then ccLnW = ccQ.tk.
      if ccQ.tx = ccTok and self.tk.GetTok(ccQ.tk + 1) <> '.' then ccLnW = ccQ.tk.
      if ccQ.tx = 'DO' then ccDoW = ccQ.tk.
      if ccHead = ccTok and (ccTail = 'SWAP' or ccTail = 'LINES' or ccTail[1 : 6] = 'LINES.') then ccLnW = ccQ.tk.
      if ccHead = ccTok and (ccTail = 'SETVALUE' or ccTail = 'APPEND' or ccTail = 'PREPEND')
        ccArgS = ccX + 1 ; do CcArgs
        get(ccQ, ccX)
        if ccArgLin then ccLnW = ccQ.tk.
      end
      if ccTail <> 'SPLIT' or ccHead <> ccTok then cycle.
      ccTk = ccQ.tk ; ccSure = 0
      if ccFrom < ccLoop then do CcSureSplit.
      ccY = 0                                                                          ! 1 = this split clips: st:clip as its own
      get(ccQ, ccX + 1)                                                                !   FIFTH argument, pClip - in the quote or
      if ~errorcode() and self.SplitOwnArgs(ccQ.tk - 1) then ccY = self.scClip.        !   pLeft slot it is a 1 that does not clip
      get(ccQ, ccX)
      if ccSure
        ccSeen = ccY
        if ccY then ccBad = 0 ; ccLnW = 0 ; ccDoW = 0 ; ccFarW = 0.
      else
        ccSeen = choose(ccSeen and ccY)
      end
      if ~ccY then ccBad = ccTk.
    end
    if ccFarK and ccSeen
      ccCallRow = 1 ; do CcFarCall
      if ccCall then ccFarW = ccFrom ; ccFarNm = ccCall.
    end
    ccFrom = ccNext
  end
  if ~ccSeen and ccBad
    ccWhy = 'the split of ' & lower(clip(ccTok)) & ' on line ' & self.LogLineOf(ccBad) & ' does not clip, so a line of it may carry a trailing space'
  elsif ~ccSeen
    ccWhy = 'no split of ' & lower(clip(ccTok)) & ' is sure to have run before the loop, so where its lines come from cannot be seen'
  elsif ccLnW
    ccWhy = lower(clip(ccTok)) & '''s lines are written on line ' & self.LogLineOf(ccLnW) & ' after the split that clips them, or handed to a call that could, so a line may carry a trailing space'
  elsif ccDoW
    ccWhy = 'line ' & self.LogLineOf(ccDoW) & ' calls a routine after the split that clips the lines of ' & lower(clip(ccTok)) & |
            ', and the routine could write them, so a line may carry a trailing space'
  elsif ccFarW
    ccWhy = lower(clip(ccTok)) & ' is ' & choose(ccFarK = 1, 'a parameter', choose(ccFarK = 2, 'a reference', choose(ccFarK = 3, 'STATIC or THREAD', 'not this procedure''s own'))) & |
            ', and line ' & self.LogLineOf(ccFarW) & ' calls ' & lower(clip(ccFarNm)) & ' after the split that clips its lines, which could write them without naming it'
  end

! ---- ccTopL = the first token of the line of the outermost LOOP or ACCEPT around the compare's loop, or of
!      that loop's own line when there is none. Its body comes round again, so a write of the lines after
!      the compare's loop, inside it, reaches the next pass's loads: the split walk runs to its END
CcTopLoop routine
  ccTopL = ccLoop ; ccBack = 0
  loop ccY = ccLoop - 1 to ccScFirst by -1
    get(self.tk.tokens, ccY)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      ccBack += 1
    of '+'
      if ccBack
        ccBack -= 1
      elsif upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT'
        ccTopL = ccY
      end
    end
  end
  loop ccY = ccTopL to ccScFirst by -1
    get(self.tk.tokens, ccY)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then ccTopL = ccY ; break.
  end

! ---- ccTok can change out of sight of the walks here: a method of a class the procedure declares uses
!      it, or a reference is taken on it anywhere in the procedure, through which a write would not
!      name it. A reference on a MEMBER of it is one too - `r &= a.valuePtr` is its buffer, and
!      `r = 'q'` writes the bytes and leaves the length - so the root of what follows the `&=`
!      decides, as in DgProvenNonEmpty: `&= a`, `&= a.valuePtr` and `&= a.getValuePtr()` all root at a.
!      The other way round as well: `a &= other` makes a the other object, which a write under that
!      name changes
CcEscapes routine
  data
rt   string(vs:maxName),auto
  code
  if self.MayHaveLocalMethods(ccSc) and self.UsedInLocalMethods(upper(ccTok), ccScFirst, ccScLast)
    ccWhy = lower(clip(ccTok)) & ' is used in a method of a class this procedure declares, which can change it where this pass does not look'
    exit
  end
  loop ccY = ccScFirst to ccScLast
    get(self.tk.tokens, ccY)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '&=' then cycle.
    rt = self.tk.GetTok(ccY + 1)
    if self.NameRoot(self.tk.GetTok(ccY - 1)) = self.NameRoot(ccTok)
      ccWhy = lower(clip(ccTok)) & ' is set by reference to ' & lower(clip(rt)) & ' on line ' & self.LogLineOf(ccY) & |
              ', and a write under that name would not name it'
      exit
    end
    if self.NameRoot(rt) <> self.NameRoot(ccTok) then cycle.
    ccWhy = 'a reference is taken on ' & lower(clip(rt)) & ' on line ' & self.LogLineOf(ccY) & ', and a write through it would not name it'
    exit
  end

! ---- a DO on the line in hand, when a or b is loaded above it or on the line itself: the routine
!      shares the procedure's data and could change the value between its load and the compare
CcDoLine routine
  if ~ccLoadA and ~ccLoadB and ccLdr <> ccA and ccLdr <> ccB then exit.
  loop ccX = 1 to records(ccQ)
    get(ccQ, ccX)
    if errorcode() then break.
    if ccQ.tx = 'DO'
      ccWhy = 'line ' & self.LogLineOf(ccFrom) & ' calls a routine between a load and the compare, and the routine could change the value'
      exit
    end
  end

! ---- the mention in the ccQ row ccX starts a statement, so it is the target of an assignment: a store
!      into the value, or a new length. StoreHead answers from the token stream: after a line end, ';',
!      THEN or ELSE, a column-1 label standing in front of its statement, or the debug mark that begins
!      a line (`? a.valuePtr[1] = ' '`, a store in a debug build) - and not at the head of a line that
!      a '|' continues, where the statement began on the line above
CcStoreTo routine
  get(ccQ, ccX)
  ccY = choose(self.StoreHead(ccQ.tk) > 0)
  get(ccQ, ccX)
  if ccY then ccWhy = lower(clip(ccHead)) & ' is changed between its load and the compare - a store into its ' & lower(clip(ccTail)) & ' on line ' & self.LogLineOf(ccFrom).

! ---- the mention in the ccQ row ccX - a loaded side's valuePtr, its _DataEnd, or its getValuePtr() -
!      handed WHOLE as an argument to a call (getValuePtr() as three rows, its name two before the tail):
!      the call may write through it, or bump the length, before the compare. A call that cannot write
!      through it is no change - ArgMayWrite: one whose summary says it only reads that parameter, a
!      plain call on the pure list (ruled 28 Oct 2026), or a call that only reads what it is handed, such
!      as a StringTheory's setValue or append, or MESSAGE (ReadOnlyCallAt); or no call at all, a
!      subscript or CHOOSE, which picks a value. The object itself handed to a call is refused in CcLoads
!      already, whatever the call. A SLICE of the buffer handed whole - `Pad(a.valuePtr[1 : a._DataEnd])`,
!      or `Pad(a.getValuePtr(2))`, which StringTheory answers with a part of the buffer - is passed by
!      address as the buffer is, and a call that writes it can leave the value ending in a space: it is
!      no change when ArgMayWrite says so, or when the call's prototype takes that place by value
!      (AutoArgIsRefParam). The read and the tokens either side of it are taken from the token stream,
!      since ccQ holds one physical line and a call wrapped with '|' spans more. The ccQ buffer is left on
!      row ccX
CcPassedOn routine
  data
s     long,auto
e     long,auto
k     long,auto
t     long,auto
sl    byte
  code
  if ccTail <> 'VALUEPTR' and ccTail <> '_DATAEND' and ccTail <> 'GETVALUEPTR' then exit.
  s = ccX
  get(ccQ, ccX)
  if ~pLog.findByte(46,,, ccQ.tx) then s = ccX - 2. ! <dot>
  get(ccQ, s)
  if errorcode() then get(ccQ, ccX) ; exit.
  t = ccQ.tk ; e = t
  if ccTail = 'GETVALUEPTR' and self.tk.GetTok(t + 3) = '('
    k = self.tk.MatchLeftBracket('(', ')', t + 3)
    if k >= t + 4 then e = k.
    if k > t + 4 then sl = 1.
  end
  if ccTail <> '_DATAEND' and self.tk.GetTok(e + 1) = '['
    k = self.tk.MatchLeftBracket('[', ']', e + 1)
    if k > e then e = k ; sl = 1.
  end
  if self.ArgMayWrite(t, e, '', ccSums)
    k = 1
    if sl then k = self.AutoArgIsRefParam(t, 1).
    if k
      ccWhy = lower(clip(ccHead)) & ' is changed between its load and the compare - ' & choose(~sl, 'its ', 'a slice of its ') & |
              lower(clip(ccTail)) & ' is handed on line ' & self.LogLineOf(ccFrom) & ' to a call that may write it'
    end
  end
  get(ccQ, ccX)

! ---- ccSure = the split whose name is the token ccTk is sure to have run when the loop at ccLoop
!      is reached: walking back from the loop to it, no structure holding it closes, no other
!      branch of a structure holding the loop is entered, and no column-1 label lies between
CcSureSplit routine
  ccSure = 1 ; ccBack = 0
  loop ccY = ccLoop - 1 to ccTk + 1 by -1
    if self.syms.IsColOneLabel(ccY) then ccSure = 0 ; break.
    get(self.tk.tokens, ccY)                                        ! after the label test, which reads other rows
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      ccBack += 1
    of '+'
      if ccBack
        ccBack -= 1
      else
        ccSure = 1                                                  ! an opener holding the loop: what stands before it ran first
      end
    of '/'
      if ~ccBack then ccSure = 0.                                   ! another branch of a structure holding the loop
    end
  end
  if ccBack then ccSure = 0.

! ---- the two receivers as the author spelled them, from the compare line's own tokens
CcNames routine
  ccATxt = self.CcRecvText(ccS1)
  ccBTxt = self.CcRecvText(ccS2)

! ---- the tokens of ONE physical line, uppercased, into ccQ
CcFill routine
  free(ccQ)
  ccNext = 0
  loop ccX = ccFrom to records(self.tk.tokens)
    get(self.tk.tokens, ccX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      ccNext = ccX + 1 ; break
    end
    if ccX > ccFrom and self.tk.tokens.firstOnLine
      ccNext = ccX ; break
    end
    ccQ.tx = upper(self.tk.tokens.tok) ; ccQ.tk = ccX
    add(ccQ)
  end
  if ~ccNext then ccNext = records(self.tk.tokens) + 1.

! ---- ccLvl = the depth the line in hand starts at, counted from the walk's start; ccDepth runs on
!      past the line's own openers and closers
CcLineDepth routine
  ccLvl = ccDepth
  loop ccX = ccFrom to ccNext - 1
    get(self.tk.tokens, ccX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.level = '+' then ccDepth += 1.
    if self.tk.tokens.level = '-' then ccDepth -= 1.
  end

! ---- ccHead = the RECEIVER in front of the ccQ row at ccHeadIx, in either spelling
CcHead routine
  ccHead = ''
  get(ccQ, ccHeadIx)
  if errorcode() then exit.
  ccN = len(clip(ccQ.tx))
  if ~ccN then exit.
  ccD = instring('.', ccQ.tx[1 : ccN], 1, 1)
  if ccD > 1
    ccHead = ccQ.tx[1 : ccD - 1]
    exit
  end
  if ccHeadIx < 3 then exit.
  get(ccQ, ccHeadIx - 1)
  if errorcode() or ccQ.tx <> '.' then exit.
  get(ccQ, ccHeadIx - 2)
  if ~errorcode() then ccHead = ccQ.tx.

! ---- the call whose '(' is the ccQ row ccArgS: ccArgE = the row of its matching ')', 0 = it does not
!      close on this line; ccArgLin = it is given
!      st:lines, or an option that may hold it (LinesOptAt, which reads the call to its own ')' in the
!      token stream). What follows the ')' on the line is another statement's, and is not read
CcArgs routine
  data
d    long,auto
r    long,auto
  code
  ccArgE = 0 ; ccArgLin = 0
  get(ccQ, ccArgS)
  if errorcode() or ccQ.tx <> '(' then exit.
  ccArgLin = self.LinesOptAt(ccQ.tk)
  d = 0
  loop r = ccArgS to records(ccQ)
    get(ccQ, r)
    if errorcode() then break.
    if ccQ.tx = '(' then d += 1.
    if ccQ.tx = ')'
      d -= 1
      if ~d then ccArgE = r ; break.
    end
  end

! ---- the object ccTok, a side or the object a side's lines come from, must be a StringTheory: the
!      rewrite reads its _DataEnd and valuePtr, and on a class of the author's own the same method
!      names - setValue, getLine, split - may do other things
CcIsSt routine
  if self.HayType(ccTok, ccIf) <> 'STRINGTHEORY'
    ccWhy = lower(clip(ccTok)) & ' is not a StringTheory, so what its methods do is not known here'
  end

! ---- ccFarK = how a call can reach the object ccTok without naming it: 0 it cannot - a plain local of
!      this procedure, not a reference, STATIC or THREAD; 1 a parameter, the caller's object, which the
!      caller may share with what the call reaches; 2 a reference, to whatever holds what it points at;
!      3 STATIC or THREAD, shared by every call of the procedure, a recursive one too; 4 declared outside
!      this procedure, where any procedure may reach it
CcFarKind routine
  data
k    long,auto
r    long,auto
dt   long,auto
  code
  ccFarK = 4
  k = self.syms.ScopeContaining(ccIf, vs:scProc, vs:scMethod)
  if ~k then exit.
  r = self.syms.FindOwn(ccTok, k)
  if ~r then exit.
  get(self.syms.syms, r)
  if errorcode() then exit.
  dt = self.syms.syms.declTok
  if self.syms.syms.isRef
    ccFarK = 2
  elsif ~self.syms.IsColOneLabel(dt)
    ccFarK = 1
  elsif band(self.DeclAttrBits(dt), ab:static + ab:thread)
    ccFarK = 3
  else
    ccFarK = 0
  end

! ---- ccCall = the first call on the line in hand, from the ccQ row ccCallRow on, that may change the
!      object ccTok without naming it, when a call can reach it that way (ccFarK); blank = none. No
!      obstacle: a reader on the pure list called by name alone that is the runtime's own function and
!      no procedure of the file's (PureProc), a reader called on a StringTheory (PureMethodAt), a
!      method of a plain local StringTheory of this procedure - which changes only itself - and a
!      method of ccTok itself, whose mentions the
!      mention and line-write tests judge; a method of a or b too, when it is a load (setValue,
!      setValueFromLine) or a reader the mention test lets pass. A name with no brackets that may be a
!      parameterless procedure (BareCallAt) is a call like any other
CcFarCall routine
  data
r    long,auto
d    long,auto
n    long,auto
k    long,auto
dt   long,auto
nm   STRING(vs:maxName),auto
rv   STRING(vs:maxName),auto
tl   STRING(vs:maxName),auto
  code
  ccCall = ''
  loop r = ccCallRow to records(ccQ)
    get(ccQ, r)
    if errorcode() then break.
    k = ccQ.tk ; nm = ccQ.tx
    get(self.tk.tokens, k)
    if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    get(ccQ, r + 1)
    if errorcode() or ccQ.tx <> '('
      if self.BareCallAt(k) then ccCall = nm ; break.
      cycle
    end
    rv = ''
    d = self.DgLastDot(nm)
    if d > 1 and d < len(clip(nm))
      rv = nm[1 : d - 1]
      tl = nm[d + 1 : len(clip(nm))]
      nm = tl
    elsif r > 2
      get(ccQ, r - 1)
      if ~errorcode() and ccQ.tx = '.'
        get(ccQ, r - 2)
        if ~errorcode() then rv = ccQ.tx.
      end
    end
    if ~rv
      if self.PureProc(nm, ccPure, ccOwn) then cycle.
      ccCall = nm ; break
    end
    rv = self.NameRoot(rv)
    if rv = ccTok then cycle.
    if rv = ccA or rv = ccB
      if nm = 'SETVALUE' or nm = 'SETVALUEFROMLINE' or instring(' ' & clip(nm) & ' ', ccReads, 1, 1) then cycle.
    end
    get(ccQ, r + 1)
    if self.PureMethodAt(ccQ.tk, ccPure) then cycle.
    n = self.syms.FindOwn(rv, ccSc)
    if n
      get(self.syms.syms, n)
      if ~errorcode() and self.syms.syms.typeU = 'STRINGTHEORY' and ~self.syms.syms.isRef and self.stMeth.findChars(' ' & upper(clip(nm)) & ' ')
        dt = self.syms.syms.declTok
        if self.syms.IsColOneLabel(dt) and ~band(self.DeclAttrBits(dt), ab:static + ab:thread) then cycle.
      end
    end
    ccCall = clip(rv) & '.' & nm
    break
  end

! ---- the reason a side, ccTok, refuses: a call between its load and the compare, ccCall on line ccFrom,
!      can reach it without its name, ccFarK says how
CcFarSideWhy routine
  ccWhy = lower(clip(ccTok)) & ' is ' & choose(ccFarK = 1, 'a parameter', choose(ccFarK = 2, 'a reference', choose(ccFarK = 3, 'STATIC or THREAD', 'not this procedure''s own'))) & |
          ', and line ' & self.LogLineOf(ccFrom) & ' calls ' & lower(clip(ccCall)) & ' between its load and the compare, which could change it without naming it'

! ------------------------------------------------------------------------------------
! A value read at pIx: getValue() in either spelling, or the direct read
! choose(R._DataEnd < 1, '', R.valuePtr[1 : R._DataEnd]). Answers the receiver, folded,
! and the read's last token.
! ------------------------------------------------------------------------------------
VitEngine.CcValueAt Procedure(LONG pIx, *STRING pRecvU, *LONG pEnd)
memU   string(vs:maxName)
keep   long ! no AUTO: may be read before it is set
nx     long ! no AUTO: may be read before it is set
  code
  pRecvU = '' ; pEnd = 0
  if self.DgShapeAt(pIx, pRecvU, pEnd, keep) then return 1.
  if ~self.DgRecvAt(pIx, pRecvU, memU, nx) then return 0.
  if memU <> '.GETVALUE' then pRecvU = '' ; return 0.
  if self.tk.GetTok(nx) <> '(' or self.tk.GetTok(nx + 1) <> ')' then pRecvU = '' ; return 0.
  pEnd = nx + 1
  return 1

! ------------------------------------------------------------------------------------
! The receiver's text as written, from the first token of a value read at pIx: the token
! up to its last dot for `a.getValue`, the whole token for a split `a . getValue` or
! `self.ka . getValue`, and the third token, up to its last dot, for the choose() shape.
! ------------------------------------------------------------------------------------
VitEngine.CcRecvText Procedure(LONG pIx)
t      string(vs:maxName),auto
dotP   long,auto
  code
  t = self.tk.GetTok(pIx)
  if upper(t) <> 'CHOOSE' and self.DgIsMemberDot(pIx + 1) then return t. ! split, a . getValue: the token is the receiver whole, self.ka too
  if upper(t) = 'CHOOSE' then t = self.tk.GetTok(pIx + 2).
  dotP = self.DgLastDot(t)
  if dotP > 1 then return sub(t, 1, dotP - 1).
  return t
!===============================================================================================
! BUILTIN DirectReadEquals - a compare of two StringTheory values with either side read straight
! from the buffer - choose(a._DataEnd < 1, '', a.valuePtr[1 : a._DataEnd]), the spelling
! st-getvalue-slice-all writes for a.getValue() - becomes the call the st-equals rules write for
! the getValue() spelling:
!     if choose(a._DataEnd < 1, '', a.valuePtr[1 : a._DataEnd]) = b.getValue()   ->   if a.equals(b, st:clip)
!     if choose(...) <> choose(...)                                             ->   if ~a.equals(b, st:clip)
! and ~= as <>. st:clip makes equals() ignore trailing spaces, as = does, so the answer is the
! same from StringTheory 3.90 on; the group's NEEDST(3.90) holds it back for an older one. A rule
! cannot say it: a pattern names an object on its own before it may name one of its members, and
! this spelling names the object only with a member after it. It keeps the rules' limits: both
! objects StringTheory, nothing in front of the compare that binds into it (& + - * / ^ % or a
! comparison), nothing after it that continues it (& + - * / ^ %), and for <> no comparison
! after it either, since ~a.equals(b) = x would negate the second compare too. A compare written
! across lines is left alone. Each refusal names its line, on the first pass. Group st-equals.
!===============================================================================================
VitEngine.BuiltinDirectReadEquals Procedure(StringTheory pLog)
i          long,auto
drS1       long,auto               ! the left value read, first and last token
drE1       long,auto
drS2       long,auto               ! and the right
drE2       long                    ! no AUTO: may be read before it is set
drX        long                    ! no AUTO: may be read before it is set - CcValueAt's end, to check against drE1
drLine     long,auto               ! the line, read before the splice takes the tokens that carry it
drA        STRING(vs:maxName)      ! the two receivers, folded
drB        STRING(vs:maxName)
drATxt     STRING(vs:maxName),AUTO !   and as the author spelled them
drBTxt     STRING(vs:maxName),AUTO
drOp       STRING(4),AUTO          ! the comparator
drTk       STRING(4),AUTO          ! the token in front of the compare, or after it
drWhy      STRING(120),AUTO
drSb       StringTheory            ! the first token's strBefore, kept across the splice
drNew      StringTheory
changes    long
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  i = 1
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    drOp = self.tk.GetTok(i)
    if drOp <> '=' and drOp <> '<<>' and drOp <> '~=' then cycle.
    drE1 = i - 1
    if self.tk.GetTok(drE1) <> ')' then cycle.
    drS1 = self.tk.MatchRightBracket('(', ')', drE1)
    if drS1 < 2 then cycle.
    if upper(self.tk.GetTok(drS1 - 1)) = 'CHOOSE'
      drS1 -= 1
    elsif drS1 > 3 and self.DgIsMemberDot(drS1 - 2)
      drS1 -= 3                                                          ! a . getValue ( )
    else
      drS1 -= 1                                                          ! a.getValue ( )
    end
    if ~self.CcValueAt(drS1, drA, drX) or drX <> drE1 then cycle.
    drS2 = i + 1
    if ~self.CcValueAt(drS2, drB, drE2) then cycle.
    if upper(self.tk.GetTok(drS1)) <> 'CHOOSE' and upper(self.tk.GetTok(drS2)) <> 'CHOOSE' then cycle. ! getValue() on both sides: the group's rules take it
    drATxt = self.CcRecvText(drS1)
    drBTxt = self.CcRecvText(drS2)
    if self.HayType(drATxt, drS1) <> 'STRINGTHEORY' or self.HayType(drBTxt, drS2) <> 'STRINGTHEORY' then cycle.
    drWhy = ''
    drTk = choose(drS1 < 2, '', self.tk.GetTok(drS1 - 1))
    if self.SpanHasNL(drS1 + 1, drE2)
      drWhy = 'the compare is written across lines'
    elsif inlist(clip(drTk), '&', '*', '+', '-', '/', '^', '%', '=', '<<', '>', '<<>', '<<=', '>=', '~=', '~<<', '~>', '=<<', '=>')
      drWhy = 'the ' & clip(drTk) & ' in front of it binds into the compare'
    else
      drTk = self.tk.GetTok(drE2 + 1)
      if inlist(clip(drTk), '&', '*', '+', '-', '/', '^', '%')
        drWhy = 'the ' & clip(drTk) & ' after it carries the compare on'
      elsif drOp <> '=' and (inlist(clip(drTk), '=', '<<', '>', '<<>', '<<=', '>=', '~=', '~<<', '~>', '=<<', '=>') or upper(drTk) = 'NOT')
        drWhy = 'a comparison follows it, and the ~ the rewrite opens with would negate that one too'
      end
    end
    if drWhy
      if self.curPass = 1
        pLog.append('BUILTIN DirectReadEquals line ' & self.LogLineOf(drS1) & ': REFUSED - ' & clip(drWhy) & '.<13,10>')
      end
      cycle
    end
    ! ---- THE EDIT: the two value reads and the comparator become one equals() call
    drNew.setValue(choose(drOp = '=', '', '~') & clip(drATxt) & '.equals(' & clip(drBTxt) & ', st:clip)')
    drLine = self.LogLineOf(drS1)
    drSb.free()
    get(self.tk.tokens, drS1)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL then drSb.setValue(self.tk.tokens.strBefore).
    self.tk.DeleteToks(drS1, drE2)
    self.tk.InsertString(drS1, drNew, 1)
    self.tk.SetStrBefore(drS1, drSb.getValue())
    pLog.append('BUILTIN DirectReadEquals line ' & drLine & ': ' & clip(drATxt) & ' and ' & clip(drBTxt) & |
                ' compare through equals(), as with getValue().<13,10>')
    changes += 1
    i = drS1                                                             ! on from the call just written: it holds no comparator
  end
  if changes
    if not self.syms &= NULL then self.syms.dirty = 1.
    self.wantReparse = true                                              ! the new tokens carry no line numbers or levels: re-lex before the next pass
  end
  return changes

!===============================================================================================
! BUILTIN DeadValueWrite - a value written to a StringTheory that nothing reads before the next
! write is a line that does nothing:
!     st.setValue('')          ->    st.setValue(x)
!     st.setValue(x)
! The dead write is `setValue` of a literal, a plain variable the symbol table resolves or another
! StringTheory's getValue() / getValuePtr() - nothing with a side effect; on a class of the author's
! own a method of that name may move a cursor, which the line would take with it, so that is refused
! with the call named (see PureMethodAt) - or `free()` with no argument
! (a bare name the table cannot place is not taken for a variable: Clarion calls a parameterless
! procedure by its label alone, and that call is not dead with the line; `free(true)` frees
! the lines too and is not dead). The write that makes it dead is the next line to mention the
! object at all, and it must be `setValue(...)`, `free()` or `join(...)` with an argument that
! does not read the object - its argument runs to its own closing bracket, and a statement after it
! on the line runs after it and reads only the new value, so it is not judged; a line between that
! opens, closes or branches a structure, a column-1 label, a `do` anywhere on a line, or a RETURN or
! EXIT ends the search without a word - the second write must be sure to follow, and to run. A STATIC or THREAD object is shared by every
! call of the procedure, a recursive one too, so then nothing may come between the two writes. A
! read, or any other use, between the two is not a dead write and is not reported either: `free()`
! then `append()` is the commonest StringTheory idiom there is. What IS reported: a second write
! that reads the object (`st.setValue(st.getValue() & 'x')`); an object streamed to a file with
! Stream(), whose every write reaches the file, or one that code out of sight may have streamed - a
! parameter, a reference, or one reached under another name (ruled 29 Oct 2026); a first write that copies another object's flags
! (setValue given an object), unless the second is setValue given a StringTheory, which sets them
! all again; and setValue of text before free() or join() when the procedure can set the object's
! base64 flag, which setValue clears and those two leave. A dead line that carries a comment
! goes too; the comment stays, on a line of its own. Two scans on pass 1; the editing scan stops
! at its first edit.
!===============================================================================================
VitEngine.BuiltinDeadValueWrite Procedure(StringTheory pLog)
i           long,auto
dwX         long,auto
dwZ         long,auto
dwD         long,auto          ! instring scratch
dwAttr      long,auto          ! DwParamCheck: the object is STATIC or THREAD
dwN         long,auto          ! length scratch
dwLine1     long,auto          ! first token of the dead write's line
dwNextWr    long,auto          !   and of the write that makes it dead
dwFrom      long,auto          ! DwFill: first token of the line in hand
dwNext      long,auto          !   and of the next
dwHeadIx    long               ! DwHead input
dwHead      STRING(vs:maxName) !   output
dwTail      STRING(96)
dwSt        STRING(vs:maxName) ! the object, folded
dwStTxt     STRING(vs:maxName) !   and as the author spelled it
dwEsc       byte               ! ObjEscapes: a parameter, a reference to it, a local class's method, handed to a call
dwReach     byte               !   which of them, before STATIC and THREAD count too: 1 parameter, 2 reference, 3 another name
dwScFirst   long,auto
dwScLast    long,auto
dwSc        long,auto
dwWhy       STRING(200)
dwRpt       byte
dwEdited    byte
dwSite      byte               ! DwAfter: the next mention of the object is a write
dwArg       STRING(96)         ! DwShape: the dead write's argument calls this, which may not only read - blank = none
dwArgE      long               ! DwIsWrite: the row of the killing write's own ')', 0 = not on the line
dwExec      long               ! the enclosing EXECUTE, when the dead line is one of its arms
dwDeadKind  byte               ! DwShape: 1 = setValue of text, which clears base64; 2 = of an object, which copies its flags
dwIsObj     byte               ! DwArgObj: 2 = a StringTheory, 1 = another object or a name not typed, 0 = data
dwStreamAt  long               ! DwObjScan: the first <st>.stream( in the procedure
dwFlagAt    long               !   and the first mention that can set its base64 flag or its encoding
dwFlagEnc   byte               !   that mention gives it a USTRING's value, which sets the UTF-16 encoding
dwPure      StringTheory       ! ' NAME NAME ' - the calls that only read, as IfChainToCase lists them
dwOwn       StringTheory       !   the names on it this file gives a procedure of its own (PureOwnList)
dwQ         QUEUE,PRE(dw)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  self.IfCasePureList(dwPure)
  self.PureOwnList(dwPure, dwOwn)
  dwEdited = 0
  if self.curPass = 1
    dwRpt = 1 ; do DwScan
  end
  dwRpt = 0 ; do DwScan
  return dwEdited

! ---- every line that is a side-effect-free value write: is the next mention of the object a write?
DwScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    dwLine1 = i
    dwFrom = dwLine1 ; do DwFill
    do DwShape
    if ~dwSt then cycle.
    do DwScope
    if ~dwScFirst then cycle.
    do DwNames
    dwWhy = ''
    do DwParamCheck
    if dwWhy then cycle.      ! not a StringTheory of this procedure - not a site, no word
    do DwAfter
    if ~dwSite then cycle.
    ! NOT A STREAMED OBJECT. StringTheory sends what an object streamed with Stream() held to its
    ! file before each setValue, free() and join(), so the first write reaches the file.
    if ~dwWhy
      do DwObjScan
      if dwStreamAt
        dwWhy = clip(dwStTxt) & ' is streamed to a file on line ' & self.LogLineOf(dwStreamAt) & ' - each value written to it goes to the file, so none is dead'
      end
    end
    ! NOR ONE THAT CODE OUT OF SIGHT MAY HAVE STREAMED: a parameter, by the caller; a reference, by
    ! whatever holds the object it points at; an object reached under another name, by a call it is
    ! handed to or a method of a class this procedure declares. What the stream holds is private to
    ! StringTheory, so nothing in the procedure can test it. Ruled 29 Oct 2026.
    if ~dwWhy and dwReach = 1
      dwWhy = clip(dwStTxt) & ' is a parameter, and the caller may have given it Stream() - then each value written to it goes to the file, so none is dead'
    elsif ~dwWhy and dwReach = 2
      dwWhy = clip(dwStTxt) & ' is a reference, and the object it points at may be streamed to a file - then each value written to it goes there, so none is dead'
    elsif ~dwWhy and dwReach = 3
      dwWhy = clip(dwStTxt) & ' can be reached under another name, which may give it Stream() - then each value written to it goes to the file, so none is dead'
    end
    ! NOT ONE ARM OF AN EXECUTE. An EXECUTE runs ONE of the statements between it and its END,
    ! picked by the value it is given, so this line and the write that looks as if it kills the
    ! value are ALTERNATIVES: neither can overwrite the other, and taking one away RENUMBERS
    ! every arm below it, so a different value then runs a different line. Found 15 Sep 2026.
    if ~dwWhy
      dwExec = self.InExecute(dwLine1, dwScFirst)
      if dwExec
        dwWhy = 'the line is one arm of the EXECUTE on line ' & self.LogLineOf(dwExec) & ', and the write that would make it dead is another'
      end
    end
    ! NOR ANY INCLUDE IN THE PROCEDURE. The included code is not in this file, and it may read the
    ! value between the two writes - on a line between them, or in a method one of them calls.
    if ~dwWhy and self.ScopeIncludes(dwSc)
      dwWhy = clip(dwStTxt) & ' may be read by code the procedure INCLUDEs, which this file does not hold, before it is written again'
    end
    ! NOR A COPY WHOSE CALL MAY DO MORE THAN READ. getValue() and getValuePtr() only read on a
    ! StringTheory; on a class of the author's own they may move a cursor, and the call would go
    ! with the line.
    if ~dwWhy and dwArg
      dwWhy = 'the write''s argument calls ' & lower(clip(dwArg)) & ', which may do more than read a value - what it does would go with the line'
    end
    if dwWhy
      if dwRpt
        pLog.append('BUILTIN DeadValueWrite line ' & self.LogLineOf(dwLine1) & ': REFUSED - ' & clip(dwWhy) & '.<13,10>')
      end
      cycle
    end
    if dwRpt then cycle.
    dwZ = self.FirstEolAfter(dwLine1)
    if ~dwZ then cycle.
    pLog.append('BUILTIN DeadValueWrite line ' & self.LogLineOf(dwLine1) & ': the value written to ' & clip(dwStTxt) & |
                ' here is written again on line ' & self.LogLineOf(dwNextWr) & ' before anything reads it'           & |
                ' - the line goes' & choose(~self.EolHasCmt(dwZ), '', ' and its comment stays, on a line of its own') & '.<13,10>')
    self.DropLinesKeepCmts(dwLine1, dwZ)
    if not self.syms &= NULL then self.syms.dirty = 1.
    dwEdited = 1
    exit
  end

! ---- <st>.setValue( literal | name | <obj>.getValue() | <obj>.getValuePtr() ) or <st>.free(), the whole line
DwShape routine
  dwSt = '' ; dwIsObj = 0 ; dwArg = ''
  if records(dwQ) < 3 then exit.
  dwHeadIx = 1 ; do DwHead
  get(dwQ, 1)
  dwN = len(clip(dwQ.tx))
  dwD = instring('.', dwQ.tx[1 : dwN], 1, 1)
  if ~dwHead or ~dwD or dwD >= dwN then exit.
  dwTail = dwQ.tx[dwD + 1 : dwN]
  get(dwQ, 2)
  if dwQ.tx <> '(' then exit.
  get(dwQ, records(dwQ))
  if dwQ.tx <> ')' then exit.
  dwZ = 0                                 ! 1 = the shape holds
  case dwTail
  of 'FREE'
    if records(dwQ) = 3 then dwZ = 1.     ! free(true) frees the lines - not dead
  of 'SETVALUE'
    case records(dwQ)
    of 4
      get(dwQ, 3)
      if dwQ.tx[1] = ''''
        dwZ = 1                           ! a literal
      elsif ((dwQ.tx[1] >= 'A' and dwQ.tx[1] <= 'Z') or dwQ.tx[1] = '_') and ~pLog.findByte(46, 1,, dwQ.tx) and dwQ.tx <> dwHead and self.CondNamesAreData(dwQ.tk, dwQ.tk) ! <dot>
        dwZ = 1                           ! a plain variable the table resolves - not a member, whose read may do something, and not a bare name that may be a parameterless call
        dwX = 3 ; do DwArgObj
      end
    of 6                                  ! <obj>.getValue() - a copy nothing reads
      get(dwQ, 4)
      if dwQ.tx <> '(' then exit.
      get(dwQ, 5)
      if dwQ.tx <> ')' then exit.
      dwHeadIx = 3 ; do DwHead            ! dwHead is the ARGUMENT's object for a moment
      get(dwQ, 3)
      dwN = len(clip(dwQ.tx))
      dwD = instring('.', dwQ.tx[1 : dwN], 1, 1)
      if dwHead and dwD and dwD < dwN and (dwQ.tx[dwD + 1 : dwN] = 'GETVALUE' or dwQ.tx[dwD + 1 : dwN] = 'GETVALUEPTR')
        dwTail = dwHead
        dwHeadIx = 1 ; do DwHead
        if dwHead <> dwTail then dwZ = 1. ! st.setValue(st.getValue()) reads itself - not dead
        get(dwQ, 4)
        if dwZ and ~self.PureMethodAt(dwQ.tk, dwPure)
          get(dwQ, 3)
          dwArg = dwQ.tx
        end
      end
    end
  end
  if ~dwZ then exit.
  dwHeadIx = 1 ; do DwHead
  dwSt = dwHead
  dwDeadKind = 0
  if records(dwQ) > 3 then dwDeadKind = choose(~dwIsObj, 1, 2).

! ---- the next mention of the object, straight after and in the same block: a write makes the
!      site; anything else, or a structure boundary, a label, a `do` anywhere on a line, or a
!      RETURN or EXIT first, means no site - the write after a RETURN may never run
DwAfter routine
  dwSite = 0 ; dwNextWr = 0
  dwFrom = dwNext
  loop while dwFrom > 0 and dwFrom < dwScLast
    do DwFill
    if self.InCondBlock(dwFrom) then exit.      ! a write a build may leave out kills nothing
    loop dwX = dwFrom to dwNext - 1
      get(self.tk.tokens, dwX)
      if errorcode() then break.
      if self.tk.tokens.level <> ' ' then exit. ! a structure opens, closes or branches
      if not self.tk.tokens.tok &= NULL and inlist(upper(self.tk.tokens.tok), 'BREAK', 'CYCLE', 'GOTO', 'RETURN', 'EXIT', 'DO') then exit.
    end
    if self.syms.IsColOneLabel(dwFrom) then exit.
    dwZ = 0
    loop dwX = 1 to records(dwQ)
      dwHeadIx = dwX ; do DwHead
      get(dwQ, dwX)
      if errorcode() then break.
      if dwHead = dwSt or dwQ.tx = dwSt then dwZ = dwX ; break.
    end
    if ~dwZ and dwEsc then exit.                ! a line between, and the object can be read without being named
    if dwZ
      get(self.tk.tokens, dwNext - 1)           ! continued: the line ends on no EOL of its own, and its
      if errorcode() or self.tk.tokens.tok &= NULL or size(self.tk.tokens.tok) <> 1 or self.tk.tokens.tok <> '<10>' then exit. !   read of the object may sit past the bar
      do DwIsWrite
      exit
    end
    dwFrom = dwNext
  end

! ---- the line in hand mentions the object, first at row dwZ: is it <st>.setValue(...) | free() |
!      join(...) with no read of the object in the argument? The argument runs to the write's own
!      closing bracket. A statement after it on the line runs after the write, and what it reads is
!      the value the write gave - never the one it replaced - so it is not judged, under the object's
!      own name or another (ruled 4 Nov 2026)
DwIsWrite routine
  if dwZ <> 1 then exit.       ! the object is read before any call on it
  get(dwQ, 1)
  dwN = len(clip(dwQ.tx))
  dwD = instring('.', dwQ.tx[1 : dwN], 1, 1)
  if ~dwD or dwD >= dwN then exit.
  dwTail = dwQ.tx[dwD + 1 : dwN]
  if dwTail <> 'SETVALUE' and dwTail <> 'FREE' and dwTail <> 'JOIN' then exit.
  get(dwQ, 2)
  if errorcode() or dwQ.tx <> '(' then exit.
  dwArgE = 0 ; dwD = 1
  loop dwX = 3 to records(dwQ)
    get(dwQ, dwX)
    if errorcode() then break.
    if dwQ.tx = '(' then dwD += 1.
    if dwQ.tx = ')' then dwD -= 1.
    if ~dwD then dwArgE = dwX ; break.
  end
  loop dwX = 3 to records(dwQ) ! the argument must not read the object
    if dwArgE and dwX > dwArgE then break.
    dwHeadIx = dwX ; do DwHead
    get(dwQ, dwX)
    if errorcode() then break.
    if dwHead = dwSt or dwQ.tx = dwSt
      dwWhy = 'the write on line ' & self.LogLineOf(dwFrom) & ' reads ' & clip(dwStTxt) & ' - the value written on line ' & self.LogLineOf(dwLine1) & ' is what it reads'
      dwSite = 1
      exit
    end
    if dwEsc
      do DwEscArg
      if dwWhy then dwSite = 1 ; exit.
    end
  end
  do DwFlagsKept
  if dwWhy then dwSite = 1 ; exit.
  dwNextWr = dwFrom
  dwSite = 1

! ---- the write that kills the value must also undo what the dead write did to the object's flags.
!      setValue given an object copies that object's encoding, base64 and gzip flags, and only
!      setValue given a StringTheory sets them all again. setValue given text clears the base64
!      flag and sets the encoding to ANSI, which free() and join() leave as they find them: that
!      matters only when the procedure can set the flag or the encoding on the object, and then the
!      first write is not dead.
DwFlagsKept routine
  if dwDeadKind = 2
    dwIsObj = 0
    if dwTail = 'SETVALUE' and dwArgE = 4
      dwX = 3 ; do DwArgObj
    end
    if dwIsObj <> 2
      dwWhy = 'the write here copies the encoding, base64 and gzip flags of the object it is given, and the write on line ' &   |
              self.LogLineOf(dwFrom) & ' does not set them all again'
    end
  elsif dwDeadKind = 1 and dwTail <> 'SETVALUE'
    do DwObjScan
    if dwFlagAt and dwFlagEnc
      dwWhy = 'the write here sets the encoding to ANSI, which line ' & self.LogLineOf(dwFlagAt) & ' can set to UTF-16, and ' & |
              lower(clip(dwTail)) & '() on line ' & self.LogLineOf(dwFrom) & ' leaves the encoding as it is'
    elsif dwFlagAt
      dwWhy = 'the write here clears the base64 flag, which line ' & self.LogLineOf(dwFlagAt) & ' can set, and ' &              |
              lower(clip(dwTail)) & '() on line ' & self.LogLineOf(dwFrom) & ' leaves the flag as it is'
    end
  end

! ---- dwIsObj = what the dwQ row dwX names: 2 a StringTheory, 1 another object or a name the table
!      cannot type, 0 data. setValue given an object takes the StringTheory overload, which copies
!      the object's flags with its value.
DwArgObj routine
  data
tU   STRING(vs:maxName)
rf   BYTE
  code
  dwIsObj = 1
  get(dwQ, dwX)
  if errorcode() then exit.
  if ~self.syms.Lookup(dwQ.tx, dwQ.tk, tU, rf) then exit.
  if upper(tU) = 'STRINGTHEORY'
    dwIsObj = 2
  elsif self.UvPlainType(tU)
    dwIsObj = 0
  end

! ---- what the procedure does to the object that no value write shows: dwStreamAt, the first
!      <st>.stream( - a streamed object sends each value it is given to its file, so no write of it
!      is dead; dwFlagAt, the first mention that can set its base64 flag - a member fl:writers names,
!      _StealValue, or setValue given an object or a name the table cannot type - or its encoding:
!      setValue given a USTRING alone, which sets it to UTF-16 (dwFlagEnc).
DwObjScan routine
  data
k    long,auto
n    long,auto
a    long,auto
t    STRING(vs:maxName),auto
m    STRING(vs:maxName)
! #Removed as not used: tU   STRING(vs:maxName)
! #Removed as not used: rf   BYTE
  code
  dwStreamAt = 0 ; dwFlagAt = 0 ; dwFlagEnc = 0
  n = len(clip(dwSt))
  if ~n or n + 1 >= size(t) then exit.
  loop k = dwScFirst to dwScLast
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    t = upper(self.tk.tokens.tok)
    if t = dwSt and self.tk.GetTok(k + 1) = '.'
      m = upper(self.tk.GetTok(k + 2)) ; a = k + 3
    elsif t[1 : n + 1] = clip(dwSt) & '.'
      m = t[n + 2 : size(t)] ; a = k + 1
    else
      cycle
    end
    if m = 'STREAM'
      if ~dwStreamAt then dwStreamAt = k.
    end
  end
  dwFlagAt = self.MarkSetterAt(dwSt, dwScFirst, dwScLast, dwFlagEnc)

! ---- the object can be read under another name (dwEsc), so the killing write's own argument may hold
!      only literals, operators, StringTheory flags, names that cannot be that object and calls that
!      read nothing but what they are handed. A name cannot be the object when it is data, which no
!      object can be, or an object this procedure declares itself that is not a reference, a parameter,
!      STATIC or THREAD: the caller may pass the same object for two parameters, and a call of the
!      procedure from inside itself may pass in its own STATIC one. When the object is itself a STATIC or
!      THREAD local, any other local of the procedure is another object, STATIC or THREAD as well: two
!      locals are never one. A call reads only what it is handed
!      when it is on the pure list - a runtime function such as clip(), called by name alone, that is no
!      procedure of the file's (PureProc: a program's own Size is what `size(x)` calls), or a reader
!      called on a StringTheory, whose receiver is then judged as a name. Any other call, a name the
!      symbol table cannot place, or any other object could read the value written first through that
!      other name before the write replaces it. Row dwX of dwQ is the token judged.
DwEscArg routine
  data
dz    long,auto
dn    long,auto
dp    long,auto
dRoot STRING(96),AUTO
dTy   STRING(vs:maxName)
dRf   BYTE
dRow  long,auto
dOk   byte,auto
  code
  get(self.tk.tokens, dwQ.tk)
  if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then exit.
  dn = len(clip(dwQ.tx))
  if ~dn or (dn > 3 and dwQ.tx[1 : 3] = 'ST:') then exit.
  get(dwQ, dwX + 1)
  if ~errorcode() and dwQ.tx = '('
    dp = dwQ.tk
    get(dwQ, dwX)
    ! the name called is the text after the last dot. A runtime reader called by name alone reads only
    ! its arguments, rows of their own; a reader called on a StringTheory has its receiver judged below
    dz = dn
    loop while dz > 0 and dwQ.tx[dz] <> '.'
      dz -= 1
    end
    dOk = 0
    if dz < dn and dwPure.findChars(' ' & dwQ.tx[dz + 1 : dn] & ' ')
      if (~dz and self.tk.GetTok(dp - 2) <> '.' and self.PureProc(dwQ.tx[1 : dn], dwPure, dwOwn)) or self.PureMethodAt(dp, dwPure) then dOk = 1.
    end
    if ~dOk
      dwWhy = 'the write on line ' & self.LogLineOf(dwFrom) & ' calls ' & lower(clip(dwQ.tx)) & ', which may read ' & clip(dwStTxt) & ' under another name first'
      exit
    end
    if ~dz then exit.
  end
  get(dwQ, dwX)
  dz = pLog.findByte(46, 1,, dwQ.tx) ! <dot>: the root names the storage
  if dz > 1
    dRoot = dwQ.tx[1 : dz - 1]
  else
    dRoot = dwQ.tx[1 : dn]
  end
  if dRoot = 'TRUE' or dRoot = 'FALSE' then exit.
  if self.syms.Lookup(dRoot, dwQ.tk, dTy, dRf) and ~dRf
    if dTy <> 'STRINGTHEORY' and self.UvPlainType(dTy) then exit.
    dRow = self.syms.FindOwn(dRoot, dwSc)
    if dRow
      get(self.syms.syms, dRow)
      if ~errorcode() and ~self.syms.syms.isRef and self.syms.IsColOneLabel(self.syms.syms.declTok)
        if ~band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread) then exit.
        if dwAttr and ~dwReach and dRoot <> dwSt then exit.
      end
    end
  end
  dwWhy = 'the write on line ' & self.LogLineOf(dwFrom) & ' reads ' & lower(clip(dRoot)) & ', which may be ' & clip(dwStTxt) & ' under another name'

! ---- the procedure
DwScope routine
  dwScFirst = 0 ; dwScLast = 0
  dwSc = self.syms.ScopeContaining(dwLine1, vs:scProc, vs:scMethod)
  if ~dwSc then exit.
  self.syms.scopes.scopeId = dwSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  dwScFirst = self.syms.scopes.startTok
  dwScLast  = self.syms.scopes.endTok

! ---- the object is a StringTheory declared in this procedure (local or parameter - the second
!      write is what the caller sees either way). A STATIC or THREAD one is shared by every call
!      of the procedure: a call between the writes, a recursive one, may read it without its name
DwParamCheck routine
  dwZ = self.syms.FindOwn(dwSt, dwSc)
  if ~dwZ then dwWhy = 'not declared here' ; exit.
  get(self.syms.syms, dwZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then dwWhy = 'not a StringTheory' ; exit.
  dwAttr = band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread)
  dwEsc = self.ObjEscapes(dwSt, dwLine1) ! read without its name? Then nothing may come between the writes
  dwReach = 0                            ! and code out of sight may have streamed it
  if dwEsc then do DwReachKind.
  if dwAttr then dwEsc = 1.              ! nor when every call of the procedure shares it

! ---- why ObjEscapes answered 1: the object is a parameter, a reference, or reached under another name
DwReachKind routine
  get(self.syms.syms, dwZ)
  if errorcode()
    dwReach = 3
  elsif ~self.syms.IsColOneLabel(self.syms.syms.declTok)
    dwReach = 1
  elsif self.syms.syms.isRef
    dwReach = 2
  else
    dwReach = 3
  end

! ---- the object's name as the author spelled it, from the dead line
DwNames routine
  dwStTxt = dwSt
  get(self.tk.tokens, dwLine1)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  dwN = len(clip(self.tk.tokens.tok))
  if ~dwN then exit.
  dwD = instring('.', self.tk.tokens.tok[1 : dwN], 1, 1)
  if dwD > 1
    if upper(self.tk.tokens.tok[1 : dwD - 1]) = dwSt then dwStTxt = self.tk.tokens.tok[1 : dwD - 1].
  elsif ~dwD
    if upper(self.tk.tokens.tok[1 : dwN]) = dwSt then dwStTxt = self.tk.tokens.tok[1 : dwN].
  end

! ---- the tokens of ONE physical line, uppercased, into dwQ, the split dotted spelling joined
DwFill routine
  free(dwQ)
  dwNext = 0
  loop dwX = dwFrom to records(self.tk.tokens)
    get(self.tk.tokens, dwX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dwNext = dwX + 1 ; break
    end
    if dwX > dwFrom and self.tk.tokens.firstOnLine
      dwNext = dwX ; break
    end
    dwQ.tx = upper(self.tk.tokens.tok)
    dwQ.tk = dwX
    add(dwQ)
  end
  if ~dwNext then dwNext = records(self.tk.tokens) + 1.
  do DwJoin

! ---- a '.' between two names becomes one row (a method call arrives as three tokens)
DwJoin routine
  dwX = 2
  loop while dwX < records(dwQ)
    get(dwQ, dwX)
    if errorcode() then break.
    if dwQ.tx <> '.' then dwX += 1 ; cycle.
    get(dwQ, dwX - 1)
    if errorcode() or ~((dwQ.tx[1] >= 'A' and dwQ.tx[1] <= 'Z') or dwQ.tx[1] = '_') then dwX += 1 ; cycle.
    dwHead = dwQ.tx
    get(dwQ, dwX + 1)
    if errorcode() or ~((dwQ.tx[1] >= 'A' and dwQ.tx[1] <= 'Z') or dwQ.tx[1] = '_') then dwX += 1 ; cycle.
    dwTail = dwQ.tx
    delete(dwQ)
    get(dwQ, dwX)
    delete(dwQ)
    get(dwQ, dwX - 1)
    dwQ.tx = clip(dwHead) & '.' & dwTail
    put(dwQ)
  end

! ---- dwHead = the RECEIVER in front of the dwQ row at dwHeadIx
DwHead routine
  dwHead = ''
  get(dwQ, dwHeadIx)
  if errorcode() then exit.
  dwN = len(clip(dwQ.tx))
  if ~dwN then exit.
  dwD = instring('.', dwQ.tx[1 : dwN], 1, 1)
  if dwD > 1 then dwHead = dwQ.tx[1 : dwD - 1].



!===============================================================================================
! BUILTIN CheckDeleteInLoop - a REPORT, not a rewrite. A deleteLine inside a FORWARD loop over
! the same object's lines skips the line after every delete: deleteLine shifts the lines up, and
! the loop's index moves on, so the line that took the deleted one's place is never looked at.
!     loop i = 1 to st.records()
!       if st.getLine(i) = '' then st.deleteLine(i).      <- the line after a deleted one is skipped
!     end
! It bites only on two lines in a row that both match, which is why it survives testing. The tool
! cannot fix it without changing what the code does, so it SAYS so and changes nothing: walk the
! lines backwards (loop i = st.records() to 1 by -1) or use removeLines(). A backwards loop is
! already correct and is not the shape this matches. Reports on pass 1 and returns 0 - it never
! edits, so it settles in one pass. In the analysis group, with the other deeper checks.
!===============================================================================================
VitEngine.BuiltinCheckDeleteInLoop Procedure(StringTheory pLog)
i           long,auto
cdX         long,auto
cdD         long,auto          ! instring scratch
cdN         long,auto          ! length scratch
cdLoop      long,auto          ! first token of the loop line
cdEnd       long,auto          ! the loop's matching END token
cdFrom      long,auto          ! CdFill: first token of the line in hand
cdNext      long,auto          !   and of the next
cdHeadIx    long               ! CdHead input
cdHead      STRING(vs:maxName) !   output
cdTail      STRING(96)
cdSt        STRING(vs:maxName) ! the object, folded
cdStTxt     STRING(vs:maxName) !   and as the author spelled it
cdIx        STRING(vs:maxName) ! the loop index, folded
cdQ         QUEUE,PRE(cd)
tx            STRING(96)
            END
  code
  if self.syms &= NULL then return 0.
  if self.curPass <> 1 then return 0. ! report once; never edit
  self.syms.EnsureFresh()
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    cdLoop = i
    cdFrom = cdLoop ; do CdFill
    do CdLoopShape                    ! sets cdSt, cdIx on a FORWARD loop over st's lines
    if ~cdSt then cycle.
    do CdFindDelete                   ! reports if the body deletes a line by the index
  end
  return 0

! ---- LOOP <ix> = 1 TO <st>.records() - the forward shape only; a backwards loop is correct
CdLoopShape routine
  cdSt = '' ; cdIx = ''
  if records(cdQ) <> 8 then exit.
  get(cdQ, 1) ; if cdQ.tx <> 'LOOP' then exit.
  get(cdQ, 3) ; if cdQ.tx <> '=' then exit.
  get(cdQ, 4) ; if cdQ.tx <> '1' then exit.
  get(cdQ, 5) ; if cdQ.tx <> 'TO' then exit.
  get(cdQ, 7) ; if cdQ.tx <> '(' then exit.
  get(cdQ, 8) ; if cdQ.tx <> ')' then exit.
  cdHeadIx = 6 ; do CdHead
  get(cdQ, 6)
  cdN = len(clip(cdQ.tx))
  cdD = instring('.', cdQ.tx[1 : cdN], 1, 1)
  if ~cdHead or ~cdD or cdD >= cdN or cdQ.tx[cdD + 1 : cdN] <> 'RECORDS' then exit.
  get(cdQ, 2)
  if ~((cdQ.tx[1] >= 'A' and cdQ.tx[1] <= 'Z') or cdQ.tx[1] = '_') then exit.
  cdIx = cdQ.tx
  cdSt = cdHead

! ---- within the loop, a <st>.deleteLine(<ix>) is the bug; report the first one
CdFindDelete routine
  self.tk.GetTok(cdLoop)                                                                 ! position for MatchLevel
  cdEnd = self.tk.MatchLevel()
  if ~cdEnd then exit.
  do CdNames
  cdFrom = cdNext
  loop while cdFrom > 0 and cdFrom < cdEnd
    do CdFill
    loop cdX = 1 to records(cdQ)
      cdHeadIx = cdX ; do CdHead
      get(cdQ, cdX)
      if errorcode() then break.
      if cdHead <> cdSt then cycle.
      cdN = len(clip(cdQ.tx))
      cdD = instring('.', cdQ.tx[1 : cdN], 1, 1)
      if ~cdD or cdD >= cdN then cycle.
      if cdQ.tx[cdD + 1 : cdN] <> 'DELETELINE' then cycle.
      get(cdQ, cdX + 1) ; if errorcode() or cdQ.tx <> '(' then cycle.
      get(cdQ, cdX + 2) ; if errorcode() or cdQ.tx <> cdIx then cycle.
      get(cdQ, cdX + 3) ; if errorcode() or cdQ.tx <> ')' then cycle.
      pLog.append('BUILTIN CheckDeleteInLoop line ' & self.LogLineOf(cdFrom) & ': ' & clip(cdStTxt) & '.deleteLine(' & lower(clip(cdIx)) & |
                  ') inside the forward loop on line ' & self.LogLineOf(cdLoop) & ' over ' & clip(cdStTxt)                               & |
                  '''s own lines skips the line after each delete - walk the lines backwards (loop ' & lower(clip(cdIx)) & ' = '         & |
                  clip(cdStTxt) & '.records() to 1 by -1) or use removeLines().<13,10>')
      exit
    end
    cdFrom = cdNext
  end

! ---- the object's name as the author spelled it, from the loop line
CdNames routine
  cdStTxt = cdSt
  get(self.tk.tokens, cdLoop)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  loop cdX = cdLoop to records(self.tk.tokens)
    get(self.tk.tokens, cdX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    cdN = len(clip(self.tk.tokens.tok))
    if ~cdN then cycle.
    cdD = instring('.', self.tk.tokens.tok[1 : cdN], 1, 1)
    if cdD > 1
      if upper(self.tk.tokens.tok[1 : cdD - 1]) = cdSt then cdStTxt = self.tk.tokens.tok[1 : cdD - 1].
    elsif ~cdD
      if upper(self.tk.tokens.tok[1 : cdN]) = cdSt then cdStTxt = self.tk.tokens.tok[1 : cdN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into cdQ, the split dotted spelling joined
CdFill routine
  free(cdQ)
  cdNext = 0
  loop cdX = cdFrom to records(self.tk.tokens)
    get(self.tk.tokens, cdX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      cdNext = cdX + 1 ; break
    end
    if cdX > cdFrom and self.tk.tokens.firstOnLine
      cdNext = cdX ; break
    end
    cdQ.tx = upper(self.tk.tokens.tok)
    add(cdQ)
  end
  if ~cdNext then cdNext = records(self.tk.tokens) + 1.
  do CdJoin

! ---- a '.' between two names becomes one row (a method call arrives as three tokens)
CdJoin routine
  cdX = 2
  loop while cdX < records(cdQ)
    get(cdQ, cdX)
    if errorcode() then break.
    if cdQ.tx <> '.' then cdX += 1 ; cycle.
    get(cdQ, cdX - 1)
    if errorcode() or ~((cdQ.tx[1] >= 'A' and cdQ.tx[1] <= 'Z') or cdQ.tx[1] = '_') then cdX += 1 ; cycle.
    cdHead = cdQ.tx
    get(cdQ, cdX + 1)
    if errorcode() or ~((cdQ.tx[1] >= 'A' and cdQ.tx[1] <= 'Z') or cdQ.tx[1] = '_') then cdX += 1 ; cycle.
    cdTail = cdQ.tx
    delete(cdQ)
    get(cdQ, cdX)
    delete(cdQ)
    get(cdQ, cdX - 1)
    cdQ.tx = clip(cdHead) & '.' & cdTail
    put(cdQ)
  end

! ---- cdHead = the RECEIVER in front of the cdQ row at cdHeadIx
CdHead routine
  cdHead = ''
  get(cdQ, cdHeadIx)
  if errorcode() then exit.
  cdN = len(clip(cdQ.tx))
  if ~cdN then exit.
  cdD = instring('.', cdQ.tx[1 : cdN], 1, 1)
  if cdD > 1 then cdHead = cdQ.tx[1 : cdD - 1].
!===============================================================================================
! BUILTIN DeadLinesWrite - a split whose lines nothing reads before the next split or freeLines
! did work nothing used:
!     st.split(',')            ->    st.split('<13,10>')
!     st.split('<13,10>')
! The dead line is <st>.split(...) whose arguments only read: literals, names, and calls from the
! reader list IfChainToCase keeps (upper, sub, chr, another object's getValue ...). An argument
! that calls anything else is refused with its name, since what the call does would go with the
! line - and so is a name with no brackets that the symbol table does not place as data, since
! Clarion calls a parameterless procedure by its label alone (TRUE, FALSE and a name holding a
! colon, such as st:clip, are not calls). What makes the line dead is the NEXT line to
! mention the object at all: it must be <st>.split(...) again - which replaces the lines - or
! <st>.freeLines() - which frees them. A read of the lines first (records, getLine, join,
! setValueFromLine, sort ... anything that touches the queue) is the first mention instead, so
! there is no site and nothing is said: split then read is the ordinary use. A line between that
! opens, closes or branches a structure, a column-1 label, a `do` anywhere on a line, or a RETURN
! or EXIT also ends the search without a word - the second split must be sure to follow, and to
! run. Nothing at all may come between the two splits of a STATIC or THREAD object, which every
! call of the procedure shares, a recursive one too. When the object can be read under another
! name, the second split's arguments may hold nothing that could read the old lines that way - a
! call off the reader list, or a name that may be the object. Each of these refuses, and says so.
! A statement after the second split on its line runs after it and sees only the new lines, so it
! is not judged. split reads the VALUE, not the lines, and leaves the value untouched, so dropping
! the first split changes nothing a later line could see.
! A dead split that carries a comment goes too; the comment stays on a line of its own (14 Sep 2026). Two scans on
! pass 1; the editing scan stops at its first edit.
!===============================================================================================
VitEngine.BuiltinDeadLinesWrite Procedure(StringTheory pLog)
i           long,auto
dlX         long,auto
dlZ         long,auto
dlD         long,auto          ! instring scratch
dlAttr      long,auto          ! DlParamCheck: the object is STATIC or THREAD
dlN         long,auto          ! length scratch
dlLine1     long,auto          ! first token of the dead split's line
dlNextWr    long,auto          !   and of the split or freeLines that makes it dead
dlFrom      long,auto          ! DlFill: first token of the line in hand
dlNext      long,auto          !   and of the next
dlHeadIx    long               ! DlHead input
dlHead      STRING(vs:maxName) !   output
dlTail      STRING(96)
dlSt        STRING(vs:maxName) ! the object, folded
dlStTxt     STRING(vs:maxName) !   and as the author spelled it
dlEsc       byte               ! ObjEscapes: a parameter, a reference to it, a local class's method, handed to a call
dlReach     byte               !   which of them, before STATIC and THREAD count too: 1 parameter, 2 reference, 3 another name
dlArgBad    byte               ! DlEscArg: a name in the killer's arguments may read the old lines
dlArgE      long               ! DlIsKill: the row of the killer's own ')', 0 = not on the line
dlKill      STRING(16)         ! SPLIT or FREELINES - what the killer line does
dlScFirst   long,auto
dlScLast    long,auto
dlSc        long,auto
dlWhy       STRING(200)
dlRpt       byte
dlEdited    byte
dlSite      byte               ! DlAfter: the next mention of the object replaces or frees the lines
dlExec      long               ! the enclosing EXECUTE, when the dead line is one of its arms
dlArg       STRING(96)         ! DlShape: a call in the split's arguments that is not a reader, blank = none
dlArgBare   byte               !   and it is a name with no brackets, which may be a call
dlPure      StringTheory       ! ' NAME NAME ' - the calls that only read, as IfChainToCase lists them
dlOwn       StringTheory       !   the names on it this file gives a procedure of its own (PureOwnList)
dlQ         QUEUE,PRE(dl)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  self.IfCasePureList(dlPure)
  self.PureOwnList(dlPure, dlOwn)
  dlEdited = 0
  if self.curPass = 1
    dlRpt = 1 ; do DlScan
  end
  dlRpt = 0 ; do DlScan
  return dlEdited

! ---- every line that is a plain split: is the next mention of the object a split or freeLines?
DlScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    dlLine1 = i
    dlFrom = dlLine1 ; do DlFill
    do DlShape
    if ~dlSt then cycle.
    do DlScope
    if ~dlScFirst then cycle.
    do DlNames
    dlWhy = ''
    do DlParamCheck
    if dlWhy then cycle.   ! not a StringTheory of this procedure - not a site, no word
    do DlAfter
    if ~dlSite then cycle.
    ! NOT ONE ARM OF AN EXECUTE - the same rule as DeadValueWrite's, for the same reason: the
    ! split below this one is an ALTERNATIVE to it, not a replacement of its lines, and taking
    ! an arm away RENUMBERS every arm below it. Found 15 Sep 2026.
    if ~dlWhy
      dlExec = self.InExecute(dlLine1, dlScFirst)
      if dlExec
        dlWhy = 'the line is one arm of the EXECUTE on line ' & self.LogLineOf(dlExec) & ', and the split that would replace its lines is another'
      end
    end
    ! NOR ANY INCLUDE IN THE PROCEDURE, for DeadValueWrite's reason: the included code is not in this
    ! file, and it may read the lines between the two splits.
    if ~dlWhy and self.ScopeIncludes(dlSc)
      dlWhy = clip(dlStTxt) & '''s lines may be read by code the procedure INCLUDEs, which this file does not hold, before they are replaced'
    end
    if ~dlWhy and dlArg and dlArgBare
      dlWhy = 'the split''s arguments name ' & lower(clip(dlArg)) & ', which may be a procedure called without brackets - what it does would go with the line'
    elsif ~dlWhy and dlArg
      dlWhy = 'the split''s arguments call ' & lower(clip(dlArg)) & ', which may do more than read a value - what it does would go with the line'
    end
    if dlWhy
      if dlRpt
        pLog.append('BUILTIN DeadLinesWrite line ' & self.LogLineOf(dlLine1) & ': REFUSED - ' & clip(dlWhy) & '.<13,10>')
      end
      cycle
    end
    if dlRpt then cycle.
    dlZ = self.FirstEolAfter(dlLine1)
    if ~dlZ then cycle.
    if dlKill = 'SPLIT'
      pLog.append('BUILTIN DeadLinesWrite line ' & self.LogLineOf(dlLine1) & ': the lines split from ' & clip(dlStTxt) & |
                  ' here are replaced by the split on line ' & self.LogLineOf(dlNextWr)                                & |
                  ' before anything reads them - the line goes' & choose(~self.EolHasCmt(dlZ), '', ' and its comment stays, on a line of its own') & '.<13,10>')
    else
      pLog.append('BUILTIN DeadLinesWrite line ' & self.LogLineOf(dlLine1) & ': the lines split from ' & clip(dlStTxt) & |
                  ' here are freed on line ' & self.LogLineOf(dlNextWr) & ' before anything reads them'                & |
                  ' - the line goes' & choose(~self.EolHasCmt(dlZ), '', ' and its comment stays, on a line of its own') & '.<13,10>')
    end
    self.DropLinesKeepCmts(dlLine1, dlZ)
    if not self.syms &= NULL then self.syms.dirty = 1.
    dlEdited = 1
    exit
  end

! ---- <st>.split( ... ) and nothing else on the line; dlArg = the first call in the arguments
!      that is not on the reader list (a name right before a '(' is a call; a method's name is
!      what follows its last dot), since the line goes with whatever that call does. A method on
!      the list reads only on a StringTheory: `rdr.GetValue()` of the author's own class may move
!      a cursor, which the line would take with it - see PureMethodAt. A name on the list called
!      alone reads only when it is the runtime's own function and the file has no procedure of
!      that name (PureProc): `Size(s)` may call the program's own Size
DlShape routine
  dlSt = '' ; dlArg = '' ; dlArgBare = 0
  if records(dlQ) < 3 then exit.
  dlHeadIx = 1 ; do DlHead
  get(dlQ, 1)
  dlN = len(clip(dlQ.tx))
  dlD = instring('.', dlQ.tx[1 : dlN], 1, 1)
  if ~dlHead or ~dlD or dlD >= dlN or dlQ.tx[dlD + 1 : dlN] <> 'SPLIT' then exit.
  get(dlQ, 2)
  if dlQ.tx <> '(' then exit.
  get(dlQ, records(dlQ))
  if dlQ.tx <> ')' then exit.
  dlSt = dlHead
  loop dlX = 3 to records(dlQ) - 2
    get(dlQ, dlX + 1)
    if errorcode() then break.
    if dlQ.tx <> '(' then cycle.
    get(dlQ, dlX)
    dlN = len(clip(dlQ.tx))
    if ~dlN then cycle.
    case val(dlQ.tx[dlN])
    of 65 to 90 orof 48 to 57 orof 95 ! 'A' to 'Z' orof '0' to '9' orof '_'
      dlD = dlN
      loop while dlD > 0 and dlQ.tx[dlD] <> '.'
        dlD -= 1
      end
      if ~dlPure.findChars(' ' & dlQ.tx[dlD + 1 : dlN] & ' ') then dlArg = dlQ.tx ; break.
      dlArg = dlQ.tx
      get(dlQ, dlX + 1)
      if (dlD or self.tk.GetTok(dlQ.tk - 2) = '.') and ~self.PureMethodAt(dlQ.tk, dlPure) then break.
      if ~dlD and self.tk.GetTok(dlQ.tk - 2) <> '.' and ~self.PureProc(dlArg, dlPure, dlOwn) then break.
      dlArg = ''
    end
  end
  if dlArg then exit.
  ! a name with no brackets may be a call too: Clarion calls a parameterless procedure by its label
  loop dlX = 3 to records(dlQ) - 1
    get(dlQ, dlX)
    if errorcode() then break.
    if self.BareNameIsCall(dlQ.tk) then dlArg = dlQ.tx ; dlArgBare = 1 ; break.
  end

! ---- the next mention of the object, straight after and in the same block: a split or freeLines
!      makes the site; anything else, or a structure boundary, a label, a `do` anywhere on a line,
!      or a RETURN or EXIT first, means none - the split after a RETURN may never run
DlAfter routine
  dlSite = 0 ; dlNextWr = 0 ; dlKill = ''
  dlFrom = dlNext
  loop while dlFrom > 0 and dlFrom < dlScLast
    do DlFill
    if self.InCondBlock(dlFrom) then exit.      ! a split a build may leave out replaces nothing
    loop dlX = dlFrom to dlNext - 1
      get(self.tk.tokens, dlX)
      if errorcode() then break.
      if self.tk.tokens.level <> ' ' then exit. ! a structure opens, closes or branches
      if not self.tk.tokens.tok &= NULL and inlist(upper(self.tk.tokens.tok), 'BREAK', 'CYCLE', 'GOTO', 'RETURN', 'EXIT', 'DO') then exit.
    end
    if self.syms.IsColOneLabel(dlFrom) then exit.
    dlZ = 0
    loop dlX = 1 to records(dlQ)                ! a `do` anywhere on the line, after a `;` too
      get(dlQ, dlX)
      if ~errorcode() and dlQ.tx = 'DO' then dlZ = 1 ; break.
    end
    if dlZ then exit.
    loop dlX = 1 to records(dlQ)
      dlHeadIx = dlX ; do DlHead
      get(dlQ, dlX)
      if errorcode() then break.
      if dlHead = dlSt or dlQ.tx = dlSt then dlZ = dlX ; break.
    end
    if ~dlZ and dlEsc then exit.                ! a line between, and the object can be read without being named
    if dlZ
      get(self.tk.tokens, dlNext - 1)           ! continued: the line ends on no EOL of its own, and its
      if errorcode() or self.tk.tokens.tok &= NULL or size(self.tk.tokens.tok) <> 1 or self.tk.tokens.tok <> '<10>' then exit. !   read of the object may sit past the bar
      do DlIsKill
      exit
    end
    dlFrom = dlNext
  end

! ---- the line in hand mentions the object, first at row dlZ: is it <st>.split(...) or
!      <st>.freeLines(...) as the whole statement? Its arguments run to its own closing bracket, and
!      a name in them that may read the old lines under another name refuses. A statement after it
!      on the line runs after it, and the lines it can reach are the new ones - never those the
!      first split made - so it is not judged, under the object's own name or another (ruled 4 Nov
!      2026)
DlIsKill routine
  if dlZ <> 1 then exit. ! the object is read before any call on it - the lines were used
  get(dlQ, 1)
  dlN = len(clip(dlQ.tx))
  dlD = instring('.', dlQ.tx[1 : dlN], 1, 1)
  if ~dlD or dlD >= dlN then exit.
  dlTail = dlQ.tx[dlD + 1 : dlN]
  if dlTail <> 'SPLIT' and dlTail <> 'FREELINES' then exit.
  get(dlQ, 2)
  if errorcode() or dlQ.tx <> '(' then exit.
  dlArgE = 0 ; dlD = 1
  loop dlX = 3 to records(dlQ)
    get(dlQ, dlX)
    if errorcode() then break.
    if dlQ.tx = '(' then dlD += 1.
    if dlQ.tx = ')' then dlD -= 1.
    if ~dlD then dlArgE = dlX ; break.
  end
  ! the object must not appear again in the killer's own arguments (split reads the value, not
  ! the lines, so a bare separator is fine; a second mention would be an odd read we leave alone),
  ! and when it can be read under another name (dlEsc), nothing in them may read it that way
  loop dlX = 3 to records(dlQ)
    if dlArgE and dlX > dlArgE then break.
    dlHeadIx = dlX ; do DlHead
    get(dlQ, dlX)
    if errorcode() then break.
    if dlHead = dlSt or dlQ.tx = dlSt then exit.
    if dlEsc
      do DlEscArg
      if dlArgBad then dlSite = 1 ; exit.
    end
  end
  dlKill = dlTail
  dlNextWr = dlFrom
  dlSite = 1

! ---- the object can be read under another name (dlEsc), so the killer's own arguments may hold only
!      literals, operators, StringTheory flags, names that cannot be that object and calls that read
!      nothing but what they are handed - the same tests as DwEscArg, which says why each is there. Any
!      other call, a name the symbol table cannot place, or any other object could read the old lines
!      through that other name before the killer replaces them. Row dlX of dlQ is the token judged;
!      dlArgBad = 1 refuses, and dlWhy says why.
DlEscArg routine
  data
dz    long,auto
dn    long,auto
dp    long,auto
dRoot STRING(96),AUTO
dTy   STRING(vs:maxName)
dRf   BYTE
dRow  long,auto
dOk   byte,auto
  code
  dlArgBad = 0
  get(self.tk.tokens, dlQ.tk)
  if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then exit.
  dn = len(clip(dlQ.tx))
  if ~dn or (dn > 3 and dlQ.tx[1 : 3] = 'ST:') then exit.
  get(dlQ, dlX + 1)
  if ~errorcode() and dlQ.tx = '('
    dp = dlQ.tk
    get(dlQ, dlX)
    ! the name called is the text after the last dot. A runtime reader called by name alone reads only
    ! its arguments, rows of their own; a reader called on a StringTheory has its receiver judged below
    dz = dn
    loop while dz > 0 and dlQ.tx[dz] <> '.'
      dz -= 1
    end
    dOk = 0
    if dz < dn and dlPure.findChars(' ' & dlQ.tx[dz + 1 : dn] & ' ')
      if (~dz and self.tk.GetTok(dp - 2) <> '.' and self.PureProc(dlQ.tx[1 : dn], dlPure, dlOwn)) or self.PureMethodAt(dp, dlPure) then dOk = 1.
    end
    if ~dOk
      dlArgBad = 1
      dlWhy = 'line ' & self.LogLineOf(dlFrom) & ' calls ' & lower(clip(dlQ.tx)) & ', which may read the lines of ' & clip(dlStTxt) & ' under another name first'
      exit
    end
    if ~dz then exit.
  end
  get(dlQ, dlX)
  dz = pLog.findByte(46, 1,, dlQ.tx) ! <dot>: the root names the storage
  if dz > 1
    dRoot = dlQ.tx[1 : dz - 1]
  else
    dRoot = dlQ.tx[1 : dn]
  end
  if dRoot = 'TRUE' or dRoot = 'FALSE' then exit.
  if self.syms.Lookup(dRoot, dlQ.tk, dTy, dRf) and ~dRf
    if dTy <> 'STRINGTHEORY' and self.UvPlainType(dTy) then exit.
    dRow = self.syms.FindOwn(dRoot, dlSc)
    if dRow
      get(self.syms.syms, dRow)
      if ~errorcode() and ~self.syms.syms.isRef and self.syms.IsColOneLabel(self.syms.syms.declTok)
        if ~band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread) then exit.
        if dlAttr and ~dlReach and dRoot <> dlSt then exit.
      end
    end
  end
  dlArgBad = 1
  dlWhy = 'line ' & self.LogLineOf(dlFrom) & ' reads ' & lower(clip(dRoot)) & ', which may be ' & clip(dlStTxt) & ' under another name'

! ---- the procedure
DlScope routine
  dlScFirst = 0 ; dlScLast = 0
  dlSc = self.syms.ScopeContaining(dlLine1, vs:scProc, vs:scMethod)
  if ~dlSc then exit.
  self.syms.scopes.scopeId = dlSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  dlScFirst = self.syms.scopes.startTok
  dlScLast  = self.syms.scopes.endTok

! ---- the object is a StringTheory declared in this procedure (local or parameter - the second
!      split is what a later reader sees either way). A STATIC or THREAD one is shared by every
!      call of the procedure: a call between the splits, a recursive one, may read its lines
DlParamCheck routine
  dlZ = self.syms.FindOwn(dlSt, dlSc)
  if ~dlZ then dlWhy = 'not declared here' ; exit.
  get(self.syms.syms, dlZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then dlWhy = 'not a StringTheory' ; exit.
  dlAttr = band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread)
  dlEsc = self.ObjEscapes(dlSt, dlLine1) ! read without its name? Then nothing may come between the splits
  dlReach = 0                            ! and why, for DlEscArg
  if dlEsc then do DlReachKind.
  if dlAttr then dlEsc = 1.              ! nor when every call of the procedure shares it

! ---- why ObjEscapes answered 1: the object is a parameter, a reference, or reached under another name
DlReachKind routine
  get(self.syms.syms, dlZ)
  if errorcode()
    dlReach = 3
  elsif ~self.syms.IsColOneLabel(self.syms.syms.declTok)
    dlReach = 1
  elsif self.syms.syms.isRef
    dlReach = 2
  else
    dlReach = 3
  end

! ---- the object's name as the author spelled it, from the dead line
DlNames routine
  dlStTxt = dlSt
  get(self.tk.tokens, dlLine1)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  dlN = len(clip(self.tk.tokens.tok))
  if ~dlN then exit.
  dlD = instring('.', self.tk.tokens.tok[1 : dlN], 1, 1)
  if dlD > 1
    if upper(self.tk.tokens.tok[1 : dlD - 1]) = dlSt then dlStTxt = self.tk.tokens.tok[1 : dlD - 1].
  elsif ~dlD
    if upper(self.tk.tokens.tok[1 : dlN]) = dlSt then dlStTxt = self.tk.tokens.tok[1 : dlN].
  end

! ---- the tokens of ONE physical line, uppercased, into dlQ, the split dotted spelling joined
DlFill routine
  free(dlQ)
  dlNext = 0
  loop dlX = dlFrom to records(self.tk.tokens)
    get(self.tk.tokens, dlX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dlNext = dlX + 1 ; break
    end
    if dlX > dlFrom and self.tk.tokens.firstOnLine
      dlNext = dlX ; break
    end
    dlQ.tx = upper(self.tk.tokens.tok)
    dlQ.tk = dlX
    add(dlQ)
  end
  if ~dlNext then dlNext = records(self.tk.tokens) + 1.
  do DlJoin

! ---- a '.' between two names becomes one row (a method call arrives as three tokens)
DlJoin routine
  dlX = 2
  loop while dlX < records(dlQ)
    get(dlQ, dlX)
    if errorcode() then break.
    if dlQ.tx <> '.' then dlX += 1 ; cycle.
    get(dlQ, dlX - 1)
    if errorcode() or ~((dlQ.tx[1] >= 'A' and dlQ.tx[1] <= 'Z') or dlQ.tx[1] = '_') then dlX += 1 ; cycle.
    dlHead = dlQ.tx
    get(dlQ, dlX + 1)
    if errorcode() or ~((dlQ.tx[1] >= 'A' and dlQ.tx[1] <= 'Z') or dlQ.tx[1] = '_') then dlX += 1 ; cycle.
    dlTail = dlQ.tx
    delete(dlQ)
    get(dlQ, dlX)
    delete(dlQ)
    get(dlQ, dlX - 1)
    dlQ.tx = clip(dlHead) & '.' & dlTail
    put(dlQ)
  end

! ---- dlHead = the RECEIVER in front of the dlQ row at dlHeadIx
DlHead routine
  dlHead = ''
  get(dlQ, dlHeadIx)
  if errorcode() then exit.
  dlN = len(clip(dlQ.tx))
  if ~dlN then exit.
  dlD = instring('.', dlQ.tx[1 : dlN], 1, 1)
  if dlD > 1 then dlHead = dlQ.tx[1 : dlD - 1].
!===============================================================================================
! BUILTIN ByteLoopToCall - a byte-by-byte loop over the value is one StringTheory call:
!     loop i = 1 to st._DataEnd                                  n += st.count('x')
!       if st.valuePtr[i] = 'x' then n += 1.
!     end
! The hit decides the call: `n += 1` is a count; `f = 1 ; break` is `if st.containsChar('x') then
! f = 1.`; and `p = i ; break`, with `p = 0` on the line before, is `p = st.findChar('x')`. The
! spelling `val(st.valuePtr[i]) = 9` gives the byte forms - count(chr(9)), containsByte(9),
! findByte(9). StringTheory's Count with a one-character needle is a memchr walk counting every
! occurrence, ContainsChar is choose(memchr(...)), FindChar the first position or 0: each reads
! exactly the bytes the loop read. The guards, each a refusal that says which: the loop head is
! `loop i = 1 to st._DataEnd` or `st.length()`; the body is that one IF, on its line or as a block;
! the character is a one-character literal (or one <n> escape, or a number on the val() spelling);
! the position form has `p = 0` before the loop, since findChar answers 0 where the loop leaves p
! alone; the index is the loop's alone; the hit variable is neither the index nor the object; the
! object is a StringTheory; the loop is not an EXECUTE arm; a frame line's comment stays above the call (14 Sep 2026). A loop
! over the bytes with any other body is not a site and is not reported. Two scans on pass 1.
!===============================================================================================
VitEngine.BuiltinByteLoopToCall Procedure(StringTheory pLog)
i           long,auto
blX         long,auto
blY         long,auto
blZ         long,auto
blD         long,auto          ! instring scratch
blN         long,auto          ! length scratch
blLoop      long,auto          ! first token of the loop line
blIf        long,auto          !   of the IF line
blPast      long,auto          ! first token PAST the loop's END line
blFrom      long,auto          ! BlFill: first token of the line in hand
blNext      long,auto          !   and of the next
blCont      byte               !   1 = it is carried on to the next line by a bar
blHeadIx    long               ! BlHead input
blHead      STRING(vs:maxName) !   output
blTail      STRING(96)
blSt        STRING(vs:maxName) ! the object, folded
blStTxt     STRING(vs:maxName) !   and as the author spelled it
blIx        STRING(vs:maxName) ! the loop index, folded
blIxDecl    byte               ! BlIndexUse: the line is the index's own declaration
blHit       STRING(vs:maxName) ! the variable the hit changes, folded
blHitTxt    STRING(vs:maxName) !   and as written
blKind      byte               ! 1 = count (hit += 1), 2 = flag (hit = 1), 3 = position (hit = i)
blByte      byte               ! the val() spelling: the character is a number, the calls are the byte ones
blChar      STRING(96)         ! the character, as written: 'x', '<9>' or 9
blEq        long               ! the blQ row of the '=' at depth 0 on the IF line
blThen      long               !   and of THEN, 0 in the block form
blScFirst   long,auto
blScLast    long,auto
blScCode    long,auto
blSc        long,auto
blWhy       STRING(200)
blRpt       byte
blEdited    byte
blCmtN      long               ! comments kept from the loop (log)
blDepth     long,auto
blLoopLn    long,auto          ! the log-facing line of the loop, read BEFORE the edit moves it
blTxt       StringTheory       ! the one line that replaces the loop
blInd       StringTheory       ! the loop's indent
blQ         QUEUE,PRE(bl)
tx            STRING(96)
tk            long             ! the row's first token in the real stream
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  blEdited = 0
  if self.curPass = 1
    blRpt = 1 ; do BlScan
  end
  blRpt = 0 ; do BlScan
  return blEdited

! ---- every loop over an object's bytes whose body is one IF on the byte read: the guards, then the edit
BlScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    blLoop = i
    blFrom = blLoop ; do BlFill
    do BlLoopShape
    if ~blSt then cycle.
    do BlScope
    if ~blScFirst then cycle.
    do BlNames
    blWhy = ''
    do BlBody            ! sets blIf, blPast, blKind, blChar ... or blWhy; blIf = 0 = not a site
    if ~blIf then cycle.
    if ~blWhy then do BlParamCheck.
    if ~blWhy then do BlIndexUse.
    if ~blWhy then do BlZeroBefore.
    if ~blWhy then do BlRuns.
    if blWhy
      if blRpt
        pLog.append('BUILTIN ByteLoopToCall line ' & self.LogLineOf(blLoop) & ': REFUSED - ' & clip(blWhy) & '.<13,10>')
      end
      cycle
    end
    if blRpt then cycle.
    blLoopLn = self.LogLineOf(blLoop)
    do BlEdit
    pLog.append('BUILTIN ByteLoopToCall line ' & blLoopLn & ': the byte loop over ' & clip(blStTxt) & ' is one call' & |
                choose(~blCmtN, '', ' - its ' & blCmtN & ' comment(s) stay above it, on lines of their own') & '.<13,10>')
    blEdited = 1
    exit
  end

! ---- LOOP <ix> = 1 TO <st>._DataEnd (six rows) or <st>.length() (eight)
BlLoopShape routine
  blSt = '' ; blIx = ''
  if records(blQ) <> 6 and records(blQ) <> 8 then exit.
  get(blQ, 1) ; if blQ.tx <> 'LOOP' then exit.
  get(blQ, 3) ; if blQ.tx <> '=' then exit.
  get(blQ, 4) ; if blQ.tx <> '1' then exit.
  get(blQ, 5) ; if blQ.tx <> 'TO' then exit.
  blHeadIx = 6 ; do BlHead
  get(blQ, 6)
  blN = len(clip(blQ.tx))
  blD = instring('.', blQ.tx[1 : blN], 1, 1)
  if ~blHead or ~blD or blD >= blN then exit.
  blTail = blQ.tx[blD + 1 : blN]
  if records(blQ) = 6
    if blTail <> '_DATAEND' then exit.
  else
    if blTail <> 'LENGTH' then exit.
    get(blQ, 7) ; if blQ.tx <> '(' then exit.
    get(blQ, 8) ; if blQ.tx <> ')' then exit.
  end
  get(blQ, 2)
  case blQ.tx[1]
  of 'A' to 'Z' orof '_'
  else
    exit
  end
  blIx = blQ.tx
  blSt = blHead

! ---- the body: ONE if on the byte read, its hit (and break), then the loop's END. Either
!         if <read> = <c> then <hit>.  |  then <hit> ; break.        (one line, then END)
!      or if <read> = <c>  /  <hit>  /  [break]  /  end  /  end
BlBody routine
  blIf = 0 ; blPast = 0 ; blKind = 0 ; blByte = 0 ; blChar = '' ; blEq = 0 ; blThen = 0
  blFrom = blNext ; do BlFill
  get(blQ, 1)
  if errorcode() or blQ.tx <> 'IF' then exit.
  blZ = 0
  loop blX = 2 to records(blQ)
    get(blQ, blX)
    if errorcode() then break.
    if blQ.tx = '(' then blZ += 1.
    if blQ.tx = ')' then blZ -= 1.
    if blZ then cycle.
    if blQ.tx = '=' and ~blEq then blEq = blX.
    if blQ.tx = 'THEN' then blThen = blX ; break.
  end
  if ~blEq then exit.
  if blCont and blThen < records(blQ)
    blIf = blFrom
    blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' carries on onto the next line'
    exit
  end
  do BlCompare ! the byte read on the left, the character on the right; blIf set when it is
  if ~blIf or blWhy then exit.
  ! ---- THEN ends the physical line: either a bar carries the IF on, which is refused, or this is the
  !      block form written with THEN, read as the block form is
  if blThen and blThen = records(blQ)
    get(blQ, blThen)
    if errorcode() then exit.
    if ~self.IsEolTok(blQ.tk + 1)
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' carries on after THEN onto the next line'
      exit
    end
    blThen = 0
  end
  if blThen
    ! ---- one line: THEN <hit> += 1 .  |  THEN <hit> = 1|<ix> ; BREAK .
    get(blQ, blThen + 1) ; blHit = blQ.tx ; blZ = blQ.tk ; do BlHitName
    get(blQ, blThen + 2)
    if errorcode() then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' neither counts nor sets a variable' ; exit.
    case blQ.tx
    of '+='
      if records(blQ) <> blThen + 4 then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does more than count' ; exit.
      get(blQ, blThen + 3) ; if blQ.tx <> '1' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' adds something other than 1' ; exit.
      get(blQ, blThen + 4) ; if blQ.tx <> '.' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does not end on its own line' ; exit.
      blKind = 1
    of '='
      if records(blQ) <> blThen + 6 then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does more than set a variable and break' ; exit.
      get(blQ, blThen + 3) ; do BlHitKind
      if blWhy then exit.
      get(blQ, blThen + 4) ; if blQ.tx <> ';' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does more than set a variable and break' ; exit.
      get(blQ, blThen + 5) ; if blQ.tx <> 'BREAK' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does not break after the hit - every byte is still read' ; exit.
      get(blQ, blThen + 6) ; if blQ.tx <> '.' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does not end on its own line' ; exit.
    else
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' neither counts nor sets a variable'
      exit
    end
  else
    ! ---- a block: <hit> += 1  /  END   or   <hit> = 1|<ix>  /  BREAK  /  END
    blFrom = blNext ; do BlFill
    if blCont then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' carries a line of its block onto the next' ; exit.
    if records(blQ) <> 3 then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does more than count or set a variable on its first line' ; exit.
    get(blQ, 1) ; blHit = blQ.tx ; blZ = blQ.tk ; do BlHitName
    get(blQ, 2)
    case blQ.tx
    of '+='
      get(blQ, 3) ; if blQ.tx <> '1' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' adds something other than 1' ; exit.
      blKind = 1
    of '='
      get(blQ, 3) ; do BlHitKind
      if blWhy then exit.
      blFrom = blNext ; do BlFill
      get(blQ, 1)
      if errorcode() or records(blQ) <> 1 or blQ.tx <> 'BREAK' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does not break right after the hit - every byte is still read' ; exit.
    else
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' neither counts nor sets a variable'
      exit
    end
    blFrom = blNext ; do BlFill
    get(blQ, 1)
    if errorcode() or records(blQ) <> 1 or blQ.tx <> 'END' then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does more than its hit' ; exit.
  end
  blFrom = blNext ; do BlFill
  get(blQ, 1)  ! the loop's own END
  if errorcode() or records(blQ) <> 1 or blQ.tx <> 'END'
    blWhy = 'the loop on line ' & self.LogLineOf(blLoop) & ' holds more than the one IF: line ' & self.LogLineOf(blFrom)
    exit
  end
  blPast = blNext
  if ~((blHit[1] >= 'A' and blHit[1] <= 'Z') or blHit[1] = '_') then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' does not simply change a variable' ; exit.
  if blHit = blIx then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' changes the loop index itself' ; exit.
  if blHit = blSt then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' assigns to the object' ; exit.

! ---- the hit variable as the author spelled it, from its token at blZ
BlHitName routine
  blHitTxt = blHit
  get(self.tk.tokens, blZ)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then blHitTxt = self.tk.tokens.tok.

! ---- the blQ row in hand is what `<hit> =` assigns: 1 (a flag) or the index (a position)
BlHitKind routine
  if blQ.tx = '1'
    blKind = 2
  elsif blQ.tx = blIx
    blKind = 3
  else
    blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' sets ' & lower(clip(blHit)) & ' to something other than 1 or the index'
  end

! ---- rows 2 .. blEq-1 are <st>.valuePtr[<ix>] (4 rows) or val( <st>.valuePtr[<ix>] ) (7); the row
!      after '=' is the character, and it is the last of the compare
BlCompare routine
  blX = 2
  get(blQ, blX)
  if errorcode() then exit.
  if blQ.tx = 'VAL'
    get(blQ, blX + 1)
    if errorcode() or blQ.tx <> '(' then exit.
    blByte = 1
    blX += 2
  end
  blHeadIx = blX ; do BlHead
  get(blQ, blX)
  blN = len(clip(blQ.tx))
  blD = instring('.', blQ.tx[1 : blN], 1, 1)
  if blHead <> blSt or ~blD or blD >= blN or blQ.tx[blD + 1 : blN] <> 'VALUEPTR' then exit.
  get(blQ, blX + 1) ; if errorcode() or blQ.tx <> '[' then exit.
  get(blQ, blX + 2) ; if errorcode() or blQ.tx <> blIx then exit.
  get(blQ, blX + 3) ; if errorcode() or blQ.tx <> ']' then exit.
  blX += 4
  if blByte
    get(blQ, blX) ; if errorcode() or blQ.tx <> ')' then exit.
    blX += 1
  end
  if blX <> blEq then exit.                       ! something else before the '='
  blIf = blFrom                                   ! THE SHAPE: from here a failure is a refusal
  blY = choose(~blThen, records(blQ), blThen - 1) ! the last row of the compare
  if blY <> blEq + 1 then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares the byte with more than one thing' ; exit.
  get(blQ, blEq + 1)
  get(self.tk.tokens, blQ.tk)                     ! the character AS WRITTEN - the row is uppercased
  if errorcode() or self.tk.tokens.tok &= NULL then blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares the byte with nothing' ; exit.
  blChar = self.tk.tokens.tok
  blN = len(clip(blChar))
  if blByte
    loop blX = 1 to blN
      case val(blChar[blX])
      of 48 to 57                                 ! '0' to '9'
      else
        blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares the byte value with ' & clip(blChar) & ', which is not a number'
        exit
      end
    end
    if blN > 3 or blChar[1 : blN] > 255           ! a byte is 0 to 255: `= 300` is never true, and
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares the byte value with ' & clip(blChar) & ', which no byte can hold - the test is never true, and a search for it would be'
      exit                                        !   containsByte(300) can match a real byte
    end
  else
    if blChar[1] <> '''' or blN < 3 or blChar[blN] <> ''''
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares the byte with ' & clip(blChar) & ', which is not a literal'
      exit
    end
    if self.GetSingleCharVal(blChar) = -1         ! one character: 'x', a doubled pair, or ONE '<n>' code
      blWhy = 'the IF on line ' & self.LogLineOf(blIf) & ' compares one byte with ' & clip(blChar) & ', which is not one character'
    end
  end

! ---- the procedure and the end of its header
BlScope routine
  blScFirst = 0 ; blScLast = 0 ; blScCode = 0
  blSc = self.syms.ScopeContaining(blLoop, vs:scProc, vs:scMethod)
  if ~blSc then exit.
  self.syms.scopes.scopeId = blSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  blScFirst = self.syms.scopes.startTok
  blScLast  = self.syms.scopes.endTok
  blZ = 0
  loop blX = blScFirst to records(self.tk.tokens)
    get(self.tk.tokens, blX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      blZ += 1
    elsif self.tk.tokens.tok = ')'
      blZ -= 1
      if ~blZ then blScCode = blX ; break.
    elsif ~blZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      blScCode = blX ; break
    end
  end
  if ~blScCode then blScCode = blScFirst.

! ---- the object is a StringTheory of this procedure (nothing is written to it); the index a local of
!      the procedure, or of the ROUTINE the loop is in when it has DATA of its own, and not declared OVER
!      another variable, which the loop would set too
BlParamCheck routine
  data
rsc  long,auto
  code
  rsc = self.syms.ScopeContaining(blLoop, vs:scRoutine, vs:scRoutine) ! a ROUTINE's own DATA first: its names hide the procedure's
  blZ = 0
  if rsc then blZ = self.syms.FindSym(blSt, rsc).
  if ~blZ then blZ = self.syms.FindOwn(blSt, blSc).
  if ~blZ then blWhy = clip(blStTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, blZ)
  if errorcode() then blWhy = clip(blStTxt) & ' is not declared in this procedure' ; exit.
  if self.syms.syms.typeU <> 'STRINGTHEORY' then blWhy = clip(blStTxt) & ' is not a StringTheory' ; exit.
  blZ = 0
  if rsc then blZ = self.syms.FindSym(blIx, rsc).
  if ~blZ then blZ = self.syms.FindOwn(blIx, blSc).
  if ~blZ then blWhy = lower(clip(blIx)) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, blZ)
  if errorcode() or (self.syms.syms.declTok > blScFirst and self.syms.syms.declTok <= blScCode)
    blWhy = lower(clip(blIx)) & ' is a PARAMETER, and the loop is what sets it'
  elsif band(self.DeclAttrBits(self.syms.syms.declTok), ab:over)
    blWhy = lower(clip(blIx)) & ' is declared OVER another variable, which the loop sets as well'
  elsif self.NameShared(blLoop, blIx)
    blWhy = lower(clip(blIx)) & ' has a second name - a field of a structure, an OVER or a reference - that can read what the loop left in it'
  end

! ---- the index is the loop's alone - not even a method of a class the procedure declares names it:
!      such a method shares the procedure's data, and its body lies outside the walk below. Nor may
!      the procedure INCLUDE a file: the included code is not in this file, and it may read the index
BlIndexUse routine
  if self.MayHaveLocalMethods(blSc) and self.UsedInLocalMethods(upper(blIx), blScFirst, blScLast)
    blWhy = lower(clip(blIx)) & ' is used in a method of a class this procedure declares, which can read it after the loop'
    exit
  end
  if self.ScopeIncludes(blSc)
    blWhy = lower(clip(blIx)) & ' may be read by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  blFrom = blScFirst
  loop while blFrom > 0 and blFrom < blScLast
    do BlFill
    blIxDecl = 0                                                       ! the index's OWN declaration is skipped, and nothing
    if self.syms.IsColOneLabel(blFrom)                                 !   else in column 1: a labelled statement that reads it,
      get(blQ, 1)                                                      !   or `x LONG,OVER(i)`, is a use
      if ~errorcode() and blQ.tx = blIx then blIxDecl = 1.
    end
    if blFrom = blLoop or blFrom = blIf or blIxDecl
      blFrom = blNext ; cycle                                          ! the loop's own mentions, and its declaration
    end
    if blFrom > blIf and blFrom < blPast then blFrom = blNext ; cycle. ! the hit line of the block form
    loop blX = 1 to records(blQ)
      blHeadIx = blX ; do BlHead
      get(blQ, blX)
      if errorcode() then break.
      if blHead = blIx or blQ.tx = blIx
        blWhy = lower(clip(blIx)) & ' is used on line ' & self.LogLineOf(blFrom) & ' outside the loop, which leaves it at the length plus one'
        exit
      end
    end
    blFrom = blNext
  end

! ---- the position form needs `<hit> = 0` on the line before the loop
BlZeroBefore routine
  if blKind <> 3 then exit.
  blY = 0
  loop blX = blLoop - 1 to blScCode + 1 by -1
    get(self.tk.tokens, blX)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then blY = blX ; break.
  end
  if blY
    blFrom = blY ; do BlFill
    if records(blQ) = 3
      get(blQ, 1)
      if blQ.tx = blHit
        get(blQ, 2)
        if blQ.tx = '='
          get(blQ, 3)
          if blQ.tx = '0'
            if ~self.InCondBlock(blY) then exit.
            blWhy = lower(clip(blHitTxt)) & ' is set to 0 on line ' & self.LogLineOf(blY) & ' inside a COMPILE or OMIT block, which some build leaves out'
            exit
          end
        end
      end
    end
  end
  blWhy = lower(clip(blHitTxt)) & ' is not set to 0 on the line before the loop - findChar answers 0 for no match, where the loop leaves it alone'

! ---- the loop is not one arm of an EXECUTE
BlRuns routine
  blDepth = 0
  loop blX = blLoop - 1 to blScCode + 1 by -1
    get(self.tk.tokens, blX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      blDepth += 1
    of '+'
      if blDepth
        blDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          blWhy = 'the loop is one arm of the EXECUTE on line ' & self.LogLineOf(blX)
        end
        break
      end
    end
  end

! ---- every line of the loop goes, so none may carry a comment
! ---- THE EDIT: one line at the loop's indent, the loop deleted whole
BlEdit routine
  blInd.free()
  get(self.tk.tokens, blLoop)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    blY = 0
    loop blX = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[blX] = '<10>' then blY = blX.
    end
    if blY < size(self.tk.tokens.strBefore)
      blInd.setValue(self.tk.tokens.strBefore[blY + 1 : size(self.tk.tokens.strBefore)])
    end
  end
  blTxt.setValue(blInd)
  case blKind
  of 1
    blTxt.append(clip(blHitTxt) & ' += ' & clip(blStTxt) & '.count(')
    if blByte
      blTxt.append('chr(' & clip(blChar) & '))')
    else
      blTxt.append(clip(blChar) & ')')
    end
  of 2
    blTxt.append('if ' & clip(blStTxt))
    if blByte
      blTxt.append('.containsByte(' & clip(blChar) & ')')
    else
      blTxt.append('.containsChar(' & clip(blChar) & ')')
    end
    blTxt.append(' then ' & clip(blHitTxt) & ' = 1.')
  of 3
    blTxt.append(clip(blHitTxt) & ' = ' & clip(blStTxt))
    if blByte
      blTxt.append('.findByte(' & clip(blChar) & ')')
    else
      blTxt.append('.findChar(' & clip(blChar) & ')')
    end
  end
  blTxt.append('<13,10>')
  self.TxaMarkLines(blTxt, self.TxaShiftOf(blLoop))
  ! the loop goes; its comments stay above the call (one EOL token per comment line kept)
  blCmtN = self.DropLinesKeepCmts(blLoop, blPast - 1)
  self.InsertLinesAbove(blLoop + blCmtN, blTxt)
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- the object's name as the author spelled it, from the loop line
BlNames routine
  blStTxt = blSt
  loop blX = blLoop to records(self.tk.tokens)
    get(self.tk.tokens, blX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    blN = len(clip(self.tk.tokens.tok))
    if ~blN then cycle.
    blD = instring('.', self.tk.tokens.tok[1 : blN], 1, 1)
    if blD > 1
      if upper(self.tk.tokens.tok[1 : blD - 1]) = blSt then blStTxt = self.tk.tokens.tok[1 : blD - 1].
    elsif ~blD
      if upper(self.tk.tokens.tok[1 : blN]) = blSt then blStTxt = self.tk.tokens.tok[1 : blN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into blQ with their positions; the split
!      dotted spelling joined
BlFill routine
  free(blQ)
  blNext = 0
  blCont = 0
  loop blX = blFrom to records(self.tk.tokens)
    get(self.tk.tokens, blX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      blNext = blX + 1 ; break
    end
    if blX > blFrom and self.tk.tokens.firstOnLine
      blNext = blX ; blCont = 1 ; break
    end
    blQ.tx = upper(self.tk.tokens.tok)
    blQ.tk = blX
    add(blQ)
  end
  if ~blNext then blNext = records(self.tk.tokens) + 1.
  do BlJoin

! ---- a '.' between two names becomes one row (a method call arrives as three tokens)
BlJoin routine
  blX = 2
  loop while blX < records(blQ)
    get(blQ, blX)
    if errorcode() then break.
    if blQ.tx <> '.' then blX += 1 ; cycle.
    get(blQ, blX - 1)
    if errorcode() or ~((blQ.tx[1] >= 'A' and blQ.tx[1] <= 'Z') or blQ.tx[1] = '_') then blX += 1 ; cycle.
    blHead = blQ.tx
    get(blQ, blX + 1)
    if errorcode() or ~((blQ.tx[1] >= 'A' and blQ.tx[1] <= 'Z') or blQ.tx[1] = '_') then blX += 1 ; cycle.
    blTail = blQ.tx
    delete(blQ)
    get(blQ, blX)
    delete(blQ)
    get(blQ, blX - 1)
    blQ.tx = clip(blHead) & '.' & blTail
    put(blQ)
  end

! ---- blHead = the RECEIVER in front of the blQ row at blHeadIx
BlHead routine
  blHead = ''
  get(blQ, blHeadIx)
  if errorcode() then exit.
  blN = len(clip(blQ.tx))
  if ~blN then exit.
  blD = instring('.', blQ.tx[1 : blN], 1, 1)
  if blD > 1 then blHead = blQ.tx[1 : blD - 1].

!===============================================================================================
! BUILTIN LineSearchToInLine - a loop that searches the lines for a value, one line at a time, is
! one inLine() call:
!     loop i = 1 to st.records()                          if st.inLine(x,,,,,true) then found = 1.
!       if st.getLine(i) = x then found = 1 ; break.
!     end
! and with `pos = 0` on the line before, `if st.getLine(i) = x then pos = i ; break.` becomes
! `pos = st.inLine(x,,,,,true)`. StringTheory's InLine with pWholeLine true and its default pClip
! matches a line whose CLIPPED length equals the clipped search length and whose bytes are equal -
! which is exactly Clarion's `=` on two strings, trailing spaces ignored, case kept - and a blank
! search value finds a line that is empty or all spaces, as `getLine(i) = ''` does. `upper()` on
! BOTH sides is the same call with pNocase true. The guards, each a refusal that says which: the
! loop is exactly `loop i = 1 to st.records()` over one IF that compares the line read with `=` and
! does nothing but set the hit and break - on the IF line after THEN, or as a two-line block; the
! search value is a literal, a plain variable or another StringTheory's getValue(), so evaluating it once
! instead of per line changes nothing, and it mentions neither the object nor the index - nor, in
! the position form that searches on after a hit, the variable the hit sets; for the
! position form the line before the loop is `pos = 0`, since inLine answers 0 for no match where the
! loop leaves pos alone; the index is the loop's alone; the object is a StringTheory; the loop is
! not an EXECUTE arm; a frame line's comment stays above the call (14 Sep 2026). The flag form is the same call with or
! without a break, and walking backwards (`loop i = st.records() to 1 by -1`) too; the position form
! without a break, or backwards with one, answers with the LAST match, and is rewritten as a
! BACKWARDS inLine, which StringTheory 3.90 or later provides; when --stversion= names an older
! StringTheory it refuses. A loop over the lines with any other body
! is not a site and is not reported. Two scans on pass 1, as DropValueCopy does.
!===============================================================================================
VitEngine.BuiltinLineSearchToInLine Procedure(StringTheory pLog)
i           long,auto
lsX         long,auto
lsY         long,auto
lsZ         long,auto
lsD         long,auto          ! instring scratch
lsN         long,auto          ! length scratch
lsLoop      long,auto          ! first token of the loop line
lsIf        long,auto          !   of the IF line
lsPast      long,auto          ! first token PAST the loop's END line
lsFrom      long,auto          ! LsFill: first token of the line in hand
lsNext      long,auto          !   and of the next
lsCont      byte               !   1 = it is carried on to the next line by a bar
lsHeadIx    long               ! LsHead input
lsHead      STRING(vs:maxName) !   output
lsTail      STRING(96)
lsSt        STRING(vs:maxName) ! the object, folded
lsStTxt     STRING(vs:maxName) !   and as the author spelled it
lsIx        STRING(vs:maxName) ! the loop index, folded
lsIxDecl    byte               ! LsIndexUse: the line is the index's own declaration
lsHit       STRING(vs:maxName) ! the variable the hit sets, folded
lsHitTxt    STRING(vs:maxName) !   and as written
lsKind      byte               ! 1 = flag (hit = 1), 2 = position (hit = i)
lsNoCase    byte               ! upper() on both sides of the compare
lsBack      byte               ! the loop walks the lines backwards - records() to 1 by -1
lsBreak     byte               ! the hit breaks out of the loop
lsLastMatch byte               ! the loop answers with the LAST match - emit a BACKWARDS inLine
lsBackNeed  EQUATE('3.90')     ! StringTheory 3.90: the first release whose inLine walks BACKWARDS - an older one returns 0 for every backwards call
lsEq        long               ! the lsQ row of the '=' at depth 0 on the IF line
lsThen      long               ! the lsQ row of THEN, 0 in the block form
lsNdlA      long               ! the search value: first and last lsQ row
lsNdlB      long
lsScFirst   long,auto
lsScLast    long,auto
lsScCode    long,auto
lsSc        long,auto
lsWhy       STRING(200)
lsRpt       byte
lsEdited    byte
lsCmtN      long               ! comments kept from the loop (log)
lsDepth     long,auto
lsLoopLn    long,auto          ! the log-facing line of the loop, read BEFORE the edit moves it
lsTxt       StringTheory       ! the one line that replaces the loop
lsInd       StringTheory       ! the loop's indent
lsNdl       StringTheory       ! the search value, as written
lsTU        STRING(vs:maxName) ! LsNeedle: the search variable's declared type
lsRf        BYTE
lsQ         QUEUE,PRE(ls)
tx            STRING(96)
tk            long             ! the row's first token in the real stream
tkE           long             !   and its last (a joined name spans three)
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  lsEdited = 0
  if self.curPass = 1
    lsRpt = 1 ; do LsScan
  end
  lsRpt = 0 ; do LsScan
  return lsEdited

! ---- every loop over an object's lines whose body is one IF on the line read: the guards, then the edit
LsScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    lsLoop = i
    lsFrom = lsLoop ; do LsFill
    do LsLoopShape
    if ~lsSt then cycle.
    do LsScope
    if ~lsScFirst then cycle.
    do LsNames
    lsWhy = ''
    do LsBody            ! sets lsIf, lsPast, lsKind ... or lsWhy; lsIf = 0 = not a site
    if ~lsIf then cycle.
    if ~lsWhy then do LsNeedle.
    if ~lsWhy then do LsHitNeedle.
    if ~lsWhy then do LsParamCheck.
    if ~lsWhy then do LsIndexUse.
    if ~lsWhy then do LsZeroBefore.
    if ~lsWhy then do LsRuns.
    if lsWhy
      if lsRpt
        pLog.append('BUILTIN LineSearchToInLine line ' & self.LogLineOf(lsLoop) & ': REFUSED - ' & clip(lsWhy) & '.<13,10>')
      end
      cycle
    end
    if lsRpt then cycle.
    lsLoopLn = self.LogLineOf(lsLoop)
    do LsEdit
    pLog.append('BUILTIN LineSearchToInLine line ' & lsLoopLn & ': the search of ' & clip(lsStTxt) & '''s lines is one inLine() call' & |
                choose(~lsCmtN, '', ' - its ' & lsCmtN & ' comment(s) stay above it, on lines of their own') & '.<13,10>')
    lsEdited = 1
    exit
  end

! ---- LOOP <ix> = 1 TO <st>.records() - eight rows - or backwards, LOOP <ix> = <st>.records() TO 1 BY -1
LsLoopShape routine
  lsSt = '' ; lsIx = '' ; lsBack = 0
  if records(lsQ) = 10 or records(lsQ) = 11 then do LsLoopBack ; exit.
  if records(lsQ) <> 8 then exit.
  get(lsQ, 1) ; if lsQ.tx <> 'LOOP' then exit.
  get(lsQ, 3) ; if lsQ.tx <> '=' then exit.
  get(lsQ, 4) ; if lsQ.tx <> '1' then exit.
  get(lsQ, 5) ; if lsQ.tx <> 'TO' then exit.
  get(lsQ, 7) ; if lsQ.tx <> '(' then exit.
  get(lsQ, 8) ; if lsQ.tx <> ')' then exit.
  lsHeadIx = 6 ; do LsHead
  get(lsQ, 6)
  lsN = len(clip(lsQ.tx))
  lsD = instring('.', lsQ.tx[1 : lsN], 1, 1)
  if ~lsHead or ~lsD or lsD >= lsN or lsQ.tx[lsD + 1 : lsN] <> 'RECORDS' then exit.
  get(lsQ, 2)
  if ~((lsQ.tx[1] >= 'A' and lsQ.tx[1] <= 'Z') or lsQ.tx[1] = '_') then exit.
  lsIx = lsQ.tx
  lsSt = lsHead

! ---- LOOP <ix> = <st>.records() TO 1 BY -1 - ten rows, or eleven when `-1` arrives as two
LsLoopBack routine
  get(lsQ, 1) ; if lsQ.tx <> 'LOOP' then exit.
  get(lsQ, 3) ; if lsQ.tx <> '=' then exit.
  get(lsQ, 5) ; if lsQ.tx <> '(' then exit.
  get(lsQ, 6) ; if lsQ.tx <> ')' then exit.
  get(lsQ, 7) ; if lsQ.tx <> 'TO' then exit.
  get(lsQ, 8) ; if lsQ.tx <> '1' then exit.
  get(lsQ, 9) ; if lsQ.tx <> 'BY' then exit.
  if records(lsQ) = 10
    get(lsQ, 10) ; if lsQ.tx <> '-1' then exit.
  else
    get(lsQ, 10) ; if lsQ.tx <> '-' then exit.
    get(lsQ, 11) ; if lsQ.tx <> '1' then exit.
  end
  lsHeadIx = 4 ; do LsHead
  get(lsQ, 4)
  lsN = len(clip(lsQ.tx))
  lsD = instring('.', lsQ.tx[1 : lsN], 1, 1)
  if ~lsHead or ~lsD or lsD >= lsN or lsQ.tx[lsD + 1 : lsN] <> 'RECORDS' then exit.
  get(lsQ, 2)
  if ~((lsQ.tx[1] >= 'A' and lsQ.tx[1] <= 'Z') or lsQ.tx[1] = '_') then exit.
  lsIx = lsQ.tx
  lsSt = lsHead
  lsBack = 1

! ---- the body: ONE if on the line read, its hit and break, then the loop's END. Either
!         if <read> = <x> then <hit> ; break.        (one line, then END)
!      or if <read> = <x>  /  <hit>  /  break  /  end  /  end
!      lsIf = 0 says "not a site" (silent); lsWhy says "a site that refuses"
LsBody routine
  lsIf = 0 ; lsPast = 0 ; lsKind = 0 ; lsNoCase = 0 ; lsEq = 0 ; lsThen = 0 ; lsNdlA = 0 ; lsNdlB = 0 ; lsLastMatch = 0
  lsFrom = lsNext ; do LsFill
  get(lsQ, 1)
  if errorcode() or lsQ.tx <> 'IF' then exit.
  lsZ = 0
  loop lsX = 2 to records(lsQ)       ! the '=' and the THEN at depth 0
    get(lsQ, lsX)
    if errorcode() then break.
    if lsQ.tx = '(' then lsZ += 1.
    if lsQ.tx = ')' then lsZ -= 1.
    if lsZ then cycle.
    if lsQ.tx = '=' and ~lsEq then lsEq = lsX.
    if lsQ.tx = 'THEN' then lsThen = lsX ; break.
  end
  if ~lsEq then exit.                ! not an equality test - not a site
  lsIf = lsFrom
  if lsCont then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' carries on onto the next line' ; exit.
  do LsCompare                       ! which side is the line read; the other is the search value
  if lsWhy then exit.
  if lsThen
    ! ---- one line: THEN <hit> = 1|<ix> ; BREAK .
    get(lsQ, lsThen + 2)
    if errorcode() or lsQ.tx <> '=' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not simply set a variable (a count, say, has no one-call answer)' ; exit.
    lsBreak = choose(records(lsQ) = lsThen + 6)
    if ~lsBreak and records(lsQ) <> lsThen + 4 then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does more than set a variable and break' ; exit.
    get(lsQ, lsThen + 1) ; lsHit = lsQ.tx ; lsZ = lsQ.tk ; do LsHitName
    get(lsQ, lsThen + 3) ; do LsHitKind
    if lsWhy then exit.
    if ~lsBreak
      get(lsQ, lsThen + 4) ; if lsQ.tx <> '.' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not end on its own line' ; exit.
    else
      get(lsQ, lsThen + 4) ; if lsQ.tx <> ';' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does more than set a variable and break' ; exit.
      get(lsQ, lsThen + 5) ; if lsQ.tx <> 'BREAK' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not break after the hit - every line is still searched' ; exit.
      get(lsQ, lsThen + 6) ; if lsQ.tx <> '.' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not end on its own line' ; exit.
    end
  else
    ! ---- a block: <hit> = 1|<ix>  /  BREAK  /  END
    lsFrom = lsNext ; do LsFill
    if lsCont then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' carries a line of its block onto the next' ; exit.
    if records(lsQ) <> 3 then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not simply set a variable on its first line' ; exit.
    get(lsQ, 1) ; lsHit = lsQ.tx ; lsZ = lsQ.tk ; do LsHitName
    get(lsQ, 2) ; if lsQ.tx <> '=' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not simply set a variable on its first line' ; exit.
    get(lsQ, 3) ; do LsHitKind
    if lsWhy then exit.
    lsFrom = lsNext ; do LsFill
    get(lsQ, 1)
    lsBreak = choose(~errorcode() and records(lsQ) = 1 and lsQ.tx = 'BREAK')
    if ~lsBreak and (errorcode() or records(lsQ) <> 1 or lsQ.tx <> 'END') then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does more than set a variable' ; exit.
    if lsBreak
      lsFrom = lsNext ; do LsFill
      get(lsQ, 1)
      if errorcode() or records(lsQ) <> 1 or lsQ.tx <> 'END' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does more than set a variable and break' ; exit.
    end
  end
  lsFrom = lsNext ; do LsFill
  get(lsQ, 1)                        ! the loop's own END
  if errorcode() or records(lsQ) <> 1 or lsQ.tx <> 'END'
    lsWhy = 'the loop on line ' & self.LogLineOf(lsLoop) & ' holds more than the one IF: line ' & self.LogLineOf(lsFrom)
    exit
  end
  lsPast = lsNext
  if ~((lsHit[1] >= 'A' and lsHit[1] <= 'Z') or lsHit[1] = '_') then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not simply set a variable' ; exit.
  if lsHit = lsIx then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' sets the loop index itself' ; exit.
  if lsHit = lsSt then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' assigns to the object' ; exit.
  ! the position form forward without a break, or backwards with one, answers with the last match
  if lsKind = 2 and lsBack = lsBreak
    ! --stversion= not given: 3.90 or later is assumed
    if ~self.rl.stVersion or self.rl.stVersion >= lsBackNeed
      lsLastMatch = 1                ! emit a backwards inLine
    else
      lsWhy = 'the loop on line ' & self.LogLineOf(lsLoop) & ' answers with the LAST matching line, and --stversion= says StringTheory ' & |
              clip(self.rl.stVersion) & ', whose inLine does not walk backwards - 3.90 or later is needed'
    end
  end

! ---- the hit variable as the author spelled it, from its token at lsZ
LsHitName routine
  lsHitTxt = lsHit
  get(self.tk.tokens, lsZ)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then lsHitTxt = self.tk.tokens.tok.

! ---- the lsQ row in hand is what the hit assigns: 1 (a flag) or the index (a position)
LsHitKind routine
  if lsQ.tx = '1'
    lsKind = 1
  elsif lsQ.tx = lsIx
    lsKind = 2
  else
    lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' sets ' & lower(clip(lsHit)) & ' to something other than 1 or the index'
  end

! ---- the compare on the IF line: rows 2 .. lsEq-1 and lsEq+1 .. (lsThen-1 | end). One side is
!      <st>.getLine(<ix>) (4 rows) or upper( <st>.getLine(<ix>) ) (7 rows); the other side is the
!      search value, wrapped in upper( ) when the read is
LsCompare routine
  lsY = choose(~lsThen, records(lsQ), lsThen - 1) ! last row of the compare
  do LsReadAt                                     ! is the LEFT side the line read?  lsZ = rows it took, 0 = no
  if lsZ
    if 2 + lsZ - 1 <> lsEq - 1 then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' compares more than the line read' ; exit.
    lsNdlA = lsEq + 1 ; lsNdlB = lsY
  else
    lsNdlA = 2 ; lsNdlB = lsEq - 1
    lsX = lsEq + 1 ; do LsReadFrom                ! the RIGHT side, then
    if ~lsZ or lsEq + lsZ <> lsY
      lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' does not compare ' & clip(lsStTxt) & '.getLine(' & lower(clip(lsIx)) & ') with a value'
      exit
    end
  end
  if lsNdlB < lsNdlA then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' compares the line read with nothing' ; exit.
  if lsNoCase                                     ! upper( <value> ) - both sides, or neither
    get(lsQ, lsNdlA) ; if lsQ.tx <> 'UPPER' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' uppers the line read but not the value it compares with' ; exit.
    get(lsQ, lsNdlA + 1) ; if lsQ.tx <> '(' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' uppers the line read but not the value it compares with' ; exit.
    get(lsQ, lsNdlB) ; if lsQ.tx <> ')' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' uppers the line read but not the value it compares with' ; exit.
    lsNdlA += 2 ; lsNdlB -= 1
    if lsNdlB < lsNdlA then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' compares the line read with nothing' ; exit.
  else
    get(lsQ, lsNdlA)
    if lsQ.tx = 'UPPER' then lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' uppers the value but not the line read' ; exit.
  end

! ---- LsReadAt: the line read starting at lsQ row 2; LsReadFrom: at row lsX. lsZ = rows used, 0 = not it
LsReadAt routine
  lsX = 2
  do LsReadFrom

LsReadFrom routine
  lsZ = 0
  lsNoCase = 0
  get(lsQ, lsX)
  if errorcode() then exit.
  if lsQ.tx = 'UPPER'
    get(lsQ, lsX + 1)
    if errorcode() or lsQ.tx <> '(' then exit.
    lsNoCase = 1
    lsX += 2
  end
  get(lsQ, lsX)
  if errorcode() then exit.
  lsHeadIx = lsX ; do LsHead
  get(lsQ, lsX)
  lsN = len(clip(lsQ.tx))
  lsD = instring('.', lsQ.tx[1 : lsN], 1, 1)
  if lsHead <> lsSt or ~lsD or lsD >= lsN or lsQ.tx[lsD + 1 : lsN] <> 'GETLINE' then exit.
  get(lsQ, lsX + 1) ; if errorcode() or lsQ.tx <> '(' then exit.
  get(lsQ, lsX + 2) ; if errorcode() or lsQ.tx <> lsIx then exit.
  get(lsQ, lsX + 3) ; if errorcode() or lsQ.tx <> ')' then exit.
  lsZ = 4
  if lsNoCase
    get(lsQ, lsX + 4) ; if errorcode() or lsQ.tx <> ')' then lsZ = 0 ; exit.
    lsZ = 7
  end

! ---- the search value: a literal, a plain name, or <obj>.getValue() - nothing evaluated per line
!      that could differ evaluated once; and it mentions neither the object nor the index. The
!      object of a getValue() must be a StringTheory: one of the author's own class may answer
!      differently at every call
LsNeedle routine
  lsN = lsNdlB - lsNdlA + 1
  lsFrom = lsIf ; do LsFill               ! LsBody has read the lines after the IF
  get(lsQ, lsNdlA)
  if lsN = 1
    if lsQ.tx[1] = '''' then exit.        ! a literal
    case lsQ.tx[1]
    of 'A' to 'Z' orof '_'
      if lsQ.tx = lsSt or lsQ.tx = lsIx
        lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is the object or the index itself'
      elsif pLog.findByte(46, 1,, lsQ.tx) ! <dot>
        lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is a member, and whether reading it once is the same as reading it per line cannot be told'
      elsif self.syms &= NULL or ~self.syms.Lookup(lsQ.tx, lsQ.tk, lsTU, lsRf)
        lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is not a declared variable - a name nothing declares may be a call, which the loop runs once per line'
      elsif upper(lsTU) <> 'STRING' and upper(lsTU) <> 'CSTRING' and upper(lsTU) <> 'PSTRING'
        lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is a ' & clip(lsTU) & ' - a line compared with a number compares NUMERICALLY, and inLine() compares text'
      end
      exit
    end
    lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is not a literal, a variable or a getValue()'
    exit
  end
  if lsN = 3
    lsHeadIx = lsNdlA ; do LsHead
    get(lsQ, lsNdlA)
    lsY = len(clip(lsQ.tx))
    lsD = instring('.', lsQ.tx[1 : lsY], 1, 1)
    if lsHead and self.HayType(lsHead, lsQ.tk) <> 'STRINGTHEORY' then lsHead = ''.
    if lsHead and lsHead <> lsSt and lsD and lsD < lsY and lsQ.tx[lsD + 1 : lsY] = 'GETVALUE'
      get(lsQ, lsNdlA + 1)
      if lsQ.tx = '('
        get(lsQ, lsNdlA + 2)
        if lsQ.tx = ')' then exit.
      end
    end
  end
  lsWhy = 'the value compared on line ' & self.LogLineOf(lsIf) & ' is not a literal, a variable or a getValue() - evaluated once instead of per line it might differ'

! ---- the position form that searches on after a hit - forward with no break, or backwards with
!      none - must not set the very variable it searches for: the loop then compares each later
!      line with the new value, where one inLine() call compares every line with the first
LsHitNeedle routine
  if lsKind <> 2 or lsBreak or lsNdlA <> lsNdlB then exit.
  lsFrom = lsIf ; do LsFill
  get(lsQ, lsNdlA)
  if errorcode() or lsQ.tx <> lsHit then exit.
  lsWhy = 'the IF on line ' & self.LogLineOf(lsIf) & ' sets ' & clip(lsHitTxt) & ', the value it searches for, and goes on - each later line is compared with the new value'

! ---- the procedure and the end of its header
LsScope routine
  lsScFirst = 0 ; lsScLast = 0 ; lsScCode = 0
  lsSc = self.syms.ScopeContaining(lsLoop, vs:scProc, vs:scMethod)
  if ~lsSc then exit.
  self.syms.scopes.scopeId = lsSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  lsScFirst = self.syms.scopes.startTok
  lsScLast  = self.syms.scopes.endTok
  lsZ = 0
  loop lsX = lsScFirst to records(self.tk.tokens)
    get(self.tk.tokens, lsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      lsZ += 1
    elsif self.tk.tokens.tok = ')'
      lsZ -= 1
      if ~lsZ then lsScCode = lsX ; break.
    elsif ~lsZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      lsScCode = lsX ; break
    end
  end
  if ~lsScCode then lsScCode = lsScFirst.

! ---- the object is a StringTheory of this procedure (local or parameter - nothing is written);
!      the index is a local of the procedure, or of the ROUTINE the loop is in when it has DATA of its
!      own, and not declared OVER another variable, which the loop would set too
LsParamCheck routine
  data
rsc  long,auto
  code
  rsc = self.syms.ScopeContaining(lsLoop, vs:scRoutine, vs:scRoutine) ! a ROUTINE's own DATA first: its names hide the procedure's
  lsZ = 0
  if rsc then lsZ = self.syms.FindSym(lsSt, rsc).
  if ~lsZ then lsZ = self.syms.FindOwn(lsSt, lsSc).
  if ~lsZ then lsWhy = clip(lsStTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, lsZ)
  if errorcode() then lsWhy = clip(lsStTxt) & ' is not declared in this procedure' ; exit.
  if self.syms.syms.typeU <> 'STRINGTHEORY' then lsWhy = clip(lsStTxt) & ' is not a StringTheory' ; exit.
  lsZ = 0
  if rsc then lsZ = self.syms.FindSym(lsIx, rsc).
  if ~lsZ then lsZ = self.syms.FindOwn(lsIx, lsSc).
  if ~lsZ then lsWhy = lower(clip(lsIx)) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, lsZ)
  if errorcode() or (self.syms.syms.declTok > lsScFirst and self.syms.syms.declTok <= lsScCode)
    lsWhy = lower(clip(lsIx)) & ' is a PARAMETER, and the loop is what sets it'
  elsif band(self.DeclAttrBits(self.syms.syms.declTok), ab:over)
    lsWhy = lower(clip(lsIx)) & ' is declared OVER another variable, which the loop sets as well'
  elsif self.NameShared(lsLoop, lsIx)
    lsWhy = lower(clip(lsIx)) & ' has a second name - a field of a structure, an OVER or a reference - that can read what the loop left in it'
  end

! ---- the index is the loop's alone: the original leaves it at the count plus one, or at the hit. Not
!      even a method of a class the procedure declares names it: such a method shares the procedure's
!      data, and its body lies outside the walk below. Nor may the procedure INCLUDE a file: the
!      included code is not in this file, and it may read the index
LsIndexUse routine
  if self.MayHaveLocalMethods(lsSc) and self.UsedInLocalMethods(upper(lsIx), lsScFirst, lsScLast)
    lsWhy = lower(clip(lsIx)) & ' is used in a method of a class this procedure declares, which can read it after the loop'
    exit
  end
  if self.ScopeIncludes(lsSc)
    lsWhy = lower(clip(lsIx)) & ' may be read by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  lsFrom = lsScFirst
  loop while lsFrom > 0 and lsFrom < lsScLast
    do LsFill
    lsIxDecl = 0                                                       ! the index's OWN declaration is skipped, and nothing
    if self.syms.IsColOneLabel(lsFrom)                                 !   else in column 1: a labelled statement that reads it,
      get(lsQ, 1)                                                      !   or `x LONG,OVER(i)`, is a use
      if ~errorcode() and lsQ.tx = lsIx then lsIxDecl = 1.
    end
    if lsFrom = lsLoop or lsFrom = lsIf or lsIxDecl
      lsFrom = lsNext ; cycle                                          ! the loop's own mentions, and its declaration
    end
    if lsFrom > lsIf and lsFrom < lsPast then lsFrom = lsNext ; cycle. ! the hit line of the block form
    loop lsX = 1 to records(lsQ)
      lsHeadIx = lsX ; do LsHead
      get(lsQ, lsX)
      if errorcode() then break.
      if lsHead = lsIx or lsQ.tx = lsIx
        lsWhy = lower(clip(lsIx)) & ' is used on line ' & self.LogLineOf(lsFrom) & ' outside the loop, which leaves it at the count plus one'
        exit
      end
    end
    lsFrom = lsNext
  end

! ---- the position form needs `<hit> = 0` on the line before the loop: inLine answers 0 for no
!      match where the loop leaves the variable alone
LsZeroBefore routine
  if lsKind <> 2 then exit.
  lsY = 0
  loop lsX = lsLoop - 1 to lsScCode + 1 by -1 ! the previous line's first token
    get(self.tk.tokens, lsX)
    if errorcode() then break.
    if self.tk.tokens.firstOnLine then lsY = lsX ; break.
  end
  if lsY
    lsFrom = lsY ; do LsFill
    if records(lsQ) = 3
      get(lsQ, 1)
      if lsQ.tx = lsHit
        get(lsQ, 2)
        if lsQ.tx = '='
          get(lsQ, 3)
          if lsQ.tx = '0'
            if ~self.InCondBlock(lsY) then exit.
            lsWhy = lower(clip(lsHitTxt)) & ' is set to 0 on line ' & self.LogLineOf(lsY) & ' inside a COMPILE or OMIT block, which some build leaves out'
            exit
          end
        end
      end
    end
  end
  lsWhy = lower(clip(lsHitTxt)) & ' is not set to 0 on the line before the loop - inLine answers 0 for no match, where the loop leaves it alone'

! ---- the loop is not one arm of an EXECUTE
LsRuns routine
  lsDepth = 0
  loop lsX = lsLoop - 1 to lsScCode + 1 by -1
    get(self.tk.tokens, lsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      lsDepth += 1
    of '+'
      if lsDepth
        lsDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          lsWhy = 'the loop is one arm of the EXECUTE on line ' & self.LogLineOf(lsX)
        end
        break
      end
    end
  end

! ---- every line of the loop goes, so none may carry a comment
! ---- THE EDIT: one line at the loop's indent, the loop deleted whole (delete first: the loop
!      is what is deleted, and the insertion goes where its first token was)
LsEdit routine
  lsInd.free()
  get(self.tk.tokens, lsLoop)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    lsY = 0
    loop lsX = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[lsX] = '<10>' then lsY = lsX.
    end
    if lsY < size(self.tk.tokens.strBefore)
      lsInd.setValue(self.tk.tokens.strBefore[lsY + 1 : size(self.tk.tokens.strBefore)])
    end
  end
  lsFrom = lsIf ; do LsFill       ! the search value as written, from its tokens
  get(lsQ, lsNdlA) ; lsX = lsQ.tk
  get(lsQ, lsNdlB) ; lsY = lsQ.tkE
  self.IsuSpanText(lsX, lsY, lsNdl)
  lsTxt.setValue(lsInd)
  if lsKind = 1
    lsTxt.append('if ')
  else
    lsTxt.append(clip(lsHitTxt))
    lsTxt.append(' = ')
  end
  lsTxt.append(clip(lsStTxt))
  lsTxt.append('.inLine(')
  lsTxt.append(lsNdl)
  if lsLastMatch                  ! backwards from the end: the first hit is the LAST matching line
    lsTxt.append(', -1, ')
    lsTxt.append(clip(lsStTxt))
    lsTxt.append('.records(), 1')
    if lsNoCase
      lsTxt.append(', true, true)')
    else
      lsTxt.append(',, true)')
    end
  elsif lsNoCase
    lsTxt.append(',,,,true,true)')
  else
    lsTxt.append(',,,,,true)')
  end
  if lsKind = 1
    lsTxt.append(' then ')
    lsTxt.append(clip(lsHitTxt))
    lsTxt.append(' = 1.')
  end
  lsTxt.append('<13,10>')
  self.TxaMarkLines(lsTxt, self.TxaShiftOf(lsLoop))
  ! the loop goes; its comments stay above the call (one EOL token per comment line kept)
  lsCmtN = self.DropLinesKeepCmts(lsLoop, lsPast - 1)
  self.InsertLinesAbove(lsLoop + lsCmtN, lsTxt)
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- the names as the author spelled them: the object from the loop line, the hit from its line
LsNames routine
  lsStTxt = lsSt ; lsHitTxt = ''
  loop lsX = lsLoop to records(self.tk.tokens)
    get(self.tk.tokens, lsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    lsN = len(clip(self.tk.tokens.tok))
    if ~lsN then cycle.
    lsD = instring('.', self.tk.tokens.tok[1 : lsN], 1, 1)
    if lsD > 1
      if upper(self.tk.tokens.tok[1 : lsD - 1]) = lsSt then lsStTxt = self.tk.tokens.tok[1 : lsD - 1].
    elsif ~lsD
      if upper(self.tk.tokens.tok[1 : lsN]) = lsSt then lsStTxt = self.tk.tokens.tok[1 : lsN].
    end
  end

! ---- the tokens of ONE physical line, uppercased, into lsQ with their positions; the split
!      dotted spelling joined
LsFill routine
  free(lsQ)
  lsNext = 0
  lsCont = 0
  loop lsX = lsFrom to records(self.tk.tokens)
    get(self.tk.tokens, lsX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      lsNext = lsX + 1 ; break
    end
    if lsX > lsFrom and self.tk.tokens.firstOnLine
      lsNext = lsX ; lsCont = 1 ; break
    end
    lsQ.tx = upper(self.tk.tokens.tok)
    lsQ.tk = lsX
    lsQ.tkE = lsX
    add(lsQ)
  end
  if ~lsNext then lsNext = records(self.tk.tokens) + 1.
  do LsJoin

! ---- a method CALL arrives as three tokens; a '.' between two names becomes one row that spans them
LsJoin routine
  lsX = 2
  loop while lsX < records(lsQ)
    get(lsQ, lsX)
    if errorcode() then break.
    if lsQ.tx <> '.' then lsX += 1 ; cycle.
    get(lsQ, lsX - 1)
    if errorcode() or ~((lsQ.tx[1] >= 'A' and lsQ.tx[1] <= 'Z') or lsQ.tx[1] = '_') then lsX += 1 ; cycle.
    lsHead = lsQ.tx
    get(lsQ, lsX + 1)
    if errorcode() or ~((lsQ.tx[1] >= 'A' and lsQ.tx[1] <= 'Z') or lsQ.tx[1] = '_') then lsX += 1 ; cycle.
    lsTail = lsQ.tx
    lsZ = lsQ.tkE
    delete(lsQ)
    get(lsQ, lsX)
    delete(lsQ)
    get(lsQ, lsX - 1)
    lsQ.tx = clip(lsHead) & '.' & lsTail
    lsQ.tkE = lsZ
    put(lsQ)
  end

! ---- lsHead = the RECEIVER in front of the lsQ row at lsHeadIx
LsHead routine
  lsHead = ''
  get(lsQ, lsHeadIx)
  if errorcode() then exit.
  lsN = len(clip(lsQ.tx))
  if ~lsN then exit.
  lsD = instring('.', lsQ.tx[1 : lsN], 1, 1)
  if lsD > 1 then lsHead = lsQ.tx[1 : lsD - 1].

!===============================================================================================
! BUILTIN FirstAddIsSet - a `+=` that is a zero-initialised local's FIRST write is an `=`, and the
! local can be AUTO:
!     n  long                         n  long,auto
!       code                    ->      code
!       n += st.count('x')              n = st.count('x')
! A Clarion local without AUTO starts at zero, so `0 + e` is `e` - provided the `+=` runs exactly
! once, on every path, before anything reads the local, and nothing else has written it. The
! guards, each a refusal that says which: the local is this procedure's own, numeric, declared
! without attributes; nothing mentions it before the `+=` (a read would have seen the zero, a write
! makes this not the first); no DO lies before it (the routine may read the local) and no GOTO (it
! may jump over the line); the `+=` sits at the top level of the code - inside no IF, CASE, EXECUTE,
! LOOP or ACCEPT, so it runs on every path and runs once; a BEGIN block always runs and does not
! refuse - in no routine, and no column-1 label lies between CODE and it. `n = n + e` is the same
! shape when e is one term or arithmetic: `n = n + a & b` is (n + a) & b, and refuses. The `+=`
! form is two in-place token edits and nothing moves; the long form deletes the
! `n +` tokens, so later token positions shift. Two scans on pass 1, as DropValueCopy does.
!===============================================================================================
VitEngine.BuiltinFirstAddIsSet Procedure(StringTheory pLog)
i           long,auto
faX         long,auto
faZ         long,auto
faN         long,auto          ! length scratch
faLine1     long,auto          ! first token of the += line
faOpTok     long,auto          ! the += token, or the = of the long form
faSelfTok   long,auto          ! long form: the `n` after the =, then its '+'
faFrom      long,auto          ! FaFill: first token of the line in hand
faNext      long,auto          !   and of the next
faVar       STRING(vs:maxName) ! the local, folded
faVarTxt    STRING(vs:maxName) !   and as written
faScFirst   long,auto
faScLast    long,auto
faScCode    long,auto
faSc        long,auto
faDecl      long               ! the declaration token
faTypeTok   long               !   and its type token, which gains ,auto
faWhy       STRING(200)
faRpt       byte
faEdited    byte
faDepth     long,auto
faNums      EQUATE(' LONG SHORT BYTE USHORT ULONG REAL SREAL DECIMAL PDECIMAL BFLOAT4 BFLOAT8 ')
faQ         QUEUE,PRE(fa)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  faEdited = 0
  if self.curPass = 1
    faRpt = 1 ; do FaScan
  end
  faRpt = 0 ; do FaScan
  return faEdited

! ---- every `<v> += <e>` or `<v> = <v> + <e>` line: the guards, then the edit
FaScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine or (i > 1 and ~self.IsEolTok(i - 1)) then cycle.
    faLine1 = i
    faFrom = faLine1 ; do FaFill
    do FaShape
    if ~faVar then cycle.
    do FaScope
    if ~faScFirst then cycle.
    faWhy = ''
    do FaDecl
    if ~faWhy and ~faDecl then cycle. ! ,auto already: nothing to do, and nothing to say - but a refusal is said
    if ~faWhy then do FaRest.
    if ~faWhy then do FaOnce.
    if ~faWhy then do FaBefore.
    if faWhy
      if faRpt
        pLog.append('BUILTIN FirstAddIsSet line ' & self.LogLineOf(faLine1) & ': REFUSED - ' & clip(faWhy) & '.<13,10>')
      end
      cycle
    end
    if faRpt then cycle.
    do FaEdit
    pLog.append('BUILTIN FirstAddIsSet line ' & self.LogLineOf(faLine1) & ': ' & clip(faVarTxt) & ' starts at zero and this is its first write, so it is an assignment and the local is AUTO.<13,10>')
    faEdited = 1
    exit
  end

! ---- <v> += <e>  (rows: V, +=, ...)  or  <v> = <v> + <e>  (rows: V, =, V, +, ...), <e> not empty
FaShape routine
  faVar = '' ; faOpTok = 0 ; faSelfTok = 0
  if records(faQ) < 3 then exit.
  get(faQ, 1)
  case faQ.tx[1]
  of 'A' to 'Z' orof '_'
  else
    exit
  end
  if pLog.findByte(46, 1,, faQ.tx) then exit. ! a member is not a local  ! <dot>
  faVar = faQ.tx
  ! the name as written, for the messages
  get(self.tk.tokens, faQ.tk)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then faVarTxt = self.tk.tokens.tok.
  get(faQ, 2)
  if faQ.tx = '+='
    faOpTok = faQ.tk
    exit
  end
  if faQ.tx <> '=' or records(faQ) < 5 then faVar = '' ; exit.
  faOpTok = faQ.tk
  get(faQ, 3)
  if faQ.tx <> faVar then faVar = '' ; exit.
  faSelfTok = faQ.tk
  get(faQ, 4)
  if faQ.tx <> '+' then faVar = '' ; exit.

! ---- the long form `n = n + <rest>` stores the same once `n +` goes only when the rest binds at least as
!      tightly as the +: one term, or arithmetic. An & at the top level of the rest joins it to the sum, not
!      to what follows: `n = n + a & b` is (n + a) & b, which with n at zero joins a's number to b, where
!      `n = a & b` joins a's text. So an operator in the rest that binds looser than + refuses. The rest
!      runs to the end of the statement: the end of its line, or a ';' outside brackets
FaRest routine
  data
d    long,auto
e    long,auto
  code
  if ~faSelfTok then exit.
  d = 0 ; e = 0
  loop faX = faSelfTok + 2 to records(self.tk.tokens)
    get(self.tk.tokens, faX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if self.tk.tokens.tok = '(' or self.tk.tokens.tok = '['
      d += 1
    elsif self.tk.tokens.tok = ')' or self.tk.tokens.tok = ']'
      d -= 1
    elsif self.tk.tokens.tok = ';' and ~d
      break
    end
    e = faX
  end
  if e and self.SpanTopLevel(faSelfTok + 2, e) > 6
    faWhy = clip(faVarTxt) & ' + is joined to what follows it by an operator that binds looser than +, such as &, so dropping ' & |
            clip(faVarTxt) & ' + would change what is stored'
  end

! ---- the local: this procedure's own, numeric, declared bare (no attributes, no ,auto already)
FaDecl routine
  faDecl = 0 ; faTypeTok = 0
  faZ = self.syms.FindSym(faVar, faSc)
  if ~faZ then faWhy = clip(faVarTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, faZ)
  if errorcode() then faWhy = clip(faVarTxt) & ' is not declared in this procedure' ; exit.
  if (self.syms.syms.declTok > faScFirst and self.syms.syms.declTok <= faScCode) then faWhy = clip(faVarTxt) & ' is a PARAMETER - it arrives with a value' ; exit.
  if self.syms.syms.isField then faWhy = clip(faVarTxt) & ' is a field of a structure - a GET or an assignment of the whole structure sets it' ; exit.
  if ~instring(' ' & clip(self.syms.syms.typeU) & ' ', faNums, 1, 1) then faWhy = clip(faVarTxt) & ' is not a plain number' ; exit.
  faDecl = self.syms.syms.declTok
  faFrom = faDecl ; do FaFill ! V, TYPE and nothing else: any attribute refuses
  if records(faQ) <> 2
    get(faQ, 4)
    if ~errorcode() and records(faQ) = 4 and faQ.tx = 'AUTO' then faDecl = 0 ; exit.
    get(faQ, 3)
    if ~errorcode() and faQ.tx = ',' then faWhy = clip(faVarTxt) & ' is declared with attributes, and AUTO is not simply one more' ; exit.
    faWhy = clip(faVarTxt) & '''s declaration is not a plain name and type' ; exit
  end
  get(faQ, 2)
  faTypeTok = faQ.tk
  get(self.tk.tokens, faDecl)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then faVarTxt = self.tk.tokens.tok.

! ---- nothing mentions the local before the += line, its declaration apart; no routine runs before
!      it, since a routine may read the local; and no GOTO lies before it, since it may jump over the line.
!      Nor may a method of a class the procedure declares name it: such a method shares the procedure's
!      data, and a call to it before the line may set the local or read it. Nor may the procedure
!      INCLUDE a file: the included code is not in this file, and it may set the local, read it, or
!      declare another name for it.
FaBefore routine
  if self.MayHaveLocalMethods(faSc) and self.UsedInLocalMethods(upper(faVar), faScFirst, faScLast)
    faWhy = clip(faVarTxt) & ' is used in a method of a class this procedure declares, which may set it or read it before this line'
    exit
  end
  if self.ScopeIncludes(faSc)
    faWhy = clip(faVarTxt) & ' may be set or read by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  faFrom = faScFirst
  loop while faFrom > 0 and faFrom < faLine1
    do FaFill
    if faFrom <> faDecl
      loop faX = 1 to records(faQ)
        get(faQ, faX)
        if errorcode() then break.
        if faQ.tx = faVar
          faWhy = clip(faVarTxt) & ' is used on line ' & self.LogLineOf(faFrom) & ', before this line - a read there saw the zero, a write there made this not the first'
          exit
        end
        if faQ.tx = 'DO'
          faWhy = 'a routine runs on line ' & self.LogLineOf(faFrom) & ', before this line, and it may read ' & faVarTxt
          exit
        end
        if faQ.tx = 'GOTO'
          faWhy = 'a GOTO on line ' & self.LogLineOf(faFrom) & ' lies before this line, which it may jump over'
          exit
        end
      end
    end
    faFrom = faNext
  end
  faFrom = faLine1                                                ! every row of the statement: a | row has
  loop while faFrom > 0 and faFrom <= self.FirstEolAfter(faLine1) !   no EOL of its own
    do FaFill
    loop faX = choose(faFrom = faLine1, 2, 1) to records(faQ)     ! the first row's first token is the += target itself
      get(faQ, faX)
      if errorcode() then break.
      if faQ.tx = faVar and faQ.tk <> faSelfTok
        faWhy = clip(faVarTxt) & ' is read on its own line, where it is still zero - as AUTO it would hold anything'
        exit
      end
    end
    faFrom = faNext
  end

! ---- the += runs once and on every path: at the top level of the code, inside no IF, CASE, EXECUTE,
!      LOOP or ACCEPT (a BEGIN block always runs), in no routine, and no label before it
FaOnce routine
  if self.InCondBlock(faLine1)
    faWhy = 'the line is inside a COMPILE or OMIT block, which a build may leave out'
    exit
  end
  if self.syms.ScopeContaining(faLine1, vs:scRoutine, vs:scRoutine)
    faWhy = 'the line is in a routine, which may run more than once'
    exit
  end
  faDepth = 0
  loop faX = faLine1 - 1 to faScCode + 1 by -1
    get(self.tk.tokens, faX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.firstOnLine and upper(self.tk.tokens.tok) = 'CODE' then break. ! the data section: declarations, not labels
    if self.syms.IsColOneLabel(faX)
      faWhy = 'a label on line ' & self.LogLineOf(faX) & ' lies before it - the line can be reached again'
      exit
    end
    if self.tk.tokens.level = '-' or (self.tk.tokens.type = vt:end and self.tk.tokens.level <> '+' and self.tk.tokens.level <> '/')
      faDepth += 1                                                                   ! a block closed above us - an inline '.' terminator is retyped vt:end and may carry no '-'
    elsif self.tk.tokens.level = '+'
      if faDepth
        faDepth -= 1
      else
        faN = len(clip(self.tk.tokens.tok))
        if ~faN then cycle.
        case upper(self.tk.tokens.tok[1 : faN])
        of 'LOOP'  orof 'ACCEPT'
          faWhy = 'the line is inside the loop on line ' & self.LogLineOf(faX) & ', so it may run more than once'
          exit
        of 'BEGIN'
        else
          faWhy = 'the line is inside the ' & lower(self.tk.tokens.tok[1 : faN]) & ' on line ' & self.LogLineOf(faX) & ', so it does not run on every path - a read on a path that skips it would find no zero'
          exit
        end
      end
    end
  end

! ---- THE EDIT: += becomes = (the long form drops `n +`), and the type token gains ,auto
FaEdit routine
  if faSelfTok
    faZ = faSelfTok + 1 ! the '+' after the second n
    self.tk.DeleteToks(faSelfTok, faZ)
  else
    self.tk.SetTok(faOpTok, '=')
  end
  get(self.tk.tokens, faTypeTok)
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    self.tk.SetTok(faTypeTok, clip(self.tk.tokens.tok) & ',auto')
  end
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- the procedure and the end of its header
FaScope routine
  faScFirst = 0 ; faScLast = 0 ; faScCode = 0
  faSc = self.syms.ScopeContaining(faLine1, vs:scProc, vs:scMethod)
  if ~faSc then exit.
  self.syms.scopes.scopeId = faSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  faScFirst = self.syms.scopes.startTok
  faScLast  = self.syms.scopes.endTok
  faZ = 0
  loop faX = faScFirst to records(self.tk.tokens)
    get(self.tk.tokens, faX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      faZ += 1
    elsif self.tk.tokens.tok = ')'
      faZ -= 1
      if ~faZ then faScCode = faX ; break.
    elsif ~faZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      faScCode = faX ; break
    end
  end
  if ~faScCode then faScCode = faScFirst.

! ---- the tokens of ONE physical line, uppercased, into faQ with their positions
FaFill routine
  free(faQ)
  faNext = 0
  loop faX = faFrom to records(self.tk.tokens)
    get(self.tk.tokens, faX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      faNext = faX + 1 ; break
    end
    if faX > faFrom and self.tk.tokens.firstOnLine
      faNext = faX ; break
    end
    faQ.tx = upper(self.tk.tokens.tok)
    faQ.tk = faX
    add(faQ)
  end
  if ~faNext then faNext = records(self.tk.tokens) + 1.

!===============================================================================================
! BUILTIN ChangeBeforeSplit - a change made to every line of a split, one line at a time, is one
! change to the whole value, made before the split:
!     st.split('<13,10>')                          st.upper()
!     loop i = 1 to st.records()            ->     st.split('<13,10>')
!       st.setValueFromLine(i)
!       st.upper()
!       st.setLineFromValue(i)              !   or, all on one line:  st.setLine(i, upper(st.getLine(i)))
!     end
! The change lines move to just before the split, at its indent and in their order; the loop's
! five frame lines go; UnusedVars then sweeps the index. It is exact only under these guards, and
! each refusal says which: the change is line-local and position-free - upper(), lower(), or a
! two-argument replace of literals that share no character with the separator (so no match can
! span two lines) and carry no '<' escape; a replace needs a PLAIN split, since clip-then-replace
! and replace-then-clip differ when the replacement ends in a space; a case change needs a split
! whose separator, quote start and quote end are literals with no letter in them, since the split
! compares all three with the text; the loop is exactly `loop i = 1 to st.records()` over load,
! changes, store and END, nothing else; nothing mentions
! the object between the split and the loop; after the loop the original leaves the VALUE as the
! last line - or, for the one-line spelling, as it was - and the rewrite as the whole changed text,
! so every touch of the value afterwards must follow a
! write (setValue, join, free, setValueFromLine) certain to have run - a read, a bare pass or a `do`
! with no such write before it refuses, and a STATIC or THREAD object must have one at every RETURN
! and at the end of the procedure's code; a PARAMETER is refused, since the caller may have given it
! Stream(), and the change writes a value it never held (ruled 29 Oct 2026); nothing reaches the object under another
! name - a reference taken on it, a call that may keep one - and it is not given Stream(); inside a
! loop, the innermost loop around the split sets the object afresh before it, and nothing that runs
! before that write on the next pass - in that loop or in one further out - may touch the value or
! call a routine; a GOTO below the split that jumps back to a label at or above it runs the lines
! from that label again, so they must set the object afresh before the split in the same way; the
! index is the loop's alone; the split is not an EXECUTE arm. A comment on any
! of the four frame lines (the loop, the load, the store, the END) stays where the loop was, as a
! comment line at its indent. A split with no such loop after it is not a site and is not
! reported. Two scans on pass 1, as DropValueCopy does: the editing scan stops at its first edit.
!===============================================================================================
VitEngine.BuiltinChangeBeforeSplit Procedure(StringTheory pLog)
i           long,auto
cbX         long,auto
cbY         long,auto
cbZ         long,auto
cbD         long,auto          ! instring scratch
cbN         long,auto          ! length scratch
cbSplit     long,auto          ! first token of the split line
cbLoop      long,auto          !   of the loop line
cbLoad      long,auto          !   of the setValueFromLine line
cbStore     long,auto          !   of the setLineFromValue line
cbChg1      long,auto          !   of the first change line - the load's next
cbEnd       long,auto          !   of the END line
cbPast      long,auto          ! first token PAST the END's line
cbFrom      long,auto          ! CbFill: first token of the line in hand
cbNext      long,auto          !   and of the next
cbHeadIx    long               ! CbHead input
cbHead      STRING(vs:maxName) !   output
cbTail      STRING(96)
cbSt        STRING(vs:maxName) ! the object, folded
cbStTxt     STRING(vs:maxName) !   and as the author spelled it
cbIx        STRING(vs:maxName) ! the loop index, folded
cbIxDecl    byte               ! CbIndexUse: the line is the index's own declaration
cbScFirst   long,auto
cbScLast    long,auto
cbScCode    long,auto
cbSc        long,auto
cbIsStat    byte               ! the object is STATIC or THREAD, kept for the next call - a value write before the end is then required
cbDp        long               ! CbAfter: the depth, from the level marks
cbDom       long               !   the shallowest write of the value in force, 9999 = none
cbDomJ      byte               !   that write came after a BREAK, CYCLE or GOTO
cbJump      byte               !   a BREAK, CYCLE or GOTO met after the loop
cbSkip      long               !   a branch of a structure around the loop, passed over; 9999 = none
cbArgEnd    long               !   a write's closing bracket - it runs once its arguments are read
cbPlain     byte               ! the split carries only its separator
cbSep       STRING(96)         ! the separator literal, quotes and all
cbQuo1      STRING(96)         !   the quote start and end, when given as literals
cbQuo2      STRING(96)
cbArgOdd    byte               !   2 or 3 = that argument is there and is no literal
cbReplace   byte               ! at least one change is a replace
cbOneLine   byte               ! the body is one line, <st>.setLine(<ix>, upper(<st>.getLine(<ix>)))
cbFn        STRING(16)         !   the wrapping function, UPPER or LOWER
cbWhy       STRING(200)
cbRpt       byte
cbEdited    byte
cbCmtN      long               ! the frame lines' comments kept where the loop was
cbCmts      StringTheory       !   as comment lines at the loop's indent
cbCmt       StringTheory       !   one of them
cbLoopInd   StringTheory       !   the loop's indent
cbOutAt     long               ! CbOuter: the innermost LOOP or ACCEPT around the split
cbOutTop    long               !   and the outermost
cbDep       long               !   and the depth walking up to it
cbDepth     long,auto
cbSplitLn   long,auto          ! the log-facing lines of the split and the loop, read BEFORE the edit moves them
cbLoopLn    long,auto
cbTxt       StringTheory       ! the change lines, rendered at the split's indent
cbInd       StringTheory       ! that indent
cbBlk       StringTheory       ! the OMIT blocks folded in front of the loop's lines - they stay
cbLine      StringTheory       ! one change line's tokens, as written
cbSepB      StringTheory       ! the separator's bytes, its escapes read
cbValWr     EQUATE(' SETVALUE JOIN FREE SETVALUEFROMLINE ')
cbLinesOk   EQUATE(' RECORDS GETLINE INLINE GETLINES SETLINE ADDLINE DELETELINE REMOVELINES SORT ')
cbQ         QUEUE,PRE(cb)
tx            STRING(96)
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  cbEdited = 0
  if self.curPass = 1
    cbRpt = 1 ; do CbScan
  end
  cbRpt = 0 ; do CbScan
  return cbEdited

! ---- every split in the file that a load / change / store loop follows: the guards, then the edit
CbScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    cbSplit = i
    cbFrom = cbSplit ; do CbFill
    do CbSplitShape
    if ~cbSt then cycle.
    do CbScope
    if ~cbScFirst then cycle.
    do CbFindLoop
    if ~cbLoop then cycle. ! a split with no such loop is not a site
    cbWhy = ''
    do CbNames
    do CbBody
    if ~cbWhy then do CbParamCheck.
    if ~cbWhy then do CbOuter.
    if ~cbWhy then do CbOuterRing.
    if ~cbWhy then do CbGotoBack.
    if ~cbWhy then do CbIndexUse.
    if ~cbWhy then do CbAfter.
    if ~cbWhy then do CbRuns.
    if ~cbWhy then do CbFrameCmt.
    if cbWhy
      if cbRpt
        pLog.append('BUILTIN ChangeBeforeSplit line ' & self.LogLineOf(cbSplit) & ': REFUSED - ' & clip(cbWhy) & '.<13,10>')
      end
      cycle
    end
    if cbRpt then cycle.
    cbSplitLn = self.LogLineOf(cbSplit) ; cbLoopLn = self.LogLineOf(cbLoop)
    do CbEdit
    pLog.append('BUILTIN ChangeBeforeSplit line ' & cbSplitLn & ': the change made to every line of ' & clip(cbStTxt) & |
                ' in the loop on line ' & cbLoopLn & ' is made once, to the value, before the split'                  & |
                choose(~cbCmtN, '', ' - the loop''s ' & cbCmtN & ' comment(s) stay where it was, on lines of their own') & '.<13,10>')
    cbEdited = 1
    exit
  end

! ---- <st>.split( <literal> [, options] ) and nothing else on the line
CbSplitShape routine
  cbSt = '' ; cbSep = '' ; cbPlain = 0
  if records(cbQ) < 4 then exit.
  cbHeadIx = 1 ; do CbHead
  get(cbQ, 1)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if ~cbHead or ~cbD or cbD >= cbN or cbQ.tx[cbD + 1 : cbN] <> 'SPLIT' then exit.
  get(cbQ, 2)
  if cbQ.tx <> '(' then exit.
  get(cbQ, 3)
  if cbQ.tx[1] <> '''' then exit.  ! the separator must be a literal - the guard reads it
  cbSep = cbQ.tx
  get(cbQ, records(cbQ))
  if cbQ.tx <> ')' then exit.
  loop cbX = 4 to records(cbQ) - 1 ! the call is the whole statement, or it is not the shape
    get(cbQ, cbX)
    if cbQ.tx = ';' or cbQ.tx = ')' then exit.
  end
  cbPlain = choose(records(cbQ) = 4)
  cbSt = cbHead
  do CbSplitArgs

! ---- the split's arguments after the separator. The quote start and end - the second and third - are
!      compared with the text as the separator is, so each is kept for CbSepCase when it is one literal,
!      and noted when it is anything else; an empty place is no quote. The rest are flags, which a case
!      change cannot alter. Only a comma between the arguments is counted: one inside a subscript or a
!      call can stand only in an argument that is no literal, which is noted at its first row
CbSplitArgs routine
  data
an    long,auto
rows  long,auto
  code
  cbQuo1 = '' ; cbQuo2 = '' ; cbArgOdd = 0
  an = 1 ; rows = 0
  loop cbX = 4 to records(cbQ) - 1
    get(cbQ, cbX)
    if errorcode() then break.
    if cbQ.tx = ',' then an += 1 ; rows = 0 ; cycle.
    rows += 1
    if an <> 2 and an <> 3 then cycle.
    if rows > 1 or cbQ.tx[1] <> '''' then cbArgOdd = an ; exit.
    if an = 2
      cbQuo1 = cbQ.tx
    else
      cbQuo2 = cbQ.tx
    end
  end

! ---- the loop is the first line after the split to mention the object, and nothing with a level
!      mark or a column-1 label lies between (a loop in another block is not this shape)
CbFindLoop routine
  cbLoop = 0
  cbFrom = cbNext
  loop while cbFrom > 0 and cbFrom < cbScLast
    do CbFill
    cbZ = 0
    loop cbX = 1 to records(cbQ)
      cbHeadIx = cbX ; do CbHead
      get(cbQ, cbX)
      if errorcode() then break.
      if cbHead = cbSt or cbQ.tx = cbSt then cbZ = 1 ; break.
    end
    if cbZ
      do CbLoopShape                ! sets cbLoop when this line is the loop
      exit
    end
    loop cbX = cbFrom to cbNext - 1 ! a line that does not mention the object: it may not
      get(self.tk.tokens, cbX)      !   open, close or branch a structure - the LOOP line
      if errorcode() then break.    !   itself carries a '+', so this comes AFTER that test
      if self.tk.tokens.level <> ' ' then exit.
      if not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'DO' then exit.
    end
    if self.syms.IsColOneLabel(cbFrom) then exit.
    cbFrom = cbNext
  end

! ---- the split runs where the code after the loop is walked: not in a routine (the code after its DO is
!      above it), and in an outer loop only when that loop sets the object afresh before the split - its next
!      pass would otherwise split the changed text, where the original split the last line. The loop judged
!      is the INNERMOST around the split, whose pass is the one that comes round to it; a loop further out
!      comes round through its own line and whatever stands before the inner loop, and none of that may
!      touch the value or call a routine either
CbOuter routine
  if self.syms.ScopeContaining(cbSplit, vs:scRoutine, vs:scRoutine)
    cbWhy = 'the split is in a routine, and the code that runs after its DO, which may read the value, is not walked here'
    exit
  end
  cbOutAt = 0 ; cbOutTop = 0 ; cbDep = 0
  loop cbX = cbSplit - 1 to cbScFirst + 1 by -1
    get(self.tk.tokens, cbX)
    if errorcode() then break.
    if self.tk.tokens.level = '-' then cbDep += 1 ; cycle.
    if self.tk.tokens.level <> '+' then cycle.
    if cbDep then cbDep -= 1 ; cycle.
    if not self.tk.tokens.tok &= NULL and (upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT')
      if ~cbOutAt then cbOutAt = cbX.
      cbOutTop = cbX
    end
  end
  if ~cbOutAt then exit.
  cbFrom = cbOutAt ; do CbFill                                                     ! the loop line itself
  do CbOuterLine
  if cbWhy then exit.
  cbFrom = cbNext
  loop while cbFrom > 0 and cbFrom < cbSplit
    do CbFill
    loop cbX = cbFrom to cbNext - 1                                                ! unconditional: nothing opens, closes or branches
      get(self.tk.tokens, cbX)
      if errorcode() then break.
      if self.tk.tokens.level <> ' ' then cbFrom = 0 ; break.
      if upper(self.tk.GetTok(cbX)) = 'DO' then cbFrom = 0 ; break.
    end
    if ~cbFrom then break.
    cbZ = 0
    loop cbX = 1 to records(cbQ)
      cbHeadIx = cbX ; do CbHead
      get(cbQ, cbX)
      if errorcode() then break.
      if cbHead = cbSt or cbQ.tx = cbSt then cbZ = cbX ; break.
    end
    if cbZ
      get(cbQ, cbZ)
      cbN = len(clip(cbQ.tx))
      cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
      if cbHead = cbSt and cbD and cbD < cbN and (cbQ.tx[cbD + 1 : cbN] = 'SETVALUE' or cbQ.tx[cbD + 1 : cbN] = 'LOADFILE') then do CbFreshArgs ; exit.
      break
    end
    cbFrom = cbNext
  end
  cbWhy = 'the split is inside the loop on line ' & self.LogLineOf(cbOutAt) & ', whose next pass would split the changed text, where the original split ' & |
          choose(~cbOneLine, 'the last line', 'the text as it was')

! ---- the loops further out than the innermost, from the outermost one's line down to the inner loop's:
!      on their next pass these lines run before the inner loop sets the object afresh, on the value the
!      last pass left changed. They may count or read the lines, which the rewrite leaves the same, but
!      not touch the value, and not call a routine, which could
CbOuterRing routine
  if ~cbOutAt or cbOutTop >= cbOutAt then exit.
  cbFrom = cbOutTop
  loop while cbFrom > 0 and cbFrom < cbOutAt
    do CbFill
    loop cbX = cbFrom to cbNext - 1
      if upper(self.tk.GetTok(cbX)) <> 'DO' then cycle.
      cbWhy = 'the split is inside the loop on line ' & self.LogLineOf(cbOutTop) & ', and line ' & self.LogLineOf(cbFrom) & |
              ' calls a routine on its next pass before ' & clip(cbStTxt) & ' is set afresh, where the last pass left the value changed'
      exit
    end
    loop cbX = 1 to records(cbQ)
      cbHeadIx = cbX ; do CbHead
      get(cbQ, cbX)
      if errorcode() then break.
      if cbHead <> cbSt and cbQ.tx <> cbSt then cycle.
      if cbHead = cbSt and cbD < cbN and instring(' ' & clip(cbQ.tx[cbD + 1 : cbN]) & ' ', cbLinesOk, 1, 1) then cycle.
      cbWhy = 'the split is inside the loop on line ' & self.LogLineOf(cbOutTop) & ', and line ' & self.LogLineOf(cbFrom) & |
              ' touches ' & clip(cbStTxt) & ' on its next pass before the loop on line ' & self.LogLineOf(cbOutAt)        & |
              ' sets it afresh, where the last pass left the value changed'
      exit
    end
    cbFrom = cbNext
  end

! ---- a GOTO below the split that jumps back to a label at or above it (GotoBackTop) is the back edge of a
!      loop spelled another way: the lines from that label run again, on the value the loop left - the last
!      line, or the text as it was for the one-line spelling - where the rewrite leaves the whole changed
!      text. So, as CbOuter asks of a loop around the split, they must set the object afresh before the
!      split, with nothing before that write that opens, closes or branches a structure, calls a routine
!      or touches the object, and a write that reads it is no fresh one. A column-1 label after the write
!      is another way in, past it, so a write must follow the last label
CbGotoBack routine
  data
top   long,auto
fresh byte,auto
bad   byte,auto
  code
  top = self.GotoBackTop(cbSplit, cbScFirst, cbScLast)
  if ~top then exit.
  fresh = 0 ; bad = 0
  cbFrom = top
  loop while cbFrom > 0 and cbFrom < cbSplit
    do CbFill
    if self.syms.IsColOneLabel(cbFrom) then fresh = 0.
    if ~fresh
      loop cbX = cbFrom to cbNext - 1
        get(self.tk.tokens, cbX)
        if errorcode() then break.
        if self.tk.tokens.level <> ' ' then bad = 1 ; break.
        if upper(self.tk.GetTok(cbX)) = 'DO' then bad = 1 ; break.
      end
      if bad then break.
      cbZ = 0
      loop cbX = 1 to records(cbQ)
        cbHeadIx = cbX ; do CbHead
        get(cbQ, cbX)
        if errorcode() then break.
        if cbHead = cbSt or cbQ.tx = cbSt then cbZ = cbX ; break.
      end
      if cbZ
        get(cbQ, cbZ)
        cbN = len(clip(cbQ.tx))
        cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
        if cbHead <> cbSt or ~cbD or cbD >= cbN then bad = 1 ; break.
        if cbQ.tx[cbD + 1 : cbN] <> 'SETVALUE' and cbQ.tx[cbD + 1 : cbN] <> 'LOADFILE' then bad = 1 ; break.
        loop cbX = cbZ + 1 to records(cbQ)
          cbHeadIx = cbX ; do CbHead
          get(cbQ, cbX)
          if errorcode() then break.
          if cbHead = cbSt or cbQ.tx = cbSt then bad = 1 ; break.
        end
        if bad then break.
        fresh = 1
      end
    end
    cbFrom = cbNext
  end
  if fresh and ~bad then exit.
  cbWhy = 'a GOTO below the split jumps back to line ' & self.LogLineOf(top) & ', and the lines from there do not set ' & clip(cbStTxt) &                             |
          ' afresh before the split - they would run on the whole changed text, where the original left ' & choose(~cbOneLine, 'the last line', 'the text as it was')

! ---- the outer loop's own line runs again before every pass: it may count the lines, which the rewrite
!      leaves the same, but not touch the value, which the last pass left changed
CbOuterLine routine
  loop cbX = 1 to records(cbQ)
    cbHeadIx = cbX ; do CbHead
    get(cbQ, cbX)
    if errorcode() then break.
    if cbHead <> cbSt and cbQ.tx <> cbSt then cycle.
    if cbHead = cbSt and cbD < cbN and instring(' ' & clip(cbQ.tx[cbD + 1 : cbN]) & ' ', cbLinesOk, 1, 1) then cycle.
    cbWhy = 'the split is inside the loop on line ' & self.LogLineOf(cbOutAt) & ', whose own line reads ' & clip(cbStTxt) & ' on every pass, where the last pass left the value changed'
    exit
  end

! ---- the write that sets the object afresh in the outer loop must not read it: its arguments are read
!      first, from the value the last pass left changed
CbFreshArgs routine
  loop cbX = cbZ + 1 to records(cbQ)
    cbHeadIx = cbX ; do CbHead
    get(cbQ, cbX)
    if errorcode() then break.
    if cbHead = cbSt or cbQ.tx = cbSt
      cbWhy = 'the split is inside the loop on line ' & self.LogLineOf(cbOutAt) & ', and line ' & self.LogLineOf(cbFrom) & ' reads ' & clip(cbStTxt) & ' as it sets it afresh, from the value the last pass left changed'
      exit
    end
  end

! ---- LOOP <ix> = 1 TO <st>.records() - eight rows, no more
CbLoopShape routine
  cbIx = ''
  if records(cbQ) <> 8 then exit.
  get(cbQ, 1) ; if cbQ.tx <> 'LOOP' then exit.
  get(cbQ, 3) ; if cbQ.tx <> '=' then exit.
  get(cbQ, 4) ; if cbQ.tx <> '1' then exit.
  get(cbQ, 5) ; if cbQ.tx <> 'TO' then exit.
  get(cbQ, 7) ; if cbQ.tx <> '(' then exit.
  get(cbQ, 8) ; if cbQ.tx <> ')' then exit.
  cbHeadIx = 6 ; do CbHead
  get(cbQ, 6)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbHead <> cbSt or ~cbD or cbD >= cbN or cbQ.tx[cbD + 1 : cbN] <> 'RECORDS' then exit.
  get(cbQ, 2)
  if ~((cbQ.tx[1] >= 'A' and cbQ.tx[1] <= 'Z') or cbQ.tx[1] = '_') then exit.
  cbIx = cbQ.tx
  cbLoop = cbFrom

! ---- the body: the load, one or more change lines, the store, END - and nothing else
CbBody routine
  cbLoad = 0 ; cbStore = 0 ; cbEnd = 0 ; cbPast = 0 ; cbReplace = 0 ; cbOneLine = 0 ; cbFn = ''
  cbFrom = cbLoop ; do CbFill
  cbFrom = cbNext ; do CbFill
  ! st.setLine(i, upper(st.getLine(i))) - the compact spelling, all on one line
  do CbOneLineTry
  if cbWhy then exit.
  if cbOneLine then exit.
  cbTail = 'SETVALUEFROMLINE' ; do CbIndexCall
  if ~cbZ
    cbWhy = 'the loop body does not begin by loading line ' & lower(clip(cbIx)) & ' into ' & clip(cbStTxt) & ' (line ' & self.LogLineOf(cbFrom) & ')'
    exit
  end
  cbLoad = cbFrom
  cbChg1 = cbNext
  loop
    cbFrom = cbNext
    if cbFrom <= 0 or cbFrom >= cbScLast then cbWhy = 'the loop on line ' & self.LogLineOf(cbLoop) & ' never stores the line back' ; exit.
    do CbFill
    cbTail = 'SETLINEFROMVALUE' ; do CbIndexCall
    if cbZ then cbStore = cbFrom ; break.
    do CbChangeLine ! refuses, or notes a replace
    if cbWhy then exit.
  end
  if cbStore = cbChg1 then cbWhy = 'nothing is changed between the load and the store in the loop on line ' & self.LogLineOf(cbLoop) ; exit.
  cbFrom = cbNext ; do CbFill
  get(cbQ, 1)
  if errorcode() or records(cbQ) <> 1 or cbQ.tx <> 'END'
    cbWhy = 'the loop on line ' & self.LogLineOf(cbLoop) & ' does more than load, change and store: line ' & self.LogLineOf(cbFrom)
    exit
  end
  cbEnd = cbFrom
  cbPast = cbNext
  if cbReplace and ~cbPlain
    cbWhy = 'the split on line ' & self.LogLineOf(cbSplit) & ' has options, and a replace before a clipping split is not a replace after it'
  end


! ---- the compact body: <st>.setLine( <ix>, upper|lower( <st>.getLine( <ix> ) ) ) and nothing
!      else - twelve rows once the dotted calls are joined. Sets cbOneLine, or cbWhy when it is
!      that shape wrapped in a function that is not line-by-line, or neither when it is not the shape
CbOneLineTry routine
  if records(cbQ) <> 12 then exit.
  cbHeadIx = 1 ; do CbHead
  get(cbQ, 1)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbHead <> cbSt or ~cbD or cbD >= cbN or cbQ.tx[cbD + 1 : cbN] <> 'SETLINE' then exit.
  get(cbQ, 2) ; if cbQ.tx <> '(' then exit.
  get(cbQ, 3) ; if cbQ.tx <> cbIx then exit.
  get(cbQ, 4) ; if cbQ.tx <> ',' then exit.
  get(cbQ, 6) ; if cbQ.tx <> '(' then exit.
  cbHeadIx = 7 ; do CbHead
  get(cbQ, 7)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbHead <> cbSt or ~cbD or cbD >= cbN or cbQ.tx[cbD + 1 : cbN] <> 'GETLINE' then exit.
  get(cbQ, 8)  ; if cbQ.tx <> '(' then exit.
  get(cbQ, 9)  ; if cbQ.tx <> cbIx then exit.
  get(cbQ, 10) ; if cbQ.tx <> ')' then exit.
  get(cbQ, 11) ; if cbQ.tx <> ')' then exit.
  get(cbQ, 12) ; if cbQ.tx <> ')' then exit.
  get(cbQ, 5)
  case cbQ.tx[1]
  of 'A' to 'Z' orof '_'
  else
    exit                                     ! row 5 is not a function name - not this shape
  end
  if cbQ.tx <> 'UPPER' and cbQ.tx <> 'LOWER'
    cbWhy = clip(cbStTxt) & '.setLine on line ' & self.LogLineOf(cbFrom) & ' wraps the line in ' & lower(clip(cbQ.tx)) & |
            '(), and only upper() and lower() give the same answer per line and per value'
    exit
  end
  cbFn = cbQ.tx
  cbTail = cbFn
  do CbSepCase
  if cbWhy then exit.
  cbLoad = cbFrom ; cbStore = cbFrom         ! the single line is load, change and store
  cbFrom = cbNext ; do CbFill
  get(cbQ, 1)
  if errorcode() or records(cbQ) <> 1 or cbQ.tx <> 'END'
    cbWhy = 'the loop on line ' & self.LogLineOf(cbLoop) & ' does more than the one setLine: line ' & self.LogLineOf(cbFrom)
    exit
  end
  cbEnd = cbFrom ; cbPast = cbNext
  cbOneLine = 1
! ---- cbZ = this line is <st>.<cbTail>( <ix> ) exactly
CbIndexCall routine
  cbZ = 0
  if records(cbQ) <> 4 then exit.
  cbHeadIx = 1 ; do CbHead
  get(cbQ, 1)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbHead <> cbSt or ~cbD or cbD >= cbN or cbQ.tx[cbD + 1 : cbN] <> cbTail then exit.
  get(cbQ, 2) ; if cbQ.tx <> '(' then exit.
  get(cbQ, 3) ; if cbQ.tx <> cbIx then exit.
  get(cbQ, 4) ; if cbQ.tx <> ')' then exit.
  cbZ = 1

! ---- a change line: <st>.upper() | <st>.lower() | <st>.replace('a', 'b') under the literal rules
CbChangeLine routine
  cbHeadIx = 1 ; do CbHead
  get(cbQ, 1)
  cbN = len(clip(cbQ.tx))
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbHead <> cbSt or ~cbD or cbD >= cbN
    cbWhy = 'line ' & self.LogLineOf(cbFrom) & ' in the loop is not a change to ' & cbStTxt
    exit
  end
  cbTail = cbQ.tx[cbD + 1 : cbN]
  get(cbQ, 2)
  if errorcode() or cbQ.tx <> '('
    cbWhy = 'line ' & self.LogLineOf(cbFrom) & ' in the loop is not a call on ' & cbStTxt
    exit
  end
  case cbTail
  of 'UPPER'   orof 'LOWER'
    if records(cbQ) <> 3
      cbWhy = clip(cbStTxt) & '.' & lower(clip(cbTail)) & ' on line ' & self.LogLineOf(cbFrom) & ' takes an argument, and only the bare call is known to be line by line'
    end
    if ~cbWhy then do CbSepCase.
  of 'REPLACE'
    if records(cbQ) <> 6
      cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' is not the two-argument form - a count or an option is not the same per line and per value'
      exit
    end
    get(cbQ, 4)
    if cbQ.tx <> ','
      cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' is not the two-argument form'
      exit
    end
    get(cbQ, 3) ; do CbLiteral
    if cbWhy then exit.
    if len(clip(cbQ.tx)) < 3
      cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' has an empty needle'
      exit
    end
    get(cbQ, 5) ; do CbLiteral
    if cbWhy then exit.
    cbReplace = 1
  else
    cbWhy = clip(cbStTxt) & '.' & lower(clip(cbTail)) & ' on line ' & self.LogLineOf(cbFrom) & ' is not known to give the same answer per line and per value'
  end

! ---- a case change may move before the split only when the separator has NO LETTERS: upper()
!      and lower() change the separator's own letters too, so `split(' and ')` after upper() finds
!      no separator at all - and they can MAKE one, an 'a' becoming the separator 'A'. A byte from 128
!      up counts as a letter: the runtime's case conversion acts on those as well. The quote start and
!      end are compared with the text in the same way, so they are held to the same rule, and one
!      that is not a literal refuses.
CbSepCase routine
  data
k     long,auto
lit   STRING(96),auto
nm    STRING(16),auto
  code
  if cbArgOdd
    cbWhy = 'the quote ' & choose(cbArgOdd = 2, 'start', 'end') & ' of the split on line ' & self.LogLineOf(cbSplit) & ' is not a literal, so whether ' & lower(clip(cbTail)) & '() changes what it matches cannot be told'
    exit
  end
  loop k = 1 to 3
    case k
    of 1 ; lit = cbSep ;  nm = 'separator'
    of 2 ; lit = cbQuo1 ; nm = 'quote start'
    of 3 ; lit = cbQuo2 ; nm = 'quote end'
    end
    if ~lit then cycle.
    if ~self.LitBytes(lit, cbSepB)
      cbWhy = 'the ' & clip(nm) & ' ' & clip(lit) & ' of the split on line ' & self.LogLineOf(cbSplit) & ' cannot be read as bytes, so whether a case change alters it cannot be told'
      exit
    end
    loop cbY = 1 to cbSepB._DataEnd
      case val(cbSepB.valuePtr[cbY])
      of 65 to 90 orof 97 to 122 orof 128 to 255
        cbWhy = 'the ' & clip(nm) & ' ' & clip(lit) & ' of the split on line ' & self.LogLineOf(cbSplit) & ' has a letter in it, which ' & lower(clip(cbTail)) & '() would change once the value is changed whole'
        exit
      end
    end
  end

! ---- the cbQ row in hand is a replace argument: a literal, no '<' escape, sharing no byte with
!      the separator - so nothing it does can reach across a line. The separator is read as the
!      bytes it stands for: '<32>' is a space and '<44>' a comma, written plainly in a literal
CbLiteral routine
  cbN = len(clip(cbQ.tx))
  if cbQ.tx[1] <> ''''
    cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' has an argument that is not a literal, so what it could match cannot be told'
    exit
  end
  if instring('<<', cbQ.tx[1 : cbN], 1, 1)
    cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' has a literal with a <<> escape in it, which could be a line break'
    exit
  end
  if cbN < 3 then exit.                      ! '' - nothing inside to share
  if ~self.LitBytes(cbSep, cbSepB)           ! the separator's bytes, escapes read
    cbWhy = 'the separator ' & clip(cbSep) & ' of the split on line ' & self.LogLineOf(cbSplit) & ' cannot be read as bytes, so what a replace could match across two lines cannot be told'
    exit
  end
  loop cbY = 1 to cbSepB._DataEnd
    if instring(upper(cbSepB.valuePtr[cbY]), cbQ.tx[2 : cbN - 1], 1, 1)
      cbWhy = clip(cbStTxt) & '.replace on line ' & self.LogLineOf(cbFrom) & ' has a literal sharing a character with the separator ' & clip(cbSep) & ', so a match could span two lines'
      exit
    end
  end

! ---- the procedure and the end of its header
CbScope routine
  cbScFirst = 0 ; cbScLast = 0 ; cbScCode = 0
  cbSc = self.syms.ScopeContaining(cbSplit, vs:scProc, vs:scMethod)
  if ~cbSc then exit.
  self.syms.scopes.scopeId = cbSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  cbScFirst = self.syms.scopes.startTok
  cbScLast  = self.syms.scopes.endTok
  cbZ = 0
  loop cbX = cbScFirst to records(self.tk.tokens)
    get(self.tk.tokens, cbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      cbZ += 1
    elsif self.tk.tokens.tok = ')'
      cbZ -= 1
      if ~cbZ then cbScCode = cbX ; break.
    elsif ~cbZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      cbScCode = cbX ; break
    end
  end
  if ~cbScCode then cbScCode = cbScFirst.

! ---- the object is a StringTheory of this procedure, not a reference or a parameter - the caller may
!      have given it Stream() - and a STATIC or THREAD object is noted, whose value the next call starts
!      from; the index is a local,
!      not declared OVER another variable, which the loop would set too
CbParamCheck routine
  cbIsStat = 0
  cbZ = self.syms.FindOwn(cbSt, cbSc)
  if ~cbZ then cbWhy = clip(cbStTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, cbZ)
  if errorcode() then cbWhy = clip(cbStTxt) & ' is not declared in this procedure' ; exit.
  if self.syms.syms.typeU <> 'STRINGTHEORY' then cbWhy = clip(cbStTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then cbWhy = clip(cbStTxt) & ' is a reference - what it points at is not this procedure''s to leave changed' ; exit.
  if (self.syms.syms.declTok > cbScFirst and self.syms.syms.declTok <= cbScCode)
    cbWhy = clip(cbStTxt) & ' is a parameter, and the caller may have given it Stream() - then its file would receive a value it never held'
    exit
  end
  cbY = self.syms.syms.declTok
  if self.DeclHasAttr(cbY, 'STATIC') or self.DeclHasAttr(cbY, 'THREAD') then cbIsStat = 1.
  cbZ = self.syms.FindOwn(cbIx, cbSc)
  if ~cbZ then cbWhy = lower(clip(cbIx)) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, cbZ)
  if errorcode() or (self.syms.syms.declTok > cbScFirst and self.syms.syms.declTok <= cbScCode)
    cbWhy = lower(clip(cbIx)) & ' is a PARAMETER, and the loop is what sets it'
  elsif band(self.DeclAttrBits(self.syms.syms.declTok), ab:over)
    cbWhy = lower(clip(cbIx)) & ' is declared OVER another variable, which the loop sets as well'
  end

! ---- the index is the loop's alone: the original leaves it at the count plus one. Not even a method
!      of a class the procedure declares names it: such a method shares the procedure's data, and its
!      body lies outside the walk below. Nor may the procedure INCLUDE a file: the included code is
!      not in this file, and it may read the index or the object's value
CbIndexUse routine
  if self.MayHaveLocalMethods(cbSc) and self.UsedInLocalMethods(upper(cbIx), cbScFirst, cbScLast)
    cbWhy = lower(clip(cbIx)) & ' is used in a method of a class this procedure declares, which can read it after the loop'
    exit
  end
  if self.ScopeIncludes(cbSc)
    cbWhy = lower(clip(cbIx)) & ' and ' & clip(cbStTxt) & ' may be read by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  cbFrom = cbScFirst
  loop while cbFrom > 0 and cbFrom < cbScLast
    do CbFill
    cbIxDecl = 0                       ! the index's OWN declaration is skipped, and nothing
    if self.syms.IsColOneLabel(cbFrom) !   else in column 1: a labelled statement that reads it,
      get(cbQ, 1)                      !   or `x LONG,OVER(i)`, is a use
      if ~errorcode() and cbQ.tx = cbIx then cbIxDecl = 1.
    end
    if cbFrom = cbLoop or cbFrom = cbLoad or cbFrom = cbStore or cbIxDecl
      cbFrom = cbNext ; cycle          ! the loop's own mentions, and its declaration
    end
    loop cbX = 1 to records(cbQ)
      cbHeadIx = cbX ; do CbHead
      get(cbQ, cbX)
      if errorcode() then break.
      if cbHead = cbIx or cbQ.tx = cbIx
        cbWhy = lower(clip(cbIx)) & ' is used on line ' & self.LogLineOf(cbFrom) & ' outside the loop, which leaves it at the count plus one'
        exit
      end
    end
    cbFrom = cbNext
  end

! ---- after the loop the VALUE differs until it is written again: the last line before, the whole
!      changed text after. So every touch of the value after the loop must come after a write of it
!      (setValue, join, free, setValueFromLine) that is certain to have run - one earlier in the
!      same block or in a block around the touch. A setLength keeps part of the value, so it reads
!      it. The walk keeps a depth from the level marks: a write inside an IF covers nothing after
!      the IF's END, an ELSE or OF puts a write in that block out of force, and a write that is an
!      arm of an EXECUTE covers nothing, the arms being alternatives. A write at the loop's own
!      depth stays in force past the END of a structure around the loop, unless a BREAK, CYCLE or
!      GOTO came before it. Another branch of a structure around the loop - its ELSE, another OF -
!      is not reached from the loop and is passed over. A write runs once its own arguments are
!      read, so `st.setValue(st.getValue() & x)` reads the value first. A `do` with no write in
!      force refuses - the routine could read the value. A PARAMETER, or a STATIC or THREAD object,
!      keeps its value past the procedure: a write must be in force at every RETURN and at the end
!      of the procedure's code. The walk ends at the first ROUTINE: a routine runs when it is DOne,
!      and every `do` after the loop is judged here. A method of a class the procedure declares may
!      read the value too, from outside this walk: the object named in one refuses.
!      So does the object reached under another name - a reference taken on it, a call that may keep
!      one - and its Stream(), whose file receives each value the loop gives it.
CbAfter routine
  if self.MayHaveLocalMethods(cbSc) and self.UsedInLocalMethods(upper(cbSt), cbScFirst, cbScLast)
    cbWhy = clip(cbStTxt) & ' is used in a method of a class this procedure declares, which can read its value after the loop'
    exit
  end
  if ~cbWhy then cbWhy = self.ObjReach(cbSt, cbSplit, 3).
  if cbWhy then exit.
  cbDp = 0 ; cbDom = 9999 ; cbDomJ = 0 ; cbJump = 0 ; cbSkip = 9999 ; cbArgEnd = 0
  loop cbX = cbPast to cbScLast
    get(self.tk.tokens, cbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if cbArgEnd and cbX > cbArgEnd
      if cbDp < cbDom then cbDom = cbDp ; cbDomJ = cbJump.
      cbArgEnd = 0
    end
    cbTail = upper(self.tk.tokens.tok)
    case self.tk.tokens.level
    of '+'
      cbDp += 1
    of '-'
      cbDp -= 1
      if cbDp < cbSkip then cbSkip = 9999.
      if cbDp < cbDom
        if cbDom <= 0 and ~cbDomJ
          cbDom = cbDp
        else
          cbDom = 9999
        end
      end
    of '/'
      if cbSkip = 9999
        if cbDp <= 0
          cbSkip = cbDp
        elsif cbDom >= cbDp
          cbDom = 9999
        end
      end
    end
    if self.tk.tokens.firstOnLine and upper(self.tk.GetTok(cbX + 1)) = 'ROUTINE' then break.
    if cbSkip <> 9999 then cycle.
    case cbTail
    of 'BREAK'  orof 'CYCLE' orof 'GOTO'
      cbJump = 1
      cycle
    of 'RETURN'
      if cbDom > cbDp then do CbKeptRet.
      if cbWhy then exit.
      cycle
    of 'DO'
      if cbDom <= cbDp then cycle.
      cbWhy = 'line ' & self.LogLineOf(cbX) & ' calls a routine after the loop, before ' & clip(cbStTxt) & '''s value is written again - and the routine could read it'
      exit
    end
    cbN = len(clip(cbTail))
    if ~cbN then cycle.
    cbD = instring('.', cbTail[1 : cbN], 1, 1)
    if cbD > 1 and cbD < cbN
      if cbTail[1 : cbD - 1] <> cbSt then cycle.
      cbTail = cbTail[cbD + 1 : cbN]
    elsif ~cbD and cbTail = cbSt
      cbTail = ''
      if self.tk.GetTok(cbX + 1) = '.' then cbTail = upper(self.tk.GetTok(cbX + 2)).
    else
      cycle
    end
    if ~cbTail
      if cbDom <= cbDp then cycle.
      cbWhy = clip(cbStTxt) & ' is handed whole to a call on line ' & self.LogLineOf(cbX) & ' after the loop, before its value is written again'
      exit
    end
    if instring(' ' & clip(cbTail) & ' ', cbValWr, 1, 1)
      do CbArgEnd
      if self.ArmOfExecute(cbX) or self.InCondBlock(cbX) then cbArgEnd = 0.                                           ! a write some builds leave out is not in force
      cycle
    end
    if instring(' ' & clip(cbTail) & ' ', cbLinesOk, 1, 1) then cycle.
    if cbDom <= cbDp then cycle.
    cbWhy = clip(cbStTxt) & '.' & lower(clip(cbTail)) & ' on line ' & self.LogLineOf(cbX) & ' touches the value after the loop, which left it ' & |
            choose(~cbOneLine, 'as the LAST LINE', 'as it was') & ' and would now leave it as the whole changed text'
    exit
  end
  if cbArgEnd and cbDp < cbDom then cbDom = cbDp.
  if cbDom > cbDp then do CbKeptEnd.

! ---- cbArgEnd = the ')' that closes the call named at token cbX, or cbX itself when no bracket follows
CbArgEnd routine
  cbArgEnd = cbX
  cbD = choose(self.tk.GetTok(cbX + 1) = '.', cbX + 3, cbX + 1)
  if self.tk.GetTok(cbD) <> '(' then exit.
  cbZ = 0
  loop cbY = cbD to cbScLast
    get(self.tk.tokens, cbY)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    if self.tk.tokens.tok = '(' then cbZ += 1.
    if self.tk.tokens.tok = ')' then cbZ -= 1.
    if ~cbZ then cbArgEnd = cbY ; break.
  end

! ---- a RETURN at cbX with no write of the value in force: the next call of a STATIC or THREAD
!      object would start from the whole changed text where it saw the last line, or the text as it was
CbKeptRet routine
  if cbIsStat
    cbWhy = clip(cbStTxt) & ' is STATIC or THREAD and its value is never written after the loop before the RETURN on line ' & self.LogLineOf(cbX) & ' - the next call would start from the whole changed text'
  end

! ---- the end of the procedure's code with no write of the value in force: the same for a kept object
CbKeptEnd routine
  if cbIsStat
    cbWhy = clip(cbStTxt) & ' is STATIC or THREAD and its value is never written after the loop, or not on every path to the end of its code - the next call would start from the whole changed text'
  end

! ---- the split is not one arm of an EXECUTE (the loop after it would be another)
CbRuns routine
  cbDepth = 0
  loop cbX = cbSplit - 1 to cbScCode + 1 by -1
    get(self.tk.tokens, cbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      cbDepth += 1
    of '+'
      if cbDepth
        cbDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          cbWhy = 'the split is one arm of the EXECUTE on line ' & self.LogLineOf(cbX) & ', and the loop is another'
        end
        break
      end
    end
  end

! ---- the frame lines' comments - the loop, the load, the store, the END - stay where the loop
!      was, as comment lines at its indent; the change lines carry their own with them
CbFrameCmt routine
  cbCmts.free() ; cbCmtN = 0
  self.IndentOf(cbLoop, cbLoopInd)
  loop cbX = 1 to 4
    case cbX
    of 1 ; cbY = cbLoop
    of 2 ; cbY = cbLoad
    of 3 ; cbY = cbStore
    of 4 ; cbY = cbEnd
    end
    self.MgCmtText(self.FirstEolAfter(cbY), cbCmt)
    if cbCmt._DataEnd
      if cbLoopInd._DataEnd then cbCmts.append(cbLoopInd.valuePtr[1 : cbLoopInd._DataEnd]).
      cbCmts.append(cbCmt)
      cbCmts.append('<13,10>')
      cbCmtN += 1
    end
  end
  self.TxaMarkLines(cbCmts, self.TxaShiftOf(cbLoop))

! ---- THE EDIT: the change lines, as written, at the split's indent, before the split; the loop
!      goes whole. Delete first - the loop is below the split, so the split does not move.
CbEdit routine
  cbInd.free()
  get(self.tk.tokens, cbSplit)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    cbY = 0
    loop cbX = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[cbX] = '<10>' then cbY = cbX.
    end
    if cbY < size(self.tk.tokens.strBefore)
      cbInd.setValue(self.tk.tokens.strBefore[cbY + 1 : size(self.tk.tokens.strBefore)])
    end
  end
  cbTxt.free()
  if cbOneLine                               ! synthesise the one call at the split's indent
    cbTxt.append(cbInd)
    cbTxt.append(clip(cbStTxt) & '.' & lower(clip(cbFn)) & '()<13,10>')
    self.TxaMarkLines(cbTxt, self.TxaShiftOf(cbSplit))
    self.LineBlocks(cbLoop, cbPast - 1, cbBlk)
    self.tk.DeleteToks(cbLoop, cbPast - 1)
    if cbCmtN then self.tk.InsertString(cbLoop, cbCmts).
    if cbBlk._DataEnd then self.tk.PrependStrBefore(cbLoop, cbBlk.getValue()).
    self.InsertLinesAbove(cbSplit, cbTxt)
    if not self.syms &= NULL then self.syms.dirty = 1.
    exit
  end
  cbFrom = cbChg1
  loop while cbFrom > 0 and cbFrom < cbStore
    do CbFill
    cbZ = self.FirstEolAfter(cbFrom)
    if ~cbZ then break.
    self.IsuSpanText(cbFrom, cbZ - 1, cbLine)
    cbTxt.append(cbInd)
    cbTxt.append(cbLine)
    get(self.tk.tokens, cbZ)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      cbTxt.append(self.tk.tokens.strBefore) ! the line's own comment moves with it
    end
    cbTxt.append('<13,10>')
    cbFrom = cbNext
  end
  self.TxaMarkLines(cbTxt, self.TxaShiftOf(cbSplit))
  self.LineBlocks(cbLoop, cbPast - 1, cbBlk)
  self.tk.DeleteToks(cbLoop, cbPast - 1)
  if cbCmtN then self.tk.InsertString(cbLoop, cbCmts).
  if cbBlk._DataEnd then self.tk.PrependStrBefore(cbLoop, cbBlk.getValue()).
  self.InsertLinesAbove(cbSplit, cbTxt)
  if not self.syms &= NULL then self.syms.dirty = 1.

! ---- the name as the author spelled it, from the split line
CbNames routine
  cbStTxt = cbSt
  get(self.tk.tokens, cbSplit)
  if errorcode() or self.tk.tokens.tok &= NULL then exit.
  cbN = len(clip(self.tk.tokens.tok))
  if ~cbN then exit.
  cbD = instring('.', self.tk.tokens.tok[1 : cbN], 1, 1)
  if cbD > 1
    if upper(self.tk.tokens.tok[1 : cbD - 1]) = cbSt then cbStTxt = self.tk.tokens.tok[1 : cbD - 1].
  elsif ~cbD
    if upper(self.tk.tokens.tok[1 : cbN]) = cbSt then cbStTxt = self.tk.tokens.tok[1 : cbN].
  end

! ---- the tokens of ONE physical line, uppercased, into cbQ, the split dotted spelling joined
CbFill routine
  free(cbQ)
  cbNext = 0
  loop cbX = cbFrom to records(self.tk.tokens)
    get(self.tk.tokens, cbX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      cbNext = cbX + 1 ; break
    end
    if cbX > cbFrom and self.tk.tokens.firstOnLine
      cbNext = cbX ; break
    end
    cbQ.tx = upper(self.tk.tokens.tok)
    add(cbQ)
  end
  if ~cbNext then cbNext = records(self.tk.tokens) + 1.
  do CbJoin

! ---- a method CALL arrives as three tokens (the tokenizer joins a dotted name only when no '('
!      follows); a '.' between two names becomes one row, so every routine above sees one spelling
CbJoin routine
  cbX = 2
  loop while cbX < records(cbQ)
    get(cbQ, cbX)
    if errorcode() then break.
    if cbQ.tx <> '.' then cbX += 1 ; cycle.
    get(cbQ, cbX - 1)
    if errorcode() or ~((cbQ.tx[1] >= 'A' and cbQ.tx[1] <= 'Z') or cbQ.tx[1] = '_') then cbX += 1 ; cycle.
    cbHead = cbQ.tx
    get(cbQ, cbX + 1)
    if errorcode() or ~((cbQ.tx[1] >= 'A' and cbQ.tx[1] <= 'Z') or cbQ.tx[1] = '_') then cbX += 1 ; cycle.
    cbTail = cbQ.tx
    delete(cbQ)
    get(cbQ, cbX)
    delete(cbQ)
    get(cbQ, cbX - 1)
    cbQ.tx = clip(cbHead) & '.' & cbTail
    put(cbQ)
  end

! ---- cbHead = the RECEIVER in front of the cbQ row at cbHeadIx
CbHead routine
  cbHead = ''
  get(cbQ, cbHeadIx)
  if errorcode() then exit.
  cbN = len(clip(cbQ.tx))
  if ~cbN then exit.
  cbD = instring('.', cbQ.tx[1 : cbN], 1, 1)
  if cbD > 1 then cbHead = cbQ.tx[1 : cbD - 1].

!===============================================================================================
! BUILTIN DropValueCopy - a scratch object that only ever holds a COPY of another object's value,
! and only reads it, is the other object itself:
!     tmp.setValue(st.getValue())          tmp.setValue(st.getValuePtr())          tmp.setValue(st)
!     if tmp._DataEnd > 3 ...       ->     if st._DataEnd > 3 ...
! The copy line goes and every later use of the scratch reads the source. The same shape as
! DropLineBuffer for a whole value, with the same kind of guard: the scratch may only READ its
! value after the copy - any change to it, any read of its LINES (the copy carried none), any
! call that could change it, or a bare pass to a call refuses, and so does its buffer, or a slice
! of it, handed to a call that may write it - and, for a STRING source, which the rename puts in
! place of a getValue() read, that read handed to a call that may take it by address; the source must not change between
! the copy and the scratch's last read, and no routine may be called in between, since a routine
! shares the locals; the scratch must be a StringTheory local that is not mentioned before the
! copy in its procedure, so no earlier reader is left with a value nothing writes; the copy must
! RUN before every read - no read outside the structure holding the copy, in another branch of
! it, in a different routine, past a label, or with the copy as one arm of an EXECUTE. A comment
! on the copy line (or on the fold line) stays where the line was, on a line of its own.
! UnusedVars then sweeps the declaration.
! Two scans on pass 1, as DropLineBuffer does: the editing scan stops at its first edit.
!===============================================================================================
VitEngine.BuiltinDropValueCopy Procedure(StringTheory pLog)
i           long,auto
dvX         long,auto
dvY         long,auto
dvZ         long,auto
dvD         long,auto                                                           ! instring scratch
dvN         long,auto                                                           ! length scratch
dvSubW      byte                                                                ! a subscript of the source is written, not read
dvAtHead    byte                                                                ! DvStmtHead: the row in hand starts a statement
dvBufOut    byte                                                                ! DvBufOut: the row in hand hands its buffer on - by reference, or to a call that may write or keep it
dvTouchTk   long                                                                ! DvTouchOK: the token of the touch it is asked about
dvLine1     long,auto                                                           ! first token of the copy line
dvEol       long,auto                                                           ! its EOL token
dvFrom      long,auto                                                           ! DvFill: first token of the line in hand
dvNext      long,auto                                                           !   and of the next
dvHeadIx    long                                                                ! DvHead input
dvHead      STRING(vs:maxName)                                                  !   output
dvTail      STRING(96)
dvBuf       STRING(vs:maxName)                                                  ! the scratch, folded
dvSrc       STRING(vs:maxName)                                                  ! the source, folded
dvBufTxt    STRING(vs:maxName)                                                  !   and as the author spelled them
dvSrcTxt    STRING(vs:maxName)
dvScFirst   long,auto                                                           ! the procedure
dvScLast    long,auto
dvScCode    long,auto
dvSc        long,auto
dvParmsU    StringTheory                                                        ! a parameter source: ' NAME ... ' of the procedure's other object parameters
dvLast      long,auto                                                           ! first token of the scratch's last read line
dvWalkEnd   long                                                                ! the source walk's end: dvLast, or the END of a loop around it
dvLoopAt    long                                                                !   the LOOP opened after the copy that holds the last read
dvLoopD     long                                                                !   and the depth it opened at
dvBufDecl   long
dvWhy       STRING(300)
dvCmt       StringTheory                                                        ! the copy line's trailing comment - kept where the line was, on a line of its own (ruled 14 Sep 2026)
dvFoldCmt   StringTheory                                                        !   and the fold line's
dvDelS      long,auto                                                           ! DvDropLine in: the line's first token and its EOL
dvDelE      long,auto
dvDelCmt    StringTheory                                                        !   and the comment to keep, if any
dvIndSt     StringTheory                                                        ! the line's indent, for the kept comment
dvBlk       StringTheory                                                        ! an OMIT block folded in front of the line - it stays
dvRpt       byte                                                                ! the report-only scan
dvLogLn     long,auto                                                           ! the copy line's number, for the log - DvRename reuses dvN
dvEdited    byte
dvDepth     long,auto                                                           ! DvRuns: structure depth, counted from the copy line
dvFold      STRING(5)                                                           ! 'UPPER' or 'LOWER' when the line after the copy folds the scratch's case, else ''
dvFoldLine  long                                                                !   that line's first token
dvFoldEol   long                                                                !   and its EOL
dvFoldReads EQUATE(' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH SLICE SUB ') ! what a case fold can be carried into: a value read, wrapped, or a length, unchanged
dvTouchOK   byte                                                                ! DvTouchOK out: the source touch on line dvFrom lies in an arm body no read of the scratch can follow
dvSrcStr    byte                                                                ! the source is a STRING, CSTRING or PSTRING, not an object: reads of the scratch spell as len() and a subscript
dvSrcFar    byte                                                                ! a call can reach the source without its name: 1 the caller's (a parameter, by address) or a reference's, 2 STATIC or THREAD
dvFarObj    byte                                                                ! DvFarHead out: the object the row in hand names may be the caller's source itself
dvPure      StringTheory                                                        ! ' NAME ... ' - the readers a call to which is no obstacle (IfCasePureList), filled when first asked
dvOwn       StringTheory                                                        !   the names on it this file gives a procedure of its own (PureOwnList), built with it
dvByVal     byte                                                                ! the copy is <src>.getValue() or getValuePtr(): the source's flags stay behind
dvEqAt      long                                                                !   and the first line that reads the scratch with equals(), 0 = none - DvEqFlags judges it
dvDataEnd   long,auto                                                           ! DvEqFlags: the CODE statement
dvArgTU     STRING(vs:maxName)                                                  !   the declared type of a setValue's argument
dvArgRf     byte
dvEqWhy     STRING(160)                                                         !   what may have set the source's encoding, for the report
dvStrReads  EQUATE(' _DATAEND VALUEPTR GETVALUE ')                              ! what a STRING source can stand in for
dvRdQ      QUEUE,PRE(dr)                                                        ! every line that reads the scratch, in order - DvTouchOK asks whether any follows a touch
ln           long
tk           long                                                               ! the token of the line's last read
           END
dvReads     EQUATE(' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH SLICE SUB CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS CLIPLENGTH ') ! reads of the VALUE - the only thing the copy carried
dvSrcOk     EQUATE(                                                             |
  ' _DATAEND VALUEPTR GETVALUE GETVALUEPTR LENGTH SLICE SUB CONTAINSCHAR CONTAINSBYTE FINDBYTE FINDCHAR FINDCHARS INSTRING STARTSWITH ENDSWITH EQUALS CLIPLENGTH RECORDS GETLINE GETLINES INLINE ') ! and what leaves the SOURCE unchanged: those, and reads of its lines
dvQ        QUEUE,PRE(dv)
tx           STRING(96)
tk           long                                                               ! the token this row came from
           END
dvSelfU    STRING(vs:maxName)                                                   ! the scope's class when it is a method, for the summaries
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  self.BuildSummaries()   ! which bodies only READ a parameter - a call to one is no obstacle (ruled 14 Sep 2026)
  dvEdited = 0
  if self.curPass = 1
    dvRpt = 1 ; do DvScan
  end
  dvRpt = 0 ; do DvScan
  return dvEdited

! ---- every line of the file: the shape, the rules, and - unless this is the report-only scan - the edit
DvScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    dvLine1 = i
    dvFrom = dvLine1 ; do DvFill
    do DvShape
    if ~dvBuf then cycle.
    dvWhy = ''
    do DvScope
    if ~dvScFirst then cycle.
    do DvNames
    do DvParamCheck
    if ~dvWhy then do DvUses.
    if ~dvWhy then do DvRuns.
    if dvWhy
      if dvRpt
        pLog.append('BUILTIN DropValueCopy line ' & self.LogLineOf(dvLine1) & ': REFUSED - ' & clip(dvWhy) & '.<13,10>')
      end
      cycle
    end
    if dvRpt then cycle.
    ! ---- THE EDIT: rename every later use of the scratch, then drop the copy line whole
    dvLogLn = self.LogLineOf(dvLine1)
    do DvRename
    dvEol = self.FirstEolAfter(dvLine1)
    if ~dvEol then cycle.
    if dvFoldLine ! the fold line first: it lies below the copy line
      dvDelS = dvFoldLine ; dvDelE = dvFoldEol ; dvDelCmt.setValue(dvFoldCmt) ; do DvDropLine
    end
    dvDelS = dvLine1 ; dvDelE = dvEol ; dvDelCmt.setValue(dvCmt) ; do DvDropLine
    if not self.syms &= NULL then self.syms.dirty = 1.
    pLog.append('BUILTIN DropValueCopy line ' & dvLogLn & ': ' & clip(dvBufTxt) & ' only ever held a copy of ' & clip(dvSrcTxt) & |
                choose(~dvFold, '', ' folded to ' & lower(clip(dvFold)) & ' case') & ', so its reads read ' & clip(dvSrcTxt)    & |
                choose(~dvFold, '', ' under ' & lower(clip(dvFold)) & '()') & ' and the copy goes'                              & |
                choose(~dvCmt._DataEnd and ~dvFoldCmt._DataEnd, '', ' - its comment stays, on a line of its own') & '.<13,10>')
    dvEdited = 1
    exit
  end

! ---- <buf>.setValue( <src>.getValue() | <src>.getValuePtr() | <src> ) and nothing else on the line
DvShape routine
  dvBuf = '' ; dvSrc = '' ; dvByVal = 0
  if records(dvQ) < 4 then exit.
  dvHeadIx = 1 ; do DvHead
  get(dvQ, 1)
  dvN = len(clip(dvQ.tx))
  dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
  if ~dvHead or ~dvD or dvD >= dvN or dvQ.tx[dvD + 1 : dvN] <> 'SETVALUE' then exit. ! one spelling: DvFill joined the split one
  get(dvQ, 2)
  if dvQ.tx <> '(' then exit.
  get(dvQ, 3)
  dvN = len(clip(dvQ.tx))
  dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
  if dvD > 1 and dvD < dvN
    if dvQ.tx[dvD + 1 : dvN] <> 'GETVALUE' and dvQ.tx[dvD + 1 : dvN] <> 'GETVALUEPTR' then exit.
    if records(dvQ) <> 6 then exit.                                                  ! <src>.getValue ( ) )
    get(dvQ, 4) ; if dvQ.tx <> '(' then exit.
    get(dvQ, 5) ; if dvQ.tx <> ')' then exit.
    get(dvQ, 6) ; if dvQ.tx <> ')' then exit.
    get(dvQ, 3)
    dvSrc = dvQ.tx[1 : dvD - 1]
    dvByVal = 1
  else
    if records(dvQ) <> 4 then exit.                                                  ! <src> )
    get(dvQ, 4) ; if dvQ.tx <> ')' then exit.
    get(dvQ, 3)
    if dvD then exit.
    dvSrc = dvQ.tx
  end
  if ~((dvSrc[1] >= 'A' and dvSrc[1] <= 'Z') or dvSrc[1] = '_') then exit.           ! a literal or an expression is no source
  dvBuf = dvHead
  if dvSrc = dvBuf then dvBuf = ''.
  if dvBuf then do DvFoldLine.

! ---- the line after the copy, when it is <buf>.upper() or <buf>.lower() alone: a case-folded copy.
!      Ruled 13 Sep 2026: such a copy is the source under upper() or lower() at every read, so
!      the fold line goes with the copy line, and each value read of the scratch is wrapped.
DvFoldLine routine
  dvFold = '' ; dvFoldLine = 0 ; dvFoldEol = 0
  dvFrom = dvNext
  loop ! the next line that holds a token
    if ~dvFrom or dvFrom > records(self.tk.tokens) then exit.
    do DvFill
    if records(dvQ) then break.
    dvFrom = dvNext
  end
  if records(dvQ) <> 3 then exit.
  get(dvQ, 1)
  dvN = len(clip(dvQ.tx))
  dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
  if dvD < 2 or dvD >= dvN then exit.
  if dvQ.tx[1 : dvD - 1] <> dvBuf then exit.
  if dvQ.tx[dvD + 1 : dvN] <> 'UPPER' and dvQ.tx[dvD + 1 : dvN] <> 'LOWER' then exit.
  get(dvQ, 2) ; if dvQ.tx <> '(' then exit.
  get(dvQ, 3) ; if dvQ.tx <> ')' then exit.
  get(dvQ, 1)
  dvFold     = dvQ.tx[dvD + 1 : dvN]
  dvFoldLine = dvFrom
  dvFoldEol  = self.FirstEolAfter(dvFrom)

! ---- the procedure and the end of its header
DvScope routine
  dvScFirst = 0 ; dvScLast = 0 ; dvScCode = 0
  dvSc = self.syms.ScopeContaining(dvLine1, vs:scProc, vs:scMethod)
  if ~dvSc then exit.
  self.syms.scopes.scopeId = dvSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  dvScFirst = self.syms.scopes.startTok
  dvScLast  = self.syms.scopes.endTok
  dvSelfU   = self.syms.scopes.selfClass
  dvZ = 0
  loop dvX = dvScFirst to records(self.tk.tokens)
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      dvZ += 1
    elsif self.tk.tokens.tok = ')'
      dvZ -= 1
      if ~dvZ then dvScCode = dvX ; break.
    elsif ~dvZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dvScCode = dvX ; break
    end
  end
  if ~dvScCode then dvScCode = dvScFirst.

! ---- the scratch must be a LOCAL of this procedure; the source may be anything declared. Neither may
!      be named in a method of a class the procedure declares: such a method shares the procedure's
!      data, and its body lies outside every walk here. Nor may the procedure INCLUDE a file: the
!      included code is not in this file either
DvParamCheck routine
  dvZ = self.syms.FindOwn(dvBuf, dvSc)
  dvBufDecl = 0
  if ~dvZ then dvWhy = clip(dvBufTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, dvZ)
  dvBufDecl = self.syms.syms.declTok
  if errorcode() or (self.syms.syms.declTok > dvScFirst and self.syms.syms.declTok <= dvScCode) ! inside the header: a parameter. A program-level
    dvWhy = clip(dvBufTxt) & ' is a PARAMETER, so it is not this procedure''s to remove' !   object in a PROGRAM's main CODE is declared before it
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then dvWhy = clip(dvBufTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then dvWhy = clip(dvBufTxt) & ' is a reference - what it points at is not this procedure''s to leave unwritten' ; exit.
  if self.MayHaveLocalMethods(dvSc) and self.UsedInLocalMethods(upper(dvBuf), dvScFirst, dvScLast)
    dvWhy = clip(dvBufTxt) & ' is used in a method of a class this procedure declares, which would find it never written'
    exit
  end
  dvZ = self.syms.FindOwn(dvSrc, dvSc)
  if ~dvZ
    dvWhy = clip(dvSrcTxt) & ' is not declared in this procedure, so whether it lives long enough cannot be told from here'
    exit
  end
  get(self.syms.syms, dvZ)
  if errorcode() then dvWhy = 'the declaration of ' & clip(dvSrcTxt) & ' could not be read' ; exit.
  dvParmsU.free()
  if self.syms.syms.declTok > dvScFirst and self.syms.syms.declTok <= dvScCode           ! a parameter: another one may name the same object
    loop dvX = 1 to records(self.syms.syms)
      get(self.syms.syms, dvX)
      if errorcode() then break.
      if self.syms.syms.scopeId <> dvSc or self.syms.syms.nameU = dvSrc then cycle.
      if self.syms.syms.declTok <= dvScFirst or self.syms.syms.declTok > dvScCode then cycle.
      dvParmsU.append(' ' & clip(self.syms.syms.nameU) & ' ')
    end
    get(self.syms.syms, dvZ)
  end
  if self.syms.syms.isField then dvWhy = clip(dvSrcTxt) & ' is a field of a structure - a GET or an assignment of the whole structure changes it' ; exit.
  dvSrcStr = 0
  case self.syms.syms.typeU
  of 'STRINGTHEORY'
  of 'STRING'       orof 'CSTRING' orof 'PSTRING'                                        ! a string variable or parameter: the scratch's reads spell as len() and a
    if self.syms.syms.isRef then dvWhy = clip(dvSrcTxt) & ' is a reference to a string - what it points at may move'. ! subscript on it (ruled 13 Sep 2026)
    dvSrcStr = 1
  else
    dvWhy = clip(dvSrcTxt) & ' is not a StringTheory or a string'
  end
  ! CAN A CALL REACH THE SOURCE WITHOUT ITS NAME? An object parameter is the caller's object, which
  ! the caller may hold as program data, and a string parameter passed by address is the caller's
  ! variable; a reference points at what anything may hold; and a STATIC or THREAD source is shared
  ! by every call of the procedure, a recursive one too. DvFarCall then refuses a call between the
  ! copy and the last read. A string passed by value - its type written in the header with no '*'
  ! in front, as one token or two - is the procedure's own copy.
  dvSrcFar = 0
  if self.syms.syms.declTok > dvScFirst and self.syms.syms.declTok <= dvScCode
    dvSrcFar = 1
    dvTail = upper(self.tk.GetTok(self.syms.syms.declTok - 1))
    if dvSrcStr and self.tk.GetTok(self.syms.syms.declTok - 2) <> '*'
      if inlist(dvTail, 'STRING', 'CSTRING', 'PSTRING') then dvSrcFar = 0.
    end
  elsif self.syms.syms.isRef
    dvSrcFar = 1
  elsif band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread)
    dvSrcFar = 2
  end
  if ~dvWhy and self.MayHaveLocalMethods(dvSc) and self.UsedInLocalMethods(upper(dvSrc), dvScFirst, dvScLast)
    dvWhy = clip(dvSrcTxt) & ' is used in a method of a class this procedure declares, which can change it while the copy is still read'
  end
  if ~dvWhy and self.ScopeIncludes(dvSc)
    dvWhy = clip(dvSrcTxt) & ' and ' & clip(dvBufTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
  end

! ---- every OTHER line of the procedure: the scratch may only be read, and only after the copy;
!      the source may not change between the copy and the scratch's last read; the copy line
!      itself may carry a comment, which is kept for a line of its own
DvUses routine
  dvLast = 0 ; dvEqAt = 0
  free(dvRdQ)
  dvCmt.free() ; dvFoldCmt.free()                                      ! a comment on the copy line, or the fold line, is kept
  get(self.tk.tokens, self.FirstEolAfter(dvLine1))                     !   where the line was, on a line of its own (ruled 14 Sep 2026)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    dvX = pLog.findByte(33, 1,, self.tk.tokens.strBefore)              ! '!'
    if dvX then dvCmt.setValue(self.tk.tokens.strBefore[dvX : size(self.tk.tokens.strBefore)]).
  end
  if dvFoldLine
    get(self.tk.tokens, dvFoldEol)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      dvX = pLog.findByte(33, 1,, self.tk.tokens.strBefore)            ! '!'
      if dvX then dvFoldCmt.setValue(self.tk.tokens.strBefore[dvX : size(self.tk.tokens.strBefore)]).
    end
  end
  dvFrom = dvScFirst
  loop while dvFrom > 0 and dvFrom < dvScLast
    do DvFill
    if dvFrom = dvBufDecl or dvFrom = dvLine1 or dvFrom = dvFoldLine then dvFrom = dvNext ; cycle.
    loop dvX = 1 to records(dvQ)
      dvHeadIx = dvX ; do DvHead
      get(dvQ, dvX)
      if errorcode() then break.
      if (dvQ.tx = dvSrc or dvHead = dvSrc)                            ! r &= src: a second name for the source, through which it
        if self.tk.GetTok(dvQ.tk - 1) = '&='                           !   can change where no walk here looks
          dvWhy = 'a reference to ' & clip(dvSrcTxt) & ' is taken on line ' & self.LogLineOf(dvFrom) & ' - a second name for it, through which it can change unseen'
          exit
        end
        get(dvQ, dvX)
      end
      if dvFrom < dvLine1 and ~dvSrcStr and ~dvSrcFar and (dvQ.tx = dvSrc or dvHead = dvSrc)
        do DvKeptBefore
        if dvWhy then exit.
      end
      if dvHead <> dvBuf and dvQ.tx <> dvBuf then cycle.
      if dvFrom < dvLine1
        dvWhy = clip(dvBufTxt) & ' is used before the copy, on line ' & self.LogLineOf(dvFrom) & ' - a reader would be left with a value nothing writes'
        exit
      end
      if dvHead = dvBuf
        dvN = len(clip(dvQ.tx))
        dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
        if dvD and dvD < dvN
          dvTail = dvQ.tx[dvD + 1 : dvN]
        else
          dvTail = dvQ.tx
        end
        case dvTail
        of 'VALUEPTR' orof '_DATAEND'
          do DvStmtHead
          if dvAtHead
            dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' is written on line ' & self.LogLineOf(dvFrom) & ' - after the rename that write would change ' & dvSrcTxt
            exit
          end
        end
        case dvTail
        of 'VALUEPTR' orof 'GETVALUEPTR'
          do DvBufOut
          if dvBufOut
            dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' hands its buffer on, to be written or kept' & |
                    ' where no walk here looks - after the rename that buffer would be ' & clip(dvSrcTxt) & '''s'
            exit
          end
        end
        dvBufOut = 0
        if ~dvFold or dvTail = '_DATAEND' then do DvSliceOut.
        if dvBufOut and dvTail = 'GETVALUE'
          dvWhy = clip(dvBufTxt) & '.getvalue() on line ' & self.LogLineOf(dvFrom) & ' is handed to a call that may take it by address' & |
                  ' - after the rename it would be ' & clip(dvSrcTxt) & ' itself, which the call could change'
          exit
        elsif dvBufOut and dvTail = '_DATAEND'
          dvWhy = clip(dvBufTxt) & '._dataend on line ' & self.LogLineOf(dvFrom) & ' hands its length to a call that may write it' & |
                  ' - after the rename it would be the length of ' & dvSrcTxt
          exit
        elsif dvBufOut
          dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' hands a part of its buffer to a call' & |
                  ' that may write it or keep it - after the rename that part would be ' & clip(dvSrcTxt) & '''s'
          exit
        end
        if ~instring(' ' & clip(dvTail) & ' ', dvReads, 1, 1)
          dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' is not a plain read of the value it copied'
          exit
        end
        if dvByVal and dvTail = 'EQUALS' and ~dvEqAt then dvEqAt = dvFrom.    ! judged once the walk is done, by DvEqFlags
        if dvFold and ~instring(' ' & clip(dvTail) & ' ', dvFoldReads, 1, 1)
          dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' is not a read the case fold can be carried into'
          exit
        end
        if dvSrcStr and ~instring(' ' & clip(dvTail) & ' ', dvStrReads, 1, 1)
          dvWhy = clip(dvBufTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' has no spelling on a STRING, which ' & clip(dvSrcTxt) & ' is'
          exit
        end
        dvLast = dvFrom
        get(dvQ, dvX)
        if ~records(dvRdQ) or dr:ln <> dvFrom
          clear(dvRdQ)
          dr:ln = dvFrom
          dr:tk = dvQ.tk
          add(dvRdQ)
        else
          dr:tk = dvQ.tk
          put(dvRdQ)
        end
      else                                                                    ! a bare mention
        get(dvQ, dvX + 1)
        if ~errorcode() and dvQ.tx = '.' then get(dvQ, dvX) ; cycle.          ! the head of a split dotted form - its tail is judged next
        dvWhy = clip(dvBufTxt) & ' is handed whole to a call on line ' & self.LogLineOf(dvFrom) & ' - the callee could change it'
        exit
      end
    end
    if dvWhy then break.
    dvFrom = dvNext
  end
  if dvWhy then exit.
  if ~dvLast then dvWhy = clip(dvBufTxt) & ' is never read after the copy, so there is nothing to move' ; exit.
  ! ---- the source between the copy and the END of the statement holding the scratch's last read - a
  !      | line has no EOL, and a call on a line the statement carries on to runs before the read - and,
  !      when that read is inside a LOOP opened after the copy, on to the loop's END: its next pass runs
  !      those lines before the read
  dvWalkEnd = self.FirstEolAfter(dvLast)
  if ~dvWalkEnd then dvWalkEnd = dvLast.
  dvLoopAt = 0 ; dvDepth = 0
  loop dvX = self.FirstEolAfter(dvLine1) + 1 to dvLast
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    case self.tk.tokens.level
    of '+'
      if ~dvLoopAt and not self.tk.tokens.tok &= NULL and (upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT')
        dvLoopAt = dvX ; dvLoopD = dvDepth
      end
      dvDepth += 1
    of '-'
      dvDepth -= 1
      if dvLoopAt and dvDepth <= dvLoopD then dvLoopAt = 0.
    end
  end
  if dvLoopAt
    loop dvX = dvLast + 1 to records(self.tk.tokens)
      get(self.tk.tokens, dvX)
      if errorcode() then break.
      if self.tk.tokens.level = '+' then dvDepth += 1.
      if self.tk.tokens.level = '-'
        dvDepth -= 1
        if dvDepth <= dvLoopD then dvWalkEnd = dvX ; break.
      end
    end
  end
  dvFrom = dvLine1
  loop while dvFrom > 0 and dvFrom <= dvWalkEnd
    do DvFill
    if dvFrom = dvLine1 then dvFrom = dvNext ; cycle.
    if dvSrcFar
      do DvFarCall
      if dvWhy then exit.
    end
    dvZ = 0
    loop dvX = 1 to records(dvQ)
      get(dvQ, dvX)
      if ~errorcode() and dvQ.tx = 'DO' then dvZ = 1 ; break.
    end
    if dvZ
      dvTouchTk = dvQ.tk
      do DvTouchOK                                                            ! a routine could change the source - unless no read of the scratch can follow
      if ~dvTouchOK
        dvWhy = 'line ' & self.LogLineOf(dvFrom) & ' calls a routine between the copy and ' & clip(dvBufTxt) & '''s last read, and a routine could change ' & dvSrcTxt
        exit
      end
    end
    loop dvX = 1 to records(dvQ)
      dvHeadIx = dvX ; do DvHead
      get(dvQ, dvX)
      if errorcode() then break.
      do DvFarHead
      if dvFarObj
        dvN = len(clip(dvQ.tx))
        dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
        if dvD and dvD < dvN
          dvTail = dvQ.tx[dvD + 1 : dvN]
        else
          dvTail = dvQ.tx
        end
        dvAtHead = 0
        if dvTail = 'VALUEPTR' or dvTail = '_DATAEND' then do DvStmtHead.
        if dvAtHead or ~instring(' ' & clip(dvTail) & ' ', dvSrcOk, 1, 1)
          dvWhy = lower(clip(dvHead)) & ' may be the same object as ' & clip(dvSrcTxt) & ', and it changes on line ' & self.LogLineOf(dvFrom) & ' before ' & clip(dvBufTxt) & '''s last read'
          exit
        end
      end
      if dvHead <> dvSrc and dvQ.tx <> dvSrc then cycle.
      if dvHead = dvSrc
        dvN = len(clip(dvQ.tx))
        dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
        if dvD and dvD < dvN
          dvTail = dvQ.tx[dvD + 1 : dvN]
        else
          dvTail = dvQ.tx
        end
        dvAtHead = 0 ; dvBufOut = 0
        if dvTail = 'VALUEPTR' or dvTail = '_DATAEND' then do DvStmtHead.
        if dvTail = 'VALUEPTR' or dvTail = 'GETVALUEPTR' then do DvBufOut.
        if ~dvBufOut then do DvSliceOut.
        if dvAtHead or dvBufOut or ~instring(' ' & clip(dvTail) & ' ', dvSrcOk, 1, 1)
          get(dvQ, dvX)
          dvTouchTk = dvQ.tk
          do DvTouchOK
          if ~dvTouchOK
            dvWhy = clip(dvSrcTxt) & ' changes on line ' & self.LogLineOf(dvFrom) & ' (' & lower(clip(dvTail)) & '), before ' & clip(dvBufTxt) & '''s last read'
            exit
          end
        end
      else
        dvSubW = 0
        get(dvQ, dvX + 1)
        if ~errorcode() and dvQ.tx = '.' then get(dvQ, dvX) ; cycle.
        if dvSrcStr                                                           ! a STRING source: a subscript read, or an argument to a pure reader, is a read
          if ~errorcode() and dvQ.tx = '['
            get(dvQ, dvX)
            dvSubW = choose(self.StoreHead(dvQ.tk) > 0)                       ! s[1] = 'X' at the start of a statement writes the source
            if ~dvSubW
              dvTail = 'VALUEPTR' ; do DvSliceOut
              if dvBufOut then dvSubW = 2.
            end
            if ~dvSubW then cycle.
          end
          if dvX > 2 and dvSubW <> 2
            get(dvQ, dvX - 1)
            if ~errorcode() and dvQ.tx = '('
              get(dvQ, dvX - 2)
              if ~errorcode() and instring(' ' & clip(dvQ.tx) & ' ', ' LEN UPPER LOWER CLIP SUB LEFT RIGHT VAL INSTRING ', 1, 1)
                if ~dvPure._DataEnd then self.IfCasePureList(dvPure) ; self.PureOwnList(dvPure, dvOwn).
                if self.PureProc(dvQ.tx, dvPure, dvOwn) then get(dvQ, dvX) ; cycle.
              end
            end
          end
          get(dvQ, dvX)
        end
        ! the callee only reads it, by its summary (ruled 14 Sep 2026)
        get(dvQ, dvX)
        if ~dvSubW and self.ArgReadsOnly(dvQ.tk, dvSelfU) then cycle.
        dvTouchTk = dvQ.tk
        do DvTouchOK
        if ~dvTouchOK and dvSubW = 2
          dvWhy = clip(dvSrcTxt) & ' has a slice handed on line ' & self.LogLineOf(dvFrom) & ' to a call that may write it, before ' & clip(dvBufTxt) & '''s last read'
          exit
        end
        if ~dvTouchOK
          dvWhy = clip(dvSrcTxt) & choose(~dvSubW, ' is handed whole to a call on line ', ' is written through a subscript on line ') & self.LogLineOf(dvFrom) & ', before ' & clip(dvBufTxt) & '''s last read'
          exit
        end
      end
    end
    if dvWhy then break.
    dvFrom = dvNext
  end
  if ~dvWhy and dvEqAt then do DvEqFlags.

! ---- does the dvQ row dvX, `name.valuePtr` or `name.getValuePtr()`, hand the buffer on? Taken by
!      reference with &=, or a whole argument of a call that may write it or keep it - any call but one
!      ArgMayWrite clears: a body whose summary says it only reads that parameter, a plain call on the
!      pure list, or a call that only reads what it is handed, such as a StringTheory's setValue or
!      append, or MESSAGE (ReadOnlyCallAt) - it can be written later, anywhere, without the name. A
!      slice of it handed on is DvSliceOut's question. The tokens either side are read from the token
!      stream, not from dvQ, which holds one physical line: a call wrapped with '|' puts them on another
!      line ----
DvBufOut routine
  data
t    long,auto
a    long,auto
sm   byte,auto
  code
  dvBufOut = 0
  get(dvQ, dvX)
  if errorcode() then exit.
  t = dvQ.tk
  if self.tk.GetTok(t - 1) = '&=' then dvBufOut = 1 ; exit.
  if self.tk.GetTok(t - 1) <> '(' and self.tk.GetTok(t - 1) <> ',' then exit.
  a = t + 1
  if dvTail = 'GETVALUEPTR'
    if self.tk.GetTok(t + 3) <> '(' or self.tk.GetTok(t + 4) <> ')' then exit.
    a = t + 5
  end
  if self.tk.GetTok(a) <> ')' and self.tk.GetTok(a) <> ',' then exit.
  sm = 1
  dvBufOut = self.ArgMayWrite(t, a - 1, dvReads, sm)

! ---- does the dvQ row dvX hand on storage that the rename makes the source's? A SLICE of the buffer,
!      `Up(tmp.valuePtr[1 : n])` - or `Up(tmp.getValuePtr(n))`, which StringTheory answers with a part of
!      the buffer - is passed by address as the whole buffer is, and so is its length,
!      `Shorten(tmp._DataEnd)`; and when the source is a STRING the
!      rename writes a getValue() read as the variable itself, so `Fix(tmp.getValue())`, which handed the
!      call a copy, would hand it the source. Asked of the source too: a slice of ITS buffer, or of a
!      STRING source (dvTail is set to VALUEPTR for that, the buffer a STRING stands in for), handed to a
!      call that may write it changes the source before the scratch's last read. Handed as a whole
!      argument it is no obstacle when the call cannot write through it (ArgMayWrite: a call that only
!      reads what it is handed - a StringTheory's own setValue, append, prepend and the rest of
!      ReadOnlyCallAt's list, or the runtime's MESSAGE and the like - or one of a StringTheory's reads; a
!      body whose summary says it only reads it; a plain call on the pure list), or when its prototype
!      takes that place by value (AutoArgIsRefParam, which answers no for CHOOSE as well: it picks a
!      value and keeps nothing). A case-folded copy wraps a read of the scratch in upper() or lower(), a
!      value, so the caller does not ask it there - but not the length, which the rename leaves bare, so
!      `Shorten(tmp._DataEnd)` is asked under a fold too; and the buffer handed whole, with no subscript, is
!      DvBufOut's question. The read and the tokens either side of it are taken from the token stream, as
!      DvBufOut takes them: a call wrapped with '|' spans lines ----
DvSliceOut routine
  data
t    long,auto
e    long,auto
sm   byte,auto
  code
  dvBufOut = 0
  get(dvQ, dvX)
  if errorcode() then exit.
  t = dvQ.tk
  case dvTail
  of 'GETVALUE'
    if ~dvSrcStr then exit.
    if self.tk.GetTok(t + 3) <> '(' or self.tk.GetTok(t + 4) <> ')' then exit.
    e = t + 4
  of 'GETVALUEPTR'
    if self.tk.GetTok(t + 3) <> '(' then exit.
    e = self.tk.MatchLeftBracket('(', ')', t + 3)
    if e > t and self.tk.GetTok(e + 1) = '[' then e = self.tk.MatchLeftBracket('[', ']', e + 1).
    if e <= t + 4 then exit.
  of 'VALUEPTR'
    if self.tk.GetTok(t + 1) <> '[' then exit.
    e = self.tk.MatchLeftBracket('[', ']', t + 1)
  of '_DATAEND'
    e = t
  else
    exit
  end
  if e < t then exit.
  sm = 1
  if ~self.ArgMayWrite(t, e, dvReads, sm) then exit.
  dvBufOut = self.AutoArgIsRefParam(t, 1)

! ---- does the dvQ row dvX start a statement? A `name.valuePtr[...]` or `name._DataEnd` there is the
!      target of an assignment - a WRITE of the buffer, though the same words elsewhere only read it.
!      StoreHead answers: after a line end, ';', THEN or ELSE, after a column-1 label standing in
!      front of its statement (`Again  tmp.valuePtr[1] = 'X'`), or after the debug mark that begins a
!      line (`? tmp.valuePtr[1] = 'X'`, a store in a debug build) - and not at the head of a line
!      that a '|' continues, where the statement began on the line above ----
DvStmtHead routine
  get(dvQ, dvX)
  dvAtHead = choose(self.StoreHead(dvQ.tk) > 0)
  get(dvQ, dvX)

! ---- a source this procedure owns, handed whole to a call BEFORE the copy - or its buffer, or a slice
!      of its buffer, getValuePtr(n) among them - may be kept there by reference, and changed through
!      it by a call between the copy and the scratch's last read that names nothing. A call is no
!      obstacle only when the summary of its body says it reads or writes that parameter and keeps no
!      reference to it, or it is a plain call on the pure list (ArgFact; ruled 28 Oct 2026) - or, for a
!      slice, when the call cannot write through it (ArgMayWrite: a StringTheory's own setValue, append
!      or prepend copy what they are given) or its prototype takes that place by value
!      (AutoArgIsRefParam), so what it gets is a copy. Row dvX of dvQ names the source; dvWhy says which
!      line. The tokens either side are read from the token stream: a call wrapped with '|' puts them
!      on another line ----
DvKeptBefore routine
  data
kn   long,auto
kd   long,auto
kt   STRING(96),auto
ka   long,auto
ks   byte
sm   byte,auto
  code
  kt = ''
  if dvHead = dvSrc
    kn = len(clip(dvQ.tx))
    kd = instring('.', dvQ.tx[1 : kn], 1, 1)
    if kd and kd < kn then kt = dvQ.tx[kd + 1 : kn].
    if kt <> 'VALUEPTR' and kt <> 'GETVALUEPTR' then exit.
  end
  get(dvQ, dvX)
  ka = dvQ.tk + 1
  if kt = 'GETVALUEPTR'
    if self.tk.GetTok(dvQ.tk + 3) <> '(' then exit.
    ka = self.tk.MatchLeftBracket('(', ')', dvQ.tk + 3) + 1
    if ka < dvQ.tk + 5 then exit.
    if ka > dvQ.tk + 5 then ks = 1.
  end
  if kt and self.tk.GetTok(ka) = '['
    ka = self.tk.MatchLeftBracket('[', ']', ka)
    if ~ka then exit.
    ka += 1 ; ks = 1
  end
  if self.tk.GetTok(dvQ.tk - 1) <> '(' and self.tk.GetTok(dvQ.tk - 1) <> ',' then exit.
  if self.tk.GetTok(ka) <> ')' and self.tk.GetTok(ka) <> ',' then exit.
  if inlist(self.ArgFact(dvQ.tk, dvSelfU), 'R', 'W', 'P', 'F') then exit.
  if kt
    sm = 1
    if ~self.ArgMayWrite(dvQ.tk, ka - 1, dvReads, sm) or ~self.AutoArgIsRefParam(dvQ.tk, 1) then exit.
  end
  if ks
    dvWhy = 'a slice of ' & clip(dvSrcTxt) & '.' & lower(clip(kt)) & ' is handed to a call on line ' & self.LogLineOf(dvFrom) &      |
            ', before the copy - it may keep a reference to it, through which a later call changes ' & clip(dvSrcTxt) & ' unseen'
    exit
  end
  dvWhy = clip(dvSrcTxt) & choose(~kt, '', '.' & lower(clip(kt))) & ' is handed whole to a call on line ' & self.LogLineOf(dvFrom) & |
          ', before the copy - it may keep a reference to it, through which a later call changes ' & clip(dvSrcTxt) & ' unseen'

! ---- a source another call can reach (dvSrcFar) may be changed by any call on the line in hand that does
!      not name it: the caller's object or variable, what a reference points at, a STATIC or THREAD one
!      that every call of the procedure shares. No obstacle: a reader on the pure list called by name
!      alone that is the runtime's own function and no procedure of the file's (PureProc - a class's
!      Size method does not make a plain size() one), and a method of a StringTheory this procedure
!      owns, which changes only itself. Any other
!      call refuses, one written without brackets too - and for the caller's string, so does a store
!      into a string this procedure does not own, which may be the same variable. A line in an arm
!      body that no read of the scratch can follow is let pass (DvTouchOK). dvWhy says which ----
DvFarCall routine
  data
cz   long,auto
cd   long,auto
cn   long,auto
cs   long ! no AUTO: may be read before it is set
cf   byte,auto
cr   STRING(96),auto
ct   STRING(vs:maxName),auto
cw   STRING(300)
  code
  if ~dvPure._DataEnd then self.IfCasePureList(dvPure) ; self.PureOwnList(dvPure, dvOwn).
  loop cz = 1 to records(dvQ)
    get(dvQ, cz)
    if errorcode() then break.
    if ~((dvQ.tx[1] >= 'A' and dvQ.tx[1] <= 'Z') or dvQ.tx[1] = '_') then cycle.
    cr = dvQ.tx
    cs = dvQ.tk
    get(self.tk.tokens, cs)
    if errorcode() or self.tk.tokens.type <> vt:label then cycle.
    get(dvQ, cz + 1)
    if errorcode() or dvQ.tx <> '('
      if self.BareCallAt(cs)
        cw = 'line ' & self.LogLineOf(dvFrom) & ' calls ' & lower(cr)
        break
      end
      if ~dvSrcStr or dvSrcFar <> 1 or cr = dvSrc then cycle.
      if ~self.StoreHead(cs) then cycle.
      ct = self.NameRoot(cr)
      cn = self.syms.FindOwn(ct, dvSc)
      cf = 1
      if cn
        get(self.syms.syms, cn)
        if ~errorcode() and ~self.syms.syms.isRef and self.syms.syms.declTok > dvScCode then cf = 0.
      end
      if ~cf then cycle.
      case self.HayType(cr, cs)
      of '' orof 'STRING' orof 'CSTRING' orof 'PSTRING' orof 'ASTRING' orof 'ANY'
        cw = 'line ' & self.LogLineOf(dvFrom) & ' stores into ' & lower(clip(cr)) & ', which may be the same variable as ' & dvSrcTxt
        break
      end
      cycle
    end
    cn = len(clip(cr))
    cd = cn
    loop while cd > 0 and cr[cd] <> '.'
      cd -= 1
    end
    ! a method of the source itself is judged by the walk that called this, as any other use of it
    if cd > 1 and cr[1 : cd - 1] = dvSrc then cycle.
    if ~cd
      if self.PureProc(cr, dvPure, dvOwn) then cycle.
    elsif cd > 1 and ~instring('.', cr[1 : cd - 1], 1, 1)
      cn = self.syms.FindOwn(cr[1 : cd - 1], dvSc)
      if cn
        get(self.syms.syms, cn)
        if ~errorcode() and self.syms.syms.typeU = 'STRINGTHEORY' and ~self.syms.syms.isRef and self.syms.syms.declTok > dvScCode then cycle.
      end
    end
    cw = 'line ' & self.LogLineOf(dvFrom) & ' calls ' & lower(cr)
    break
  end
  if ~cw then exit.
  dvTouchTk = cs
  do DvTouchOK
  if dvTouchOK then exit.
  dvWhy = clip(cw) & ' between the copy and ' & clip(dvBufTxt) & '''s last read, and ' & clip(dvSrcTxt)                                           & |
          choose(dvSrcFar = 2, ' is STATIC or THREAD, shared by every call of the procedure', ' is the caller''s, or what a reference points at') & |
          ' - it can change without being named'

! ---- for a source the caller owns: may the object the dvQ row dvX names (its root, dvHead) be that same
!      object? Another parameter may, and so may anything this procedure does not own - program or module
!      data, SELF, a reference - when it is an object: data of a plain type (a LONG, a GROUP) cannot be ----
DvFarHead routine
  data
fz   long,auto
  code
  dvFarObj = 0
  if ~dvHead or dvHead = dvSrc then exit.
  if dvParmsU.findChars(' ' & clip(dvHead) & ' ') then dvFarObj = 1 ; exit.
  if dvSrcFar <> 1 then exit.
  fz = self.syms.FindOwn(dvHead, dvSc)
  if fz
    get(self.syms.syms, fz)
    if ~errorcode() and ~self.syms.syms.isRef and self.syms.syms.declTok > dvScCode then exit.
  end
  if self.syms.Lookup(dvHead, dvQ.tk, dvArgTU, dvArgRf)
    if upper(dvArgTU) <> 'STRINGTHEORY' and self.UvPlainType(dvArgTU) then exit.
  end
  dvFarObj = 1

! ---- an equals() read of a getValue() copy (ruled 18 Oct 2026). equals with st:NoCaseCompare or
!      st:UnicodeCompare compares by the object's encoding, which a getValue() copy does not carry:
!      the scratch starts plain. Reading the source instead gives the same answer only when the
!      source is plain too - TakeOverValue's test. It is its own local, not a parameter, not a
!      reference, not STATIC or THREAD, and nothing that can run before the read sets its encoding,
!      base64 or gzip flags: a method that sets them, a setValue or append from another object
!      (which copies them), a setValue from a USTRING (which sets the UTF-16 encoding), or the
!      object handed whole to a call that is not known only to read it.
!      What can run before the read: a line above the copy, a line in a routine, the rest of a LOOP
!      around the copy (its next pass), the lines up to the walk's end - and every line, when the
!      copy is in a routine or the procedure holds a GOTO.
DvEqFlags routine
  data
t     long,auto
ta    string(vs:maxName),auto
d     long,auto
o     long,auto
late  long,auto
every byte,auto
  code
  dvEqWhy = ''
  dvZ = self.syms.FindOwn(dvSrc, dvSc)
  get(self.syms.syms, dvZ)
  if errorcode()
    dvEqWhy = 'the declaration of ' & clip(dvSrcTxt) & ' could not be read'
  elsif self.syms.syms.declTok > dvScFirst and self.syms.syms.declTok <= dvScCode
    dvEqWhy = clip(dvSrcTxt) & ' is a PARAMETER, whose encoding is the caller''s'
  elsif self.syms.syms.isRef
    dvEqWhy = clip(dvSrcTxt) & ' is a reference, whose encoding is set elsewhere'
  elsif self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    dvEqWhy = clip(dvSrcTxt) & ' is STATIC or THREAD, so it keeps its encoding from the call before'
  end
  if ~dvEqWhy
    dvDataEnd = self.CodeTokOfScope(dvScFirst, dvScLast)
    every = choose(self.syms.ScopeContaining(dvLine1, vs:scRoutine, vs:scRoutine) > 0)
    if ~every                                            ! a GOTO can bring any line round again
      loop t = dvDataEnd to dvScLast
        get(self.tk.tokens, t)
        if errorcode() then break.
        if not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'GOTO' then every = 1 ; break.
      end
    end
    late = dvWalkEnd
    if ~every                                            ! the outermost LOOP still open at the copy: its next
      d = 0 ; o = 0                                      !   pass runs the rest of its body before the read again
      loop t = dvDataEnd to dvLine1 - 1
        get(self.tk.tokens, t)
        if errorcode() then break.
        case self.tk.tokens.level
        of '+'
          if ~o and not self.tk.tokens.tok &= NULL and (upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT') then o = d + 1.
          d += 1
        of '-'
          d -= 1
          if o and d < o then o = 0.
        end
      end
      if o
        loop t = dvLine1 to dvScLast
          get(self.tk.tokens, t)
          if errorcode() then break.
          case self.tk.tokens.level
          of '+'
            d += 1
          of '-'
            d -= 1
            if d < o
              if t > late then late = t.
              break
            end
          end
        end
      end
    end
    dvFrom = dvDataEnd
    loop while dvFrom > 0 and dvFrom < dvScLast
      do DvFill
      if dvFrom = dvLine1 then dvFrom = dvNext ; cycle.
      if ~every and dvFrom > late and ~self.syms.ScopeContaining(dvFrom, vs:scRoutine, vs:scRoutine) ! it runs only after the read
        dvFrom = dvNext ; cycle
      end
      loop dvX = 1 to records(dvQ)
        dvHeadIx = dvX ; do DvHead
        get(dvQ, dvX)
        if errorcode() then break.
        if dvHead = dvSrc
          dvN = len(clip(dvQ.tx))
          dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
          if dvD and dvD < dvN
            dvTail = dvQ.tx[dvD + 1 : dvN]
          else
            dvTail = dvQ.tx
          end
          ! --ignoremarks: the marks are the user's own risk
          if ~self.ignoreMarks and instring(' ' & clip(dvTail) & ' ', fl:writers, 1, 1)
            dvEqWhy = clip(dvSrcTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' may set its encoding'
          elsif dvTail = 'SETVALUE' or dvTail = 'APPEND'
            ta = ''                                      ! setValue(<name>) or append(<name>)
            if self.tk.GetTok(dvQ.tk + 3) = '(' then ta = upper(self.tk.GetTok(dvQ.tk + 4)).
            case val(ta[1])
            of 65 to 90 orof 95                          ! 'A' to 'Z' orof '_'
              if ~self.syms.Lookup(ta, dvFrom, dvArgTU, dvArgRf) or upper(dvArgTU) = 'STRINGTHEORY' ! an object, or a name nothing declares
                dvEqWhy = clip(dvSrcTxt) & '.' & lower(clip(dvTail)) & ' on line ' & self.LogLineOf(dvFrom) & ' may copy another object''s encoding'
              end
              if ~dvEqWhy and dvTail = 'SETVALUE' and upper(dvArgTU) = 'USTRING'
                if self.tk.GetTok(dvQ.tk + 5) = ')'
                  dvEqWhy = clip(dvSrcTxt) & '.setvalue on line ' & self.LogLineOf(dvFrom) & ' gives it the value of a USTRING, which sets its encoding to UTF-16'
                end
              end
            end
          end
        elsif dvQ.tx = dvSrc
          get(dvQ, dvX + 1)
          if ~errorcode() and dvQ.tx = '.' then cycle.   ! the head of a split dotted form
          get(dvQ, dvX)
          if ~self.ArgReadsOnly(dvQ.tk, dvSelfU) then dvEqWhy = clip(dvSrcTxt) & ' is handed whole to a call on line ' & self.LogLineOf(dvFrom) & ', which may set its encoding'.
        end
        if dvEqWhy then break.
      end
      if dvEqWhy then break.
      dvFrom = dvNext
    end
  end
  if dvEqWhy
    dvWhy = clip(dvBufTxt) & '.equals on line ' & self.LogLineOf(dvEqAt) & ' may compare by the encoding, which a getValue() copy does not carry, and ' & dvEqWhy
  end

! ---- is the touch of the source on line dvFrom harmless? It is when it lies in a BODY of an IF or
!      CASE that opens after the copy, and no read of the scratch can run after it: the heads of that
!      structure run BEFORE any body and never after one, another body never runs in the same
!      activation, so only a read later in the same body, or after the structure's END, could see the
!      change - and so could a read on the touch's own line in the touch's own statement, ahead of the
!      touch or after it, since a call runs before every other operand is read, or in a later
!      statement: `n = tmp._DataEnd + src.replace('a', 'bb')`, `src.append('x') ; message(tmp.getValue())`, or
!      `src.prepend(tmp.valuePtr[3 : 4])`, which after the rename hands the source a part of its own
!      buffer while it moves it. Ruled 13 Sep 2026, from VitRules.LoadStyleFile: an upper copy tested in an IF/ELSIF
!      chain whose arms hand the source to the parsers. A touch on a head line, or inside a LOOP the
!      copy is not in, refuses as before.
DvTouchOK routine
  data
d    long,auto
o    long,auto
oe   long,auto
be   long,auto
t    long,auto
r    long,auto
sb   long,auto
lv   string(1),auto
tyv  string(1),auto
oU   string(vs:maxName),auto
  code
  dvTouchOK = 0
  if dvFrom > dvLast then exit.                            ! past the last read, in its loop: the next pass reads after it
  d = 0 ; o = 0
  loop t = dvFrom - 1 to self.FirstEolAfter(dvLine1) by -1 ! back to the opener the touch line sits in
    get(self.tk.tokens, t)
    if errorcode() then exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      d += 1
    elsif lv = '+'
      if d
        d -= 1
      else
        o = t
        break
      end
    end
  end
  if ~o then exit.                                         ! the touch is at the copy's own level
  get(self.tk.tokens, o)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  oU = upper(self.tk.tokens.tok)
  if oU <> 'IF' and oU <> 'CASE' then exit.                ! a LOOP body runs again; anything else is not modelled
  if dvFrom <= self.FirstEolAfter(o) then exit.            ! on the opener's own line: a head
  get(self.tk.tokens, dvFrom)
  if errorcode() then exit.
  if self.tk.tokens.level = '/' then exit.                 ! an ELSIF / OF line: a head
  get(self.tk.tokens, o)                                   ! MatchLevel wants the opener in the buffer
  oe = self.tk.MatchLevel()
  if oe <= o then exit.
  be = oe ; d = 0                                          ! the body ends at the next head of this structure, or its END
  loop t = dvFrom + 1 to oe - 1
    get(self.tk.tokens, t)
    if errorcode() then exit.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '+'
      d += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      d -= 1
    elsif lv = '/' and ~d
      be = t
      break
    end
  end
  sb = 1                                                   ! the touch's own statement starts after the EOL or ; before
  loop t = dvTouchTk - 1 to 1 by -1                        !   it - a | line has no EOL, so a wrapped one is taken whole
    if self.IsEolTok(t) or self.tk.GetTok(t) = ';' then sb = t + 1 ; break.
  end
  loop r = 1 to records(dvRdQ)                             ! no read later in this body, none after the structure
    get(dvRdQ, r)
    if errorcode() then exit.
    if dr:ln <= dvFrom and dr:tk >= sb then exit.
    if dr:ln > dvFrom and dr:ln < be then exit.
    if dr:ln > oe then exit.
  end
  dvTouchOK = 1

! ---- the copy must RUN before every read. The reads lie between the copy and the last of them,
!      so: the last read is in the copy's own routine (or, like it, in none); walking from the
!      copy to it, the structure holding the copy never ends, no other branch of it begins, and
!      no label offers a way in; and the copy is not itself one arm of an EXECUTE
DvRuns routine
  if self.InCondBlock(dvLine1)
    dvWhy = 'the copy on line ' & self.LogLineOf(dvLine1) & ' is inside a COMPILE or OMIT block, which a build may leave out'
    exit
  end
  if self.syms.ScopeContaining(dvLine1, vs:scRoutine, vs:scRoutine) <> self.syms.ScopeContaining(dvLast, vs:scRoutine, vs:scRoutine)
    dvWhy = clip(dvBufTxt) & ' is read on line ' & self.LogLineOf(dvLast) & ' in a different routine from the copy, so the read may run first'
    exit
  end
  dvDepth = 0
  dvEol = self.FirstEolAfter(dvLine1)
  dvY = self.FirstEolAfter(dvLast)
  loop dvX = dvEol + 1 to dvY
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      dvDepth += 1
    elsif self.tk.tokens.level = '-'
      dvDepth -= 1
      if dvDepth < 0
        dvWhy = 'the structure holding the copy ends on line ' & self.LogLineOf(dvX) & ', before ' & clip(dvBufTxt) & '''s read on line ' & |
                self.LogLineOf(dvLast) & ' - the read can run without the copy'
        exit
      end
    elsif self.tk.tokens.level = '/' and ~dvDepth
      dvWhy = 'line ' & self.LogLineOf(dvX) & ' begins another branch of the structure holding the copy, so ' & clip(dvBufTxt) & '''s read on line ' & |
              self.LogLineOf(dvLast) & ' can run without it'
      exit
    elsif self.syms.IsColOneLabel(dvX)                                               ! (which re-fetches the token - the walk fetches its own next)
      dvWhy = 'a label on line ' & self.LogLineOf(dvX) & ' lies between the copy and ' & clip(dvBufTxt) & '''s read on line ' & |
              self.LogLineOf(dvLast) & ' - the read can be reached without the copy'
      exit
    end
  end
  dvDepth = 0                                                                        ! the opener the copy sits DIRECTLY inside
  loop dvX = dvLine1 - 1 to dvScCode + 1 by -1
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      dvDepth += 1
    of '+'
      if dvDepth
        dvDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          dvWhy = 'the copy is one arm of the EXECUTE on line ' & self.LogLineOf(dvX) & ', and a read of ' & clip(dvBufTxt) & ' is another'
        end
        break
      end
    end
  end

! ---- a line goes whole when it carries no comment. When it does, the statement goes and the comment
!      stays where the line was, on a line of its own at the line's indent (ruled 14 Sep 2026): the
!      EOL token is kept and its trivia becomes the indent and the comment.
DvDropLine routine
  self.LineBlocks(dvDelS, dvDelE, dvBlk)
  if ~dvDelCmt._DataEnd
    self.tk.DeleteToks(dvDelS, dvDelE)
  else
    self.IndentOf(dvDelS, dvIndSt)
    self.tk.DeleteToks(dvDelS, dvDelE - 1) ! the statement; the EOL now sits at dvDelS
    self.tk.SetStrBefore(dvDelS, dvIndSt.getValue() & dvDelCmt.getValue())
  end
  if dvBlk._DataEnd then self.tk.PrependStrBefore(dvDelS, dvBlk.getValue()).

! ---- the two names as the author spelled them
DvNames routine
  dvBufTxt = dvBuf ; dvSrcTxt = dvSrc
  loop dvX = dvLine1 to records(self.tk.tokens)
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    dvN = len(clip(self.tk.tokens.tok))
    if ~dvN then cycle.
    dvD = instring('.', self.tk.tokens.tok[1 : dvN], 1, 1)
    if dvD > 1
      if upper(self.tk.tokens.tok[1 : dvD - 1]) = dvBuf then dvBufTxt = self.tk.tokens.tok[1 : dvD - 1].
      if upper(self.tk.tokens.tok[1 : dvD - 1]) = dvSrc then dvSrcTxt = self.tk.tokens.tok[1 : dvD - 1].
    else
      if upper(self.tk.tokens.tok[1 : dvN]) = dvBuf then dvBufTxt = self.tk.tokens.tok[1 : dvN].
      if upper(self.tk.tokens.tok[1 : dvN]) = dvSrc then dvSrcTxt = self.tk.tokens.tok[1 : dvN].
    end
  end

! ---- every mention of the scratch after the copy line becomes the source. SetTok changes text
!      only, so nothing moves.
!      A case-folded copy also wraps each VALUE read in upper() or lower(): `buf.valuePtr[a : b]`
!      becomes `upper(src.valuePtr[a : b])`, `buf.getValue()` becomes `upper(src.getValue())`; a
!      length read is renamed only. The walk runs from the END of the procedure backwards, so the
!      tokens a wrap inserts never move a mention still to be visited.
DvRename routine
  dvEol = self.FirstEolAfter(dvLine1)
  loop dvX = dvScLast to dvEol + 1 by -1
    if dvX = dvBufDecl then cycle.
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    dvN = len(clip(self.tk.tokens.tok))
    if ~dvN then cycle.
    dvD = instring('.', self.tk.tokens.tok[1 : dvN], 1, 1)
    if dvD > 1
      if upper(self.tk.tokens.tok[1 : dvD - 1]) = dvBuf
        dvTail = upper(self.tk.tokens.tok[dvD + 1 : dvN])
        if dvSrcStr and dvTail = '_DATAEND' ! on a STRING: the length is len(src), the value is src itself
          self.tk.SetTok(dvX, 'len(' & clip(dvSrcTxt) & ')')
        elsif dvSrcStr and dvTail = 'VALUEPTR'
          self.tk.SetTok(dvX, clip(dvSrcTxt))
          if dvFold then do DvWrap.
        else
          self.tk.SetTok(dvX, clip(dvSrcTxt) & self.tk.tokens.tok[dvD : dvN])
          if dvFold and dvTail = 'VALUEPTR' then do DvWrap.
        end
      end
    elsif ~dvD
      if upper(self.tk.tokens.tok[1 : dvN]) = dvBuf
        dvTail = ''
        get(self.tk.tokens, dvX + 2)        ! the split spelling: buf . method ( ... )
        if ~errorcode() and not self.tk.tokens.tok &= NULL then dvTail = upper(self.tk.tokens.tok).
        get(self.tk.tokens, dvX)
        if dvSrcStr and dvTail = 'GETVALUE' ! buf.getValue() on a STRING source is the source itself
          self.tk.SetTok(dvX, choose(~dvFold, clip(dvSrcTxt), lower(clip(dvFold)) & '(' & clip(dvSrcTxt) & ')'))
          self.tk.DeleteToks(dvX + 1, dvX + 4)
        else
          self.tk.SetTok(dvX, clip(dvSrcTxt))
          if dvFold
            case dvTail
            of 'GETVALUE' orof 'GETVALUEPTR' orof 'SLICE' orof 'SUB'
              do DvWrap
            end
          end
        end
      end
    end
  end

! ---- wrap the read that starts at dvX in upper( ... ) / lower( ... ): the close is the bracket that
!      matches the '[' or '(' after the name; the close goes in first so dvX still holds
DvWrap routine
  dvY = 0
  get(self.tk.tokens, dvX + 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok = '['
    dvY = self.tk.MatchLeftBracket('[', ']', dvX + 1)
  else
    dvY = self.tk.MatchLeftBracket('(', ')', dvX + 3)
  end
  if dvY <= dvX then exit.
  self.tk.InsertString(dvY + 1, ')', 1)
  get(self.tk.tokens, dvX)  ! the read's own leading trivia moves in front of upper(
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL
    self.tk.InsertString(dvX, lower(clip(dvFold)) & '(', 1)
  else
    self.tk.InsertString(dvX, self.tk.tokens.strBefore & lower(clip(dvFold)) & '(', 1)
    self.tk.SetStrBefore(dvX + 2, '')
  end

! ---- the tokens of ONE physical line, uppercased, into dvQ
DvFill routine
  free(dvQ)
  dvNext = 0
  loop dvX = dvFrom to records(self.tk.tokens)
    get(self.tk.tokens, dvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      dvNext = dvX + 1 ; break
    end
    if dvX > dvFrom and self.tk.tokens.firstOnLine
      dvNext = dvX ; break
    end
    dvQ.tx = upper(self.tk.tokens.tok)
    dvQ.tk = dvX
    add(dvQ)
  end
  if ~dvNext then dvNext = records(self.tk.tokens) + 1.
  do DvJoin

! ---- a method CALL arrives as three tokens - `tmp` `.` `setValue` - because the tokenizer joins a dotted name
!      only when no '(' follows it; a property read arrives joined. Join the split ones here, so every routine
!      above sees ONE spelling: a row that is '.' between two names becomes one row.
DvJoin routine
  dvX = 2
  loop while dvX < records(dvQ)
    get(dvQ, dvX)
    if errorcode() then break.
    if dvQ.tx <> '.' then dvX += 1 ; cycle.
    get(dvQ, dvX - 1)
    if errorcode() or ~((dvQ.tx[1] >= 'A' and dvQ.tx[1] <= 'Z') or dvQ.tx[1] = '_') then dvX += 1 ; cycle.
    dvHead = dvQ.tx
    get(dvQ, dvX + 1)
    if errorcode() or ~((dvQ.tx[1] >= 'A' and dvQ.tx[1] <= 'Z') or dvQ.tx[1] = '_') then dvX += 1 ; cycle.
    dvTail = dvQ.tx
    delete(dvQ)   ! the tail row goes...
    get(dvQ, dvX)
    delete(dvQ)   ! ...and the dot
    get(dvQ, dvX - 1)
    dvQ.tx = clip(dvHead) & '.' & dvTail
    put(dvQ)
  end

! ---- dvHead = the RECEIVER in front of the dvQ row at dvHeadIx, in either spelling
DvHead routine
  dvHead = ''
  get(dvQ, dvHeadIx)
  if errorcode() then exit.
  dvN = len(clip(dvQ.tx))
  if ~dvN then exit.
  dvD = instring('.', dvQ.tx[1 : dvN], 1, 1)
  if dvD > 1
    dvHead = dvQ.tx[1 : dvD - 1]
    exit
  end
  if dvHeadIx < 3 then exit.
  get(dvQ, dvHeadIx - 1)
  if errorcode() or dvQ.tx <> '.' then exit.
  get(dvQ, dvHeadIx - 2)
  if ~errorcode() then dvHead = dvQ.tx.

!===============================================================================================
! BUILTIN TakeOverValue - a scratch loaded with a COPY of a local's value, where the local is
! never mentioned again, IS that local: the copy line goes and every later mention of the
! scratch names the source.
!     tmp.setValue(st.getValue())          st.split(',')
!     tmp.split(',')                ->     n = st.records()
!     n = tmp.records()
! The mirror of DropValueCopy: there the scratch only READS the copy; here it may do anything
! with it, because the source is dead. Exact only under these guards, and each refusal says
! which: the source is a StringTheory LOCAL of this procedure - a parameter's value is the
! caller's, a reference points elsewhere - never mentioned after the copy line, routines
! included, and no reference to it is taken anywhere, since that is a second name for it, nor is
! it handed before the copy to a call that may keep one - only to a call the summaries show reads
! it, or writes it and keeps nothing, or to a function on the pure list (ruled 28 Oct 2026); the
! source's LINES do not come over unseen - the hand-over is of the value, so when something
! before the copy may have given the source lines (a split or another lines-making call, a
! setValue with st:lines or an option that may hold it, a whole-object pass to a call) the scratch
! must throw its own lines away, with a split or freeLines that starts its line at the copy's own
! depth, before any lines call, setValue with st:lines (or such an option), or whole-object pass
! of its own; the scratch is a
! StringTheory local, not a reference, not STATIC or THREAD, not mentioned before the copy, and
! declared with the same type as the source, whose name its mentions take; the copy runs at most
! once per call - not in a routine, not inside a LOOP or ACCEPT, no label before it - since a
! second run would find the source already changed; the copy runs
! before every later mention of the scratch, the DropValueCopy walk: the structure holding the
! copy never ends before the last mention, no other branch of it begins, no label lies between,
! the copy is not an EXECUTE arm, and the last mention is not in a routine. A comment on the
! copy line stays where the line was, on a line of its own. UnusedVars then sweeps the
! scratch's declaration.
! Two scans on pass 1, as DropValueCopy does: the editing scan stops at its first edit.
!===============================================================================================
VitEngine.BuiltinTakeOverValue Procedure(StringTheory pLog)
i           long,auto
tvX         long,auto
tvY         long,auto
tvZ         long,auto
tvD         long,auto          ! instring scratch
tvN         long,auto          ! length scratch
tvLine1     long,auto          ! first token of the copy line
tvEol       long,auto          ! its EOL token
tvFrom      long,auto          ! TvFill: first token of the line in hand
tvNext      long,auto          !   and of the next
tvHeadIx    long               ! TvHead input
tvHead      STRING(vs:maxName) !   output
tvTail      STRING(96)
tvBuf       STRING(vs:maxName) ! the scratch, folded
tvSrc       STRING(vs:maxName) ! the source, folded
tvBufTxt    STRING(vs:maxName) !   and as the author spelled them
tvSrcTxt    STRING(vs:maxName)
tvScFirst   long,auto          ! the procedure
tvScLast    long,auto
tvScCode    long,auto
tvDataEnd   long,auto          ! the CODE statement: a mention above it is a declaration
tvSc        long,auto
tvLast      long,auto          ! first token of the scratch's last mention
tvBufDecl   long
tvWhy       STRING(200)
tvCmt       StringTheory       ! the copy line's trailing comment - kept where the line was, on a line of its own (ruled 14 Sep 2026)
tvIndSt     StringTheory       ! the line's indent, for the kept comment
tvBlk       StringTheory       ! an OMIT block folded in front of the copy line - it stays
tvRpt       byte               ! the report-only scan
tvEdited    byte
tvSums      byte               ! TvKeepAt: the summaries are built for this call
tvDepth     long,auto          ! TvOnce, TvRuns and TvDepthAt: structure depth
tvSrcLines  long               ! first token of a line before the copy that may give the source lines, 0 = none
tvByVal     byte               ! the copy is <src>.getValue() or getValuePtr(): the source's flags stay behind
tvSrcFlags  byte               !   and before it the source may have had them set - a fresh local has the defaults
tvArgTU     STRING(vs:maxName) ! TvSrcFlagsAt: the declared type of setValue's argument
tvArgRf     BYTE
tvBufLines  long               ! first token of the scratch's first use of its lines before a reset of them, 0 = none
tvBufReset  byte               ! the scratch has thrown its lines away: a split or freeLines starting its line at the copy's depth
tvHit       byte               ! TvStLinesArg out: the call may be given st:lines; TvBufLinesAt: the call is a reset
tvLinesMk   EQUATE(' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN ADDLINE INSERTLINE SETLINE SETLINEFROMVALUE LINES SWAP WRAPTEXT ') ! what gives an object lines
tvFlagRd    EQUATE(                                                                                                                                  |
  ' ADDBOM APIUTF8TOANSI ASNDECODE BASE64DECODE BASE64ENCODE BIGENDIAN CHARS DECENTITYTOCHAR DECODEHEXINLINE ENCODEDWORDDECODE ENCODEDWORDENCODE ' & |
    'EQUALS GUNZIP GZIP JSONDECODE LITTLEENDIAN NORMALIZE REMOVEHTML TOANSI TOUNICODE UTF16TOANSI UTF8TOANSI ENCODING BASE64 GZIPPED ENDIAN CODEPAGE ')
tvLinesNew  EQUATE(' SPLIT SPLITEVERY SPLITINTOWORDS SPLITBYMATCH SPLITBETWEEN FREELINES ') ! what throws the old lines away first
tvLinesUse  EQUATE(' RECORDS GETLINE GETLINES INLINE SETVALUEFROMLINE SETLINEFROMVALUE SETLINE ADDLINE INSERTLINE DELETELINE REMOVELINES SORT JOIN LINES SWAP ') ! what reads, or builds on, the lines it finds
tvQ         QUEUE,PRE(tv)
tx            STRING(96)
tk            long
            END
  code
  if self.syms &= NULL then return 0.
  self.syms.EnsureFresh()
  tvEdited = 0
  if self.curPass = 1
    tvRpt = 1 ; do TvScan
  end
  tvRpt = 0 ; do TvScan
  return tvEdited

! ---- every line of the file: the shape, the guards, and - unless this is the report-only scan - the edit
TvScan routine
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine then cycle.
    tvLine1 = i
    tvFrom = tvLine1 ; do TvFill
    do TvShape
    if ~tvBuf then cycle.
    tvWhy = ''
    do TvScope
    if ~tvScFirst then cycle.
    do TvNames
    do TvParamCheck
    if ~tvBuf then cycle.             ! no StringTheory local as the source: not a candidate
    if ~tvWhy then do TvUses.
    if ~tvWhy then do TvOnce.
    if ~tvWhy then do TvRuns.
    if tvWhy
      if tvRpt
        pLog.append('BUILTIN TakeOverValue line ' & self.LogLineOf(tvLine1) & ': REFUSED - ' & clip(tvWhy) & '.<13,10>')
      end
      cycle
    end
    if tvRpt then cycle.
    ! ---- THE EDIT: every later mention of the scratch names the source, then the copy line goes whole
    do TvRename
    tvEol = self.FirstEolAfter(tvLine1)
    if ~tvEol then cycle.
    tvX = self.LogLineOf(tvLine1)
    self.LineBlocks(tvLine1, tvEol, tvBlk)
    if ~tvCmt._DataEnd
      self.tk.DeleteToks(tvLine1, tvEol)
    else
      ! the statement goes; the EOL keeps the comment, at the line's indent
      self.IndentOf(tvLine1, tvIndSt)
      self.tk.DeleteToks(tvLine1, tvEol - 1)
      self.tk.SetStrBefore(tvLine1, tvIndSt.getValue() & tvCmt.getValue())
    end
    if tvBlk._DataEnd then self.tk.PrependStrBefore(tvLine1, tvBlk.getValue()).
    if not self.syms &= NULL then self.syms.dirty = 1.
    pLog.append('BUILTIN TakeOverValue line ' & tvX & ': ' & clip(tvSrcTxt) & ' is never used after the copy, so ' & |
                clip(tvBufTxt) & ' takes it over - its later uses name ' & clip(tvSrcTxt) & ' and the copy goes'   & |
                choose(~tvCmt._DataEnd, '', ' - its comment stays, on a line of its own') & '.<13,10>')
    tvEdited = 1
    exit
  end

! ---- <buf>.setValue( <src>.getValue() | <src>.getValuePtr() | <src> ) and nothing else on the line
TvShape routine
  tvBuf = '' ; tvSrc = '' ; tvByVal = 0
  if records(tvQ) < 4 then exit.
  tvHeadIx = 1 ; do TvHead
  get(tvQ, 1)
  tvN = len(clip(tvQ.tx))
  tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
  if ~tvHead or ~tvD or tvD >= tvN or tvQ.tx[tvD + 1 : tvN] <> 'SETVALUE' then exit. ! one spelling: TvFill joined the split one
  get(tvQ, 2)
  if tvQ.tx <> '(' then exit.
  get(tvQ, 3)
  tvN = len(clip(tvQ.tx))
  tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
  if tvD > 1 and tvD < tvN
    if tvQ.tx[tvD + 1 : tvN] <> 'GETVALUE' and tvQ.tx[tvD + 1 : tvN] <> 'GETVALUEPTR' then exit.
    if records(tvQ) <> 6 then exit.                                                  ! <src>.getValue ( ) )
    get(tvQ, 4) ; if tvQ.tx <> '(' then exit.
    get(tvQ, 5) ; if tvQ.tx <> ')' then exit.
    get(tvQ, 6) ; if tvQ.tx <> ')' then exit.
    get(tvQ, 3)
    tvSrc = tvQ.tx[1 : tvD - 1]
    tvByVal = 1
  else
    if records(tvQ) <> 4 then exit.                                                  ! <src> )
    get(tvQ, 4) ; if tvQ.tx <> ')' then exit.
    get(tvQ, 3)
    if tvD then exit.
    tvSrc = tvQ.tx
  end
  if ~((tvSrc[1] >= 'A' and tvSrc[1] <= 'Z') or tvSrc[1] = '_') then exit.           ! a literal or an expression is no source
  tvBuf = tvHead
  if tvSrc = tvBuf then tvBuf = ''.

! ---- the procedure and the end of its header
TvScope routine
  tvScFirst = 0 ; tvScLast = 0 ; tvScCode = 0
  tvSc = self.syms.ScopeContaining(tvLine1, vs:scProc, vs:scMethod)
  if ~tvSc then exit.
  self.syms.scopes.scopeId = tvSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  tvScFirst = self.syms.scopes.startTok
  tvScLast  = self.syms.scopes.endTok
  tvZ = 0
  loop tvX = tvScFirst to records(self.tk.tokens)
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      tvZ += 1
    elsif self.tk.tokens.tok = ')'
      tvZ -= 1
      if ~tvZ then tvScCode = tvX ; break.
    elsif ~tvZ and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      tvScCode = tvX ; break
    end
  end
  if ~tvScCode then tvScCode = tvScFirst.

! ---- both must be StringTheory LOCALS of this procedure: the scratch because it is renamed away,
!      the source because its value is handed over - a parameter's value is the caller's, and a
!      reference points at something with a life of its own. A source that is not a StringTheory
!      declared here is not a candidate at all, so it is passed over in silence, not refused.
!      Neither may be STATIC or THREAD: such a source keeps the changes for the next call, and such
!      a scratch comes to the copy holding the lines and flags the last call left in it. And the two
!      are declared with the same type, since every later mention of the scratch is renamed onto
!      the source (RenameTypeWhy).
TvParamCheck routine
  tvBufDecl = 0
  tvZ = self.syms.FindOwn(tvSrc, tvSc)
  if ~tvZ then tvBuf = '' ; exit.
  get(self.syms.syms, tvZ)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' then tvBuf = '' ; exit.
  tvZ = self.syms.FindOwn(tvBuf, tvSc)
  if ~tvZ then tvWhy = clip(tvBufTxt) & ' is not declared in this procedure' ; exit.
  get(self.syms.syms, tvZ)
  tvBufDecl = self.syms.syms.declTok
  if errorcode() or (self.syms.syms.declTok > tvScFirst and self.syms.syms.declTok <= tvScCode)
    tvWhy = clip(tvBufTxt) & ' is a PARAMETER, so it is not this procedure''s to rename'
    exit
  end
  if self.syms.syms.typeU <> 'STRINGTHEORY' then tvWhy = clip(tvBufTxt) & ' is not a StringTheory' ; exit.
  if self.syms.syms.isRef then tvWhy = clip(tvBufTxt) & ' is a reference - what it points at is not this procedure''s to rename' ; exit.
  if self.DeclHasAttr(tvBufDecl, 'STATIC') or self.DeclHasAttr(tvBufDecl, 'THREAD')
    tvWhy = clip(tvBufTxt) & ' is STATIC or THREAD - it keeps the lines and flags the last call left in it, which ' & |
            clip(tvSrcTxt) & ' would not have'
    exit
  end
  tvZ = self.syms.FindOwn(tvSrc, tvSc)
  get(self.syms.syms, tvZ)
  if errorcode() or (self.syms.syms.declTok > tvScFirst and self.syms.syms.declTok <= tvScCode)
    tvWhy = clip(tvSrcTxt) & ' is a PARAMETER - its value is the caller''s, and the caller may read it again'
    exit
  end
  if self.syms.syms.isRef then tvWhy = clip(tvSrcTxt) & ' is a reference - what it points at may be read again elsewhere' ; exit.
  if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD')
    tvWhy = clip(tvSrcTxt) & ' is STATIC or THREAD - its value lasts to the next call, which would see the changes'
  end
  if ~tvWhy then tvWhy = self.RenameTypeWhy(tvBuf, tvSrc, tvSc).
  if ~tvWhy then do TvAlias.

! ---- the source reached another way: a reference taken on it or on its buffer with &=, which could
!      read the value the copy was to keep; or the object given state a getValue() copy does not
!      carry - Stream(), whose file receives the value, UseBuffer() or CleanBuffer() - which the
!      hand-over would move
TvAlias routine
  data
k   long,auto
t   STRING(vs:maxName),auto
  code
  loop k = tvScFirst to tvScLast
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    t = upper(self.tk.tokens.tok)
    if t = '&='
      if self.NameRoot(self.tk.GetTok(k + 1)) = tvSrc
        tvWhy = 'a reference is taken on ' & clip(tvSrcTxt) & ' on line ' & self.LogLineOf(k) & ', and it could read the value the copy was to keep'
        exit
      end
      cycle
    end
    if t <> tvSrc then cycle.
    if self.tk.GetTok(k + 1) <> '.' then cycle.
    case upper(self.tk.GetTok(k + 2))
    of 'STREAM' orof 'USEBUFFER' orof 'CLEANBUFFER'
      tvWhy = clip(tvSrcTxt) & '.' & lower(clip(self.tk.GetTok(k + 2))) & ' on line ' & self.LogLineOf(k) & ' gives it state a copy of its value does not carry'
      exit
    end
  end

! ---- every OTHER line of the procedure, routines included: the scratch is not mentioned before
!      the copy, the source is not mentioned after it, and the scratch IS mentioned after it; the
!      source's mentions before the copy say whether it may carry lines, and the scratch's after
!      it whether those lines would be found; the copy line's comment, if any, is kept for a line
!      of its own. A method of a class the procedure declares shares its data, and its body lies
!      outside this walk: either name used in one refuses. So does an INCLUDE in the procedure,
!      whose code is not in this file.
TvUses routine
  if self.MayHaveLocalMethods(tvSc) and self.UsedInLocalMethods(upper(tvSrc), tvScFirst, tvScLast)
    tvWhy = clip(tvSrcTxt) & ' is used in a method of a class this procedure declares, which could read it after the copy'
    exit
  end
  if self.MayHaveLocalMethods(tvSc) and self.UsedInLocalMethods(upper(tvBuf), tvScFirst, tvScLast)
    tvWhy = clip(tvBufTxt) & ' is used in a method of a class this procedure declares, which the hand-over would not reach'
    exit
  end
  if self.ScopeIncludes(tvSc)
    tvWhy = clip(tvSrcTxt) & ' and ' & clip(tvBufTxt) & ' may be read or changed by code the procedure INCLUDEs, which this file does not hold'
    exit
  end
  tvLast = 0
  tvSrcLines = 0 ; tvBufLines = 0 ; tvBufReset = 0 ; tvSrcFlags = 0
  tvDataEnd = self.CodeTokOfScope(tvScFirst, tvScLast)
  tvCmt.free()                                             ! a comment on the copy line is kept where the line
  get(self.tk.tokens, self.FirstEolAfter(tvLine1))         !   was, on a line of its own (ruled 14 Sep 2026)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    tvX = pLog.findByte(33, 1,, self.tk.tokens.strBefore)  ! '!'
    if tvX then tvCmt.setValue(self.tk.tokens.strBefore[tvX : size(self.tk.tokens.strBefore)]).
  end
  tvFrom = tvScFirst
  loop while tvFrom > 0 and tvFrom < tvScLast
    do TvFill
    if tvFrom = tvBufDecl or tvFrom = tvLine1 then tvFrom = tvNext ; cycle.
    loop tvX = 1 to records(tvQ)
      tvHeadIx = tvX ; do TvHead
      get(tvQ, tvX)
      if errorcode() then break.
      if tvHead = tvBuf or tvQ.tx = tvBuf
        if tvFrom < tvLine1
          tvWhy = clip(tvBufTxt) & ' is mentioned before the copy, on line ' & self.LogLineOf(tvFrom) & ' - the copy is not the start of its life'
          exit
        end
        tvLast = tvFrom
        if tvByVal and tvSrcFlags then do TvFlagUse.
        if tvWhy then exit.
        if ~tvBufLines and ~tvBufReset then do TvBufLinesAt.
      elsif tvHead = tvSrc or tvQ.tx = tvSrc
        if tvFrom > tvLine1
          tvWhy = clip(tvSrcTxt) & ' is used again on line ' & self.LogLineOf(tvFrom) & ', after the copy - it is a copy, not a hand-over'
          exit
        end
        do TvSrcLinesAt
        if ~tvWhy and tvByVal then do TvSrcFlagsAt.
        if tvWhy then exit.
      end
    end
    if tvWhy then break.
    tvFrom = tvNext
  end
  if tvWhy then exit.
  if ~tvLast then tvWhy = clip(tvBufTxt) & ' is never used after the copy, so there is nothing to take over' ; exit.
  if tvSrcLines and tvBufLines
    tvWhy = clip(tvSrcTxt) & ' may carry lines from line ' & self.LogLineOf(tvSrcLines) & ', and ' & clip(tvBufTxt) & |
       ' uses its lines on line ' & self.LogLineOf(tvBufLines) & ' before any split of its own - the lines would come over with the value'
  end

! ---- before a getValue() copy: may this mention of the source, at row tvX, have set its encoding, base64 or gzip
!      flags? A method that sets them, a setValue from another object (which copies them), a one-argument
!      setValue of a USTRING (which gives the UTF-16 encoding), or the source handed whole to a call.
!      A source set only from text keeps the defaults a fresh local starts with. The argument is read
!      from the token stream: tvQ holds one physical line, and a call wrapped with '|' puts it on the next.
TvSrcFlagsAt routine
  data
ta   STRING(vs:maxName),auto
  code
  if self.ignoreMarks then exit.                                                        ! --ignoremarks
  if tvFrom < tvDataEnd then exit.
  get(tvQ, tvX)
  if errorcode() then exit.
  if tvHead = tvSrc
    tvN = len(clip(tvQ.tx))
    tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
    if tvD and tvD < tvN
      tvTail = tvQ.tx[tvD + 1 : tvN]
    else
      tvTail = tvQ.tx
    end
    if instring(' ' & clip(tvTail) & ' ', fl:writers, 1, 1) or instring(' ' & clip(tvTail) & ' ', fl:state, 1, 1) then tvSrcFlags = 1 ; exit.
    if instring(' ' & clip(tvTail) & ' ', tvLinesNew, 1, 1) then tvSrcFlags = 1 ; exit. ! a split sets EndOfLastLine, which the copy leaves behind
    if tvTail <> 'SETVALUE' and tvTail <> 'APPEND' then exit.
    ta = upper(self.tk.GetTok(tvQ.tk + 4))                                              ! setValue(<name>) or append(<name>)
    if self.tk.GetTok(tvQ.tk + 3) <> '(' or ~((ta[1] >= 'A' and ta[1] <= 'Z') or ta[1] = '_') then exit.
    if self.syms &= NULL or ~self.syms.Lookup(ta, tvFrom, tvArgTU, tvArgRf) or upper(tvArgTU) = 'STRINGTHEORY'
      tvSrcFlags = 1                                                                    ! an object, or a name nothing declares
    end
    if tvTail = 'SETVALUE' and upper(tvArgTU) = 'USTRING'
      if self.tk.GetTok(tvQ.tk + 5) = ')' then tvSrcFlags = 1.
    end
    exit
  end
  get(tvQ, tvX + 1)
  if ~errorcode() and tvQ.tx = '.' then exit.                                           ! the head of a split dotted form
  tvSrcFlags = 1                                                                        ! handed whole to a call

! ---- a getValue() copy: the scratch kept its own encoding, base64 and gzip flags, and a take-over gives it the
!      source's - so no use of the scratch may read them, nor may it be handed whole to a call, which could
!      read them too
TvFlagUse routine
  get(tvQ, tvX)
  if errorcode() then exit.
  if tvHead = tvBuf
    tvN = len(clip(tvQ.tx))
    tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
    if tvD and tvD < tvN
      tvTail = tvQ.tx[tvD + 1 : tvN]
    else
      tvTail = tvQ.tx
    end
    if instring(' ' & clip(tvTail) & ' ', tvFlagRd, 1, 1) or instring(' ' & clip(tvTail) & ' ', fl:state, 1, 1)
      tvWhy = clip(tvBufTxt) & '.' & lower(clip(tvTail)) & ' on line ' & self.LogLineOf(tvFrom) & ' reads the encoding, base64 or gzip flags, which a getValue() copy does not carry'
    end
    exit
  end
  get(tvQ, tvX + 1)
  if ~errorcode() and tvQ.tx = '.' then exit. ! the head of a split dotted form
  tvWhy = clip(tvBufTxt) & ' is handed whole to a call on line ' & self.LogLineOf(tvFrom) & ', which could read the flags a getValue() copy does not carry'

! ---- a mention of the source on a line before the copy, at row tvX of tvQ. A reference taken on
!      it refuses: a second name for the source, which the walk above cannot follow. A call that
!      gives it lines, a setValue with st:lines, or the object handed whole to a call - which could
!      split it - marks the source as one that may carry lines at the copy.
TvSrcLinesAt routine
  if tvFrom < tvDataEnd then exit.            ! a declaration, not a use: it gives the source no lines
  get(tvQ, tvX)
  if errorcode() then exit.
  if tvHead = tvSrc
    tvN = len(clip(tvQ.tx))
    tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
    if tvD and tvD < tvN
      tvTail = tvQ.tx[tvD + 1 : tvN]
    else
      tvTail = tvQ.tx
    end
    if instring(' ' & clip(tvTail) & ' ', tvLinesMk, 1, 1)
      if ~tvSrcLines then tvSrcLines = tvFrom.
    elsif tvTail = 'SETVALUE' or tvTail = 'APPEND' or tvTail = 'PREPEND'
      do TvStLinesArg
      if tvHit and ~tvSrcLines then tvSrcLines = tvFrom.
    end
    exit
  end
  get(tvQ, tvX + 1)
  if ~errorcode() and tvQ.tx = '.' then exit.                                     ! the head of a split dotted form - its tail is judged next
  if tvX > 1
    get(tvQ, tvX - 1)
    if ~errorcode() and tvQ.tx = '&='
      tvWhy = 'a reference to ' & clip(tvSrcTxt) & ' is taken on line ' & self.LogLineOf(tvFrom) & ' - a second name for it, through which it can be read or changed unseen'
      exit
    end
  end
  do TvKeepAt
  if tvWhy then exit.
  if ~tvSrcLines then tvSrcLines = tvFrom.                                        ! handed whole to a call, which could split it

! ---- the source handed whole to a call before the copy, at row tvX: a call that may KEEP a
!      reference to it could read it after the hand-over, when it holds what the scratch did. So
!      the call must be one the summaries show only reads it, or writes it and keeps nothing, or a
!      function on the pure list; a call the tool cannot see into refuses (ruled 28 Oct 2026, the
!      rule DeadTrim follows for a call before the split). tvQ holds one physical line, and a call
!      carried on with '|' puts its argument first on the next one, so the token before the source
!      is read from the token stream, whatever line it is on.
TvKeepAt routine
  data
sU   STRING(vs:maxName),auto
  code
  get(tvQ, tvX)
  if errorcode() then exit.
  sU = self.tk.GetTok(tvQ.tk - 1)
  if sU <> '(' and sU <> ',' then exit.
  sU = ''
  self.syms.scopes.scopeId = tvSc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if ~errorcode() then sU = self.syms.scopes.selfClass.
  if ~tvSums then self.BuildSummaries() ; tvSums = 1.
  get(tvQ, tvX)
  if inlist(self.ArgFact(tvQ.tk, sU), 'R', 'W', 'P', 'F') then exit.
  tvWhy = clip(tvSrcTxt) & ' is handed whole to a call on line ' & self.LogLineOf(tvFrom) &    |
          ' before the copy, which may keep a reference to it and read it after the hand-over'

! ---- a mention of the scratch after the copy, at row tvX of tvQ, while its lines are still the
!      ones it was declared with. A split or freeLines that starts its line at the copy's own
!      depth throws them away, and nothing after it can find the source's; one deeper in, or not
!      first on its line, may not run. Any other lines call, a setValue with st:lines, or the
!      object handed whole to a call - which could read them - is a use of the lines it finds.
TvBufLinesAt routine
  get(tvQ, tvX)
  if errorcode() then exit.
  if tvHead = tvBuf
    tvN = len(clip(tvQ.tx))
    tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
    if tvD and tvD < tvN
      tvTail = tvQ.tx[tvD + 1 : tvN]
    else
      tvTail = tvQ.tx
    end
    tvHit = 0
    if instring(' ' & clip(tvTail) & ' ', tvLinesNew, 1, 1)
      tvHit = 1
    elsif tvTail = 'FREE'
      get(tvQ, tvX + 2)
      if ~errorcode() and tvQ.tx <> ')' then tvHit = 1. ! free(true) frees the lines too
    end
    if tvHit
      if tvX = 1
        do TvDepthAt
        ! a split a build may leave out resets nothing
        if ~tvDepth and ~self.InCondBlock(tvFrom) then tvBufReset = 1.
      end
      exit
    end
    if instring(' ' & clip(tvTail) & ' ', tvLinesUse, 1, 1)
      tvBufLines = tvFrom
    elsif tvTail = 'SETVALUE' or tvTail = 'APPEND' or tvTail = 'PREPEND'
      do TvStLinesArg
      if tvHit then tvBufLines = tvFrom.
    end
    exit
  end
  get(tvQ, tvX + 1)
  if ~errorcode() and tvQ.tx = '.' then exit.                                     ! the head of a split dotted form - its tail is judged next
  tvBufLines = tvFrom                                                             ! handed whole to a call, or named by a reference

! ---- tvHit = the call named at row tvX is given st:lines, the setValue option that copies lines in, or
!      an option that may hold it (LinesOptAt). Read from the token stream to the call's own ')': tvQ
!      holds one physical line, and a call wrapped with '|' carries its arguments on to the next
TvStLinesArg routine
  tvHit = 0
  get(tvQ, tvX)
  if errorcode() then exit.
  if self.LinesOptAt(tvQ.tk) then tvHit = 1.

! ---- tvDepth = how many structures opened after the copy line are still open at the line at tvFrom
TvDepthAt routine
  tvDepth = 0
  loop tvZ = self.FirstEolAfter(tvLine1) + 1 to tvFrom - 1
    get(self.tk.tokens, tvZ)
    if errorcode() then break.
    if self.tk.tokens.level = '+' then tvDepth += 1.
    if self.tk.tokens.level = '-' then tvDepth -= 1.
  end

! ---- the copy runs at most once per call: not in a routine, not inside a LOOP or ACCEPT at any
!      depth, no label above it - a second run would find the source already changed
TvOnce routine
  if self.syms.ScopeContaining(tvLine1, vs:scRoutine, vs:scRoutine)
    tvWhy = 'the copy is in a routine, which may run more than once - a second run would find ' & clip(tvSrcTxt) & ' already changed'
    exit
  end
  tvDepth = 0
  loop tvX = tvLine1 - 1 to tvScCode + 1 by -1
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.firstOnLine and upper(self.tk.tokens.tok) = 'CODE' then break. ! the data section: declarations, not labels
    if self.syms.IsColOneLabel(tvX)
      tvWhy = 'a label on line ' & self.LogLineOf(tvX) & ' lies before the copy, so it can be reached again - a second run would find ' & clip(tvSrcTxt) & ' already changed'
      exit
    end
    case self.tk.tokens.level
    of '-'
      tvDepth += 1
    of '+'
      if tvDepth
        tvDepth -= 1
      else
        tvN = len(clip(self.tk.tokens.tok))
        if tvN and (upper(self.tk.tokens.tok[1 : tvN]) = 'LOOP' or upper(self.tk.tokens.tok[1 : tvN]) = 'ACCEPT')
          tvWhy = 'the copy is inside the loop on line ' & self.LogLineOf(tvX) & ', so it may run more than once - a second run would find ' & clip(tvSrcTxt) & ' already changed'
          exit
        end
      end
    end
  end

! ---- the copy must RUN before every later mention. The mentions lie between the copy and the
!      last of them, so: the last mention is not in a routine; walking from the copy to it, the
!      structure holding the copy never ends, no other branch of it begins, and no label offers a
!      way in; and the copy is not itself one arm of an EXECUTE
TvRuns routine
  if self.InCondBlock(tvLine1)
    tvWhy = 'the copy on line ' & self.LogLineOf(tvLine1) & ' is inside a COMPILE or OMIT block, which a build may leave out'
    exit
  end
  if self.syms.ScopeContaining(tvLast, vs:scRoutine, vs:scRoutine)
    tvWhy = clip(tvBufTxt) & ' is used on line ' & self.LogLineOf(tvLast) & ' in a routine, which may run before the copy'
    exit
  end
  tvDepth = 0
  tvEol = self.FirstEolAfter(tvLine1)
  tvY = self.FirstEolAfter(tvLast)
  loop tvX = tvEol + 1 to tvY
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.level = '+'
      tvDepth += 1
    elsif self.tk.tokens.level = '-'
      tvDepth -= 1
      if tvDepth < 0
        tvWhy = 'the structure holding the copy ends on line ' & self.LogLineOf(tvX) & ', before ' & clip(tvBufTxt) & '''s use on line ' & |
                self.LogLineOf(tvLast) & ' - the use can run without the copy'
        exit
      end
    elsif self.tk.tokens.level = '/' and ~tvDepth
      tvWhy = 'line ' & self.LogLineOf(tvX) & ' begins another branch of the structure holding the copy, so ' & clip(tvBufTxt) & '''s use on line ' & |
              self.LogLineOf(tvLast) & ' can run without it'
      exit
    elsif self.syms.IsColOneLabel(tvX)                                              ! (which re-fetches the token - the walk fetches its own next)
      tvWhy = 'a label on line ' & self.LogLineOf(tvX) & ' lies between the copy and ' & clip(tvBufTxt) & '''s use on line ' & |
              self.LogLineOf(tvLast) & ' - the use can be reached without the copy'
      exit
    end
  end
  tvDepth = 0                                                                       ! the opener the copy sits DIRECTLY inside
  loop tvX = tvLine1 - 1 to tvScCode + 1 by -1
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case self.tk.tokens.level
    of '-'
      tvDepth += 1
    of '+'
      if tvDepth
        tvDepth -= 1
      else
        if upper(self.tk.tokens.tok) = 'EXECUTE'
          tvWhy = 'the copy is one arm of the EXECUTE on line ' & self.LogLineOf(tvX) & ', and a use of ' & clip(tvBufTxt) & ' is another'
        end
        break
      end
    end
  end

! ---- the two names as the author spelled them
TvNames routine
  tvBufTxt = tvBuf ; tvSrcTxt = tvSrc
  loop tvX = tvLine1 to records(self.tk.tokens)
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break.
    tvN = len(clip(self.tk.tokens.tok))
    if ~tvN then cycle.
    tvD = instring('.', self.tk.tokens.tok[1 : tvN], 1, 1)
    if tvD > 1
      if upper(self.tk.tokens.tok[1 : tvD - 1]) = tvBuf then tvBufTxt = self.tk.tokens.tok[1 : tvD - 1].
      if upper(self.tk.tokens.tok[1 : tvD - 1]) = tvSrc then tvSrcTxt = self.tk.tokens.tok[1 : tvD - 1].
    else
      if upper(self.tk.tokens.tok[1 : tvN]) = tvBuf then tvBufTxt = self.tk.tokens.tok[1 : tvN].
      if upper(self.tk.tokens.tok[1 : tvN]) = tvSrc then tvSrcTxt = self.tk.tokens.tok[1 : tvN].
    end
  end

! ---- every mention of the scratch after the copy line names the source. SetTok changes text
!      only, so nothing moves.
TvRename routine
  tvEol = self.FirstEolAfter(tvLine1)
  loop tvX = tvEol + 1 to tvScLast
    if tvX = tvBufDecl then cycle.
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    tvN = len(clip(self.tk.tokens.tok))
    if ~tvN then cycle.
    tvD = instring('.', self.tk.tokens.tok[1 : tvN], 1, 1)
    if tvD > 1
      if upper(self.tk.tokens.tok[1 : tvD - 1]) = tvBuf
        self.tk.SetTok(tvX, clip(tvSrcTxt) & self.tk.tokens.tok[tvD : tvN])
      end
    elsif ~tvD
      if upper(self.tk.tokens.tok[1 : tvN]) = tvBuf then self.tk.SetTok(tvX, clip(tvSrcTxt)).
    end
  end

! ---- the tokens of ONE physical line, uppercased, into tvQ
TvFill routine
  free(tvQ)
  tvNext = 0
  loop tvX = tvFrom to records(self.tk.tokens)
    get(self.tk.tokens, tvX)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      tvNext = tvX + 1 ; break
    end
    if tvX > tvFrom and self.tk.tokens.firstOnLine
      tvNext = tvX ; break
    end
    tvQ.tx = upper(self.tk.tokens.tok)
    tvQ.tk = tvX
    add(tvQ)
  end
  if ~tvNext then tvNext = records(self.tk.tokens) + 1.
  do TvJoin

! ---- a method CALL arrives as three tokens - `tmp` `.` `setValue` - because the tokenizer joins a dotted name
!      only when no '(' follows it; a property read arrives joined. Join the split ones here, so every routine
!      above sees ONE spelling: a row that is '.' between two names becomes one row.
TvJoin routine
  tvX = 2
  loop while tvX < records(tvQ)
    get(tvQ, tvX)
    if errorcode() then break.
    if tvQ.tx <> '.' then tvX += 1 ; cycle.
    get(tvQ, tvX - 1)
    if errorcode() or ~((tvQ.tx[1] >= 'A' and tvQ.tx[1] <= 'Z') or tvQ.tx[1] = '_') then tvX += 1 ; cycle.
    tvHead = tvQ.tx
    get(tvQ, tvX + 1)
    if errorcode() or ~((tvQ.tx[1] >= 'A' and tvQ.tx[1] <= 'Z') or tvQ.tx[1] = '_') then tvX += 1 ; cycle.
    tvTail = tvQ.tx
    delete(tvQ)   ! the tail row goes...
    get(tvQ, tvX)
    delete(tvQ)   ! ...and the dot
    get(tvQ, tvX - 1)
    tvQ.tx = clip(tvHead) & '.' & tvTail
    put(tvQ)
  end

! ---- tvHead = the RECEIVER in front of the tvQ row at tvHeadIx, in either spelling
TvHead routine
  tvHead = ''
  get(tvQ, tvHeadIx)
  if errorcode() then exit.
  tvN = len(clip(tvQ.tx))
  if ~tvN then exit.
  tvD = instring('.', tvQ.tx[1 : tvN], 1, 1)
  if tvD > 1
    tvHead = tvQ.tx[1 : tvD - 1]
    exit
  end
  if tvHeadIx < 3 then exit.
  get(tvQ, tvHeadIx - 1)
  if errorcode() or tvQ.tx <> '.' then exit.
  get(tvQ, tvHeadIx - 2)
  if ~errorcode() then tvHead = tvQ.tx.
VitEngine.BuiltinInlineSingleUse Procedure(StringTheory pLog)
n         long,auto
i         long,auto
j         long,auto
s         long,auto
sc        long,auto                ! scope holding the candidate store
symRow    long,auto
sS        long,auto                ! first token of the store statement
sE        long,auto                ! last token of it
nS        long,auto                ! first token of the NEXT statement
nE        long,auto                ! last token of it
delE      long,auto                ! last token to delete - sE plus its EOL
occ       long,auto                ! the single read of the target in the next statement
reads     long,auto
writes    long,auto
bail      byte,auto
isLbl     byte,auto
isuN      long,auto                ! occurrences of the target in the whole scope
isuST     byte,auto                ! the StringTheory spelling of the shape: name.setValue(<expr>) / name.getValue()
impure    byte,auto                ! (8) the expression calls something not on the pure list
anyCall   byte,auto                ! (8c) the expression holds a CALL, pure or not - safe to write twice, never free to RUN twice
relaxOK   byte,auto                ! (8b) ... and the next statement runs it exactly once, first, and calls nothing else
isuCalBad byte,auto                ! (8d) a call in the next statement runs before the read and could change an operand
isuCk     long,auto                ! (8d) scratch: a call found, an operand's row
isuCkR    long,auto                ! (8d) the operand being judged
occE      long,auto                ! last token of the read: occ itself, or the ')' of name.getValue()
expS      long,auto                ! the expression span: after '=' or inside setValue's brackets
expE      long,auto
isuParen  long,auto                ! bracket depth while looking for a second argument
isuPrv    string(4)                ! (6e) the tokens either side of the read
isuNxt    string(4)
isuVerb   string(8)                ! (11) the statement word after the store
! ---- (10) the liveness walk. See the long comment at the test itself. -----------------------
isuDep    long,auto                ! structure depth while walking the scope
isuNextB  long,auto                ! block-id generator - a NEW id every time a block opens
isuBlkS   long,auto                ! block id of the store
isuBlkO   long,auto                ! block id of the read
isuInBlk  long,auto                ! occurrences of the name inside the store's own block
isuStrand long,auto                ! reads elsewhere that no earlier write in their own block kills
isuStk    long,dim(isu:maxDepth)   ! block id currently open at each depth
isuWr     long,dim(isu:maxDepth)   ! has a WRITE to the name been seen in the block open at this depth? Reset when a block opens, so a write inside an IF cannot count as killing the value for code outside it.
isuWrPend long                     ! the slot a write on this line kills - applied at the end of the line, so the reads beside it still see the old value
isuA      long                     ! the depths around the store, cleared when the walk reaches it
isuOver   byte,auto                ! depth ran past the array - refuse rather than guess
isuLvl    string(1),auto           ! the row's level, read BEFORE anything else can move the buffer
isuHit    byte,auto                ! this token IS the name
isuSafe   byte,auto                ! the liveness verdict for this candidate
isuPend   long,auto                ! opens seen on this LINE, applied at its end - a structure header belongs to the block containing it, not to the one it opens
isuRoot   string(vs:maxName)       ! root of the expression, for the GET guard
! ---- (6c) further reads of a PURE expression - ruled 14 Sep 2026. See the note at the test. ----
isuXN     long                     ! extra reads found: in the next statement (6c) and below it (10c)
isuWrAft  byte                     ! a write to the name seen after the store, in token order - no extra read may follow it
isuDom    byte                     ! IsuDominated out: the store's block is the current block or an ancestor of it
isuKnown  byte                     ! IsuKnownExtra out: token j is already in IsuXQ; IsuExtraRead sets it when it adds one
isuOpBad  byte                     ! IsuOperandsStill out: an operand may have changed before the last extra read
isuOpEnd  long                     ! the last extra read's token - the operand walk runs from the store to it
isuOpDep  long                     ! bracket depth in that walk
isuOpImp  long                     ! how many of the open brackets belong to a call NOT on the pure list
isuLpAt   long                     ! a LOOP or ACCEPT opened after the store and still open: its back edge reaches the read
isuLpD    long                     !   the depth it opened at
isuGd     long                     !   and the structure depth walking from the store
isuOpK    long                     ! walk cursors
isuOpM    long
isuOpJ    long
isuBrk    byte                     ! IsuBracket out: the expression needs brackets where it is written
isuSubBad byte                     ! IsuSubUse out: a subscript after the read is written, or the expression takes none
isuStArg  byte                     ! IsuStoreArg out: the read is the whole argument of SIZE or ADDRESS
isuOpCol  byte                     ! IsuOperands out: the expression holds a name with a colon - a prefixed field or an equate
isuArmS   long                     ! IsuOperandsStill: the structure the next statement opens, and where it ends - a
isuArmE   long                     !   write in one of its arms cannot reach a read in another
isuArmD   long                     !   depth inside it
isuOpPre  byte                     !   a write seen before that structure, which reaches every arm
isuOpU    string(vs:maxName)
isuOpStk  long,dim(isu:maxDepth)   ! per open bracket: 1 when it is such a call's
IsuXQ QUEUE,PRE(ix)                ! the extra reads, in token order
xOcc      long
xOccE     long
      END
IsuOpQ QUEUE,PRE(io)               ! the expression's operand roots, UPPER
nm        string(vs:maxName)
      END
IsuEdQ QUEUE,PRE(ie)               ! the staged edits by POSITION, highest first: a read (1) or a store line (2)
pos       long
kind      byte
row       long                     !   the IsuQ row it belongs to
      END
nameU      string(vs:maxName),auto
tU         string(vs:maxName),auto
callU      string(vs:maxName),auto
pureU      StringTheory            ! ' NAME NAME ... ' - space delimited, UPPER
isuOwnU    StringTheory            ! the names on it this file gives a procedure of its own
expTxt     StringTheory            ! <expr> as written, spacing and all
isuFold    string(5)               ! (4b) 'UPPER' / 'LOWER' when the line after the store folds the object's case - the expression is then wrapped in it
isuKept    long,auto               ! comments kept from a dropped store line (log)
foldTok    long                    !      the object's token on that line: part of the store to the liveness walk
foldE      long                    !      and that line's EOL, which the delete range then runs to
changes    long
IsuQ  QUEUE,PRE(iq)
qOcc      long                     ! read token to overwrite with the expression
qOccE     long                     !   and the last token of the read - beyond qOcc for name.getValue()
qDelS     long                     ! store statement, first token
qDelE     long                     ! store statement, last token INCLUDING its EOL
qExpS     long                     ! the expression span, rendered at apply time
qExpE     long
qLn       long                     ! source line of the store, for the log
qNm       string(vs:maxName)
qFold     string(5)                ! 'UPPER' / 'LOWER' when the expression is written wrapped in it
      END
  code
  self.lmProcS = -1
  free(IsuQ)                                                                       ! local QUEUEs persist between calls
  if self.tk &= NULL then return 0.
  if self.syms &= NULL then return 0.
  self.IfCasePureList(pureU)
  self.PureOwnList(pureU, isuOwnU)

  n = records(self.tk.tokens)
  i = 1
  loop while i <= n
    do IsuTry
    i += 1
  end

  ! HIGHEST POSITION FIRST. Every staged edit is independent, but a DeleteToks below a staged
  ! index would move it, so the queue is walked backwards - IcApply does the same for the same
  ! reason. Within one entry the read is overwritten BEFORE the store line is deleted, because
  ! the read sits after the store and the delete would otherwise move it.
  ! ONE QUEUE IN POSITION ORDER (14 Sep 2026). A further read (6c) can lie far below its store -
  ! below other candidates' stores - so row order is no longer position order. Every edit, a read
  ! or a store line, goes into one queue sorted by position and is applied highest first, reads
  ! and store lines interleaved: an edit moves only what lies above it, and every edit below it is
  ! done. A store line lies above all of its reads, so its expression is rendered while it stands.
  free(IsuEdQ)                                                                     ! every edit, read or store, by position
  loop s = 1 to records(IsuQ)
    get(IsuQ, s)
    if errorcode() then cycle.
    clear(IsuEdQ) ; ie:pos = iq:qOcc ; ie:kind = 1 ; ie:row = s ; add(IsuEdQ)
    if iq:qDelS
      clear(IsuEdQ) ; ie:pos = iq:qDelS ; ie:kind = 2 ; ie:row = s ; add(IsuEdQ)
    end
  end
  sort(IsuEdQ, -ie:pos)
  loop s = 1 to records(IsuEdQ)
    get(IsuEdQ, s)
    if errorcode() then cycle.
    get(IsuQ, ie:row)
    if errorcode() then cycle.
    if ie:kind = 2                                                                 ! the store line goes - every edit above it is done
      isuKept = self.DropLinesKeepCmts(iq:qDelS, iq:qDelE, iq:qExpS + 1, iq:qExpE) ! the expression's own trivia went with it
      changes += 1
      pLog.append('BUILTIN InlineSingleUse: ' & clip(iq:qNm) & ' inlined into the next statement, line ' & iq:qLn & |
                  choose(~isuKept, '', ' - its comment stays, on a line of its own') & '<13,10>')
      cycle
    end
    self.IsuSpanText(iq:qExpS, iq:qExpE, expTxt)                                   ! the read: rendered while its store still stands
    if iq:qFold then expTxt.enclose(lower(clip(iq:qFold)) & '(', ')').             ! (4b) the case fold rides into the expression
    if ~expTxt._DataEnd then cycle.
    do IsuBracket                                                                  ! `z - 1` into `inner - bnd` is `inner - (z - 1)`, never `inner - z - 1`
    if isuBrk then expTxt.enclose('(', ')').
    self.tk.SetTok(iq:qOcc, expTxt.getValue())
    if iq:qOccE > iq:qOcc then self.tk.DeleteToks(iq:qOcc + 1, iq:qOccE).          ! name.getValue(): the dot, the call and its brackets go
    if ~iq:qDelS
      pLog.append('BUILTIN InlineSingleUse: ' & clip(iq:qNm) & ' stored on line ' & iq:qLn & ' - its pure expression also written into a further read<13,10>')
    end
  end
  if changes
    self.wantReparse = true                                                        ! the expression arrives as ONE token's text; the
                                                                                   ! re-lex is what turns it back into real tokens
    pLog.append('BUILTIN InlineSingleUse: ' & changes & ' inline(s) this pass<13,10>')
  end
  return changes

! ---- consider the statement starting at token i ------------------------------------------
! A ROUTINE with no DATA section takes no CODE statement either - that is the Clarion rule, not
! a style choice here.
IsuTry routine
  get(self.tk.tokens, i)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if ~self.IsEolTok(i - 1) then exit.                    ! after a line END: a row after a '|' goes on with the statement above it
  if ~self.IsFirstOnLine(i) then exit.                   ! a statement starts a line; this pass never
                                                         ! splits an `a = 1 ; b = 2` line
  if self.tk.tokens.type <> vt:label then exit.          ! (3) the store must start with a plain name
  nameU = upper(self.tk.tokens.tok)
  if pLog.findByte(46, 1,, nameU) then exit.             ! a dotted name is a field or a property read,  ! <dot>
                                                         ! not a local this pass may reason about
  get(self.tk.tokens, i + 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  isuST = 0
  if self.tk.tokens.tok = '.'                            ! (3b) the StringTheory spelling: name.setValue( <expr> ) and nothing else
    get(self.tk.tokens, i + 2)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then exit.
    if upper(self.tk.tokens.tok) <> 'SETVALUE' then exit.
    get(self.tk.tokens, i + 3)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then exit.
    if self.tk.tokens.tok <> '(' then exit.
    isuST = 1
  else
    if self.tk.tokens.tok <> '=' then exit.              ! (3) `v = ...` and nothing else - a compound
  end                                                    ! assign is ONE two-character token and fails here
  sS = i
  sE = self.IsuStmtEnd(sS)                               ! a bar-continued store spans two physical lines and both are deleted - see (5)
  if ~sE then exit.
  if isuST                                               ! the call's ')' closes the statement, and it takes ONE argument -
    if self.tk.MatchLeftBracket('(', ')', sS + 3) <> sE then exit.
    if sE < sS + 5 then exit.                            !   setValue(x, st:clip) is not a plain copy of x
    isuParen = 0
    loop j = sS + 4 to sE - 1
      get(self.tk.tokens, j)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.tok = '(' then isuParen += 1.
      if self.tk.tokens.tok = ')' then isuParen -= 1.
      if self.tk.tokens.tok = ',' and ~isuParen then exit.
    end
    expS = sS + 4 ; expE = sE - 1
  else
    if sE < sS + 2 then exit.                            ! an empty right-hand side
    expS = sS + 2 ; expE = sE
  end
  ! (4) the store line must end in an EOL. A comment on it is kept, on a line of its own, when the
  ! line goes (ruled 14 Sep 2026).
  delE = sE + 1
  get(self.tk.tokens, delE)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok[1] <> '<10>' then exit.          ! not an EOL - refuse rather than guess
  isuFold = '' ; foldTok = 0 ; foldE = 0
  if isuST then do IsuFoldLine.                          ! (4b) `name.upper()` or `name.lower()` on the very next line folds into the expression - ruled 13 Sep 2026

  ! (1) and (2) - the scope, and whether the target is a plain local of it.
  sc = self.syms.ScopeContaining(sS, vs:scProc, vs:scMethod)
  if ~sc then exit.
  self.AutoScopePrep(sc)
  if self.acBail then exit.
  ! (12) NOT ONE ARM OF AN EXECUTE. An EXECUTE runs ONE of the statements between it and its
  !      END, picked by the value it is given, so the store and the statement below it are
  !      ALTERNATIVES: that statement never sees the store at all, and deleting the store's
  !      line RENUMBERS every arm below it, so a different value then runs a different line.
  !      This pass says nothing when it refuses, as the eleven tests above it do not.
  if self.InExecute(sS, self.acCodeT) then exit.
  symRow = self.syms.FindOwn(nameU, sc)
  if ~symRow then exit.
  if isuST                                               ! (2b) a StringTheory local of this procedure, not a reference. A program-level object
    get(self.syms.syms, symRow)                          !      arrives here only from the main CODE, and only when FindOwn found no other scope
    if errorcode() then exit.                            !      mentions it (ruled 13 Sep 2026) - it lives for the whole program, but nothing else reads it
    if self.syms.syms.typeU <> 'STRINGTHEORY' then exit.
    if self.syms.syms.isRef then exit.
    loop j = 1 to records(self.acRoutQ)                  !      and, as AutoEligible asks of a plain local: not mentioned in a ROUTINE of the scope,
      get(self.acRoutQ, j)                               !      since a routine shares the locals and the walk at (10) reads the main code only -
      if errorcode() then break.                         !      a read there would be left reading an object nothing wrote
      if self.NameRefdInRange(nameU, self.acRoutQ.rStart, self.acRoutQ.rEnd) then exit.
    end
    clear(self.acDotQ)                                   !      and no merged dotted token is rooted at it anywhere in the scope - `name._DataEnd`
    self.acDotQ.rootU = nameU                            !      arrives as one token, which no whole-token test below can see
    get(self.acDotQ, self.acDotQ.rootU)
    if ~errorcode() then exit.
    get(self.syms.syms, symRow)                          !      and, as AutoEligible asks too: not read in a method of a
    get(self.syms.scopes, self.syms.syms.scopeId)        !      class the procedure declares, which shares its locals
    if self.MayHaveLocalMethods(self.syms.syms.scopeId)
      if self.UsedInLocalMethods(nameU, self.syms.scopes.startTok, self.syms.scopes.endTok) then exit.
    end
    ! and, as AutoEligible asks last: not read where the code does not say - through a reference
    ! taken on it with &=, an INCLUDE in the procedure, or a control's USE()
    if self.UnseenRead(nameU) then exit.
    get(self.syms.syms, symRow)
  else
    if ~self.AutoEligible(symRow) then exit.
  end

  ! (7) and (8) - the expression must not mention the target, and must call nothing impure -
  !     or, when it does, (8b) below must find the next statement runs it once, first, and alone.
  !     A method on the pure list is pure only on a StringTheory: GetLine on a class of the
  !     author's own may move on at every call - see PureMethodAt.
  bail = 0 ; impure = 0 ; anyCall = 0
  loop j = expS to expE
    get(self.tk.tokens, j)
    if errorcode()
      bail = 1
      break
    end
    if self.tk.tokens.tok &= NULL then cycle.
    tU = upper(self.tk.tokens.tok)
    if tU = nameU                                        ! (7)
      bail = 1
      break
    end
    if tU = '('                                          ! (8) a '(' is a call's bracket, or a group
      get(self.tk.tokens, j - 1)
      if errorcode()
        bail = 1
        break
      end
      if self.tk.tokens.tok &= NULL
        bail = 1
        break
      end
      if self.tk.tokens.type = vt:label
        callU = upper(self.tk.tokens.tok)
        anyCall = 1                                           ! (8c) a CALL, pure or not - see the gate at (6d)
        if ~pureU.findChars(' ' & clip(callU) & ' ') then impure = 1.
        if self.tk.GetTok(j - 2) = '.' and ~self.PureMethodAt(j, pureU) then impure = 1.
        if self.tk.GetTok(j - 2) <> '.' and ~self.PureProc(callU, pureU, isuOwnU) then impure = 1.
      end
    end
    ! a name with no '(' after it is a CALL too when it does not name data: Clarion calls a
    ! procedure or a method that takes no parameters by its label alone - `s[Tick]`. The whole
    ! argument of RECORDS, POINTER or SIZE is a structure or a variable, never a call's value
    if self.BareNameIsCall(j)
      case upper(self.tk.GetTok(j - 2))
      of 'RECORDS' orof 'POINTER' orof 'SIZE'
        if self.tk.GetTok(j - 1) = '(' and self.tk.GetTok(j + 1) = ')' then cycle.
      end
      anyCall = 1
      impure = 1
    end
  end
  if bail then exit.

  ! (11) THE TARGET HOLDS THE VALUE EXACTLY - ruled 13 Sep 2026. Folding drops the store's
  !      conversion: `a STRING(8)` / `a = upper(s)` / `case a` became `case upper(s)`, no longer
  !      cut to eight; `v LONG` / `v = x / 2` / `if v = 1` no longer truncated. So the target's type
  !      must be shown to hold the expression's value with nothing lost - IsuTypeExact says how.
  if ~self.IsuTypeExact(symRow, isuST, expS, expE) then exit.

  ! (9) and (6) - the next statement, and how it uses the target.
  nS = self.IsuNextStmt(delE)
  if ~nS then exit.
  nE = self.IsuStmtEnd(nS)                               ! same for the reading statement
  if ~nE then exit.
  isLbl = 0
  get(self.tk.tokens, nS)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.type = vt:label                      ! (9) a jump label owns its whole line
    if nS = nE then isLbl = 1.
  end
  if isLbl then exit.
  reads = 0
  writes = 0
  occ = 0
  free(IsuXQ) ; isuXN = 0
  loop j = nS to nE
    get(self.tk.tokens, j)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> nameU then cycle.
    reads += 1
    ix:xOcc = j ; ix:xOccE = j
    if isuST                                                  ! (6b) the read is name.getValue() and nothing else of the name
      ix:xOccE = 0
      get(self.tk.tokens, j + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '.'
        get(self.tk.tokens, j + 2)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'GETVALUE'
          get(self.tk.tokens, j + 3)
          if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '('
            get(self.tk.tokens, j + 4)
            if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = ')' then ix:xOccE = j + 4.
          end
        end
      end
      if ~ix:xOccE then writes += 1.                          ! any other use of the object is not a plain read of its value
    end
    if self.IsuIsWrite(j) then writes += 1.                   ! `v = ...` at a statement start is a STORE; `if a = 'X'` compares (14 Sep 2026)
    if ~isuST                                                 ! `v[1] = 'J'` writes part of v, and `v[1]` reads
      do IsuSubUse                                            !   only what a plain variable can be sliced from
      if isuSubBad then writes += 1.
    end
    do IsuStoreArg                                            ! size(v) and address(v) take the VARIABLE, not its value
    if isuStArg then writes += 1.
    get(self.tk.tokens, j + 1)
    if ~errorcode()
      if not self.tk.tokens.tok &= NULL
        if instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then writes += 1. ! `v += 1` reads AND writes
      end
    end
    if reads = 1                                              ! the first read is THE read; any other is an extra (6c)
      occ = ix:xOcc ; occE = ix:xOccE
    else
      add(IsuXQ)
      isuXN += 1
    end
  end
  if writes then exit.                                        ! (6) it must never be written there
  if ~occ then exit.
  ! (6e) A WHOLE ARGUMENT MAY BE PASSED BY ADDRESS. `work = name ; n = StripCount(work)` with
  !      StripCount(*STRING pS) hands the callee WORK, a copy; inlined, it hands it NAME, and the
  !      call changes the original. A whole argument moves only into a slot its prototype declares
  !      by value, or into a function on the pure list; a callee this cannot place keeps the copy.
  if occE = occ
    isuPrv = self.tk.GetTok(occ - 1)                          ! the tokens either side of the read
    isuNxt = self.tk.GetTok(occ + 1)                          !   - a bracket or a comma both sides
    case isuPrv                                               !   is a whole argument
    of '(' orof ','
      case isuNxt
      of ')' orof ','
        if self.AutoArgIsRefParam(occ, 1) then exit.          ! by address, or a callee this cannot place
      end
    end
  end
  !      A SLICE of the read handed whole, `Strip(b[1 : 3])`, is the variable's own storage just as
  !      `Strip(b)` is: then the tokens either side of the whole slice decide.
  if occE = occ and self.tk.GetTok(occ + 1) = '['
    isuPrv = self.tk.GetTok(occ - 1)
    isuNxt = self.tk.GetTok(self.tk.MatchLeftBracket('[', ']', occ + 1) + 1)
    if (isuPrv = '(' or isuPrv = ',') and (isuNxt = ')' or isuNxt = ',')
      if self.AutoArgIsRefParam(occ, 1) then exit.
    end
  end
  !      The StringTheory spelling's read is name.getValue(), and a call handed it whole was handed
  !      a copy of the value. When the expression is one variable - a name, a field, an element or
  !      a slice - the call would be handed that variable itself, so the tokens either side of the
  !      whole read decide, as above. A value that is computed, or folded in case, is a copy
  !      either way.
  if isuST and ~isuFold
    get(self.tk.tokens, expS)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.type = vt:label
      j = expS
      if self.tk.GetTok(j + 1) = '[' then j = self.tk.MatchLeftBracket('[', ']', j + 1).
      if j = expE
        j = occE
        if self.tk.GetTok(j + 1) = '[' then j = self.tk.MatchLeftBracket('[', ']', j + 1).
        isuPrv = self.tk.GetTok(occ - 1)
        isuNxt = self.tk.GetTok(j + 1)
        if (isuPrv = '(' or isuPrv = ',') and (isuNxt = ')' or isuNxt = ',')
          if self.AutoArgIsRefParam(occ, 1) then exit.
        end
      end
    end
  end
  ! (6c) READ MORE THAN ONCE - ruled 14 Sep 2026. A PURE expression - one that calls nothing off
  !      the pure list - gives the same value however often it is written, so it may stand at
  !      every read of the target, in the next statement and below it, provided nothing between
  !      the store and the last of those reads writes the target (the walk, 10c) or any variable
  !      the expression reads (IsuOperandsStill). An impure expression is read EXACTLY once, as
  !      before: written twice it would run twice.
  ! (6d) A PURE CALL IS SAFE TO WRITE TWICE AND IS NOT FREE TO RUN TWICE - ruled 16 Sep 2026, and
  !      it is the older reading restored: CaseB's banner in TestData\inlinesu.clw still says
  !      "Inlining would evaluate upper() twice". (6c) above answered whether the VALUE is the
  !      same, which it is, and said nothing about what it COSTS. The pure list mixes things that
  !      are free to recompute - LEN, VAL, CHR, ABS, SIZE - with string SEARCHES that are not:
  !      INSTRING, FINDCHARS, SLICE, GETLINE, UPPER. Duplicating one of those to save a LONG makes
  !      the user's code SLOWER, which is the opposite of this tool's job. Reported 16 Sep against
  !      StringTheory.BeforeLast, where `x = self.Instring(...)` read twice came back as TWO
  !      searches and no local.
  !      SO: an expression holding a call of ANY kind is written ONCE. The single-read case still
  !      MOVES it, which is what this pass is for; only the COPY into a further read is refused.
  !      A call is the line, rather than a list of cheap names: such a list needs a judgement per
  !      name, goes stale, and a name nobody thought of defaults to the wrong side of it.
  !      THE TEST IS MADE TWICE: here, on the reads inside the next statement, and again after
  !      the walk at (10) has found the reads below it (the line after `if ~isuSafe then exit.`)
  !      - `if x > 1` and then `x - 1` inside the IF is two reads of one call, and the second
  !      is the one the walk finds.
  if reads > 1 and (impure or anyCall) then exit.
  if impure                                                   ! (8b) an impure expression moves only when the next statement runs it
    do IsuRelax                                               !      exactly once, first, and calls nothing else
    if ~relaxOK then exit.
  else
    do IsuCallFirst                                           ! (8d) a call-free one waits for no call in the next statement that
    if isuCalBad then exit.                                   !      runs before the read and could change what it reads
  end

  ! (10) NOTHING ELSE STILL NEEDS THE STORE. The liveness walk (IsuLive) decides: it has to
  !      see every other reader the store could reach, and two shapes make a plain scan wrong:
  !
  !   A CONDITIONAL STORE IS NOT A REDEFINITION. A later `v = 0` inside an IF assigns nothing
  !   on the false path, so reads below it still need THIS store.
  !
  !   A LOOP HAS A BACK EDGE. With
  !       loop
  !         if v > 0 then ...        <- reads the PREVIOUS iteration's value
  !         v = expr
  !         use(v)                   <- the pair
  !       end
  !   nothing follows the pair textually, but deleting the store leaves the read at the top of
  !   the loop with no writer at all.
  !
  ! isuN, the count of the name's occurrences in the scope, is kept only so the --verbose line
  ! can say what a count-of-two rule would have decided.
  !
  ! THE COST, stated because it is real: a variable reused later keeps its store and this pass
  ! leaves the pair alone. Substituting while KEEPING the store would be worse than doing
  ! nothing - the expression would then be evaluated twice, once into the variable nobody now
  ! reads and once where it was inlined - so the refusal is the whole answer, not half of one.
  isuN = 0
  loop j = self.acCodeT to self.acMainEnd
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> nameU then cycle.
    isuN += 1
    if isuN > 2 then break.
  end
  do IsuLive                                             ! THE WALK DECIDES. isuN is counted only so the --verbose line
  if ~isuSafe then exit.                                 !   can show what a count-of-two rule would have said.
  if records(IsuXQ) and (impure or anyCall) then exit.

  ! (11) NEVER INLINE A BARE FIELD REFERENCE INTO A GET.
  !
  ! `GET(q, q.field)` is Clarion's FREE-KEY VALUE lookup, not a positional get - a different
  ! operation, and silently so. `get(CmtQ, hgAnc)` where hgAnc held CmtQ.hangFrom came back as
  ! `get(CmtQ, CmtQ.hangFrom)` and changed what the statement means.
  !
  ! *** COMPARING ROOTS IS NOT ENOUGH. *** Refusing only when the expression's root matches
  ! the queue's name works for `CmtQ` and `CmtQ.hangFrom` and fails for a PRE() prefix, because
  ! THE PREFIX IS NOT THE QUEUE NAME: on `GQ QUEUE,PRE(g)` the field is `g:gA` and the queue
  ! is `GQ`. Knowing which queue a prefixed field belongs to needs the symbol table, which is
  ! more than this guard is worth.
  !
  ! So the test is SHAPE, not identity: a single token holding a '.' or a ':' is a field
  ! reference, and a field reference is exactly what must not be moved into a GET.
  !
  ! (6e) ALREADY REFUSES THE WHOLE-ARGUMENT CASE. GET, ADD, PUT and SORT have no MAP prototype
  ! and are not on the pure list, so AutoArgIsRefParam keeps the copy for `get(GQ, n)` before
  ! this test is reached, field or not. What reaches it is a read inside a larger argument,
  ! `get(GQ, n + 0)`, which this refuses although an expression there is a position, never a key.
  ! The test stays for the day the builtins are read from a by-value table, when (6e) would let
  ! a whole argument through and the field case would be this test's again.
  if sS + 2 = sE                                              ! the expression is ONE token
    get(self.tk.tokens, nS)
    if ~errorcode()
      if not self.tk.tokens.tok &= NULL
        ! GET, ADD, PUT and SORT each take a field as a KEY and a number as a position
        isuVerb = upper(self.tk.tokens.tok)
        if inlist(isuVerb, 'GET', 'ADD', 'PUT', 'SORT')
          get(self.tk.tokens, sS + 2)
          if ~errorcode()
            if not self.tk.tokens.tok &= NULL
              isuRoot = self.tk.tokens.tok
              if pLog.findByte(46, 1,, isuRoot) or pLog.findByte(58, 1,, isuRoot) then exit. ! <colon>  ! <dot>
            end
          end
        end
      end
    end
  end

  ! (12) NEVER INLINE INTO A LOOP HEADER. Clarion reads a TO limit that is a variable or a
  ! simple expression on EVERY pass, and a function call ONCE at the start. So
  ! `n = q.records() ; loop i = 1 to n` and `loop i = 1 to q.records()` agree, but
  ! `v = n + 1 ; loop i = 1 to v` and `loop i = 1 to n + 1` do not when the body changes n -
  ! and the pass cannot tell which it is looking at. Refusing costs a conversion; assuming
  ! costs correctness, and nobody would see it. A column-1 label may stand in front of the
  ! keyword - `Outer LOOP i = 1 TO v`, the name a BREAK or CYCLE gives - so the word after
  ! the label is the one judged.
  j = nS
  if self.syms.IsColOneLabel(nS) then j = nS + 1.
  get(self.tk.tokens, j)
  if ~errorcode()
    if not self.tk.tokens.tok &= NULL
      if upper(self.tk.tokens.tok) = 'LOOP' then exit.
    end
  end

  loop j = 1 to records(IsuQ)                            ! a chained pair - this expression reads a target already staged to
    get(IsuQ, j)                                         !   go - waits for the next pass, when the file has been re-lexed
    if errorcode() then break.                           !   with the first substitution in it
    if iq:qOcc >= expS and iq:qOcc <= expE then exit.
  end
  clear(IsuQ)
  iq:qOcc  = occ
  iq:qOccE = occE
  iq:qFold = isuFold
  iq:qDelS = sS
  iq:qDelE = delE
  iq:qExpS = expS
  iq:qExpE = expE
  iq:qLn   = self.LogLineOf(sS)
  iq:qNm   = nameU
  add(IsuQ)
  if errorcode() then exit.
  loop j = 1 to records(IsuXQ)                                ! (6c) the extra reads take the expression too; the store goes once
    get(IsuXQ, j)
    if errorcode() then break.
    clear(IsuQ)
    iq:qOcc  = ix:xOcc
    iq:qOccE = ix:xOccE
    iq:qFold = isuFold
    iq:qDelS = 0
    iq:qDelE = 0
    iq:qExpS = expS
    iq:qExpE = expE
    iq:qLn   = self.LogLineOf(sS)
    iq:qNm   = nameU
    add(IsuQ)
  end
  i = nE                                                      ! never stage two overlapping edits: the next
                                                              ! candidate starts after the statement just used

! ---- (10) THE LIVENESS WALK ---------------------------------------------------------------
! Answers the question the whole-scope count of two only APPROXIMATES: can any read other than
! the one being replaced still observe the value this store writes?
!
! The count says "the name appears nowhere else, so nobody else can see it". True, and far
! stricter than the question. It refuses a scratch variable reused for a second, unrelated job
! later in the same procedure - and when one variable serves two such pairs it is SELF-BLOCKING,
! each pair refused on account of the other's existence, so neither ever converts.
!
! WHAT IT WALKS. The tokenizer stamps every token with a `level`: '+' opens a structure, '-'
! closes one, '/' is an ELSE or ELSIF. Accumulating those gives the depth, and handing out a new
! id every time a block opens gives BLOCK IDENTITY - which is what tells two sibling loops apart
! when both sit at depth 1.
!
! WHAT IT DECIDES. Each clause maps to a bug that has actually happened here:
!
!   (a) inside the store's OWN block the name occurs exactly twice - the store and the read. A
!       third occurrence there could be a read ABOVE the store, which a loop's back edge reaches
!       from the previous iteration: a bug a forward scan could not see.
!
!   (b) the read is in the SAME block as the store. Otherwise the store may run many times and
!       the read once, or the store may not run at all.
!
!   (c) every OTHER read of the name in the scope is preceded, IN ITS OWN BLOCK, by a write to
!       the name. A write in a DEEPER block does not count, and that is the whole point: the
!       other one was `oldLn = 0` inside an IF read as a redefinition, when the false
!       path assigned nothing and four reads below got whatever was on the stack. Nor does a
!       write inside an inline `if c then v = 1.` - the same conditional store in one line -
!       and a write counts only from the END of its line, so `v = v + 1` reads the old value
!       first and is a stray read, not a kill. `name.setValue(...)` is a write (IsuIsWrite).
!
! It REFUSES rather than guesses when nesting runs past isu:maxDepth.
! ---- (8b) an expression that calls something not on the pure list may still move when the next
!      statement is a CASE, IF, EXECUTE or RETURN header, or `x = <the read>`, is not a LOOP header,
!      calls nothing else, and reads the target as its FIRST operand - only a bracket or a NOT may
!      stand between the keyword and the read. Then the call runs exactly once, as the first thing
!      that statement does, which is exactly when and how often it ran on the line before. `if gv = a`
!      is refused: the original read gv after the call, and in `if gv = NotPure()` the order of the
!      two reads is the compiler's, not the text's - measured in an assignment (looplim\Fetch), a
!      call runs before any other operand is read, wherever it is written. Ruled 13 Sep 2026.
! ---- (8d) the same question for a CALL-FREE expression: the next statement calls something off the
!      pure list whose brackets do not hold the read. That call runs BEFORE the folded expression is
!      read - measured (looplim\Fetch): in `x = Bump() * 100 + g` and `x = g + Bump() * 100` alike,
!      g is read after Bump() has run - where the store read its operands before it. A call whose
!      brackets hold the read is no change: it reads its arguments before it runs. A method call
!      counts whatever its name, since a name on the pure list is pure only on the objects it is
!      known for. So every operand must be one no call can write: a plain local of this procedure
!      (AutoEligible: no parameter, reference, field, OVER, STATIC or program data), read in no
!      method of a class the procedure declares, and not named in the next statement, where it
!      could be handed to the call by address.
! ---- (4b) the very next line is `name.upper()` or `name.lower()`, alone on its line (a comment after
!      it rides on the line end and is kept, on a line of its own, when the line goes - ruled 14 Sep
!      2026): the fold is part of the store. The read then becomes upper(<expr>) and both lines go.
!      Ruled 13 Sep 2026, from VitRules.ParseOptions: `word.setValue(<slice>) ; word.upper() ; case
!      word.getValue()`.
IsuFoldLine routine
  data
f  long,auto
fU string(vs:maxName),auto
  code
  f = delE + 1
  get(self.tk.tokens, f)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if ~self.tk.tokens.firstOnLine then exit.
  if upper(self.tk.tokens.tok) <> nameU then exit.
  get(self.tk.tokens, f + 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok <> '.' then exit.
  get(self.tk.tokens, f + 2)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  fU = upper(self.tk.tokens.tok)
  if fU <> 'UPPER' and fU <> 'LOWER' then exit.
  get(self.tk.tokens, f + 3)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok <> '(' then exit.
  get(self.tk.tokens, f + 4)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok <> ')' then exit.
  get(self.tk.tokens, f + 5)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok[1] <> '<10>' then exit. ! alone on its line
  isuFold = fU
  foldTok = f
  foldE   = f + 5
  delE    = foldE                               ! the delete range runs over the fold line too

! ---- isuBrk = the expression being written at iq:qOcc needs brackets: it is not one term (a
!      single token, a call, a subscript, a dotted method call spanning the whole of it), and a
!      neighbour of the read is an arithmetic or concatenation operator, a subscript or a dot,
!      which would bind into it. `a = z - 1` / `inner - a` must become `inner - (z - 1)`.
IsuBracket routine
  isuBrk = 0
  if iq:qFold then exit.                                                              ! upper( ... ) around it: one term already
  if iq:qExpS = iq:qExpE then exit.
  get(self.tk.tokens, iq:qExpS + 1)
  if errorcode() then exit.
  if not self.tk.tokens.tok &= NULL
    case self.tk.tokens.tok
    of '('
      if self.tk.MatchLeftBracket('(', ')', iq:qExpS + 1) = iq:qExpE then exit.       ! name( ... ) whole
    of '['
      if self.tk.MatchLeftBracket('[', ']', iq:qExpS + 1) = iq:qExpE then exit.       ! name[ ... ] whole
    of '.'
      get(self.tk.tokens, iq:qExpS + 3)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '('
        if self.tk.MatchLeftBracket('(', ')', iq:qExpS + 3) = iq:qExpE then exit.     ! name . method ( ... ) whole
      end
    end
  end
  get(self.tk.tokens, iq:qOcc - 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if instring(' ' & clip(self.tk.tokens.tok) & ' ', ' + - * / ^ % & ', 1, 1) then isuBrk = 1 ; exit.
  end
  get(self.tk.tokens, iq:qOccE + 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if instring(' ' & clip(self.tk.tokens.tok) & ' ', ' + - * / ^ % & [ . ', 1, 1) then isuBrk = 1.
  end

! ---- (6c)/(10c) helpers - ruled 14 Sep 2026 -------------------------------------------------
! isuKnown = token j is already one of the extra reads
IsuKnownExtra routine
  isuKnown = 0
  loop isuOpK = 1 to records(IsuXQ)
    get(IsuXQ, isuOpK)
    if errorcode() then break.
    if ix:xOcc = j then isuKnown = 1 ; break.
  end

! isuDom = the store's block is the block open at the current depth, or one of its ancestors:
! a read there runs only after the store did. A read in a sibling branch, or above the store
! at the same depth, is not dominated - the same-block test for the FIRST read covers that, and
! here the block id is looked for down the whole open stack.
IsuDominated routine
  isuDom = 0
  if ~isuBlkS then exit.
  loop isuOpK = 1 to isuDep + 1
    if isuStk[isuOpK] = isuBlkS then isuDom = 1 ; break.
  end

! token j is a plain read of the target (name.getValue() in the StringTheory spelling): add it
! as an extra. Any other spelling of the name is not a plain read, and is left to be counted -
! which refuses, since it sits inside the store's block. A read in a LOOP header is never an
! extra: every word from the start of the statement's LOGICAL line to the read is looked at,
! so a LOOP behind a column-1 label, after a ';' or on the line above a '|' is seen.
IsuExtraRead routine
  if ~isuST
    do IsuSubUse
    if isuSubBad then exit.
  end
  do IsuStoreArg
  if isuStArg then exit.
  get(self.tk.tokens, j + 1)    ! `v += 1` writes v: no extra, and no extra after it
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then isuWrAft = 1 ; exit.
  end
  isuOpK = j                    ! a LOOP header re-reads its limit on every pass
  loop while isuOpK > 1         !   (see (12)): never an extra
    if self.IsEolTok(isuOpK - 1) then break.
    isuOpK -= 1
  end
  loop while isuOpK < j
    get(self.tk.tokens, isuOpK)
    if ~errorcode() and not self.tk.tokens.tok &= NULL
      if upper(self.tk.tokens.tok) = 'LOOP' then exit.
    end
    isuOpK += 1
  end
  ix:xOcc = j ; ix:xOccE = j
  if isuST
    ix:xOccE = 0
    get(self.tk.tokens, j + 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '.'
      get(self.tk.tokens, j + 2)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'GETVALUE'
        get(self.tk.tokens, j + 3)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '('
          get(self.tk.tokens, j + 4)
          if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = ')' then ix:xOccE = j + 4.
        end
      end
    end
    if ~ix:xOccE then exit.
  end
  add(IsuXQ)
  if errorcode() then exit.
  isuXN += 1
  isuKnown = 1

! isuSubBad = the target at token j has a subscript after it, and the expression cannot stand
! there. `b[1] = 'J'` (or `b[1] += ...`) WRITES part of b: it is no read, and inlined it would
! write the variable that was copied. Any other `b[...]` reads a slice of b, which only a plain
! variable has - `upper(s)[1]` or `'abc'[1]` does not compile - so the expression must be one
! name the table places as data. The token buffer is left on token j, as the walks expect.
IsuSubUse routine
  do IsuSubTest
  get(self.tk.tokens, j)

IsuSubTest routine
  data
k    long,auto
t    string(vs:maxName),auto
  code
  isuSubBad = 0
  if self.tk.GetTok(j + 1) <> '[' then exit.
  isuSubBad = 1
  k = self.tk.MatchLeftBracket('[', ']', j + 1)
  if k <= j + 1 then exit.
  t = self.tk.GetTok(k + 1)
  if instring(' ' & clip(t) & ' ', isu:cmpdOps, 1, 1) then exit.
  if t = '='
    if self.IsFirstOnLine(j) then exit.
    case upper(self.tk.GetTok(j - 1))
    of ';' orof 'THEN' orof 'ELSE'
      exit
    end
  end
  if expS <> expE then exit.
  get(self.tk.tokens, expS)
  if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then exit.
  if ~self.CondNamesAreData(expS, expS) then exit.
  isuSubBad = 0

! isuStArg = the target at token j is the whole argument of SIZE or ADDRESS. Both take the
! VARIABLE - how much storage it has, where it is - not its value, so such a read is no plain
! read: `v = b` with v a LONG and b a BYTE, then size(v) is 4, where size(b) is 1. The token
! buffer is left on token j, as the walks expect.
IsuStoreArg routine
  isuStArg = 0
  if self.tk.GetTok(j - 1) = '(' and self.tk.GetTok(j + 1) = ')'
    case upper(self.tk.GetTok(j - 2))
    of 'SIZE' orof 'ADDRESS'
      isuStArg = 1
    end
  end
  get(self.tk.tokens, j)

! the expression's operand roots: every name in it that is not a call and not a property or
! method tail. `pOpts.valuePtr` arrives as one token and its root is `pOpts`; `st . getValue (`
! arrives split and its root is `st`. A name holding a ':' is an equate such as st:clip, or a
! field of a structure with a prefix - `g:gA` of `GQ GROUP,PRE(g)` - whose structure the
! spelling does not name, so a write to it through that structure, CLEAR(GQ) or GET(Q, 1),
! could not be seen: isuOpCol says the expression holds one, and the walks that must watch
! every operand refuse.
IsuOperands routine
  free(IsuOpQ)
  isuOpCol = 0
  loop isuOpK = expS to expE
    get(self.tk.tokens, isuOpK)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    isuOpU = upper(self.tk.tokens.tok)
    if pLog.findByte(58, 1,, isuOpU)                              ! <colon>
      isuOpCol = 1
      cycle
    end
    isuOpM = pLog.findByte(46, 1,, isuOpU)                        ! <dot>
    if isuOpM > 1 then isuOpU = isuOpU[1 : isuOpM - 1].
    if isuOpK > expS                                              ! a tail after a dot is not a root
      get(self.tk.tokens, isuOpK - 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '.' then cycle.
    end
    if ~isuOpM                                                    ! a name followed by '(' is a call, not an operand
      get(self.tk.tokens, isuOpK + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '(' then cycle.
    end
    if self.NameShared(isuOpK, isuOpU) then isuOpCol = 1 ; cycle. ! a second name for it: a write through that is not seen
    io:nm = isuOpU
    get(IsuOpQ, io:nm)
    if errorcode()
      io:nm = isuOpU
      add(IsuOpQ)
    end
  end

! isuOpBad = between the store and the last extra read, something may have changed a value the
! expression reads: an operand assigned (plain or compound), an object operand given to a method
! off the pure list, or an operand handed to a call off the pure list, which could write it by
! address. The walk is token order, which over-counts across sibling branches - the safe side.
IsuOperandsStill routine
  isuOpBad = 0 ; isuOpPre = 0
  isuOpEnd = 0
  loop isuOpK = 1 to records(IsuXQ)
    get(IsuXQ, isuOpK)
    if errorcode() then break.
    if ix:xOcc > isuOpEnd then isuOpEnd = ix:xOcc.
  end
  if ~isuOpEnd then exit.
  do IsuOperands
  if isuOpCol then isuOpBad = 1 ; exit.
  if ~records(IsuOpQ) then exit.
  ! the structure the next statement opens, when the extra read lies inside it: a write in one
  ! of its arms cannot reach a read in another, so the writes seen are dropped at each arm
  ! boundary of THAT structure (a '/' at its own depth) - and a write seen before it, or in the
  ! arm the read is in, stands. A read below the structure sees every arm's writes, as before.
  isuArmS = 0 ; isuArmE = 0 ; isuArmD = 0
  get(self.tk.tokens, nS)
  if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.level = '+'
    isuArmE = self.tk.MatchLevel()
    if isuArmE > nS and isuOpEnd > nE and isuOpEnd < isuArmE then isuArmS = nS.
  end
  isuOpDep = 0 ; isuOpImp = 0 ; isuLpAt = 0 ; isuLpD = 0 ; isuGd = 0
  loop isuOpK = sE + 1 to isuOpEnd
    get(self.tk.tokens, isuOpK)
    if errorcode() then break.
    case self.tk.tokens.level
    of '+'                                                    ! a loop opened between the store and the read runs the
      if ~isuLpAt and not self.tk.tokens.tok &= NULL and (upper(self.tk.tokens.tok) = 'LOOP' or upper(self.tk.tokens.tok) = 'ACCEPT')
        isuLpAt = isuOpK ; isuLpD = isuGd                     !   lines below the read again before it
      end
      isuGd += 1
    of '-'
      isuGd -= 1
      if isuLpAt and isuGd <= isuLpD then isuLpAt = 0.
    end
    if not self.tk.tokens.tok &= NULL and upper(self.tk.tokens.tok) = 'DO' then do IsuOpHit. ! a routine may change an operand
    if isuArmS and isuOpK > nE                                ! inside the structure: track its arms
      if self.tk.tokens.level = '+'
        isuArmD += 1
      elsif self.tk.tokens.level = '-' or (self.tk.tokens.type = vt:end and self.tk.tokens.level <> '/')
        isuArmD -= 1
      elsif self.tk.tokens.level = '/' and ~isuArmD
        isuOpBad = 0                                          ! a new arm of the structure: the last arm's writes cannot reach here
      end
    end
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      isuOpDep += 1
      if isuOpDep > isu:maxDepth then isuOpBad = 1 ; break.
      isuOpStk[isuOpDep] = 0
      get(self.tk.tokens, isuOpK - 1)                         ! whose bracket: a call's, and is the callee pure?
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.type = vt:label
        isuOpU = upper(self.tk.tokens.tok)
        isuOpM = pLog.findByte(46, 1,, isuOpU)                ! <dot>
        if isuOpM then isuOpU = isuOpU[isuOpM + 1 : len(clip(isuOpU))].
        if ~pureU.findChars(' ' & clip(isuOpU) & ' ') then isuOpStk[isuOpDep] = 1 ; isuOpImp += 1 ; do IsuOpHit.
        if ~isuOpStk[isuOpDep] and ~isuOpM then do IsuOpProc.
        if ~isuOpStk[isuOpDep] and isuOpK > 3
          if self.tk.GetTok(isuOpK - 2) = '.' then do IsuOpRecv.
        end
        if ~isuOpStk[isuOpDep] and (isuOpM or self.tk.GetTok(isuOpK - 2) = '.') and ~self.PureMethod(isuOpU, pureU) then isuOpStk[isuOpDep] = 1 ; isuOpImp += 1 ; do IsuOpHit.
      end
      cycle
    end
    if self.tk.tokens.tok = ')'
      if isuOpDep > 0
        if isuOpStk[isuOpDep] then isuOpImp -= 1.
        isuOpDep -= 1
      end
      cycle
    end
    if self.tk.tokens.type <> vt:label then cycle.
    isuOpU = upper(self.tk.tokens.tok)
    isuOpM = pLog.findByte(46, 1,, isuOpU)                    ! <dot>
    if isuOpM > 1 then isuOpU = isuOpU[1 : isuOpM - 1].
    io:nm = isuOpU
    get(IsuOpQ, io:nm)
    if errorcode()                                            ! not an operand - but a name the table does not
      if self.BareNameIsCall(isuOpK) then do IsuOpHit.        !   place as data may be a call with no brackets
      cycle
    end
    if isuOpImp then do IsuOpHit ; cycle.                     ! inside a call off the pure list: it may write it
    if self.IsuIsWrite(isuOpK) then do IsuOpHit ; cycle.      ! `x = ...` or `x.setValue(`
    get(self.tk.tokens, isuOpK + 1)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then do IsuOpHit ; cycle.
    if self.tk.tokens.tok = '['                               ! a subscript: a write when '=' follows its ']'
      isuOpJ = self.tk.MatchLeftBracket('[', ']', isuOpK + 1)
      if isuOpJ > isuOpK
        get(self.tk.tokens, isuOpJ + 1)
        if ~errorcode() and not self.tk.tokens.tok &= NULL
          if self.tk.tokens.tok = '=' or instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then do IsuOpHit.
        end
      end
      cycle
    end
    if self.tk.tokens.tok = '.' or isuOpM > 1                 ! an object operand: the method must be a reader
      if self.tk.tokens.tok = '.'
        get(self.tk.tokens, isuOpK + 2)
        if errorcode() then break.
        if self.tk.tokens.tok &= NULL then cycle.
        isuOpU = upper(self.tk.tokens.tok)
        if ~self.PureMethod(isuOpU, pureU) then do IsuOpHit ; cycle.
      else
        get(self.tk.tokens, isuOpK)
        isuOpU = upper(self.tk.tokens.tok)
        isuOpU = isuOpU[isuOpM + 1 : len(clip(isuOpU))]
      end
      if ~pureU.findChars(' ' & clip(isuOpU) & ' ') and isuOpU <> 'VALUEPTR' and isuOpU <> '_DATAEND' then do IsuOpHit.
    end
  end
  if isuOpPre or isuLpAt then isuOpBad = 1.

! ---- an operand may have changed at token isuOpK: before the structure the read is in, that
!      reaches every arm and is final; inside it, it stands until the next arm boundary
IsuOpHit routine
  if isuArmS and isuOpK > nE
    isuOpBad = 1
  else
    isuOpPre = 1
  end

! ---- a METHOD on the pure list is a reader only on a StringTheory: the list names StringTheory's
!      readers, and GetLine on a class of the author's own may move a position or write an
!      argument by address. Any other receiver makes the call one off the pure list.
IsuOpRecv routine
  if self.HayType(self.tk.GetTok(isuOpK - 3), isuOpK - 3) = 'STRINGTHEORY' then exit.
  isuOpStk[isuOpDep] = 1
  isuOpImp += 1
  do IsuOpHit

! ---- a call with NO object in front of it is a reader only when it is one of the runtime's own
!      functions on the list: a name this file gives a procedure of its own may write an operand
!      by address (PureProc). Any other makes the call one off the pure list.
IsuOpProc routine
  if self.tk.GetTok(isuOpK - 2) = '.' then exit.
  if self.PureProc(isuOpU, pureU, isuOwnU) then exit.
  isuOpStk[isuOpDep] = 1
  isuOpImp += 1
  do IsuOpHit

IsuRelax routine
  relaxOK = 0
  get(self.tk.tokens, nS)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  tU = upper(self.tk.tokens.tok)
  case tU
  of 'CASE' orof 'IF' orof 'EXECUTE' orof 'RETURN'
    relaxOK = 1
    loop j = nS + 1 to occ - 1               ! ... and the read is the FIRST operand: only a bracket or a NOT may stand before it
      get(self.tk.tokens, j)
      if errorcode() then relaxOK = 0 ; exit.
      if self.tk.tokens.tok &= NULL then cycle.
      tU = upper(self.tk.tokens.tok)
      if tU <> '(' and tU <> '~' and tU <> 'NOT' then relaxOK = 0 ; break.
    end
  end
  if occ = nS + 2
    get(self.tk.tokens, nS + 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '=' then relaxOK = 1.
  end
  if ~relaxOK then exit.
  loop j = nS to nE                          ! no other call in that statement
    get(self.tk.tokens, j)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '(' then cycle.
    if isuST and j = occ + 3 then cycle.     ! getValue's own bracket
    get(self.tk.tokens, j - 1)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = vt:label then relaxOK = 0 ; exit.
  end

IsuCallFirst routine
  isuCalBad = 0
  isuCk = 0
  loop j = nS to nE                                                        ! a call off the pure list that does not hold the read
    get(self.tk.tokens, j)
    if errorcode() then isuCalBad = 1 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '(' then cycle.
    if isuST and j = occ + 3 then cycle.                                   ! getValue's own bracket
    get(self.tk.tokens, j - 1)
    if errorcode() then isuCalBad = 1 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    tU = upper(self.tk.tokens.tok)
    get(self.tk.tokens, j - 2)
    if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.tok <> '.'
      if self.PureProc(tU, pureU, isuOwnU) then cycle.
    end
    if j < occ and self.tk.MatchLeftBracket('(', ')', j) > occ then cycle. ! the read is its argument
    isuCk = 1
    break
  end
  if ~isuCk
    loop j = nS to nE                                                      ! a call with no brackets: a name the
      if j = occ then cycle.                                               !   table does not place as data
      if self.BareNameIsCall(j) then isuCk = 1 ; break.
    end
  end
  if ~isuCk then exit.
  do IsuOperands
  if isuOpCol then isuCalBad = 1 ; exit.
  loop isuCkR = 1 to records(IsuOpQ)                                       ! ... and an operand it could write
    get(IsuOpQ, isuCkR)
    if errorcode() then isuCalBad = 1 ; break.
    isuCk = self.syms.FindOwn(io:nm, sc)
    if ~isuCk then isuCalBad = 1 ; break.
    if ~self.AutoEligible(isuCk) then isuCalBad = 1 ; break.
    get(self.syms.syms, isuCk)
    get(self.syms.scopes, self.syms.syms.scopeId)
    if self.MayHaveLocalMethods(self.syms.syms.scopeId)
      if self.UsedInLocalMethods(io:nm, self.syms.scopes.startTok, self.syms.scopes.endTok) then isuCalBad = 1 ; break.
    end
    if self.NameRefdInRange(io:nm, nS, nE) then isuCalBad = 1 ; break.
  end
  get(self.syms.syms, symRow)

IsuLive routine
  isuDep    = 0
  isuNextB  = 1
  isuBlkS   = 0
  isuBlkO   = 0
  isuInBlk  = 0
  isuStrand = 0
  isuOver   = 0
  isuPend   = 0
  isuWrPend = 0
  isuWrAft  = 0
  isuStk[1] = 1                                                                  ! depth 0 is block 1 - the procedure body itself
  isuWr[1]  = 0
  loop j = self.acCodeT to self.acMainEnd
    get(self.tk.tokens, j)
    if errorcode() then break.
    ! READ THE ROW INTO LOCALS FIRST. IsuIsWrite below does its own get() and would otherwise
    ! leave the record buffer pointing at token j+1, so the level test after it would be asking
    ! about the WRONG TOKEN. That is a silent wrong answer, not a crash.
    isuLvl = self.tk.tokens.level
    isuHit = 0
    if not self.tk.tokens.tok &= NULL
      if upper(self.tk.tokens.tok) = nameU then isuHit = 1.
    end
    ! A CLOSE that cancels an open from THIS SAME LINE is an inline structure - `if x then y.`
    ! opens and closes without ever having a body, so the depth must not move at all.
    if isuLvl = '-'
      if isuPend > 0
        isuPend -= 1
      elsif isuDep > 0
        isuDep -= 1                                                              ! a real close belongs to the level OUTSIDE it
      end
    end
    if isuDep + 1 > isu:maxDepth
      isuOver = 1
      break
    end
    ! an ELSE on the line its IF opens on, `if c then x = 1 else x = 2.`, is that one-line IF's
    ! own: the block the line sits in goes on
    if isuLvl = '/' and ~isuPend                                                 ! ELSE / ELSIF - a new path, so a NEW block at this depth
      isuNextB += 1
      isuStk[isuDep + 1] = isuNextB
      isuWr[isuDep + 1]  = 0
    end
    if isuHit and j = foldTok then isuHit = 0.                                   ! (4b) the fold line's mention is the store's own
    if isuHit and j > occ and ~impure and ~isuWrAft                              ! (10c) a further read of a pure expression, below the
      do IsuKnownExtra                                                           !       first: an extra when it is a plain read the
      if ~isuKnown                                                               !       store's block holds ((6c) found the ones in the
        do IsuDominated                                                          !       next statement)
        if isuDom and ~self.IsuIsWrite(j) then do IsuExtraRead.
      end
      if isuKnown then isuHit = 0.                                               ! an extra: not a strand, not a count
    end
    if isuHit and self.InExecute(j, self.acCodeT)                                ! an EXECUTE runs ONE of its arms, so a write in one cannot
      isuOver = 1                                                                !   cover a read in another: the walk cannot judge it
      break
    end
    if isuHit
      if j = sS
        isuBlkS = isuStk[isuDep + 1]
        loop isuA = 1 to isuDep                                                  ! a write ABOVE the store kills nothing it writes: from
          isuWr[isuA] = 0                                                        !   here on its value reaches every later read in the
        end                                                                      !   blocks around it, through a BREAK or the loop's end
      elsif j = occ
        isuBlkO = isuStk[isuDep + 1]
      end
      if isuBlkS and isuStk[isuDep + 1] = isuBlkS then isuInBlk += 1.
      if self.IsuIsWrite(j) = 1
        if ~isuPend then isuWrPend = isuDep + 1.                                 ! a kill - from the END of its line (below), and never from inside an inline `if c then v
        if j > sS then isuWrAft = 1.                                             ! (10c) no extra read may follow a write to the name
      elsif j <> occ and j <> sS
        if ~isuWr[isuDep + 1] then isuStrand += 1.                               ! a read nothing in its own block kills
      end
    end
    ! AN OPEN TAKES EFFECT AT THE END OF ITS LINE, NOT AT THE KEYWORD.
    ! `case wU` and `if wU = '.'` are structure HEADERS: the tokens on that line, including the
    ! ones being tested here, belong to the block CONTAINING the structure - the body only starts
    ! on the next line. Incrementing at the keyword put a header's own read inside the structure
    ! it opens, which made the store and its read look like different blocks. The diagnostic
    ! showed it as blkStore=2 blkRead=3 for a pair sitting in one loop body.
    if isuLvl = '+' then isuPend += 1.
    if not self.tk.tokens.tok &= NULL
      if self.tk.tokens.tok[1] = '<10>'                                          ! end of line - now the pending opens take effect
        if isuWrPend                                                             ! ... and so does a write: `v = v + 1` read the old value first
          isuWr[isuWrPend] = 1
          isuWrPend = 0
        end
        loop while isuPend > 0
          isuPend -= 1
          isuDep  += 1
          if isuDep + 1 > isu:maxDepth
            isuOver = 1
            break
          end
          isuNextB += 1
          isuStk[isuDep + 1] = isuNextB
          isuWr[isuDep + 1]  = 0
        end
        if isuOver then break.
      end
    end
  end
  ! the verdict, as one named thing rather than a condition buried in a message
  isuSafe = 0
  if ~isuOver and isuInBlk = 2 and isuBlkS and isuBlkS = isuBlkO and ~isuStrand
    isuSafe = 1
  end
  if isuSafe and isuXN                                                           ! (6c) the extra read: written TWICE at most - the
    if isuXN > 1 then isuSafe = 0.                                               !      ruling's word - since every copy of the expression
    if expS = expE                                                               !      is work done again; and never a bare literal, whose
      get(self.tk.tokens, expS)                                                  !      name is what it means
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.type = vt:literal or self.tk.tokens.type = vt:Integer or self.tk.tokens.type = vt:NumericWithDecPt then isuSafe = 0.
      end
    end
    if isuSafe then do IsuOperandsStill.                                         !      and nothing the expression reads may change first
    if isuOpBad then isuSafe = 0.
  end
  if self.verbose
    pLog.append('  [ISU] ' & clip(nameU) & ' store line ' & self.LogLineOf(sS) & |
                ' scopeCount=' & isuN & ' inBlock=' & isuInBlk                 & |
                ' blkStore=' & isuBlkS & ' blkRead=' & isuBlkO                 & |
                ' stranded=' & isuStrand & ' tooDeep=' & isuOver               & |
                ' | liveness=' & choose(isuSafe = 1, 'SAFE', 'refuse')         & |
                ' count=' & choose(isuN = 2, 'SAFE', 'refuse') & '<13,10>')
  end


!===============================================================================================
! A token span rendered with the spacing it was WRITTEN with.
!
! MgSpanText joins with one space, which turns `upper(s)` into `upper ( s )`. That compiles, but
! this pass moves the text into the user's line and the user's spacing has to survive the trip.
! Every token after the first contributes its own strBefore; the first contributes none, because
! its strBefore is the indent of the line the expression is being taken OFF.
!===============================================================================================
VitEngine.IsuSpanText Procedure(LONG pS, LONG pE, StringTheory pOut)
j  long,auto
  code
  pOut.free()
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if j > pS
      if not self.tk.tokens.strBefore &= NULL
        pOut.append(self.tk.tokens.strBefore)
      end
    end
    pOut.append(self.tk.tokens.tok)
  end

!===============================================================================================
! The last token of the statement that starts at pFirst.
!
! A statement continued with '|' runs on to its logical end: the bar is trivia, so the walk
! passes it and returns the last token before the line end that closes the statement. Returns 0
! when the statement holds a ';' or runs off the end of the file. A refusal here refuses the
! whole inline, which is where proof obligation 5 lives.
!===============================================================================================
VitEngine.IsuStmtEnd Procedure(LONG pFirst)
j    long,auto
last long,auto
n    long,auto
  code
  n = records(self.tk.tokens)
  last = 0
  loop j = pFirst to n
    get(self.tk.tokens, j)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok[1] = '<10>' then return last. ! end of the physical line
    if self.tk.tokens.tok = ';' then return 0.          ! two statements on one line - out of scope
    ! NO BAR TEST HERE. A bar is TRIVIA, not a token, so a test for one in this loop can
    ! never fire - it sat here looking like a guard until a probe proved it did nothing.
    ! The semicolon test above DOES work, because a semicolon IS a token. If a bar ever
    ! has to be refused, it has to be found in strBefore.
    last = j
  end
  return 0                                              ! ran off the end with no EOL

!===============================================================================================
! The first token of the next statement after pAfter, skipping blank lines.
!===============================================================================================
VitEngine.IsuNextStmt Procedure(LONG pAfter)
j  long,auto
n  long,auto
  code
  n = records(self.tk.tokens)
  loop j = pAfter + 1 to n
    get(self.tk.tokens, j)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok[1] = '<10>' then cycle. ! a blank line between the two is still adjacency
    return j
  end
  return 0

! =============================================================================================
! Is the token at pTok being WRITTEN rather than read? 1 = written, 2 = written on a line only a
! debug build runs, 0 = read.
!
! `v = ...` writes v; anything else reads it. That is the same test the store detection at the
! top of this pass makes, and it is the whole of what the liveness walk needs: a write KILLS the
! value any earlier store left, so no read after it can observe that store.
!
! A COMPOUND ASSIGNMENT IS ONE TOKEN. `v += 1` lexes as `v` then `+=`, not `+` then `=`, so it
! answers FALSE here - and that is right in the only way that matters. `+=` reads v as well as
! writing it, so calling it a plain kill would be wrong. Answering "read" is the safe half,
! because a read is what makes the walk refuse.
!
! `name.setValue(...)` IS a write, whatever its arguments: the old value is gone. Without this
! an object loaded and read in two places - a pair at the top of a procedure and a pair inside
! one of its arms - read as one pair plus two strays, and neither pair ever converted.
!
! WHERE A STORE STANDS is StoreHead's answer, not the line's. `Again  v = 0` behind a
! column-1 label is a store, though v is not first on its line; `if a = 1 or |` with `v = 5`
! on the next line is a comparison, though v is. `loop v = 1 to k` writes v, and so does
! `? v = 0`, in a debug build. A write that a release build skips kills nothing, so the
! liveness walk takes only 1 as a kill; a caller asking whether a value may change takes either.
! =============================================================================================
VitEngine.IsuIsWrite Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok + 1)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok = '='     ! `v = ...` writes v - when v begins its statement. `if v = 1` and
    return self.StoreHead(pTok)   !   `... or v = 1` compare it (14 Sep 2026)
  end
  if self.tk.tokens.tok <> '.' then return 0.
  get(self.tk.tokens, pTok + 2)   ! the StringTheory spelling of a store, name.setValue( - whatever the
  if errorcode() then return 0.   !   arguments, the old value is gone, which is all a kill means
  if self.tk.tokens.tok &= NULL then return 0.
  if upper(self.tk.tokens.tok) <> 'SETVALUE' then return 0.
  get(self.tk.tokens, pTok + 3)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '(' then return 0.
  if self.DebugLine(pTok) then return 2.
  return 1

!===============================================================================================
! THE STATIC TYPE OF AN EXPRESSION, as far as the tokens show it; '' when they do not.
!
! Ruled 13 Sep 2026, for InlineSingleUse: folding a plain local drops the store's conversion.
! `a STRING(8)` / `a = upper(s)` / `case a` became `case upper(s)`, which no longer truncates to
! eight; `v LONG` / `v = x / 2` / `if v = 1` no longer truncates. So the fold happens only when the
! target's declared type is shown to hold the value exactly (IsuTypeExact), and this is the half
! that reads the expression. The answer is a type keyword - STRING with pWidth its length (0 =
! not known), or BYTE, SHORT, USHORT, LONG, ULONG, SREAL, REAL - and a numeric literal answers
! its class with pLit = its token, so the caller can range-check the value.
!
! WHAT IT READS. A literal. A name whose declaration is visible - a STRING(n) local gives n, a
! `STRING` parameter gives 0. A call to a Clarion reader with a known return: upper, lower, left,
! right and center keep their one argument's type; clip, sub, all, format, chr and deformat give a
! STRING of unknown width; len, instring, val, records, pointer, errorcode, size, inlist,
! numeric, band, bor, bxor and bshift give a LONG. A MAP procedure of this file with a plain
! return type. A StringTheory reader on an object whose declaration is visible: getValue,
! getValuePtr, getLine and slice a STRING; records, length, count, findChar, findChars,
! findByte, clipLength and instring a LONG. A subscript of a string - `x[i]` is one character,
! `x[a : b]` with literal bounds is b - a + 1, `st.valuePtr[...]` the same - unless the string
! is declared with DIM, when `x[i]` is a whole element and the width is not known. At the top, `&` makes
! a STRING whatever its operands, `+ - *` on integers a LONG, `/` on numbers a REAL. A leading
! `-` is a sign. A comparison, a logical operator, a choose(), an object, a reference, a dotted
! name the symbols do not resolve, a numeric literal that is not plain digits: ''.
! ARITHMETIC ON A ULONG IS DECIMAL: ULONG has the DECIMAL base type, so `+ - * /` with a ULONG
! operand is BCD arithmetic, which a LONG or REAL store converts - it answers DECIMAL, a number
! no target here holds exactly. A whole-number literal past the LONG range is a ULONG for the
! same reason, and past the ULONG range ''.
!===============================================================================================
VitEngine.IsuExprType Procedure(LONG pS, LONG pE, *LONG pWidth, *LONG pLit)
s        long,auto
e        long,auto
j        long,auto
depth    long,auto
nOps     long,auto
opAmp    long,auto
opDiv    long,auto
opNum    long,auto
aS       long,auto               ! the operand being collected
w        long                    ! a recursive answer's width
lit      long                    ! ... and its literal token
kind     string(vs:maxName),auto ! ... and its class
allInt   byte,auto
anyReal  byte,auto
anyBad   byte,auto
anyDec   byte,auto
tU       string(vs:maxName),auto
tTy      string(1),auto
  code
  pWidth = 0
  pLit   = 0
  s = pS
  e = pE
  if e < s then return ''.
  loop                                                          ! `( expr )` - the brackets are the whole span
    get(self.tk.tokens, s)
    if errorcode() then return ''.
    if self.tk.tokens.tok &= NULL then return ''.
    if self.tk.tokens.tok <> '(' then break.
    if self.tk.MatchLeftBracket('(', ')', s) <> e then break.
    s += 1
    e -= 1
    if e < s then return ''.
  end
  depth = 0
  nOps  = 0
  opAmp = 0
  opDiv = 0
  opNum = 0
  loop j = s to e                                               ! the operators at the top of the expression
    get(self.tk.tokens, j)
    if errorcode() then return ''.
    if self.tk.tokens.tok &= NULL then cycle.
    tU  = self.tk.tokens.tok
    tTy = self.tk.tokens.type
    case tU
    of '(' orof '['
      depth += 1
      cycle
    of ')' orof ']'
      depth -= 1
      if depth < 0 then return ''.
      cycle
    end
    if depth then cycle.
    if tTy = vt:label or tTy = vt:Literal or tTy = vt:Integer or tTy = vt:NumericWithDecPt then cycle.
    if tU = '.' then cycle.                                     ! the dot of a method call or a property
    case tU
    of '&'
      opAmp += 1
      nOps  += 1
    of '/'
      opDiv += 1
      nOps  += 1
    of '+' orof '*'
      opNum += 1
      nOps  += 1
    of '-'
      if j > s                                                  ! a leading '-' is a sign
        opNum += 1
        nOps  += 1
      end
    else
      return ''                                                 ! a comparison, a logical operator, a comma: not a value this reads
    end
  end
  if depth then return ''.
  if ~nOps then return self.IsuOperandType(s, e, pWidth, pLit).
  if opAmp then return self.IsuJoinType(s, e, pWidth).          ! `&` makes a string of whatever it joins: the sum of known widths, or 0
  allInt  = 1
  anyReal = 0
  anyBad  = 0
  anyDec  = 0
  depth   = 0
  aS      = s
  get(self.tk.tokens, s)
  if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '-' then aS = s + 1. ! the sign
  loop j = aS to e + 1                                          ! each operand between the operators
    if j <= e
      get(self.tk.tokens, j)
      if errorcode() then return ''.
      if self.tk.tokens.tok &= NULL then cycle.
      tU = self.tk.tokens.tok
      if tU = '(' or tU = '[' then depth += 1 ; cycle.
      if tU = ')' or tU = ']' then depth -= 1 ; cycle.
      if depth then cycle.
      if tU <> '+' and tU <> '-' and tU <> '*' and tU <> '/' then cycle.
    end
    if j - 1 < aS then return ''.                               ! two operators in a row
    kind = self.IsuExprType(aS, j - 1, w, lit)
    case kind
    of 'BYTE'  orof 'SHORT' orof 'USHORT' orof 'LONG'
    of 'ULONG'
      anyDec = 1
    of 'REAL'  orof 'SREAL'
      anyReal = 1
      allInt  = 0
    else
      anyBad = 1
    end
    aS = j + 1
  end
  if anyBad then return ''.
  if anyDec then return 'DECIMAL'.
  if opDiv or anyReal then return 'REAL'.
  if allInt then return 'LONG'.
  return ''

!===============================================================================================
! `a & b & c` at the top of an expression: a STRING whose width is the sum of the operands'
! widths when every operand is a STRING of known width - upper(s8) & lower(s8) is sixteen - and
! 0 (not known) as soon as one is not: a number's printed form has no fixed width.
!===============================================================================================
VitEngine.IsuJoinType Procedure(LONG pS, LONG pE, *LONG pWidth)
j      long,auto
depth  long,auto
aS     long,auto
w      long
lit    long
total  long,auto
kind   string(vs:maxName),auto
tU     string(vs:maxName),auto
  code
  pWidth = 0
  depth  = 0
  total  = 0
  aS     = pS
  loop j = pS to pE + 1
    if j <= pE
      get(self.tk.tokens, j)
      if errorcode() then return 'STRING'.
      if self.tk.tokens.tok &= NULL then cycle.
      tU = self.tk.tokens.tok
      if tU = '(' or tU = '[' then depth += 1 ; cycle.
      if tU = ')' or tU = ']' then depth -= 1 ; cycle.
      if depth then cycle.
      if tU <> '&' then cycle.
    end
    if j - 1 < aS then return 'STRING'.
    kind = self.IsuExprType(aS, j - 1, w, lit)
    if kind <> 'STRING' or ~w then return 'STRING'. ! not a string, or a string of no known width: the join's width is not known
    total += w
    aS = j + 1
  end
  pWidth = total
  return 'STRING'

!===============================================================================================
! One operand of IsuExprType: a token, a call, a method call on a StringTheory, a subscript.
!===============================================================================================
VitEngine.IsuOperandType Procedure(LONG pS, LONG pE, *LONG pWidth, *LONG pLit)
tU       string(vs:maxName),auto
tTy      string(1),auto
nmU      string(vs:maxName),auto
callU    string(vs:maxName),auto
typeU    string(vs:maxName)
isRef    byte
w        long
lit      long
kind     string(vs:maxName)
! #Removed as not used: close    long,auto
lo       long,auto
hi       long,auto
d        long,auto
dotAt    long,auto
q        long,auto
num      StringTheory
litV     real,auto
  code
  pWidth = 0
  pLit   = 0
  get(self.tk.tokens, pS)
  if errorcode() then return ''.
  if self.tk.tokens.tok &= NULL then return ''.
  tU  = self.tk.tokens.tok
  tTy = self.tk.tokens.type
  if pS = pE                                                            ! ---- one token
    if tTy = vt:Literal
      num.setValue(self.tk.tokens.tok)
      pWidth = self.IsuLiteralWidth(num)
      return 'STRING'
    end
    if tTy = vt:Integer
      num.setValue(self.tk.tokens.tok)
      if num.IsAllDigits() then pLit = pS.                              ! a hex or binary spelling is a LONG whose value this does not read
      ! A WHOLE NUMBER PAST THE LONG RANGE IS NOT A LONG: up to 4294967295 it is a ULONG's value,
      ! which a LONG store wraps and whose arithmetic is BCD; past that it is not read.
      if pLit and num._DataEnd > 9
        litV = num.getValue()
        if litV > 4294967295 then return ''.
        if litV > 2147483647 then return 'ULONG'.
      end
      return 'LONG'
    end
    if tTy = vt:NumericWithDecPt
      pLit = pS
      return 'REAL'
    end
    if tTy <> vt:label then return ''.
    if ~self.syms.Lookup(tU, pS, typeU, isRef) then return ''.
    if isRef then return ''.
    kind = self.IsuKeywordClass(typeU)
    if kind = 'STRING' then pWidth = self.syms.DeclaredStrLen(tU, pS).
    return kind
  end
  if tTy <> vt:label then return ''.
  nmU = upper(tU)
  get(self.tk.tokens, pS + 1)
  if errorcode() then return ''.
  if self.tk.tokens.tok &= NULL then return ''.
  if self.tk.tokens.tok = '['                                           ! ---- a subscript: x[i], x[a : b], st.valuePtr[...]
    if self.tk.MatchLeftBracket('[', ']', pS + 1) <> pE then return ''.
    dotAt = 0
    loop d = 1 to len(clip(nmU))
      if nmU[d] = '.' then dotAt = d.
    end
    if dotAt
      if nmU[dotAt + 1 : len(clip(nmU))] <> 'VALUEPTR' then return ''.
      if ~self.syms.Lookup(nmU[1 : dotAt - 1], pS, typeU, isRef) then return ''.
      if typeU <> 'STRINGTHEORY' then return ''.
    else
      if ~self.syms.Lookup(nmU, pS, typeU, isRef) then return ''.
      if isRef then return ''.
      if typeU <> 'STRING' and typeU <> 'CSTRING' and typeU <> 'PSTRING' then return ''.
      if self.syms.DeclaredHasDim(nmU, pS) then return 'STRING'.        ! an array, or a declaration not read whole: x[i] is a whole ELEMENT, of a width this does not read
    end
    if pE - 1 = pS + 2 then pWidth = 1.                                 ! x[i] - one character
    if pE - 1 = pS + 4                                                  ! x[a : b] with literal bounds
      get(self.tk.tokens, pS + 3)
      if errorcode() then return ''.
      if not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = ':'
        lo = 0
        hi = 0
        get(self.tk.tokens, pS + 2)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.type = vt:Integer then lo = self.tk.tokens.tok.
        get(self.tk.tokens, pS + 4)
        if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.type = vt:Integer then hi = self.tk.tokens.tok.
        if lo > 0 and hi >= lo then pWidth = hi - lo + 1.
      end
    end
    return 'STRING'
  end
  if self.tk.tokens.tok = '.'                                           ! ---- recv.method(...) on a StringTheory whose declaration is visible
    get(self.tk.tokens, pS + 2)
    if errorcode() then return ''.
    if self.tk.tokens.tok &= NULL then return ''.
    if self.tk.tokens.type <> vt:label then return ''.
    callU = upper(self.tk.tokens.tok)
    get(self.tk.tokens, pS + 3)
    if errorcode() then return ''.
    if self.tk.tokens.tok &= NULL then return ''.
    if self.tk.tokens.tok <> '(' then return ''.
    if self.tk.MatchLeftBracket('(', ')', pS + 3) <> pE then return ''.
    if ~self.syms.Lookup(nmU, pS, typeU, isRef) then return ''.
    if typeU <> 'STRINGTHEORY' then return ''.
    case callU
    of 'GETVALUE' orof 'GETVALUEPTR' orof 'GETLINE' orof 'SLICE'
      return 'STRING'
    of 'RECORDS'  orof 'LENGTH'      orof 'COUNT'   orof 'FINDCHAR' orof 'FINDCHARS' orof 'FINDBYTE' orof 'CLIPLENGTH' orof 'INSTRING'
      return 'LONG'
    end
    return ''
  end
  if self.tk.tokens.tok <> '(' then return ''.
  if self.tk.MatchLeftBracket('(', ')', pS + 1) <> pE then return ''.
  case nmU                                                              ! ---- a call
  of 'UPPER' orof 'LOWER' orof 'LEFT' orof 'RIGHT' orof 'CENTER'
    if pE - 1 < pS + 2 then return ''.
    loop q = pS + 2 to pE - 1                                           ! one argument only - a second one sets the width, which this does not read
      get(self.tk.tokens, q)
      if errorcode() then return ''.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.tok = ',' then return 'STRING'.
    end
    kind = self.IsuExprType(pS + 2, pE - 1, w, lit)
    if kind <> 'STRING' then return 'STRING'.                           ! upper(n) of a number is a string of a width this does not read
    pWidth = w
    return 'STRING'
  of 'CLIP' orof 'SUB'      orof 'ALL' orof 'FORMAT'  orof 'CHR'     orof 'DEFORMAT'
    return 'STRING'
  of 'LEN'  orof 'INSTRING' orof 'VAL' orof 'RECORDS' orof 'POINTER' orof 'ERRORCODE' orof 'SIZE' orof 'INLIST' orof 'NUMERIC' orof 'BAND' orof 'BOR' orof 'BXOR' orof 'BSHIFT'
    return 'LONG'
  end
  return self.IsuKeywordClass(self.syms.MapProtoReturn(nmU))            ! a MAP procedure of this file, one prototype, a plain return type

!===============================================================================================
! A declared or returned type keyword as one of the classes IsuExprType answers; '' otherwise.
!===============================================================================================
VitEngine.IsuKeywordClass Procedure(STRING pTypeU)
  code
  case upper(pTypeU)
  of 'STRING'   orof 'CSTRING' orof 'PSTRING'
    return 'STRING'
  of 'BYTE'     orof 'SHORT'   orof 'USHORT'  orof 'LONG' orof 'ULONG' orof 'REAL' orof 'SREAL'
    return upper(clip(pTypeU))
  of 'SIGNED'
    return 'LONG'
  of 'UNSIGNED'
    return 'ULONG'
  end
  return ''

!===============================================================================================
! The width of a string literal token: the number of characters it stands for, read with the
! whole literal grammar (LitBytes) - a doubled quote, << and {{ are one character each, an
! angle-bracket escape one per number in it (<13,10> is two), and a repeat count multiplies:
! '*{9}' is nine. 0 when the spelling cannot be read, which the callers take as not known.
!===============================================================================================
VitEngine.IsuLiteralWidth Procedure(StringTheory pTok)
dec  StringTheory
  code
  if ~self.LitBytes(pTok.getValue(), dec) then return 0.
  return dec._DataEnd

!===============================================================================================
! Does the target of an InlineSingleUse store hold the expression's value EXACTLY? Ruled 13 Sep
! 2026: the fold drops the store's conversion, so it happens only when there is none.
!   * the StringTheory spelling: the expression must be a STRING of any width - setValue of a
!     number stores its printed form, which a numeric compare of the expression need not equal;
!   * a plain STRING(n): a STRING of exactly n - a wider value was truncated, a narrower one
!     padded, and len(), a concatenation or an append would see the difference;
!   * an integer type: an integer class whose whole range fits - BYTE in anything, SHORT and
!     USHORT in LONG, LONG in LONG, ULONG in ULONG - or a plain-digit literal in range;
!   * REAL: any integer class, SREAL, REAL, or a numeric literal - not the DECIMAL a ULONG operand
!     makes of a sum, which the store rounds; SREAL: BYTE, SHORT, USHORT, SREAL, or a plain-digit
!     literal of at most 16777216 either side of zero - the largest whole numbers a four-byte
!     float holds exactly; a wider one, and any decimal literal, is
!     rounded on the way in, so a compare against the literal would no longer be the same test;
!   * anything else - CSTRING, PSTRING, DECIMAL, a reference, a type this does not know: no.
!===============================================================================================
VitEngine.IsuTypeExact Procedure(LONG pSymRow, BYTE pIsST, LONG pS, LONG pE)
cls   string(vs:maxName),auto
tgt   string(vs:maxName),auto
w     long
lit   long
n     long
v     real
hasV  byte,auto
  code
  cls = self.IsuExprType(pS, pE, w, lit)
  if ~cls then return 0.
  if pIsST then return choose(cls = 'STRING').
  get(self.syms.syms, pSymRow)
  if errorcode() then return 0.
  if self.syms.syms.isRef or self.syms.syms.isLike or self.syms.syms.isField then return 0.
  tgt = self.syms.syms.typeU
  hasV = 0
  if lit
    get(self.tk.tokens, lit)
    if ~errorcode() and not self.tk.tokens.tok &= NULL
      v = self.tk.tokens.tok
      hasV = 1
    end
  end
  case tgt
  of 'STRING'
    if cls <> 'STRING' then return 0.
    n = self.syms.DeclaredStrLen(self.syms.syms.nameU, self.syms.syms.declTok)
    if ~n or ~w then return 0.
    return choose(w = n)
  of 'LONG' orof 'SIGNED'
    case cls
    of 'BYTE' orof 'SHORT' orof 'USHORT' orof 'LONG'
      return 1
    end
    return 0
  of 'ULONG' orof 'UNSIGNED'
    case cls
    of 'BYTE' orof 'USHORT' orof 'ULONG'
      return 1
    of 'LONG'
      if hasV and v >= 0 then return 1.
    end
    return 0
  of 'SHORT'
    if cls = 'BYTE' or cls = 'SHORT' then return 1.
    if cls = 'LONG' and hasV and v >= -32768 and v <= 32767 then return 1.
    return 0
  of 'USHORT'
    if cls = 'BYTE' or cls = 'USHORT' then return 1.
    if cls = 'LONG' and hasV and v >= 0 and v <= 65535 then return 1.
    return 0
  of 'BYTE'
    if cls = 'BYTE' then return 1.
    if cls = 'LONG' and hasV and v >= 0 and v <= 255 then return 1.
    return 0
  of 'REAL'
    if cls = 'STRING' then return 0.
    if cls = 'DECIMAL' then return 0.
    loop n = pS to pE                                     ! a division of integers, or a decimal constant, is BCD
      get(self.tk.tokens, n)                              !   arithmetic, which the store rounds into the REAL
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      if self.tk.tokens.tok = '/' or self.tk.tokens.type = vt:NumericWithDecPt then return 0.
    end
    return 1
  of 'SREAL'
    case cls
    of 'BYTE' orof 'SHORT' orof 'USHORT' orof 'SREAL'
      return 1
    of 'LONG'
      if hasV and v >= -16777216 and v <= 16777216 then return 1.
    end
    return 0
  end
  return 0

! ====================================================================================
! BUILTIN IfChainToCase (idiom cleanup, on by default) - collapse a chain of
! equality tests on ONE repeated expression into a CASE, so the expression is evaluated
! ONCE instead of once per arm:
!
!     if lower(w.getValue()) = 'fold' or lower(w.getValue()) = 'trimr'    case lower(w.getValue())
!       <body A>                                                         of 'fold' orof 'trimr'
!     elsif lower(w.getValue()) = 'chr'                          ==>        <body A>
!       <body B>                                                         of 'chr'
!     else                                                                  <body B>
!       <body C>                                                         else
!     end                                                                   <body C>
!                                                                        end
!
! The model that keeps this small: THE BODIES ARE NEVER TOUCHED, and the block's ELSE and
! its terminator (END or '.') already mean to a CASE exactly what they meant to the IF.
! Only the IF head and each ELSIF head are rewritten, by four token edits:
!   * the IF keyword      -> `case`  (SetTok, trivia KEPT - the CASE lands on the IF's line
!                                     at the IF's indent, and the expression that followed
!                                     the IF stays put and becomes the CASE selector)
!   * the first arm's '=' -> `of`    (SetTok with '<13,10>' & indent, so `of` starts a new
!                                     line level with the CASE; the literal after it keeps
!                                     its own leading space)
!   * each later `or`     -> `orof`  (SetTok, trivia kept) plus DeleteToks over THAT arm's
!                                     repeated expression and its '='
!   * an ELSIF keyword    -> `of`    (SetTok, trivia kept - it already owns its line) plus
!                                     DeleteToks over its repeated expression and its '='
! SetTok re-runs TokenType, so the new `case` immediately carries level '+' and every new
! `of`/`orof` carries '/' - the level marks stay consistent for the rest of the pass.
! Edits are collected first and applied HIGHEST POSITION FIRST (the established pattern):
! a DeleteToks shifts every position above it, so a right-to-left apply is the only order
! in which the staged positions stay valid.
!
! A '|' continuation needs no special handling: the tokenizer parks the bar AND the CRLF in
! the strBefore of the token that FOLLOWS the bar, so deleting an arm's repeated expression
! also removes the line break in front of it (the arms simply close up onto one line), and a
! bar sitting in front of an `or` survives into the `orof`. Either way the result is legal.
!
! SAFETY. Collapsing evaluates the repeated expression ONCE where the IF evaluated it up to
! N times, so it is sound only when that expression is PURE. Purity is PROVEN, not assumed:
! every token of the expression must be a name, a member dot, a constant inside an argument
! list, or a CALL whose name is on a known-pure list (Clarion reader builtins plus the
! StringTheory reader methods; extend it per rule file with the PURE(name name) parameter).
! A call that is not on the list refuses the WHOLE IF - `if NextWord() = 'a' or NextWord() =
! 'b'` consumes two words and must go on doing so. A token followed by '(' is the call being
! made, so that is the token whose name is tested; the tokenizer does not merge a dotted name
! when a '(' follows it, so a method call arrives as [obj] [.] [method] ['('] and the name
! tested is the METHOD. A name with NO '(' after it - a plain one, a merged dotted one
! (st._DataEnd), the name in front of a '[' - is a READ only when the symbol table says it
! names data: Clarion calls a parameterless procedure or method by its label alone, so
! `GetNext` and `self.NextWord` are calls with nothing to recognise them by, and every such
! name goes through CondNamesAreData, the proof HoistCommonBranchCode uses. A name that does
! not resolve refuses the IF. The edits renumber the token queue, so the table is marked
! stale after each conversion and the next proof rebuilds it.
!
! WHAT IT REFUSES (all under-reach - a refusal leaves working code exactly as it was):
!   * anything but a top-level OR chain whose arms are `EXPR = <constant>` or the RANGE
!     `(EXPR >= lo and EXPR <= hi)` (brackets optional), which becomes `of lo to hi` - CASE's
!     range compares strings exactly as `>=` and `<=` do. The WHOLE condition may be `~( ... )`
!     or `not ( ... )`: then the OF list is written with no body and the IF's body becomes the
!     ELSE, which is only possible when the IF has no ELSIF or ELSE of its own. So may the
!     IF head's whole test be `EXPR < lo or EXPR > hi` (brackets optional), which IS
!     `~(EXPR >= lo and EXPR <= hi)`: `<` becomes `of`, `or` becomes `to`, the expression
!     again and its `>` go, and the body becomes the ELSE - even as a single OF, because in
!     optimised casevalue then compares it as integers (ruled 23 Oct 2026). Not from a
!     one-liner, and not with the bounds the other way round. Anything else
!     refuses: XOR, a NOT or '~' inside an arm, any other `>` and `<` (exclusive bounds have no CASE
!     spelling), a bound or a right-hand side that is not a single constant token,
!     parentheses that are not a call, and any operator or bracket inside the expression -
!     EXCEPT a subscript on a name, `name[...]`, whose interior may hold anything this scanner
!     already accepts plus `+ - * /` and the `:` of a slice. The test there is PURITY, not
!     constancy: `name[1]`, `name[k]` and `name[1 : 2]` are taken because nothing in a condition
!     can change k while the condition is being evaluated, while `name[Next()]` still refuses
!     because a call inside the subscript runs once per arm as an IF and once as a CASE;
!   * an expression that is not TEXTUALLY IDENTICAL (caseless, whitespace-blind, via
!     SpanTokEqual) in every arm of every head - a CASE has exactly one selector;
!   * more than one comment in one head. A head's ONE comment - a '!', or words after a bar -
!     ends on the `of` line made from that head (ruled 23 Oct 2026): where it stands when the
!     edits leave its token alone, at the end of that line when they delete or replace its
!     trivia, and in a one-liner, whose own line end closes the `end`, on the line break the
!     THEN becomes. A NEGATED head's comment - `~( ... )`, or E < lo or E > hi - goes on its
!     `else` line instead: it says when the body runs, and the `of` line lists the values the
!     body does not run for. Two would have to share that line. A comment in a one-liner's BODY is the
!     body's, and the IF stays as it is. So does one the comment layout reads as CARRIED ON
!     (its text indented after the marker, --cmtcont=indent) when the conversion would part
!     it from its other half: an IF's that carries on the line above, where the `case` line
!     would come between them, and a one-liner's that the next line carries on, where its
!     body and `end` would;
!   * a one-liner head (`then` or ';' before the line ends) whose expression is a bare name
!     against only two values: the CASE would be three lines longer for nothing. A one-liner
!     whose expression does work - a call - or that tests three or more values
!     IS converted, and written in block form as part of the conversion: the THEN becomes the
!     line break after the OF list, the body takes a line of its own, the '.' becomes `end`.
!     `if C then S; T.`, an ELSE on the line, `if ~(C) then S.` and a body that closes more
!     than the IF (`S..`) stay as they are;
!   * an ELSIF at this IF's own depth whose condition does NOT qualify. A PARTIAL conversion
!     is IMPOSSIBLE - `case ... of ... elsif ...` is not legal Clarion - so a non-qualifying
!     ELSIF refuses the WHOLE IF rather than converting the arms in front of it;
!   * fewer than TWO resulting OF values across the whole IF - one `of` is no clearer than
!     the IF was. NOTE the count is of VALUES, not of arms: `if x = 'a' or x = 'b' or x = 'c'`
!     is a single arm and three values, and it qualifies. It is worth converting precisely
!     because the selector is evaluated ONCE PER COMPARISON in that shape and once in total as
!     a CASE - so the saving grows with the number of values, not with the number of arms.
!
! HIGH-RISK: this is the only builtin that changes an expression's evaluation COUNT.
!     The purity list IS the safety argument - a side-effecting name wrongly added to it (or
!     via PURE(...)) is a real bug. vitrules.txt declares it in a group of its own, `GROUP
!     if-chain-to-case`, on by default, so a plain run reaches it; --nogroup=if-chain-to-case
!     (or --skip=IfChainToCase) turns it off.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinIfChainToCase Procedure(StringTheory pLog)
i          long,auto
s          long,auto
raw        StringTheory
pureU      StringTheory       ! ' NAME NAME ... ' - space delimited, UPPER, leading AND trailing space
pureAddU   StringTheory       ! the names PURE(...) adds, in the same form - the author's word that they only read
pureOwnU   StringTheory       ! the names on pureU this file gives a procedure of its own (PureOwnList)
ifIndentSt StringTheory       ! the IF line's indent (trailing whitespace run of its strBefore)
ofSb       StringTheory       ! '<13,10>' & indent - the strBefore handed to the first `of`
ifTok      long               ! the IF keyword being considered
endTok     long               ! its matching terminator (END or '.') from MatchLevel
ifEol      long               ! EOL of the IF's LOGICAL line (a '|' continuation emits no EOL token)
scanFirst  long               ! condition span handed to IcScanArms
scanLast   long
refExpS    long               ! the reference expression = arm 1 of the IF head
refExpE    long
headTok    long               ! the head currently being staged (the IF, or an ELSIF)
headIsIf   byte
armOk      byte               ! IcScanArms verdict for the current head
armTotal   long               ! OF values across the whole IF
bail       byte               ! any refusal raised after the IF head scan
converted  byte               ! this IF was collapsed
oneLine    byte               ! the IF is `if C then S.` / `if C; S.`: the CASE is written in block form as part of the conversion
olThen     long               ! its THEN (or the ';' that plays THEN)
olDot      long               ! its terminating '.'
olWork     byte               ! the repeated expression does work - a call
negated    byte               ! the head is `~( C )` / `not ( C )`: the OF list stays empty and the body becomes the ELSE
negS       long               ! that `~` / `not` token
negE       long               ! its closing ')'
cPos       long               ! IcConstAt in: must this token be a constant?
constOk    byte               ! IcConstAt out
icSelS     long               ! IcConstAt in: the tested expression's first token
icSelE     long               !   and its last
icKind     string(vs:maxName) ! IcConstAt: its type, when the constant is a number
icW        long
icL        long
dep2       long               ! block depth while walking for our OWN ELSIF/ELSE
logLn      long               ! log-facing line of the IF, captured before the edits
changes    long
nxPos      long               ! IcPush staging (a routine takes no parameters)
nxPos2     long
nxKind     byte
nxTxt      string(8)
nxSb       byte
hcS        long               ! IcCmtScan in: a head's tokens after its keyword, to its EOL
hcE        long
hcN        long               ! IcCmtScan out: the comments in their trivia
hcAt       long               !   and the token whose trivia holds the last of them
hcFrom     long               ! IcCmtInd in: tokens whose trivia hold a physical line's comment
hcTo       long
hcInd      byte               ! IcCmtInd out: its text is indented after the marker - the comment above, carried on
outside    byte               ! the IF head is `E < lo or E > hi`, read as ~(E >= lo and E <= hi)
outsideOk  byte               ! IcScanArms in: the IF head's own test, where that form may be read
cmGone     byte               ! IcCmtGone out: a staged edit deletes or replaces the holder's trivia
cmTxt      StringTheory       ! IcCmtText out: the comment as it is written at the end of a line
olCmt      StringTheory       ! a one-liner's comment, for the end of its `of` line - the THEN that becomes the line break
elCmt      StringTheory       ! a negated head's comment, for its `else` line
ArmQ  QUEUE,PRE(aq)
armOr     long                ! the `or` that introduces this arm (0 = first arm of its head)
armEq     long                ! this arm's top-level '='
armExpS   long                ! first token of this arm's repeated expression
armExpE   long                ! last token of it (always armEq - 1)
armKind   byte                ! 0 = `E = lit`; 1 = the RANGE `E >= lo and E <= hi`, which becomes `of lo to hi`
armOpen   long                ! a range arm's own '(' (0 = none)
armAnd    long                ! its `and` - retyped to `to`
armExp2S  long                ! the expression repeated on the far side of the `and`
armExp2E  long
armLe     long                ! its top-level '<='
armClose  long                ! its ')' (0 = none)
      END
EdQ   QUEUE,PRE(ed)
pos       long                ! SetTok target, or the FIRST token of a delete range
pos2      long                ! last token of a delete range (kind 2 only)
kind      byte                ! 1 = SetTok, 2 = DeleteToks, 3 = an `else` line spliced in front of pos (a negated head), 4 = one space in front of pos, 5 = a one-liner's THEN becomes its line break, 6 = its body's indent, 7 = its '.' becomes `end`
txt       string(8)           ! 'case' / 'of' / 'orof' (kind 1 only)
useSb     byte                ! 1 = pass ofSb as the new strBefore (the first `of` only)
      END
CmQ   QUEUE,PRE(cm)           ! a head's one comment: it ends on the `of` line made from that head
hold      long                ! the token whose trivia holds it
tgt       long                ! the end of that `of` line: the head's EOL, or a one-liner's THEN
      END
  code
  free(ArmQ)                                     ! local QUEUEs persist between calls - start every pass empty
  free(EdQ)
  free(CmQ)
  self.IfCasePureList(pureU)                     ! the base list; PURE(...) only ever APPENDS to it
  pureAddU.setValue(' ')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      if upper(self.rl.rules.bparmQ.name) = 'PURE' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value) ! parsed exactly like UnusedVars' EXCLUDE(a b c)
        raw.upper()
        pureU.append(clip(raw.getValue()) & ' ') ! the list already ends in a space
        pureAddU.append(raw.getValue() & ' ')
      end
    end
  end
  self.PureOwnList(pureU, pureOwnU)

  if records(self.tk.tokens) < 1 then return 0.
  i = 0
  loop
    i += 1
    if i > records(self.tk.tokens) then break.   ! LIVE bound: the stream shrinks as chains collapse
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.type <> vt:reservedWord or |   ! IF is a reserved word ('r'); a variable named if is 'b'
       ~self.tk.tokens.firstOnLine            or |
       self.tk.tokens.tok &= NULL             or |
       upper(self.tk.tokens.tok) <> 'IF'      or |
       self.tk.tokens.level <> '+'               ! block opener (TokenType); ELSE/ELSIF are '/', END/'.' are '-'
      cycle
    end
    ifTok = i
    do IcTryOne
    if ~converted then cycle.
    changes += 1
    if changes = 501
      pLog.append('BUILTIN IfChainToCase: further detail lines suppressed (500 shown)<13,10>')
    end
    if changes <= 500
      pLog.append('BUILTIN IfChainToCase line ' & logLn & ': ' & armTotal & ' arm(s) -> CASE<13,10>')
    end
    i = ifTok                                    ! resume just after the new `case` - it can never re-match `if`
  end
  if changes
    self.wantReparse = true                      ! structure changed; later builtins must see the CASE, not the IF
    pLog.append('BUILTIN IfChainToCase: ' & changes & ' chain(s) collapsed this pass<13,10>')
  end
  free(ArmQ)
  free(EdQ)
  free(CmQ)
  return changes

! ---- try to collapse the IF at ifTok; sets converted / armTotal / logLn ----
IcTryOne routine
  converted = 0
  bail      = 0
  armTotal  = 0
  refExpS   = 0
  refExpE   = 0
  free(EdQ)
  free(CmQ)
  olCmt.free()
  elCmt.free()
  ifEol = self.FirstEolAfter(ifTok)                                      ! a '|' continuation carries no EOL token, so this IS the logical line end
  if ~ifEol then exit.
  do IcOneLiner                                                          ! `if C then S.` / `if C; S.`: the CASE is written in block form as part of the conversion
  if bail then exit.
  hcS = ifTok + 1 ; hcE = ifEol ; do IcCmtScan                           ! ONE comment in the head ends on the `of` line made from it;
  if hcN > 1 then exit.                                                  !   two would have to share that line, so the IF stays
  if hcN
    if oneLine and hcAt > olThen and hcAt <= olDot then exit.            ! in a one-liner's body: it is about the body, not the test
    clear(CmQ) ; cm:hold = hcAt ; cm:tgt = choose(~oneLine, ifEol, olThen) ; add(CmQ)
  end
  if hcN and ~self.cmtContNone                                           ! A COMMENT THE TOOL READS AS CARRIED ON stays beside its
    hcFrom = ifTok + 1 ; hcTo = ifEol ; do IcCmtInd                      !   other half (ruled 23 Oct 2026): one that carries on the
    if hcInd and self.IsEolTok(ifTok - 1) and self.LineHasComment(ifTok - 1, ifTok - 1) then exit. ! line above would have the `case` line between
    if oneLine                                                           !   them, and a one-liner's carried on by the next line
      hcTo = self.FirstEolAfter(ifEol)                                   !   would have the body and the `end` between them
      if hcTo
        hcFrom = ifEol + 1 ; do IcCmtInd
        if hcInd then exit.
      end
    end
  end
  if oneLine
    scanLast = olThen - 1
  else
    get(self.tk.tokens, ifTok)                                           ! position the queue for MatchLevel
    if errorcode() then exit.
    endTok = self.tk.MatchLevel()                                        ! the matching '-' (END or '.')
    if endTok <= ifTok then exit.
    if ifEol >= endTok then exit.                                        ! no body between the head and the terminator
    scanLast = ifEol - 1
  end
  scanFirst = ifTok + 1
  do IcNegation                                                          ! `if ~( C )` / `if not ( C )`: C is the chain, the body is the ELSE
  if oneLine and negated then exit.                                      ! `if ~(C) then S.` is not written; its block form is
  outside   = 0
  outsideOk = choose(~negated)                                           ! `E < lo or E > hi` is read only as the IF head's whole test
  do IcScanArms
  outsideOk = 0
  if ~armOk then exit.
  if outside                                                             ! read as ~(E >= lo and E <= hi): the body is the CASE's ELSE,
    if oneLine then exit.                                                !   with no `~(` to take out - and, like `if ~(C) then S.`, not
    negated = 1 ; negS = 0 ; negE = 0                                    !   written from a one-liner
  end
  get(ArmQ, 1)
  if errorcode() then exit.
  refExpS = aq:armExpS                                                   ! arm 1 of the IF head DEFINES the CASE selector
  refExpE = aq:armExpE
  do IcCheckSame
  if bail then exit.
  headTok  = ifTok
  headIsIf = 1
  do IcEmitHead
  if bail then exit.
  if ~oneLine then do IcHeads.                                           ! the ELSIF chain at this IF's own depth (a one-liner has none)
  if bail or                                                             |
     (armTotal < 2 and ~outside)                                         ! a single OF is no clearer than the IF - but the outside form's one
    exit                                                                 !   range is what casevalue then compares as integers (ruled 23 Oct 2026)
  end
  if oneLine
    do IcWork                                                            ! the CASE is three lines longer than the one-liner: two values pay for that only when the expression does work
    if ~olWork and armTotal < 3 then exit.
    nxPos = olThen     ; nxPos2 = 0 ; nxKind = 5 ; nxTxt = '' ; nxSb = 0 ! THEN (or ';') becomes the line break after the OF list
    do IcPush
    nxPos = olThen + 1 ; nxPos2 = 0 ; nxKind = 6 ; nxTxt = '' ; nxSb = 0 ! the body on a line of its own, two in
    do IcPush
    nxPos = olDot      ; nxPos2 = 0 ; nxKind = 7 ; nxTxt = '' ; nxSb = 0 ! its '.' becomes `end` on a line of its own
    do IcPush
  end
  do IcCaptureIndent
  logLn = self.LogLineOf(ifTok)                                          ! captured BEFORE the edits - log coordinates only, never logic
  do IcApply
  if not self.syms &= NULL then self.syms.dirty = 1.                     ! the edits renumber the queue; the next IF's name proofs rebuild the table through Lookup
  converted = 1

! ---- every arm of the head just scanned must repeat the SAME expression ----
IcCheckSame routine
  data
c  long,auto
  code
  loop c = 1 to records(ArmQ)
    get(ArmQ, c)
    if errorcode() then bail = 1 ; exit.
    if ~self.SpanTokEqual(refExpS, refExpE, aq:armExpS, aq:armExpE) then bail = 1 ; exit.
    if aq:armKind = 1 ! a range repeats the expression on both sides of its `and`
      if ~self.SpanTokEqual(refExpS, refExpE, aq:armExp2S, aq:armExp2E) then bail = 1 ; exit.
    end
  end

! ---- is the IF at ifTok a one-liner, `if C then S.` or `if C; S.`? Sets oneLine, olThen, olDot,
!      endTok. Two statements after the THEN, an ELSE on the line, a nested block, a body that
!      closes more than the IF (`S..`) or a missing '.' are not this shape: bail. ----
IcOneLiner routine
  data
z      long,auto
thenC  long,auto
semiC  long,auto
semiP  long,auto
lastT  long,auto
plusC  long,auto
slashC long,auto
  code
  oneLine = 0
  olThen  = 0
  olDot   = 0
  thenC   = 0
  semiC   = 0
  semiP   = 0
  lastT   = 0
  plusC   = 0
  slashC  = 0
  loop z = ifTok + 1 to ifEol - 1
    get(self.tk.tokens, z)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.level = '+' then plusC += 1.
    if self.tk.tokens.level = '/' then slashC += 1.
    if self.tk.tokens.tok &= NULL then cycle.
    lastT = z
    if upper(self.tk.tokens.tok) = 'THEN' then thenC += 1 ; olThen = z.
    if self.tk.tokens.tok = ';'
      semiC += 1
      if ~semiP then semiP = z.
    end
  end
  if thenC + semiC = 0 then exit.                                                     ! a block IF
  if thenC + semiC <> 1 or plusC or slashC then bail = 1 ; exit.
  if semiC then olThen = semiP.                                                       ! `if C; S.` - the ';' plays THEN's part
  if ~lastT then bail = 1 ; exit.
  get(self.tk.tokens, lastT)
  if errorcode() then bail = 1 ; exit.
  if self.tk.tokens.tok <> '.' or self.tk.tokens.type <> vt:end then bail = 1 ; exit. ! the terminator must be the line's last token
  if olThen + 1 >= lastT then bail = 1 ; exit.                                        ! an empty body
  loop z = olThen + 1 to lastT - 1                                                    ! no second terminator inside the body: `S..` closes more than the IF
    get(self.tk.tokens, z)
    if errorcode() then bail = 1 ; exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = vt:end then bail = 1 ; exit.
  end
  olDot   = lastT
  endTok  = lastT
  oneLine = 1

! ---- does the repeated expression do work - a call? A bare name against two
!      values is left as the one-liner it is: the CASE would be three lines longer for nothing. ----
IcWork routine
  data
z  long,auto
  code
  olWork = 0
  loop z = refExpS to refExpE
    get(self.tk.tokens, z)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '(' then olWork = 1 ; exit.
  end

! ---- stage (do NOT apply) the token edits for one qualified head ----
IcEmitHead routine
  data
a  long,auto
  code
  get(ArmQ, 1)
  if errorcode() then bail = 1 ; exit.
  if headIsIf
    nxPos = headTok  ; nxPos2 = 0 ; nxKind = 1 ; nxTxt = 'case' ; nxSb = 0         ! `if` -> `case`, indent kept
    do IcPush
    nxPos = aq:armEq ; nxPos2 = 0 ; nxKind = 1 ; nxTxt = 'of'   ; nxSb = 1         ! first '=' -> `of` on a NEW line; the expression in front of it stays put as the selector
    do IcPush
    if aq:armOpen                                                                  ! a bracketed first range arm: its '(' goes, the expression is the selector
      nxPos = aq:armOpen ; nxPos2 = nxPos ; nxKind = 2 ; nxTxt = '' ; nxSb = 0
      do IcPush
    end
    if negated                                                                     ! `~(` and its `)` go; an `else` line goes in front of the body
      if negS                                                                      !   (the outside form, E < lo or E > hi, has no `~(` to take out)
        nxPos = negS ; nxPos2 = negS + 1 ; nxKind = 2 ; nxTxt = '' ; nxSb = 0
        do IcPush
        nxPos = negE ; nxPos2 = negE ; nxKind = 2 ; nxTxt = '' ; nxSb = 0
        do IcPush
      end
      nxPos = ifEol + 1 ; nxPos2 = 0 ; nxKind = 3 ; nxTxt = 'else' ; nxSb = 0
      do IcPush
    end
    if aq:armOpen or (negated and negS)                                            ! the token before the selector went: give it its space
      nxPos = aq:armExpS ; nxPos2 = 0 ; nxKind = 4 ; nxTxt = '' ; nxSb = 0
      do IcPush
    end
  else
    nxPos = headTok     ; nxPos2 = 0        ; nxKind = 1 ; nxTxt = 'of' ; nxSb = 0 ! `elsif` -> `of`; it already owns its line, so keep its trivia
    do IcPush
    nxPos = headTok + 1 ; nxPos2 = aq:armEq ; nxKind = 2 ; nxTxt = ''   ; nxSb = 0 ! drop the repeated expression and its '='
    do IcPush
  end
  do IcRangeTail                                                                   ! arm 1, when it is a range
  loop a = 2 to records(ArmQ)
    get(ArmQ, a)
    if errorcode() then bail = 1 ; exit.
    nxPos = aq:armOr     ; nxPos2 = 0        ; nxKind = 1 ; nxTxt = 'orof' ; nxSb = 0
    do IcPush
    nxPos = aq:armOr + 1 ; nxPos2 = aq:armEq ; nxKind = 2 ; nxTxt = ''     ; nxSb = 0
    do IcPush
    do IcRangeTail
  end
  armTotal += records(ArmQ)

! ---- the far side of a range arm (the ArmQ row is current): `and` -> `to`, the repeated
!      expression and its '<=' go, and so does the arm's own ')'. The bounds keep their spacing.
!      A dataless routine -> no CODE section. ----
IcRangeTail routine
  if aq:armKind <> 1 then exit.
  nxPos = aq:armAnd   ; nxPos2 = 0          ; nxKind = 1 ; nxTxt = 'to' ; nxSb = 0
  do IcPush
  nxPos = aq:armExp2S ; nxPos2 = aq:armLe   ; nxKind = 2 ; nxTxt = ''   ; nxSb = 0
  do IcPush
  if aq:armClose
    nxPos = aq:armClose ; nxPos2 = aq:armClose ; nxKind = 2 ; nxTxt = '' ; nxSb = 0
    do IcPush
  end

! ---- `if ~( C )` / `if not ( C )`: when the bracket after the NOT closes exactly at the end of
!      the condition, C is the chain to scan and the IF's body is the CASE's ELSE - the OF list
!      is written with no body of its own. negS/negE remember the tokens to delete. ----
IcNegation routine
  data
z2  long,auto
d2  long
  code
  negated = 0
  if scanLast < scanFirst + 2 then exit.
  get(self.tk.tokens, scanFirst)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok <> '~' and upper(self.tk.tokens.tok) <> 'NOT' then exit.
  get(self.tk.tokens, scanFirst + 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.tok <> '(' then exit.
  loop z2 = scanFirst + 1 to scanLast ! that '(' must close AT the end of the condition
    get(self.tk.tokens, z2)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '(' then d2 += 1.
    if self.tk.tokens.tok = ')'
      d2 -= 1
      if ~d2
        if z2 <> scanLast then exit.  ! it closed early - `~(a) or b` is not this shape
        break
      end
    end
  end
  if d2 then exit.
  negated = 1
  negS = scanFirst
  negE = scanLast
  scanFirst += 2
  scanLast  -= 1

! ---- is the token at cPos a constant (a literal or an integer)? constOk ----
IcConstAt routine
  constOk = 0
  get(self.tk.tokens, cPos)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.type <> vt:Literal and self.tk.tokens.type <> vt:Integer then exit.
  if self.tk.tokens.type = vt:Integer                          ! a number against the expression: IF compares a string with it
    icKind = self.IsuExprType(icSelS, icSelE, icW, icL)        !   numerically, CASE as text ('01' = 1, but not OF 1) - so the
    if ~icKind and icSelS = icSelE                             !   expression must be shown to be a number; one name it cannot
      icKind = self.HayType(self.syms.TokText(icSelS), icSelS) ! type - self.kind, a DECIMAL - by its declaration
    end
    case icKind
    of   'BYTE'    orof 'SHORT'    orof 'USHORT'  orof 'LONG'    orof 'ULONG' orof 'SREAL' orof 'REAL' orof 'SIGNED' orof 'UNSIGNED'
    orof 'DECIMAL' orof 'PDECIMAL' orof 'BFLOAT4' orof 'BFLOAT8'
    else
      exit
    end
  end
  constOk = 1

! ---- append one staged edit (dataless routine -> no CODE section) ----
IcPush routine
  clear(EdQ)
  ed:pos   = nxPos
  ed:pos2  = nxPos2
  ed:kind  = nxKind
  ed:txt   = nxTxt
  ed:useSb = nxSb
  add(EdQ)

! ---- walk this IF's OWN depth for ELSIF/ELSE; nested blocks are stepped over ----
IcHeads routine
  data
w      long,auto
zz     long,auto
esEol  long,auto
lv     string(1),auto
tyv    string(1),auto ! token TYPE, needed for the inline-dot close
wU     string(vs:maxName),auto
  code
  dep2 = 0
  w    = ifTok                                                   ! the IF's own '+' is not counted: depth 0 IS this IF's body
  loop
    w += 1
    if w >= endTok then break.
    get(self.tk.tokens, w)
    if errorcode() then bail = 1 ; break.
    lv  = self.tk.tokens.level
    tyv = self.tk.tokens.type
    if lv = '+'
      dep2 += 1
    elsif lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/')
      dep2 -= 1                                                  ! the inline-dot idiom: an INLINE '.' terminator is retyped
      if dep2 < 0 then bail = 1 ; break.                         !   vt:end but carries NO '-' level - the level pass skips inline dots. Counting only '-' let a one-liner IF in the body
                                                                 !   inflate the depth for ever, so a REAL ELSIF below it read as nested and was stepped over - and this IF's head
                                                                 !   had already been staged as a CASE. The output would then have carried an ELSIF inside a CASE - not Clarion.
    elsif lv = '/'
      if dep2 > 0 then cycle.                                    ! an ELSE/ELSIF/OF belonging to a NESTED block
      if negated then bail = 1 ; break.                          ! a negated head owns the ELSE and can take no ELSIF: refuse
      if self.tk.tokens.tok &= NULL then bail = 1 ; break.
      wU = upper(self.tk.tokens.tok)
      if wU = 'ELSE' then break.                                 ! a trailing ELSE means the same to a CASE - left alone
      if wU <> 'ELSIF' then bail = 1 ; break.                    ! an OF/OROF at our own depth - not a shape we model
      if ~self.IsFirstOnLine(w) then bail = 1 ; break.           ! an ELSIF sharing a line with something else
      esEol = self.FirstEolAfter(w)
      if ~esEol then bail = 1 ; break.
      if esEol >= endTok then bail = 1 ; break.
      hcS = w + 1 ; hcE = esEol ; do IcCmtScan                   ! one comment ends on the `of` line this ELSIF becomes
      if hcN > 1 then bail = 1 ; break.
      if hcN then clear(CmQ) ; cm:hold = hcAt ; cm:tgt = esEol ; add(CmQ).
      loop zz = w + 1 to esEol - 1                               ! a one-liner ELSIF is not ours
        get(self.tk.tokens, zz)
        if errorcode() then bail = 1 ; break.
        if self.tk.tokens.tok &= NULL then cycle.
        if upper(self.tk.tokens.tok) = 'THEN' or                 |
           self.tk.tokens.tok = ';'
          bail = 1 ; break
        end
      end
      if bail then break.
      scanFirst = w + 1
      scanLast  = esEol - 1
      do IcScanArms
      if ~armOk then bail = 1 ; break.                           ! a non-qualifying ELSIF refuses the WHOLE IF: `case ... of ... elsif` is not Clarion
      do IcCheckSame
      if bail then break.
      headTok  = w
      headIsIf = 0
      do IcEmitHead
      if bail then break.
      w = esEol                                                  ! nothing on a qualified head line can carry a level mark
    end
  end
  ! belt: the walk must come back to the depth it started at. If it does not,
  ! some opener in the body was never closed by a mark we recognise - which means
  ! every ELSIF below it was mis-read as nested and silently stepped over. Refusing
  ! the whole IF is the only safe answer: the alternative is a CASE with an ELSIF
  ! left inside it. Costs nothing on well-formed code, where dep2 is always 0 here.
  if ~bail and dep2 then bail = 1.

! ---- parse the condition span [scanFirst..scanLast] as `EXPR = lit [or EXPR = lit]...` ----
! Fills ArmQ and sets armOk. Any refusal EXITs with armOk = 0 - the caller then abandons the
! whole IF. Nothing here edits tokens.
IcScanArms routine
  data
rcvTU  string(vs:maxName) ! a method call's object, resolved  ! no AUTO: may be read before it is set
rcvRf  byte               ! no AUTO: may be read before it is set
p      long,auto          ! start of the arm being parsed
q      long,auto          ! cursor inside the arm's expression
dep    long,auto          ! bracket depth - a call's own brackets AND a subscript's
sdep   long,auto          ! of that depth, how much is SUBSCRIPT. The two are kept
                          ! apart so widening what may appear inside `name[...]`
                          ! does not silently widen what may appear inside a
                          ! call's argument list, which is a separate question
eqP    long,auto          ! this arm's top-level '='
expS   long,auto
litP   long,auto
curOr  long,auto          ! the `or` that introduced this arm
geP    long,auto          ! a range arm's top-level '>=' (0 = an equality arm)
ltP    long,auto          ! the outside form's top-level '<'
gtP    long,auto          !   and its '>'
armO   long,auto          ! a range arm's own '(' (0 = none)
armC   long,auto          ! ... and its ')'
loP    long,auto          ! the range's bounds
hiP    long,auto
andP   long,auto          ! its `and`
exp2S  long,auto          ! the repeated expression after the `and` ...
leP    long,auto          ! ... up to this '<='
lastP  long,auto          ! the arm's last token, where the next `or` is looked for
d      long,auto
dotAt  long,auto
nLen   long,auto
tU     string(vs:maxName),auto
nmU    string(vs:maxName)
callU  string(vs:maxName),auto
tTy    string(1),auto
  code
  free(ArmQ)
  armOk = 0
  if scanLast < scanFirst then exit.                                            ! empty condition
  p     = scanFirst
  curOr = 0
  loop                                                                          ! one iteration per `EXPR = literal` arm, or per `(EXPR >= lo and EXPR <= hi)` range arm
    armO = 0
    get(self.tk.tokens, p)
    if errorcode() then exit.
    if not self.tk.tokens.tok &= NULL
      if self.tk.tokens.tok = '('                                               ! a range arm may be bracketed
        armO = p
        p += 1
      end
    end
    expS = p
    get(self.tk.tokens, expS)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then exit.
    if self.tk.tokens.type <> vt:label then exit.                               ! an arm must START with a name (a variable, or the callee of a call)
    dep  = 0
    sdep = 0
    eqP  = 0
    geP  = 0
    ltP  = 0
    q    = p
    loop while q <= scanLast
      get(self.tk.tokens, q)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then exit.
      tU  = upper(self.tk.tokens.tok)
      tTy = self.tk.tokens.type
      if tU = '('
        get(self.tk.tokens, q - 1)                                                    ! a '(' is only ever allowed as a CALL's opening bracket
        if errorcode() then exit.
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.type <> vt:label then exit.                                 ! grouping brackets - refused (we do not model precedence)
        nmU  = upper(self.tk.tokens.tok)
        nLen = len(clip(nmU))
        dotAt = 0
        loop d = 1 to nLen                                                            ! defensive: the tokenizer does NOT merge a dotted name in front of '(',
          if nmU[d] = '.' then dotAt = d.                                             ! so this should already be the bare method name - take the tail anyway
        end
        if dotAt >= nLen then exit.
        if dotAt
          callU = nmU[dotAt + 1 : nLen]
        else
          callU = nmU
        end
        if ~pureU.findChars(' ' & clip(callU) & ' ') then exit.                       ! NOT provably pure -> refuse the whole IF
        if dotAt then exit.                                                           ! a merged rcv.name( - not placed, refused
        if self.tk.GetTok(q - 2) = '.'                                                ! A METHOD IS PURE ONLY ON A STRINGTHEORY: the list names
          if self.syms &= NULL then exit.                                             !   StringTheory's readers, and another class's GetLine may
          if ~self.syms.Lookup(self.tk.GetTok(q - 3), q - 3, rcvTU, rcvRf) then exit. ! read the NEXT line on every call
          if upper(rcvTU) <> 'STRINGTHEORY' then exit.
        elsif ~pureAddU.findChars(' ' & clip(callU) & ' ')                            ! A CALL WITH NO OBJECT IN FRONT is pure only as one of
          if ~self.PureProc(callU, pureU, pureOwnU) then exit.                        !   the runtime's own readers (PureProc), or named by PURE(...)
        end
        dep += 1
        q += 1
        cycle
      end
      if tU = ')'
        dep -= 1
        if dep < 0 then exit.
        q += 1
        cycle
      end
      ! A SUBSCRIPT WHOSE EXPRESSION IS PURE IS AS STABLE A SELECTOR AS A BARE NAME, so
      ! `t2[1]`, `t2[k]` and `t2[1 : 2]` all make as good a CASE selector as `ch` does.
      ! Without this the brackets fell through to the refusal below and a chain like
      !     if t2[1] = '+' or t2[1] = '-' or t2[1] = '*' or ...
      ! was left alone - and that is the shape the conversion is worth most on, because the
      ! selector is evaluated once per comparison where a CASE evaluates it once.
      !
      ! *** WHY A VARIABLE SUBSCRIPT IS SAFE. It looks as if `t2[k]` should refuse because
      ! k could change between arms - but nothing in the condition can change it:
      ! Clarion has no assignment inside an expression, and the only calls this scanner
      ! admits are on IfCasePureList, every one a reader. Nor can an ELSIF body change it
      ! before a later arm is tested - if an arm's condition is true its body runs and no
      ! later condition is ever evaluated, and if it is false no body runs at all. So k holds
      ! one value for the whole condition, and `t2[k]` names one thing in every arm. ***
      !
      ! THE LINE THAT ACTUALLY MATTERS IS PURITY, NOT CONSTANCY. `t2[Next()]` must still
      ! refuse - a call in the subscript happens once per arm in the IF and once in the CASE,
      ! so an impure one changes what the program does. That is enforced without new code: a
      ! '(' inside these brackets meets the SAME callee-purity test above, because this block
      ! deliberately does not skip the subscript's interior - it walks it like any other.
      !
      ! sdep, not dep, carries the relaxation below, so widening a SUBSCRIPT does not also
      ! widen a call's ARGUMENT LIST. Those are separate questions and only one was asked.
      if tU = '['
        get(self.tk.tokens, q - 1)                                              ! a '[' is only ever a subscript, so it must follow a
        if errorcode() then exit.                                               ! NAME (or a merged dotted one - c.valuePtr[1] is one token)
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.type <> vt:label then exit.
        dep  += 1
        sdep += 1
        q += 1
        cycle
      end
      if tU = ']'
        if sdep < 1 then exit.                                                  ! a ']' with no '[' - malformed, refuse the IF
        dep  -= 1
        sdep -= 1
        if dep < 0 then exit.
        q += 1
        cycle
      end
      if ~dep and tU = '=' then eqP = q ; break.                                ! the arm's comparison - the expression is [expS..q-1]
      if ~dep and tU = '>=' then geP = q ; break.                               ! ... or the lower bound of a range arm
      if ~dep and tU = '<<' then ltP = q ; break.                               ! ... or of the outside form
      ! AND/OR/XOR/NOT are reserved words in keyword position only, so they are matched by
      ! TEXT, not by type - a continued line can present them with firstOnLine set.
      case tU
      of 'AND' orof 'OR' orof 'XOR' orof 'NOT' orof 'THEN' orof '~' orof ';' orof '='
        exit
      end
      ! Whitelist. Every other operator ('+', '-', '*', '/', '&', the comparison family) and
      ! every other bracket ('[', '{') falls through to the else and refuses the IF - the
      ! comparison operators are deliberately caught by the whitelist rather than named,
      ! so no '<' has to be written (and doubled) in a literal here.
      if tTy <> vt:label                                                        ! a label is allowed: a callee, tested at its '(', or a
        if self.tk.tokens.tok = '.'                                             ! read of data, tested below. Everything else: a whitelist
          if self.tk.tokens.level = '-' then exit.                              ! a block terminator '.', not a member dot
        elsif self.tk.tokens.tok = ','
          if dep < 1 then exit.                                                 ! a comma outside an argument list
        elsif tTy = vt:Literal or tTy = vt:Integer or tTy = vt:NumericWithDecPt
          if dep < 1 then exit.                                                 ! a constant outside an argument list
        elsif self.tk.tokens.tok = '+' or self.tk.tokens.tok = '-' or                 |
              self.tk.tokens.tok = '*' or self.tk.tokens.tok = '/' or                 |
              self.tk.tokens.tok = ':'
          ! Pure arithmetic, and the ':' of a slice, INSIDE A SUBSCRIPT ONLY - sdep, not dep.
          ! These compute a position from things already in the expression and call nothing, so
          ! they cannot make the selector answer differently in one arm than another. The text
          ! is carried into the CASE selector VERBATIM, so precedence is preserved by copying
          ! and nothing here has to model it. Anything else - '&', '^', the comparison family -
          ! still refuses, which is under-reach and costs only a conversion that does not happen.
          if sdep < 1 then exit.
        else
          exit
        end
      end
      if tTy = vt:label                                                               ! a name with no '(' after it must resolve to data - see the banner
        get(self.tk.tokens, q + 1)
        if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.tok <> '('
          if ~self.CondNamesAreData(q, q) then exit.
        end
      end
      q += 1
    end
    if geP                                                                            ! ---- a RANGE arm: E >= lo and E <= hi [ ) ]
      if geP - 1 < expS then exit.                                                    ! empty expression
      loP = geP + 1                                                                   ! lo: ONE constant token
      if loP > scanLast then exit.
      cPos = loP ; icSelS = expS ; icSelE = geP - 1
      do IcConstAt
      if ~constOk then exit.
      andP = loP + 1
      if andP > scanLast then exit.
      get(self.tk.tokens, andP)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then exit.
      if upper(self.tk.tokens.tok) <> 'AND' then exit.
      exp2S = andP + 1                                                                ! the expression again - IcCheckSame proves it is the same one
      leP   = 0
      q     = exp2S
      loop while q <= scanLast
        get(self.tk.tokens, q)
        if errorcode() then exit.
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.tok = '<<=' then leP = q ; break.
        q += 1
      end
      if ~leP or leP - 1 < exp2S then exit.
      hiP = leP + 1                                                                   ! hi: ONE constant token
      if hiP > scanLast then exit.
      cPos = hiP ; icSelS = expS ; icSelE = geP - 1
      do IcConstAt
      if ~constOk then exit.
      armC = 0
      if armO                                                                         ! a bracketed arm closes right after hi
        if hiP + 1 > scanLast then exit.
        get(self.tk.tokens, hiP + 1)
        if errorcode() then exit.
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.tok <> ')' then exit.
        armC = hiP + 1
      end
      clear(ArmQ)
      aq:armOr    = curOr
      aq:armEq    = geP
      aq:armExpS  = expS
      aq:armExpE  = geP - 1
      aq:armKind  = 1
      aq:armOpen  = armO
      aq:armAnd   = andP
      aq:armExp2S = exp2S
      aq:armExp2E = leP - 1
      aq:armLe    = leP
      aq:armClose = armC
      add(ArmQ)
      if errorcode() then exit.
      lastP = choose(armC <> 0, armC, hiP)
    elsif ltP                                                                         ! ---- OUTSIDE a range: E < lo or E > hi [ ) ], read as
      if ~outsideOk or curOr then exit.                                               !   ~(E >= lo and E <= hi) - the IF head's whole test only
      if ltP - 1 < expS then exit.                                                    ! empty expression
      loP = ltP + 1                                                                   ! lo: ONE constant token
      if loP > scanLast then exit.
      cPos = loP ; icSelS = expS ; icSelE = ltP - 1
      do IcConstAt
      if ~constOk then exit.
      andP = loP + 1                                                                  ! the `or`, which becomes `to`
      if andP > scanLast then exit.
      get(self.tk.tokens, andP)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then exit.
      if upper(self.tk.tokens.tok) <> 'OR' then exit.
      exp2S = andP + 1                                                                ! the expression again - IcCheckSame proves it is the same one,
      gtP   = 0                                                                       !   and the scan above let no '>' into the first
      q     = exp2S
      loop while q <= scanLast
        get(self.tk.tokens, q)
        if errorcode() then exit.
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.tok = '>' then gtP = q ; break.
        q += 1
      end
      if ~gtP or gtP - 1 < exp2S then exit.
      hiP = gtP + 1                                                                   ! hi: ONE constant token
      if hiP > scanLast then exit.
      cPos = hiP ; icSelS = expS ; icSelE = ltP - 1
      do IcConstAt
      if ~constOk then exit.
      armC = 0
      if armO                                                                         ! a bracketed test closes right after hi
        if hiP + 1 > scanLast then exit.
        get(self.tk.tokens, hiP + 1)
        if errorcode() then exit.
        if self.tk.tokens.tok &= NULL then exit.
        if self.tk.tokens.tok <> ')' then exit.
        armC = hiP + 1
      end
      lastP = choose(armC <> 0, armC, hiP)
      if lastP <> scanLast then exit.                                                 ! nothing may follow: its OF list is this one range
      clear(ArmQ)
      aq:armOr    = 0
      aq:armEq    = ltP                                                               ! '<' becomes `of`, as a range's '>=' does
      aq:armExpS  = expS
      aq:armExpE  = ltP - 1
      aq:armKind  = 1
      aq:armOpen  = armO
      aq:armAnd   = andP                                                              ! `or` becomes `to`, as a range's `and` does
      aq:armExp2S = exp2S
      aq:armExp2E = gtP - 1
      aq:armLe    = gtP                                                               ! the expression again and its '>' go
      aq:armClose = armC
      add(ArmQ)
      if errorcode() then exit.
      outside = 1
    else                                                                              ! ---- an EQUALITY arm: E = lit
      if armO then exit.                                                              ! `(E = lit)` in brackets is not modelled
      if ~eqP or                                                                      |   ! no top-level '=' in this arm
         eqP - 1 < expS                                                               ! empty expression
        exit
      end
      litP = eqP + 1                                                                  ! the right-hand side: exactly ONE constant token
      if litP > scanLast then exit.
      cPos = litP ; icSelS = expS ; icSelE = eqP - 1
      do IcConstAt
      if ~constOk then exit.
      clear(ArmQ)
      aq:armOr   = curOr
      aq:armEq   = eqP
      aq:armExpS = expS
      aq:armExpE = eqP - 1
      aq:armKind = 0
      add(ArmQ)
      if errorcode() then exit.
      lastP = litP
    end
    if lastP = scanLast then break.                                                   ! the chain ends here
    p = lastP + 1
    get(self.tk.tokens, p)                                                            ! only a top-level `or` may join the next arm
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL then exit.
    if upper(self.tk.tokens.tok) <> 'OR' then exit.
    curOr = p
    p += 1
    if p > scanLast then exit.                                                        ! a trailing `or` with nothing after it
  end
  if ~records(ArmQ) then exit.
  armOk = 1

! ---- capture the IF line's indent, exactly as BuiltinExpandOneLiners' CaptureIndentE does:
!      the trailing whitespace run of the line-start token's strBefore ----
IcCaptureIndent routine
  data
k2     long,auto
sbLen2 long,auto
ch2    string(1),auto
  code
  ifIndentSt.free()
  ofSb.setValue('<13,10>')                ! set FIRST: every exit below must still leave ofSb usable
  get(self.tk.tokens, ifTok)
  if errorcode() then exit.
  if self.tk.BufColOne() then exit.       ! column-1 IF (cannot happen: it would not be type 'r')
  sbLen2 = size(self.tk.tokens.strBefore)
  k2 = sbLen2
  loop while k2 >= 1
    ch2 = self.tk.tokens.strBefore[k2]
    case val(ch2)
    of 32 orof 9                          ! <space> orof <tab>
      k2 -= 1
    else
      break
    end
  end
  if k2 < sbLen2
    ifIndentSt.setValue(sub(self.tk.tokens.strBefore, k2 + 1, sbLen2 - k2))
    ofSb.append(ifIndentSt)
  end

! ---- apply the staged edits HIGHEST POSITION FIRST; a delete shifts everything above it ----
IcApply routine
  data
e  long,auto
  code
  loop e = 1 to records(CmQ)                                              ! FIRST, while every staged position still holds: a head's
    get(CmQ, e)                                                           !   comment whose trivia an edit deletes or replaces moves
    if errorcode() then break.                                            !   to the end of the `of` line made from that head
    do IcCmtGone
    if negated and cm:tgt = ifEol and (cmGone or cm:hold = ifEol)         ! A NEGATED HEAD'S comment says when its body runs, and the
      do IcCmtText                                                        !   body is the ELSE: the `of` line lists the values it does
      if cmTxt._DataEnd                                                   !   NOT run for, so the comment goes on the `else` line
        elCmt.setValue(' ' & cmTxt.getValue())                            !   (ruled 23 Oct 2026)
        if cm:hold = ifEol then self.tk.SetStrBefore(ifEol, '').
      end
      cycle
    end
    if ~cmGone then cycle.                                                ! it stays where it is, which is on that line already
    do IcCmtText
    if ~cmTxt._DataEnd then cycle.
    if oneLine and cm:tgt = olThen
      olCmt.setValue(' ' & cmTxt.getValue())                              ! the THEN becomes that line's end, below
    else
      self.tk.SetStrBefore(cm:tgt, ' ' & cmTxt.getValue())                ! the head's EOL, whose trivia was spaces at most
    end
    if oneLine and cm:hold = ifEol then self.tk.SetStrBefore(ifEol, '').  ! the line's own end now closes the `end`
  end
  sort(EdQ, -ed:pos)
  loop e = 1 to records(EdQ)
    get(EdQ, e)
    if errorcode() then break.
    case ed:kind
    of 1
      if ed:useSb
        self.tk.SetTok(ed:pos, clip(ed:txt), ofSb.getValue())             ! new text AND a new line break + indent in front
      else
        self.tk.SetTok(ed:pos, clip(ed:txt))                              ! strBefore OMITTED = keep the existing leading trivia
      end
    of 3                                                                  ! the `else` line in front of a negated head's body, at the CASE's indent
      self.tk.InsertString(ed:pos, ifIndentSt.getValue() & 'else' & elCmt.getValue() & '<13,10>')
    of 4
      self.tk.SetStrBefore(ed:pos, ' ')                                   ! the selector lost the '(' in front of it
    of 5
      if olCmt._DataEnd                                                   ! a one-liner's THEN (or ';') becomes the line break after the OF list,
        self.tk.SetTok(ed:pos, '<10>', olCmt.getValue())                  !   carrying the line's comment
      else
        self.tk.SetTok(ed:pos, '<10>', '')
      end
    of 6
      self.tk.SetStrBefore(ed:pos, ifIndentSt.getValue() & '  ')          ! its body on a line of its own, two in
    of 7
      self.tk.SetTok(ed:pos, 'end', ofSb.getValue())                      ! its '.' becomes `end` on a line of its own at the CASE's indent
    else
      self.tk.DeleteToks(ed:pos, ed:pos2)
    end
  end

! ---- the comments in the trivia of tokens hcS..hcE, one per physical line: a '!' and what follows
!      it, or words after a continuation bar. hcN counts them, hcAt is the token holding the last. ----
IcCmtScan routine
  data
hcT   long,auto
hcK   long,auto
hcIn  byte,auto
hcHas byte,auto
  code
  hcN = 0 ; hcAt = 0
  loop hcT = hcS to hcE
    get(self.tk.tokens, hcT)
    if errorcode() then hcN = 2 ; exit.                                   ! unreadable: as good as two - the IF stays
    if self.tk.tokens.strBefore &= NULL then cycle.
    hcIn = 0 ; hcHas = 0
    loop hcK = 1 to size(self.tk.tokens.strBefore)
      case val(self.tk.tokens.strBefore[hcK])
      of 13 orof 10                                                       ! the end of a physical line ends its comment
        if hcHas then hcN += 1 ; hcAt = hcT.
        hcIn = 0 ; hcHas = 0
      of 32  orof 9
      of 124                                                              ! '|': the rest of the line is a comment, if it says anything
        if hcIn
          hcHas = 1
        else
          hcIn = 1
        end
      of 33                                                               ! '!'
        hcIn = 1 ; hcHas = 1
      else
        if hcIn then hcHas = 1.
      end
    end
    if hcHas then hcN += 1 ; hcAt = hcT.
  end

! ---- does a staged edit delete or replace the trivia of cm:hold? Then its comment has to move. ----
IcCmtGone routine
  data
hcG  long,auto
  code
  cmGone = 0
  if oneLine and cm:hold = ifEol then cmGone = 1 ; exit.                  ! a one-liner's own line end closes the `end` once it is a block
  loop hcG = 1 to records(EdQ)
    get(EdQ, hcG)
    if errorcode() then break.
    case ed:kind
    of 2
      if cm:hold >= ed:pos and cm:hold <= ed:pos2 then cmGone = 1 ; exit.
    of 1
      if ed:useSb and ed:pos = cm:hold then cmGone = 1 ; exit.            ! the first `of`, given a new line break and indent
    of 4 orof 5 orof 6 orof 7
      if ed:pos = cm:hold then cmGone = 1 ; exit.
    end
  end

! ---- the one comment in cm:hold's trivia, as it is written at the end of a line: from its '!',
!      or words after a bar given one - only a bar makes them a comment where they stand ----
IcCmtText routine
  data
hcX   long,auto
hcA   long,auto
hcB   long,auto
hcBar byte,auto
  code
  cmTxt.free()
  get(self.tk.tokens, cm:hold)
  if errorcode() or self.tk.tokens.strBefore &= NULL then exit.
  hcA = 0 ; hcBar = 0
  loop hcX = 1 to size(self.tk.tokens.strBefore)
    case val(self.tk.tokens.strBefore[hcX])
    of 13  orof 10
      hcBar = 0
    of 32  orof 9
    of 124                                                                ! '|'
      hcBar = 1
    of 33                                                                 ! '!'
      hcA = hcX ; break
    else
      if hcBar then hcA = hcX ; break.
    end
  end
  if ~hcA then exit.
  hcB = size(self.tk.tokens.strBefore)
  loop hcX = hcA + 1 to hcB                                               ! to the end of its physical line
    if self.tk.tokens.strBefore[hcX] = '<13>' or self.tk.tokens.strBefore[hcX] = '<10>' then hcB = hcX - 1 ; break.
  end
  cmTxt.setValue(self.tk.tokens.strBefore[hcA : hcB])
  cmTxt.clip()
  if cmTxt.valuePtr[1] <> '!' then cmTxt.prepend('! ').

! ---- is the comment on the FIRST physical line of tokens hcFrom..hcTo carried on from the one
!      above - its text two or more spaces after the marker, as the comment layout reads it? ----
IcCmtInd routine
  data
hcV  long,auto
hcY  long,auto
hcSp long,auto
hcOn byte,auto
  code
  hcInd = 0 ; hcOn = 0 ; hcSp = 0
  loop hcV = hcFrom to hcTo
    get(self.tk.tokens, hcV)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    loop hcY = 1 to size(self.tk.tokens.strBefore)
      case val(self.tk.tokens.strBefore[hcY])
      of 13 orof 10                                                       ! the first physical line ends with no text after a marker
        exit
      of 32 orof 9
        if hcOn then hcSp += 1.
      of 33 orof 124                                                      ! '!' or '|': the marker - or, after one, its text
        if hcOn then hcInd = choose(hcSp >= 2) ; exit.
        hcOn = 1
      else
        if hcOn then hcInd = choose(hcSp >= 2) ; exit.
      end
    end
  end

! ------------------------------------------------------------------------------------
! The provably-pure call names IfChainToCase will accept inside the repeated expression.
! Space delimited, UPPER, with a leading AND a trailing space so instring(' NAME ', list)
! cannot match a substring of a longer name.
! Two families, both READ-ONLY by definition:
!   * Clarion reader builtins - they compute a value from their arguments and touch nothing;
!   * StringTheory reader methods - they inspect self.value and do
!     not modify it, so calling one once instead of three times is unobservable.
! Anything absent is refused, which is the safe direction. A rule file adds its own with
! BUILTIN IfChainToCase, PURE(myFn myOtherFn).
! NOTE the list is built with several appends on purpose: a single quoted literal beyond
! roughly 680 characters stops the Clarion parser dead.
! CHOOSE is listed but CANNOT currently be reached: `CHOOSE` is in vitTokenize's
!     reservedWords, so its token is typed 'r' and IfChainToCase's callee test (which
!     demands type 'b' = label) refuses it first. That is under-reach, not a hazard - a
!     `choose(...)` in the repeated expression simply leaves the IF alone. Left on the
!     list so the intent is recorded; revisit if the callee test is ever widened.
! ------------------------------------------------------------------------------------
VitEngine.IfCasePureList Procedure(StringTheory pOut)
  code
  pOut.setValue(' UPPER LOWER CLIP LEFT RIGHT CENTER SUB LEN VAL CHR NUMERIC INSTRING ')
  pOut.append('FORMAT DEFORMAT ABS INT ROUND BAND BOR BXOR BSHIFT CHOOSE ADDRESS SIZE ')
  pOut.append('GETVALUE GETVALUEPTR LENGTH LENGTHA CLIPLENGTH SLICE RECORDS GETLINE ')
  pOut.append('FINDCHAR FINDCHARS FINDBYTE CONTAINSCHAR CONTAINSBYTE ')

! ------------------------------------------------------------------------------------
! A pure list - this one, or KnownRangePureList, with a rule file's PURE(...) names - holds two
! kinds of reader: the runtime's own functions, called by name alone, and StringTheory's
! methods, called on an object. A name after an object's '.' is a METHOD, so only the second
! kind can be meant there: Fmt.Format(s), Buf.Size() and Num.Val(s) are that class's own
! methods, which may change what they are handed. 1 = pNameU is on pPure AND is a method
! StringTheory has that leaves the object as it was, so a call to it on an object may be read
! as a reader.
! THREE NAMES ARE READERS ONLY WITHOUT A DOT. The runtime's upper(x), lower(x) and clip(x)
! return a changed copy; StringTheory's Upper(), Lower() and Clip() return nothing and change
! the object's own value, so after a '.' they are writes and this answers 0. Left() and Right()
! stay readers either way: StringTheory's return a String and leave the object alone - its
! in-place forms are SetLeft() and SetRight(), which no pure list holds.
! Whether the object IS a StringTheory each caller asks of the receiver in front of the dot: a
! pure-list name called as a method is harmless only on a StringTheory (ruled 28 Oct 2026).
! ------------------------------------------------------------------------------------
VitEngine.PureMethod Procedure(STRING pNameU, StringTheory pPure)
nmU  string(vs:maxName),auto
  code
  nmU = upper(pNameU)
  if ~nmU then return 0.
  if ~pPure.findChars(' ' & clip(nmU) & ' ') then return 0.
  if ~self.stMeth.findChars(' ' & clip(nmU) & ' ') then return 0.
  case nmU
  of 'UPPER' orof 'LOWER' orof 'CLIP'
    return 0
  end
  return 1

! ------------------------------------------------------------------------------------
! The call whose '(' is at pParen, its name after a '.': 1 = it is a reader - PureMethod takes
! the name, and the receiver in front of the dot resolves to a StringTheory. GetLine, Length or
! FindChar on a class of the author's own may move a position or write an argument by address,
! so any other receiver, or one the symbol table cannot resolve, answers 0. So does a call with
! no '.' in front of its name: the runtime's own functions are the caller's question.
! ------------------------------------------------------------------------------------
VitEngine.PureMethodAt Procedure(LONG pParen, StringTheory pPure)
  code
  if pParen < 4 then return 0.
  if self.tk.GetTok(pParen - 2) <> '.' then return 0.
  if ~self.PureMethod(self.tk.GetTok(pParen - 1), pPure) then return 0.
  if self.syms &= NULL then return 0.
  if self.HayType(self.tk.GetTok(pParen - 3), pParen - 3) <> 'STRINGTHEORY' then return 0.
  return 1

! ------------------------------------------------------------------------------------
! The names on pPure that this file also gives a PROCEDURE of its own - a body here or a MAP
! prototype - into pOut, in the list's own form (' NAME NAME '). A call to one written with no
! object in front of it may run that procedure and not the runtime's function: a program's own
! `Size PROCEDURE(STRING s),LONG` is the one `size(s)` calls. A method does not count: it is
! called on an object, never by its name alone. A caller that asks PureProc often builds this once.
! The scopes buffer is put back on the row it was on.
! ------------------------------------------------------------------------------------
VitEngine.PureOwnList Procedure(StringTheory pPure, StringTheory pOut)
z   long,auto
sv  long,auto
nm  string(vs:maxName),auto
w   StringTheory
  code
  pOut.setValue(' ')
  if self.syms &= NULL or self.syms.scopes &= NULL then return.
  sv = pointer(self.syms.scopes)
  loop z = 1 to records(self.syms.scopes)
    get(self.syms.scopes, z)
    if errorcode() then break.
    if self.syms.scopes.kind <> vs:scProc then cycle.
    nm = upper(self.tk.GetTok(self.syms.scopes.startTok))
    if nm and pPure.findChars(' ' & clip(nm) & ' ') then pOut.append(clip(nm) & ' ').
  end
  if sv then get(self.syms.scopes, sv).
  w.setValue(pPure)
  w.split(' ')
  loop z = 1 to w.records()
    nm = upper(w.getLine(z))
    if nm and self.syms.MapProtoCount(nm) then pOut.append(clip(nm) & ' ').
  end

! ------------------------------------------------------------------------------------
! The call named pNameU, written with NO object in front of it: 1 = it is a reader on pPure, which
! neither writes nor keeps what it is handed. A pure list holds two kinds of reader (see
! PureMethod), and a name alone can mean only the first, the runtime's own functions: GetLine,
! Length or FindChar written as a plain call is a procedure of the program's own, which may write
! an argument by address or keep a reference to it. So the name must be on the list, be one of
! the runtime's functions, and not be a name this file gives a procedure of its own (pOwn, from
! PureOwnList). A name a rule file's PURE(...) adds is the caller's to take at its word.
! ------------------------------------------------------------------------------------
VitEngine.PureProc Procedure(STRING pNameU, StringTheory pPure, StringTheory pOwn)
nmU  string(vs:maxName),auto
  code
  nmU = upper(pNameU)
  if ~nmU then return 0.
  if self.syms &= NULL then return 0.
  if ~pPure.findChars(' ' & clip(nmU) & ' ') then return 0.
  if pOwn.findChars(' ' & clip(nmU) & ' ') then return 0.
  if nmU = 'CHOOSE' then return 1.
  if ~self.IsRuntimeBuiltin(nmU) then return 0.
  return 1

! ====================================================================================
! PROCEDURE SUMMARIES - one pre-pass that answers, for every PROCEDURE and
! METHOD body in THIS file, the single question "what does it RETURN?", so that the
! analysis builtins can use a fact established in one procedure while transforming
! another.
!
!     parser.StripRefSig    st.removeByte(32) ... return st.getValuePtr()   -> sm:spaceless
!     parser.MaskSigBase    st.SetValue(self.StripRefSig(pParams))          -> st is spaceless
!                           ... return clip(st.getValue())                  -> the clip is dead
!
! THE FACTS. sm:spaceless is deliberately STRONGER than "no trailing spaces": setLength
! truncates INTO the string, so only "no spaces anywhere" rules out a cut EXPOSING an
! interior space as a new trailing one.
! sm:nonNeg / sm:posBound feed KnownRanges' seed table at a call site. sm:none is the
! default and ANY doubt collapses to it.
!
! WHAT IT REFUSES, and every one of these is pinned by a case in TestData\summary.clw:
!   * a body that is NOT in this file. A MAP prototype describes a SIGNATURE, never a
!     behaviour, so there is simply no row and the answer is sm:none;
!   * a VIRTUAL method - a derived class may override it with something that does not
!     strip spaces at all - and a method whose prototype is not VISIBLE (no CLASS body
!     here and no --thorough include closure), which is the same "assume nothing" answer.
!     VitSymbols.MethodIsVirtual returns -1 / 1 for those two, and only 0 is usable;
!   * recursion, direct or mutual: no fixpoint iteration in v1. NB a v1 summary is a pure
!     BODY-SHAPE analysis - it never consults another summary - so recursion cannot
!     actually corrupt one. The refusal is implemented anyway, blunt (ANY mention of the
!     body's own name in its own code), so that the guard is already in place the day
!     summaries become compositional;
!   * a scope with GOTO / COMPILE / OMIT or no CODE (the AutoScopePrep bail), and any
!     scope owning a ROUTINE - a RETURN inside a routine returns from the PROCEDURE, and
!     routine bodies are outside acMainEnd, so we would be summarising a body we had not
!     read all of;
!   * a scope whose level-mark walk does not return to the depth it started at. An INLINE
!     '.' terminator is retyped vt:end but carries NO '-' mark, so the close test is the same one
!     idiom; an unbalanced walk makes "depth 0" a lie and depth 0 is the whole argument
!     that the spaceless point is unconditionally executed;
!   * no explicit RETURN at all, a bare RETURN, or return paths that DISAGREE;
!   * a number, when the prototype returns anything but LONG, ULONG, SIGNED or UNSIGNED:
!     RETURN converts the value, so a length returned as a SHORT can come back negative
!     (SmRetWidth; this one is pinned in TestData\ad6kr.clw).
!
! A SUMMARY IS ABOUT THE RETURN VALUE, AND NOTHING ELSE. It says nothing whatsoever about
! what the body did to a *STRING argument, and no consumer may read it as if it did: the
! only thing either consumer does with a summary is credit the RECEIVER OF AN ASSIGNMENT
! (KnownRanges) or the buffer a setValue STORED INTO (TrailingSpaces). RefStrip in the
! fixture pins that.
!
! DELIBERATE DEVIATION from the design, and it is load-bearing. The design describes
!     setLength as a TRUNCATION. Read against the
!     shipped class it is not only that: StringTheory.SetLength PADS WITH BYTE 32 when
!     NewLength is greater than _DataEnd (stMemSet(..., 32, ...) on both the buffer and the
!     non-buffer path). So a GROWING setLength puts trailing spaces INTO a spaceless buffer
!     and would invalidate the very simplification the summary exists to license. setLength
!     is therefore sk:trunc, not sk:keep: SpaceKeepUse refuses it outright, and the ONLY
!     place it is accepted is BuiltinTrailingSpaces' TsTruncGuard, which requires the
!     author's own same-line proof that it shrinks - `if E < recv._DataEnd then
!     recv.setLength(E).` with the two E spans token-for-token equal. GrowLength in the
!     fixture pins the refusal of the unguarded form.
! ------------------------------------------------------------------------------------
VitEngine.BuildSummaries Procedure()
scRow      long,auto
scKind     byte
sc         long,auto
scSelf     string(vs:maxName)     ! the method's receiver class, captured BEFORE AutoScopePrep clobbers the buffer
startT     long,auto
codeT      long,auto
mainEnd    long,auto
ownerU     string(vs:maxName)     ! '' for a plain procedure
nameU      string(vs:maxName)
nmOk       byte
fact       byte                   ! sm:* being built for this scope
vres       long,auto
lblTxt     string(vs:maxName)
lblLen     long,auto
dotP       long,auto
smRecur    byte
smBad      byte
smEnds     byte                   ! the main code ends in a valued RETURN - it cannot run off its end
smAny      byte                   ! at least one RETURN seen
depth      long
prevEol    byte
rFact      byte                   ! ONE return path's fact
rRecv      string(vs:maxName)     ! ONE return path's receiver (spaceless only)
smRecvU    string(vs:maxName)     ! the agreed receiver of every return path
reS        long
reE        long
reTmp      long,auto
smMakeP    long                   ! the recv.removeByte(32) that makes the buffer spaceless
smMakeE    long                   ! its closing ')'
mth        string(vs:maxName)
! ---- token peek (SmGet)
gPos       long,auto
gOk        byte
gCut       byte
gNull      byte
gTxt       string(vs:maxName)
gTU        string(vs:maxName)
gTy        string(1)
gLv        string(1)
! ---- name splitting (SmSplitRoot)
spIn       string(vs:maxName)
spRoot     string(vs:maxName)
spSuf      string(vs:maxName)
! ---- paren matching (SmMatchParen)
mpOpen     long
mpClose    long
! ---- depth-0 line starts
lsPos      long
lsOk       byte
indOk      byte
! ---- symbol eligibility (SmRecvOk)
okName     string(vs:maxName)
okRes      byte
okDecl     long
SmLineQ  QUEUE,PRE(sml)           ! every DEPTH-0 line start of the scope's main code, ascending
smlPos    long
         END
! ---- the parameter facts (SmParamWrites) - ruled 14 Sep 2026
prFacts    string(32)             ! 'R' at position k: parameter k is only read by the body
prEnd      long                   ! the scope's last token - routines included, they share the parameters
prOpen     long                   ! the header's parameter list - its '(' and
prClose    long                   !   the matching ')'. The rows declared between the two are the parameters, in the prototype's order
prK        long                   ! walk cursors
prJ        long
prD        long                   ! bracket depth in the walk
prImp      long                   ! open brackets that belong to a call NOT on the pure list
prStk      long,dim(isu:maxDepth)
prU        string(vs:maxName)
prM        long
prSlot     long                   ! one parameter's slot in the header - its position in a call (SmSlot)
prPure     StringTheory           ! the pure list, for the walk
prOwn      StringTheory           ! the names on it this file gives a procedure of its own (PureOwnList)
smNum      StringTheory           ! a return literal, to read its spelling (SmRetNumeric)
SmParQ   QUEUE,PRE(spq)           ! the parameters, by position
nm         string(vs:maxName)
dtok       long
ro         byte
kp         byte
         END
  code
  if self.sums &= NULL then return.
  free(self.sums)
  self.IfCasePureList(prPure)
  if self.syms &= NULL then return.
  self.syms.EnsureFresh() ! consumer gate - the token stream may have moved
  self.acScopeId = 0      ! ... which also retires the AutoScopePrep cache
  self.lmProcS = -1       ! ... and the list of names local methods use (UsedInLocalMethods)
  if self.syms.scopes &= NULL then return.
  self.PureOwnList(prPure, prOwn)
  loop scRow = 1 to records(self.syms.scopes)
    get(self.syms.scopes, scRow)
    if errorcode() then break.
    scKind = self.syms.scopes.kind
    sc     = self.syms.scopes.scopeId
    scSelf = self.syms.scopes.selfClass
    startT = self.syms.scopes.startTok
    if scKind <> vs:scProc and scKind <> vs:scMethod then cycle.
    fact = sm:none
    prFacts = ''
    do SmScopeName
    if ~nmOk then cycle.  ! we could not even name it - record nothing
    do SmParamWrites      ! which parameters the body only reads - a fact of its own, beside the return fact
    do SmClassify
    do SmRecord
  end
  self.acScopeId = 0
  free(SmLineQ)

! ---- which of the body's PARAMETERS it only READS - ruled 14 Sep 2026, so that a copy pass may accept
!      a call to this body between a copy and a read: `up.setValue(pText)` ... `self.MatchingParen(pText, x)`
!      ... `if up._DataEnd > 5 ...` folds when MatchingParen only reads pText. prFacts holds one
!      character per parameter, in header order: 'R' = read only; anything else = it may write it, or no
!      answer. The scan covers the WHOLE scope, routines included (they share the parameters), and a
!      VIRTUAL method, or one whose prototype is not visible, gets no answer - a derived class may
!      replace the body. A parameter is written by an assignment (`p =`, `p += 1`, `p &= `, `p[i] = `),
!      by a LOOP that counts it (`loop p = 1 to n`), by a store on a line only a debug build runs
!      (`? p = 0`), by a method off the pure list (`p.append(`), or by being handed whole to a call
!      off the pure list, which could write it by address - and a call with no object in front of it
!      is on the list only as one of the runtime's own readers (PureProc). A reference taken on it
!      (`x &= p`) is not a read either: it outlives the call, and whatever holds it can write the
!      object later, under another name. A parameter the DATA section names - a control's USE(), an
!      OVER(), a FILE's NAME() - is read or written where no statement shows it, and gets no answer.
!      COMPILE and OMIT do not withhold the answer: the tokenizer reads
!      every COMPILE block and every conditional OMIT in full, so a write inside one is counted, and an
!      unconditional OMIT('x') block is never built. The census needs no order, so a GOTO does not matter
!      either. At most 32 parameters.
SmParamWrites routine
  prFacts = ''
  free(SmParQ)
  if scKind = vs:scMethod
    if self.syms.MethodIsVirtual(ownerU, nameU) <> 0 then exit.
  end
  self.AutoScopePrep(sc)                                           ! for acCodeT and the GOTO/COMPILE/OMIT bail over the main code; a routine on its own is NOT a bail here
  if ~self.acCodeT then exit.
  if self.urInc then exit.
  prEnd = 0
  loop prK = 1 to records(self.syms.scopes)                        ! the scope's last token, routines and all
    get(self.syms.scopes, prK)
    if errorcode() then break.
    if self.syms.scopes.scopeId = sc then prEnd = self.syms.scopes.endTok ; break.
  end
  if ~prEnd then exit.
  ! the parameters are the rows declared inside the HEADER's parameter list, and their
  ! declaration token ascends with their position in it. The symbol queue is sorted by
  ! NAME, so its row order is not the header's - spq:dtok carries the order instead.
  prOpen = 0
  loop prK = startT + 1 to self.acCodeT
    if self.IsEolTok(prK) then break.                              ! the header line ended first: no parameter list
    get(self.tk.tokens, prK)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '(' then prOpen = prK ; break.
  end
  if ~prOpen then exit.
  prClose = self.tk.MatchLeftBracket('(', ')', prOpen)
  if prClose <= prOpen then exit.
  loop prK = 1 to records(self.syms.syms)
    get(self.syms.syms, prK)
    if errorcode() then break.
    if self.syms.syms.scopeId <> sc then cycle.
    if self.syms.syms.declTok <= prOpen or self.syms.syms.declTok > prClose then cycle.
    if records(SmParQ) >= 32 then prFacts = '' ; exit.
    clear(SmParQ)
    spq:nm   = self.syms.syms.nameU
    spq:dtok = self.syms.syms.declTok
    spq:ro   = 1
    add(SmParQ)
  end
  if ~records(SmParQ) then exit.
  sort(SmParQ, spq:nm)                                             ! for the keyed reads in the walk below
  prD = 0 ; prImp = 0
  loop prK = self.acCodeT + 1 to prEnd
    get(self.tk.tokens, prK)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '('
      prD += 1
      if prD > isu:maxDepth then prFacts = '' ; exit.
      prStk[prD] = 0
      get(self.tk.tokens, prK - 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.type = vt:label
        prU = upper(self.tk.tokens.tok)
        prM = prPure.findByte(46, 1,, prU)                         ! <dot>
        if prM then prU = prU[prM + 1 : len(clip(prU))].
        if ~prPure.findChars(' ' & clip(prU) & ' ') then prStk[prD] = 1 ; prImp += 1.
        if ~prStk[prD] and prK > 3
          if self.tk.GetTok(prK - 2) = '.' then do SmRecvSt.
        end
        if ~prStk[prD] and (prM or self.tk.GetTok(prK - 2) = '.') and ~self.PureMethod(prU, prPure) then prStk[prD] = 1 ; prImp += 1.
        if ~prStk[prD] and ~prM then do SmPlainCall.
      end
      cycle
    end
    if self.tk.tokens.tok = ')'
      if prD > 0
        if prStk[prD] then prImp -= 1.
        prD -= 1
      end
      cycle
    end
    if self.tk.tokens.type <> vt:label then cycle.
    prU = upper(self.tk.tokens.tok)
    prM = prPure.findByte(46, 1,, prU)                             ! <dot>
    if prM > 1 then prU = prU[1 : prM - 1].
    spq:nm = prU
    get(SmParQ, spq:nm)
    if errorcode() then cycle.                                     ! not a parameter
    if ~spq:ro then cycle.                                         ! already known written
    if prImp then spq:ro = 0 ; put(SmParQ) ; cycle.                ! inside the brackets of a call off the pure list
    if self.IsuIsWrite(prK) then spq:ro = 0 ; put(SmParQ) ; cycle. ! `p = ` or `p.setValue(`
    get(self.tk.tokens, prK - 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '&=' then spq:ro = 0 ; put(SmParQ) ; cycle.
    get(self.tk.tokens, prK + 1)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '&=' or instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then spq:ro = 0 ; put(SmParQ) ; cycle.
    if self.tk.tokens.tok = '['                                    ! a subscript: a write when '=' follows its ']'
      prJ = self.tk.MatchLeftBracket('[', ']', prK + 1)
      if prJ > prK
        get(self.tk.tokens, prJ + 1)
        if ~errorcode() and not self.tk.tokens.tok &= NULL
          if self.tk.tokens.tok = '=' or instring(' ' & clip(self.tk.tokens.tok) & ' ', isu:cmpdOps, 1, 1) then spq:ro = 0 ; put(SmParQ).
        end
      end
      cycle
    end
    if self.tk.tokens.tok = '.' or prM > 1                         ! an object: the method must be a reader
      if self.tk.tokens.tok = '.'
        get(self.tk.tokens, prK + 2)
        if errorcode() then break.
        if self.tk.tokens.tok &= NULL then cycle.
        prU = upper(self.tk.tokens.tok)
        if ~self.PureMethod(prU, prPure) then spq:ro = 0 ; put(SmParQ) ; cycle.
      else
        get(self.tk.tokens, prK)
        prU = upper(self.tk.tokens.tok)
        prU = prU[prM + 1 : len(clip(prU))]
      end
      if ~prPure.findChars(' ' & clip(prU) & ' ') and prU <> 'VALUEPTR' and prU <> '_DATAEND' then spq:ro = 0 ; put(SmParQ).
      if spq:ro and prM <= 1
        if self.HayType(self.tk.GetTok(prK), prK) <> 'STRINGTHEORY' then spq:ro = 0 ; put(SmParQ).
      end
    end
  end
  do SmKept
  do SmDataUse
  do SmLocalMeth
  ! each fact goes to its parameter's SLOT in the header, counted by the commas in front of it
  ! as ArgFact counts a call's. A parameter written with no type word - `pFlag`, its type left
  ! to the prototype - has no row, so numbering the rows would move every later fact one slot
  ! to the left. A slot with no row stays blank, which no consumer takes for an answer.
  sort(SmParQ, spq:dtok)
  loop prK = 1 to records(SmParQ)
    get(SmParQ, prK)
    if errorcode() then break.
    do SmSlot
    if prSlot > 32 then cycle.
    if spq:kp
      prFacts[prSlot] = '.'
    elsif spq:ro
      prFacts[prSlot] = 'R'
    else
      prFacts[prSlot] = 'W'
    end
  end

! ---- prSlot = the header slot of the parameter in the SmParQ buffer: one more than the commas
!      in front of its name at the list's own depth ----
SmSlot routine
  data
k   long,auto
d   long,auto
  code
  prSlot = 1
  d = 0
  loop k = prOpen + 1 to spq:dtok - 1
    case self.tk.GetTok(k)
    of '(' orof '['
      d += 1
    of ')' orof ']'
      d -= 1
    of ','
      if ~d then prSlot += 1.
    end
  end

! ---- a parameter named in a method of a class the procedure declares may be written there, or a
!      reference to it kept (`self.ref &= pS`): such a method shares the procedure's data, and its
!      body follows the procedure, outside the walks above. Such a parameter gets no answer ----
SmLocalMeth routine
  data
k   long,auto
  code
  if ~self.MayHaveLocalMethods(sc) then exit.
  loop k = 1 to records(SmParQ)
    get(SmParQ, k)
    if errorcode() then break.
    if spq:kp then cycle.
    if self.UsedInLocalMethods(spq:nm, startT, prEnd) then spq:kp = 1 ; put(SmParQ).
  end

! ---- which parameters the body may KEEP - a reference to it that outlives the call: `x &= p`,
!      ADDRESS(p), or p handed whole to a call off the pure list, which may keep it in turn. A kept
!      parameter is never 'R' or 'W', whatever else the census found (ruled 28 Oct 2026). The walk
!      back to the call's '(' stops at the start of the line, and a call it cannot find keeps it.
!      A method counts as one of those readers only when its receiver is a StringTheory and
!      StringTheory has a method of that name - see PureMethod - and a call with no object in front
!      of it only when it is one of the runtime's own functions - see PureProc.
!      A WAY INTO THE PARAMETER is kept as the parameter is: a member of it (`gBuf &= p.valuePtr`,
!      `Keep(p.valuePtr)`), its buffer as `p.getValuePtr()`, or a slice of it, handed whole. The
!      name in front of the first '.' is the one looked up, as the walk above looks it up.
SmKept routine
  data
k   long,auto
j   long,auto
d   long,auto
e   long,auto
tU  string(vs:maxName),auto
  code
  loop k = self.acCodeT + 1 to prEnd
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    tU = upper(self.tk.tokens.tok)
    e = prPure.findByte(46, 1,, tU)
    if e > 1 then tU = tU[1 : e - 1].
    spq:nm = tU
    get(SmParQ, spq:nm)
    if errorcode() or spq:kp then cycle.
    tU = self.tk.GetTok(k - 1)
    if tU = '&='
      spq:kp = 1 ; put(SmParQ) ; cycle
    end
    if tU <> '(' and tU <> ',' then cycle.
    e = k
    if self.tk.GetTok(k + 1) = '['
      e = self.tk.MatchLeftBracket('[', ']', k + 1)
    elsif self.tk.GetTok(k + 1) = '.' and upper(self.tk.GetTok(k + 2)) = 'GETVALUEPTR'
      if self.tk.GetTok(k + 3) = '(' then e = self.tk.MatchLeftBracket('(', ')', k + 3).
      if e > k and self.tk.GetTok(e + 1) = '[' then e = self.tk.MatchLeftBracket('[', ']', e + 1).
    end
    if e < k then cycle.
    tU = self.tk.GetTok(e + 1)
    if tU <> ',' and tU <> ')' then cycle.
    d = 0
    loop j = k - 1 to self.acCodeT + 1 by -1
      tU = self.tk.GetTok(j)
      if tU = '<10>' then j = 0 ; break.
      case tU
      of ')' orof ']'
        d += 1
      of '(' orof '['
        if ~d then break.
        d -= 1
      end
    end
    tU = choose(j < 2, '', upper(self.tk.GetTok(j - 1)))
    if ~tU or tU = 'ADDRESS' or ~prPure.findChars(' ' & clip(tU) & ' ') then spq:kp = 1 ; put(SmParQ).
    if tU and j > 2 and self.tk.GetTok(j - 2) = '.' and ~self.PureMethod(tU, prPure) then spq:kp = 1 ; put(SmParQ).
    if ~spq:kp and (j < 3 or self.tk.GetTok(j - 2) <> '.')
      if ~self.PureProc(tU, prPure, prOwn) then spq:kp = 1 ; put(SmParQ).
    end
    if spq:kp or j < 4 then cycle.
    if self.tk.GetTok(j - 2) <> '.' then cycle.
    if self.HayType(self.tk.GetTok(j - 3), j - 3) <> 'STRINGTHEORY' then spq:kp = 1 ; put(SmParQ).
  end

! ---- a METHOD on the pure list is a reader only on a StringTheory: GetLine on a class of the
!      author's own may write an argument by address, so with any other receiver the call's
!      brackets count as a call off the pure list ----
SmRecvSt routine
  if self.HayType(self.tk.GetTok(prK - 3), prK - 3) = 'STRINGTHEORY' then exit.
  prStk[prD] = 1
  prImp += 1

! ---- a call with NO object in front of it is a reader only when it is one of the runtime's own
!      functions on the list: a name this file gives a procedure of its own may write the
!      parameter by address or keep it (PureProc), so its brackets count as a call off the list ----
SmPlainCall routine
  if self.tk.GetTok(prK - 2) = '.' then exit.
  if self.PureProc(prU, prPure, prOwn) then exit.
  prStk[prD] = 1
  prImp += 1

! ---- a parameter the DATA section names is read or written where no statement shows it: ACCEPT
!      writes a control's USE() variable, an OVER() is the same storage under another name, OPEN
!      reads a FILE's NAME(). Such a parameter gets no answer. The procedure's own data lies
!      between the header's ')' and CODE, a routine's between ROUTINE and its own CODE ----
SmDataUse routine
  data
r   long,auto
k   long,auto
s   long,auto
e   long,auto
  code
  loop r = 0 to records(self.acRoutQ)
    s = prClose + 1
    e = self.acCodeT - 1
    if r
      get(self.acRoutQ, r)
      if errorcode() then break.
      s = self.acRoutQ.rStart + 1
      e = self.CodeTokOfScope(s, self.acRoutQ.rEnd) - 1
    end
    loop k = s to e
      get(self.tk.tokens, k)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
      if self.tk.tokens.firstOnLine and self.tk.BufColOne() then cycle.
      if self.tk.GetTok(k - 1) = '.' then cycle.
      spq:nm = upper(self.tk.GetTok(k))
      get(SmParQ, spq:nm)
      if errorcode() or spq:kp then cycle.
      spq:kp = 1
      put(SmParQ)
    end
  end

! ---- the owner/name this body is filed under ----
SmScopeName routine
  nmOk   = 0
  ownerU = ''
  nameU  = ''
  gPos = startT
  do SmGet
  if ~gOk or                                   |
     gNull
    exit
  end
  lblTxt = gTxt
  lblLen = len(clip(lblTxt))
  if ~lblLen then exit.
  dotP = prPure.findByte(46, 1,, lblTxt)       ! <dot>
  if scKind = vs:scMethod
    ownerU = upper(scSelf)
    if ~ownerU then exit.
    if dotP > 1 and dotP < lblLen
      nameU = upper(lblTxt[dotP + 1 : lblLen]) ! 'Class.Method' arrives as ONE column-1 token
    elsif ~dotP
      gPos = startT + 2                        ! ... or as Class . Method, three tokens
      do SmGet
      if ~gOk then exit.
      nameU = gTU
    else
      exit                                     ! a leading or trailing dot - not a name we model
    end
  else
    if dotP then exit.
    nameU = upper(lblTxt)
  end
  if ~nameU then exit.
  nmOk = 1

! ---- everything that has to hold before a body may be summarised at all ----
SmClassify routine
  if scKind = vs:scMethod
    vres = self.syms.MethodIsVirtual(ownerU, nameU)
    if vres then exit.     ! -1 = no prototype visible, 1 = VIRTUAL: assume nothing
  end
  self.AutoScopePrep(sc)   ! NB clobbers the scopes buffer - sc/scKind/scSelf/startT are captured above
  if self.acBail or        |   ! missing scope / no CODE / GOTO / COMPILE / OMIT present
     records(self.acRoutQ) ! a RETURN inside a ROUTINE returns from the PROCEDURE, and routines are outside acMainEnd
    exit
  end
  if self.urInc then exit.
  codeT   = self.acCodeT
  mainEnd = self.acMainEnd
  if mainEnd <= codeT then exit.
  do SmSelfCall
  if smRecur then exit.
  do SmDepthWalk
  if smBad then exit.
  do SmEndsInReturn
  if ~smEnds then exit.
  do SmReturns
  if fact = sm:spaceless then do SmProveSpaceless.
  if fact = sm:nonNeg or fact = sm:posBound then do SmRetWidth.

! ---- a number is only as wide as the type the procedure RETURNS: RETURN converts its value to
!      that type, so `return len(s)` from a ,SHORT procedure comes back negative past 32767, and
!      `return 256` from a ,BYTE one comes back 0. The facts stand only for a prototype that
!      returns LONG, ULONG, SIGNED or UNSIGNED - the types KnownRanges takes for a position - and
!      not for one that returns a reference ----
SmRetWidth routine
  data
rtRf  byte
  code
  case upper(self.syms.ProcReturnAt(startT, rtRf))
  of 'LONG' orof 'ULONG' orof 'SIGNED' orof 'UNSIGNED'
    if ~rtRf then exit.
  end
  fact = sm:none

! ---- file the answer; a name that turns up twice (an overload) collapses to sm:none ----
SmRecord routine
  data
zz  long,auto
  code
  loop zz = 1 to records(self.sums)
    get(self.sums, zz)
    if errorcode() then break.
    if self.sums.smOwnerU <> ownerU or |
       self.sums.smNameU  <> nameU
      cycle
    end
    if self.sums.smFact <> fact        ! two bodies, one name: a keyed read would land on
      self.sums.smFact = sm:none       !   an arbitrary one of them, so neither is usable
    end
    if self.sums.smParamRO <> prFacts then self.sums.smParamRO = ''.
    put(self.sums)
    exit
  end
  clear(self.sums)
  self.sums.smOwnerU  = ownerU
  self.sums.smNameU   = nameU
  self.sums.smFact    = fact
  self.sums.smParamRO = prFacts
  add(self.sums)

! ---- does this body mention its OWN name?  Deliberately blunt - see the header ----
SmSelfCall routine
  data
zz  long,auto
  code
  smRecur = 0
  loop zz = codeT + 1 to mainEnd
    gPos = zz
    do SmGet
    if ~gOk or         |
       gTy <> vt:label
      cycle
    end
    if gTU = nameU then smRecur = 1 ; break.
  end

! ---- every DEPTH-0 line start of the main code, plus the balance check ----
SmDepthWalk routine
  data
lz  long,auto
  code
  free(SmLineQ)
  depth   = 0
  prevEol = 0
  smBad   = 0
  loop lz = codeT + 1 to mainEnd
    if self.IsEolTok(lz)
      prevEol = 1
      cycle
    end
    gPos = lz
    do SmGet
    if ~gOk then smBad = 1 ; break.
    if gNull then cycle.
    if prevEol and ~depth
      do SmIndentOk                        ! gPos is already lz
      if indOk
        clear(SmLineQ)
        sml:smlPos = lz
        add(SmLineQ)
      end
    end
    prevEol = 0
    if gLv = '+'
      depth += 1
    elsif gLv = '-' or (gTy = vt:end and gLv <> '+' and gLv <> '/')
      depth -= 1                           ! the inline-dot idiom: an INLINE '.' is retyped vt:end but may carry NO '-'
      if depth < 0 then smBad = 1 ; break.
    end
  end
  if ~smBad and depth then smBad = 1.      ! the belt: an unbalanced walk makes "depth 0" a lie

! ---- the main code must END in a valued RETURN at depth 0, or control can run off its end.
!      The compiler accepts a body whose only valued RETURN is conditional - no error, no warning
!      (tested 8 Sep) - and the caller then receives whatever the return register holds: measured
!      as the LENGTH of a blank string argument, which looks like a perfectly good "1 or more".
!      A body whose last depth-0 statement is `return <value>` cannot get there; anything else
!      (an IF holding the RETURNs, a bare RETURN, a `.` after it) earns no fact. ----
SmEndsInReturn routine
  smEnds = 0
  if ~records(SmLineQ) then exit.
  get(SmLineQ, records(SmLineQ))
  if errorcode() then exit.
  gPos = sml:smlPos
  do SmGet
  if ~gOk or gTy <> vt:reservedWord or gTU <> 'RETURN' then exit.
  if self.IsEolTok(sml:smlPos + 1) then exit.      ! a bare RETURN
  gPos = sml:smlPos + 1
  do SmGet
  if ~gOk or gTy = vt:end or gTxt = ';' then exit. ! `return.` or `return ;` - no value
  smEnds = 1

! ---- every RETURN in the main code must agree, or there is no fact ----
SmReturns routine
  data
rz  long,auto
  code
  fact    = sm:none
  smAny   = 0
  smRecvU = ''
  rz = codeT
  loop
    rz += 1
    if rz > mainEnd then break.
    gPos = rz
    do SmGet
    if ~gOk                   or            |
       gTy <> vt:reservedWord or            |
       gTU <> 'RETURN'
      cycle
    end
    reS   = rz + 1
    reTmp = self.FirstEolAfter(rz)
    if reTmp > rz and reTmp - 1 <= mainEnd
      reE = reTmp - 1                       ! a '|' continuation emits NO EOL token, so this is the LOGICAL line
    else
      reE = mainEnd
    end
    loop while reE >= reS                   ! trim the terminator of `if C then return X.`
      gPos = reE
      do SmGet
      if ~gOk then break.
      if gTy = vt:end or gTxt = ';'
        reE -= 1
      else
        break
      end
    end
    if reE < reS
      fact  = sm:none                       ! a bare RETURN returns no value
      smAny = 1
      break
    end
    do SmRetFact
    if ~smAny
      fact    = rFact
      smRecvU = rRecv
      smAny   = 1
    elsif rFact <> fact or rRecv <> smRecvU
      fact = sm:none                        ! the return paths disagree
      break
    end
    if fact = sm:none then break.
    rz = reE
  end
  if ~smAny then fact = sm:none.            ! no explicit RETURN at all

! ---- ONE return expression -> rFact / rRecv ----
SmRetFact routine
  rFact = sm:none
  rRecv = ''
  do SmRetSpaceless
  if rFact <> sm:none then exit.
  do SmRetNumeric

! ---- (a) `return recv.getValue()` / `.getValuePtr()` - the WHOLE buffer, so its own fact.
!      Both return value[1 : _DataEnd] (checked against StringTheory), never the
!      physical slack behind it, so "the buffer is spaceless" IS "the result is spaceless". ----
SmRetSpaceless routine
  if reE <> reS + 4 then exit.
  gPos = reS
  do SmGet
  if ~gOk or                                    |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do SmSplitRoot
  if spSuf then exit.                           ! self.st.getValue() - not a simple local receiver
  okName = spRoot
  gPos = reS + 1
  do SmGet
  if ~gOk or                                    |
     gTxt <> '.'
    exit
  end
  gPos = reS + 2
  do SmGet
  if ~gOk or                                    |
     gTU <> 'GETVALUE' and gTU <> 'GETVALUEPTR'
    exit
  end
  gPos = reS + 3
  do SmGet
  if ~gOk or                                    |
     gTxt <> '('
    exit
  end
  gPos = reS + 4
  do SmGet
  if ~gOk or                                    |
     gTxt <> ')'                                ! getValue(start,len) is a slice, not the whole value
    exit
  end
  do SmRecvOk
  if ~okRes then exit.
  rFact = sm:spaceless
  rRecv = okName

! ---- (b) a literal, (c) a StringTheory counting read, (d) a bare Clarion reader ----
SmRetNumeric routine
  if reE = reS
    gPos = reS
    do SmGet
    if ~gOk or                                                                        |
       gTy <> vt:Integer                                                              ! a NEGATIVE literal is '-' then the digits - two tokens, no fact
      exit
    end
    ! a value is read only from plain digits: a hex, binary or octal spelling earns no fact -
    ! `return 0FFFFFFFFh` returns -1 from a LONG procedure
    smNum.setValue(gTxt,st:clip)
    if ~smNum.IsAllDigits() then exit.
    ! a NUMERIC compare: `return 00` is zero too. (Not val(): in Clarion that is the character code.)
    if gTxt = 0
      rFact = sm:nonNeg
    else
      rFact = sm:posBound
    end
    exit
  end
  if reE >= reS + 4
    gPos = reS + 1
    do SmGet
    if gOk and gTxt = '.'
      gPos = reS
      do SmGet
      if ~gOk or                                                                      |
         gTy <> vt:label
        exit
      end
      spIn = gTU
      do SmSplitRoot
      if spSuf then exit.
      okName = spRoot
      do SmRecvOk
      if ~okRes then exit.                                                            ! only a StringTheory of THIS scope; another class's len() is its own business
      gPos = reS + 2
      do SmGet
      if ~gOk then exit.
      mth = gTU
      gPos = reS + 3
      do SmGet
      if ~gOk or                                                                      |
         gTxt <> '('
        exit
      end
      mpOpen = reS + 3
      do SmMatchParen
      if mpClose <> reE then exit.
      case mth
      of   'LEN'      orof 'LENGTH'    orof 'LENGTHA'  orof 'CLIPLENGTH' orof 'LINES' |
      orof 'FINDCHAR' orof 'FINDCHARS' orof 'FINDBYTE' orof 'INSTRING'
        rFact = sm:nonNeg                                                             ! a length or a position: 0 = none, never negative
      end
      exit
    end
  end
  if reE < reS + 2 then exit.
  gPos = reS
  do SmGet
  if ~gOk then exit.
  mth = gTU
  if self.IsUserProc(mth) then exit.                                                  ! the user's own `Len` is not Clarion's
  gPos = reS + 1
  do SmGet
  if ~gOk or                                                                          |
     gTxt <> '('
    exit
  end
  mpOpen = reS + 1
  do SmMatchParen
  if mpClose <> reE then exit.
  case mth
  of 'LEN' orof 'RECORDS' orof 'SIZE' orof 'INSTRING'
    rFact = sm:nonNeg
  end

! ---- the sm:spaceless CANDIDATE has to be PROVED: find the removeByte(32) that makes the
!      buffer spaceless and confirm nothing between it and the RETURN can undo it. A method of a
!      class the procedure declares shares its data, so a call to one in between may re-pad the
!      buffer unseen: a receiver such a method names is not proved. The scope is read again first,
!      since AutoScopePrep has moved the scopes buffer ----
SmProveSpaceless routine
  data
zz  long,auto
  code
  if self.MayHaveLocalMethods(sc)
    self.syms.scopes.scopeId = sc
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if errorcode() then fact = sm:none ; exit.
    if self.UsedInLocalMethods(smRecvU, self.syms.scopes.startTok, self.syms.scopes.endTok) then fact = sm:none ; exit.
  end
  smMakeP = 0
  smMakeE = 0
  loop zz = codeT + 1 to mainEnd
    gPos = zz
    do SmGet
    if ~gOk or                                 |
       gTy <> vt:label
      cycle
    end
    spIn = gTU
    do SmSplitRoot
    if spSuf then cycle.
    if spRoot <> smRecvU then cycle.
    if ~self.SpaceMakeUse(zz) then cycle.
    lsPos = zz
    do SmIsLineStart
    if ~lsOk then cycle.                       ! it must be UNCONDITIONAL: a depth-0 line of its own
    mpOpen = zz + 3
    do SmMatchParen
    if ~mpClose then cycle.
    if ~self.IsEolTok(mpClose + 1) then cycle. ! ... and nothing else may share that line
    smMakeP = zz                               ! keep looking: the LAST one wins
    smMakeE = mpClose
  end
  if ~smMakeP
    fact = sm:none                             ! nothing in this body ever removes the spaces
    exit
  end
  loop zz = codeT + 1 to mainEnd
    gPos = zz
    do SmGet
    if ~gOk then cycle.
    if gTy = vt:reservedWord and gTU = 'RETURN' and zz < smMakeP
      fact = sm:none                           ! a return path that never reaches the removeByte
      exit
    end
    if gTy = vt:reservedWord and gTU = 'DO' and zz > smMakeE
      fact = sm:none                           ! a routine can do anything to any buffer
      exit
    end
    if gTy <> vt:label then cycle.
    spIn = gTU
    do SmSplitRoot
    if spRoot <> smRecvU then cycle.
    if zz <= smMakeE
      if spSuf                                 ! a merged property token ABOVE the removeByte: only the length
        if spSuf <> '_DATAEND'                 !   is harmless - valuePtr hands out a writable &STRING, and a
          fact = sm:none                       !   reference taken here can be written through LATER, below the
          exit                                 !   point where we start claiming the buffer is spaceless
        end
        cycle
      end
      gPos = zz + 1
      do SmGet
      if ~gOk or gTxt <> '.'
        fact = sm:none                         ! a BARE mention anywhere - foo(st), st &= other - may alias
        exit                                   !   the buffer to something that mutates it without naming it
      end
      cycle
    end
    if ~self.SpaceKeepUse(zz)
      fact = sm:none                           ! something below the removeByte can put a space back
      exit
    end
  end

! ---- is okName a simple LOCAL StringTheory of scope sc?  (KrRecvOk's test) ----
SmRecvOk routine
  data
rz  long,auto
  code
  okRes = 0
  if ~okName then exit.
  rz = self.syms.FindSym(okName, sc)             ! module-level receivers are out: a call this walk cannot see
  if ~rz then exit.                              !   could move their contents without naming them here
  get(self.syms.syms, rz)
  if errorcode() then exit.
  if self.syms.syms.isRef then exit.             ! `st &= other` re-points a reference and carries no call
  if self.syms.syms.isLike then exit.
  if self.syms.syms.isField then exit.
  if self.syms.syms.typeU <> 'STRINGTHEORY' then exit.
  okDecl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(okDecl) then exit. ! a PARAMETER is not a column-1 declaration
  if band(self.DeclAttrBits(okDecl), ab:over + ab:dim) then exit.
  okRes = 1

! ---- is lsPos one of this scope's depth-0 line starts? ----
SmIsLineStart routine
  data
sz  long,auto
  code
  lsOk = 0
  loop sz = 1 to records(SmLineQ)
    get(SmLineQ, sz)
    if errorcode() then break.
    if sml:smlPos = lsPos then lsOk = 1 ; break.
    if sml:smlPos > lsPos then break.
  end

! ---- the token at gPos starts its line with pure indent (column 1 is a LABEL position) ----
SmIndentOk routine
  data
iz  long,auto
ic  string(1),auto
  code
  indOk = 0
  get(self.tk.tokens, gPos)
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL then exit.
  if ~size(self.tk.tokens.strBefore) then exit.
  loop iz = 1 to size(self.tk.tokens.strBefore)
    ic = self.tk.tokens.strBefore[iz]
    case val(ic)
    of 32 orof 9
      ! plain indent
    else
      exit ! a comment, a bar, or the CRLF of a continuation
    end
  end
  indOk = 1

! ---- matching ')' for the '(' at mpOpen (0 = none) ----
SmMatchParen routine
  data
mz  long,auto
md  long,auto
  code
  mpClose = 0
  md      = 0
  loop mz = mpOpen to mainEnd
    gPos = mz
    do SmGet
    if ~gOk then exit.
    if gTy = vt:literal then cycle. ! a bracket INSIDE a quoted literal is text, not structure
    case gTxt
    of '('
      md += 1
    of ')'
      md -= 1
      if ~md then mpClose = mz ; exit.
      if md < 0 then exit.
    end
  end

! ---- split spIn at its FIRST '.' -> spRoot / spSuf (a bare name gives spSuf = '') ----
SmSplitRoot routine
  data
dz  long,auto
nz  long,auto
  code
  spRoot = spIn
  spSuf  = ''
  nz = len(clip(spIn))
  if ~nz then spRoot = '' ; exit.
  dz = prPure.findByte(46, 1,, spIn) ! <dot>
  if dz > 1 and dz < nz
    spRoot = spIn[1 : dz - 1]
    spSuf  = spIn[dz + 1 : nz]
  elsif dz
    spRoot = ''                      ! a leading or trailing dot - not a name we model
  end

! ---- one token into gTxt / gTU / gTy / gLv / gNull ----
SmGet routine
  gOk   = 0
  gCut  = 0
  gNull = 0
  gTxt  = ''
  gTU   = ''
  gTy   = ' '
  gLv   = ' '
  if gPos < 1 then exit.
  get(self.tk.tokens, gPos)
  if errorcode() then exit.
  gTy = self.tk.tokens.type
  gLv = self.tk.tokens.level
  if not self.tk.tokens.tok &= NULL
    gCut = choose(size(self.tk.tokens.tok) > size(gTxt)) ! the token does NOT FIT gTxt, a fixed STRING: it arrives CUT to its first 255 characters. A cut NAME or
    if gCut and gTy <> vt:literal then exit.             !   NUMBER is refused as before (gOk stays 0, 'cannot see it'). A cut LITERAL is let through, because every
    gTxt = self.tk.tokens.tok                            !   keyword / operator compare is right on the cut copy, and the walk no longer goes blind on a whole body
    gTU  = upper(self.tk.tokens.tok)                     !   for one long message. The readers of a literal's TEXT (TsLitOk, TsLitSpaceless, the instring seed)
                                                         !   ask gCut first and refuse, so a cut copy is never scanned and never copied into emitted source
  else
    gNull = 1
  end
  gOk = 1

! ------------------------------------------------------------------------------------
! the sm:* fact for ONE body. Linear - the table holds one row per proc/method in
! the file, and a name that appeared twice was already collapsed to sm:none by SmRecord.
! No parent-class walk: a summary is filed under the class whose body we READ, and an
! inherited body is deliberately not credited to the derived class (under-reach).
! ------------------------------------------------------------------------------------
VitEngine.SummaryOf Procedure(STRING pOwnerU, STRING pNameU)
z    long,auto
oU   string(vs:maxName),auto
nU   string(vs:maxName),auto
  code
  if self.sums &= NULL then return sm:none.
  oU = upper(pOwnerU)
  nU = upper(pNameU)
  if ~nU then return sm:none.
  loop z = 1 to records(self.sums)
    get(self.sums, z)
    if errorcode() then break.
    if self.sums.smOwnerU <> oU or |
       self.sums.smNameU  <> nU
      cycle
    end
    return self.sums.smFact
  end
  return sm:none                   ! no row = another file, or a body we refused

! ------------------------------------------------------------------------------------
! Is the bare argument at pArgTok handed to a body that only READS it? Ruled 14 Sep 2026:
! the copy and line passes refuse a source or a buffer "handed whole to a call, which could
! change it"; when the callee is a PROCEDURE of this file, or a SELF method whose prototype
! is visible and not VIRTUAL, and its summary marks that parameter position 'R', the call
! reads it and is no obstacle. The call is found by walking back from the argument to the
! '(' that is open at depth 0 and the name before it; the position is one more than the
! depth-0 commas between them. Anything else - another receiver, an overload, a name the
! summaries do not hold, a parameter past the 32 recorded - answers 0, the safe side.
! ------------------------------------------------------------------------------------
VitEngine.ArgReadsOnly Procedure(LONG pArgTok, STRING pSelfClassU)
  code
  return choose(self.ArgFact(pArgTok, pSelfClassU) = 'R')

! ------------------------------------------------------------------------------------
! What the call around the bare argument at pArgTok does with it, by the summary of the body it
! reaches - the walk and the refusals are the ones ArgReadsOnly has always made: 'R' the body only
! reads that parameter, 'W' it may write it but keeps no reference to it, '.' it may keep one (or
! no answer), 'P' a plain call to one of the runtime's readers on the pure list, which neither
! writes nor keeps it (PureProc), and '' when there is no call, no summary, or the call is one the
! summaries cannot key (ruled 28 Oct 2026). The walk back counts the slot at bracket depth 0, and
! the braces of a property count as brackets: in `Fill(?List{PROPLIST:Width, 1}, st)` the comma
! inside the braces is not the call's, so st is in slot 2. A name inside the braces is the
! property's index, not an argument.
! A StringTheory's own setValue or append, given the object whole as its first argument, keeps nothing
! when its receiver is one StCopyRecv vouches for (ruled 30 Oct 2026). append copies the value alone and
! answers 'R'. setValue copies the encoding, base64 and gzip flags, byte order and code page as well, and
! answers 'F': no obstacle where the question is a reference kept to the object, but not a plain read to
! a builtin that puts another object in this one's place - after the change it would copy that one's.
! ------------------------------------------------------------------------------------
VitEngine.ArgFact Procedure(LONG pArgTok, STRING pSelfClassU)
z       long,auto
d       long,auto
opn     long,auto
pos     long,auto
nmU     string(vs:maxName),auto
oU      string(vs:maxName),auto
ro      string(32)
pure    StringTheory
own     StringTheory
  code
  if self.sums &= NULL then return ''.
  if pArgTok < 3 then return ''.
  d = 0 ; pos = 1 ; opn = 0
  loop z = pArgTok - 1 to 1 by -1                            ! back to the call's '('
    get(self.tk.tokens, z)
    if errorcode() then return ''.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = vt:literal then cycle.
    if self.tk.tokens.tok[1] = '<10>' then return ''.        ! the line began: no call around it
    if self.tk.tokens.tok = '}' then d += 1 ; cycle.
    if self.tk.tokens.tok = '{{' and ~d then return ''.      ! a property's index, not an argument
    if self.tk.tokens.tok = '{{' then d -= 1 ; cycle.
    if self.tk.tokens.tok = ')' or self.tk.tokens.tok = ']'
      d += 1
    elsif self.tk.tokens.tok = '(' or self.tk.tokens.tok = '['
      if d
        d -= 1
      elsif self.tk.tokens.tok = '('
        opn = z ; break
      else
        return ''                                            ! inside a subscript, not a call
      end
    elsif self.tk.tokens.tok = ',' and ~d
      pos += 1
    end
  end
  if ~opn or pos > 32 then return ''.
  get(self.tk.tokens, opn - 1)                               ! the callee
  if errorcode() then return ''.
  if self.tk.tokens.tok &= NULL then return ''.
  if self.tk.tokens.type <> vt:label then return ''.
  nmU = upper(self.tk.tokens.tok)
  if pure.findByte(46,,, nmU) then return ''.                ! a merged dotted name is never a call  ! <dot>
  oU = ''
  if opn >= 3
    get(self.tk.tokens, opn - 2)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '.'
      get(self.tk.tokens, opn - 3)
      if errorcode() then return ''.
      if self.tk.tokens.tok &= NULL then return ''.
      if upper(self.tk.tokens.tok) <> 'SELF'                 ! only SELF names a class the summaries key on,
        if pos = 1 and (nmU = 'SETVALUE' or nmU = 'APPEND') and self.StCopyRecv(opn - 3, pArgTok) then return choose(nmU = 'APPEND', 'R', 'F').
        return ''                                            !   but a StringTheory's own copy is known
      end
      oU = upper(pSelfClassU)
      if ~oU then return ''.
      if self.syms.MethodIsVirtual(oU, nmU) <> 0 then return ''.
      if self.syms.MethodProtoCount(oU, nmU) > 1 then return ''.
    end
  end
  if ~oU
    if self.syms.MapProtoCount(nmU) > 1 then return ''.      ! an overload: the call may bind a body that is not here
  end
  ro = ''
  loop z = 1 to records(self.sums)
    get(self.sums, z)
    if errorcode() then break.
    if self.sums.smOwnerU <> oU or self.sums.smNameU <> nmU then cycle.
    ro = self.sums.smParamRO
    break
  end
  if ~ro
    if ~oU and nmU <> 'ADDRESS'
      self.IfCasePureList(pure)
      if pure.findChars(' ' & clip(nmU) & ' ')
        self.PureOwnList(pure, own)
        if self.PureProc(nmU, pure, own) then return 'P'.
      end
    end
    return ''
  end
  return ro[pos]

! ------------------------------------------------------------------------------------
! Does the setValue or append called on the receiver at pRecvTok only copy the object at pArgTok? In
! StringTheory 3.90, SetValue and Append given a StringTheory copy its value - SetValue its encoding,
! base64 and gzip flags, byte order and code page too - and keep nothing (ArgFact says which). That is exact only when the receiver is a StringTheory
! and nothing more, and is not the argument: a plain local of the procedure, method or routine around
! it, declared StringTheory - not a reference or a parameter, either of which may hold a class derived
! from it whose method does more, and not STATIC or THREAD, which a call of the procedure from inside
! itself may have passed in as the argument - and a name other than the argument's, which the call
! would write. 1 = it only copies.
! ------------------------------------------------------------------------------------
VitEngine.StCopyRecv Procedure(LONG pRecvTok, LONG pArgTok)
row  long
rU   string(vs:maxName),auto
aU   string(vs:maxName),auto
  code
  if self.syms &= NULL then return 0.
  if self.tk.GetTok(pRecvTok - 1) = '.' then return 0.
  rU = upper(self.tk.GetTok(pRecvTok))
  aU = upper(self.tk.GetTok(pArgTok))
  if ~rU or ~aU or rU = aU then return 0.
  if instring('.', rU, 1, 1) or instring('.', aU, 1, 1) then return 0.
  if self.syms.Visible(rU, pRecvTok, row) <> vs:visSym then return 0.
  get(self.syms.syms, row)
  if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' or self.syms.syms.isRef or self.syms.syms.isLike then return 0.
  if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then return 0.
  if band(self.DeclAttrBits(self.syms.syms.declTok), ab:static + ab:thread) then return 0.
  get(self.syms.scopes, self.syms.syms.scopeId)
  if errorcode() then return 0.
  return choose(self.syms.scopes.kind = vs:scProc or self.syms.scopes.kind = vs:scMethod or self.syms.scopes.kind = vs:scRoutine)

! ------------------------------------------------------------------------------------
! the sm:* fact of the call occupying EXACTLY [pFirst..pLast] - nothing before it,
! nothing after it, so the value the caller sees IS the value the body returned.
! Two shapes only:
!     self.Method(...)   keyed on pSelfClassU, and only when the prototype is visible AND
!                        not VIRTUAL (MethodIsVirtual must answer exactly 0);
!     MyProc(...)        keyed on '' - a plain procedure DEFINED in this file.
! A call on any other receiver (other.Method(), self.member.Method()) is sm:none: knowing
! which body would run means knowing the receiver's class, which this is not the place for.
! pNameOut carries the callee's SOURCE-case name back, for the log line that has to name
! the evidence.
! ------------------------------------------------------------------------------------
VitEngine.SummaryOfCallAt Procedure(LONG pFirst, LONG pLast, STRING pSelfClassU, *STRING pNameOut)
mOpen   long
mClose  long
nmTxt   string(vs:maxName),auto
nmU     string(vs:maxName),auto
oU      string(vs:maxName),auto
tTxt    string(vs:maxName),auto
  code
  pNameOut = ''
  if pLast <= pFirst then return sm:none.
  get(self.tk.tokens, pFirst)
  if errorcode() then return sm:none.
  if self.tk.tokens.tok &= NULL then return sm:none.
  if self.tk.tokens.type <> vt:label then return sm:none.
  nmTxt = self.tk.tokens.tok
  if instring('.', nmTxt, 1, 1) then return sm:none.                  ! a MERGED dotted name is never a call - the tokenizer splits before a '('
  get(self.tk.tokens, pFirst + 1)
  if errorcode() then return sm:none.
  if self.tk.tokens.tok &= NULL then return sm:none.
  tTxt = self.tk.tokens.tok
  if tTxt = '('                                                       ! ---- MyProc(...)
    mOpen = pFirst + 1
    do MatchParen
    if mClose <> pLast then return sm:none.
    pNameOut = nmTxt
    ! two prototypes of one name are an OVERLOAD: the call binds by signature, and the other body
    ! may be in another file, so the summary of the body here says nothing about this call
    if self.syms.MapProtoCount(upper(nmTxt)) > 1 then return sm:none.
    return self.SummaryOf('', upper(nmTxt))
  end
  if tTxt <> '.' or                                                   |
     upper(nmTxt) <> 'SELF'                                           ! only SELF names a class we can key on
    return sm:none
  end
  oU = upper(pSelfClassU)
  if ~oU or                                                           |
     pLast < pFirst + 4
    return sm:none
  end
  get(self.tk.tokens, pFirst + 2)
  if errorcode() then return sm:none.
  if self.tk.tokens.tok &= NULL then return sm:none.
  if self.tk.tokens.type <> vt:label then return sm:none.
  nmTxt = self.tk.tokens.tok
  nmU   = upper(nmTxt)
  get(self.tk.tokens, pFirst + 3)
  if errorcode() then return sm:none.
  if self.tk.tokens.tok &= NULL then return sm:none.
  if self.tk.tokens.tok <> '(' then return sm:none.
  mOpen = pFirst + 3
  do MatchParen
  if mClose <> pLast then return sm:none.
  if self.syms.MethodIsVirtual(oU, nmU) <> 0 then return sm:none.     ! -1 = no prototype visible, 1 = VIRTUAL
  if self.syms.MethodProtoCount(oU, nmU) > 1 then return sm:none.     ! an overload - the call may bind a body that is not here
  pNameOut = nmTxt
  return self.SummaryOf(oU, nmU)

MatchParen routine
  data
d   long,auto
z   long,auto
tx  string(vs:maxName),auto
  code
  mClose = 0
  d      = 0
  loop z = mOpen to pLast
    get(self.tk.tokens, z)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or    |
       self.tk.tokens.type = vt:literal
      cycle
    end
    tx = self.tk.tokens.tok
    case tx
    of '('
      d += 1
    of ')'
      d -= 1
      if ~d then mClose = z ; break.
      if d < 0 then break.
    end
  end

! ------------------------------------------------------------------------------------
! what a StringTheory method name COULD do to the SPACES in its buffer, on its
! NAME alone - the one place this whitelist lives. The caller still has to validate the
! ARGUMENTS: removeByte(38) keeps a spaceless buffer spaceless but only removeByte(32)
! MAKES one, and replace(a, b) keeps it only while b cannot contain a space.
! This is NOT the ts:* ladder. That one asks about TRAILING spaces and about blindness,
! for a pass that INSERTS a clip; this one asks the single question "can this use put a
! space INTO the buffer", which is what a summary has to survive.
! Anything absent is sk:bad, which is the safe direction.
! ------------------------------------------------------------------------------------
VitEngine.SmMethodKind Procedure(STRING pMethodU)
  code
  ! getValuePtr is NOT a read: it hands out a writable reference into the buffer, exactly as the
  ! valuePtr property does, and a callee can write a blank through it. It falls to sk:bad below.
  case upper(pMethodU)
  of   'GETVALUE' orof 'CLIPLENGTH' orof 'LEN' orof 'LENGTH' orof 'LENGTHA'                   |
     orof 'FINDCHAR' orof 'FINDCHARS' orof 'FINDBYTE' orof 'CONTAINSCHAR' orof 'CONTAINSBYTE' |
     orof 'SUB' orof 'SLICE' orof 'GETLINE' orof 'LINES' orof 'INSTRING' orof 'BETWEEN'       |
     orof 'EQUALS' orof 'COMPARE' orof 'STARTSWITH' orof 'ENDSWITH'
    return sk:read                                                                      ! reads self.value and writes nothing
  of   'CLIP' orof 'TRIM'
    return sk:keep                                                                      ! only ever REMOVES from the ends
  of   'REMOVEBYTE'
    return sk:strip
  of   'REMOVEFROMPOSITION'                                                             ! deletes a span and nothing else, so a
    return sk:keep                                                                      !   spaceless buffer stays spaceless. WITHOUT this it is sk:bad and TrailingSpaces refuses everything below it.
  of   'SETVALUE'
    return sk:store
  of   'REPLACE'
    return sk:repl
  of   'SETLENGTH'
    return sk:trunc                                                                     ! GROWS by padding with byte 32 - see the DEVIATION on BuildSummaries
  end
  return sk:bad

! ------------------------------------------------------------------------------------
! can the use of a StringTheory receiver whose ROOT token is at pTok put a SPACE
! into the buffer?  1 = provably not.  Every bail returns 0, which is the safe direction.
! sk:store returns 0 here on purpose: a setValue is only ever a keeper when its argument
! is itself a spaceless call, and reading a summary to answer a question ASKED BY the
! summary pass is a compositional step this pass does not take.
! ------------------------------------------------------------------------------------
VitEngine.SpaceKeepUse Procedure(LONG pTok)
tTxt   string(vs:maxName)
sb     StringTheory ! the replacement literal, read whole - a fixed work string cut one at 255 and missed a blank beyond it
tU     string(vs:maxName)
mthU   string(vs:maxName),auto
knd    byte
mOpen  long
mClose long
lastC  long
argS   long
d      long
z      long,auto
dp     long,auto
nz     long,auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  tTxt = self.tk.tokens.tok
  tU   = upper(tTxt)
  nz   = len(clip(tU))
  dp   = sb.findByte(46, 1,, tU)                            ! <dot>
  if dp > 1 and dp < nz                                     ! ---- a MERGED property token: recv._DataEnd, recv.valuePtr, ...
    if tU[dp + 1 : nz] <> '_DATAEND' then return 0.         ! ONLY the length. recv.valuePtr hands out a &STRING that can be
    get(self.tk.tokens, pTok + 1)                           !   written through, and any other property is one we have not read
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then return 0.
    tTxt = self.tk.tokens.tok
    if tTxt = '=' then return 0.                            ! recv._DataEnd = n WRITES, and growing it exposes the slack behind
    if len(clip(tTxt)) = 2 and tTxt[2] = '='
      case val(tTxt[1])
      of 43 orof 45 orof 42 orof 47 orof 37 orof 94 orof 38 ! '+' orof '-' orof '*' orof '/' orof '%' orof '^' orof '&'
        return 0                                            ! a compound assignment writes it too
      end
    end
    if pTok > 1                                             ! ... and it must not be an ARGUMENT: a *LONG parameter is a write ... nor bound to a reference: `n &= recv._DataEnd` makes every later write to n a write here
      get(self.tk.tokens, pTok - 1)
      if ~errorcode()
        if not self.tk.tokens.tok &= NULL
          tTxt = self.tk.tokens.tok
          case tTxt
          of '(' orof ',' orof '&='
            return 0
          end
        end
      end
    end
    return 1
  end
  if dp then return 0.                                      ! a leading or trailing dot - not a name we model
  get(self.tk.tokens, pTok + 1)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  tTxt = self.tk.tokens.tok
  if tTxt <> '.' then return 0.                             ! a BARE mention - foo(st), st &= other - may alias the buffer
  get(self.tk.tokens, pTok + 2)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type <> vt:label then return 0.
  mthU = upper(self.tk.tokens.tok)
  get(self.tk.tokens, pTok + 3)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  tTxt = self.tk.tokens.tok
  if tTxt <> '(' then return 0.                             ! the tokenizer only leaves recv . name unmerged before a '('
  mOpen = pTok + 3
  do SkMatch
  if ~mClose then return 0.
  knd = self.SmMethodKind(mthU)
  case knd
  of sk:read orof sk:keep orof sk:strip
    return 1                                                ! reads, and the two removal families: a space can only leave
  of sk:repl
    do SkReplOk
    return knd                                              ! SkReplOk overwrites knd with 1 or 0
  end
  return 0

! ---- replace(old, new): the REPLACEMENT decides. Exactly two arguments, the last one a
!      single quoted literal with no space, no tab and no '<' escape in it. Read into a StringTheory:
!      a fixed work string cut a long literal at 255 characters and never saw a blank beyond. ----
SkReplOk routine
  knd   = 0
  lastC = 0
  d     = 0
  loop z = mOpen + 1 to mClose - 1
    get(self.tk.tokens, z)
    if errorcode() then exit.
    if self.tk.tokens.tok &= NULL or              |
       self.tk.tokens.type = vt:literal
      cycle
    end
    tTxt = self.tk.tokens.tok
    if tTxt = '('
      d += 1
    elsif tTxt = ')'
      d -= 1
    elsif ~d and tTxt = ','
      if lastC then exit.                         ! three or more arguments - not the form we model
      lastC = z
    end
  end
  if ~lastC then exit.
  argS = lastC + 1
  if argS <> mClose - 1 then exit.                ! the replacement must be ONE token
  get(self.tk.tokens, argS)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.type <> vt:literal then exit. ! a computed replacement - we cannot see what is in it
  sb.setValue(self.tk.tokens.tok)                 ! the whole literal, quotes and all, into a StringTheory: no length cap
  if sb._DataEnd < 2 then exit.
  if sb.containsA(' <9>') then exit.              ! the replacement IS whitespace
  if sb.containsByte(60) then exit.               ! a '<' escape - it may BE a space under another name
  knd = 1

! ---- matching ')' for the '(' at mOpen ----
SkMatch routine
  data
sz  long,auto
sd  long,auto
sx  string(vs:maxName),auto
  code
  mClose = 0
  sd     = 0
  loop sz = mOpen to records(self.tk.tokens)
    get(self.tk.tokens, sz)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or    |
       self.tk.tokens.type = vt:literal
      cycle
    end
    sx = self.tk.tokens.tok
    case sx
    of '('
      sd += 1
    of ')'
      sd -= 1
      if ~sd then mClose = sz ; break.
      if sd < 0 then break.
    end
  end

! ------------------------------------------------------------------------------------
! is the use whose root token is at pTok exactly `recv.removeByte(32)`?  That is
! the ONE operation accepted as MAKING a buffer spaceless - it removes every
! occurrence of the byte from the whole value (StringTheory.RemoveByte, checked).
! ------------------------------------------------------------------------------------
VitEngine.SpaceMakeUse Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if instring('.', upper(self.tk.tokens.tok), 1, 1) then return 0.
  get(self.tk.tokens, pTok + 1)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '.' then return 0.
  get(self.tk.tokens, pTok + 2)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if upper(self.tk.tokens.tok) <> 'REMOVEBYTE' then return 0.
  get(self.tk.tokens, pTok + 3)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '(' then return 0.
  get(self.tk.tokens, pTok + 4)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type <> vt:Integer then return 0.
  if self.tk.tokens.tok <> '32' then return 0. ! only removing the SPACE byte makes the buffer spaceless
  get(self.tk.tokens, pTok + 5)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> ')' then return 0.  ! removeByte(32, from) is a RANGE - it does not clear the whole value
  return 1

! ====================================================================================
! ------------------------------------------------------------------------------------
! BUILTIN DeadGuard - a guard THIS TOOL emitted, deleted when an earlier guard in the
! same procedure proves it can never fire.
!
! st-getvalue-slice rewrites st.getValue() into
!     choose(st._DataEnd < 1, '', st.valuePtr[1 : st._DataEnd])
! and the choose() is load-bearing in general: valuePtr is UNBOUND on an empty
! StringTheory, so the raw slice would fault. But in code like
! preprocessor.EvalPPCondition it cannot fire:
!
!     if c._dataEnd < 1 then return true.          <- proves it, for the rest of the proc
!     p = c.findByte(61)
!     if p > 1
!       ...
!     else
!       nm = left(choose(c._DataEnd < 1, '', c.valuePtr[1 : c._DataEnd]))
!
! so the guard is noise the tool put there itself. It becomes
!     nm = left(c.valuePtr[1 : c._DataEnd])
!
! WHY THIS DIRECTION IS SAFE AND THE OPPOSITE ONE IS NOT. Asked to prove bounds so a
! slice could REPLACE a clamp, the answer was no: a proof that is wrong by one turns a
! clamp into a GPF in somebody's shipped program. Here the proof only lets a test that
! cannot fire be deleted - if it is wrong, the guard was doing nothing anyway, and the
! cost of being wrong is a missed simplification rather than a crash. Same machinery,
! opposite risk.
!
! WHAT IT DEMANDS BEFORE EDITING - all of it, or it leaves the line alone:
!   * the EXACT shape above, on ONE receiver: the same name in all three places;
!   * a dominating guard `if <recv>._DataEnd < 1 then return` earlier in the same
!     procedure. DOMINATING is checked by walking back with the tokenizer's level marks
!     and only accepting a guard reached at nesting zero - a guard inside a branch we
!     are not in proves nothing, and neither does one in another arm of an EXECUTE;
!   * NOTHING BETWEEN THEM THAT COULD CHANGE THE RECEIVER. Any call on it that is not on
!     the const list below kills the fact. The list is deliberately short and additive:
!     an unknown method is assumed to MUTATE, so a new ST method cannot silently make
!     this unsound.
!   * the scope must pass AutoScopePrep - no GOTO / COMPILE / OMIT, which is what makes
!     "earlier in the token stream" mean "earlier in execution";
!   * no INCLUDE in the scope, or in a method that follows it: the included code is not in this
!     file, and it may empty the receiver between the guard and the use;
!   * the guard must sit inside the same LOOP as the use, or in none when the use is in none.
!     A loop body runs again, so a mutation BELOW the use in that body runs before it on every
!     pass but the first, and a guard above the loop proves nothing about those passes.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinDeadGuard Procedure(StringTheory pLog)
s        long,auto
scKind   byte,auto
i        long,auto
e        long
keep     long
mainEnd  long,auto
recvU    string(vs:maxName)
lineNo   long,auto
fol      byte,auto
changes  long
sb       StringTheory ! strBefore is a &STRING of any length - a fixed STRING would pad it back with the spaces we are trying to remove
  code
  if self.syms &= NULL then return 0.
  loop s = records(self.syms.scopes) to 1 by -1                  ! BACKWARDS. Deleting tokens moves every scope
    get(self.syms.scopes, s)                                     !   AFTER this one, and the startTok/endTok in
    if errorcode() then break.                                   !   the rows were recorded before we started, so
    scKind = self.syms.scopes.kind                               !   visit the later ones FIRST while those
    if scKind <> vs:scProc and scKind <> vs:scMethod then cycle. ! numbers are still true - the reparse
    self.acScopeId = 0                                           !   that fixes them up does not happen until
    self.AutoScopePrep(s)                                        !   this builtin returns
    if self.acBail then cycle.                                   ! GOTO / COMPILE / OMIT / no CODE - order not provable
    if self.urInc then cycle.                                    ! an INCLUDE: code this file does not hold may change it
    mainEnd = self.acMainEnd
    i = self.acCodeT + 1
    loop while i <= mainEnd
      if ~self.DgShapeAt(i, recvU, e, keep)                      ! the emitted choose(), on one receiver
        i += 1
        cycle
      end
      if ~self.DgProvenNonEmpty(recvU, i, dg:wantGuard)          ! is there a dominating guard, unspoilt?
        i += 1
        cycle
      end
      if self.SpanHasNL(i + 1, keep) or self.SpanHasNL(e, e)     ! a comment or a continuation in what goes
        do BarRefused                                            !   would go with it, and the lines would join:
        i += 1                                                   !   left as written, and the report says why
        cycle
      end
      get(self.tk.tokens, i)
      lineNo = self.tk.tokens.lineNo
      fol = self.tk.tokens.firstOnLine                           ! choose( held the line's start and indent: the
      if self.tk.tokens.strBefore &= NULL                        !   survivor must inherit BOTH. A NULL strBefore
        sb.Free()                                                !   is just a zero-length one - it is what
      else                                                       !   SetStrBefore stores for '' - so it is the
        sb.SetValue(self.tk.tokens.strBefore)                    !   ordinary "(choose" case, not a refusal
      end
      self.tk.DeleteToks(e, e)                                   ! the closing ')' FIRST - deleting forwards would
      self.tk.DeleteToks(i, keep - 1)                            !   shift the index we just computed. Everything
      self.tk.SetStrBefore(i, sb.GetValue())                     ! else valuePtr keeps the space from ", " - "left( c."
      if fol
        get(self.tk.tokens, i)
        if ~errorcode()
          self.tk.tokens.firstOnLine = true
          put(self.tk.tokens)
        end
      end
      self.wantReparse = true                                    ! tokens gone; later builtins must see the new stream
      changes += 1
      pLog.append('BUILTIN DeadGuard line ' & self.tk.MapLine(lineNo) & ': choose(' & clip(recvU) & |
                  '._DataEnd << 1, ...) cannot fire - an earlier guard already returned on empty<13,10>')
      mainEnd -= (keep - i) + 1                                  !   up to R.valuePtr goes, and so does the ')'.
                                                                 ! Do NOT advance i: the survivor sits at i now, and a scope may hold more than one - the deferred pass runs ONCE, so a break here would leave the rest forever
    end
  end
  if changes then pLog.append('BUILTIN DeadGuard: ' & changes & ' guard(s) removed this pass<13,10>').
  return changes

! ---- the guard at i is proved, but the choose() is written across lines: the edit would lose the line
!      break and any words after the bar, so it stays, and the report says so - once: in the one
!      FINAL pass, or on the first pass when a rule file runs this on every pass ----
BarRefused routine
  if ~self.rl.deferPhase and self.curPass > 1 then exit.
  pLog.append('BUILTIN DeadGuard line ' & self.LogLineOf(i) & ': REFUSED - choose(' & clip(recvU) & '._DataEnd << 1, ...)')
  pLog.append(' cannot fire, but it is written across lines, and the edit would lose the line break and any words after the bar<13,10>')

! ------------------------------------------------------------------------------------
! Is the emitted shape at pIx? Returns the receiver, the index of the closing ')', and
! the index of the one token that must SURVIVE - everything from pIx up to the token
! before it goes, and so does the ')'.
!
!   choose ( R._DataEnd < 1 , '' , R.valuePtr [ 1 : R._DataEnd ] )
!                                  ^ pKeep                        ^ pEnd
!
! The receiver must be the SAME name in both places - a choose() written over two
! different objects is not ours and is not decidable here. It is read through DgRecvAt,
! so `self.buf` is as good a receiver as `c`.
! ------------------------------------------------------------------------------------
VitEngine.DgShapeAt Procedure(LONG pIx, *STRING pRecvU, *LONG pEnd, *LONG pKeep)
memU     string(vs:maxName)
r2       string(vs:maxName)
m2       string(vs:maxName)
nx       long
nx2      long
  code
  pRecvU = '' ; pEnd = 0 ; pKeep = 0
  if upper(self.tk.GetTok(pIx)) <> 'CHOOSE' then return 0.
  if self.tk.GetTok(pIx + 1) <> '(' then return 0.
  ! the shape is THREE arms - a fourth would ride along in pKeep..pEnd
  if self.DgArgCountAt(pIx + 1) <> 3 then return 0.
  if ~self.DgRecvAt(pIx + 2, pRecvU, memU, nx) then return 0.
  if memU <> '._DATAEND' then return 0.
  if self.tk.GetTok(nx)     <> '<<' then return 0.
  if self.tk.GetTok(nx + 1) <> '1' then return 0.
  if self.tk.GetTok(nx + 2) <> ',' then return 0.
  if self.tk.GetTok(nx + 3) <> '''''' then return 0. ! the empty literal
  if self.tk.GetTok(nx + 4) <> ',' then return 0.
  if ~self.DgRecvAt(nx + 5, r2, m2, nx2) then return 0.
  if r2 <> pRecvU then return 0.
  if m2 <> '.VALUEPTR' then return 0.
  pKeep = nx + 5
  pEnd  = self.tk.MatchLeftBracket('(', ')', pIx + 1)
  if ~pEnd then return 0.
  return 1

!===============================================================================================
! Is this receiver member the TARGET of an assignment rather than a read?
!
! Walks forward past any subscript - `c.valuePtr[1] = ' '` has to skip the [1] - and answers 1
! when the next thing at that level is a plain '='. A compound `+=` counts too: it writes.
! A '==' would be a comparison, but Clarion has no such operator, so a bare '=' after a member
! at statement level is a store.
!===============================================================================================
VitEngine.DgMemberIsTarget Procedure(LONG pTok)
z    long,auto
z0   long,auto
dep  long,auto
t2   string(2),auto
  code
  ! A STORE HAPPENS AT STATEMENT START. `c._DataEnd = 0` is one; the '=' inside
  ! `if c._DataEnd = 0` is a COMPARISON, and reading that as a store refused a
  ! simplification that was perfectly safe.
  ! AND RIGHT AFTER THE '?' OF A DEBUG LINE. `? c._DataEnd = 0` empties c in a debug build, which
  ! runs every statement on that line, so it is a store too: StoreHead answers for BeginsStmt's
  ! positions and that one.
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if ~self.StoreHead(pTok)
    if pTok < 2 then return 0.
    get(self.tk.tokens, pTok - 1)
    if errorcode() or self.tk.tokens.tok &= NULL then return 0.
    ! AND THEN / ELSE OPEN A STATEMENT TOO. `if f then c._DataEnd = 0.` puts a store in an
    ! inline THEN clause, where it is neither first on its line nor after a ';' - so it would
    ! read as harmless and three guards would go where one should. BeginsStmt tests EOL / ';'
    ! / THEN / ELSE, and a column-1 label in front of the statement (`Again  c._DataEnd = 0`).
    ! A member that a '|' continuation puts first on a line is NOT at a statement start: in
    ! `if a or |` / `c._DataEnd = 0` the '=' compares.
    ! THE FIFTH POSITION IS NOT A POSITION IN THE LANGUAGE, AND IS STILL WORTH ACCEPTING.
    ! A statement after a TERMINATOR dot on the same line - `if f then g = f. c._DataEnd = 0` -
    ! had an arm added for it, the probe still lost the guard, and rather than argue the point
    ! the compiler was asked: that line is refused with "Expected: <LINEBREAK> ;" AT THE
    ! SECOND STATEMENT'S FIRST CHARACTER, while the same pair joined by a ';' compiles
    ! (TestData\r233leg.clw case 2, against controls 1 and 3). Only a line break or a ';' may
    ! follow a terminator dot - both of which this test already accepts - so on code that
    ! COMPILES the vt:end arm below is unreachable, and the defect the probe was really seeing
    ! is the SPLIT MEMBER handled further down.
    ! It stays anyway, and deliberately. A general-use tool is pointed at whatever a user has,
    ! and some of it will not compile. Without this arm a member here reads as mid-expression,
    ! which means a READ, which DELETES a guard - the aggressive direction on input we cannot
    ! parse into a legal program. Accepting the position costs nothing that compiles and makes
    ! the answer on input that does not the conservative one. vt:end rather than a text test on
    ! '.', because the word END lands in the same position and deserves the same answer.
    ! Pinned by dgtermdot-test.txt / TestData\dgtermdot.clw.
    if self.tk.tokens.tok <> ';'                            |
       and upper(self.tk.tokens.tok) <> 'THEN'              |
       and upper(self.tk.tokens.tok) <> 'ELSE'              |
       and self.tk.tokens.type <> vt:end
      return 0                                              ! mid-expression: a read
    end
  end
  ! A MEMBER MAY BE THREE TOKENS. DgMemberAt reads both spellings and DgOpenAfter adds the
  ! two extra tokens for the split one, and this walk must start past the whole member: on
  ! `c ._DataEnd = 0` a walk that started one token past the RECEIVER would meet the
  ! qualifying dot as a size-1 token, and the single-character block below answers `read`
  ! to anything it does not recognise - READ two tokens before the '=' it was looking for,
  ! the store walking through the proof as harmless, the guard deleted, and a slice left
  ! whose end precedes its start.
  ! THE SPELLING IS ORDINARY, NOT EXOTIC. The label merge wants NO whitespace in front of the
  ! dot (vitTokenize.clw:466-515), and one space there is enough to leave the member as three
  ! tokens. Clarion 11 accepts that space - asked, not argued: `grp .n = 0` compiles, while
  ! `grp . n = 0` and `grp. n = 0` are refused, so it is a space AFTER the dot that turns it
  ! into a terminator, which is the rule the tokenizer already implements. So this arrives on
  ! code that COMPILES, with no terminator dot anywhere near it.
  ! Pinned by splitmember-test.txt / TestData\splitmember.clw.
  ! An `if tok = '.' then cycle` at the END of this loop would look like the answer to this
  ! case and could never fire: a '.' token is ONE character, so the single-character block
  ! above always answers first.
  z0 = pTok
  if self.DgIsMemberDot(pTok + 1) then z0 = pTok + 2.       ! split: <receiver> . <member>
  dep = 0
  loop z = z0 + 1 to z0 + 40
    get(self.tk.tokens, z)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1
      case self.tk.tokens.tok
      of '[' orof '('
        dep += 1
        cycle
      of ']' orof ')'
        dep -= 1
        cycle
      end
      if dep then cycle.
      if self.tk.tokens.tok[1] = '<10>' then return 0.      ! end of statement, no '=' seen
      if self.tk.tokens.tok = ';' then return 0.
      if self.tk.tokens.tok = '=' then return 1.            ! a store into the member
      return 0                                              ! anything else - it was a read
    end
    if dep then cycle.
    ! A COMPOUND ASSIGN IS ONE TWO-CHARACTER TOKEN, so it never reached the
    ! single-character test above and fell through as a read. `c._DataEnd -= 1`
    ! shortens the buffer as surely as a plain store does.
    t2 = self.tk.tokens.tok
    if t2[2] = '='
      case val(t2[1])
      of 43 orof 45 orof 42 orof 47 orof 38 orof 37 orof 94 ! '+' orof '-' orof '*' orof '/' orof '&' orof '%' orof '^'
        return 1
      end
    end
    return 0
  end
  return 0

!===============================================================================================
! Is the statement at pTok nothing but a bare name - i.e. a call with its brackets left off?
!
! True when the token is first on its line and the next thing is the end of the statement. That
! is the one call spelling with no bracket and no keyword to recognise it by.
!===============================================================================================
VitEngine.DgStmtIsBareName Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok + 1)
  if errorcode() then return 1.                      ! end of file - treat as a statement
  if self.tk.tokens.tok &= NULL then return 1.
  if size(self.tk.tokens.tok) = 1
    if self.tk.tokens.tok[1] = '<10>' then return 1. ! EOL
    if self.tk.tokens.tok = ';' then return 1.
    if self.tk.tokens.tok = '.'
      ! A TRAILING DOT IS NOT A QUALIFIER. `if f then Wipe9.` ends with Clarion's
      ! statement terminator, and reading it as the '.' of a dotted name let that call
      ! walk straight through. A qualifying dot has a NAME after it; a terminator does not.
      get(self.tk.tokens, pTok + 2)
      if errorcode() then return 1.
      if self.tk.tokens.tok &= NULL then return 1.
      if self.tk.tokens.type = 'b' then return 0.    ! a name follows: it qualifies
      return 1                                       ! nothing follows: a terminator
    end
  end
  return 0

!===============================================================================================
! Is this receiver a simple LOCAL of the procedure we are inside?
!
! A PROCEDURE reached without parentheses is invisible to the opaque-call arm, and a ROUTINE is
! handled by the DO arm - but neither can touch another procedure's locals. Module-level and
! global data they can. A dotted receiver answers 0 too: `gs.buf` names storage inside something
! this cannot see the lifetime of. And a method of a class the procedure declares CAN touch its
! locals - it shares the procedure's data - so a local such a method names answers 0.
!===============================================================================================
VitEngine.DgRecvIsLocal Procedure(STRING pRecvU, LONG pAtTok)
sy    long,auto
rootU string(vs:maxName),auto
scr   long,auto
  code
  if ~pRecvU then return 0.
  ! *** THE ROOT IS WHAT HAS TO BE LOCAL, NOT THE WHOLE NAME. *** `gs.buf` is reachable by a
  ! parenless call exactly when `gs` is - so refusing every dotted receiver refused a shape
  ! that is perfectly safe and is pinned by dotrecv-test.
  rootU = self.NameRoot(pRecvU)
  if ~rootU then return 0.
  if self.syms &= NULL then return 0.
  loop sy = 1 to records(self.syms.syms)
    get(self.syms.syms, sy)
    if errorcode() then break.
    if self.syms.syms.nameU <> rootU then cycle.
    scr = self.syms.syms.scopeId
    get(self.syms.scopes, scr)
    if errorcode() then cycle.
    if self.syms.scopes.startTok > pAtTok or self.syms.scopes.endTok < pAtTok then cycle.
    if self.syms.scopes.kind <> vs:scProc and self.syms.scopes.kind <> vs:scMethod then cycle.
    ! *** AND A TRUE LOCAL, WHICH A PARAMETER IS NOT. *** A CLASS parameter is BY REFERENCE
    ! and SELF is the caller's object, so both name storage a parenless call CAN reach. The
    ! sibling gates all demand a column-1 declaration and refuse isRef; this one did not.
    if self.syms.syms.isRef then cycle.
    if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then cycle.
    if self.MayHaveLocalMethods(scr) and self.UsedInLocalMethods(rootU, self.syms.scopes.startTok, self.syms.scopes.endTok) then return 0.
    return 1
  end
  return 0

! ------------------------------------------------------------------------------------
! ONE backward walk, two facts. Does something earlier in this procedure prove pWant
! about pRecvU at pIx, with nothing in between that could have unproved it? Walks BACK
! to the CODE statement.
!
!   dg:wantGuard   pRecvU is NOT EMPTY, from   if R._DataEnd < 1 then return.
!   dg:wantTrim    pRecvU has NO LEADING SPACE, from   R.Trim()   or   R.setLeft()
!
! Two separate questions are asked of every token on the way back, and they are NOT
! asked at the same nesting:
!
!   * COULD THIS HAVE CHANGED THE RECEIVER? Asked at EVERY nesting. A mutation inside a
!     branch we did not come through cannot be ruled out cheaply, and a wrong answer here
!     is unsound, so any use of the receiver that is not on the const list below kills the
!     fact wherever it appears. An unknown method is assumed to MUTATE, so a new
!     StringTheory method cannot silently make this unsound.
!   * DOES THIS PROVE IT? Asked only where the statement DOMINATES us, which is tracked
!     with the tokenizer's level marks. Going backwards a '-' means a block closed above
!     us (nest+1) and a '+' means one opened (nest-1), so a guard is read at the '+' when
!     nest returns to zero - i.e. from a block that opened AND closed as a SIBLING
!     statement before us, which is exactly the shape of
!         if c._DataEnd < 1 then return.
!     Reaching our line at all means that IF did not fire. A guard nested one deeper
!     (case 4 in the fixture) never brings nest back to zero, so it is never believed.
!
!     A LOOP the use sits inside is the other way for text order to lie about execution
!     order: its body runs again, so a mutation BELOW the use runs before it on every pass
!     but the first. The walk stops, unproved, at a LOOP or ACCEPT opener it is inside - a
!     '+' met at nest zero is an opener whose block we are in - so a proof has to come from
!     inside the same loop as the use.
!
!     An ELSE is the other way to be somewhere we did not come through, and it needs its
!     own mark: walking back out of an else arm, everything until the owning IF is code
!     that did NOT run. inArm says so. It is set on a '/' seen at OUR level and cleared
!     by the '+' that owns it, so an elsif chain of any length clears in one go. Without
!     it a Trim() in the THEN arm would be believed while we sit in the ELSE arm.
!
!     An EXECUTE arm is a third way, and it carries no mark at all. The statements between
!     an EXECUTE and its END are ALTERNATIVES - one of them runs, picked by the value - so
!     a guard or a Trim() one arm above ours did not run when ours did. inExec says that
!     the level being walked is an EXECUTE's own list of arms: ArmOfExecute answers it for
!     the use, and again for each opener the walk climbs out of. While it is set nothing at
!     that level proves anything. The code above the EXECUTE did run, so the walk goes on
!     past the EXECUTE, and a guard there still counts.
!
! Only the one-line THEN RETURN form of the guard is recognised. The block form
!     if c._DataEnd < 1 ; return ; end
! is a miss, not a wrong answer: it simply leaves the choose() in place. Likewise only
! the NO-ARGUMENT Trim() proves anything - Trim('*') strips a different alphabet, and
! spaces would survive it. setLeft() is decided by its What argument instead, which can
! be a SUM - see DgSetLeftProves.
!
! The receiver is written two ways by the tokenizer and both are read here: a property
! merges into one token (c._DataEnd, c.valuePtr) but a CALL splits into three (c . Free).
! Reading only the merged form would silently see no mutations at all.
! ------------------------------------------------------------------------------------
VitEngine.DgProvenNonEmpty Procedure(STRING pRecvU, LONG pIx, STRING pWant)
j        long,auto
nest     long
inArm    byte
inExec   byte,auto
lv       string(1),auto
tyv      string(1),auto
mU       string(vs:maxName),auto
kwU      string(vs:maxName),auto
psc      long,auto
rootU    string(vs:maxName),auto
bare     byte,auto
pn       string(vs:maxName),auto
own      StringTheory
ownSet   byte
  code
  ! A REFERENCE TAKEN ON THE RECEIVER is a second name a member store can go through -
  ! `ref._DataEnd = 0` is one merged token, neither the receiver nor a call - so a receiver
  ! anything points at is never proven. A reference on its buffer (`r &= c.valuePtr`, one
  ! merged token) or on the object it is a member of reaches it too: the root decides.
  if self.syms &= NULL then return 0.
  psc = self.syms.ScopeContaining(pIx, vs:scProc, vs:scMethod)
  if ~psc then return 0.
  self.syms.scopes.scopeId = psc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 0.
  rootU = self.NameRoot(pRecvU)
  loop j = self.syms.scopes.startTok to self.syms.scopes.endTok
    if self.tk.GetTok(j) = '&=' and self.NameRoot(self.tk.GetTok(j + 1)) = rootU then return 0.
  end
  ! IS THE USE ONE ARM OF AN EXECUTE? Then the statements above it at its level are other
  ! arms, which did not run when it did - see the header.
  inExec = choose(self.ArmOfExecute(pIx) > 0)
  loop j = pIx - 1 to self.acCodeT + 1 by -1
    get(self.tk.tokens, j)
    if errorcode() then break.
    lv = self.tk.tokens.level
    tyv = self.tk.tokens.type
    ! *** A ROUTINE CAN EMPTY ANY BUFFER, AND `do` DOES NOT MENTION THE RECEIVER. *** This
    ! walk looks for mutations THROUGH the receiver, so a bare `do Wipe` - where Wipe does
    ! c.free() - was invisible, the guard read as dead and was deleted, and what was left was
    ! `nm = left(c.valuePtr[1 : c._DataEnd])` on an empty buffer. A slice whose end precedes
    ! its start, with no bounds checking behind it: the GPF this builtin's own banner promises
    ! away. Every sibling analysis already kills on DO - KnownRanges at lnDo, TrailingSpaces
    ! in two places - and this one walker was the odd one out.
    if self.tk.tokens.type = vt:reservedWord
      if upper(self.tk.tokens.tok) = 'DO' then return 0.                              ! cannot prove across a DO
      ! AND A CALL IS THE OTHER SPELLING OF THE SAME THING. A ROUTINE reached by DO and a
      ! PROCEDURE reached by CALL are both opaque here: either can empty any buffer this walk
      ! can see, and neither mentions the receiver. The DO half was closed first and this one
      ! left open, so `Wipe()` between a guard and its use still had the guard deleted.
      if upper(self.tk.tokens.tok) = 'CALL' then return 0.
    end
    ! AND A PLAIN `Wipe()` IS A CALL WITH NO KEYWORD IN FRONT OF IT. CALL is only
    ! Clarion's DYNAMIC call, so covering DO and CALL still left the ordinary spelling -
    ! the one the probe used - walking straight through. Any call that is not on the pure
    ! list can empty any buffer, so it ends the proof, exactly as KnownRanges treats one.
    ! A METHOD CALL ON THE RECEIVER ITSELF - `c.trim()`, `self.buf.free()` - is left to the member
    ! logic below, which reads the method's name: DeadLeft's whole PROOF is such a call. A method
    ! call on ANY OTHER object - `self.Reset()`, `oth.Wipe()` - is as opaque as a bare call: that
    ! object may be the receiver's owner or hold a reference to it, and its method can empty the
    ! buffer without naming it. Its method's name is tested against the pure list as a bare call's is,
    ! and must also be a method StringTheory has: `oth.Format(x)` is that class's own - see PureMethod.
    ! And the object must BE a StringTheory: `oth.GetLine(n)` on a class of the author's own is that
    ! class's method whatever its name, and as opaque as `oth.Wipe()` - see PureMethodAt.
    ! A name with NO object in front of it must be one of the runtime's own functions, and not a name
    ! this file gives a procedure of its own (PureProc, with PureOwnList built once per walk): a plain
    ! `GetLine(n)` or a program's own `Size PROCEDURE` is the program's code, and may empty the buffer.
    if self.tk.tokens.tok = '(' and j > 2
      get(self.tk.tokens, j - 2)
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.tok = '.' and upper(self.tk.GetTok(j - 3)) = pRecvU
          get(self.tk.tokens, j)                                                      ! our receiver's own method: the member logic decides
          cycle
        end
      end
      get(self.tk.tokens, j - 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.type = 'b'
          if ~self.dgPure.findChars(' ' & clip(upper(self.tk.tokens.tok)) & ' ') then return 0.
          pn = self.tk.tokens.tok                                                     ! the name, read before GetTok moves the buffer
          if self.tk.GetTok(j - 2) = '.'
            if ~self.PureMethodAt(j, self.dgPure) then return 0.
          else
            if ~ownSet then self.PureOwnList(self.dgPure, own) ; ownSet = 1.
            if ~self.PureProc(pn, self.dgPure, own) then return 0.
          end
        end
      end
      get(self.tk.tokens, j)                                                          ! restore the walk's buffer
    end
    ! A PARENLESS CALL IS A BARE NAME STANDING AS A WHOLE STATEMENT. Clarion lets a call
    ! omit its brackets, so `Wipe9` on a line of its own is a call with nothing to recognise it
    ! by. It cannot reach another procedure's TRUE locals - but a PARAMETER is the caller's
    ! variable by reference, and SELF is the caller's object, so it can reach both of those.
    ! Only refuse when the receiver is actually within its reach: with nothing between the guard
    ! and the use there is no call to be exposed to, and a parameter receiver simplifies as it
    ! always did.
    ! AND IT NEED NOT BE FIRST ON ITS LINE. `x = f ; Wipe9` puts one after a semicolon,
    ! `if f then Wipe9.` puts one after THEN, and `oth.Wipe` is a parenless method call on
    ! something else entirely - which can still reach a global. Keying on firstOnLine saw
    ! none of them, and with the pre-filter gone a global receiver lost its guard to all
    ! three. Any bare name that ENDS a statement is a call we cannot see into.
    ! NOR NEED IT END ONE. `x = Wipe + 1` and `if Pad then x = 1.` call Wipe and Pad as surely
    ! as `Wipe` alone: a name in the middle of a statement that the symbol table does not place
    ! as data is a call too (BareCallAt). A name on the receiver's own root is left to the
    ! arm after this one, which reads it as a member or as a method of what holds the receiver.
    ! THE RESTORE HAS TO HAPPEN WHETHER THE TEST PASSED OR NOT. DgStmtIsBareName PEEKS
    ! at j+1 (and sometimes j+2) and returns without putting the buffer back, so when it answers
    ! NO - which is every mid-statement token, the common case - the walk's buffer was left on the
    ! NEIGHBOUR. The same-root arm immediately below reads `self.tk.tokens` expecting token j, and
    ! was reading that neighbour instead: for `k = gs2.wipe + 1` walked backwards it tested '+',
    ! which has no dot, so the arm never fired and a parenless method call on the receiver's own
    ! root walked through the proof. The guard was deleted and what was left was
    ! `left(gs2.buf.valuePtr[1 : gs2.buf._DataEnd])` on a buffer that call may have emptied - the
    ! GPF this builtin's banner promises away, and in the ONE arm written to prevent it.
    ! It hid because the pinned case put the call on a line of its OWN: there the test answers
    ! YES, the restore ran, and the arm saw what it was supposed to. MEASURED: the same call
    ! mid-statement lost its guard while its split-spelling twin kept one.
    ! The restore is inside the type test, so it costs a GET only where a peek actually happened.
    if self.tk.tokens.type = 'b'
      bare = self.DgStmtIsBareName(j)
      if ~bare and self.NameRoot(self.tk.GetTok(j)) <> rootU
        bare = self.BareCallAt(j)
      end
      if bare
        if ~self.DgRecvIsLocal(pRecvU, pIx) then return 0.
      end
      get(self.tk.tokens, j)                                                          ! restore the walk's buffer
    end
    ! SOMETHING ELSE ON THE SAME ROOT IS A MUTATION WE CANNOT SEE INTO. `gs2.wipe` is a
    ! parenless METHOD call: it merges to one token, so it carries no '(' for the opaque-call
    ! arm, and it is not a member of `gs2.buf`, so the member walk below skips it entirely. But
    ! it names the same ROOT as the receiver, and whatever it does it can do to gs2.buf.
    if self.tk.tokens.type = 'b' and not self.tk.tokens.tok &= NULL
      if own.findByte(46,,, self.tk.tokens.tok)                                       | ! <dot>
         and upper(self.tk.tokens.tok) <> upper(pRecvU)                               |
         and self.NameRoot(self.tk.tokens.tok) = self.NameRoot(pRecvU)
        if ~self.DgMemberAt(j, pRecvU) then return 0.
      end
    end
    mU = self.DgMemberAt(j, pRecvU)                                                   ! '' when this is not our receiver
    if mU
      if pWant = dg:wantTrim and ~nest and ~inArm and ~inExec and ~self.DebugLine(j)  ! both of these leave character 1 non-blank,
        case mU                                                                       !   which is the whole claim - see the header
        of '.TRIM'                                                                    ! Trim() strips ' ', left()'s own alphabet.
          if ~self.DgArgCountAt(self.DgOpenAfter(j)) then return 1.                   ! Trim('*') strips something else
        of '.SETLEFT'                                                                 ! setLeft() / setLeft(n): pWhat defaults to
          if self.DgSetLeftProves(self.DgOpenAfter(j)) then return 1.                 ! st:spaces, and a What that SUMS
        end                                                                           !   st:spaces in still qualifies
      end
      case mU
      of   '._DATAEND' orof '.VALUEPTR'     orof '.GETVALUE'      orof '.GETVALUEPTR' |
      orof '.LEN'      orof '.LENGTH'       orof '.LENGTHA'       orof '.CLIPLENGTH'  |
      orof '.SUB'      orof '.SLICE'        orof '.BETWEEN'       orof '.BEFORE'      |
      orof '.AFTER'    orof '.FINDCHAR'     orof '.FINDCHARS'     orof '.FINDBYTE'    |
      orof '.INSTRING' orof '.CONTAINSCHAR' orof '.CONTAINSCHARS'                     |
      orof '.RECORDS'  orof '.GETLINE'      orof '.LINES'
        ! CONST ONLY WHILE IT IS BEING READ. `c._DataEnd` reads the length; `c._DataEnd = 0`
        ! SETS it, and `c.valuePtr[1] = ' '` writes a byte - both through names on this list,
        ! which blessed them as harmless. A member that is the TARGET of an assignment is a
        ! mutation whatever its name is, so look for the '=' that follows it.
        if self.DgMemberIsTarget(j) then return 0.
      else
        return 0                                                                      ! anything else MIGHT mutate it: unknown = unsafe
      end
    end
    ! AN UNMARKED END CLOSES A BLOCK TOO. A '.' rewritten by SetTok keeps its vt:end type and loses its
    ! '-' mark, and the eleven other level walks count it as a close - see WalkUnreachable. Every builtin
    ! that rewrites a '.' asks for a re-read before the next one runs, so this walk should never meet one;
    ! if it did, a one-line guard nested inside an `if ... end` would be taken for a sibling above the use.
    if lv = '-' or (tyv = vt:end and lv <> '+' and lv <> '/') then nest += 1.
    if lv = '/' and ~nest then inArm = 1.                                             ! an ELSE/ELSIF at OUR level: everything from here
    if lv = '+'                                                                       !   back to its IF is an arm we did not run
      if nest > 0
        nest -= 1                                                                     ! the opener of a block that closed above us
        if inExec then cycle.
      else
        inArm = 0                                                                     ! the opener of a block we are INSIDE: the IF that owns the arm(s) we just walked over,
        kwU = upper(self.tk.GetTok(j))                                                !   or a LOOP, whose body runs again - nothing above it holds on the second pass
        if kwU = 'LOOP' or kwU = 'ACCEPT' then return 0.
        if pWant = dg:wantGuard and self.DgGuardAt(j, pRecvU) then return 1.
        inExec = choose(self.ArmOfExecute(j) > 0)
        cycle
      end
      if ~nest and ~inArm and pWant = dg:wantGuard and self.DgGuardAt(j, pRecvU) then return 1.
    end
  end
  return 0                                                                            ! reached the CODE statement without a proof

! ------------------------------------------------------------------------------------
! Is the token at pIx a use of pRecvU's member, and which member? Returns '.NAME' upper
! cased, or '' if this token is not our receiver at all. Handles both spellings:
!     c._DataEnd          one token
!     c . Free            three tokens
! A bare receiver that is NOT followed by a dot - passed to something, say - answers
! '.?', which is on no const list and so is read as a possible mutation.
! ------------------------------------------------------------------------------------
VitEngine.DgMemberAt Procedure(LONG pIx, STRING pRecvU)
t        string(vs:maxName),auto
dotP     long,auto
  code
  t = self.tk.GetTok(pIx)
  if ~t then return ''.
  if self.DgIsMemberDot(pIx + 1)          ! split: <receiver> . <method>
    if upper(t) <> pRecvU then return ''.
    return '.' & upper(self.tk.GetTok(pIx + 2))
  end
  if upper(t) = pRecvU then return '.?'.  ! the receiver BARE - passed to something,
  dotP = self.DgLastDot(t)                !   &= assigned. Assume the worst
  if dotP < 2 or                          |
     upper(sub(t, 1, dotP - 1)) <> pRecvU
    return ''
  end
  return upper(sub(t, dotP, len(clip(t)) - dotP + 1))

! ------------------------------------------------------------------------------------
! Is the whole one-line guard at pIx?   if R._DataEnd < 1 then return
! A guard on a `?` DEBUG line runs in debug builds only, so it proves nothing.
! ------------------------------------------------------------------------------------
VitEngine.DgGuardAt Procedure(LONG pIx, STRING pRecvU)
  code
  if upper(self.tk.GetTok(pIx)) <> 'IF' then return 0.
  if self.DebugLine(pIx) then return 0.
  if self.DgMemberAt(pIx + 1, pRecvU) <> '._DATAEND' then return 0.
  if self.tk.GetTok(pIx + 2) <> '<<' then return 0.
  if self.tk.GetTok(pIx + 3) <> '1' then return 0.
  if upper(self.tk.GetTok(pIx + 4)) <> 'THEN' then return 0.
  if upper(self.tk.GetTok(pIx + 5)) <> 'RETURN' then return 0.
  return 1

! ------------------------------------------------------------------------------------
! Where is the '(' of the call whose member name sits at pIx? The tokenizer writes a
! member two ways - see DgMemberAt - and the same test decides both.
! ------------------------------------------------------------------------------------
VitEngine.DgOpenAfter Procedure(LONG pIx)
  code
  if self.DgIsMemberDot(pIx + 1) then return pIx + 3. ! split    c . Trim (
  return pIx + 1                                      ! merged   c.Trim (

! ------------------------------------------------------------------------------------
! How many arguments does the call bracket at pOpenIx have? 0 for '()', otherwise one
! more than the commas at depth 1 - so a comma inside a nested call or subscript is not
! counted. Answers 99 when pOpenIx is not a '(' at all, which passes none of the tests
! the callers make and so reads as a refusal rather than as "no arguments".
! ------------------------------------------------------------------------------------
VitEngine.DgArgCountAt Procedure(LONG pOpenIx)
j        long,auto
depth    long,auto
n        long,auto
! #Removed as not used: t        string(vs:maxName),auto
  code
  if self.tk.GetTok(pOpenIx) <> '(' then return 99.
  if self.tk.GetTok(pOpenIx + 1) = ')' then return 0.
  n     = 1
  depth = 1
  loop j = pOpenIx + 1 to records(self.tk.tokens)
    case self.tk.GetTok(j)
    of '(' orof '['
      depth += 1
    of ')' orof ']'
      depth -= 1
      if ~depth then break.
    of ','
      if depth = 1 then n += 1.
    end
  end
  return n

! ------------------------------------------------------------------------------------
! Does the setLeft() whose bracket opens at pOpenIx provably strip leading SPACES?
!
!   st.setLeft()                        yes - What is omitted and defaults to st:spaces
!   st.setLeft(20)                      yes - the Length pads the RIGHT; it strips nothing
!   st.setLeft( ,st:spaces + st:tabs)   yes - a sum that INCLUDES st:spaces (the usual form,
!                                             and the one the CapeSoft help gives as its
!                                             own example)
!   st.setLeft( ,st:tabs)               NO  - leading spaces survive it untouched
!   st.setLeft( ,flags)                 NO  - a variable. This walk does not evaluate one,
!                                             and a wrong guess here is unsound
!
! The third parameter, Pad, cannot matter: padding is added on the RIGHT, and a string
! made entirely of pad characters has no leading space to strip either way.
! ------------------------------------------------------------------------------------
VitEngine.DgSetLeftProves Procedure(LONG pOpenIx)
n        long,auto
j        long,auto
j0       long
depth    long,auto
t        string(vs:maxName),auto
sawSp    byte
sawAny   byte
  code
  n = self.DgArgCountAt(pOpenIx)
  if n = 99 then return 0.                             ! not a call bracket at all
  if n < 2 then return 1.                              ! What omitted - it defaults to st:spaces
  depth = 1
  loop j = pOpenIx + 1 to records(self.tk.tokens)
    t = self.tk.GetTok(j)
    case t
    of '(' orof '['
      depth += 1
    of ')' orof ']'
      depth -= 1
      if ~depth then break.
    of ','
      if depth = 1
        if ~j0
          j0 = j + 1                                   ! What starts after the FIRST comma
        else
          break                                        ! and ends at the second - Pad is not our business
        end
      end
    end
    if j0 and j >= j0                                  ! inside What: a sum of st:* constants, nothing else
      sawAny = true
      case upper(t)
      of 'ST:SPACES'
        sawSp = true
      of '+'
        ! a term separator - keep reading
      else
        if upper(sub(t, 1, 3)) <> 'ST:' then return 0. ! a variable or an expression: not read here
      end
    end
  end
  if ~sawAny then return 1.                            ! `setLeft(20, )` - What is empty, so it defaulted
  return choose(sawSp = true)

! ------------------------------------------------------------------------------------
! BUILTIN DeadLeft (OPT-IN) - drop a left() that provably has nothing to strip.
!
!     c.Trim()
!     ...
!     nm = left(c.sub(1, p - 1))        ->   nm = c.sub(1, p - 1)
!     nm = left(c.valuePtr[1 : n])      ->   nm = c.valuePtr[1 : n]
!
! from preprocessor.EvalPPCondition, the same procedure DeadGuard came
! from: the receiver is trimmed at the top and every read of it below starts at
! character 1, so left() cannot find a leading space to remove.
!
! WHY THE SLICE MUST START AT 1. Trim() proves nothing about character 7. left(c.sub(2,n))
! may well have a space to strip, so only a literal 1 as the first argument qualifies -
! not a variable that happens to hold 1, which would need the value walk.
!
! THE ARGUMENT IS THE READ AND NOTHING ELSE. left() strips the LEADING spaces of its whole
! argument. A first operand proven clean can still be EMPTY - sub(1, 0) when the separator
! comes first, or a value Trim() left empty - and then left() strips the next operand
! instead, so left(A & B) keeps its left(); only left(A) alone loses it.
!
! WHY Trim() AND NOT trim(alphabet). The no-argument Trim() strips ' ' - the same
! alphabet left() strips - so one exactly covers the other. Trim('*') does not, and
! answers no.
!
! WHY ONLY THE ONE-ARGUMENT FORM. Clarion spells this LEFT(string [,length]), and a
! length is not decoration: the result is a string of exactly that width, padded on the
! right. The edit deletes the word and its two brackets and nothing else, so on
! left(x, 40) it would change the width AND leave `x, 40` standing - text that is not
! Clarion. DlShapeAt counts the arguments and takes only the one-argument form.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinDeadLeft Procedure(StringTheory pLog)
s        long,auto
scKind   byte,auto
i        long,auto
e        long
mainEnd  long,auto
fol      byte,auto
recvU    string(vs:maxName)
lineNo   long,auto
changes  long
sb       StringTheory ! see BuiltinDeadGuard - a fixed STRING would pad
  code
  if self.syms &= NULL then return 0.
  loop s = records(self.syms.scopes) to 1 by -1                  ! BACKWARDS, and for the reason written out at
    get(self.syms.scopes, s)                                     !   BuiltinDeadGuard: the recorded token ranges
    if errorcode() then break.                                   !   of every LATER scope go stale the moment we
    scKind = self.syms.scopes.kind                               !   delete anything, and nothing repairs them
    if scKind <> vs:scProc and scKind <> vs:scMethod then cycle. ! until this builtin returns
    self.acScopeId = 0
    self.AutoScopePrep(s)                                        ! the ROW - AutoScopePrep gets positionally
    if self.acBail then cycle.                                   ! GOTO / COMPILE / OMIT / no CODE - order not provable
    if self.urInc then cycle.                                    ! an INCLUDE: code this file does not hold may change it
    mainEnd = self.acMainEnd
    i = self.acCodeT + 1
    loop while i <= mainEnd
      if ~self.DlShapeAt(i, recvU, e)                            ! left( <receiver read starting at 1> ...
        i += 1
        cycle
      end
      if ~self.DgProvenNonEmpty(recvU, i, dg:wantTrim)           ! a dominating Trim(), unspoilt?
        i += 1
        cycle
      end
      if self.SpanHasNL(i + 1, i + 2) or self.SpanHasNL(e, e)    ! a comment or a continuation in what goes
        do BarRefused                                            !   would go with it, and the lines would join:
        i += 1                                                   !   left as written, and the report says why
        cycle
      end
      get(self.tk.tokens, i)
      lineNo = self.tk.tokens.lineNo
      fol    = self.tk.tokens.firstOnLine                        ! left( held the line's start and indent
      if self.tk.tokens.strBefore &= NULL
        sb.Free()
      else
        sb.SetValue(self.tk.tokens.strBefore)
      end
      self.tk.DeleteToks(e, e)                                   ! the closing ')' FIRST - deleting forwards would
      self.tk.DeleteToks(i, i + 1)                               !   shift the index we just computed
      self.tk.SetStrBefore(i, sb.GetValue())
      if fol
        get(self.tk.tokens, i)
        if ~errorcode()
          self.tk.tokens.firstOnLine = true
          put(self.tk.tokens)
        end
      end
      self.wantReparse = true
      changes += 1
      pLog.append('BUILTIN DeadLeft line ' & self.tk.MapLine(lineNo) & ': left() on ' & clip(recvU) & |
                  ' from character 1 has nothing to strip - it was trimmed above<13,10>')
      mainEnd -= 3                                               ! left, its '(' and its ')'. Do NOT advance i - the survivor sits at i, and case 1 of the fixture has TWO in one procedure
    end
  end
  if changes then pLog.append('BUILTIN DeadLeft: ' & changes & ' left() removed this pass<13,10>').
  return changes

! ---- the left() at i has nothing to strip, but it is written across lines: the edit would lose the
!      line break and any words after the bar, so it stays, and the report says so - once, as
!      DeadGuard says it ----
BarRefused routine
  if ~self.rl.deferPhase and self.curPass > 1 then exit.
  pLog.append('BUILTIN DeadLeft line ' & self.LogLineOf(i) & ': REFUSED - left() on ' & clip(recvU) & ' from character 1')
  pLog.append(' has nothing to strip, but it is written across lines, and the edit would lose the line break and any words after the bar<13,10>')

! ------------------------------------------------------------------------------------
! Is the no-op shape at pIx? Returns the receiver and the index of left()'s closing ')'.
!     left ( R.valuePtr [ 1 : ...        left ( R . sub ( 1 , ...
! Both spellings of a member reference are read - see DgRecvAt. The left is the runtime's
! own: one after a '.' is a method of that object, and is left alone.
! ------------------------------------------------------------------------------------
VitEngine.DlShapeAt Procedure(LONG pIx, *STRING pRecvU, *LONG pEnd)
memU     string(vs:maxName)
nx       long
ce       long,auto
  code
  pRecvU = '' ; pEnd = 0
  if upper(self.tk.GetTok(pIx)) <> 'LEFT' then return 0.
  if self.tk.GetTok(pIx - 1) = '.' then return 0.
  if self.tk.GetTok(pIx + 1) <> '(' then return 0.
  if self.DgArgCountAt(pIx + 1) <> 1 then return 0.
  if ~self.DgRecvAt(pIx + 2, pRecvU, memU, nx) then return 0.
  case memU
  of '.VALUEPTR'                                  ! R.valuePtr[1 : ...
    if self.tk.GetTok(nx) <> '[' then return 0.
  of '.SUB'      orof '.SLICE'                    ! R.sub(1, ...   R.slice(1, ...
    if self.tk.GetTok(nx) <> '(' then return 0.
  else
    return 0
  end
  if self.tk.GetTok(nx + 1) <> '1' then return 0. ! a LITERAL 1 - a variable holding 1 is not read here
  case self.tk.GetTok(nx + 2)                     ! ... and the operand must END there: '1 + p' is not a read
  of ',' orof ':' orof ')' orof ']'               !     from character 1, and the left() it wears does real work
  else
    return 0
  end
  pEnd = self.tk.MatchLeftBracket('(', ')', pIx + 1)
  if ~pEnd then return 0.
  ! the read is the whole argument: an empty first operand hands left() the next one
  if memU = '.VALUEPTR'
    ce = self.tk.MatchLeftBracket('[', ']', nx)
  else
    ce = self.tk.MatchLeftBracket('(', ')', nx)
  end
  if ce + 1 <> pEnd then return 0.
  return 1

! ------------------------------------------------------------------------------------
! Read a member reference at pIx whatever its spelling, WITHOUT knowing the receiver
! first: DgMemberAt answers about a receiver already in hand, this one names it.
!   merged   c.valuePtr            -> recv c, member .VALUEPTR, next = pIx + 1
!   split    c . sub               -> recv c, member .SUB,      next = pIx + 3
! Answers 0 when the token is not a member reference at all.
! ------------------------------------------------------------------------------------
VitEngine.DgRecvAt Procedure(LONG pIx, *STRING pRecvU, *STRING pMemU, *LONG pNext)
t        string(vs:maxName),auto
dotP     long,auto
  code
  pRecvU = '' ; pMemU = '' ; pNext = 0
  t = self.tk.GetTok(pIx)
  if ~t then return 0.
  if self.DgIsMemberDot(pIx + 1) ! split: <receiver> . <method>
    if ~self.tk.GetTok(pIx + 2) then return 0.
    pRecvU = upper(t)
    pMemU  = '.' & upper(self.tk.GetTok(pIx + 2))
    pNext  = pIx + 3
    return 1
  end
  dotP = self.DgLastDot(t)       ! merged, and split on the LAST dot: the
  if dotP < 2 then return 0.     !   receiver of self.buf._DataEnd is self.buf
  pRecvU = upper(sub(t, 1, dotP - 1))
  pMemU  = upper(sub(t, dotP, len(clip(t)) - dotP + 1))
  pNext  = pIx + 1
  return 1

! ------------------------------------------------------------------------------------
! Where is the LAST dot in a token? A receiver may be dotted itself - self.buf.valuePtr
! is one token whose receiver is self.buf - so the member is what follows the last dot,
! never the first. Answers 0 when there is none.
! ------------------------------------------------------------------------------------
VitEngine.DgLastDot Procedure(STRING pTok)
x        long,auto
  code
  loop x = len(clip(pTok)) to 1 by -1
    if pTok[x] = '.' then return x.
  end
  return 0

! ------------------------------------------------------------------------------------
! Is the token at pIx the '.' that joins a receiver to a member, rather than the '.'
! that CLOSES a block? Clarion spells both the same and only the token type tells them
! apart. Without this, `if x then n = c.` reads as a call on c, and the token after the
! END dot - the next line's first word - gets taken for a method name.
! ------------------------------------------------------------------------------------
VitEngine.DgIsMemberDot Procedure(LONG pIx)
  code
  if self.tk.GetTok(pIx) <> '.' then return 0.
  get(self.tk.tokens, pIx)
  if errorcode() then return 0.
  return choose(self.tk.tokens.type = vt:dot)

! BUILTIN KnownRanges (S3, runs by default) - retire a guard, or a choose(),
! that provably cannot go the other way, and collapse a computed sub() length into the
! slice() that says the same thing, by tracking WHERE a scalar local got its value.
!
!     p = st.findChar('=')                          p is 0 .. st._DataEnd
!     if ~p then break.                             below it, p is 1 .. st._DataEnd
!     if p - 1 < st._DataEnd then st.setLength(p - 1).      -> st.setLength(p - 1)
!     ... st.sub(choose(q < 0, st._DataEnd + q + 1, q), q)  -> st.sub(q, q)
!     ... st.sub(p, q - p + 1)                              -> st.slice(p, q)
!
! BOTH of those lines are code VitTransform ITSELF emitted (the truncate rule and
! the v13c sub-position dispatch). A pattern rule cannot know where a value came from,
! so it guards; this pass can, so it cleans up after them.
!
! THE MODEL. This is AutoCheck's walk (AutoVerdict) carrying RANGE FACTS instead of
! assigned/not-assigned: the same per-scope AutoScopePrep bail, the same level-mark
! frames, the same inline-dot idiom. One linear forward pass over each proc/method
! MAIN code, and over each ROUTINE that has DATA of its own - for that routine's own locals,
! which are allocated on every DO and visible nowhere else.
!
!   lattice   rk:none / rk:zeroBound (0..recv._DataEnd) / rk:posBound (1..recv._DataEnd)
!             / rk:nonNeg (>= 0).  Each bounded fact records the RECEIVER it is bounded
!             by, so a fact about `st` says nothing about `other._DataEnd`.
!             rk:posBound with NO receiver is x >= 1 and nothing above it: a summary's, or a
!             nonNeg narrowed by `if ~x`. A fact can also REMEMBER a string (kvClip): the local
!             holds len(clip(that string)) until either name is written - S14 reads on it.
!   seeds     x = recv.findChar/findChars/findByte/instring(...)  -> zeroBound on recv
!             x = recv.len/length/lengthA/clipLength(...)          -> nonNeg
!             x = recv._DataEnd                                    -> nonNeg
!             x = len/records/size/instring(...)                   -> nonNeg
!             x = len(clip(s))                                     -> nonNeg, remembering s
!             x = self.Method(...) / x = MyProc(...)               -> that body's
!               SUMMARY, when the body is in THIS file and (for a method) its prototype is
!               visible and NOT virtual. sm:nonNeg -> nonNeg, sm:posBound -> posBound with
!               NO receiver, so a summary can only ever decide `x < 0` and `x >= 0` and
!               their mirrors - never S3, which demands a bound on the receiver it is
!               written on. The fact carries the CALLEE's name and every log line it
!               decides says so, because the evidence is in another procedure.
!             anything else -> the fact is DROPPED (rk:none).
!   counted LOOP  `loop i = 1 to recv._DataEnd` and `loop i = recv._DataEnd to 1 by -1` make i
!             posBound on recv for the body (KrLoopSeed); from 0, or from a local >= 0, zeroBound;
!             any other counted loop from a non-negative integer or a local >= 0 makes i nonNeg.
!   narrowing `if ~x then break|return|cycle|exit.` - below it x is non-zero, so
!             zeroBound becomes posBound;  `if ~x` ... `else` - inside the ELSE x is
!             non-zero.  The ELSE form is restored from a snapshot taken AT THE IF, so a
!             kill inside the THEN branch (which never ran on this path) cannot suppress
!             it. Facts carry the depth they were made at and die when that block closes.
!   invalidation
!             * a write to x (`x =`, `x +=`, ... at a statement start / after THEN /
!               ELSE / ';') drops every fact for x, then the seed above may re-make it;
!             * ANY impure call on the line drops every fact whose variable OR receiver
!               is NAMED anywhere on that line - it may be a *LONG output parameter, or a
!               method that moves the receiver's _DataEnd, and there is no prototype here;
!             * any `DO <routine>` clears EVERY fact - a routine can change anything;
!             * a non-IF block opener
!               clears every fact: LOOP and ACCEPT REPEAT, so a fact made above the opener
!               is not valid at the top of the body on the second iteration, and this walk
!               only ever sees the body once. Under-reach for CASE/EXECUTE, deliberately.
!             * GOTO / COMPILE / OMIT anywhere in the scope refuses the scope outright
!               (the existing AutoScopePrep bail).
!
! THE SIMPLIFICATIONS.
!   S1  `if C then S.` with C provably TRUE -> `if C then` and the terminating '.' are
!       deleted, leaving S, which inherits the IF token's leading trivia (its indent, and
!       any comment lines parked in front of it). SINGLE-LINE FORM ONLY - collapsing a
!       block IF would mean re-indenting its body, which is a different job. With C
!       provably FALSE the whole line goes (KrS1Dead) unless a comment is in the way.
!   S2  `choose(C, A, B)` with C provably FALSE -> the span becomes B; TRUE -> A. The
!       kept value inherits the CHOOSE token's trivia. EXACTLY two top-level commas: the
!       four-or-more argument form of CHOOSE is the INDEXED form and means something else.
!       A choose() is one term and the kept value need not be: where an operator beside it
!       would bind into it, it keeps the choose's own brackets - `2 * choose(p >= 0, a + 1,
!       0)` -> `2 * (a + 1)`. A kept comparison or logical value is taken only where a
!       condition already stood (KrChooseBr).
!   S3  `recv.sub(q, x - q + 1)` -> `recv.slice(q, x)`. The same span, said once
!       and without the arithmetic. The `sub` token is retyped to `slice` and `- q + 1` is
!       deleted; nothing else on the line moves.
!       THE GUARD IS THE WHOLE POINT. The two ST methods agree ONLY while q >= 1 AND
!       x >= 1, so BOTH must carry rk:posBound. rk:nonNeg is NOT enough - zero is
!       precisely the broken case, and it is why this cannot be a rule: a rule could only
!       guard with isConst, and isConst proves >= 0. Re-read against StringTheory.Sub and
!       StringTheory.Slice while building this, there are three divergences, and
!       every one of them returns a WRONG ANSWER rather than failing:
!         x = 0  sub yields '' (its length works out <= 0), but Slice reads pEnd = 0 as
!                "to the end" and hands back the WHOLE REST of the string;
!         x < 0  sub yields '', but Slice measures from the end (pEnd = _DataEnd + pEnd);
!         q = 0  sub returns Value[1 : x + 1], because it clamps pStart up to 1 AFTER the
!                CALLER computed the length; slice returns Value[1 : x]. Off by one.
!       Everything else matches, including an over-long end - Sub clamps the length, Slice
!       clamps pEnd, and both land on _DataEnd. So the design's guard stands as ratified.
!       THE SHAPE, and nothing wider: q and the leading term x are each ONE token naming a
!       local that holds rk:posBound; the length argument has exactly ONE top-level '-'
!       and exactly ONE top-level '+'; the middle term is token-for-token equal to q
!       (SpanTokEqual); the trailing term is the literal 1; the sub has exactly one
!       top-level comma. Anything else is refused - under-reach is the correct answer here.
!       NB both facts are also required to be bounded by the receiver the call is made on.
!       That is STRICTER than soundness needs: only `>= 1` is load-bearing, and the
!       _DataEnd half of posBound is never used, because Sub and Slice clamp an over-long
!       end identically. Deliberate - a fact about `st` is the only one this walk is
!       willing to defend for a call written on `st`.
!       This is NOT the shipped rest-of-string RULE (`st.sub(w, st._DataEnd - w + 1)` ->
!       `st.slice(w)`). That one matches the literal text `_DataEnd` and runs in an earlier
!       pass; S3 handles any expression whose RANGE is known. Where both could apply the
!       rule fires first and leaves no `sub` behind, so the two need no coordination.
!   S4  `recv.setValue(recv.sub(1, w - 1) & recv.slice(b))` -> `recv.RemoveFromPosition(w, b - w)`,
!       a span copied around is a span removed - its own banner is at KrTryS4.
!   S5  `recv.setValue(recv.sub(1, w) & X & recv.slice(w + 1))` -> `recv.insert(w + 1, X)`,
!       a span copied around an insertion is an insert - its banner is at KrTryS5.
!   S6  `recv.setValue(recv.sub(1, w) & X)` -> `recv.setLength(w)` then `recv.append(X)`, and its mirror
!       `recv.setValue(X & recv.slice(w + 1))` -> `recv.RemoveFromPosition(1, w)` then `recv.prepend(X)`,
!       two statements on two lines - its banner is at KrS6Shape.
!   S7  `recv.setValue(recv.sub(1, w - 1) & X & recv.slice(b))` -> `recv.RemoveFromPosition(w, b - w)` then
!       `recv.insert(w, X)`, S4 with a middle term, two statements on two lines - its banner is at KrS7Stage.
!   S9  `recv.sub(q, 1)` / `recv.slice(q, q)` -> `recv.valuePtr[q]`, `recv.slice(q, x)` -> `recv.valuePtr[q : x]`,
!       a character or a span read in place, not copied - its banner is at KrTryS9.
!
! DECIDABLE COMPARISONS - and NOTHING else. x holds a fact, recv is its bounding receiver:
!       x < 0          FALSE for zeroBound / posBound / nonNeg
!       x <= -1        FALSE  "
!       x >= 0         TRUE   "
!       x > -1         TRUE   "
!       x + n < 0  /  x + n >= 0  /  x + n <= -1  /  x + n > -1   the same, for a non-negative integer n
!       x = 0, x < 1, x <= 0    FALSE for posBound (or x + n with n >= 1, for any fact)
!       x <> 0, x >= 1, x > 0   TRUE   "
!       x  (the whole condition)  TRUE for posBound;  ~x / NOT x  FALSE for posBound
!       x <= recv._DataEnd      TRUE for zeroBound or posBound on THAT SAME receiver
!       x > recv._DataEnd       FALSE  "
!       x - 1 < recv._DataEnd   TRUE for posBound on THAT SAME receiver
!     and comparisons joined by AND alone or by OR alone at bracket depth 0 (KrEvalCond): AND is
!     FALSE on one FALSE part, OR is TRUE on one TRUE part, both sound under Clarion's early exit.
! Anything else is UNDECIDED and is left alone. That is the entire safety argument: every
! bail above lands in UNDECIDED, and UNDECIDED never edits anything.
!
! DELIBERATE DEVIATION from the design table, flagged for review. The design also
!     lists `x < recv._DataEnd` as TRUE for posBound. It is NOT: posBound means
!     1 <= x <= _DataEnd, so x may EQUAL _DataEnd and the comparison is then FALSE.
!     Implementing it would delete a guard that really can fire, which is a behaviour
!     change - so it is refused here and fixture case BareLessDataEnd pins the refusal.
!     `x - 1 < _DataEnd` (the row above) IS sound: x >= 1 makes x - 1 <= _DataEnd - 1.
!     NB `x - 1 < recv._DataEnd` is also true for zeroBound (x - 1 >= -1), but the design
!     restricts that row to posBound and the fixture (NoZeroTest) expects the refusal, so
!     posBound it is - pure under-reach.
!
! WHAT IT REFUSES (all under-reach - a refusal leaves working code exactly as it was):
!   * a scope with GOTO / COMPILE / OMIT, and a ROUTINE without DATA of its own;
!   * any variable that is not a simple scalar INTEGER local of this scope - a parameter
!     (not a column-1 declaration), a reference, a field, LIKE, OVER, DIM, STATIC, THREAD;
!   * any receiver that is not a simple local StringTheory of this scope - a module-level
!     one could be moved by a call this walk cannot see, and a reference could be re-pointed
!     by `st &= other`, which carries no call for the invalidation scan to catch;
!   * any fact bounded by a receiver that a REFERENCE in the scope is pointed at - `r &= st`,
!     or at what holds it or at a member of it: a write through r moves st without naming it;
!   * any line carrying a ';' - two statements on one line make the order of effects matter,
!     and `if C then A ; B.` puts BOTH statements in the THEN branch;
!   * an impure call that RAN TO COMPLETION before a choose on the same line, or one that
!     sits inside the choose as a sibling argument - argument evaluation order is not
!     specified, so the fact may already be stale. A call that ENCLOSES the choose is fine:
!     its own effect happens after its arguments are computed. S3 applies the same test,
!     for the same reason, to the sub() it is about to rewrite (KrSubCallsOk);
!   * for a sub() with anything but exactly two arguments, a start or a leading term
!     that is not ONE token, a length whose top-level '-'/'+' count is not exactly one
!     each, a middle term that is not token-for-token the start, a trailing term that is
!     not the literal 1, or either operand holding anything but rk:posBound on the
!     receiver the call is made on;
!   * a comment or a '|' continuation anywhere in the text being deleted or re-trivia-ed;
!   * an inline ELSE, a nested opener, or a second THEN inside a candidate one-liner;
!   * a scope whose level-mark walk does not return to the depth it started at. An INLINE
!     '.' terminator is retyped vt:end but may carry NO '-' level mark (the level pass skips
!     inline dots), so the close test is the idiom; if the walk still ends unbalanced the
!     WHOLE scope is rolled back rather than half-transformed.
!
! HIGH-RISK: this builtin DELETES code. The purity list and the decidable table ARE
!     the safety argument - a side-effecting name wrongly added to the list (or via
!     PURE(...)) is a real bug. ON BY DEFAULT: vitrules.txt declares it in a group of its
!     own, `GROUP known-ranges`, so a plain run reaches it; --nogroup=known-ranges leaves it
!     out and --only=KnownRanges runs it alone.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinKnownRanges Procedure(StringTheory pLog)
s           long,auto
raw         StringTheory
pureU       StringTheory               ! ' NAME NAME ... ' - space delimited, UPPER, leading AND trailing space
pureAddU    StringTheory               ! the names a rule file's PURE(...) adds, in the same form - taken at their word
pureOwnU    StringTheory               ! the base list's names this file gives a PROCEDURE of its own (KrPureOwn)
reachU      StringTheory               ! ' NAME ' - receivers ObjReach says this scope can reach unseen (KrReachTest)
reachNo     StringTheory               ! ' NAME ' - receivers it says nothing reaches; both lists start again each scope
noteSt      StringTheory               ! NOTE('...') - LOG text only; it never injects a comment into the source
sbSt        StringTheory               ! donor trivia while applying a kind-2 edit
wsST        StringTheory               ! a VEHICLE for IsAll in KrTriviaClean - its own value is never consulted
changes     long
scRow       long,auto                  ! row in syms.scopes
scKind      byte,auto
sc          long,auto                  ! scopeId of the proc/method being walked
scPar       long,auto                  ! a routine's parent - the method whose class its `self.` names
scSelf      string(vs:maxName)         ! the method's receiver class, captured BEFORE AutoScopePrep clobbers the buffer
codeT       long,auto
mainEnd     long,auto
depth       long                       ! open block frames
edMark      long,auto                  ! records(KrEdQ) when this scope started - refusal rollback point
chgMark     long,auto                  ! `changes` at the same instant - see the rollback
logMark     long,auto                  ! pLog length at the same instant - ditto
scBad       byte                       ! this scope refused: roll its staged edits back
i           long,auto
lineFirst   long,auto                  ! first token of the LOGICAL line being processed
lineLast    long,auto                  ! last token of it ('|' continuations included - they emit no EOL token)
lineEol     long,auto
logLn       long,auto
edLine      long,auto                  ! records(KrEdQ) before S2 ran on this line - see KrLine
viaTxt      string(260)                ! the log's EVIDENCE clause - a summary-driven decision cannot be audited from the changed line alone
! ---- comparison operator texts. chr() sidesteps the doubling rule for '<' entirely.
opLT        string(4)
opLE        string(4)
opGT        string(4)
opGE        string(4)
opNE        string(4)
! ---- token peek (KrGet)
gPos        long,auto
gOk         byte
gCut        byte
gTxt        string(vs:maxName)
gTU         string(vs:maxName)
gTy         string(1)
gLv         string(1)
! ---- fact helpers
fName       string(vs:maxName)         ! KrFind in
fKind       byte                       ! KrFind out
fRecv       string(vs:maxName)         ! KrFind out
fVia        string(vs:maxName)         ! KrFind out - the callee whose SUMMARY made this fact ('' = an ordinary seed)
fGeVar      string(vs:maxName)         ! KrFind out - the local this one is >= ('' = no relational bound)
fClip       string(vs:maxName)         ! KrFind out - the string whose clipped length this local holds ('' = none)
purgeD      long                       ! KrPurge in
alName      string(vs:maxName)         ! KrAliased in - a receiver; alRes = 1 when a reference in this scope is pointed at it
alRes       byte
killNm      string(vs:maxName)         ! KrKillName / KrKillRecv in
addNm       string(vs:maxName)         ! KrAddFact in
addKd       byte
addRc       string(vs:maxName)
addVia      string(vs:maxName)         !
addGe       string(vs:maxName)         !
addCo       string(vs:maxName)         ! the string remembered, if any
! ---- per-line classification (KrLineScan)
lnSemi      byte
lnLevel     byte
lnDo        byte
lnImpure    byte
! ---- narrowing
narName     string(vs:maxName)         ! '' = this line narrows nothing
narBlock    byte                       ! 1 = `if ~x` block form (handed to the frame), 0 = one-liner transfer
pendNm      string(vs:maxName)         ! snapshot handed to KrOpen
lsNm        string(vs:maxName)         ! S11 (KrLoopSeed): the counted LOOP's counter, handed to KrOpen - '' when the
lsKd        byte                       !   header seeds nothing; the fact it holds inside the body, and its receiver
lsRc        string(vs:maxName)         !
pendKd      byte
pendRc      string(vs:maxName)
pendVia     string(vs:maxName)         !
pendGe      string(vs:maxName)         !
pendCo      string(vs:maxName)         !
frmSeq      long                       ! frame counter - tags each snapshot in KrSnapQ
lineSnapLo  long                       ! first frmSeq minted ON the current line: kills on the line reach those snapshots (the condition ran on every path)
lineKillSeq long                       ! the frame snapshot a '/' line re-exposed (ELSIF condition, OF selector): its kills reach that one too
snSeq       long                       ! the frame whose snapshot is being read
snNm        string(vs:maxName)         ! one snapshot row, copied out before KrFind clobbers the buffer
snKd        byte
snRc        string(vs:maxName)
snDp        long
snVi        string(vs:maxName)
snGe        string(vs:maxName)
snCo        string(vs:maxName)
! ---- seed (KrDetectSeed)
seedOk      byte
seedNm      string(vs:maxName)
seedKd      byte
seedRc      string(vs:maxName)
seedVia     string(vs:maxName)         ! the callee whose summary produced this seed ('' = one of the built-in shapes)
seedGe      string(vs:maxName)         ! the START argument of a forward search - a lower bound on the seed
seedCo      string(vs:maxName)         ! the string whose clipped length this seed holds - `v = len(clip(x))`
gaS         long                       ! KrArg2 out - the second argument's span (0 = none)
gaE         long
a2S         long                       ! KrArg2 in - the whole argument list to scan
a2E         long
mth         string(vs:maxName)         ! shared by KrDetectSeed and KrSeedGeArg, so PROCEDURE level
s4Uz        long                       ! S4 - shared by KrTryS4 and KrS4Shape, so PROCEDURE level.
sOpn        long                       !   A ROUTINE's DATA is private to that routine, so these belong
sCls        long                       !   HERE - declared inside KrTryS4 they are invisible to KrS4Shape.
sSub        long
sSlc        long
sAmp        long                       ! the top-level '&' the head ends before - the FIRST, when there are several
sAmp1       long                       ! that first '&', kept while sAmp is moved to the last for the tail (S7)
sAmpN       long                       ! the LAST top-level '&' - the tail starts after it
sW          long
sB          long
sRcv        string(vs:maxName)
wNm         string(vs:maxName)
bNm         string(vs:maxName)
bVia        string(vs:maxName)
wSrc        string(vs:maxName)         ! the two operands AS THE AUTHOR SPELLED THEM. wNm/bNm are
bSrc        string(vs:maxName)         !   upper-cased for matching; emitting those would rewrite p as P.
smNm        string(vs:maxName)         ! SummaryOfCallAt out - the callee's source-case name
smF         byte                       ! SummaryOfCallAt out - the sm:* fact
! ---- condition evaluation (KrEvalCond)
evS         long,auto
evE         long,auto
evRes       byte                       ! 0 = undecided, 1 = TRUE, 2 = FALSE
krHdrSkip   byte                       ! S2-S14 refused: a LOOP/ELSIF/OF header line, or a line S1 removes whole
krExecN     long                       ! EXECUTE frames open around the line
krHdrTok    long,auto                  ! the header keyword token - lineFirst, or past a column-1 label
evOp        string(4)
evOfs       long                       ! 2 when the condition reads `x + n <op> ...` for a non-negative integer n: the shapes shift by two tokens
evN         long                       ! that integer, 0 when there is none
evNeg       byte                       ! that integer was SUBTRACTED
! ---- S1
s1Then      long
s1Dot       long
s1Gone      byte                       ! KrS1Dead staged the removal of the whole line
! ---- S2
c2Tok       long                       ! the CHOOSE token
c2Open      long
c2Close     long
c2C1        long                       ! first top-level comma
c2C2        long                       ! second top-level comma
c2KeepS     long
c2KeepE     long
c2Done      byte
c2CallsOk   byte
c2Res       byte
c2Br        byte                       ! KrChooseBr: 1 = the kept value keeps the choose's brackets, 2 = refused
! ---- S3. Its own vars, not S2's: KrTryS3 runs AFTER KrTryS2 on the same line and
!      must not disturb a decision S2 has already staged.
s3Tok       long                       ! the `sub` method token - retyped to `slice`
s3Open      long                       ! its '('
s3Close     long                       ! its matching ')'
s3Com       long                       ! the ONE top-level comma inside it
s3Recv      string(vs:maxName)         ! the receiver, already through KrRecvOk
s3Q         long                       ! the ONE token of argument 1 (the start)
s3X         long                       ! the ONE token of the leading term of argument 2
s3Min       long                       ! the ONE top-level '-' in argument 2
s3Plus      long                       ! the ONE top-level '+' in it
s3Done      byte
s4Ok        byte                       ! S4 matched and staged this line
s4Why       string(200)                ! why S4 refused a line whose SHAPE matched
s4Refs      long                       ! refusal lines emitted (capped)
s4Two       long                       ! a second top-level '&' was seen
s4DotR      long                       ! this setValue has a dotted receiver
s4DotT      string(vs:maxName)         ! ... spelled thus
s4TlSub     long                       ! the trailing term is sub(b, _DataEnd - b + 1), not slice(b)
s3CallsOk   byte
ccLo        long                       ! the span KrSubCallsOk is protecting: S3 sets it from s3Tok/s3Close,
ccHi        long                       !   S4 from sOpn/sCls. The check is the SAME check; only the span differs.
! ---- S6 (KrS6Shape, from S5's scan): recv.setValue(recv.sub(1, w) & X) -> recv.setLength(w) / recv.append(X), and its mirror
s6Ok        byte                       ! S6 matched and staged this line
s6Why       string(200)                ! why S6 refused a line whose SHAPE matched
mkWhy       string(200)                ! KrMarked: what in the scope may mark the receiver base64 or give it an encoding
krInsSt     StringTheory               ! the new statement a kind-7 edit splices in (KrApplyInsert)
krIndSt     StringTheory               ! ... and the indent it takes from the line it goes in front of
! ---- S9 (KrTryS9): recv.sub(q, 1) / recv.slice(q, q) -> recv.valuePtr[q];  recv.slice(q, x) -> recv.valuePtr[q : x]
s9Tok       long                       ! the `sub` / `slice` method token - retyped to `valuePtr`
s9Open      long                       ! its '(' - retyped to '['
s9Close     long                       ! its matching ')' - retyped to ']'
s9Com       long                       ! the ONE top-level comma inside it
s9Recv      string(vs:maxName)         ! the receiver, already through KrRecvOk
s9Meth      string(5)                  ! SUB or SLICE
s9Done      byte                       ! S9 staged this read
s9CtxOk     byte                       ! the read is not a whole argument of a call that could take it by reference
s9Why       string(200)                ! why S9 refused a read whose SHAPE matched
! ---- S5 (KrTryS5): recv.setValue(recv.sub(1, w) & X & recv.slice(w + 1)) -> recv.insert(w + 1, X)
s5Uz        long                       ! the setValue token
s5Ok        byte                       ! S5 matched and staged this line
s5Amp1      long                       ! the FIRST top-level '&' inside the setValue - the head ends before it
s5AmpN      long                       ! the LAST top-level '&' - the tail starts after it
s5WSrc      string(vs:maxName)         ! w as the author spelled it
s5Cmt       StringTheory               ! comments riding a continuation inside the head or the tail, carried to the line's end
s5Why       string(200)                ! why S5 refused a line whose SHAPE matched
s5Join      byte                       ! 1 = a continuation inside the kept middle term is rejoined too - the joined statement fits the width policy
s5Wid       long                       ! the rewritten statement's width if rejoined, indent included
! ---- call classification (KrCallAt)
caPos       long                       ! the '(' token
caIsCall    byte
caPure      byte
caDot       byte                       ! the callee is a METHOD - a '.' before it
caName      string(vs:maxName)
caTmp       string(vs:maxName)
bcCall      byte
! ---- paren matching (KrMatchParen)
mpOpen      long
mpClose     long
! ---- trivia scan (KrTriviaClean)
tcS         long
tcE         long
tcOk        byte
! ---- symbol eligibility (KrLocalOk / KrRecvOk)
okName      string(vs:maxName)
okRes       byte
okDecl      long
okPos       long
! ---- name splitting (KrSplitRoot)
spIn        string(vs:maxName)
spRoot      string(vs:maxName)
spSuf       string(vs:maxName)
! ---- edit staging
nxPos       long
nxPos2      long
nxKind      byte
nxTxt       string(5 * vs:maxName + 5) ! kinds 3, 5 and 7 - a retyped token, a carried comment, a whole new statement - sized for the widest, four names and the call around them; KrApply ignores it for kinds 1, 2 and 6.
                                       ! THE WIDTH IS THE POINT. The widest thing built here is '(' & w & ', ' & b & ' - ' & w  =  6 + 2*len(w) + len(b) characters, so one
                                       !   name's worth of width cut the TRAILING OPERAND NAME as soon as the total passed it. Clipping an operand cannot substitute: clip()
                                       !   removes padding that sits AFTER the name, so the cut falls in the same place either way. Size it for the worst case, as here.
KrFactQ  QUEUE,PRE(kv)
kvName   string(vs:maxName)
kvKind   byte                          ! rk:*
kvRecv   string(vs:maxName)            ! '' for rk:nonNeg
kvDepth  long                          ! block depth the fact was made at; dies when that block closes
kvVia    string(vs:maxName)            ! the callee whose SUMMARY established it - the log line must name it
kvGeVar  string(vs:maxName)            ! a RELATIONAL lower bound - this local is >= the local NAMED here. '' = none. Seeded by `x = recv.findByte(ch, v)` with a non-zero guard, because FindByte(ch,
                                       !   pStart) searches from address+pStart-1 and so returns 0 or a position AT OR AFTER pStart. Every other fact in this queue bounds a value against a CONSTANT or against
                                       !   the receiver; this is the first to bound one against another VARIABLE, which is exactly what the span-removal rewrite needs and could not be said before.
kvClip   string(vs:maxName)            ! this local holds len(clip(<the string NAMED here>)); '' = none. Cleared by a write to that string,
                                       !   gone with the fact when this local is written. S14 reads `x[1 : v]` for `clip(x)` on it.
       END
KrKillQ  QUEUE,PRE(kk)                 ! names destroyed INSIDE a block, so KrClose can keep them destroyed.
kkFrame  long                          !   the frame it happened in; handed up to the parent when that frame closes
kkName   string(vs:maxName)            !   so an outer ELSE cannot resurrect it either
         END
KrAliasQ QUEUE,PRE(ka)                 ! the names a reference is pointed at in this scope (KrAliasScan): no fact is bounded by one
kaName   string(vs:maxName)
         END
KrFrameQ QUEUE,PRE(kf)
kfDepth  long
kfNar    string(vs:maxName)            ! '' = this frame narrows nothing at its ELSE
kfKind   byte                          ! the snapshot taken AT the IF
kfRecv   string(vs:maxName)
kfVia    string(vs:maxName)            !
kfSeq    long                          ! which snapshot in KrSnapQ belongs to this frame
kfGeVar  string(vs:maxName)            ! the RELATIONAL bound must survive the ELSE narrowing too. Without it, `if ~q ... else` - which is how parser.MaskSigBase is written - restores q as posBound but
                                       !   FORGETS q >= p, and S4 refuses. The one-liner `if ~q then break.` narrowing carried it from the start; the BLOCK form is a different path and was missed.
kfClip   string(vs:maxName)            ! the remembered string survives the ELSE narrowing too
kfExec   byte                          ! the frame is an EXECUTE: each line in it is an ARM
       END
! the fact set AS IT STOOD AT EACH OPEN 'IF'. The ELSE branch did not run the
! THEN branch, so it must not inherit the THEN branch's KILLS either - and a kill deletes a
! row outright, at any depth, so the depth purge cannot undo one. Without this,
!     if ~q
!       st.setLength(p - 1)        <- impure: kills every fact keyed on st, including p's
!     else
!       ... p and q used here       <- p has no fact, though setLength never ran on this path
!     end
! which is exactly how parser.MaskSigBase is written. The comment on the ELSE narrowing has
! always said a kill in the THEN branch 'cannot suppress it' - that was true of the one
! narrowed variable and of nothing else.
KrSnapQ  QUEUE,PRE(sn)
snFrame  long
snName   string(vs:maxName)
snKind   byte
snRecv   string(vs:maxName)
snDepth  long
snVia    string(vs:maxName)
snGeVar  string(vs:maxName)
snClip   string(vs:maxName)
       END
KrEdQ    QUEUE,PRE(kr)
pos      long                          ! kind 1: first token of the delete range.  kind 2/3: the token being changed
pos2     long                          ! kind 1: last token of the delete range.   kind 2: the DONOR token (always BELOW pos)
kind     byte                          ! 1 = DeleteToks, 2 = SetStrBefore copied from pos2, 3 = SetTok text, 5 = carried comments merged in FRONT of the line's own, 6 = strBefore becomes one space (a rejoined continuation)
txt      string(5 * vs:maxName + 5)    ! kind 3 only: the replacement token text. Blank for kinds 1 and 2.
                                       ! SAME SIZE AS nxTxt, AND FOR THE SAME REASON. nxTxt was widened to the worst case its own comment works out - 6 + 2*len(w) + len(b) - after a narrow buffer cut a
                                       !   trailing operand name into emitted source. KrPush then copied it straight into THIS field, which was left at one name's width, so the truncation the widening
                                       !   existed to stop happened one assignment later and in the same place. TrailingSpaces got this right on BOTH sides at once - nxTxt and tseTxt are the same width
                                       !   there. A one-sided fix to a two-sided problem is worth recognising as a shape: whenever a built string is handed on, the receiving field is part of the fix.
       END
  code
  if self.syms &= NULL then return 0.
  self.acScopeId = 0                                            ! the token stream may have moved since the last pass
  free(KrFactQ)                                                 ! local QUEUEs persist between calls - start every pass empty
  free(KrSnapQ)                                                 !
  frmSeq = 0
  s4Refs = 0                                                    !
  free(KrFrameQ)
  free(KrKillQ)
  free(KrEdQ)
  opLT = chr(60)
  opLE = chr(60) & '='
  opGT = chr(62)
  opGE = chr(62) & '='
  opNE = chr(60) & '>'
  self.KnownRangePureList(pureU)                                ! the base list; PURE(...) only ever APPENDS to it
  pureAddU.setValue(' ')                                        ! and what PURE(...) adds is kept apart as well, for KrCallAt
  noteSt.free()
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      case upper(self.rl.rules.bparmQ.name)
      of 'PURE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)              ! parsed exactly like UnusedVars' EXCLUDE(a b c)
          raw.upper()
          pureU.append(clip(raw.getValue()) & ' ')              ! the list already ends in a space
          pureAddU.append(clip(raw.getValue()) & ' ')           ! the author's own word that these only read
        end
      of 'NOTE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.unquote('''','''')
          noteSt.setValue(raw)                                  ! reported once in the log; NEVER written into the source
        end
      end
    end
  end

  self.BuildSummaries()                                         ! what every proc/method in this file RETURNS - seeds a call site below
  if self.syms.scopes &= NULL then return 0.
  do KrPureOwn                                                  ! a runtime name this file also gives a procedure is not taken as pure
  loop scRow = 1 to records(self.syms.scopes)
    get(self.syms.scopes, scRow)
    if errorcode() then break.
    scKind = self.syms.scopes.kind
    sc     = self.syms.scopes.scopeId
    scSelf = self.syms.scopes.selfClass                         ! which class a `self.` call in this scope names
    if scKind <> vs:scProc and scKind <> vs:scMethod and scKind <> vs:scRoutine then cycle. ! module data has no code
    if scKind = vs:scRoutine                                    ! a ROUTINE with DATA of its own is walked for THOSE locals: they are
      scPar = self.syms.scopes.parentId                         !   allocated on every DO and visible nowhere else, so the walk is as
      self.syms.scopes.scopeId = scPar                          !   sound as a procedure's. Its `self.` is its method's class - the
      get(self.syms.scopes, self.syms.scopes.scopeId)           !   routine row carries none, so the PARENT row is read, BY ITS ID: a
      if ~errorcode() then scSelf = self.syms.scopes.selfClass. !   search on parentId found a sibling routine, or this row, never
      get(self.syms.scopes, scRow)                              !   the method. One without DATA has no CODE and bails.
    end
    self.AutoScopePrep(sc)                                      ! NB clobbers the scopes buffer - sc/scKind/scSelf are captured above
    if self.acBail then cycle.                                  ! missing scope / no CODE / GOTO / COMPILE / OMIT present
    codeT   = self.acCodeT
    mainEnd = self.acMainEnd
    if mainEnd <= codeT then cycle.
    do KrScopeWalk
  end

  if records(KrEdQ)
    do KrApply
    self.wantReparse = true                                     ! tokens deleted; later builtins must see the new stream
    if noteSt._DataEnd
      pLog.append('BUILTIN KnownRanges: ' & clip(noteSt.getValue()) & '<13,10>')
    end
    pLog.append('BUILTIN KnownRanges: ' & changes & ' simplification(s) this pass<13,10>')
  end
  free(KrFactQ)
  free(KrSnapQ)                                                 !
  free(KrFrameQ)
  free(KrKillQ)
  free(KrEdQ)
  return changes

! ---- walk ONE proc/method main code, staging its edits; roll them back on any refusal ----
KrScopeWalk routine
  free(KrFactQ)
  free(KrSnapQ)                                                     !
  free(KrFrameQ)
  free(KrKillQ)
  do KrAliasScan                                                    ! the names a reference is pointed at, scope-wide
  depth  = 0
  krExecN = 0
  scBad  = 0
  edMark  = records(KrEdQ)
  chgMark = changes                                                 ! see the rollback below
  logMark = pLog._DataEnd
  i = codeT + 1
  loop
    if i > mainEnd or                                               |
       scBad
      break
    end
    get(self.tk.tokens, i)
    if errorcode() then scBad = 1 ; break.
    if self.tk.tokens.tok &= NULL                                   ! trivia-only tail record
      i += 1
      cycle
    end
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' ! a physical newline
      i += 1
      cycle
    end
    lineFirst = i
    lineEol   = self.FirstEolAfter(lineFirst)                       ! a '|' continuation emits NO EOL token, so this is the LOGICAL line
    if lineEol > lineFirst and lineEol <= mainEnd + 1
      lineLast = lineEol - 1
    else
      lineLast = mainEnd
    end
    do KrLine
    i = lineLast + 1
  end
  ! belt and braces: the walk must come back to the depth it started at. If it does
  ! not, some opener was never closed by a mark we recognise - so every frame boundary below
  ! it was mis-read and the facts we acted on are not the facts that hold. Roll the scope back
  ! rather than half-transform it. Costs nothing on well-formed code, where depth is 0 here.
  if ~scBad and depth then scBad = 1.
  if scBad
    loop while records(KrEdQ) > edMark
      get(KrEdQ, records(KrEdQ))
      if errorcode() then break.
      delete(KrEdQ)
    end
    ! the edits go, so the COUNT and the LOG must go with them. Without this the
    ! report claims simplifications that never happened, and worse: `changes` is this
    ! builtin's return value, so a non-zero count sets wantReparse and the fixpoint
    ! walks the same scope, rolls it back and counts it again on every pass to the cap.
    ! A leaked level mark is enough to reach it (TokenType early-returns for + - * / % ^
    ! and quoted literals without resetting `level`), so this is not a corner.
    changes = chgMark
    if pLog._DataEnd > logMark then pLog.setLength(logMark).
  end

! ---- one LOGICAL line: decide with the facts as they stand, THEN move the facts on ----
KrLine routine
  if krExecN                                  ! INSIDE AN EXECUTE EVERY LINE IS AN ARM AND RUNS ALONE: no fact from
    free(KrFactQ)                             !   one arm holds in the next, and no edit may add or delete a line,
    do KrLevelWalk                            !   which would renumber the arms below it
    do KrLineEffects
    exit
  end
  lineSnapLo  = frmSeq + 1                    ! snapshots minted on THIS line get this line's kills - the
  lineKillSeq = 0                             !   opener's condition runs on every path, so what it kills must die in the ELSE snapshot too (set by KrSnapRestore for the '/'-line twin: an ELSIF condition's kills)
  do KrLineScan                               ! ';' / level marks / DO / an impure call anywhere
  do KrDetectNarrow                           ! `if ~x then break.` (N1) or `if ~x` (N2)
  if ~lnSemi                                  ! two statements on one line: the order of effects matters
    do KrTryS1
    edLine = records(KrEdQ)
    krHdrSkip = s1Gone                        ! a line S1 removes whole takes no other edit: KrApply runs the highest
                                              !   position first, so an edit inside the line would shorten it and the
                                              !   removal, its end fixed when it was staged, would run on into the lines below
    krHdrTok = lineFirst
    get(self.tk.tokens, lineFirst)            ! a column-1 LABEL fronts the header keyword ('P loop while ...') -
    if ~errorcode() and self.tk.tokens.type = vt:label and self.tk.BufColOne()
      krHdrTok = lineFirst + 1                !   judge the keyword, not the label
    end
    case upper(self.tk.GetTok(krHdrTok))
    of 'LOOP' orof 'ELSIF' orof 'OF' orof 'OROF' orof 'UNTIL' orof 'WHILE'
      krHdrSkip = 1                           ! S2-S4 REFUSED on these headers: a LOOP WHILE/UNTIL condition
    end                                       !   re-evaluates every iteration and an ELSIF/OF operand runs under the PREVIOUS branch's facts - but the opener fact-clear (KrLevelWalk) lands only AFTER this
                                              !   line has already staged its edits, one line too late for the header itself: loop while choose(x >= 0, 1, 0) became loop while 1, an infinite loop
    if ~krHdrSkip
      do KrTryS2
    end
    ! S3 runs only when S2 changed NOTHING on this line. A choose() can ENCLOSE a
    ! sub(), and a decided choose deletes the losing value WHOLE - so S2's delete span
    ! could contain S3's, and two overlapping deletes in one KrApply sweep is corruption,
    ! not under-reach. S1 removing the whole line stops everything after it (krHdrSkip
    ! above). S1 keeping the statement removes only `if C then` and the '.', and the only
    ! conditions KrEvalCond decides are five tokens long at most, so a call can never be
    ! inside one.
    if ~krHdrSkip and records(KrEdQ) = edLine
      do KrTryS3
    end
    if ~krHdrSkip and records(KrEdQ) = edLine ! S4 for the same reason S3 waits - one
      do KrTryS4                              !   delete span per line, or KrApply corrupts
    end
    if ~krHdrSkip and records(KrEdQ) = edLine ! S5 likewise
      do KrTryS5
    end
    if ~krHdrSkip and records(KrEdQ) = edLine ! S9 likewise
      do KrTryS9
    end
    if ~krHdrSkip and records(KrEdQ) = edLine ! S14 likewise
      do KrTryS14
    end
  end
  do KrLevelWalk                              ! frames, depth, the ELSE narrowing, the depth purge
  do KrLineEffects                            ! writes, impure kills, the seed, the N1 narrowing

! ---- level marks of this line, in token order ----
KrLevelWalk routine
  data
lw  long,auto
  code
  lw = lineFirst - 1
  loop
    lw += 1
    if lw > lineLast or |
       scBad
      break
    end
    gPos = lw
    do KrGet
    if ~gOk then scBad = 1 ; break.
    if gLv = '+'
      do KrOpen
    elsif gLv = '/'
      do KrElseMark
    elsif gLv = '-' or (gTy = vt:end and gLv <> '+' and gLv <> '/')
      do KrClose        ! the inline-dot idiom: an INLINE '.' is retyped vt:end but may carry NO '-'
    end
  end

! ---- a block opens ----
KrOpen routine
  do KrSnapTake           ! the fact set as it stands NOW, before the branch runs
  depth += 1
  clear(KrFrameQ)
  kf:kfDepth = depth
  kf:kfSeq   = frmSeq     !
  kf:kfNar   = ''
  kf:kfKind  = rk:none
  kf:kfRecv  = ''
  kf:kfVia   = ''
  kf:kfGeVar = ''
  kf:kfClip = ''
  kf:kfExec = choose(gTU = 'EXECUTE')
  if kf:kfExec then krExecN += 1.
  if gTU = 'IF'
    if pendNm             ! `if ~x` - snapshot taken BEFORE the frame opened
      kf:kfNar  = pendNm
      kf:kfKind = pendKd
      kf:kfRecv = pendRc
      kf:kfVia  = pendVia ! the evidence travels with the fact
      kf:kfGeVar = pendGe ! and so does the relational bound
      kf:kfClip = pendCo
    end
  else
    lsNm = ''
    if gTU = 'LOOP'       ! S11: a counted LOOP's own header bounds its counter -
      do KrLoopSeed       !   read here, BEFORE the free below clears the facts
    end
    free(KrFactQ)         ! LOOP and ACCEPT REPEAT: a fact made above the opener is not
  end                     !   valid at the top of the body on iteration 2, and this walk
  add(KrFrameQ)           !   sees the body once. CASE/EXECUTE lose their facts too - under-reach.
  if lsNm                 ! the counter, at the body's depth: it dies with the loop's END
    addNm  = lsNm
    addKd  = lsKd
    addRc  = lsRc
    addVia = ''
    addGe  = ''
    addCo  = ''
    do KrAddFact
  end
  pendNm = ''

! ---- S11: a counted LOOP seeds its own counter. `loop i = 1 to recv._DataEnd` runs i over
!      1.._DataEnd: a limit that is a variable or a simple expression is re-read on every pass
!      (only a function call is evaluated once), so the bound holds even
!      when the body changes the string, and a body statement that moves recv kills the fact as
!      any impure call does. `loop i = recv._DataEnd to 1 by -1` is the same range; any BY that is
!      an integer literal, either sign, keeps i between the two ends. A start (counting up) or a
!      limit (counting down) that is a non-negative integer, or a local already >= 0, gives i >= 0;
!      the literal 1, or a local already 1 or more on recv, against recv._DataEnd gives 1.._DataEnd
!      on recv; 0 or a local >= 0 against recv._DataEnd gives 0.._DataEnd. The local's fact is read
!      HERE, before KrOpen clears the facts for the body. The header must be the whole line: with
!      a ';' on it the second statement runs inside the body. Nothing else - a WHILE, an UNTIL, a
!      bare LOOP, a start or limit of more than one token - seeds anything. ----
KrLoopSeed routine
  data
lz     long,auto
dz     long,auto
lsPos  long,auto
lsTo   long,auto               ! the TO token
lsBy   long,auto               ! the BY token, 0 when none
lsEnd  long,auto               ! the limit's last token
lsDown byte,auto               ! BY a negative literal
lsLo   string(vs:maxName),auto ! the floor - the start counting up, the limit counting down
lsHi   string(vs:maxName),auto ! the ceiling
lsLoT  string(1),auto
lsHiT  string(1),auto
lsLoKd byte,auto               ! what the floor proves: rk:nonNeg for >= 0, rk:posBound for >= 1
lsLoRc string(vs:maxName),auto ! ... and on which receiver, when a local's fact says so
lsCtr  string(vs:maxName)      ! the counter
lsWhy  string(200),auto        ! why a recognised header seeded nothing
lsCz   long,auto               ! the call the counter is a whole argument of
lsCd   long,auto               ! bracket depth on the walk back to it
lsFlr  string(vs:maxName)      ! counting down: the local that is the limit, read again on every pass
lsArg  byte,auto               ! which name the token is: 1 the counter, 2 lsFlr, 3 the receiver, 4 its _DataEnd
  code
  lsNm = ''
  lsKd = rk:none
  lsRc = ''
  lsPos = gPos
  lsWhy = ''
  loop 1 times
    if lnSemi then break.
    gPos = lsPos + 1
    do KrGet
    if ~gOk or gTy <> vt:label then break.
    spIn = gTU
    do KrSplitRoot
    lsCtr = gTU
    if spSuf then lsWhy = 'the counter is a member, not a local' ; break.
    okName = spRoot
    do KrLocalOk
    if ~okRes then lsWhy = 'the counter is not a simple integer local of this scope' ; break.
    lsCtr = okName
    gPos = lsPos + 2
    do KrGet
    if ~gOk or gTxt <> '=' then break.
    lsTo = 0
    lsBy = 0
    dz   = 0
    loop lz = lsPos + 3 to lineLast
      gPos = lz
      do KrGet
      if ~gOk then break.
      if gTxt = '(' then dz += 1.
      if gTxt = ')' then dz -= 1.
      if dz then cycle.
      if gTU = 'TO' and ~lsTo then lsTo = lz.
      if gTU = 'BY' and lsTo and ~lsBy then lsBy = lz.
    end
    if ~lsTo then lsWhy = 'no TO on the line' ; break.
    if lsTo <> lsPos + 4 then lsWhy = 'the start is more than one token' ; break.
    lsEnd = choose(lsBy <> 0, lsBy - 1, lineLast)         ! a COMPARISON: choose(lsBy, ..) would be the indexed form
    if lsEnd <> lsTo + 1 then lsWhy = 'the limit is more than one token' ; break.
    lsDown = 0
    if lsBy                                               ! BY an integer literal, either sign
      gPos = lsBy + 1
      do KrGet
      if ~gOk then break.
      lsWhy = 'the BY step is not an integer literal (' & clip(gTxt) & ' ' & gTy & ')'
      if gTxt = '-'
        if lsBy + 2 <> lineLast then break.
        gPos = lsBy + 2
        do KrGet
        if ~gOk or gTy <> vt:Integer then break.
        lsDown = 1
      elsif gTy <> vt:Integer or lsBy + 1 <> lineLast
        break
      end
      lsWhy = ''
    end
    gPos = lsPos + 3
    do KrGet
    lsLo  = gTU
    lsLoT = gTy
    gPos = lsTo + 1
    do KrGet
    lsHi  = gTU
    lsHiT = gTy
    if lsDown                                             ! counting down, the limit is the floor
      lsLo  = lsHi
      lsLoT = lsHiT
      gPos  = lsPos + 3
      do KrGet
      lsHi  = gTU
      lsHiT = gTy
    end
    ! ---- the floor: >= 0, or >= 1, and on whose behalf
    lsLoKd = rk:none
    lsLoRc = ''
    if lsLoT = vt:Integer                                 ! a negative literal is two tokens and never lands here
      lsLoKd = choose(lsLo = '0', rk:nonNeg, rk:posBound)
    elsif lsLoT = vt:label
      spIn = lsLo
      do KrSplitRoot
      if spSuf then lsWhy = clip(lsLo) & ' is a member read, not a local' ; break.
      fName = spRoot
      do KrFind
      if fKind = rk:none then lsWhy = clip(spRoot) & ' holds no fact here' ; break.
      lsLoKd = choose(fKind = rk:posBound, rk:posBound, rk:nonNeg)
      lsLoRc = fRecv
      if lsDown then lsFlr = fName.
    else
      lsWhy = 'the ' & choose(~lsDown, 'start', 'limit') & ' is neither an integer nor a local'
      break
    end
    ! ---- the ceiling: recv._DataEnd bounds the counter by recv; anything else leaves it >= 0
    lsKd = rk:nonNeg
    if lsHiT = vt:label
      spIn = lsHi
      do KrSplitRoot
      if spSuf = '_DATAEND'
        okName = spRoot
        do KrRecvOk
        if okRes
          if lsLoKd = rk:posBound and (lsLoT = vt:Integer or lsLoRc = spRoot)
            lsKd = rk:posBound
            lsRc = spRoot
          elsif lsLoKd = rk:nonNeg
            lsKd = rk:zeroBound
            lsRc = spRoot
          end
        end
      end
    end
    ! ---- the body runs again: a line that writes the counter, changes the receiver or calls a routine
    !      breaks the fact on the next pass for every line above it, which were decided with it
    !      A CALL MAY WRITE THE COUNTER BY ADDRESS: `Back(i)` with Back(*LONG p) is a write that no `=`
    !      shows. The counter as a whole argument of a call that is not pure is a write unless the
    !      callee's prototype is found here and takes that slot by value (AutoArgIsRefParam).
    !      COUNTING DOWN, THE START IS READ ONCE AND THE LIMIT ON EVERY PASS. `loop i = st._DataEnd to 1
    !      by -1` keeps the length the loop began with, so whatever in the body may shorten st breaks
    !      the ceiling for the lines above it: st handed whole to a call whose body may write it or keep
    !      it (ArgFact), a store to st._DataEnd, a reference bound to it, or the length handed to a call
    !      that may take it by address. A local limit (`to k by -1`) is the floor on every pass, so a
    !      write to k breaks the floor as a write to the counter does. Counting up, the length is the
    !      limit, read again at the top of every pass, and the start is a value already taken.
    get(self.tk.tokens, lsPos)
    lz = self.tk.MatchLevel()
    loop dz = lsEnd + 1 to lz - 1
      get(self.tk.tokens, dz)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      lsLo = upper(self.tk.tokens.tok)
      if lsLo = 'DO' then lsWhy = 'the body calls a routine' ; break.
      if lsLo = lsCtr and self.AutoTokIsWrite(dz) then lsWhy = 'the body writes the counter' ; break.
      lsArg = choose(lsLo = lsCtr)
      if lsDown and ~lsArg
        if lsFlr and lsLo = lsFlr
          lsArg = 2
          if self.AutoTokIsWrite(dz)
            lsWhy = 'the body writes ' & lower(clip(lsFlr)) & ', the limit, which the loop reads on every pass'
            break
          end
        elsif lsRc and lsLo = lsRc and self.tk.GetTok(dz + 1) <> '.'
          lsArg = 3
        elsif lsRc and lsLo = clip(lsRc) & '._DATAEND'
          lsArg = 4
          if self.AutoTokIsWrite(dz) or self.tk.GetTok(dz - 1) = '&='
            lsWhy = 'the body may change ' & lower(clip(lsRc)) & '._DataEnd, which the loop read once, at the start'
            break
          end
        end
      end
      if lsArg
        lsCz = 0
        case self.tk.GetTok(dz - 1)
        of '(' orof ','
          case self.tk.GetTok(dz + 1)
          of ')' orof ','
            lsCd = 0
            loop lsCz = dz - 1 to lsEnd + 1 by -1
              lsLo = self.tk.GetTok(lsCz)
              if lsLo = '<10>' or lsLo = ';' then lsCz = 0 ; break.
              if lsLo = ')' or lsLo = ']' then lsCd += 1 ; cycle.
              if lsLo <> '(' and lsLo <> '[' then cycle.
              if lsCd then lsCd -= 1 ; cycle.
              if lsLo = '[' then lsCz = 0.
              break
            end
          end
        end
        if lsCz > lsEnd
          caPos = lsCz
          do KrCallAt
          if lsArg = 3
            if caIsCall and ~caPure and ~inlist(self.ArgFact(dz, scSelf), 'R', 'P', 'F')
              lsWhy = 'the body hands ' & lower(clip(lsRc)) & ' to ' & lower(caName)
              lsWhy = clip(lsWhy) & ', which may shorten it below the start the loop read once'
              break
            end
          elsif caIsCall and ~caPure and self.AutoArgIsRefParam(dz, 1)
            lsWhy = 'the counter'
            if lsArg = 2 then lsWhy = lower(lsFlr).
            if lsArg = 4 then lsWhy = lower(clip(lsRc)) & '._DataEnd'.
            lsWhy = 'the body hands ' & clip(lsWhy) & ' to ' & lower(clip(caName)) & ', which may change it'
            break
          end
        end
        cycle
      end
      if ~lsRc then cycle.
      if lsLo = lsRc and self.tk.GetTok(dz + 1) = '.'
        lsHi = upper(self.tk.GetTok(dz + 2))
      elsif sub(lsLo, 1, len(clip(lsRc)) + 1) = clip(lsRc) & '.'
        lsHi = sub(lsLo, len(clip(lsRc)) + 2, len(clip(lsLo)))
      else
        cycle
      end
      if lsHi = '_DATAEND' or lsHi = 'VALUEPTR' then cycle.
      if ~pureU.findChars(' ' & clip(lsHi) & ' ') then lsWhy = 'the body changes ' & lower(lsRc) ; break.
    end
    if lsWhy then lsKd = rk:none ; lsRc = '' ; break.
    lsNm = lsCtr
  end
  if lsNm
    if changes < 500
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(lsPos) & ': loop counter ' & clip(lsCtr) & ' is '                                           & |
                  choose(lsKd = rk:posBound, '1..' & clip(lsRc) & '._DataEnd', choose(lsKd = rk:zeroBound, '0..' & clip(lsRc) & '._DataEnd', '0 or more')) & |
                  ' for the body<13,10>')
    end
  elsif lsWhy
    s4Refs += 1
    if s4Refs <= 20
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(lsPos) & ': loop counter ' & clip(lsCtr) & ' NOT seeded - ' & clip(lsWhy) & '<13,10>')
    end
  end
  gPos = lsPos
  do KrGet

! ---- ELSE / ELSIF / OF / OROF: the branch just walked is not on this path ----
KrElseMark routine
  purgeD = depth
  do KrPurge          ! everything the previous branch established
  do KrSnapRestore    ! ... and everything it KILLED comes back
  if ~records(KrFrameQ) then exit.
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then exit.
  if kf:kfDepth <> depth then exit.
  if ~kf:kfNar then exit.
  if kf:kfKind <> rk:zeroBound and kf:kfKind <> rk:nonNeg then exit.
  ! `if ~x` ... ELSE (or ELSIF - reached only when ~x was false too): x is non-zero here.
  ! A nonNeg fact narrows to posBound with NO receiver: x >= 1 and nothing above it.
  ! Restored from the AT-THE-IF snapshot, so a kill inside the THEN branch - which never ran
  ! on this path - cannot suppress it.
  addNm  = kf:kfNar
  addKd  = rk:posBound
  addRc  = kf:kfRecv
  addVia = kf:kfVia   !
  addGe  = kf:kfGeVar !
  addCo  = kf:kfClip
  do KrAddFact

! ---- END / '.' ----
KrClose routine
  purgeD = depth
  do KrPurge
  do KrKillsOut                                ! what ANY branch destroyed stays destroyed - see below
  do KrSnapDrop                                ! this frame's snapshot dies with the frame
  if ~records(KrFrameQ) then scBad = 1 ; exit. ! level underflow - do not trust the walk
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then scBad = 1 ; exit.
  if kf:kfExec then krExecN -= 1.
  delete(KrFrameQ)
  depth -= 1
  if depth < 0 then scBad = 1.

! ---- A FACT DESTROYED BY *ANY* BRANCH MUST NOT WALK OUT OF THE BLOCK. ----
!      The ELSE restore is right and stays: the else branch never ran the then branch, so
!      inside the else the old fact really does still hold, and KrSnapKill's header says
!      deliberately that a kill deep in a branch must not reach the snapshot.
!
!      WHAT WAS WRONG IS WHAT HAPPENED AFTER THE END. KrSnapRestore puts each row back
!      carrying its ORIGINAL depth, so a fact learned before the IF comes back at a depth
!      shallower than the block - and KrPurge, which only deletes depth >= this one, cannot
!      touch it. The fact walked out of the END into code that runs on EITHER path.
!      MEASURED: `p` seeded and narrowed, killed by `p = -9` in a then branch, restored at
!      the else, and `if p >= 0 then y = 2.` below the END came back as a bare `y = 2` -
!      the guard deleted while p was -9 on one of the two paths.
!
!      After an IF you only know what was true on EVERY path, so every name killed anywhere
!      inside the block is dropped here regardless of the depth it was learned at.
!
!      THE RE-TAG IS THE PART THAT IS EASY TO MISS. A kill inside a NESTED block has to go
!      on mattering to the blocks around it: the inner END drops it, but an outer ELSE
!      restores from an outer snapshot the kill never reached, so the outer END has to drop
!      it again. Handing the rows up to the parent frame does that at every level; at the
!      outermost frame there is no parent and they are simply discarded.
!
!      A KILL TAKES THE REMEMBERED HALF OF A FACT TOO, as KrKillName does at the write: a row that
!      remembers the killed name - `v = len(clip(x))` remembers x in kvClip, a findByte bound
!      names a local in kvGeVar - keeps its own bound, which is still true, and loses the part that
!      is true on one path only. Otherwise the ELSE would restore `v holds len(clip(x))`, the END would
!      let it walk out though x was written in the THEN branch, and S14 would read a stale x[1 : v].
KrKillsOut routine
  data
oz   long,auto
oy   long,auto
oSeq long,auto
oPar long,auto
  code
  if ~records(KrKillQ) then exit.
  oSeq = 0
  oPar = 0
  if records(KrFrameQ)
    get(KrFrameQ, records(KrFrameQ))
    if ~errorcode() then oSeq = kf:kfSeq.
    if records(KrFrameQ) > 1
      get(KrFrameQ, records(KrFrameQ) - 1)
      if ~errorcode() then oPar = kf:kfSeq.
    end
  end
  if ~oSeq then exit.
  loop oz = records(KrKillQ) to 1 by -1
    get(KrKillQ, oz)
    if errorcode() then cycle.
    if kk:kkFrame <> oSeq then cycle.
    loop oy = records(KrFactQ) to 1 by -1
      get(KrFactQ, oy)
      if errorcode() then cycle.
      if kv:kvName = kk:kkName or kv:kvRecv = kk:kkName
        delete(KrFactQ)
      elsif kv:kvGeVar = kk:kkName or kv:kvClip = kk:kkName
        if kv:kvGeVar = kk:kkName then kv:kvGeVar = ''.
        if kv:kvClip = kk:kkName then kv:kvClip = ''.
        put(KrFactQ)
      end
    end
    get(KrKillQ, oz)
    if errorcode() then cycle.
    if oPar
      kk:kkFrame = oPar ! hand it up - an outer ELSE can resurrect it too
      put(KrKillQ)
    else
      delete(KrKillQ)   ! outermost frame: nothing left to protect
    end
  end

! ---- the SHAPE did not match, on a setValue whose argument IS a concatenation.
!      Only logged once we know there is a top-level '&' - otherwise every plain setValue in
!      the file would report. Unconditional silence covers three different things: a correct
!      refusal, a missing arm, and never having looked. Only the first should be silent. ----
KrS4Miss routine
  do KrS4Refuse

! ---- S4 matched the SHAPE but a guard said no. Say so - a silent refusal is
!      indistinguishable from the pattern never matching. Capped like every other detail line. ----
KrS4Refuse routine
  s4Refs += 1
  if s4Refs > 20 then exit.
  pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(s4Uz) & ': span-removal REFUSED on ' & |
              clip(sRcv) & '.setValue(...) - ' & clip(s4Why) & '<13,10>')

! ---- copy the live fact set aside, tagged with a fresh frame number ----
KrSnapTake routine
  data
tz1  long,auto
  code
  frmSeq += 1
  loop tz1 = 1 to records(KrFactQ)
    get(KrFactQ, tz1)
    if errorcode() then cycle.
    clear(KrSnapQ)
    sn:snFrame = frmSeq
    sn:snName  = kv:kvName
    sn:snKind  = kv:kvKind
    sn:snRecv  = kv:kvRecv
    sn:snDepth = kv:kvDepth
    sn:snVia   = kv:kvVia
    sn:snGeVar = kv:kvGeVar
    sn:snClip = kv:kvClip
    add(KrSnapQ)
  end

! ---- at the ELSE, put back anything the THEN branch KILLED. The purge just above
!      has already dropped what that branch CREATED, so a snapshot row with no live fact of
!      the same name is one the branch deleted - and it never ran on this path. A row that
!      IS still live is left alone rather than duplicated. ----
KrSnapRestore routine
  data
tz2  long,auto
  code
  if ~records(KrFrameQ) then exit.
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then exit.
  if kf:kfDepth <> depth then exit.
  snSeq = kf:kfSeq
  lineKillSeq = snSeq ! this '/' line's own effects (an ELSIF condition's impure call, an OF selector) run on every LATER path too, so KrLineEffects' kills must reach this frame's snapshot
  ! rebuild the fact set WHOLESALE from the snapshot. Restoring only
  ! rows whose name has no live fact is wrong whenever a name carries MORE THAN ONE
  ! row - and the interesting ones always do:
  !     p = st.findByte(61)      seeds p as zeroBound
  !     if ~p then break.        appends p as posBound
  ! KrFind scans backwards so posBound wins while both are live. After a kill removed both,
  ! the by-name restore put back the zeroBound seed, then found p 'live' and skipped the
  ! posBound - restoring the WEAKEST fact and dropping the one that mattered. The refusal
  ! line said 'P holds zeroBound' and that is exactly what it was seeing.
  free(KrFactQ)
  loop tz2 = 1 to records(KrSnapQ)
    get(KrSnapQ, tz2)
    if errorcode() then cycle.
    if sn:snFrame <> snSeq then cycle.
    snNm = sn:snName
    snKd = sn:snKind
    snRc = sn:snRecv
    snDp = sn:snDepth
    snVi = sn:snVia
    snGe = sn:snGeVar
    snCo = sn:snClip
    clear(KrFactQ)
    kv:kvName  = snNm
    kv:kvKind  = snKd
    kv:kvRecv  = snRc
    kv:kvDepth = snDp
    kv:kvVia   = snVi
    kv:kvGeVar = snGe
    kv:kvClip = snCo
    add(KrFactQ)
  end

! ---- the frame is closing, so its snapshot is dead ----
KrSnapDrop routine
  data
tz3  long,auto
  code
  if ~records(KrFrameQ) then exit.
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then exit.
  snSeq = kf:kfSeq
  loop tz3 = records(KrSnapQ) to 1 by -1
    get(KrSnapQ, tz3)
    if errorcode() then cycle.
    if sn:snFrame = snSeq then delete(KrSnapQ).
  end

! ---- drop every fact made at purgeD or deeper ----
KrPurge routine
  data
pz  long,auto
  code
  loop pz = records(KrFactQ) to 1 by -1
    get(KrFactQ, pz)
    if errorcode() then cycle.
    if kv:kvDepth >= purgeD then delete(KrFactQ).
  end

! ---- drop every fact ABOUT killNm - and the RELATIONAL half of any fact that NAMES it.
!      q's `>= P` is meaningless once P is rewritten, but q's own lower bound still
!      holds, so the geVar is blanked rather than the row deleted. S4 is the only
!      geVar consumer and a blank geVar refuses there ("it is >= nothing"). Without
!      this sweep the stale `ge P` survived P's reassignment and S4 rewrote to a
!      RemoveFromPosition that is a DIFFERENT PROGRAM once the new P is past q
!      (the S4 header's own proof: duplicate-vs-clamp). ----
KrKillName routine
  data
kz  long,auto
  code
  if ~killNm then exit.
  loop kz = records(KrFactQ) to 1 by -1
    get(KrFactQ, kz)
    if errorcode() then cycle.
    if kv:kvName = killNm
      delete(KrFactQ)
    elsif kv:kvGeVar = killNm
      kv:kvGeVar = ''
      put(KrFactQ)
    elsif kv:kvClip = killNm
      kv:kvClip = ''
      put(KrFactQ)
    end
  end
  do KrSnapKill
  do KrKillRecord ! and the block this happened in must remember it

! ---- a fact about a member of SELF - `self.buf` - holds only while nothing can change the object. A call
!      on this line that may change things - one KrLineScan found impure, or a procedure called by its
!      name alone, which BareCallAt answers - can reach it without naming it, so every such fact goes,
!      and every clip or bound that names a member. Each member is killed by its own name, so the block
!      records it and its ELSE and END keep it dead. Ruled 30 Oct 2026.
KrKillSelf routine
  data
rz  long,auto
bz  byte,auto
sx  StringTheory
  code
  loop rz = 1 to records(KrFactQ)
    get(KrFactQ, rz)
    if errorcode() then cycle.
    if kv:kvRecv[1 : 5] = 'SELF.' then sx.append(' ' & clip(kv:kvRecv)).
    if kv:kvName[1 : 5] = 'SELF.' then sx.append(' ' & clip(kv:kvName)).
    if kv:kvClip[1 : 5] = 'SELF.' then sx.append(' ' & clip(kv:kvClip)).
    if kv:kvGeVar[1 : 5] = 'SELF.' then sx.append(' ' & clip(kv:kvGeVar)).
  end
  if ~sx._DataEnd then exit.
  bz = lnImpure
  loop rz = lineFirst to lineLast
    if bz then break.
    gPos = rz
    do KrGet
    if gOk and gTy = vt:label and self.BareCallAt(rz) then bz = 1.
  end
  if ~bz then exit.
  sx.split(' ')
  loop rz = 1 to sx.records()
    killNm = sx.getLine(rz)
    if ~killNm then cycle.
    do KrKillName
    do KrKillRecv
  end

! ---- remember, for the enclosing block, that this name was destroyed inside it ----
!      KrKillsOut at the END is what uses these. Recorded here rather than at the write site
!      because this is the ONE place a fact dies by name, and a rule with two homes is how
!      two of them drift apart.
KrKillRecord routine
  data
kr  long,auto
  code
  if ~records(KrFrameQ) then exit.      ! not inside a block - nothing can resurrect it
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then exit.
  loop kr = records(KrKillQ) to 1 by -1 ! already recorded for this frame? nothing to add
    get(KrKillQ, kr)
    if errorcode() then cycle.
    if kk:kkFrame = kf:kfSeq and kk:kkName = killNm then exit.
  end
  get(KrFrameQ, records(KrFrameQ))
  if errorcode() then exit.
  clear(KrKillQ)
  kk:kkFrame = kf:kfSeq
  kk:kkName  = killNm
  add(KrKillQ)

! ---- THE KILL AND THE SEED HAVE TO AGREE ABOUT WHAT A DOTTED NAME IS. ----
!      KrDetectSeed records the WHOLE token - `SELF.BUF` - as the fact's name or receiver.
!      Every kill above splits the token first and offers only the ROOT, `SELF`, so on a
!      dotted receiver the two spellings never met and a mutation of `self.buf` left every
!      fact it should have invalidated standing. Measured: with `self.buf.Replace(...)`
!      between the seeds and the use, the dotted probe still converted while its bare twin
!      correctly refused. The root kill STAYS - a write through `self.buf` may well stale a
!      fact about `self` - and the whole token is offered as well, to both kills. More
!      killing means fewer facts, which means fewer conversions: the safe direction, and
!      the only one available while the two halves disagree.
!      Nothing to do when the token has no suffix: root and whole token are then the same
!      string and KrKillName/KrKillRecv have already been asked it.
KrKillWhole routine
  if ~spSuf then exit.
  killNm = spIn
  do KrKillName
  do KrKillRecv

! ---- drop every fact BOUNDED BY killNm ----
KrKillRecv routine
  data
rz  long,auto
nk  long,auto
  code
  if ~killNm then exit.
  nk = len(clip(killNm))                                ! A MEMBER IS PART OF ITS OBJECT: `self.Shrink()` names
  loop rz = records(KrFactQ) to 1 by -1
    get(KrFactQ, rz)
    if errorcode() then cycle.
    if kv:kvRecv = killNm then delete(KrFactQ) ; cycle. !   SELF, never SELF.BUF, and still changes it
    if len(clip(kv:kvRecv)) > nk + 1 and kv:kvRecv[1 : nk + 1] = killNm[1 : nk] & '.' then delete(KrFactQ).
  end
  do KrSnapKillRecv

! ---- a kill on the line that MINTED a snapshot (a '+' opener's own condition) or on
!      a '/' line that re-exposed one (ELSIF condition, OF selector) must reach that
!      snapshot too: the killed effect ran on EVERY path, so the ELSE restore must not
!      resurrect it. Kills from lines deeper in a branch leave snapshots alone - those
!      effects belong to one branch only, and restoring them at ELSE is the point of
!      the snapshot. Both routines are called ONLY from KrLineEffects, so lineSnapLo /
!      lineKillSeq are always current. ----
KrSnapKill routine
  data
sz  long,auto
  code
  if ~records(KrSnapQ) then exit.
  loop sz = records(KrSnapQ) to 1 by -1
    get(KrSnapQ, sz)
    if errorcode() then cycle.
    if sn:snFrame < lineSnapLo and (~lineKillSeq or sn:snFrame <> lineKillSeq) then cycle.
    if sn:snName = killNm
      delete(KrSnapQ)
    elsif sn:snGeVar = killNm
      sn:snGeVar = ''
      put(KrSnapQ)
    elsif sn:snClip = killNm
      sn:snClip = ''
      put(KrSnapQ)
    end
  end

KrSnapKillRecv routine
  data
sr  long,auto
nk  long,auto
  code
  if ~records(KrSnapQ) then exit.
  nk = len(clip(killNm))
  loop sr = records(KrSnapQ) to 1 by -1
    get(KrSnapQ, sr)
    if errorcode() then cycle.
    if sn:snFrame < lineSnapLo and (~lineKillSeq or sn:snFrame <> lineKillSeq) then cycle.
    if sn:snRecv = killNm then delete(KrSnapQ) ; cycle.
    if nk and len(clip(sn:snRecv)) > nk + 1 and sn:snRecv[1 : nk + 1] = killNm[1 : nk] & '.' then delete(KrSnapQ). ! and its members
  end

! ---- innermost live fact for fName (rows are appended, so scan BACKWARDS) ----
KrFind routine
  data
fz  long,auto
  code
  fKind = rk:none
  fRecv = ''
  fVia  = ''
  fGeVar = ''             !
  fClip = ''
  if ~fName then exit.
  loop fz = records(KrFactQ) to 1 by -1
    get(KrFactQ, fz)
    if errorcode() then cycle.
    if kv:kvName = fName
      fKind = kv:kvKind
      fRecv = kv:kvRecv
      fVia  = kv:kvVia    !
      fGeVar = kv:kvGeVar !
      fClip = kv:kvClip
      break
    end
  end

! ---- is alName a receiver a reference in this scope is pointed at? `r &= st` makes r a second spelling
!      of st, and a write through r moves st's _DataEnd without naming st, so no kill in the walk would
!      reach a fact bounded by st. A reference to what HOLDS the receiver (`r &= self` for self.buf) or to
!      a MEMBER of it (`r &= st.x` for st) counts the same way. ----
KrAliased routine
  data
qz   long,auto
aN   long,auto
nN   long,auto
  code
  alRes = 0
  if ~alName then exit.
  nN = len(clip(alName))
  loop qz = 1 to records(KrAliasQ)
    get(KrAliasQ, qz)
    if errorcode() then break.
    if ka:kaName = alName then alRes = 1 ; exit.
    aN = len(clip(ka:kaName))
    if nN > aN and alName[1 : aN + 1] = ka:kaName[1 : aN] & '.' then alRes = 1 ; exit.
    if aN > nN and ka:kaName[1 : nN + 1] = alName[1 : nN] & '.' then alRes = 1 ; exit.
  end

! ---- the names a reference is pointed at anywhere in this scope, routines included - they share the
!      locals. Read once per scope, before the walk. KrReachTest's answers start again here too. ----
KrAliasScan routine
  data
az   long,auto
aEnd long,auto
  code
  free(KrAliasQ)
  reachU.setValue(' ')
  reachNo.setValue(' ')
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then exit.
  aEnd = self.syms.scopes.endTok
  loop az = codeT + 1 to aEnd
    gPos = az
    do KrGet
    if ~gOk or gTxt <> '&=' then cycle.
    gPos = az + 1
    do KrGet
    if ~gOk or gTy <> vt:label then cycle.
    clear(KrAliasQ)
    ka:kaName = gTU
    add(KrAliasQ)
  end

! ---- record a fact at the CURRENT depth (dataless routine -> no CODE section) ----
KrAddFact routine
  if addRc            ! bounded by a receiver: refused when a reference is pointed at it
    alName = addRc
    do KrAliased
    if alRes then exit.
  end
  clear(KrFactQ)
  kv:kvName  = addNm
  kv:kvKind  = addKd
  kv:kvRecv  = addRc
  kv:kvDepth = depth
  kv:kvVia   = addVia !
  kv:kvGeVar = addGe  !
  kv:kvClip = addCo
  add(KrFactQ)

! ---- one token into gTxt / gTU / gTy / gLv ----
KrGet routine
  gOk  = 0
  gCut = 0
  gTxt = ''
  gTU  = ''
  gTy  = ' '
  gLv  = ' '
  if gPos < 1 then exit.
  get(self.tk.tokens, gPos)
  if errorcode() then exit.
  gTy = self.tk.tokens.type
  gLv = self.tk.tokens.level
  if not self.tk.tokens.tok &= NULL
    gCut = choose(size(self.tk.tokens.tok) > size(gTxt)) ! the token does NOT FIT gTxt, a fixed STRING: it arrives CUT to its first 255 characters. A cut NAME or
    if gCut and gTy <> vt:literal then exit.             !   NUMBER is refused as before (gOk stays 0, 'cannot see it'). A cut LITERAL is let through, because every
    gTxt = self.tk.tokens.tok                            !   keyword / operator compare is right on the cut copy, and the walk no longer goes blind on a whole body
    gTU  = upper(self.tk.tokens.tok)                     !   for one long message. The readers of a literal's TEXT (TsLitOk, TsLitSpaceless, the instring seed)
                                                         !   ask gCut first and refuse, so a cut copy is never scanned and never copied into emitted source
  end
  gOk = 1

! ---- split spIn at its FIRST '.' -> spRoot / spSuf (a bare name gives spSuf = '') ----
KrSplitRoot routine
  data
dz  long,auto
nz  long,auto
  code
  spRoot = spIn
  spSuf  = ''
  nz = len(clip(spIn))
  if ~nz then spRoot = '' ; exit.
  dz = pLog.findByte(46, 1,, spIn) ! <dot>
  if dz > 1 and dz < nz
    spRoot = spIn[1 : dz - 1]
    spSuf  = spIn[dz + 1 : nz]
  elsif dz
    spRoot = ''                    ! a leading or trailing dot - not a name we model
  end

! ---- is the '(' at caPos a CALL, and is that call on the pure list? ----
KrCallAt routine
  data
cz  long,auto
cn  long,auto
cd  long,auto
  code
  caIsCall = 0
  caPure   = 0
  caName   = ''
  if caPos < 2 then exit.
  get(self.tk.tokens, caPos - 1)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if self.tk.tokens.type <> vt:label and self.tk.tokens.type <> vt:reservedWord then exit. ! '(' after an operator/comma/'(' = grouping
  caName = upper(self.tk.tokens.tok)
  if self.tk.tokens.type = vt:reservedWord and caName <> 'CHOOSE' then exit. ! `not(`, `if(` ... not calls
  ! defensive: the tokenizer does NOT merge a dotted name in front of a '(', so this is
  ! already the bare method name - take the tail after the last dot anyway.
  cn = len(clip(caName))
  cd = 0
  loop cz = 1 to cn
    if caName[cz] = '.' then cd = cz.
  end
  if cd >= cn then exit.
  if cd
    caTmp  = caName[cd + 1 : cn]
    caName = caTmp
  end
  caIsCall = 1
  ! A NAME IS NOT PURE ON ITS OWN - IT DEPENDS WHOSE IT IS. Clarion's CLIP(x) returns a
  ! trimmed copy and touches nothing. StringTheory's c.Clip() SHRINKS THE BUFFER. This looks
  ! up the tail after the last dot, so both arrive here as CLIP and the method read as pure -
  ! and KnownRanges then kept a fact about a receiver that had just been shortened.
  ! THE DOT IS A SEPARATE TOKEN: the tokenizer does NOT merge a dotted name in front of a '(',
  ! so `cd` above is always 0 and the loop that computes it does nothing. The dot is at
  ! caPos - 2, which is the test the DeadGuard arm uses too. A method StringTheory does not
  ! have - obj.Format(x), obj.Size() - is its own class's, and never pure: see PureMethod.
  caDot = 0
  if caPos > 2
    get(self.tk.tokens, caPos - 2)
    if ~errorcode() and not self.tk.tokens.tok &= NULL
      if self.tk.tokens.tok = '.' then caDot = 1.
    end
    get(self.tk.tokens, caPos - 1)                                           ! restore the callee row
  end
  if caDot and caName = 'CLIP'
    caPure = 0                                                               ! a dotted CLIP is the mutating one
  elsif (caDot or cd) and ~self.PureMethod(caName, pureU)
    caPure = 0
  elsif pureU.findChars(' ' & clip(caName) & ' ')
    caPure = 1
  end
  ! *** AND A METHOD IS PURE ONLY ON A STRINGTHEORY. *** The list names StringTheory's readers;
  ! GetLine, Length or FindChar on a class of the author's own may move a position or write an
  ! argument by address. So a dotted call counts as pure only when the receiver in front of the
  ! dot resolves to a StringTheory.
  if caDot and caPure
    if self.HayType(self.tk.GetTok(caPos - 3), caPos - 3) <> 'STRINGTHEORY' then caPure = 0.
  end
  ! AND A CALL WITH NO OBJECT IN FRONT OF IT IS PURE ONLY WHEN IT IS THE RUNTIME'S OWN FUNCTION.
  ! Written as a plain call, a name on the list that is a StringTheory method - GetLine, FindByte,
  ! Equals and the rest - can only be a procedure of the author's own, which may write an argument
  ! by address; and a runtime name that this file also gives a procedure (pureOwnU) may call that
  ! procedure instead. A name a rule file's PURE(...) adds is taken at its word.
  if caPure and ~caDot and ~cd and ~pureAddU.findChars(' ' & clip(caName) & ' ')
    if caName <> 'CHOOSE' and ~self.IsRuntimeBuiltin(caName) then caPure = 0.
    if pureOwnU.findChars(' ' & clip(caName) & ' ') then caPure = 0.
  end

! ---- matching ')' for the '(' at mpOpen, within this logical line (0 = none) ----
KrMatchParen routine
  data
mz  long,auto
md  long,auto
  code
  mpClose = 0
  md      = 0
  loop mz = mpOpen to lineLast
    gPos = mz
    do KrGet
    if ~gOk then exit.
    case gTxt
    of '('
      md += 1
    of ')'
      md -= 1
      if ~md then mpClose = mz ; exit.
      if md < 0 then exit.
    end
  end

! ---- every strBefore in [tcS..tcE] is plain whitespace (no comment, no bar, no line break) ----
KrTriviaClean routine
  data
qz  long,auto
  code
  tcOk = 0
  loop qz = tcS to tcE
    get(self.tk.tokens, qz)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if ~wsST.IsAll('<32,9>', self.tk.tokens.strBefore, false) then exit. ! '!' comment, '|' continuation or a CR/LF
    ! ISALL SAYS THIS IN ONE LINE, and a library test is harder to get subtly wrong than a
    !   hand-rolled character walk.
    !   THE THIRD ARGUMENT IS pClip, NOT A CASE FLAG, and false is load-bearing: it measures the
    !   alphabet with size() rather than clipLen(). It changes nothing for '<32,9>', whose last
    !   byte is a tab - but write the alphabet '<9,32>' and the default would clip the space
    !   straight out of it, and no plain-space gap would ever pass again. The same argument is
    !   written out at the label-merge site in vitTokenize, which is where this spelling comes
    !   from.
    !   IsAll reads a ZERO-LENGTH pTestString as "not supplied" and answers from the RECEIVER's
    !   own value instead. It cannot be reached with one here: a NULL strBefore is cycled above,
    !   and a non-NULL one was allocated with a size of at least 1. wsST is a vehicle for the
    !   method and its own value is never consulted.
  end
  tcOk = 1

! ---- classify the line before anything is decided on it ----
KrLineScan routine
  data
zz  long,auto
  code
  lnSemi   = 0
  lnLevel  = 0
  lnDo     = 0
  lnImpure = 0
  loop zz = lineFirst to lineLast
    gPos = zz
    do KrGet
    if ~gOk then cycle.
    if gLv = '+' or gLv = '/' or gLv = '-' or |
       gTy = vt:end
      lnLevel = 1
    end
    if gTxt = ';' then lnSemi = 1.
    if gTy = vt:reservedWord and gTU = 'DO' then lnDo = 1.
    if gTxt = '('
      caPos = zz
      do KrCallAt
      if caIsCall and ~caPure then lnImpure = 1.
    end
  end

! ---- `if ~x then break.` (N1) or `if ~x` (N2); sets narName / narBlock / pend* ----
KrDetectNarrow routine
  narName  = ''
  narBlock = 0
  pendNm   = ''
  pendKd   = rk:none
  pendRc   = ''
  pendVia  = ''
  pendGe   = ''
  pendCo   = ''
  gPos = lineFirst
  do KrGet
  if ~gOk                   or                                               |
     gTy <> vt:reservedWord or                                               |
     gTU <> 'IF'            or                                               |
     gLv <> '+'             or                                               |
     lineLast < lineFirst + 2
    exit
  end
  gPos = lineFirst + 1
  do KrGet
  if ~gOk or                                                                 |
     gTxt <> '~'                                                             ! only the bare `~x` test removes the zero
    exit
  end
  gPos = lineFirst + 2
  do KrGet
  if ~gOk or                                                                 |
     gTy <> vt:label
    exit
  end
  fName = gTU
  do KrFind
  if fKind <> rk:zeroBound and fKind <> rk:nonNeg then exit.                 ! nothing to narrow: a zeroBound becomes posBound on its receiver; a nonNeg becomes posBound with NO receiver - x >= 1, no upper bound
  if lineFirst + 2 = lineLast
    narName  = fName                                                         ! N2: block form - the ELSE branch knows x is non-zero
    narBlock = 1
    pendNm   = fName
    pendKd   = fKind
    pendRc   = fRecv
    pendVia  = fVia                                                          !
    pendGe   = fGeVar                                                        !
    pendCo   = fClip
    exit
  end
  if lineFirst + 5 > lineLast then exit.                                     ! N1 is  if ~ x then KEYWORD .  - and RETURN may carry a value
  gPos = lineFirst + 3
  do KrGet
  if ~gOk or                                                                 |
     gTU <> 'THEN'
    exit
  end
  gPos = lineFirst + 4
  do KrGet
  if ~gOk                   or                                               |
     gTy <> vt:reservedWord or                                               |
     gTU <> 'BREAK' and gTU <> 'RETURN' and gTU <> 'CYCLE' and gTU <> 'EXIT' ! an UNCONDITIONAL transfer, so falling through means x is non-zero
    exit
  end
  if gTU <> 'RETURN' and lineFirst + 5 <> lineLast then exit.                ! only RETURN takes anything after it - its value, any shape
  gPos = lineLast
  do KrGet
  if ~gOk or                                                                 |
     gTy <> vt:end
    exit
  end
  narName = fName

! ---- does this line SEED a fact?  Plain `V = <one reader call>` lines only ----
KrDetectSeed routine
  data
rs   long,auto
re   long,auto
  code
  seedOk  = 0
  seedNm  = ''
  seedKd  = rk:none
  seedRc  = ''
  seedVia = ''
  seedGe  = ''                                                         !
  seedCo  = ''
  if lnLevel or lnSemi or                                              |   ! a conditional write cannot credit the code below the block
     lineLast < lineFirst + 2
    exit
  end
  gPos = lineFirst
  do KrGet
  if ~gOk or                                                           |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.                                                  ! a.b = ... is a member write, not our local
  seedNm = spRoot
  gPos = lineFirst + 1
  do KrGet
  if ~gOk or                                                           |
     gTxt <> '='
    exit
  end
  okName = seedNm
  do KrLocalOk
  if ~okRes then exit.
  rs = lineFirst + 2
  re = lineLast
  ! ---- (a) a bare property read:  n = st._DataEnd
  if rs = re
    gPos = rs
    do KrGet
    if ~gOk or                                                         |
       gTy <> vt:label
      exit
    end
    spIn = gTU
    do KrSplitRoot
    if spSuf <> '_DATAEND' then exit.
    okName = spRoot
    do KrRecvOk
    if ~okRes then exit.
    seedOk = 1
    seedKd = rk:nonNeg                                                 ! _DataEnd is >= 0; it is not bounded BY anything
    exit
  end
  gPos = re
  do KrGet
  if ~gOk or                                                           |
     gTxt <> ')'                                                       ! the RHS must be exactly ONE call, closing on the last token
    exit
  end
  ! ---- (b) a method call:  x = <recv>.<method>( ... )
  gPos = rs
  do KrGet
  if ~gOk then exit.
  if gTy = vt:label and re >= rs + 3
    gPos = rs + 1
    do KrGet
    if gOk and gTxt = '.'
      gPos = rs
      do KrGet
      spIn = gTU
      do KrSplitRoot
      ! a DOTTED receiver seeds a fact like any other: the span-removal matcher accepts
      ! self.buf, and it can only match a fact the seeder recorded, so the seeder must accept
      ! it too - widening a pattern buys nothing while the analysis that feeds it stays narrow.
      ! It passes its own test first, KrDotRecvOk: it is a StringTheory, and SELF or an object
      ! of this scope's own holds it.
      ! `self.Method(...)` is a DIFFERENT shape and still goes to the summary path: there the
      ! merge yields the bare token `self`, so spSuf is blank. `self.buf.findByte(...)` yields
      ! `self.buf` with spSuf 'BUF', and is a receiver, not a call on self.
      if spRoot = 'SELF' and ~spSuf                                    ! ---- x = self.<Method>(...) - a body IN THIS FILE
        smNm = ''
        smF  = self.SummaryOfCallAt(rs, re, scSelf, smNm)              ! sm:none unless the prototype is visible AND not VIRTUAL
        do KrSeedFromSummary
        exit
      end
      if spSuf
        okName = spIn ; okPos = rs                                     ! a StringTheory that SELF or a local object holds
        do KrDotRecvOk
        if ~okRes then exit.
        seedRc = spIn                                                  ! the WHOLE token is the receiver's identity
      else
        okName = spRoot                                                ! a simple local StringTheory of this scope
        do KrRecvOk
        if ~okRes then exit.
        seedRc = okName
      end
      gPos = rs + 2
      do KrGet
      if ~gOk or                                                       |
         gTy <> vt:label
        exit
      end
      mth = gTU
      gPos = rs + 3
      do KrGet
      if ~gOk or                                                       |
         gTxt <> '('
        exit
      end
      mpOpen = rs + 3
      do KrMatchParen
      if mpClose <> re then exit.
      case mth
      of 'FINDCHAR' orof 'FINDCHARS' orof 'FINDBYTE' orof 'INSTRING'
        seedOk = 1                                                     ! 0 = not found, else 1 .. recv._DataEnd
        seedKd = rk:zeroBound
        do KrSeedGeArg                                                 ! and, if it was given a START, x >= that start
      of 'LEN'      orof 'LENGTH'    orof 'LENGTHA'  orof 'CLIPLENGTH'
        seedOk = 1                                                     ! >= 0 only. clipLength IGNORES trailing spaces, so it is
        seedKd = rk:nonNeg                                             !   NOT _DataEnd and must never be treated as that bound
        seedRc = ''
      end
      exit
    end
  end
  ! ---- (c) a bare Clarion reader:  x = len(...) / records(...) / size(...) / instring(...)
  if re < rs + 2 then exit.
  gPos = rs
  do KrGet
  if ~gOk then exit.
  mth = gTU
  gPos = rs + 1
  do KrGet
  if ~gOk or                                                           |
     gTxt <> '('
    exit
  end
  mpOpen = rs + 1
  do KrMatchParen
  if mpClose <> re then exit.
  case mth
  of 'LEN' orof 'RECORDS' orof 'SIZE' orof 'INSTRING'
    if pureOwnU.findChars(' ' & clip(mth) & ' ') then exit.            ! a procedure of the file's own of that name may be the one called
    seedOk = 1
    seedKd = rk:nonNeg
    if mth = 'LEN' then do KrSeedClipOf.                               ! len(clip(x)) also remembers x
  else
    smNm = ''                                                          ! x = MyProc(...) - a plain procedure DEFINED in this file
    smF  = self.SummaryOfCallAt(rs, re, '', smNm)
    do KrSeedFromSummary
  end

! ---- does the LEN argument name the string whose clipped length this seed holds?
!      `v = len(clip(x))` exactly - CLIP of one bare label and nothing else - with x a plain
!      STRING local of this scope, under the same aliasing tests KrLocalOk makes of a position
!      variable. The fact then REMEMBERS x, so S14 can read `x[1 : v]` for `clip(x)`; it forgets
!      the moment either name is written (KrKillName clears the field as it clears kvGeVar). ----
KrSeedClipOf routine
  seedCo = ''
  if mpClose <> mpOpen + 5 then exit. ! len ( clip ( x ) ) - the argument is exactly four tokens
  gPos = mpOpen + 1
  do KrGet
  if ~gOk or gTU <> 'CLIP' then exit.
  gPos = mpOpen + 2
  do KrGet
  if ~gOk or gTxt <> '(' then exit.
  gPos = mpOpen + 4
  do KrGet
  if ~gOk or gTxt <> ')' then exit.
  gPos = mpOpen + 3
  do KrGet
  if ~gOk or gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.                 ! a.b is a field, not a local string
  okName = spRoot
  do KrStrLocalOk
  if ~okRes then exit.
  seedCo = spRoot

! ---- KrLocalOk for a STRING: the same local-of-this-scope and no-alias tests, for the
!      string whose clipped length a seed remembers. A StringTheory is not a string here. ----
KrStrLocalOk routine
  data
lz  long,auto
  code
  okRes = 0
  if ~okName then exit.
  lz = self.syms.FindSym(okName, sc)
  if ~lz then exit.
  get(self.syms.syms, lz)
  if errorcode() then exit.
  if self.syms.syms.isRef then exit.
  if self.syms.syms.isLike then exit.
  if self.syms.syms.isField then exit.
  case self.syms.syms.typeU
  of 'STRING' orof 'CSTRING' orof 'PSTRING'
    ! a plain string - ok
  else
    exit
  end
  okDecl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(okDecl) then exit.
  if band(self.DeclAttrBits(okDecl), ab:over + ab:dim + ab:static + ab:thread) then exit.
  if self.HasSiblingOver(lz, okName) then exit.
  ! AND THE OTHER NAMES FOR IT, as KrLocalOk asks: `rx &= x` then `rx = 'abcdz'` makes x longer than the
  ! clipped length the seed remembers, and so does a method of a class the procedure declares, a control's
  ! USE() or an INCLUDE - none of them names x where this walk can see it.
  alName = okName ; do KrAliased
  if alRes then exit.
  if self.UnseenRead(okName) then exit.
  if self.MayHaveLocalMethods(sc)
    get(self.syms.scopes, sc)
    if ~errorcode()
      if self.UsedInLocalMethods(okName, self.syms.scopes.startTok, self.syms.scopes.endTok) then exit.
    end
  end
  okRes = 1

! ---- the START argument of a forward search is a LOWER BOUND on the result.
!      StringTheory.FindByte(ch, pStart) searches from address+pStart-1, so it returns 0 or a
!      position AT OR AFTER pStart - same for FindChar, FindChars and Instring. The seed is
!      recorded here; it is only USABLE once the value is also known non-zero, which is what
!      the `if ~x` narrowing at step 5 provides. Together they give `x >= v`.
!      SECOND ARGUMENT ONLY, and only when it is a bare local: an expression could be
!      anything, and Instring's second argument is a step rather than a start - which is why
!      INSTRING is deliberately absent from the case below even though it seeds a range. ----
KrSeedGeArg routine
  seedGe = ''
  case mth
  of 'FINDCHAR' orof 'FINDCHARS' orof 'FINDBYTE'
  else
    exit
  end
  a2S = mpOpen + 1
  a2E = mpClose - 1
  if a2E < a2S then exit.
  do KrArg2           ! gaS..gaE = the SECOND argument, or 0
  if ~gaS or          |
     gaS <> gaE       ! one token only - an expression proves nothing
    exit
  end
  gPos = gaS
  do KrGet
  if ~gOk or          |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit. ! a.b - not a plain local
  okName = spRoot
  do KrLocalOk
  if ~okRes then exit.
  seedGe = spRoot

! ---- gaS..gaE = the second top-level argument of the call spanning a2S..a2E ----
KrArg2 routine
  data
k2  long,auto
d2  long
c2  long,auto
  code
  gaS = 0
  gaE = 0
  c2  = 0
  loop k2 = a2S to a2E
    gPos = k2
    do KrGet
    if ~gOk then cycle.
    if gTxt = '(' then d2 += 1.
    if gTxt = ')' then d2 -= 1.
    if d2 or gTxt <> ',' then cycle.
    c2 += 1
    if c2 = 1
      gaS = k2 + 1
    else
      gaE = k2 - 1
      exit
    end
  end
  if gaS and ~gaE then gaE = a2E.
  if gaS > gaE then gaS = 0.

! ---- turn a summary into a seed. rk:posBound is recorded with NO receiver, which is
!      correct and deliberately weak: the S3 rewrite and the `x - 1 < recv._DataEnd` row
!      both demand a fact bounded by the receiver the call is written on, and a blank one
!      can never match, so a summary can only ever decide `x < 0` / `x >= 0` and their
!      mirrors. Widening that would mean claiming a bound on a buffer we never looked at. ----
KrSeedFromSummary routine
  case smF
  of sm:nonNeg
    seedOk  = 1
    seedKd  = rk:nonNeg
    seedRc  = ''
    seedVia = smNm
  of sm:posBound
    seedOk  = 1
    seedKd  = rk:posBound
    seedRc  = ''
    seedVia = smNm
  end

! ---- move the facts on, at the POST-line depth ----
KrLineEffects routine
  data
ez  long,auto
sz  long,auto
sd  long,auto
  code
  do KrDetectSeed                                           ! reads token SHAPES only - applied at step 4, after the kills
  ! ---- 1. a routine can change any variable and any receiver
  if lnDo then free(KrFactQ).
  ! ---- 2. every write target on the line loses its fact
  loop ez = lineFirst to lineLast - 1
    gPos = ez
    do KrGet
    if ~gOk or                                              |
       gTy <> vt:label
      cycle
    end
    if ez > lineFirst                                       ! a write target starts a statement: first on the line, or after THEN / ELSE / ';'
      gPos = ez - 1                                         !   or after a column-1 label (`Done  n = -1`), or after the '?' of a debug
      do KrGet
      if gTxt = '?' then gTxt = ';'.                        !   line (`? p = -1`), which marks every statement on the line: a ';' to this walk
      if ~gOk or                                            |
         gTU <> 'THEN' and gTU <> 'ELSE' and gTxt <> ';'
        if ~self.syms.IsColOneLabel(ez - 1) then cycle.
      end
    end
    gPos = ez + 1
    do KrGet
    if ~gOk then cycle.
    if gTxt = '['                                           ! A SUBSCRIPT WRITE WRITES THE VARIABLE: `x[5] = 'z'` and
      sd = 0                                                !   `x[4 : 5] = 'yz'` change x, and a fact read from it -
      loop sz = ez + 1 to lineLast                          !   `v = len(clip(x))` - is stale after them
        gPos = sz
        do KrGet
        if ~gOk then break.
        if gTxt = '[' then sd += 1.
        if gTxt = ']'
          sd -= 1
          if ~sd then break.
        end
      end
      if sd then cycle.
      gPos = sz + 1
      do KrGet
      if ~gOk then cycle.
    end
    if gTxt <> '='                                          ! '=' or a compound assignment: both WRITE the label
      if len(clip(gTxt)) <> 2 or                            |
         gTxt[2] <> '='
        cycle
      end
      case val(gTxt[1])
      of 43 orof 45 orof 42 orof 47 orof 37 orof 94 orof 38 ! '+' orof '-' orof '*' orof '/' orof '%' orof '^' orof '&'
        ! a compound assignment
      else
        cycle
      end
    end
    gPos = ez
    do KrGet
    spIn = gTU
    do KrSplitRoot
    killNm = spRoot
    do KrKillName
    do KrKillRecv
    do KrKillWhole
  end
  ! ---- 3. an impure call may write through an argument (a *LONG we have no prototype for)
  !         or move a receiver's _DataEnd. Everything it could reach, it names on this line.
  if lnImpure
    loop ez = lineFirst to lineLast
      gPos = ez
      do KrGet
      if ~gOk or                                            |
         gTy <> vt:label
        cycle
      end
      spIn = gTU
      do KrSplitRoot
      killNm = spRoot
      do KrKillName
      do KrKillRecv
      do KrKillWhole
    end
  end
  ! ---- 3b. a call that may change things - an impure one, or a name alone - may reach a member of SELF
  !          without naming it (ruled 30 Oct 2026)
  do KrKillSelf
  ! ---- 4. the seed (AFTER the kills: the call that produced the value ran last)
  if seedOk
    addNm  = seedNm
    addKd  = seedKd
    addRc  = seedRc
    addVia = seedVia                                        !
    addGe  = seedGe                                         ! the relational lower bound, if any
    addCo  = seedCo                                         ! the remembered string, if any
    do KrAddFact
  end
  ! ---- 5. `if ~x then break.` - below it x is non-zero
  if narName and ~narBlock
    fName = narName
    do KrFind
    if fKind = rk:zeroBound or fKind = rk:nonNeg
      addNm  = narName
      addKd  = rk:posBound
      addRc  = fRecv
      addCo  = fClip                                        ! the remembered string survives it too
      addVia = fVia                                         ! the evidence survives the narrowing
      addGe  = fGeVar                                       ! and so does the relational bound - the
      do KrAddFact                                          !   narrowing is what MAKES it usable (x <> 0)
    end
  end

! ---- decide the condition span [evS..evE]: evRes 0 = undecided, 1 = TRUE, 2 = FALSE.
!      A condition is one comparison (KrEvalOne), or comparisons joined by AND alone or by OR
!      alone at bracket depth 0 - mixed joiners bring precedence in and are left alone. AND is
!      FALSE the moment one part is FALSE and TRUE only when every part is; OR is TRUE the moment
!      one part is TRUE and FALSE only when every part is. Clarion evaluates AND/OR left to right
!      and stops early, so an early verdict is sound whatever the undecided parts would do - unless
!      an undecided part BEFORE it holds an impure call, which the original made and a rewrite
!      would not: that leaves the whole condition undecided. ----
KrEvalCond routine
  data
ecJ    long,auto
ecD    long
ecS    long,auto      ! the part being decided starts here
ecOp   string(3),auto ! the one joiner seen, '' while none
ecAny  byte,auto      ! a part was undecided
ecVer  byte,auto      ! the verdict so far
ecSvS  long,auto
ecSvE  long,auto
ecW    long,auto
ecPure byte,auto
  code
  evRes = 0
  ecSvS = evS ; ecSvE = evE
  ecS = evS ; ecOp = '' ; ecAny = 0 ; ecVer = 0
  loop ecJ = evS to ecSvE + 1
    if ecJ <= ecSvE
      gPos = ecJ
      do KrGet
      if ~gOk then ecVer = 0 ; break.
      if gTxt = '(' then ecD += 1.
      if gTxt = ')' then ecD -= 1.
      if ecD then cycle.
      if gTU <> 'AND' and gTU <> 'OR' then cycle.
      if ecOp and ecOp <> gTU then ecVer = 0 ; break. ! mixed - precedence, leave it
      ecOp = gTU
    end
    evS = ecS
    evE = ecJ - 1
    do KrEvalOne                                      ! this part, into evRes
    if ~evRes and ecOp                                ! an undecided part Clarion may still EVALUATE: a call in it
      ecPure = 1                                      !   must be pure, or a later verdict would drop that call
      loop ecW = evS to evE
        gPos = ecW
        do KrGet
        if gOk and gTy = vt:label                     ! a call written without brackets - `if Flag or p >= 0`
          bcCall = self.BareCallAt(ecW)               !   calls Flag before p is read (BareCallAt)
          if bcCall then ecPure = 0 ; break.
        end
        if ~gOk or gTxt <> '(' then cycle.
        caPos = ecW
        do KrCallAt
        if caIsCall and ~caPure then ecPure = 0 ; break.
      end
      if ~ecPure then ecVer = 0 ; break.
    end
    ecS = ecJ + 1
    if ~ecOp                                          ! a single comparison: its verdict is the verdict
      ecVer = evRes
      cycle
    end
    if ecOp = 'AND'
      if evRes = 2 then ecVer = 2 ; break.            ! one FALSE part decides an AND
      if ~evRes then ecAny = 1.
      ecVer = choose(~ecAny)
    else
      if evRes = 1 then ecVer = 1 ; break.            ! one TRUE part decides an OR
      if ~evRes then ecAny = 1.
      ecVer = choose(~ecAny, 2, 0)
    end
  end
  evS = ecSvS ; evE = ecSvE
  evRes = ecVer

! ---- ONE comparison, [evS..evE]. The table, and nothing outside it:
!        x < 0, x <= -1              FALSE     x >= 0, x > -1             TRUE      any fact
!        x + n < 0 ...               the same, for a non-negative integer n
!        x - 1 < 0, x - 1 <= -1        FALSE     x - 1 >= 0, x - 1 > -1     TRUE      posBound
!        x - n <= recv._DataEnd       TRUE      x - n > recv._DataEnd      FALSE     zeroBound/posBound ON THAT receiver
!        x = 0, x < 1, x <= 0        FALSE     x <> 0, x >= 1, x > 0      TRUE      posBound; any fact when n >= 1
!        x, as the whole condition   TRUE      ~x, NOT x                  FALSE     posBound
!        x <= recv._DataEnd          TRUE      x > recv._DataEnd          FALSE     zeroBound/posBound ON THAT receiver
!        x - 1 < recv._DataEnd       TRUE                                           posBound ON THAT receiver
!      `x < recv._DataEnd` is NOT here for posBound: x may equal _DataEnd. ----
KrEvalOne routine
  data
eoNeg  byte,auto
  code
  evRes = 0
  evOfs = 0 ; evN = 0 ; evNeg = 0 ; eoNeg = 0
  if evE < evS then exit.
  gPos = evS
  do KrGet
  if ~gOk then exit.
  if gTxt = '~' or gTU = 'NOT'                                   ! `~x` / `NOT x` - the whole condition
    if evE <> evS + 1 then exit.
    eoNeg = 1
    gPos = evS + 1
    do KrGet
    if ~gOk then exit.
  end
  if gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.                                            ! a member read carries no fact
  fName = spRoot
  do KrFind
  if fKind = rk:none then exit.
  if eoNeg                                                       ! ~x is FALSE for a local that is 1 or more
    if fKind = rk:posBound then evRes = 2.
    exit
  end
  if evE = evS                                                   ! bare x as the condition: TRUE for 1 or more
    if fKind = rk:posBound then evRes = 1.
    exit
  end
  ! ---- an ADDED non-negative integer keeps the sign: every fact held here is >= 0, so `x + n` is
  !      >= 0 too and the shapes below decide it exactly as they decide x, two tokens further on;
  !      with n >= 1 it is also >= 1, which is what the zero tests need.
  if evE >= evS + 4
    gPos = evS + 1
    do KrGet
    if gOk and (gTxt = '+' or gTxt = '-')
      evNeg = choose(gTxt = '-')
      gPos = evS + 2
      do KrGet
      if gOk and gTy = vt:Integer
        evOfs = 2
        evN   = gTxt
      end
    end
  end
  ! ---- a SUBTRACTED integer: x - 1 is still >= 0 when x is 1 or more, and that is all it keeps;
  !      against recv._DataEnd it can only be lower than x was, so those rows hold for any n.
  ! ---- three tokens: x <op> 0 / 1, or x <op> recv._DataEnd
  if evE = evS + 2 + evOfs
    gPos = evS + 1 + evOfs
    do KrGet
    if ~gOk then exit.
    evOp = gTxt
    gPos = evS + 2 + evOfs
    do KrGet
    if ~gOk then exit.
    if gTxt = '0'
      if evOfs and evNeg                                         ! x - n: >= 0 only as x - 1 for x >= 1
        if fKind <> rk:posBound or evN <> 1 then exit.
        if evOp = opLT then evRes = 2 ; exit.
        if evOp = opGE then evRes = 1 ; exit.
        exit
      end
      if evOp = opLT then evRes = 2 ; exit.                      ! every fact we hold says x >= 0
      if evOp = opGE then evRes = 1 ; exit.
      if fKind = rk:posBound or evN >= 1                         ! x >= 1: the zero tests decide too
        if evOp = '='  then evRes = 2 ; exit.
        if evOp = opNE then evRes = 1 ; exit.
        if evOp = opGT then evRes = 1 ; exit.
        if evOp = opLE then evRes = 2 ; exit.
      end
      exit
    end
    if gTxt = '1'
      if evOfs and evNeg then exit.                              ! x - n is never known to be 1 or more
      if fKind = rk:posBound or evN >= 1
        if evOp = opGE then evRes = 1 ; exit.
        if evOp = opLT then evRes = 2 ; exit.
      end
      exit
    end
    if evOfs and ~evNeg then exit.                               ! x + n against _DataEnd: n could carry it past
    if gTy <> vt:label then exit.
    spIn = gTU
    do KrSplitRoot
    if spSuf <> '_DATAEND' or spRoot <> fRecv then exit.         ! a bound on `st` says nothing about `other._DataEnd`
    if fKind <> rk:zeroBound and fKind <> rk:posBound then exit.
    if evOp = opLE then evRes = 1 ; exit.                        ! x <= _DataEnd is what both facts say, and x - n is lower still
    if evOp = opGT then evRes = 2 ; exit.
    if evOfs and evN >= 1 and evOp = opLT                        ! x - n < _DataEnd for x >= 1, n >= 1: the five-token
      if fKind = rk:posBound then evRes = 1.                     !   row, reached here first
    end
    exit
  end
  ! ---- four tokens:  x <= -1   /   x > -1      (or x + n <= -1 / x + n > -1)
  if evE = evS + 3 + evOfs
    gPos = evS + 1 + evOfs
    do KrGet
    if ~gOk then exit.
    evOp = gTxt
    gPos = evS + 2 + evOfs
    do KrGet
    if ~gOk or                                                   |
       gTxt <> '-'
      exit
    end
    gPos = evS + 3 + evOfs
    do KrGet
    if ~gOk or                                                   |
       gTxt <> '1'
      exit
    end
    if evOfs and evNeg                                           ! x - n against -1: >= 0 only as x - 1 for x >= 1
      if fKind <> rk:posBound or evN <> 1 then exit.
    end
    if evOp = opLE then evRes = 2 ; exit.
    if evOp = opGT then evRes = 1 ; exit.
    exit
  end
  if evOfs then exit.                                            ! the five-token shape reads x itself
  ! ---- five tokens:  x - 1 < <recv>._DataEnd   - TRUE only for posBound on THAT receiver.
  !      1 <= x <= _DataEnd  =>  x - 1 <= _DataEnd - 1  <  _DataEnd.  See the note in
  !      the header for why `x < recv._DataEnd` is NOT in this table.
  if evE <> evS + 4 or                                           |
     fKind <> rk:posBound
    exit
  end
  gPos = evS + 1
  do KrGet
  if ~gOk or                                                     |
     gTxt <> '-'
    exit
  end
  gPos = evS + 2
  do KrGet
  if ~gOk or                                                     |
     gTxt <> '1'
    exit
  end
  gPos = evS + 3
  do KrGet
  if ~gOk or                                                     |
     gTxt <> opLT
    exit
  end
  gPos = evS + 4
  do KrGet
  if ~gOk or                                                     |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf <> '_DATAEND' or                                      |
     spRoot <> fRecv                                             ! a bound on `st` says nothing about `other._DataEnd`
    exit
  end
  evRes = 1

! ---- `if C then S.` with C provably TRUE -> S ----
KrTryS1 routine
  data
tz   long,auto
dep  long,auto
  code
  s1Then = 0
  s1Dot  = 0
  s1Gone = 0
  gPos = lineFirst
  do KrGet
  if ~gOk                   or      |
     gTy <> vt:reservedWord or      |
     gTU <> 'IF'            or      |
     gLv <> '+'
    exit
  end
  ! the surviving statement inherits the IF's leading trivia; at column 1 it would read as
  ! a LABEL, so a bare-column-1 IF (which the tokenizer would not type vt:reservedWord anyway) is out.
  get(self.tk.tokens, lineFirst)
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL then exit.
  if ~size(self.tk.tokens.strBefore) then exit.
  gPos = lineLast
  do KrGet
  if ~gOk          or               |
     gTy <> vt:end or               |
     gTxt <> '.'                    ! a whole-word END on this line is not the one-liner form
    exit
  end
  s1Dot = lineLast
  dep = 0
  loop tz = lineFirst + 1 to s1Dot - 1
    gPos = tz
    do KrGet
    if ~gOk         or              |
       gLv = '+'    or              |   ! a nested opener inside the one-liner
       gLv = '/'    or              |   ! an inline ELSE - `if C then A else B.`
       gTy = vt:end                 ! a nested inline terminator
      exit
    end
    if gTxt = '('
      dep += 1
    elsif gTxt = ')'
      dep -= 1
      if dep < 0 then exit.
    elsif ~dep and gTy = vt:reservedWord and gTU = 'THEN'
      if s1Then then exit.          ! two top-level THENs - not a shape we model
      s1Then = tz
    end
  end
  if dep                        or  |
     ~s1Then                    or  |
     s1Then - 1 < lineFirst + 1 or  |   ! empty condition
     s1Then + 1 > s1Dot - 1         ! empty body
    exit
  end
  ! nothing we DELETE, and nothing whose trivia we REPLACE, may carry a comment or a bar
  tcS = lineFirst + 1
  tcE = s1Then + 1
  do KrTriviaClean
  if ~tcOk then exit.
  tcS = s1Dot
  tcE = s1Dot
  do KrTriviaClean
  if ~tcOk then exit.
  evS = lineFirst + 1
  evE = s1Then - 1
  do KrEvalCond
  if evRes = 2                      ! the mirror: a guard that can never fire
    do KrS1Dead
    exit
  end
  if evRes <> 1 then exit.
  logLn = self.LogLineOf(lineFirst) ! captured BEFORE the edits - log coordinates only, never logic
  nxPos  = s1Dot
  nxPos2 = s1Dot
  nxKind = 1
  do KrPush                         ! drop the terminating '.'
  nxPos  = s1Then + 1
  nxPos2 = lineFirst
  nxKind = 2
  do KrPush                         ! the statement inherits the IF's indent
  nxPos  = lineFirst
  nxPos2 = s1Then
  nxKind = 1
  do KrPush                         ! drop `if <condition> then`
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  do KrViaTxt
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': guard on ' & clip(fName) & ' cannot fail - if/then removed' & clip(viaTxt) & '<13,10>')
  end

! ---- `if C then S.` with C provably FALSE: the line never does anything, so it goes - whole,
!      indent, CODE and its own '<10>' - and the lines either side meet. Refused when a comment is
!      in the way: one above the IF (it lives in the IF token's trivia and would go with it), one
!      trailing (in the EOL token's), or one riding a '|' continuation inside S, which goes with the
!      line too. S1 proper is the TRUE half: the guard goes, S stays.
!      The commonest catch is a narrowing repeated - a second `if ~p then break.` under the first. ----
KrS1Dead routine
  if lineEol <> lineLast + 1 then exit.                               ! no EOL token of its own to take with it
  get(self.tk.tokens, lineFirst)                                      ! a comment parked in front of the IF, in its own trivia ...
  if errorcode() then exit.
  if not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(33, 1,, self.tk.tokens.strBefore) then exit.     ! '!'
  end
  if lineFirst > 2                                                    ! ... or a comment-only line right above it, which is an EOL
    if self.IsEolTok(lineFirst - 1) and self.IsEolTok(lineFirst - 2)  !   token of its own with the comment in its trivia: either
      get(self.tk.tokens, lineFirst - 1)                              !   is ABOUT this line and would be left describing nothing
      if ~errorcode() and not self.tk.tokens.strBefore &= NULL
        if pLog.findByte(33, 1,, self.tk.tokens.strBefore) then exit. ! '!'
      end
    end
  end
  get(self.tk.tokens, lineEol)
  if errorcode() then exit.
  if not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(33, 1,, self.tk.tokens.strBefore) or pLog.findByte(124, 1,, self.tk.tokens.strBefore) then exit. ! a trailing comment would go with it  ! '!'  ! '|'
  end
  if s1Dot > s1Then + 2                                               ! ... or one riding a continuation inside the body
    if self.SpanTriviaHasComment(s1Then + 2, s1Dot - 1) then exit.    !   of the IF
  end
  logLn = self.LogLineOf(lineFirst)
  nxPos  = lineFirst
  nxPos2 = lineEol
  nxKind = 1
  do KrPush                                                           ! the whole line, '<10>' included
  s1Gone = 1                                                          ! so KrLine stages nothing else inside it
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  do KrViaTxt
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': guard on ' & clip(fName) & ' can never fire - line removed' & clip(viaTxt) & '<13,10>')
  end

! ---- the EVIDENCE clause. A fact seeded from a procedure summary was established in
!      ANOTHER procedure, so a reader looking at the changed line alone cannot check it -
!      the log line has to say where it came from. Blank for every ordinary seed. ----
KrViaTxt routine
  if fVia
    viaTxt = ' - ' & clip(fName) & ' holds what ' & clip(fVia) & '() returns'
  else
    viaTxt = ''
  end

! ---- every choose() on this line ----
KrTryS2 routine
  data
sz  long,auto
  code
  sz = lineFirst - 1
  loop
    sz += 1
    if sz >= lineLast then break.
    gPos = sz
    do KrGet
    if ~gOk or                   |
       gTU <> 'CHOOSE'
      cycle
    end
    gPos = sz + 1
    do KrGet
    if ~gOk or                   |
       gTxt <> '('
      cycle
    end
    c2Tok  = sz
    c2Open = sz + 1
    mpOpen = c2Open
    do KrMatchParen
    if ~mpClose then cycle.
    c2Close = mpClose
    do KrChooseOne
    if c2Done then sz = c2Close. ! never descend into a span we are already rewriting
  end

! ---- one choose(): decide it and stage the collapse ----
KrChooseOne routine
  data
oz  long,auto
od  long,auto
nc  long,auto
cnd byte,auto
  code
  c2Done = 0
  ! EXACTLY two top-level commas. choose(n, v1, v2, v3 ...) is the INDEXED form and means
  ! something else entirely, so anything else is refused outright.
  c2C1 = 0
  c2C2 = 0
  nc   = 0
  od   = 0
  loop oz = c2Open + 1 to c2Close - 1
    gPos = oz
    do KrGet
    if ~gOk then exit.
    if gTxt = '('
      od += 1
    elsif gTxt = ')'
      od -= 1
      if od < 0 then exit.
    elsif ~od and gTxt = ','
      nc += 1
      if nc = 1 then c2C1 = oz.
      if nc = 2 then c2C2 = oz.
    end
  end
  if nc <> 2            or |
     c2C1 <= c2Open + 1 or |   ! empty condition
     c2C2 <= c2C1 + 1   or |   ! empty TRUE value
     c2Close <= c2C2 + 1   ! empty FALSE value
    exit
  end
  ! A BARE NUMBER IS AN INDEX, NOT A CONDITION. choose(p, a, b) with p = 2 picks b; only a
  ! first argument that IS a condition - a comparison, NOT or ~, AND, OR or XOR at its top
  ! level - is true or false, and only that may be decided from a fact.
  od = 0
  cnd = 0
  loop oz = c2Open + 1 to c2C1 - 1
    gPos = oz
    do KrGet
    if ~gOk then exit.
    if gTxt = '('
      od += 1
    elsif gTxt = ')'
      od -= 1
    elsif ~od
      case upper(gTxt)
      of   '=' orof '<<>' orof '~='  orof '<<' orof '>'   orof '<<=' orof '>=' orof '=<<' orof '=>' orof '~<<' orof '~>'
      orof '~' orof 'NOT' orof 'AND' orof 'OR' orof 'XOR'
        cnd = 1
        break
      end
    end
  end
  if ~cnd then exit.
  tcS = c2Tok + 1
  tcE = c2Close
  do KrTriviaClean
  if ~tcOk then exit.      ! a comment or a '|' inside would be deleted with the span
  do KrChooseCallsOk
  if ~c2CallsOk then exit.
  evS = c2Open + 1
  evE = c2C1 - 1
  do KrEvalCond
  if ~evRes then exit.
  c2Res = evRes
  if c2Res = 1
    c2KeepS = c2C1 + 1     ! TRUE  -> the first value
    c2KeepE = c2C2 - 1
  else
    c2KeepS = c2C2 + 1     ! FALSE -> the last value
    c2KeepE = c2Close - 1
  end
  do KrChooseBr
  if c2Br = 2 then exit.
  logLn = self.LogLineOf(c2Tok)
  nxPos  = c2KeepE + 1
  nxPos2 = c2Close - c2Br
  nxKind = 1
  do KrPush                ! everything after the kept value, up to and incl. the ')' - which stays when c2Br keeps the brackets
  nxPos  = c2KeepS
  nxPos2 = c2Tok + c2Br
  nxKind = 2
  do KrPush                ! the kept value inherits CHOOSE's trivia - with c2Br, the trivia of the '(' it now follows
  nxPos  = c2Tok + c2Br
  nxPos2 = c2KeepS - 1
  nxKind = 1
  do KrPush                ! `choose(` + the condition + the discarded value - with c2Br, all but CHOOSE itself
  if c2Br                  ! CHOOSE itself becomes the '(', keeping its own trivia
    nxPos  = c2Tok
    nxPos2 = 0
    nxKind = 3
    nxTxt  = '('
    do KrPush
  end
  c2Done = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  do KrViaTxt
  if changes <= 500
    if c2Res = 1
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': choose() condition on ' & clip(fName) & ' is always true - collapsed to the first value' & clip(viaTxt) & '<13,10>')
    else
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': choose() condition on ' & clip(fName) & ' is always false - collapsed to the last value' & clip(viaTxt) & '<13,10>')
    end
  end

! ---- may the kept value stand bare where the choose() stood? c2Br ----
!      A choose() is ONE term. The value it keeps need not be, and once the call's brackets go
!      its operators meet the neighbours': `2 * choose(p >= 0, a + 1, 0)` is `2 * (a + 1)`, never
!      `2 * a + 1`, and `10 - choose(p < 0, 0, a - 1)` is `10 - (a - 1)`. OpLevel ranks them.
!        0  bare: the value is one term, or nothing next to it binds as tightly as its own
!           loosest operator outside brackets - `x = a + 1`, `f(a + 1)`, `s & a & b`;
!        1  the choose's own brackets stay round it: the operator in front binds at least as
!           tightly (a '-', '+', '~' or NOT there may be a sign, and a sign binds tightest), or
!           the one after it does, or a '[' follows;
!        2  refused: a value whose loosest operator is a comparison or a logical one is a
!           condition, and is taken only where a condition already stood - after IF, ELSIF,
!           WHILE, UNTIL, '~', NOT, AND, OR or XOR, and before THEN, AND, OR, XOR or the end of
!           the line. Anywhere else, an assignment or an argument, it is left as written. ----
KrChooseBr routine
  data
kLv    long,auto
pLv    long,auto
nLv    long,auto
pCond  byte,auto
nCond  byte,auto
  code
  c2Br = 0
  kLv = self.SpanTopLevel(c2KeepS, c2KeepE)
  if ~kLv then exit.
  pLv = self.OpLevel(c2Tok - 1)
  pCond = choose(pLv >= 9)
  gPos = c2Tok - 1
  do KrGet
  case gTU
  of 'IF' orof 'ELSIF' orof 'WHILE' orof 'UNTIL'
    pCond = 1
  end
  if gTxt = '-' or gTxt = '+' or gTxt = '~' or gTU = 'NOT' then pLv = 1.
  nLv = self.OpLevel(c2Close + 1)
  gPos = c2Close + 1
  do KrGet
  if gTxt = '[' then nLv = 1.
  nCond = choose(gTxt = '<10>' or gTU = 'THEN' or nLv >= 10)
  if kLv >= 8 and (~pCond or ~nCond) then c2Br = 2 ; exit.
  if pLv and kLv >= pLv or nLv and nLv <= kLv then c2Br = 1.

! ---- may this choose be decided from facts taken at the START of the line? ----
KrChooseCallsOk routine
  data
qz  long,auto
  code
  c2CallsOk = 0
  loop qz = lineFirst to lineLast
    gPos = qz
    do KrGet
    if ~gOk or             |
       gTxt <> '('
      cycle
    end
    caPos = qz
    do KrCallAt
    if ~caIsCall or        |
       caPure
      cycle
    end
    mpOpen = qz
    do KrMatchParen
    if ~mpClose then exit. ! unbalanced - refuse
    ! ONLY an ENCLOSING impure call is allowed: the choose is one of its arguments, so it is
    ! computed BEFORE that call has any effect. Anything else - a call that completes before
    ! the choose, a sibling argument of the same call, a call later in the expression - leaves
    ! the order of evaluation up to the compiler, and the fact may already be stale.
    if qz >= c2Tok or      |
       mpClose <= c2Close
      exit
    end
  end
  c2CallsOk = 1

! ---- every recv.sub(...) on this line ----
!      The receiver/'.'/method/'(' shape is KrDetectSeed's shape (b), for the same reason:
!      vitTokenize merges a dotted name into ONE token EXCEPT in front of a '(', so a call
!      always arrives as four tokens and `st._DataEnd` always arrives as one.
KrTryS3 routine
  data
uz  long,auto
  code
  uz = lineFirst + 1             ! the first token that can have a recv AND a '.' below it
  loop
    uz += 1
    if uz >= lineLast then break.
    gPos = uz
    do KrGet
    if ~gOk            or        |
       gTy <> vt:label or        |   ! SUB is not in vitTokenize's reservedWords, so it types as a label
       gTU <> 'SUB'
      cycle
    end
    gPos = uz + 1
    do KrGet
    if ~gOk or                   |
       gTxt <> '('
      cycle
    end
    gPos = uz - 1
    do KrGet
    if ~gOk or                   |
       gTxt <> '.'               ! this dot is vt:dot, not vt:end - a label follows it with no space
      cycle
    end
    gPos = uz - 2
    do KrGet
    if ~gOk or                   |
       gTy <> vt:label
      cycle
    end
    spIn = gTU
    do KrSplitRoot
    if spSuf then cycle.         ! self.st.sub(...) - not a simple local receiver
    okName = spRoot
    do KrRecvOk
    if ~okRes then cycle.
    s3Recv = okName
    s3Tok  = uz
    s3Open = uz + 1
    mpOpen = s3Open
    do KrMatchParen
    if ~mpClose then cycle.
    s3Close = mpClose
    do KrSubOne
    if s3Done then uz = s3Close. ! never descend into a span we are already rewriting
  end

! ---- one recv.sub(q, x - q + 1): prove the shape and both facts, then stage the collapse.
!      Sound ONLY while q >= 1 and x >= 1 - see the three divergences in the header. ----
KrSubOne routine
  data
oz    long,auto
od    long,auto
onc   long,auto               ! top-level commas
onm   long,auto               ! top-level '-'
onp   long,auto               ! top-level '+'
qKind byte,auto               ! the fact held by the START operand
qRecv string(vs:maxName),auto
qNm   string(vs:maxName),auto ! both names, for the log line
xNm   string(vs:maxName),auto
qVia  string(vs:maxName),auto ! the summary, if any, behind each of them
xVia  string(vs:maxName),auto
  code
  s3Done = 0
  ! ---- 1. EXACTLY one top-level comma. sub(x) and sub(x, y, z) are not the form we model.
  onc  = 0
  od   = 0
  s3Com = 0
  loop oz = s3Open + 1 to s3Close - 1
    gPos = oz
    do KrGet
    if ~gOk then exit.
    if gTxt = '('
      od += 1
    elsif gTxt = ')'
      od -= 1
      if od < 0 then exit.
    elsif ~od and gTxt = ','
      onc += 1
      s3Com = oz
    end
  end
  if onc <> 1             or                                        |
     s3Com <= s3Open + 1  or                                        |   ! empty start
     s3Close <= s3Com + 1                                           ! empty length
    exit
  end
  ! ---- 2. the length argument: exactly one top-level '-' and one top-level '+', in that order
  onm = 0
  onp = 0
  od  = 0
  loop oz = s3Com + 1 to s3Close - 1
    gPos = oz
    do KrGet
    if ~gOk then exit.
    if gTxt = '('
      od += 1
    elsif gTxt = ')'
      od -= 1
      if od < 0 then exit.
    elsif ~od
      case gTxt
      of '-'
        onm += 1
        s3Min = oz
      of '+'
        onp += 1
        s3Plus = oz
      end
    end
  end
  if onm <> 1 or onp <> 1 or                                        |   ! anything ambiguous is refused outright
     s3Min >= s3Plus
    exit
  end
  ! ---- 3. the three terms of  x - q + 1
  s3X = s3Com + 1
  if s3X <> s3Min - 1 or                                            |   ! the leading term must be ONE token
     s3Plus + 1 <> s3Close - 1                                      ! the trailing term must be ONE token
    exit
  end
  gPos = s3Plus + 1
  do KrGet
  if ~gOk        or                                                 |
     gTxt <> '1' or                                                 |   ! ... and it must be the literal 1
     s3Min + 1 > s3Plus - 1                                         ! empty middle term
    exit
  end
  s3Q = s3Open + 1
  if s3Q <> s3Com - 1 then exit.                                    ! the start must be ONE token
  if ~self.SpanTokEqual(s3Min + 1, s3Plus - 1, s3Q, s3Q) then exit. ! the middle term must BE the start
  ! ---- 4. both operands are locals holding rk:posBound on THIS receiver.
  !         posBound is what makes the two methods agree; nonNeg is not enough, because a
  !         zero start is off by one and a zero end reads as "to the end of the string".
  gPos = s3Q
  do KrGet
  if ~gOk or                                                        |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.                                               ! a member read carries no fact
  fName = spRoot
  do KrFind
  qKind = fKind
  qRecv = fRecv
  qNm   = fName
  qVia  = fVia                                                      !
  if qKind <> rk:posBound or                                        |
     qRecv <> s3Recv
    exit
  end
  gPos = s3X
  do KrGet
  if ~gOk or                                                        |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.
  fName = spRoot
  do KrFind
  xNm  = fName
  xVia = fVia                                                       !
  if fKind <> rk:posBound or                                        |
     fRecv <> s3Recv
    exit
  end
  ! ---- 5. nothing in the argument list may carry a comment or a '|', and no impure call
  !         may have run before the sub - the facts were taken at the START of the line.
  tcS = s3Open
  tcE = s3Close
  do KrTriviaClean
  if ~tcOk then exit.
  ccLo = s3Tok
  ccHi = s3Close
  do KrSubCallsOk
  if ~s3CallsOk then exit.
  ! ---- 6. stage it. The delete sits ABOVE the retype, and KrApply works downwards, so the
  !         `sub` token has not moved by the time its text is replaced.
  logLn  = self.LogLineOf(s3Tok)
  nxPos  = s3Min
  nxPos2 = s3Close - 1
  nxKind = 1
  nxTxt  = ''
  do KrPush                                                         ! drop  - q + 1
  nxPos  = s3Tok
  nxPos2 = s3Tok
  nxKind = 3
  nxTxt  = 'slice'
  do KrPush                                                         ! sub -> slice
  s3Done = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  viaTxt = ''                                                       ! name whichever operand a SUMMARY vouched for
  if qVia and xVia
    viaTxt = ' - ' & clip(qNm) & ' holds what ' & clip(qVia) & '() returns, ' & clip(xNm) & ' what ' & clip(xVia) & '() returns'
  elsif qVia
    viaTxt = ' - ' & clip(qNm) & ' holds what ' & clip(qVia) & '() returns'
  elsif xVia
    viaTxt = ' - ' & clip(xNm) & ' holds what ' & clip(xVia) & '() returns'
  end
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(s3Recv) & '.sub(' & clip(qNm) & |
                ', ' & clip(xNm) & ' - ' & clip(qNm) & ' + 1) is the same span as .slice('      & |
                clip(qNm) & ', ' & clip(xNm) & ') - both are 1 or more' & clip(viaTxt) & '<13,10>')
  end

! ------------------------------------------------------------------------------------
! A SPAN COPIED AROUND IS A SPAN REMOVED.
!
!     st.SetValue(st.sub(1, p - 1) & st.slice(q))   ->   st.RemoveFromPosition(p, q - p)
!
! sub(1, p-1) keeps 1..p-1, slice(q) keeps q.._DataEnd, so what the concatenation drops is
! p..q-1 - exactly q-p characters starting at p. The rewrite is one memmove where the
! original allocates for the sub, again for the slice, again for the concatenation, and
! copies once more in the setValue.
!
! THE GENERAL SHAPE IS NOT PROVABLE, and general is what is wanted. The honest form is
!     `sub(1, A) & slice(B)` -> `RemoveFromPosition(A + 1, B - A - 1)`, which needs
!     B >= A + 1. At B = A + 1 the length is 0 and both spellings leave the string alone;
!     below that the ORIGINAL DUPLICATES characters A+1..B-1 while RemoveFromPosition
!     clamps a negative length to zero and does nothing. They are different programs, so
!     the guard is not optional.
!     The only derivable instance is A = w - 1 with B >= w, because that is precisely what
!     a forward search yields: `q = st.findByte(ch, p)` guarded non-zero gives q >= p.
!     An arbitrary A would need a relational fact between B and A that nothing produces.
!     So S4 matches the `w - 1` form ONLY. That is not a simplification for tidiness - a
!     wider match would have no way to earn its guard. If a real file shows another shape,
!     the fact it needs is the thing to add, not the pattern.
! ------------------------------------------------------------------------------------
KrTryS4 routine
  s4Uz = lineFirst + 1
  loop
    s4Uz += 1
    if s4Uz >= lineLast then break.
    gPos = s4Uz
    do KrGet
    if ~gOk            or |
       gTy <> vt:label or |
       gTU <> 'SETVALUE'
      cycle
    end
    gPos = s4Uz - 1
    do KrGet
    if ~gOk or            |
       gTxt <> '.'
      cycle
    end
    gPos = s4Uz - 2
    do KrGet
    if ~gOk or            |
       gTy <> vt:label
      cycle
    end
    spIn = gTU
    do KrSplitRoot
    ! a DOTTED receiver - self.buf.setValue(...) - is admitted. The report must wait until
    ! KrS4Shape has confirmed the argument IS a concatenation, or every ordinary
    ! self.x.setValue() in the file would produce a line. The receiver is compared WHOLE:
    ! the tokenizer splits a dotted name before a bracket, so self.buf.sub(...) arrives as
    ! self.buf, a dot, sub - the shape a bare st has - and merges it when there is no
    ! bracket, so self.buf.valuePtr arrives whole; comparing the full token covers both.
    ! A dotted receiver passes KrDotRecvOk, a bare one KrRecvOk; past that the receiver rests
    ! on the token being IDENTICAL in all three places, which the matcher demands.
    s4DotR = 0
    sRcv   = gTU
    if spSuf
      okName = sRcv ; okPos = s4Uz - 2
      do KrDotRecvOk
      if ~okRes then cycle.
      s4DotR = 1
      s4DotT = gTxt
    else
      okName = sRcv
      do KrRecvOk
      if ~okRes then cycle.
    end
    gPos = s4Uz + 1
    do KrGet
    if ~gOk or            |
       gTxt <> '('
      cycle
    end
    sOpn   = s4Uz + 1
    mpOpen = sOpn
    do KrMatchParen
    if ~mpClose then cycle.
    sCls = mpClose
    do KrS4Shape
    if s4Ok then break.
  end

! ---- the inner shape: <recv>.sub(1, <w> - 1) & <recv>.slice(<b>) ----
KrS4Shape routine
  data
kz  long,auto
dz  long
  code
  s4Ok  = 0
  s4Why = ''
  s4Two = 0
  sAmp  = 0
  sAmpN = 0
  loop kz = sOpn + 1 to sCls - 1                                                       ! the top-level '&'s: the head ends before the FIRST, the tail
    gPos = kz                                                                          !   starts after the LAST, and anything between the two is
    do KrGet                                                                           !   S7's middle term (KrS7Stage) - S4 proper has one '&'
    if ~gOk then cycle.
    if gTxt = '(' then dz += 1.
    if gTxt = ')' then dz -= 1.
    if dz then cycle.
    if gTxt = '&'
      if sAmp then s4Two = 1.
      if ~sAmp then sAmp = kz.
      sAmpN = kz
    end
  end
  if ~sAmp then exit.                                                                  ! not a concatenation at all - SILENT, or every plain setValue in the file would report
  ! ---- left term: THREE SPELLINGS, ONE SPAN. The head keeps 1..w-1 however it is written:
  !       st.sub(1, w - 1)         a LENGTH from 1, so 1..w-1
  !       st.slice(1, w - 1)       an END, and from a start of 1 that is the same
  !       st.valuePtr[1 : w - 1]   the buffer sliced directly
  !      The last matters more than it looks: this tool EMITS it. The fastcompare family and
  !      the getvalue-form both produce valuePtr[1 : _DataEnd], so a matcher that knows
  !      only sub and slice increasingly fails to recognise its own output.
  !      The tokenizer merges a dotted name NOT followed by '(' into one token, so
  !      st.valuePtr arrives whole and spSuf is how it is told apart.
  if sAmp - 1 < sOpn + 7 then exit.
  gPos = sOpn + 1
  do KrGet
  if ~gOk then exit.
  spIn = gTU
  do KrSplitRoot
  if gTU <> sRcv and gTU <> clip(sRcv) & '.VALUEPTR' then exit.                        ! whole-token compare
  if gTU = clip(sRcv) & '.VALUEPTR'                                                    ! works for st and self.buf alike
    if sAmp <> sOpn + 9 then exit.                                                     ! [ 1 : w - 1 ] is eight tokens
    gPos = sOpn + 2
    do KrGet
    if gTxt <> '[' then exit.
    gPos = sOpn + 3
    do KrGet
    if gTxt <> '1'
      s4Why = 'the leading valuePtr slice does not start at 1'
      do KrS4Miss
      exit
    end
    gPos = sOpn + 4
    do KrGet
    if gTxt <> ':' then exit.
    gPos = sOpn + 5
    do KrGet
    if gTy <> vt:label then exit.
    spIn = gTU
    do KrSplitRoot
    if spSuf then exit.
    wNm  = spRoot
    wSrc = gTxt
    sW   = sOpn + 5
    gPos = sOpn + 6
    do KrGet
    if gTxt <> '-' then exit.
    gPos = sOpn + 7
    do KrGet
    if gTxt <> '1'
      s4Why = 'the leading valuePtr end is not <<var> - 1, and that is the only form whose guard can be earned'
      do KrS4Miss
      exit
    end
    gPos = sOpn + 8
    do KrGet
    if gTxt <> ']' then exit.
  else
  gPos = sOpn + 2
  do KrGet
  if gTxt <> '.' then exit.
  gPos = sOpn + 3
  do KrGet
  ! slice(1, w - 1) is the SAME SPAN as sub(1, w - 1): sub takes a LENGTH and slice an END,
  ! and from a start of 1 those coincide - which the matcher guarantees, because it demands
  ! the literal 1 below. So BOTH spellings are admitted here, and anything else is a leading
  ! term this rewrite cannot reason about.
  if gTU <> 'SUB' and gTU <> 'SLICE'
    s4Why = 'the leading term is ' & clip(gTxt) & '(), not sub() or slice()'
    do KrS4Miss
    exit
  end
  sSub = sOpn + 3
  gPos = sSub + 1
  do KrGet
  if gTxt <> '(' then exit.
  mpOpen = sSub + 1
  do KrMatchParen
  if mpClose <> sAmp - 1 then exit.                                                    ! the sub must END where the '&' begins
  gPos = sSub + 2
  do KrGet
  if gTxt <> '1'
    s4Why = 'the leading term does not start at 1'
    do KrS4Miss
    exit
  end
  gPos = sSub + 3
  do KrGet
  if gTxt <> ',' then exit.
  if mpClose - 1 <> sSub + 6
    s4Why = 'the leading length is not <<var> - 1, and that is the only form whose guard can be earned'
    do KrS4Miss
    exit
  end
  gPos = sSub + 4
  do KrGet
  if gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.
  wNm = spRoot
  wSrc = gTxt                                                                          ! the SOURCE spelling - the replacement must not
  sW  = sSub + 4                                                                       !   upper-case a name the author wrote in lower case
  gPos = sSub + 5
  do KrGet
  if gTxt <> '-' then exit.
  gPos = sSub + 6
  do KrGet
  if gTxt <> '1' then exit.                                                            ! ... and it must be `w - 1`
  end                                                                                  ! end of the call-form head
  sAmp1 = sAmp                                                                         ! the head was read from the first '&'; the tail is read from the last
  sAmp  = sAmpN
  ! ---- right term: the same three spellings, and it must reach the END of the buffer:
  !       st.slice(b)                  omitted end = _DataEnd
  !       st.sub(b, _DataEnd - b + 1)  handled by S3 on an earlier pass, arrives as slice
  !       st.valuePtr[b : st._DataEnd] the end must be _DataEnd EXPLICITLY - anything else
  !                                    stops short and the gap is not what it looks
  gPos = sAmp + 1
  do KrGet
  if ~gOk then exit.
  spIn = gTU
  do KrSplitRoot
  if gTU <> sRcv and gTU <> clip(sRcv) & '.VALUEPTR' then exit.                        ! whole-token compare
  if gTU = clip(sRcv) & '.VALUEPTR'                                                    ! works for st and self.buf alike
    if sCls - 1 <> sAmp + 6 then exit.                                                 ! [ b : recv._DataEnd ] is six tokens
    gPos = sAmp + 2
    do KrGet
    if gTxt <> '[' then exit.
    gPos = sAmp + 3
    do KrGet
    if gTy <> vt:label then exit.
    spIn = gTU
    do KrSplitRoot
    if spSuf then exit.
    bNm  = spRoot
    bSrc = gTxt
    sB   = sAmp + 3
    gPos = sAmp + 4
    do KrGet
    if gTxt <> ':' then exit.
    gPos = sAmp + 5
    do KrGet
    if gTy <> vt:label then exit.
    spIn = gTU
    do KrSplitRoot
    if gTU <> clip(sRcv) & '._DATAEND'
      s4Why = 'the trailing valuePtr slice does not end at ' & clip(sRcv) & '._DataEnd, so it does not reach the end'
      do KrS4Miss
      exit
    end
    gPos = sAmp + 6
    do KrGet
    if gTxt <> ']' then exit.
  else
  gPos = sAmp + 2
  do KrGet
  if gTxt <> '.' then exit.
  gPos = sAmp + 3
  do KrGet
  ! sub(b, recv._DataEnd - b + 1) is the SAME span as slice(b) - both are b..end. The
  ! shipped rest-of-string rule converts one to the other, but S4 reads the sub() form
  ! directly and depends on no other pass.
  if gTU <> 'SLICE' and gTU <> 'SUB'
    s4Why = 'the trailing term is ' & clip(gTxt) & '(), not slice(), sub() or valuePtr[]'
    do KrS4Miss
    exit
  end
  s4TlSub = choose(gTU = 'SUB')
  sSlc = sAmp + 3
  gPos = sSlc + 1
  do KrGet
  if gTxt <> '(' then exit.
  mpOpen = sSlc + 1
  do KrMatchParen
  if mpClose <> sCls - 1 then exit.                                                    ! the term must END where the setValue closes
  if s4TlSub
    if mpClose - 1 <> sSlc + 8 then exit.                                              ! b , recv._DataEnd - b + 1
    gPos = sSlc + 3
    do KrGet
    if gTxt <> ',' then exit.
    gPos = sSlc + 4
    do KrGet
    spIn = gTU
    do KrSplitRoot
    if spRoot <> sRcv or spSuf <> '_DATAEND'
      s4Why = 'the trailing sub() length is not ' & clip(sRcv) & '._DataEnd - <<var> + 1, so it does not reach the end'
      do KrS4Miss
      exit
    end
    gPos = sSlc + 5
    do KrGet
    if gTxt <> '-' then exit.
    gPos = sSlc + 7
    do KrGet
    if gTxt <> '+' then exit.
    gPos = sSlc + 8
    do KrGet
    if gTxt <> '1' then exit.
    if ~self.SpanTokEqual(sSlc + 2, sSlc + 2, sSlc + 6, sSlc + 6) then exit.           ! the two b spans must MATCH
  else
    if mpClose - 1 <> sSlc + 2 then exit.                                              ! slice(b) - ONE token
  end
  gPos = sSlc + 2
  do KrGet
  if gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.
  bNm = spRoot
  bSrc = gTxt                                                                          !
  sB  = sSlc + 2
  end                                                                                  ! end of the call-form tail
  ! ---- the guard: w >= 1 on THIS receiver, and b >= w.
  !      from HERE the shape is confirmed, so a refusal is worth SAYING - reasoning
  !      about why it did not fire is easy to get wrong, and a line in the
  !      report naming the failed test turns that into evidence.
  s4Why = ''
  fName = wNm
  do KrFind
  if fKind <> rk:posBound
    s4Why = clip(wNm) & ' is not known to be 1 or more here - it holds ' &                      |
            choose(fKind = rk:none, 'NO fact at all (killed, or never established)',            |
            choose(fKind = rk:zeroBound, 'zeroBound - 0.._DataEnd, never narrowed to non-zero', |
            choose(fKind = rk:nonNeg, 'nonNeg - 0 or more, not bounded by a receiver', 'some other kind')))
    do KrS4Refuse
    exit
  end
  if fRecv <> sRcv
    s4Why = clip(wNm) & ' is bounded by ' & choose(fRecv = '', '(nothing)', clip(fRecv)) & ', not ' & sRcv
    do KrS4Refuse
    exit
  end
  fName = bNm
  do KrFind
  if fKind <> rk:posBound
    s4Why = clip(bNm) & ' is not known to be 1 or more here - it holds ' &                      |
            choose(fKind = rk:none, 'NO fact at all (killed, or never established)',            |
            choose(fKind = rk:zeroBound, 'zeroBound - 0.._DataEnd, never narrowed to non-zero', |
            choose(fKind = rk:nonNeg, 'nonNeg - 0 or more, not bounded by a receiver', 'some other kind')))
    do KrS4Refuse
    exit
  end
  if fRecv <> sRcv
    s4Why = clip(bNm) & ' is bounded by ' & choose(fRecv = '', '(nothing)', clip(fRecv)) & ', not ' & sRcv
    do KrS4Refuse
    exit
  end
  if fGeVar <> wNm
    s4Why = 'nothing says ' & clip(bNm) & ' >= ' & clip(wNm) & ' (it is >= ' &         |
            choose(fGeVar = '', 'nothing', clip(fGeVar)) & ')'
    do KrS4Refuse
    exit
  end
  bVia = fVia
  ! ---- trivia and evaluation order, exactly as S3 ----
  ! THE SPAN IS THE EXPRESSION BEING REWRITTEN, NOT THE CALL THAT WRAPS IT. The facts were
  !     taken at the START of the line, and KrSubCallsOk tolerates exactly ONE impure call - the
  !     one that ENCLOSES the span, starting before ccLo and closing after ccHi - because that
  !     call is the setter the rewrite is handed to, and it runs AFTER the expression it is
  !     given. So the span is the concatenation, sOpn + 1 .. sCls - 1, not the setter's own
  !     parens: passed those, the setter's '(' sits AT ccLo and the one call that should be
  !     tolerated is the one that refuses.
  tcS = sOpn
  tcE = sCls
  do KrTriviaClean
  if ~tcOk then exit.
  ccLo = sOpn + 1
  ccHi = sCls - 1
  do KrSubCallsOk
  if ~s3CallsOk then exit.
  do KrMarked
  if mkWhy
    s4Why = mkWhy
    do KrS4Refuse
    exit
  end
  if s4Two                                                                             ! a middle term: S7, two statements - or nothing
    do KrS7Stage
    exit
  end
  ! ---- stage it, highest position first: KrApply works downwards ----
  logLn  = self.LogLineOf(s4Uz)
  nxPos  = sOpn + 1
  nxPos2 = sCls - 1
  nxKind = 1
  nxTxt  = ''
  do KrPush                                                                            ! drop the whole concatenation
  nxPos  = sOpn
  nxPos2 = sOpn
  nxKind = 3
  nxTxt = '(' & clip(wSrc) & ', ' & clip(bSrc) & ' - ' & wSrc                          ! source spelling. The LAST operand needs no clip: its padding lands at the END of the result and the assignment
                                                                                       !   truncates it away, so a clip there would change nothing. clip() removes TRAILING padding, which sits after the
                                                                                       !   name - if the meaningful text is longer than nxTxt it is cut at the same character either way. Against that
                                                                                       !   truncation the remedy is the WIDTH of nxTxt, which is sized for the worst case; see its declaration.
  do KrPush                                                                            ! '(' becomes '(p, q - p'
  nxPos  = s4Uz
  nxPos2 = s4Uz
  nxKind = 3
  nxTxt  = 'RemoveFromPosition'
  do KrPush                                                                            ! setValue -> RemoveFromPosition
  s4Ok    = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(sRcv) & '.setValue(' & clip(sRcv)   & |
                '.sub(1, ' & clip(wNm) & ' - 1) & ' & clip(sRcv) & '.slice(' & clip(bNm)              & |
                ')) copies the string around a gap - it is .RemoveFromPosition(' & clip(wNm) & ', '   & |
                clip(bNm) & ' - ' & clip(wNm) & '), one move instead of four copies'                  & |
                choose(bVia = '', '', ' - ' & clip(bNm) & ' holds what ' & clip(bVia) & '() returns') & |
                '<13,10>')
  end

! ---- S7: recv.setValue(recv.sub(1, w - 1) & X & recv.slice(b))  ->  recv.RemoveFromPosition(w, b - w)
!                                                                     recv.insert(w, X)
!      S4 with a middle term. The head and the tail are proven exactly as S4 proves them - the same
!      three spellings each, the same guard, w posBound on this receiver and b >= w - and X is whatever
!      sits between the first and the last top-level '&'. Two statements on two lines: the span w..b-1
!      goes, then X goes in at w, which is within the string, so Insert neither prepends nor pads. Two
!      moves where the original allocated for the sub, the slice, the concatenation and the copy.
!      X may not name the receiver (it was read before the setValue ran and would now be read after the
!      removal), and the setValue must be the whole line; either failing is SILENT - the shape is not
!      this one, and S4's own refusals have already had their say. ----
KrS7Stage routine
  data
kz  long,auto
  code
  if s4Uz - 2 <> lineFirst or sCls <> lineLast then exit.
  loop kz = sAmp1 + 1 to sAmpN - 1
    gPos = kz
    do KrGet
    if ~gOk then exit.
    if gTy <> vt:label then cycle.
    if gTU = sRcv then exit.
    if pLog.findChars(clip(sRcv) & '.', 1,, gTU) = 1 then exit. ! recv._DataEnd and the like
  end
  logLn = self.LogLineOf(s4Uz)
  gPos  = lineFirst
  do KrGet                                                      ! the receiver AS WRITTEN - sRcv is upper-cased for matching
  nxPos = sAmpN ; nxPos2 = sCls - 1 ; nxKind = 1 ; nxTxt = ''
  do KrPush                                                     ! drop `& recv.slice(b)`
  nxPos = sOpn + 1 ; nxPos2 = sAmp1 ; nxKind = 1
  do KrPush                                                     ! drop `recv.sub(1, w - 1) &`
  nxPos = sOpn ; nxPos2 = sOpn ; nxKind = 3 ; nxTxt = '(' & clip(wSrc) & ','
  do KrPush                                                     ! '(' becomes '(w,' - X keeps its own leading space (SetTok clips the text)
  nxPos = s4Uz ; nxPos2 = s4Uz ; nxKind = 3 ; nxTxt = 'insert'
  do KrPush                                                     ! setValue -> insert
  nxPos = lineFirst ; nxPos2 = lineFirst ; nxKind = 7
  nxTxt = clip(gTxt) & '.RemoveFromPosition(' & clip(wSrc) & ', ' & clip(bSrc) & ' - ' & clip(wSrc) & ')'
  do KrPush                                                     ! the removal, on its own line above
  s4Ok = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(sRcv) & '.setValue(' & clip(sRcv) & '.sub(1, ' & clip(wNm)       & |
                ' - 1) & X & ' & clip(sRcv) & '.slice(' & clip(bNm) & ')) replaces the span ' & clip(wNm) & '..' & clip(bNm)       & |
                ' - 1 - now RemoveFromPosition(' & clip(wNm) & ', ' & clip(bNm) & ' - ' & clip(wNm) & ') then insert(' & clip(wNm) & |
                ', X), two moves instead of four copies' & choose(bVia = '', '', ' - ' & clip(bNm) & ' holds what ' & clip(bVia) & '() returns') & '<13,10>')
  end

! ---- may this sub() be rewritten from facts taken at the START of the line? ----
!      The same test, and the same reason, as KrChooseCallsOk: ONLY a call that ENCLOSES
!      the sub is safe, because then the sub is computed before that call has any effect.
!      A sibling argument, or a call that completed first, leaves evaluation order to the
!      compiler and q or x may already have been written through a *LONG we cannot see.
!      A separate routine from KrChooseCallsOk, whose span test the S2 fixture pins.
KrSubCallsOk routine
  data
wz  long,auto
  code
  s3CallsOk = 0
  loop wz = lineFirst to lineLast
    gPos = wz
    do KrGet
    ! a call with no brackets runs where it stands, never enclosing
    if gOk and gTxt <> '(' and self.BareCallAt(wz) then exit.
    if ~gOk or         |
       gTxt <> '('
      cycle
    end
    caPos = wz
    do KrCallAt
    if ~caIsCall or    |
       caPure          ! SUB and SLICE are both on the pure list, so the sub itself lands here
      cycle
    end
    mpOpen = wz
    do KrMatchParen
    if ~mpClose   or   |    ! unbalanced - refuse
       wz >= ccLo or   |
       mpClose <= ccHi
      exit
    end
  end
  s3CallsOk = 1

! ---- S14: instring(LIT, clip(x), 1, 1) -> instring(LIT, x[1 : v], 1, 1), and the same for a bare x
!      haystack, when a live fact says v holds len(clip(x)) - seeded by `v = len(clip(x))` and dead
!      the moment either name is written - AND v is proved >= 1. A slice whose end precedes its
!      start is illegal Clarion (a range error, or a silent GPF), so the `if ~v then return.` above
!      is what makes the slice safe; with only the equality the site is left alone and the report
!      says why. The needle must be a literal no longer than the proved length - one character,
!      since >= 1 is all the walk proves - and for the bare-x form not a blank, which could match
!      in the padding clip() would have removed. clip(x) IS x[1 : len(clip(x))], so that form is
!      exact; the slice costs no copy where clip() builds a temporary and scans back for the end.
!      v is written with its declared spelling: the fact holds names in upper case. The instring is
!      the runtime's: one after a '.' is a method of that object, and is left alone. ----
KrTryS14 routine
  data
uz     long,auto
k4     long,auto
c1     long,auto ! the three top-level commas of the call
c2     long,auto
c3     long,auto
cn     long,auto
dp     long,auto
xTok   long,auto ! the haystack's label token
hasCl  byte,auto
lz     long,auto
vKd    byte
lit    string(vs:maxName)
xTxt   string(vs:maxName),auto
xNm    string(vs:maxName),auto
vNm    string(vs:maxName),auto
vSrc   string(vs:maxName),auto
  code
  uz = lineFirst
  loop
    uz += 1
    if uz >= lineLast then break.
    gPos = uz
    do KrGet
    if ~gOk or gTU <> 'INSTRING' then cycle.
    gPos = uz - 1
    do KrGet
    if gOk and gTxt = '.' then cycle.
    gPos = uz + 1
    do KrGet
    if ~gOk or gTxt <> '(' then cycle.
    mpOpen = uz + 1
    do KrMatchParen
    if ~mpClose then cycle.
    c1 = 0 ; c2 = 0 ; c3 = 0 ; cn = 0 ; dp = 0
    loop k4 = mpOpen + 1 to mpClose - 1
      gPos = k4
      do KrGet
      if ~gOk then cycle.
      if gTxt = '(' then dp += 1.
      if gTxt = ')' then dp -= 1.
      if dp or gTxt <> ',' then cycle.
      cn += 1
      case cn
      of 1
        c1 = k4
      of 2
        c2 = k4
      of 3
        c3 = k4
      end
    end
    if cn <> 3 then cycle.                                                          ! four arguments exactly
    if c1 <> mpOpen + 2 then cycle.                                                 ! the needle: ONE literal token
    gPos = mpOpen + 1
    do KrGet
    if ~gOk or gCut or gTy <> vt:literal then cycle.
    lit = gTxt
    if c3 <> c2 + 2 or mpClose <> c3 + 2 then cycle.                                ! the start and the step: each the literal 1
    gPos = c2 + 1
    do KrGet
    if ~gOk or gTxt <> '1' then cycle.
    gPos = c3 + 1
    do KrGet
    if ~gOk or gTxt <> '1' then cycle.
    xTok  = c1 + 1                                                                  ! the haystack: x, or clip ( x )
    hasCl = 0
    if c2 = c1 + 5
      gPos = c1 + 1
      do KrGet
      if ~gOk or gTU <> 'CLIP' then cycle.
      gPos = c1 + 2
      do KrGet
      if ~gOk or gTxt <> '(' then cycle.
      gPos = c1 + 4
      do KrGet
      if ~gOk or gTxt <> ')' then cycle.
      xTok  = c1 + 3
      hasCl = 1
    elsif c2 <> c1 + 2
      cycle
    end
    gPos = xTok
    do KrGet
    if ~gOk or gTy <> vt:label then cycle.
    xTxt = gTxt
    spIn = gTU
    do KrSplitRoot
    if spSuf then cycle.
    xNm = spRoot
    vNm = ''                                                                        ! the LAST live fact that remembers x
    loop lz = records(KrFactQ) to 1 by -1
      get(KrFactQ, lz)
      if errorcode() then cycle.
      if kv:kvClip = xNm then vNm = kv:kvName ; vKd = kv:kvKind ; break.
    end
    if ~vNm then cycle.                                                             ! nothing remembered - the common case, silently
    lz = self.syms.FindSym(vNm, sc)                                                 ! v as the author spelled it
    if ~lz then cycle.
    get(self.syms.syms, lz)
    if errorcode() then cycle.
    vSrc = self.tk.GetTok(self.syms.syms.declTok)
    if vKd <> rk:posBound
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(uz) & ': instring over ' & clip(xTxt) & ' left alone - ' & clip(vSrc) & |
                  ' holds len(clip(' & clip(xTxt) & ')) but is not proved >= 1, and ' & clip(xTxt) & '[1 : 0] would be illegal<13,10>')
      cycle
    end
    if len(clip(lit)) <> 3                                                          ! a one-character needle is quote, character, quote
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(uz) & ': instring over ' & clip(xTxt) & ' left alone - the needle ' & clip(lit) & |
                  ' is longer than the one character ' & clip(vSrc) & ' is proved to hold<13,10>')
      cycle
    end
    if ~hasCl and lit[2] = ' '
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(uz) & ': instring over ' & clip(xTxt) & ' left alone - a blank needle could match ' & |
                  'in the padding that clip() would have removed<13,10>')
      cycle
    end
    nxTxt = clip(xTxt) & '[1 : ' & clip(vSrc) & ']'
    if hasCl
      nxPos = c1 + 2 ; nxPos2 = c1 + 4 ; nxKind = 1
      do KrPush                                                                     ! ( x ) after CLIP go
      nxPos = c1 + 1 ; nxPos2 = c1 + 1 ; nxKind = 3
      do KrPush                                                                     ! CLIP becomes x[1 : v], keeping its own leading space
    else
      nxPos = xTok ; nxPos2 = xTok ; nxKind = 3
      do KrPush
    end
    changes += 1
    if changes = 501
      pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
    end
    if changes <= 500
      pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(uz) & ': instring reads ' & clip(nxTxt) & ' - ' & clip(vSrc) & |
                  ' holds len(clip(' & clip(xTxt) & ')) and is proved >= 1<13,10>')
    end
    break                                                                           ! one per line
  end

! ---- S9: recv.sub(q, 1) and recv.slice(q, q) -> recv.valuePtr[q];  recv.slice(q, x) -> recv.valuePtr[q : x]
!      valuePtr is StringTheory's own reference to its buffer, so the subscript reads the character in
!      place where Sub and Slice each allocate and copy. The two spellings agree ONLY inside the string:
!      outside it Sub and Slice return '' where a subscript is a bounds error. So q (and x) must be
!      posBound ON THIS RECEIVER, and for [q : x] x must be known to be >= q - the relational fact S4
!      uses. Sub's length must be the literal 1; Slice's end must BE its start, or a local.
!      A BARE SLICE IS A VARIABLE REFERENCE. StringTheory overloads methods such as Append as both
!      (string) and (*string), so a slice handed to a call as a WHOLE ARGUMENT could bind the
!      by-reference form and give the callee a view of a buffer it is about to grow - the hazard the
!      getvalue-form rules wrap in choose() for. The read is therefore refused when it is a whole
!      argument of any call other than a Clarion built-in that takes strings by value, or a
!      StringTheory method of the same name, which only reads it (KrS9Context).
!      Inside a larger expression - `x & st.sub(q, 1)`, `st.sub(q, 1) = ','` - the value is computed
!      first and only the copy travels, so those are taken. ----
KrTryS9 routine
  data
uz  long,auto
  code
  uz = lineFirst + 1
  loop
    uz += 1
    if uz >= lineLast then break.
    gPos = uz
    do KrGet
    if ~gOk            or                |
       gTy <> vt:label or                |   ! SUB and SLICE both type as labels
       (gTU <> 'SUB' and gTU <> 'SLICE')
      cycle
    end
    s9Meth = gTU
    gPos = uz + 1
    do KrGet
    if ~gOk or                           |
       gTxt <> '('
      cycle
    end
    gPos = uz - 1
    do KrGet
    if ~gOk or                           |
       gTxt <> '.'
      cycle
    end
    gPos = uz - 2
    do KrGet
    if ~gOk or                           |
       gTy <> vt:label
      cycle
    end
    spIn = gTU
    do KrSplitRoot
    if spSuf then cycle.                 ! self.st.sub(...) - not a simple local receiver
    okName = spRoot
    do KrRecvOk
    if ~okRes then cycle.
    s9Recv = okName
    s9Tok  = uz
    s9Open = uz + 1
    mpOpen = s9Open
    do KrMatchParen
    if ~mpClose then cycle.
    s9Close = mpClose
    do KrS9One
    if s9Done then uz = s9Close.         ! never descend into a span we are already rewriting
  end

! ---- one read: prove the shape, the facts and the context, then stage the retype ----
KrS9One routine
  data
oz    long,auto
od    long,auto
onc   long,auto ! top-level commas
isOne byte,auto ! the one-character form, [q]
qNm   string(vs:maxName),auto
xNm   string(vs:maxName)
qVia  string(vs:maxName),auto
  code
  s9Done = 0
  s9Why  = ''
  ! ---- 1. EXACTLY one top-level comma, and ONE token on each side of it
  onc   = 0
  od    = 0
  s9Com = 0
  loop oz = s9Open + 1 to s9Close - 1
    gPos = oz
    do KrGet
    if ~gOk then exit.
    if gTxt = '('
      od += 1
    elsif gTxt = ')'
      od -= 1
      if od < 0 then exit.
    elsif ~od and gTxt = ','
      onc += 1
      s9Com = oz
    end
  end
  if onc <> 1            or                                                          |
     s9Com <> s9Open + 2 or                                                          |
     s9Close <> s9Com + 2
    exit
  end
  ! ---- 2. the start: a local holding posBound on THIS receiver
  gPos = s9Open + 1
  do KrGet
  if ~gOk or                                                                         |
     gTy <> vt:label
    exit
  end
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.                                                                ! a member read carries no fact
  fName = spRoot
  do KrFind
  qNm  = fName
  qVia = fVia
  if fKind = rk:none then exit.                                                      ! no fact at all: not a shape worth a line
  if fKind <> rk:posBound or                                                         |
     fRecv <> s9Recv
    s9Why = clip(qNm) & ' is not known to be 1..' & clip(s9Recv) & '._DataEnd here'
    do KrS9Refuse
    exit
  end
  ! ---- 3. the end: the literal 1 (sub), the start again (slice), or a local >= the start (slice)
  isOne = 0
  gPos  = s9Com + 1
  do KrGet
  if ~gOk then exit.
  if s9Meth = 'SUB'
    if gTxt <> '1' then exit.                                                        ! a longer sub is not one character
    isOne = 1
  elsif self.SpanTokEqual(s9Com + 1, s9Com + 1, s9Open + 1, s9Open + 1)
    isOne = 1
  else
    if gTy <> vt:label then exit.
    spIn = gTU
    do KrSplitRoot
    if spSuf then exit.
    fName = spRoot
    do KrFind
    xNm = fName
    if fKind <> rk:posBound or                                                       |
       fRecv <> s9Recv
      s9Why = clip(xNm) & ' is not known to be 1..' & clip(s9Recv) & '._DataEnd here'
      do KrS9Refuse
      exit
    end
    if fGeVar <> qNm
      s9Why = 'nothing says ' & clip(xNm) & ' >= ' & qNm
      do KrS9Refuse
      exit
    end
  end
  ! ---- 4. the context: a whole argument of a call could bind by reference
  do KrS9Context
  if ~s9CtxOk
    do KrS9Refuse
    exit
  end
  ! ---- 5. trivia and evaluation order, exactly as S3
  tcS = s9Open
  tcE = s9Close
  do KrTriviaClean
  if ~tcOk then exit.
  ccLo = s9Tok
  ccHi = s9Close
  do KrSubCallsOk
  if ~s3CallsOk then exit.
  ! ---- 6. stage it. Every edit names its own token, so their order here does not matter;
  !         KrApply works downwards and the delete sits above everything it could move.
  logLn  = self.LogLineOf(s9Tok)
  nxPos  = s9Close
  nxPos2 = s9Close
  nxKind = 3
  nxTxt  = ']'
  do KrPush                                                                          ! ) -> ]
  nxPos  = s9Com
  if isOne
    nxPos2 = s9Close - 1
    nxKind = 1
    nxTxt  = ''
    do KrPush                                                                        ! drop `, 1` / `, q`
  else
    nxPos2 = s9Com
    nxKind = 3
    nxTxt  = ':'
    do KrPush                                                                        ! , -> :
    nxKind = 6
    do KrPush                                                                        ! ... with a space in front of it
  end
  nxPos  = s9Open
  nxPos2 = s9Open
  nxKind = 3
  nxTxt  = '['
  do KrPush                                                                          ! ( -> [
  nxPos  = s9Tok
  nxPos2 = s9Tok
  nxTxt  = 'valuePtr'
  do KrPush                                                                          ! sub / slice -> valuePtr
  s9Done = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  viaTxt = ''
  if qVia then viaTxt = ' - ' & clip(qNm) & ' holds what ' & clip(qVia) & '() returns'.
  if changes <= 500
    if isOne
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(s9Recv) & '.' & lower(clip(s9Meth)) & '(' & clip(qNm)     & |
                  ', ' & choose(s9Meth = 'SUB', '1', clip(qNm)) & ') is one character read in place as valuePtr[' & clip(qNm) & |
                  '] - ' & clip(qNm) & ' is 1.._DataEnd' & clip(viaTxt) & '<13,10>')
    else
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(s9Recv) & '.slice(' & clip(qNm) & ', ' & clip(xNm)         & |
                  ') is the span read in place as valuePtr[' & clip(qNm) & ' : ' & clip(xNm) & '] - both are 1.._DataEnd and ' & |
                  clip(xNm) & ' >= ' & clip(qNm) & clip(viaTxt) & '<13,10>')
    end
  end

! ---- the context test: the read may not be a WHOLE ARGUMENT of a call that could take it by
!      reference. Bounded by '(' or ',' before and ',' or ')' after, it is an argument; then
!      the opener it belongs to is found by walking back at depth 0, and KrCallAt says whose it
!      is. Grouping parentheses are not a call. Clarion's own string functions take a copy, and
!      StringTheory's methods of those names only read their argument; a method of the same name
!      on any other object - other.Clip(...) - may write it, and refuses (ruled 28 Oct 2026). ----
KrS9Context routine
  data
cz  long,auto
cd  long,auto
  code
  s9CtxOk = 1
  gPos = s9Close + 1
  do KrGet
  if ~gOk then exit.                        ! nothing after it: not an argument
  if gTxt <> ',' and gTxt <> ')' then exit. ! an operator follows: part of an expression
  gPos = s9Tok - 3
  do KrGet
  if ~gOk then exit.
  if gTxt <> ',' and gTxt <> '(' then exit. ! an operator precedes: part of an expression
  cd = 0
  cz = s9Tok - 3
  loop
    if cz < lineFirst then exit.            ! no opener on this line
    gPos = cz
    do KrGet
    if ~gOk then exit.
    if gTxt = ')' then cd += 1.
    if gTxt = '('
      if ~cd then break.
      cd -= 1
    end
    cz -= 1
  end
  caPos = cz
  do KrCallAt
  if ~caIsCall then exit.                   ! grouping parentheses: a value
  if caDot and self.HayType(self.tk.GetTok(caPos - 3), caPos - 3) <> 'STRINGTHEORY'
    s9CtxOk = 0
    s9Why   = 'a whole argument of the method ' & lower(clip(caName)) & '() - a slice there could bind by reference'
    exit
  end
  if instring(' ' & clip(caName) & ' ', ' CHOOSE UPPER LOWER CLIP LEFT RIGHT CENTER ALL LEN INSTRING VAL SUB INLIST NUMERIC FORMAT DEFORMAT ', 1, 1) then exit.
  s9CtxOk = 0
  s9Why   = 'a whole argument of ' & clip(caName) & '() - a slice there could bind by reference'

KrS9Refuse routine
  s4Refs += 1
  if s4Refs > 20 then exit.
  pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(s9Tok) & ': in-place read REFUSED on ' & |
              clip(s9Recv) & '.' & lower(clip(s9Meth)) & '(...) - ' & clip(s9Why) & '<13,10>')

! ---- S5: recv.setValue(recv.sub(1, w) & X & recv.slice(w + 1))  ->  recv.insert(w + 1, X)
!      The head keeps 1..w, the tail keeps w+1..end and X sits between them: an INSERT at w + 1.
!      StringTheory.Insert(pStart, str) prepends for pStart < 1, appends for pStart = _DataEnd + 1
!      and PADS WITH SPACES for anything past that, so the two spellings agree only while
!      w <= _DataEnd - which is what rk:zeroBound and rk:posBound ON THIS RECEIVER say. A rule
!      cannot know that, which is why this lives here and not in the rule file. The head may be
!      sub(1, w) or slice(1, w), the same span from a start of 1. X is whatever sits between the
!      first and the last top-level '&', any number of terms, and it may not call anything impure
!      (KrSubCallsOk): in the original a call there ran between the two reads of the receiver.
!      A '|' continuation inside the head or the tail is rejoined, and a comment riding it is
!      carried to the end of the line - in FRONT of the line's own comment, so the two read in
!      source order - rather than lost. A continuation inside the kept middle term is rejoined the
!      same way when the rewritten statement fits the width policy (self.splitWidth, the limit
!      SplitWideLines works to); a wrap the author needed stays, and so does its comment. ----
KrTryS5 routine
  s5Ok = 0
  s5Uz = lineFirst + 1
  loop
    s5Uz += 1
    if s5Uz >= lineLast then break.
    gPos = s5Uz
    do KrGet
    if ~gOk            or |
       gTy <> vt:label or |
       gTU <> 'SETVALUE'
      cycle
    end
    gPos = s5Uz - 1
    do KrGet
    if ~gOk or            |
       gTxt <> '.'
      cycle
    end
    gPos = s5Uz - 2
    do KrGet
    if ~gOk or            |
       gTy <> vt:label
      cycle
    end
    spIn = gTU
    do KrSplitRoot
    sRcv = gTU            ! the receiver WHOLE, dotted or not, as S4 compares it
    if ~spSuf
      okName = sRcv
      do KrRecvOk
      if ~okRes then cycle.
    else
      okName = sRcv ; okPos = s5Uz - 2
      do KrDotRecvOk
      if ~okRes then cycle.
    end
    gPos = s5Uz + 1
    do KrGet
    if ~gOk or            |
       gTxt <> '('
      cycle
    end
    sOpn   = s5Uz + 1
    mpOpen = sOpn
    do KrMatchParen
    if ~mpClose then cycle.
    sCls = mpClose
    do KrS5Shape
    if s5Ok then break.
    do KrS6Shape          ! S5 did not stage it: the one-sided shapes
    if s6Ok then break.
  end

! ---- the shape: <recv>.sub|slice(1, <w>) & X & <recv>.slice(<w> + 1), then the guard, then the edits ----
KrS5Shape routine
  data
kz   long,auto
dz   long
  code
  s5Ok = 0 ; s5Why = '' ; s5Amp1 = 0 ; s5AmpN = 0
  loop kz = sOpn + 1 to sCls - 1                                                     ! the first and the last top-level '&'
    gPos = kz
    do KrGet
    if ~gOk then cycle.
    if gTxt = '(' then dz += 1.
    if gTxt = ')' then dz -= 1.
    if dz then cycle.
    if gTxt = '&'
      if ~s5Amp1 then s5Amp1 = kz.
      s5AmpN = kz
    end
  end
  if ~s5Amp1 or s5AmpN = s5Amp1 then exit.                                           ! not `head & X & tail` - SILENT, most setValues are not
  ! ---- head: recv . sub|slice ( 1 , w )  -  eight tokens ending right before the first '&'
  if s5Amp1 <> sOpn + 9 then exit.
  gPos = sOpn + 1 ; do KrGet ; if gTU <> sRcv then exit.
  gPos = sOpn + 2 ; do KrGet ; if gTxt <> '.' then exit.
  gPos = sOpn + 3 ; do KrGet ; if gTU <> 'SUB' and gTU <> 'SLICE' then exit.
  gPos = sOpn + 4 ; do KrGet ; if gTxt <> '(' then exit.
  gPos = sOpn + 5 ; do KrGet ; if gTxt <> '1' then exit.
  gPos = sOpn + 6 ; do KrGet ; if gTxt <> ',' then exit.
  gPos = sOpn + 7 ; do KrGet ; if gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.
  wNm    = spRoot
  s5WSrc = gTxt
  gPos = sOpn + 8 ; do KrGet ; if gTxt <> ')' then exit.
  ! ---- tail: recv . slice ( w + 1 )  -  eight tokens from right after the last '&' to the close
  if sCls - 1 <> s5AmpN + 8 then exit.
  gPos = s5AmpN + 1 ; do KrGet ; if gTU <> sRcv then exit.
  gPos = s5AmpN + 2 ; do KrGet ; if gTxt <> '.' then exit.
  gPos = s5AmpN + 3 ; do KrGet ; if gTU <> 'SLICE' then exit.
  gPos = s5AmpN + 4 ; do KrGet ; if gTxt <> '(' then exit.
  if ~self.SpanTokEqual(sOpn + 7, sOpn + 7, s5AmpN + 5, s5AmpN + 5) then exit.       ! the same w in both places
  gPos = s5AmpN + 6 ; do KrGet ; if gTxt <> '+' then exit.
  gPos = s5AmpN + 7 ; do KrGet ; if gTxt <> '1' then exit.
  gPos = s5AmpN + 8 ; do KrGet ; if gTxt <> ')' then exit.
  ! ---- the guard: w is 0.._DataEnd or 1.._DataEnd ON THIS RECEIVER, so w + 1 is at most
  !      _DataEnd + 1 and Insert appends rather than pads. From here a refusal is worth saying.
  fName = wNm
  do KrFind
  if fKind <> rk:zeroBound and fKind <> rk:posBound
    s5Why = clip(wNm) & ' is not known to be within ' & clip(sRcv) & ' here - it holds ' & |
            choose(fKind = rk:none, 'NO fact at all (killed, or never established)', 'nonNeg - 0 or more, not bounded by a receiver')
    do KrS5Refuse
    exit
  end
  if fRecv <> sRcv
    s5Why = clip(wNm) & ' is bounded by ' & choose(fRecv = '', '(nothing)', clip(fRecv)) & ', not ' & sRcv
    do KrS5Refuse
    exit
  end
  ! ---- evaluation order, exactly as S3 and S4: nothing impure inside the argument list
  ccLo = sOpn + 1
  ccHi = sCls - 1
  do KrSubCallsOk
  if ~s3CallsOk
    s5Why = 'a call inside the argument list may move ' & clip(sRcv) & ' between its two reads'
    do KrS5Refuse
    exit
  end
  do KrMarked
  if mkWhy
    s5Why = mkWhy
    do KrS5Refuse
    exit
  end
  ! ---- trivia: a continuation inside a deleted span is rejoined and its comment carried; anything else refuses
  s5Cmt.free()
  tcS = sOpn + 2 ; tcE = s5Amp1
  do KrS5Carry
  if ~tcOk then exit.
  do KrS5Join                                                                        ! the middle term: rejoin a continuation there too, if the result fits
  if ~tcOk then exit.
  tcS = s5AmpN ; tcE = sCls - 1
  do KrS5Carry
  if ~tcOk then exit.
  if s5Cmt._DataEnd
    if lineEol <> lineLast + 1 then exit.                                            ! no EOL token to carry it to - refuse rather than lose it
    if s5Cmt._DataEnd > 700 then exit.                                               ! longer than the staged text holds - refuse rather than cut
  end
  ! ---- stage it, highest position first
  logLn = self.LogLineOf(s5Uz)
  if s5Cmt._DataEnd
    nxPos = lineEol ; nxPos2 = lineEol ; nxKind = 5 ; nxTxt = s5Cmt.getValue()
    do KrPush                                                                        ! the carried comment(s), after the line's own
  end
  nxPos = s5AmpN ; nxPos2 = sCls - 1 ; nxKind = 1 ; nxTxt = ''
  do KrPush                                                                          ! drop `& recv.slice(w + 1)`
  if s5Join then do KrS5JoinStage.                                                   ! every continuation inside the middle term becomes one space
  nxPos = sOpn + 2 ; nxPos2 = s5Amp1 ; nxKind = 1
  do KrPush                                                                          ! drop `.sub(1, w) &`
  nxPos = sOpn + 1 ; nxPos2 = sOpn + 1 ; nxKind = 3 ; nxTxt = clip(s5WSrc) & ' + 1,'
  do KrPush                                                                          ! the head's receiver token becomes `w + 1,`
  nxPos = s5Uz ; nxPos2 = s5Uz ; nxKind = 3 ; nxTxt = 'insert'
  do KrPush                                                                          ! setValue -> insert
  s5Ok = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  if changes <= 500
    pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(sRcv) & '.setValue(' & clip(sRcv) & '.sub(1, ' & clip(wNm) & |
                ') & ... & ' & clip(sRcv) & '.slice(' & clip(wNm) & ' + 1)) copies the string around an insertion - it is '  & |
                clip(sRcv) & '.insert(' & clip(wNm) & ' + 1, ...)<13,10>')
  end

! ---- S6: recv.setValue(recv.sub|slice(1, w) & X)  ->  recv.setLength(w)            then  recv.append(X)
!         recv.setValue(X & recv.slice(w + 1))       ->  recv.RemoveFromPosition(1, w)  then  recv.prepend(X)
!      Truncate-and-append, and its mirror, as two statements on two lines: the copy of the head (or
!      of the tail) and the concatenation both go, and the buffer is edited in place. Sound while
!      w <= _DataEnd: setLength PADS past _DataEnd where the sub stopped (Insert's hazard again), and
!      RemoveFromPosition(1, w) would take what slice(w + 1) never had - which is what zeroBound and
!      posBound ON THIS RECEIVER say. X may not name the receiver: in the original it was read before
!      the setValue ran, and it would now be read after the truncation. X carries no continuation and
!      calls nothing impure (KrSubCallsOk); it moves to the second statement exactly as it stands.
!      The statement must be the whole line. Reached from S5's scan when S5 did not stage the line;
!      S5's own shape - head AND tail - names the receiver on the far side and fails here silently. ----
KrS6Shape routine
  data
kz     long,auto
s6Head byte,auto               ! 1 = head form, 0 = tail form
s6WTok long                    ! the w token
s6X1   long                    ! X, first token ..
s6XN   long                    ! .. and last
s6WSrc string(vs:maxName),auto ! w as written
s6Nm   string(vs:maxName),auto ! w's root, for the fact and the log
s6Rcv  string(vs:maxName),auto ! the receiver as the author spelled it
  code
  s6Ok  = 0
  s6Why = ''
  if sOpn - 3 <> lineFirst or sCls <> lineLast then exit.                            ! the setValue must be the whole line
  ! ---- head form: recv . sub|slice ( 1 , w ) & X   -  the head is eight tokens ending right before the FIRST '&'
  s6Head = 0
  if s5Amp1 = sOpn + 9
    gPos = sOpn + 1 ; do KrGet ; if gTU <> sRcv then exit.
    gPos = sOpn + 2 ; do KrGet ; if gTxt <> '.' then exit.
    gPos = sOpn + 3 ; do KrGet ; if gTU <> 'SUB' and gTU <> 'SLICE' then exit.
    gPos = sOpn + 4 ; do KrGet ; if gTxt <> '(' then exit.
    gPos = sOpn + 5 ; do KrGet ; if gTxt <> '1' then exit.
    gPos = sOpn + 6 ; do KrGet ; if gTxt <> ',' then exit.
    gPos = sOpn + 8 ; do KrGet ; if gTxt <> ')' then exit.
    s6Head = 1
    s6WTok = sOpn + 7
    s6X1   = s5Amp1 + 1
    s6XN   = sCls - 1
  elsif s5AmpN = sCls - 9
    ! ---- tail form: X & recv . slice ( w + 1 )   -  the tail is eight tokens from after the LAST '&' to the close
    gPos = s5AmpN + 1 ; do KrGet ; if gTU <> sRcv then exit.
    gPos = s5AmpN + 2 ; do KrGet ; if gTxt <> '.' then exit.
    gPos = s5AmpN + 3 ; do KrGet ; if gTU <> 'SLICE' then exit.
    gPos = s5AmpN + 4 ; do KrGet ; if gTxt <> '(' then exit.
    gPos = s5AmpN + 6 ; do KrGet ; if gTxt <> '+' then exit.
    gPos = s5AmpN + 7 ; do KrGet ; if gTxt <> '1' then exit.
    gPos = s5AmpN + 8 ; do KrGet ; if gTxt <> ')' then exit.
    s6WTok = s5AmpN + 5
    s6X1   = sOpn + 1
    s6XN   = s5AmpN - 1
  else
    exit
  end
  if s6XN < s6X1 then exit.                                                          ! nothing to append / prepend
  gPos = s6WTok ; do KrGet ; if gTy <> vt:label then exit.
  spIn = gTU
  do KrSplitRoot
  if spSuf then exit.
  s6Nm   = spRoot
  s6WSrc = gTxt
  ! ---- X may not name the receiver, or a member of it: SILENT, it is not this shape
  loop kz = s6X1 to s6XN
    gPos = kz
    do KrGet
    if ~gOk then exit.
    if gTy <> vt:label then cycle.
    if gTU = sRcv then exit.
    if pLog.findChars(clip(sRcv) & '.', 1,, gTU) = 1 then exit.                      ! recv._DataEnd and the like
  end
  ! ---- the guard: w is 0.._DataEnd or 1.._DataEnd ON THIS RECEIVER
  fName = s6Nm
  do KrFind
  if fKind <> rk:zeroBound and fKind <> rk:posBound
    s6Why = clip(s6Nm) & ' is not known to be within ' & clip(sRcv) & ' here - it holds ' & |
            choose(fKind = rk:none, 'NO fact at all (killed, or never established)',        |
            choose(fKind = rk:nonNeg, 'nonNeg - 0 or more, not bounded by a receiver', 'some other kind'))
    do KrS6Refuse
    exit
  end
  if fRecv <> sRcv
    s6Why = clip(s6Nm) & ' is bounded by ' & choose(fRecv = '', '(nothing)', clip(fRecv)) & ', not ' & sRcv
    do KrS6Refuse
    exit
  end
  ! ---- evaluation order and trivia, as S3 and S4
  ccLo = sOpn + 1
  ccHi = sCls - 1
  do KrSubCallsOk
  if ~s3CallsOk
    s6Why = 'a call inside the argument list may move ' & clip(sRcv) & ' before the second statement reads it'
    do KrS6Refuse
    exit
  end
  do KrMarked
  if mkWhy
    s6Why = mkWhy
    do KrS6Refuse
    exit
  end
  tcS = sOpn
  tcE = sCls
  do KrTriviaClean
  if ~tcOk
    s6Why = 'a comment or a continuation inside the statement'
    do KrS6Refuse
    exit
  end
  ! ---- stage it. The new line goes in front of the line's first token - the lowest position, so
  !      KrApply places it last, after every other edit on the line has been made.
  logLn = self.LogLineOf(s5Uz)
  gPos  = lineFirst
  do KrGet                                                                           ! the receiver AS WRITTEN - sRcv is upper-cased for matching
  s6Rcv = gTxt
  if s6Head
    nxPos = s6X1 ; nxPos2 = sOpn + 1 ; nxKind = 2 ; nxTxt = ''
    do KrPush                                                                        ! X's first token takes the head's spacing: none
    nxPos = sOpn + 1 ; nxPos2 = s5Amp1 ; nxKind = 1
    do KrPush                                                                        ! drop `recv.sub(1, w) &`
    nxPos = s5Uz ; nxPos2 = s5Uz ; nxKind = 3 ; nxTxt = 'append'
    do KrPush                                                                        ! setValue -> append
    nxPos = lineFirst ; nxPos2 = lineFirst ; nxKind = 7 ; nxTxt = clip(s6Rcv) & '.setLength(' & clip(s6WSrc) & ')'
  else
    nxPos = s5AmpN ; nxPos2 = sCls - 1 ; nxKind = 1 ; nxTxt = ''
    do KrPush                                                                        ! drop `& recv.slice(w + 1)`
    nxPos = s5Uz ; nxPos2 = s5Uz ; nxKind = 3 ; nxTxt = 'prepend'
    do KrPush                                                                        ! setValue -> prepend
    nxPos = lineFirst ; nxPos2 = lineFirst ; nxKind = 7 ; nxTxt = clip(s6Rcv) & '.RemoveFromPosition(1, ' & clip(s6WSrc) & ')'
  end
  do KrPush
  s6Ok = 1
  changes += 1
  if changes = 501
    pLog.append('BUILTIN KnownRanges: further detail lines suppressed (500 shown)<13,10>')
  end
  if changes <= 500
    if s6Head
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(sRcv) & '.setValue(' & clip(sRcv) & '.sub(1, ' & clip(s6WSrc) & |
                  ') & X) truncates and appends - now setLength(' & clip(s6WSrc) & ') then append(X), no copy of the head - '     & |
                  clip(s6Nm) & ' is within ' & clip(sRcv) & '<13,10>')
    else
      pLog.append('BUILTIN KnownRanges line ' & logLn & ': ' & clip(sRcv) & '.setValue(X & ' & clip(sRcv) & '.slice(' & clip(s6WSrc)             & |
                  ' + 1)) drops the head and prepends - now RemoveFromPosition(1, ' & clip(s6WSrc) & ') then prepend(X), no copy of the tail - ' & |
                  clip(s6Nm) & ' is within ' & clip(sRcv) & '<13,10>')
    end
  end

KrS6Refuse routine
  s4Refs += 1
  if s4Refs > 20 then exit.
  pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(s5Uz) & ': truncate-and-append REFUSED on ' & |
              clip(sRcv) & '.setValue(...) - ' & clip(s6Why) & '<13,10>')

! ---- the trivia of tcS..tcE, which is about to be deleted: plain spacing passes; a '|' continuation
!      passes and any comment riding it is collected into s5Cmt - a '!' and what follows it, or the
!      words written after the bar, which the compiler ignores as it does a comment (TriviaCmtRows).
!      The rows of one wrapped comment join as one comment, later rows dropping their marker
!      (CmtRowsJoin); a comment or a line break that is
!      not a continuation refuses (tcOk = 0), as it does everywhere else in this builtin ----
KrS5Carry routine
  data
cz   long,auto
cmt  StringTheory
  code
  tcOk = 0
  loop cz = tcS to tcE
    get(self.tk.tokens, cz)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if ~cmt.findByte(10, 1,, self.tk.tokens.strBefore)             ! <line feed>
      if cmt.findByte(33, 1,, self.tk.tokens.strBefore) then exit. ! a comment with no line break is not a shape this reads  ! '!'
      cycle
    end
    if ~cmt.findByte(124, 1,, self.tk.tokens.strBefore) then exit. ! a line break that is not a continuation - absorbed OMIT text, say  ! '|'
    cmt.free()
    if ~self.TriviaCmtRows(cz, cmt) then cycle.
    self.CmtRowsJoin(cmt, s5Cmt)
  end
  tcOk = 1

! ---- the middle term, s5Amp1 + 1 .. s5AmpN - 1, which is KEPT: does it hold a '|' continuation, and if so would
!      the rewritten statement fit on one line? s5Join says; a comment riding a rejoined continuation joins s5Cmt.
!      Not rejoined - the wrap stays, comment and all - when there is no width policy or the line would pass it.
!      A line break that is not a continuation refuses S5 outright, as it does in the deleted spans. ----
KrS5Join routine
  data
jz   long,auto
jc   long,auto
cmt  StringTheory
  code
  tcOk   = 0
  s5Join = 0
  s5Wid  = 0
  loop jz = s5Amp1 + 1 to s5AmpN - 1                                 ! is there one at all?
    get(self.tk.tokens, jz)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if cmt.findByte(10, 1,, self.tk.tokens.strBefore)                ! <line feed>
      if ~cmt.findByte(124, 1,, self.tk.tokens.strBefore) then exit. ! a line break that is not a continuation - refuse  ! '|'
      s5Join = 1
    elsif cmt.findByte(33, 1,, self.tk.tokens.strBefore)             ! '!'
      exit                                                           ! a comment with no line break - refuse
    end
  end
  if s5Join
    get(self.tk.tokens, lineFirst)                                   ! the statement's indent: the trivia after the last line feed
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      jc = 0
      loop jz = 1 to size(self.tk.tokens.strBefore)
        if self.tk.tokens.strBefore[jz] = '<10>' then jc = jz.
      end
      s5Wid = size(self.tk.tokens.strBefore) - jc
    end
    s5Wid += len(clip(sRcv)) + 8 + len(clip(s5WSrc)) + 5 + 1         ! recv  .insert(  w + 1,  )
    loop jz = s5Amp1 + 1 to s5AmpN - 1
      get(self.tk.tokens, jz)
      if errorcode() then exit.
      if self.tk.tokens.tok &= NULL then cycle.
      s5Wid += size(self.tk.tokens.tok)
      if self.tk.tokens.strBefore &= NULL then cycle.
      if cmt.findByte(10, 1,, self.tk.tokens.strBefore)              ! <line feed>
        s5Wid += 1                                                   ! the continuation becomes one space
      else
        s5Wid += size(self.tk.tokens.strBefore)
      end
    end
    if self.splitWidth < 1 or s5Wid > self.splitWidth                ! no policy, or too wide: the author's wrap stays
      s5Join = 0
    else
      loop jz = s5Amp1 + 1 to s5AmpN - 1                             ! collect the comments the rejoin would drop
        cmt.free()
        if ~self.TriviaCmtRows(jz, cmt) then cycle.
        self.CmtRowsJoin(cmt, s5Cmt)
      end
    end
  end
  tcOk = 1

! ---- stage the rejoin: every token of the middle term that starts a continuation row gets a one-space gap ----
KrS5JoinStage routine
  data
sz   long,auto
  code
  loop sz = s5Amp1 + 1 to s5AmpN - 1
    get(self.tk.tokens, sz)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if ~pLog.findByte(10, 1,, self.tk.tokens.strBefore) then cycle. ! <line feed>
    nxPos = sz ; nxPos2 = sz ; nxKind = 6 ; nxTxt = ''
    do KrPush
  end

! ---- S5 matched the SHAPE but a guard said no - say so, capped with S4's refusals ----
KrS5Refuse routine
  s4Refs += 1
  if s4Refs > 20 then exit.
  pLog.append('BUILTIN KnownRanges line ' & self.LogLineOf(s5Uz) & ': insert REFUSED on ' & |
              clip(sRcv) & '.setValue(...) - ' & clip(s5Why) & '<13,10>')

! ---- is okName a simple scalar INTEGER local of scope sc? ----
KrLocalOk routine
  data
lz  long,auto
  code
  okRes = 0
  if ~okName then exit.
  lz = self.syms.FindSym(okName, sc)                   ! scope sc only - a module-level or outer name is not ours
  if ~lz then exit.
  get(self.syms.syms, lz)
  if errorcode() then exit.
  if self.syms.syms.isRef then exit.
  if self.syms.syms.isLike then exit.
  if self.syms.syms.isField then exit.
  case self.syms.syms.typeU
  of 'LONG' orof 'ULONG' orof 'SIGNED' orof 'UNSIGNED'
    ! an integer position variable - ok. A SHORT, USHORT or BYTE is not: a position or a length
    ! past its range wraps on the store, and a SHORT holding 40000 is negative
  else
    exit                                         ! REAL/DECIMAL/STRING/... are not what these seeds produce
  end
  okDecl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(okDecl) then exit. ! a PARAMETER is not a column-1 declaration
  if band(self.DeclAttrBits(okDecl), ab:over + ab:dim + ab:static + ab:thread) then exit.
  ! *** AND A SIBLING DECLARED OVER(V) IS THE FIFTH SPELLING OF V'S STORAGE. *** The line above
  ! asks whether THIS variable is an alias; it does not ask whether something else aliases it.
  ! With `p LONG` and `sh SHORT,OVER(p)`, writing sh writes p - so a fact about p can be true
  ! when it is recorded and false by the time it is used, and the guard it justified deleting
  ! was load-bearing. Measured: `p = st.findByte(61) ; sh = -5 ; if p >= 0 then f = 1.` lost its
  ! guard while p was -5. AutoCheck asks this same question of its own candidates.
  if self.HasSiblingOver(lz, okName) then exit.
  ! AND THE OTHER NAMES FOR IT: a reference pointed at it (`rp &= p`, then `rp = -5`) or a method of a
  ! class the procedure declares writes it without this walk seeing its name; a control's USE(), an
  ! INCLUDE or an escaped address reads or writes it where the code does not say.
  alName = okName ; do KrAliased
  if alRes then exit.
  if self.UnseenRead(okName) then exit.
  if self.MayHaveLocalMethods(sc)
    get(self.syms.scopes, sc)
    if ~errorcode()
      if self.UsedInLocalMethods(okName, self.syms.scopes.startTok, self.syms.scopes.endTok) then exit.
    end
  end
  okRes = 1

! ---- is okName a simple LOCAL StringTheory of scope sc? ----
KrRecvOk routine
  data
rz  long,auto
  code
  okRes = 0
  if ~okName then exit.
  rz = self.syms.FindSym(okName, sc)  ! module-level receivers are out: a call this walk cannot see
  if ~rz then exit.                   !   could move their _DataEnd without naming them here
  get(self.syms.syms, rz)
  if errorcode() then exit.
  if self.syms.syms.isRef then exit.  ! `st &= other` re-points a reference and carries no call
  if self.syms.syms.isLike then exit.
  if self.syms.syms.isField then exit.
  if self.syms.syms.typeU <> 'STRINGTHEORY' then exit.
  okDecl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(okDecl) then exit.
  ! STATIC and THREAD are shared with every other call - a recursive one frees it unseen
  if band(self.DeclAttrBits(okDecl), ab:over + ab:dim + ab:static + ab:thread) then exit.
  ! AND THE CODE THAT USES IT WITHOUT NAMING IT HERE, as KrLocalOk asks for an integer: a method of a
  ! class the procedure declares calls its methods from outside this walk, and an INCLUDE or a
  ! control's USE() reads it where the code does not say.
  if self.UnseenRead(okName) then exit.
  if self.MayHaveLocalMethods(sc)
    get(self.syms.scopes, sc)
    if ~errorcode()
      if self.UsedInLocalMethods(okName, self.syms.scopes.startTok, self.syms.scopes.endTok) then exit.
    end
  end
  okRes = 1
  do KrReachTest

! ---- is okName, a DOTTED receiver at token okPos - `self.buf`, `ctx.buf` - one this walk may bound?
!      It must be a StringTheory: a class of the author's own may have an Instring or a Len of its
!      own that answers anything, -1 included. And what holds it must be this scope's own: SELF in a
!      method, or an object declared here that passes KrRecvOk's tests, with no reference on the way
!      to the member. A module-level object, a parameter or a reference can be changed by a call
!      that names nothing on its line, and no kill in this walk would see it. ----
KrDotRecvOk routine
  data
rz    long,auto
fz    long,auto
hopSt StringTheory
  code
  okRes = 0
  spIn = okName
  do KrSplitRoot
  if ~spRoot or ~spSuf then exit.
  if self.HayType(okName, okPos) <> 'STRINGTHEORY' then exit.
  if spRoot = 'SELF'
    if scSelf then okRes = 1.
    exit
  end
  rz = self.syms.FindSym(spRoot, sc)
  if ~rz then exit.
  get(self.syms.syms, rz)
  if errorcode() then exit.
  if self.syms.syms.isRef or self.syms.syms.isLike or self.syms.syms.isField then exit.
  okDecl = self.syms.syms.declTok
  if ~self.syms.IsColOneLabel(okDecl) then exit.
  if band(self.DeclAttrBits(okDecl), ab:over + ab:dim + ab:static + ab:thread) then exit.
  if self.UnseenRead(spRoot) then exit.
  if self.MayHaveLocalMethods(sc)
    get(self.syms.scopes, sc)
    if ~errorcode()
      if self.UsedInLocalMethods(spRoot, self.syms.scopes.startTok, self.syms.scopes.endTok) then exit.
    end
  end
  ! a member declared with & on the way: any field of that name in any structure counts. The
  ! members are listed with a space either side, each dot (46) made a space (32)
  if self.syms.fields &= NULL then exit.
  hopSt.setValue(' ' & clip(spSuf) & ' ')
  hopSt.replaceByte(46, 32)
  loop fz = 1 to records(self.syms.fields)
    get(self.syms.fields, fz)
    if errorcode() then break.
    if ~self.syms.fields.isRef then cycle.
    if hopSt.findChars(' ' & clip(self.syms.fields.nameU) & ' ') then exit.
  end
  okRes = 1
  do KrReachTest

! ---- okRes, set by KrRecvOk or KrDotRecvOk, stays 1 only when nothing can reach okName unseen: a
!      reference taken on it or on what holds it, or the object - or what holds it - handed whole to a
!      call whose body may keep a reference to it (ObjReach; a call is no obstacle when the summary of
!      its body says it reads or writes that parameter and keeps nothing). Through a kept reference a
!      later call that names nothing on its line - `Keep(st)`, then `Reset()` - can empty the object,
!      and no kill in this walk would see it (ruled 28 Oct 2026: a call the tool cannot see into may
!      keep one). A SELF member needs no test: every such call kills its facts (KrKillSelf). Asked once
!      for each name in a scope; KrAliasScan starts the two lists again. ----
KrReachTest routine
  data
rtWhy  string(260),auto
  code
  if reachNo.findChars(' ' & clip(okName) & ' ') then exit.
  if ~reachU.findChars(' ' & clip(okName) & ' ')
    rtWhy = self.ObjReach(okName, codeT, 5)
    if ~rtWhy
      reachNo.append(clip(okName) & ' ')
      exit
    end
    reachU.append(clip(okName) & ' ')
  end
  okRes = 0

! ---- the names on the base list that this file also gives a PROCEDURE of its own - a body here or
!      a MAP prototype. A call to one written with no object in front of it may be that procedure,
!      with other parameters, and not the runtime's function, so KrCallAt does not take it as pure.
!      A method does not count: it is called on an object, never by its name alone. ----
KrPureOwn routine
  data
pz  long,auto
pn  string(vs:maxName),auto
  code
  pureOwnU.setValue(' ')
  loop pz = 1 to records(self.syms.scopes)
    get(self.syms.scopes, pz)
    if errorcode() then break.
    if self.syms.scopes.kind <> vs:scProc then cycle.
    pn = upper(self.tk.GetTok(self.syms.scopes.startTok))
    if pn and pureU.findChars(' ' & clip(pn) & ' ') then pureOwnU.append(clip(pn) & ' ').
  end
  raw.setValue(pureU)
  raw.split(' ')
  loop pz = 1 to raw.records()
    pn = upper(raw.getLine(pz))
    if pn and self.syms.MapProtoCount(pn) then pureOwnU.append(clip(pn) & ' ').
  end
  raw.freeLines()

! ---- S4 to S7 give the receiver its new value without setValue, and setValue does one thing more:
!      it marks the object plain text - not base64, encoded Ansi. Where nothing could have marked it
!      otherwise that changes nothing, so the rewrite is refused when this scope names the receiver
!      with a method or a property that sets or reads those marks (fl:writers, _StealValue, which
!      copies another object's, and setValueW), gives it another object's value with setValue or
!      append (which copies that object's marks) or a USTRING's with setValue (which marks it UTF-16),
!      calls a method of what holds it, or hands it, or what holds it, whole to a call not known only
!      to read it.
!      mkWhy says where, blank when nothing does. ----
KrMarked routine
  data
mz   long,auto
mn   long,auto
me   long,auto
ma   long                    ! no AUTO: may be read before it is set
md   long,auto
mt   string(vs:maxName),auto
mm   string(vs:maxName)      ! no AUTO: may be read before it is set
mr   string(vs:maxName),auto
mTU  string(vs:maxName)
mRf  byte
  code
  mkWhy = ''
  mn = len(clip(sRcv))
  if ~mn or mn + 1 >= size(mt) then mkWhy = 'its name is too long to look for' ; exit.
  mr = ''
  md = instring('.', sRcv[1 : mn], 1, 1)
  if md > 1 then mr = sRcv[1 : md - 1].
  get(self.syms.scopes, sc)
  if errorcode() then mkWhy = 'the scope around it cannot be read' ; exit.
  me = self.syms.scopes.endTok
  loop mz = codeT + 1 to me
    get(self.tk.tokens, mz)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    mt = upper(self.tk.tokens.tok)
    if mt = sRcv and self.DgIsMemberDot(mz + 1)
      mm = upper(self.tk.GetTok(mz + 2)) ; ma = mz + 3
    elsif mt[1 : mn + 1] = clip(sRcv) & '.'
      mm = mt[mn + 2 : size(mt)] ; ma = mz + 1
    elsif mr and mt = mr and self.DgIsMemberDot(mz + 1) and self.tk.GetTok(mz + 3) = '('
      mkWhy = 'line ' & self.LogLineOf(mz) & ' calls ' & lower(clip(mt)) & '.' & clip(self.tk.GetTok(mz + 2)) & |
              ', which may mark ' & clip(sRcv) & ' base64 or give it an encoding'
      break
    elsif mt = sRcv or (mr and mt = mr)
      if self.tk.GetTok(mz - 1) <> '(' and self.tk.GetTok(mz - 1) <> ',' then cycle.
      if self.tk.GetTok(mz + 1) <> ')' and self.tk.GetTok(mz + 1) <> ',' then cycle.
      if self.ArgReadsOnly(mz, scSelf) then cycle.
      mkWhy = lower(clip(mt)) & ' is handed whole to a call on line ' & self.LogLineOf(mz) & |
              ', which may mark ' & clip(sRcv) & ' base64 or give it an encoding'
      break
    else
      cycle
    end
    if mm = '_STEALVALUE' or mm = 'SETVALUEW' or (~self.ignoreMarks and instring(' ' & clip(mm) & ' ', fl:writers, 1, 1)) ! --ignoremarks
      mkWhy = 'line ' & self.LogLineOf(mz) & ' can mark ' & clip(sRcv) & ' base64 or give it an encoding (' & lower(clip(mm)) & ')'
      break
    end
    if (mm = 'SETVALUE' or mm = 'APPEND') and self.tk.GetTok(ma) = '('
      if self.tk.GetTok(ma + 2) <> ')' and self.tk.GetTok(ma + 2) <> ',' then cycle.
      get(self.tk.tokens, ma + 1)
      if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
      if ~self.syms.Lookup(self.tk.tokens.tok, ma + 1, mTU, mRf) or upper(mTU) = 'STRINGTHEORY' or ~self.UvPlainType(mTU)
        mkWhy = 'line ' & self.LogLineOf(mz) & ' gives ' & clip(sRcv) & ' the value of an object (' & lower(clip(mm)) & |
                '), and that object''s base64 and encoding marks with it'
        break
      end
      if mm = 'SETVALUE' and upper(mTU) = 'USTRING' and self.tk.GetTok(ma + 2) = ')'
        mkWhy = 'line ' & self.LogLineOf(mz) & ' gives ' & clip(sRcv) & ' the value of a USTRING, which gives it the UTF-16 encoding'
        break
      end
    end
  end
  if mkWhy then mkWhy = clip(mkWhy) & ' - setValue clears both, the rewrite would not'.

! ---- append one staged edit (dataless routine -> no CODE section) ----
KrPush routine
  clear(KrEdQ)
  kr:pos  = nxPos
  kr:pos2 = nxPos2
  kr:kind = nxKind
  kr:txt  = nxTxt  ! kind 3 only; KrApply never reads it for kinds 1 and 2
  add(KrEdQ)

! ---- apply the staged edits HIGHEST POSITION FIRST; a delete shifts everything above it.
!      A kind-2 donor is ALWAYS below its target, so by the time the sweep reaches the
!      target every remaining delete is below the donor too and the donor has not moved.
!      A kind-3 retype is the same story from the other side: its token is BELOW the
!      delete staged with it, so the delete lands first and the token has not moved.
!      A kind-5 carried comment goes to the line's end through CmtToLineEnd, which on a .txa
!      keeps the wrap's mark at the very end of the line, where it has to stay. ----
KrApply routine
  data
az  long,auto
  code
  sort(KrEdQ, -kr:pos)
  loop az = 1 to records(KrEdQ)
    get(KrEdQ, az)
    if errorcode() then break.
    case kr:kind
    of 1
      self.tk.DeleteToks(kr:pos, kr:pos2)
    of 3
      self.tk.SetTok(kr:pos, clip(kr:txt)) ! strBefore OMITTED on purpose - SetTok then leaves the indent alone
    of 5                                   ! comments carried from inside the statement (S5) join the line's own
      sbSt.setValue(kr:txt, st:clip)       !   as ONE comment, carried text first - a sentence wrapped over the rows
      self.CmtToLineEnd(kr:pos, sbSt)      !   reads in order, with one marker; the gap before it stays the line's
    of 6
      self.tk.SetStrBefore(kr:pos, ' ')    ! a continuation rejoined (S5): the bar, its comment, the CRLF and the indent become one space
    of 7
      do KrApplyInsert                     ! a NEW statement on its own line in front of the token (S6)
    else
      get(self.tk.tokens, kr:pos2)
      if errorcode() then cycle.
      sbSt.free()
      if not self.tk.tokens.strBefore &= NULL
        sbSt.setValue(self.tk.tokens.strBefore)
      end
      if sbSt._DataEnd
        self.tk.SetStrBefore(kr:pos, sbSt.valuePtr[1 : sbSt._DataEnd])
      else
        self.tk.SetStrBefore(kr:pos, '')
      end
    end
  end

! ---- kind 7: put a NEW statement on its own line immediately in front of the token at kr:pos.
!      The way TrailingSpaces splices its clip() (TsApplyInsert): InsertString parses the text, the
!      CRLF closes the new line, and the new tokens take the construct's line number so the line map
!      stays honest. One difference: the token's WHOLE leading trivia - comment lines parked above the
!      statement included - moves to the new first token, so a comment that sat above the statement
!      now sits above both halves of it, and the old token keeps just the indent. ----
KrApplyInsert routine
  data
iz      long,auto
ik      long,auto
ic      string(1),auto
sbLen   long,auto
lnNo    long,auto
nBefore long,auto
nAdded  long,auto
  code
  get(self.tk.tokens, kr:pos)
  if errorcode() then exit.
  lnNo = self.tk.tokens.lineNo
  krIndSt.free()
  sbSt.free()
  if not self.tk.tokens.strBefore &= NULL
    sbSt.setValue(self.tk.tokens.strBefore)
    sbLen = size(self.tk.tokens.strBefore)
    ik = sbLen
    loop while ik >= 1                                             ! the trailing whitespace run is the indent
      ic = self.tk.tokens.strBefore[ik]
      case val(ic)
      of 32 orof 9                                                 ! <space> orof <tab>
        ik -= 1
      else
        break
      end
    end
    if ik < sbLen then krIndSt.setValue(self.tk.tokens.strBefore[ik + 1 : sbLen]).
  end
  krInsSt.setValue(kr:txt, st:clip)
  krInsSt.append('<13,10>')
  nBefore = records(self.tk.tokens)
  self.tk.InsertString(kr:pos, krInsSt)
  nAdded = records(self.tk.tokens) - nBefore
  if nAdded < 1 then exit.
  if sbSt._DataEnd
    self.tk.SetStrBefore(kr:pos, sbSt.valuePtr[1 : sbSt._DataEnd]) ! everything that led the statement now leads the new line
  end
  if krIndSt._DataEnd
    self.tk.SetStrBefore(kr:pos + nAdded, krIndSt.valuePtr[1 : krIndSt._DataEnd])
  else
    self.tk.SetStrBefore(kr:pos + nAdded, '')
  end
  loop iz = kr:pos to kr:pos + nAdded - 1
    get(self.tk.tokens, iz)
    if errorcode() then break.
    self.tk.tokens.lineNo = lnNo
    put(self.tk.tokens)
  end

! ------------------------------------------------------------------------------------
! The calls KnownRanges accepts as unable to move a tracked value or a bound. Space
! delimited, UPPER, with a leading AND a trailing space so instring(' NAME ', list) cannot
! match a substring of a longer name. Two families, both READ-ONLY by definition:
!   * Clarion reader builtins - they compute a value from their arguments and touch nothing;
!   * StringTheory reader methods - they inspect self.value and do not modify it.
! Anything absent is treated as IMPURE, which is the safe direction: an impure call drops
! every fact whose variable or receiver is named on that line. A rule file adds its own with
! BUILTIN KnownRanges, PURE(myFn myOtherFn).
! NOTE the list is built with several appends on purpose: a single quoted literal beyond
! roughly 680 characters stops the Clarion parser dead.
! ------------------------------------------------------------------------------------
VitEngine.KnownRangePureList Procedure(StringTheory pOut)
  code
  pOut.setValue(' UPPER LOWER CLIP LEFT RIGHT CENTER SUB LEN VAL CHR NUMERIC INSTRING ')
  pOut.append('FORMAT DEFORMAT ABS INT ROUND BAND BOR BXOR BSHIFT CHOOSE ADDRESS SIZE ')
  pOut.append('RECORDS POINTER ')
  pOut.append('GETVALUE GETVALUEPTR LENGTH LENGTHA CLIPLENGTH SLICE GETLINE ')
  pOut.append('FINDCHAR FINDCHARS FINDBYTE CONTAINSCHAR CONTAINSBYTE STARTSWITH ENDSWITH ')
  pOut.append('EQUALS BETWEEN ') ! COMPARE and LINES are absent on purpose: neither is a StringTheory method or a Clarion function, and a name wrongly IN a purity list is a WRONG transform - the unsafe direction.

! ====================================================================================
! BUILTIN TrailingSpaces (runs by default) - do not PROVE the buffer has no trailing
! spaces, MAKE it true, then retire the code that keeps asking about them.
! The shape this comes from:
!
!     st.Replace('<9>', ' ')                  the tail may now be padded
!     st.clip()                               <- INSERTED once, at a top-level point
!     pLen = st.clipLength()             ->   pLen = st._DataEnd
!     p    = st.findChar('=', 1)
!     return clip(st.getValue())         ->   return st.getValue()
!
! THE MODEL. Per proc/method MAIN code (routines excluded by acMainEnd, exactly as
! AutoCheck and KnownRanges exclude them), per LOCAL StringTheory receiver. Every
! textual occurrence of the receiver is classified into ONE of the ts:* kinds - see
! TsMethodKind, which is the only place the whitelist lives. Two properties matter and
! they are NOT the same property:
!
!   BLIND        the use cannot tell whether the buffer ends in spaces - it gives the
!                same answer either way. Needed so that INSERTING a clip is invisible.
!   CLEAN-KEEP   the use cannot CREATE a trailing space. Needed so that "the buffer is
!                clean" survives from the clip down to the uses that rely on it.
!
! ts:read / ts:clipLen / ts:anchor are both. ts:cleanSet is both AND makes the buffer
! clean. ts:bad is neither, and any doubt collapses to ts:bad.
!
!   REGION       let lastBad be the LAST occurrence in the scope that is ts:bad (a `DO`
!                counts - a routine can touch any buffer). P is the first DEPTH-0 line
!                start below lastBad. Then every occurrence in [P .. mainEnd] is BLIND
!                and CLEAN-KEEP, by construction.
!   ANCHOR       the region must contain a `clip(recv.getValue())`. That is the author
!                saying the trailing spaces of the result are dead. Without it the pass
!                does nothing (a region with no anchor is left completely alone).
!
! WHY DEPTH 0 IS LOAD-BEARING. The region is a TEXTUAL suffix. It is also the set of
! uses reachable after control passes P only because P sits at depth 0 of the scope: no
! enclosing block can jump control back ABOVE P, and GOTO is refused outright by the
! existing AutoScopePrep bail. So a loop inside the region needs no fixpoint iteration -
! every operation it can perform is already in the region, and no operation in the region
! can dirty the buffer. That single observation is what removes the loop analysis the
! design would otherwise have needed.
!
! THE TWO HALVES.
!   HALF A (simplify), applied to every qualifying use BELOW the clean point:
!     A1  recv.clipLength()      -> recv._DataEnd      (the receiver token is retyped and
!         the `. clipLength ( )` tokens are dropped, so it stays ONE token, which is what
!         the tokenizer produces for a dotted name that is not followed by a paren. The
!         existing rest-of-string RULE then collapses recv.sub(w, recv._DataEnd - w + 1)
!         to recv.slice(w) on a later pass - that part is not done here.)
!     A2  clip(recv.getValue())  -> recv.getValue()    (`clip` and its '(' are dropped, the
!         receiver token inherits clip's leading trivia, and the extra ')' goes.)
!   HALF B (insert): if the receiver is NOT already provably clean at the top of the
!     region, insert `recv.clip()` on its own line immediately before P, which makes it
!     clean, which is what licences A1 and A2. Half B is never done alone: it requires at
!     least one A1 to be waiting below it, because an insertion that only retires the
!     anchor clip moves the same clip from one line to another and is a wash.
!
! THE SAFETY ARGUMENT, in one line each.
!   * inserting the clip is invisible because every use below it is BLIND;
!   * the buffer STAYS clean all the way down because every use below it is CLEAN-KEEP;
!   * A1 is then an identity (clipLength() and _DataEnd agree on a clean buffer);
!   * A2 is then an identity (clip(x) is x when x has no trailing spaces);
!   * everything not on the whitelist is ts:bad, and ts:bad only ever moves P DOWN, i.e.
!     shrinks what the pass is allowed to touch. Every bail lands there.
!
! THE FIXPOINT ARGUMENT - this is the FIRST transform that inserts a statement, so it has
! to be proved, not asserted. Two independent guarantees, either one sufficient:
!   1. An insertion happens only when the receiver is NOT already clean at the top of the
!      region, and "already clean" means the first occurrence at or below P is a ts:cleanSet
!      that is ALONE on its own depth-0 line. What we insert is exactly that: `recv.clip()`
!      alone on its own depth-0 line, placed between lastBad and the old P. Nothing above P
!      is edited, so lastBad cannot move up; therefore on the next pass the first depth-0
!      line start below lastBad IS our inserted line, its statement IS a ts:cleanSet, and
!      the guard fires. At most one insertion per receiver per scope, ever.
!   2. Independently: an insertion requires at least one ts:clipLen use below it, and the
!      same pass rewrites EVERY ts:clipLen use in the region into _DataEnd. A rewritten one
!      is a merged `recv._DataEnd` token, which classifies ts:bad. So after one pass there
!      is no ts:clipLen left to justify a second insertion, and lastBad has moved DOWN past
!      the rewrite, shrinking the region further.
!   Convergence in practice: pass 1 inserts and simplifies; pass 2 finds `recv._DataEnd`
!   (ts:bad) and a now-unclipped `return recv.getValue()` (ts:bad) and stages nothing.
!
! THE LINE MAP - which neighbour wins, and why. An inserted line has no source line, so
! SetLineNumbers/MapFold must fold it onto a neighbour. Left alone MapFold would give it
! the PREDECESSOR (a wholly-inserted line finds no survivor token carrying a real lineNo
! and falls back to the carry). The design wants the SUCCESSOR - the construct the clip
! enables - so that a click on it in VitStyle's After pane lands somewhere meaningful.
! TsApplyInsert therefore stamps the construct's own lineNo onto every inserted token
! before returning. MapFold then reads a real, monotone line off the first token of the
! new line and maps it to the construct's source line; the construct's own line maps
! there too, so this is the ordinary 1 -> N case that the map and the survivor
! lookahead already handle (ExpandOneLiners makes 1 -> 3 the same way).
!
! WHAT IT REFUSES (all under-reach - a refusal leaves working code exactly as it was):
!   * a scope with GOTO / COMPILE / OMIT, and a ROUTINE without DATA of its own (it has no
!     CODE section, so AutoScopePrep bails); a ROUTINE with DATA is walked for those locals,
!     as KnownRanges walks it;
!   * a scope whose depth walk does not return to the depth it started at. An INLINE '.'
!     terminator is retyped vt:end but may carry NO '-' level mark, so the close test is
!     the inline-dot idiom; if the walk still ends unbalanced the WHOLE scope is skipped, because
!     "depth 0" would then be a lie and depth 0 is the whole reachability argument;
!   * any receiver that is not a simple LOCAL StringTheory of this scope - a module-level
!     one could be moved by a call this walk cannot see, and &-reference / LIKE / OVER /
!     DIM / STATIC / THREAD / parameter forms are all out;
!   * a receiver named BARE anywhere in the scope (`foo(st)`, `st &= other`, `address(st)`).
!     A bare mention can alias the buffer to something that later mutates it WITHOUT
!     naming it, which no textual walk can see. This is the only refusal that is scope-wide
!     rather than region-wide, and it is deliberately so;
!   * `DO` anywhere in the region;
!   * `recv._DataEnd`, `recv.len()`, `recv.length()` - they COUNT the spaces;
!   * `recv.append(...)`, `recv.prepend(...)` - THE TRAP. If the buffer ends in spaces and
!     something appends, those spaces become INTERNAL: 'abc  ' & 'x' is not 'abc' & 'x';
!   * `recv.getValue()` that is NOT immediately wrapped in `clip(...)` - the trailing
!     spaces escape to the caller, so they are not dead;
!   * a needle that is, or might be, a space: findChar(' '), findByte(32), any needle that
!     is not a single quoted literal / integer, and any literal containing a '<' escape;
!   * clipLength(pStr), clip(alphabet), trim(alphabet), getValue(start,len) - same name,
!     different method;
!   * an insertion point whose previous token is not an EOL, or whose leading trivia is
!     not pure indent (a comment or a '|' continuation carrier lives there);
!   * a comment or a '|' inside anything being deleted or re-trivia-ed;
!   * lastBad = 0, i.e. nothing above P has touched the buffer at all. The design is
!     explicit that the clip must not go at the top of a procedure, where the buffer may
!     not be populated yet.
!
! DELIBERATE DEVIATION 1 - the design's table is used for BLIND only, never for
!     CLEAN-KEEP, and `setLength(n)` / bare `setValue(x)` are therefore REFUSED here even
!     though the table lists setLength as insensitive. The design's Half B says "mark the
!     receiver clean from there", which silently assumes insensitive implies clean. It does
!     not. setLength TRUNCATES (StringTheory.SetLength: _DataEnd = NewLength), so a clean
!     buffer can come out of it dirty, and setValue stores an arbitrary string.
!     This is not a corner: it retires the motivating example itself. Take
!         st = 'LONG pA, STRING pB = 5'          (no trailing spaces anywhere)
!         p = st.findChar('=')  -> 20 ; q = st.findChar(',', 20) -> 0
!         st.setLength(p - 1)   -> 'LONG pA, STRING pB '         <- a space is CREATED
!         return clip(st.getValue())  -> 'LONG pA, STRING pB'
!     Drop that clip and the procedure returns the trailing space instead. The clip is
!     doing real work on the most ordinary input, and no clip inserted before the loop can
!     help, because the space is made after it. MaskSigBase in TestData\trailspace.clw
!     pins this refusal and carries the counterexample.
!
! DELIBERATE DEVIATION 2 - `sub` / `slice` / `crop` are refused OUTRIGHT, not only
!     when they reach the end. The design splits them on "reaching the end of the buffer",
!     which is a property of the ARGUMENTS at run time - st.sub(1, p - 1) reaches the end
!     exactly when p - 1 is at least the clipped length, and nothing in this walk knows p.
!     Guessing here would be a silent behaviour change, so the whole family is ts:bad.
!
! ---- THE SPACELESS MODE - the second way in, and the one that lifts MaskSigBase --
! Everything above is the CLEAN mode: it knows only "no TRAILING spaces", it has to MAKE
! that true by inserting a clip, and DEVIATION 1 therefore refuses setLength. A second,
! independent mode runs FIRST (TsSpacelessTry) and inserts nothing at all:
!
!     st.SetValue(self.StripRefSig(pParams))   StripRefSig is sm:spaceless (summary),
!                                              so from here st contains NO SPACES AT ALL
!     st.Replace(',omitmask', '')              a space-free replacement cannot add one
!     if p - 1 < st._DataEnd then st.setLength(p - 1).  a GUARDED shrink - see TsTruncGuard
!     pLen = st.clipLength()             ->    pLen = st._DataEnd
!     return clip(st.getValue())         ->    return st.getValue()
!
! The region is (the setValue .. mainEnd] and it needs no ANCHOR, because with no spaces in
! the buffer both A1 and A2 are IDENTITIES rather than transformations licensed by an
! author's intent. What it does need, for every use below the store:
!   * VitEngine.SpaceKeepUse says the use cannot put a space INTO the buffer (reads, clip,
!     trim, removeByte, and replace() with a space-free literal replacement), or
!   * TsTruncGuard says it is `if E < recv._DataEnd then recv.setLength(E).`, the author's
!     own same-line proof that the setLength shrinks;
!   * no `DO` below the store, and no BARE mention of the receiver anywhere in the scope
!     (TsScanUses' existing scope-wide refusal).
! The store itself must be UNCONDITIONAL: a depth-0 line start with nothing else on its line.
! Every log line the mode produces NAMES the callee, because the evidence for it is in
! another procedure and the changed line cannot be audited on its own.
!
! WHY setLength IS NOT SIMPLY ALLOWED HERE, which is a DEVIATION from the design.
!     The design (and the DEVIATION 1) both describe setLength as a truncation, in which
!     case spacelessness would survive it unconditionally. StringTheory.SetLength also
!     GROWS - and it pads the new bytes with byte 32 (stMemSet(..., 32, ...), both the
!     buffer and the non-buffer path). An unguarded setLength can therefore put trailing
!     spaces INTO a spaceless buffer and retire a clip that was doing real work. Hence the
!     guard, and hence GrowLength in TestData\summary.clw, which pins the refusal.
!
! ---- A SPACELESS setValue MAY BE A CONCATENATION -----------------------------
! A setValue whose argument is EXACTLY ONE call with an sm:spaceless summary is the plain
! case; the line that matters most is a concatenation:
!
!     st.SetValue(st.sub(1, p - 1) & st.sub(choose(q < 0, st._DataEnd + q + 1, q),
!                                           st.clipLength() - q + 1))
!
! TsConcatOk splits the argument on TOP-LEVEL '&' (depth 0, so an '&' inside a nested
! call's arguments does not split) and requires EVERY term to be spaceless-yielding
! (TsTermOk). A term qualifies three ways and no other:
!   1. a call whose summary is sm:spaceless;
!   2. a SELF-SLICE - recv.sub / recv.slice / recv.getValue on the SAME receiver - a substring of
!      a string with no spaces has no spaces;
!   3. a quoted literal with no space, tab or '<' escape in it.
! A BARE VARIABLE is refused, and that is not fussiness: '&' on a fixed STRING(n) operand
! concatenates WITH the padding. It is safe for 1 and 2 because a Clarion PROCEDURE
! returning STRING returns exactly its own length, not a padded field.
!
! DEVIATION - TERM 2 IS ADMISSIBLE ON THE KEEP WALK ONLY, and the design does not
!     say so. The design puts the whole rule in TsSpaceSetAt, the walk that CHOOSES the
!     store, and there it is circular: at the store nothing is yet known about the buffer,
!     so `st.setValue(st.sub(1, 5))` would "prove" spaceless from a slice of anything.
!         st.setValue(pParams)          arbitrary, spaces and all
!         st.setValue(st.sub(1, 5))     <- would establish spaceless. It does not.
!     Hence cnSelf: 0 on the ESTABLISH walk (terms 1 and 3 only), 1 on the KEEP walk, where
!     the forward walk already has the fact and a slice of it is sound. ConcatSlices in
!     TestData\summary.clw is written the second way, exactly as parser.MaskSigBase is.
!
! DEVIATION - the KEEP walk also asks about setValue. SpaceKeepUse answers 0 for
!     sk:store and must keep doing so: it also runs inside BuildSummaries and may not read
!     summaries that pre-pass is in the middle of building. But a concatenation INSIDE a
!     loop is never the store - it is a use BELOW the store - so TsSpaceKeepAt tries
!     TsSpaceSetAt itself, after SpaceKeepUse and TsTruncGuard.
!
! DEVIATION - TsDataEndRead, for the same line. See its own header.
!
! This builtin INSERTS and DELETES code, and it runs by default: vitrules.txt declares it inside
!     `GROUP analysis`, which STYLE optimised - the default style - names. --style=plain or
!     --nogroup=analysis leaves it out.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinTrailingSpaces Procedure(StringTheory pLog)
s          long,auto
raw        StringTheory
noteSt     StringTheory            ! NOTE('...') - LOG text only; it never injects a comment into the source
sbSt       StringTheory            ! donor trivia while applying a kind-2 edit
insSt      StringTheory            ! the text handed to InsertString
indSt      StringTheory            ! captured indent of the insertion point
parkSt     StringTheory            ! the construct's whole leading trivia when a comment is parked in it - it goes in front of OUR line (14 Sep 2026)
wsST       StringTheory            ! a VEHICLE for IsAll in TsTriviaClean - its own value is never consulted
inserts    long
simps      long
changes    long,auto
scRow      long,auto               ! row in syms.scopes
scKind     byte,auto
sc         long,auto               ! scopeId of the proc/method being walked
scPar      long,auto               ! a routine's parent - the method whose class its `self.` names
scSelf     string(vs:maxName)      ! the method's receiver class, captured BEFORE AutoScopePrep clobbers the buffer
scNameU    string(vs:maxName)      ! that scope's declaration label, UPPER - the proof bank's scope-STABLE key
dupNmU     StringTheory            ! ' NAME ... ' - the labels two or more scopes share: overloads, which bank nothing (TsDupNames)
codeT      long,auto
mainEnd    long,auto
scBad      byte                    ! the depth walk of this scope did not balance - skip it whole
rcIx       long,auto
opLT       string(4)               ! chr() sidesteps the doubling rule for '<' entirely
opLE       string(4)
! ---- token peek (TsGet)
gPos       long,auto
gOk        byte
gCut       byte
gNull      byte                    ! the record carries no token (trivia-only tail record)
gTxt       string(vs:maxName)
gTU        string(vs:maxName)
gTy        string(1)
gLv        string(1)
! ---- cross-pass proof of a guarded setLength
tpArgU     string(vs:maxName)      ! the setLength argument, tokens joined and upper-cased
tpArg      stringTheory            ! the accumulator TsArgText builds tpArgU in
tpAS       long,auto
tpAE       long,auto
tpHit      byte
tpOrd      long                    ! TsSiteKey: the setLength's place among its receiver's setLength calls
tpCnt      long                    !   and how many there are in the scope's code
! ---- name splitting (TsSplitRoot)
spIn       string(vs:maxName)
spRoot     string(vs:maxName)
spSuf      string(vs:maxName)
! ---- paren matching (TsMatchParen)
mpOpen     long
mpClose    long
! ---- argument spans of the call at mpOpen (TsArgs)
agN        long                    ! top-level argument count (0 = empty parens)
agS        long                    ! FIRST argument: first token
agE        long                    ! FIRST argument: last token
agLS       long                    ! LAST  argument: first token
agLE       long                    ! LAST  argument: last token
! ---- classification (TsClassify)
tcPos      long
tcKind     byte
tcEnd      long                    ! last token of the whole use (for an anchor: clip's ')')
mth        string(vs:maxName)
kndName    long
ltOk       byte                    ! TsLitOk: the needle is a literal that cannot be a space
is32       byte                    ! TsByte32: the integer token in gTxt is 32, the space byte, however many zeros lead it
! ---- trivia scan (TsTriviaClean)
tcS        long
tcE        long
tcOk       byte
! ---- indent / insertion-point checks
indOk      byte
insOk      byte
lsPos      long
lsOk       byte
! ---- scope line walk
depth      long
prevEol    byte
! ---- per receiver
rcU        string(vs:maxName)      ! UPPER name, for matching token roots
rcTxt      string(vs:maxName)      ! SOURCE case, for the code we write
rcEnc      byte                    ! MarkSetterAt's answer: the setter may set the encoding
rcK        long                    ! TsUtf16Risk: the mention MarkSetterAt found,
rcA        long                    !   its '(',
rcRisk     byte                    !   and whether it can make the receiver UTF-16
rcSrc      string(vs:maxName)      !   the object a setValue() there copies, upper
rcZ        long                    !   and its symbol row
recvBad    byte                    ! a BARE mention - this receiver is out for the whole scope
lastBad    long                    ! last occurrence that refuses the region (0 = none)
pTok       long                    ! the insertion point / start of the region
firstIx    long
cleanFrom  long                    ! uses at or below this token are NOT yet known clean
alreadyCl  byte
nAnchor    long
nClip      long
nSimp      long
uPos       long
uEnd       long
uKind      byte
edOk       byte
logLn      long,auto
! ---- SPACELESS mode: the receiver was STORED from a call whose summary is sm:spaceless
slOk       byte                    ! the whole mode validated for this receiver
slPos      long                    ! the setValue that makes it spaceless
slEnd      long                    ! ... and its closing ')'
slIx       long                    ! its row in TsUseQ
slName     string(vs:maxName)      ! the callee - the EVIDENCE every log line has to name
ssOk       byte                    ! TsSpaceSetAt out
ssEnd      long
ssName     string(vs:maxName)
skOk       byte                    ! TsSpaceKeepAt out
smNm       string(vs:maxName)      ! SummaryOfCallAt out
smF        byte
! ---- CONCATENATION: the setValue argument split on TOP-LEVEL '&'
cnSelf     byte                    ! may a term be a SELF-SLICE?  ONLY where the buffer is already known spaceless
cnOk       byte                    ! TsConcatOk out - every term is spaceless-yielding
cnNm       string(vs:maxName)      ! the first SUMMARISED callee among the terms - the evidence a log line has to name
tmS        long                    ! ONE term: first token
tmE        long                    ! ONE term: last token
tmOk       byte                    ! TsTermOk / TsLitSpaceless out
! ---- edit staging
nxPos      long
nxPos2     long
nxKind     byte
nxTxt      string(vs:maxName + 16) ! sized off the equate, so it cannot fall behind it: a literal sized by hand would truncate a long receiver name INTO EMITTED SOURCE the moment vs:maxName grew. The longest suffix assigned
                                   !   here is '._DataEnd' - 9 chars (TsStageClipLen; '.clip()' is 7) - and +8 would be ONE BYTE SHORT for a maxName-length receiver (`name._DataEn`); +16 leaves slack for the next suffix too.
TsRecvQ  QUEUE,PRE(tsv)
tsvNameU  string(vs:maxName)
tsvText   string(vs:maxName)
         END
TsLineQ  QUEUE,PRE(tsl)            ! every DEPTH-0 line start of this scope's main code, ascending
tslPos    long
         END
TsUseQ   QUEUE,PRE(tsu)            ! every occurrence of ONE receiver in this scope, ascending
tsuPos    long                     ! the receiver token
tsuEnd    long                     ! last token of the use
tsuKind   byte                     ! ts:*
         END
TsEdQ    QUEUE,PRE(tse)
tsePos    long                     ! kind 1: first token to delete.  2/3/4: the token acted on
tsePos2   long                     ! kind 1: last token to delete.   2: the DONOR token (always BELOW pos)
tseKind   byte                     ! 1 DeleteToks / 2 SetStrBefore from pos2 / 3 SetTok to txt / 4 insert txt as a new line before pos
tseTxt    string(vs:maxName + 16)  ! nxTxt is assigned straight into this - same size, same reason
         END
  code
  if self.syms &= NULL then return 0.
  self.acScopeId = 0                                            ! the token stream may have moved since the last pass
  free(TsRecvQ)                                                 ! local QUEUEs persist between calls - start every pass empty
  free(TsLineQ)
  free(TsUseQ)
  free(TsEdQ)
  opLT = chr(60)                                                !
  opLE = chr(60) & '='
  noteSt.free()
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      case upper(self.rl.rules.bparmQ.name)
      of 'NOTE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.unquote('''','''')
          noteSt.setValue(raw)                                  ! reported once in the log; NEVER written into the source
        end
      end
    end
  end

  self.BuildSummaries()                                         ! what every proc/method in this file RETURNS - the spaceless mode below reads it
  if self.syms.scopes &= NULL then return 0.
  do TsDupNames                                                 ! the labels overloads share, which key no proof
  loop scRow = 1 to records(self.syms.scopes)
    get(self.syms.scopes, scRow)
    if errorcode() then break.
    scKind = self.syms.scopes.kind
    sc     = self.syms.scopes.scopeId
    scSelf = self.syms.scopes.selfClass                         ! which class a `self.` call in this scope names
    scNameU = upper(self.tk.GetTok(self.syms.scopes.startTok))  ! the DECLARATION LABEL - what the proof bank is keyed on; for a method that is `Class.Method`. OVERLOADS share one label, so
                                                                !   a label two scopes declare is no key and is blanked below. Blank banks nothing and claims nothing: TsProvenAdd and TsProvenFind.
    if dupNmU.findChars(' ' & clip(scNameU) & ' ')
      scNameU = ''
    end
    if scKind <> vs:scProc and scKind <> vs:scMethod and scKind <> vs:scRoutine then cycle. ! module data has no code
    if scKind = vs:scRoutine                                    ! a ROUTINE with DATA of its own is walked for THOSE locals, as
      scPar = self.syms.scopes.parentId                         !   KnownRanges walks it: allocated on every DO and visible nowhere
      self.syms.scopes.scopeId = scPar                          !   else. Its `self.` is its method's class - the routine row carries
      get(self.syms.scopes, self.syms.scopes.scopeId)           !   none, so the PARENT row is read, BY ITS ID (a search on parentId
      if ~errorcode() then scSelf = self.syms.scopes.selfClass. !   found a sibling routine, or this row, never the method) - and it
      get(self.syms.scopes, scRow)                              !   banks no proof: a routine returns nothing to a
      scNameU = ''                                              !   caller. A procedure's own StringTheorys stay its own: a DO in
    end                                                         !   it still bails it, and a routine without DATA has no CODE.
    self.AutoScopePrep(sc)                                      ! NB clobbers the scopes buffer - sc/scKind/scSelf are captured above
    if self.acBail then cycle.                                  ! missing scope / no CODE / GOTO / COMPILE / OMIT present
    if self.urInc then cycle.                                   ! an INCLUDE: code this file does not hold may re-pad it
    codeT   = self.acCodeT
    mainEnd = self.acMainEnd
    if mainEnd <= codeT then cycle.
    do TsScopeLines
    if scBad then cycle.
    do TsCollect
    loop rcIx = 1 to records(TsRecvQ)
      get(TsRecvQ, rcIx)
      if errorcode() then break.
      rcU   = tsv:tsvNameU
      rcTxt = tsv:tsvText
      do TsReceiver
    end
  end

  changes = inserts + simps
  if changes
    do TsApply
    self.wantReparse = true                                     ! tokens inserted AND deleted; later builtins must see the new stream
    if noteSt._DataEnd
      pLog.append('BUILTIN TrailingSpaces: ' & clip(noteSt.getValue()) & '<13,10>')
    end
    pLog.append('BUILTIN TrailingSpaces: ' & inserts & ' insertion(s), ' & simps & ' simplification(s) this pass<13,10>')
  end
  free(TsRecvQ)
  free(TsLineQ)
  free(TsUseQ)
  free(TsEdQ)
  return changes

! ---- one token into gTxt / gTU / gTy / gLv / gNull ----
TsGet routine
  gOk   = 0
  gCut  = 0
  gNull = 0
  gTxt  = ''
  gTU   = ''
  gTy   = ' '
  gLv   = ' '
  if gPos < 1 then exit.
  get(self.tk.tokens, gPos)
  if errorcode() then exit.
  gTy = self.tk.tokens.type
  gLv = self.tk.tokens.level
  if not self.tk.tokens.tok &= NULL
    gCut = choose(size(self.tk.tokens.tok) > size(gTxt)) ! the token does NOT FIT gTxt, a fixed STRING: it arrives CUT to its first 255 characters. A cut NAME or
    if gCut and gTy <> vt:literal then exit.             !   NUMBER is refused as before (gOk stays 0, 'cannot see it'). A cut LITERAL is let through, because every
    gTxt = self.tk.tokens.tok                            !   keyword / operator compare is right on the cut copy, and the walk no longer goes blind on a whole body
    gTU  = upper(self.tk.tokens.tok)                     !   for one long message. The readers of a literal's TEXT (TsLitOk, TsLitSpaceless, the instring seed)
                                                         !   ask gCut first and refuse, so a cut copy is never scanned and never copied into emitted source
  else
    gNull = 1
  end
  gOk = 1

! ---- split spIn at its FIRST '.' -> spRoot / spSuf (a bare name gives spSuf = '') ----
TsSplitRoot routine
  data
dz  long,auto
nz  long,auto
  code
  spRoot = spIn
  spSuf  = ''
  nz = len(clip(spIn))
  if ~nz then spRoot = '' ; exit.
  dz = pLog.findByte(46, 1,, spIn) ! <dot>
  if dz > 1 and dz < nz
    spRoot = spIn[1 : dz - 1]
    spSuf  = spIn[dz + 1 : nz]
  elsif dz
    spRoot = ''                    ! a leading or trailing dot - not a name we model
  end

! ---- matching ')' for the '(' at mpOpen, searching forward from it (0 = none) ----
TsMatchParen routine
  data
mz  long,auto
md  long,auto
  code
  mpClose = 0
  md      = 0
  loop mz = mpOpen to mainEnd
    gPos = mz
    do TsGet
    if ~gOk then exit.
    if gTy = vt:literal then cycle. ! a bracket INSIDE a quoted literal is text, not structure
    case gTxt
    of '('
      md += 1
    of ')'
      md -= 1
      if ~md then mpClose = mz ; exit.
      if md < 0 then exit.
    end
  end

! ---- top-level argument spans of the call whose parens are mpOpen .. mpClose ----
TsArgs routine
  data
az2 long,auto
ad  long,auto
  code
  agN  = 0
  agS  = 0
  agE  = 0
  agLS = 0
  agLE = 0
  if mpClose <= mpOpen + 1 then exit. ! () - no arguments at all
  agN  = 1
  agS  = mpOpen + 1
  agLS = mpOpen + 1
  agLE = mpClose - 1
  ad   = 0
  loop az2 = mpOpen + 1 to mpClose - 1
    gPos = az2
    do TsGet
    if ~gOk then exit.
    if gTy = vt:literal then cycle.
    if gTxt = '('
      ad += 1
    elsif gTxt = ')'
      ad -= 1
    elsif ~ad and gTxt = ','
      agN += 1
      if agN = 2 then agE = az2 - 1.
      agLS = az2 + 1
    end
  end
  if agN = 1 then agE = mpClose - 1.

! ---- the FIRST argument is a single quoted literal that cannot possibly be a space ----
TsLitOk routine
  data
lz  long,auto
ln2 long,auto
lc  string(1),auto
  code
  ltOk = 0
  gPos = agS
  do TsGet
  if ~gOk or gCut or     |
     gTy <> vt:literal   ! a computed needle - we cannot see what it is
    exit
  end
  ln2 = len(clip(gTxt))
  if ln2 < 3 then exit.  ! the empty literal
  loop lz = 2 to ln2 - 1
    lc = gTxt[lz]
    case val(lc)
    of 32 orof 9
      exit               ! the needle IS whitespace: clipping moves the answer
    of 60
      exit               ! a '<' escape - the needle may BE a space under another name
    end
  end
  ltOk = 1

! ---- every strBefore in [tcS..tcE] is plain whitespace (no comment, no bar, no line break) ----
TsTriviaClean routine
  data
qz  long,auto
  code
  tcOk = 0
  loop qz = tcS to tcE
    get(self.tk.tokens, qz)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if ~wsST.IsAll('<32,9>', self.tk.tokens.strBefore, false) then exit. ! '!' comment, '|' continuation or a CR/LF
    ! ISALL SAYS THIS IN ONE LINE, and a library test is harder to get subtly wrong than a
    !   hand-rolled character walk.
    !   THE THIRD ARGUMENT IS pClip, NOT A CASE FLAG, and false is load-bearing: it measures the
    !   alphabet with size() rather than clipLen(). It changes nothing for '<32,9>', whose last
    !   byte is a tab - but write the alphabet '<9,32>' and the default would clip the space
    !   straight out of it, and no plain-space gap would ever pass again. The same argument is
    !   written out at the label-merge site in vitTokenize, which is where this spelling comes
    !   from.
    !   IsAll reads a ZERO-LENGTH pTestString as "not supplied" and answers from the RECEIVER's
    !   own value instead. It cannot be reached with one here: a NULL strBefore is cycled above,
    !   and a non-NULL one was allocated with a size of at least 1. wsST is a vehicle for the
    !   method and its own value is never consulted.
  end
  tcOk = 1

! ---- the token at gPos starts its line with pure indent (and indSt receives that indent) ----
TsIndentOk routine
  data
iz  long,auto
ic  string(1),auto
  code
  indOk = 0
  indSt.free()
  get(self.tk.tokens, gPos)
  if errorcode() then exit.
  if self.tk.BufColOne() then exit.             ! column 1 = a LABEL position, never a statement we may precede
  if ~size(self.tk.tokens.strBefore) then exit.
  loop iz = 1 to size(self.tk.tokens.strBefore)
    ic = self.tk.tokens.strBefore[iz]
    case val(ic)
    of 32 orof 9
      ! plain indent
    else
      exit                                      ! a comment, a bar, or the CRLF of a continuation
    end
  end
  indSt.setValue(self.tk.tokens.strBefore)
  indOk = 1

! ---- classify ONE occurrence of the receiver at tcPos -> tcKind / tcEnd ----
TsClassify routine
  tcKind = ts:bad
  tcEnd  = tcPos
  gPos = tcPos
  do TsGet
  if ~gOk then exit.
  spIn = gTU
  do TsSplitRoot
  if spSuf = 'VALUEPTR'
    do TsHandedOn
    exit
  end
  if spSuf = '_DATAEND' then do TsLenHandedOn.
  if spSuf then exit.       ! recv._DataEnd and every other merged property read - SENSITIVE
  gPos = tcPos + 1
  do TsGet
  if ~gOk or                |
     gTxt <> '.'            ! foo(st) / st &= other - may alias the buffer
    tcKind = ts:bare ; exit
  end
  gPos = tcPos + 2
  do TsGet
  if ~gOk or                |
     gTy <> vt:label
    exit
  end
  mth = gTU
  if mth = 'GETVALUEPTR'
    do TsHandedOn
    exit
  end
  gPos = tcPos + 3
  do TsGet
  if ~gOk or                |
     gTxt <> '('            ! the tokenizer only leaves recv . name unmerged before a '('
    exit
  end
  mpOpen = tcPos + 3
  do TsMatchParen
  if ~mpClose then exit.
  tcEnd = mpClose
  do TsArgs
  kndName = self.TsMethodKind(mth)
  case kndName
  of ts:cleanSet
    do TsCleanSetArgs
  of ts:clipLen
    if agN then exit.       ! clipLength(pStr) measures SOMEONE ELSE's string
    tcKind = ts:clipLen
  of ts:read
    do TsNeedleArgs
  of ts:anchor
    do TsAnchorArgs
  end

! ---- the BUFFER itself at tcPos, as `recv.valuePtr` or `recv.getValuePtr()`. Read in place it is
!      one bad use on its line. Bound with &= or handed to a call, it can be written later, anywhere,
!      without the receiver's name - a bare mention in all but name, so it refuses the whole scope ----
TsHandedOn routine
  gPos = tcPos - 1
  do TsGet
  if gOk and (gTxt = '&=' or gTxt = '(' or gTxt = ',') then tcKind = ts:bare.

! ---- the LENGTH at tcPos, as `recv._DataEnd`. Read or written it is one bad use on its line. Bound
!      with &= (`n &= st._DataEnd`), its address taken, or handed whole to a call that may take it by
!      address (a *LONG, which the callee may keep), it can be written later, anywhere, without the
!      receiver's name - `n -= 2` moves the end of st - so it refuses the whole scope, as a bare
!      mention does. A call whose prototype takes that slot by value, a function on the pure
!      list, or the size of a NEW string only reads it ----
TsLenHandedOn routine
  gPos = tcPos - 1
  do TsGet
  if ~gOk then exit.
  if gTxt = '&=' then tcKind = ts:bare ; exit.
  if gTxt <> '(' and gTxt <> ',' then exit.
  gPos = tcPos + 1
  do TsGet
  if ~gOk then exit.
  if gTxt <> ')' and gTxt <> ',' then exit.
  if upper(self.tk.GetTok(tcPos - 3)) = 'NEW' then exit.
  if upper(self.tk.GetTok(tcPos - 4)) = 'NEW' and self.tk.GetTok(tcPos - 3) = '(' then exit.
  if upper(self.tk.GetTok(tcPos - 2)) = 'ADDRESS' or self.AutoArgIsRefParam(tcPos, 1) then tcKind = ts:bare.

! ---- clip / trim / removeByte / setValue: is THIS call one that leaves the buffer clean? ----
TsCleanSetArgs routine
  case mth
  of 'CLIP' orof 'TRIM'
    if agN then exit.       ! clip(alphabet) / trim(alphabet) - a different method
    tcKind = ts:cleanSet
    exit
  of 'REMOVEBYTE'
    if agN <> 1 or          |
       agS <> agE
      exit
    end
    gPos = agS
    do TsGet
    do TsByte32
    if ~gOk              or |
       gTy <> vt:Integer or |
       ~is32                ! only removing the SPACE byte proves the tail is clean
      exit
    end
    tcKind = ts:cleanSet
    exit
  end
  ! setValue(x, st:clip) - StringTheory clips as it stores, so the buffer lands clean.
  ! A bare setValue(x) stores an arbitrary string and is NOT clean-keep: see DEVIATION 1.
  if agN < 2 or             |
     agLS <> agLE
    exit
  end
  gPos = agLS
  do TsGet
  if ~gOk or                |
     gTU <> 'ST:CLIP'       ! the tokenizer merges a:b into one token, so this is one compare
    exit
  end
  ! ONLY THE STRING OVERLOAD CLIPS. Given another StringTheory, setValue(obj, st:clip) runs the
  ! overload that copies that object whole and reads its second argument only for st:lines, so
  ! the value lands with every trailing space it had. So the first argument must be text: a
  ! literal, a STRING, CSTRING or PSTRING, or an expression, which is handed over as a string.
  ! One name of any other kind - an object, or a name the symbol table cannot type - is not.
  if agS = agE
    gPos = agS
    do TsGet
    if ~gOk then exit.
    if gTy <> vt:literal
      case self.HayType(gTU, agS)
      of 'STRING' orof 'CSTRING' orof 'PSTRING'
      else
        exit
      end
    end
  end
  tcKind = ts:cleanSet

! ---- findChar / findChars / findByte / containsChar / containsByte: the needle decides ----
TsNeedleArgs routine
  if agN < 1    or          |
     agS <> agE             ! a computed needle - we cannot see what it is
    exit
  end
  case mth
  of 'FINDBYTE' orof 'CONTAINSBYTE'
    gPos = agS
    do TsGet
    do TsByte32
    if ~gOk              or |
       gTy <> vt:Integer or |
       is32                 ! byte 32 IS the space, however it is written - `032` is 32 too
      exit
    end
    tcKind = ts:read
    exit
  end
  do TsLitOk
  if ~ltOk then exit.
  tcKind = ts:read

! ---- is the integer token in gTxt the number 32, the space byte, however it is written? The
!      tokenizer types a run of digits as an integer, and a leading zero changes nothing - Clarion
!      reads `032` as 32 - so the digits are compared without their leading zeros ----
TsByte32 routine
  data
bz  long,auto
bn  long,auto
  code
  is32 = 0
  bn = len(clip(gTxt))
  bz = 1
  loop while bz < bn and gTxt[bz] = '0'
    bz += 1
  end
  if bn and gTxt[bz : bn] = '32' then is32 = 1.

! ---- the declaration labels that two or more procedures or methods of this file share: OVERLOADS,
!      told apart by their parameters, which the proof bank's key does not hold. A proof made in one
!      body must not be claimed by another, so a scope with such a label banks nothing ----
TsDupNames routine
  data
dz      long,auto
dn      string(vs:maxName),auto
seenSt  StringTheory
  code
  dupNmU.setValue(' ')
  seenSt.setValue(' ')
  loop dz = 1 to records(self.syms.scopes)
    get(self.syms.scopes, dz)
    if errorcode() then break.
    if self.syms.scopes.kind <> vs:scProc and self.syms.scopes.kind <> vs:scMethod then cycle.
    dn = upper(self.tk.GetTok(self.syms.scopes.startTok))
    if ~dn then cycle.
    if seenSt.findChars(' ' & clip(dn) & ' ')
      dupNmU.append(clip(dn) & ' ')
    else
      seenSt.append(clip(dn) & ' ')
    end
  end

! ---- getValue(): only an IMMEDIATELY enclosing clip() makes the trailing spaces dead ----
!      The runtime's clip() only: in other.clip(st.getValue()) the clip is the Clip(pAlphabet)
!      method of another object, and the value is the set of characters it removes.
TsAnchorArgs routine
  if agN or             |   ! getValue(start,len) is a slice, not the whole value
     tcPos < 3
    exit
  end
  gPos = tcPos - 1
  do TsGet
  if ~gOk or            |
     gTxt <> '('
    exit
  end
  gPos = tcPos - 2
  do TsGet
  if ~gOk            or |
     gTy <> vt:label or |
     gTU <> 'CLIP'
    exit
  end
  gPos = tcPos - 3
  do TsGet
  if gOk and gTxt = '.' then exit.
  gPos = mpClose + 1
  do TsGet
  if ~gOk or            |
     gTxt <> ')'        ! clip(recv.getValue() & x) - the clip covers more than the value
    exit
  end
  tcEnd  = mpClose + 1
  tcKind = ts:anchor

! ---- every DEPTH-0 line start of this scope's main code, plus the balance check ----
TsScopeLines routine
  data
lz  long,auto
  code
  free(TsLineQ)
  depth   = 0
  prevEol = 0
  scBad   = 0
  loop lz = codeT + 1 to mainEnd
    if self.IsEolTok(lz)
      prevEol = 1                          ! a physical newline: the NEXT real token starts a line
      cycle
    end
    gPos = lz
    do TsGet
    if ~gOk then scBad = 1 ; break.
    if gNull then cycle.                   ! trivia-only tail record - does not start a line either
    if prevEol and ~depth
      do TsIndentOk                        ! gPos is already lz; gTy/gLv are already copied out
      if indOk
        clear(TsLineQ)
        tsl:tslPos = lz
        add(TsLineQ)
      end
    end
    prevEol = 0
    if gLv = '+'
      depth += 1
    elsif gLv = '-' or (gTy = vt:end and gLv <> '+' and gLv <> '/')
      depth -= 1                           ! the inline-dot idiom: an INLINE '.' is retyped vt:end but may carry NO '-'
      if depth < 0 then scBad = 1 ; break.
    end
  end
  if ~scBad and depth then scBad = 1.      ! the belt: an unbalanced walk makes "depth 0" a lie

! ---- the simple local StringTheorys of this scope ----
TsCollect routine
  data
cz   long,auto
cNm  string(vs:maxName),auto
cDcl long,auto
  code
  free(TsRecvQ)
  if self.syms.syms &= NULL then exit.
  ! POSITIONAL sweep - deliberately NOT syms.FindSym. FindSym is a KEYED get, and a keyed
  ! read switches the queue's active order, after which a positional loop reads different
  ! rows than it started with. Everything needed is copied out here, in one pass, first.
  loop cz = 1 to records(self.syms.syms)
    get(self.syms.syms, cz)
    if errorcode() then break.
    if self.syms.syms.scopeId <> sc           or  |
       self.syms.syms.typeU <> 'STRINGTHEORY' or  |
       self.syms.syms.isRef                   or  |   ! `st &= other` re-points it and carries no call to notice
       self.syms.syms.isLike                  or  |
       self.syms.syms.isField
      cycle
    end
    cNm  = self.syms.syms.nameU
    cDcl = self.syms.syms.declTok
    if ~self.syms.IsColOneLabel(cDcl) then cycle. ! a PARAMETER is not a column-1 declaration
    if band(self.DeclAttrBits(cDcl), ab:over + ab:dim + ab:static + ab:thread) then cycle.
    clear(TsRecvQ)
    tsv:tsvNameU = cNm
    gPos = cDcl
    do TsGet
    tsv:tsvText = gTxt                            ! SOURCE case, so the inserted line reads like the file
    if ~tsv:tsvText then tsv:tsvText = cNm.
    add(TsRecvQ)
  end

! ---- classify every occurrence of rcU in this scope's main code. A method of a class the
!      procedure declares shares its data and may re-pad the buffer from outside this walk, so a
!      receiver such a method names is refused for the whole scope, as a bare mention is. The
!      scope is read again first: the scopes buffer has moved since the walk began.
!      The procedure's ROUTINEs share its data too. What one does to the receiver happens at the
!      DO, which already ends the region, except what outlives the DO: a reference bound there or
!      the object, its buffer or its length handed on from there (a bare mention). That refuses the
!      whole scope as it would in the main code ----
TsScanUses routine
  data
uz  long,auto
ue  long,auto
  code
  free(TsUseQ)
  recvBad = 0
  lastBad = 0
  if self.MayHaveLocalMethods(sc)
    self.syms.scopes.scopeId = sc
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if errorcode() then recvBad = 1 ; exit.
    if self.UsedInLocalMethods(rcU, self.syms.scopes.startTok, self.syms.scopes.endTok) then recvBad = 1 ; exit.
  end
  loop uz = codeT + 1 to mainEnd
    gPos = uz
    do TsGet
    if ~gOk then recvBad = 1 ; break.
    if gNull then cycle.
    if gTy = vt:reservedWord and gTU = 'DO'
      lastBad = uz ! a routine can touch any buffer - the region must start below it
      cycle
    end
    if gTy <> vt:label then cycle.
    spIn = gTU
    do TsSplitRoot
    if spRoot <> rcU then cycle.
    tcPos = uz
    do TsClassify
    if tcKind = ts:bare then recvBad = 1 ; break.
    clear(TsUseQ)
    tsu:tsuPos  = uz
    tsu:tsuEnd  = tcEnd
    tsu:tsuKind = tcKind
    add(TsUseQ)
    if tcKind = ts:bad then lastBad = uz.
  end
  if recvBad then exit.
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then recvBad = 1 ; exit.
  ue = self.syms.scopes.endTok
  loop uz = mainEnd + 1 to ue
    gPos = uz
    do TsGet
    if ~gOk then recvBad = 1 ; break.
    if gNull or gTy <> vt:label then cycle.
    spIn = gTU
    do TsSplitRoot
    if spRoot <> rcU then cycle.
    tcPos = uz
    do TsClassify
    if tcKind = ts:bare then recvBad = 1 ; break.
  end

! ---- is lsPos one of this scope's depth-0 line starts? ----
TsIsLineStart routine
  data
sz  long,auto
  code
  lsOk = 0
  loop sz = 1 to records(TsLineQ)
    get(TsLineQ, sz)
    if errorcode() then break.
    if tsl:tslPos = lsPos then lsOk = 1 ; break.
    if tsl:tslPos > lsPos then break.
  end

! ---- may the use in uPos/uEnd/uKind actually be edited? (trivia only - the classification is done) ----
TsUseEditable routine
  edOk = 0
  if uKind = ts:clipLen
    tcS = uPos
    tcE = uEnd
  elsif uKind = ts:anchor
    if uPos < 3 then exit.
    tcS = uPos - 2
    tcE = uEnd
  else
    exit
  end
  do TsTriviaClean
  if tcOk then edOk = 1.

! ---- can the procedure make the receiver UTF-16? Each mention MarkSetterAt finds is a risk but a setValue() given
!      another StringTheory that is a local of this procedure - not a parameter, a reference, STATIC or THREAD -
!      that nothing in it marks: that copy carries ANSI text ----
TsUtf16Risk routine
  rcRisk = 0 ; rcK = codeT + 1
  loop
    rcK = self.MarkSetterAt(rcU, rcK, mainEnd, rcEnc)
    if ~rcK then exit.
    rcRisk = 1
    if self.tk.GetTok(rcK + 1) = '.'
      if upper(self.tk.GetTok(rcK + 2)) <> 'SETVALUE' then exit.
      rcA = rcK + 3
    else
      if upper(self.tk.GetTok(rcK)) <> clip(rcU) & '.SETVALUE' then exit.
      rcA = rcK + 1
    end
    if self.tk.GetTok(rcA) <> '(' then exit.
    rcSrc = upper(self.tk.GetTok(rcA + 1))
    if rcSrc = rcU then exit.
    rcZ = self.syms.FindOwn(rcSrc, sc)
    if ~rcZ then exit.
    get(self.syms.syms, rcZ)
    if errorcode() or self.syms.syms.typeU <> 'STRINGTHEORY' or self.syms.syms.isRef then exit.
    if ~self.syms.IsColOneLabel(self.syms.syms.declTok) then exit. ! a parameter is the caller's
    if self.DeclHasAttr(self.syms.syms.declTok, 'STATIC') or self.DeclHasAttr(self.syms.syms.declTok, 'THREAD') then exit.
    if self.MarkSetterAt(rcSrc, codeT + 1, mainEnd, rcEnc) then exit.
    rcRisk = 0
    rcK += 1
  end

! ---- may we put a new statement line immediately before pTok? Not when the procedure can make the receiver
!      UTF-16: StringTheory's Clip() then drops trailing ' ',0 pairs, which the CLIP it retires would not ----
TsInsertOk routine
  insOk = 0
  if pTok < 2 then exit.
  if ~self.IsEolTok(pTok - 1) then exit. ! the line above must really END there - never split a continuation
  gPos = pTok
  do TsIndentOk
  if ~indOk then exit.
  do TsUtf16Risk
  if rcRisk then exit.
  insOk = 1

! ---- one receiver: find the region, decide, stage ----
TsReceiver routine
  data
rz  long,auto
  code
  do TsScanUses
  if recvBad or                           |
     ~records(TsUseQ)
    exit
  end
  ! ---- SPACELESS MODE first. It is strictly more permissive than the region below
  !      (it starts AT the setValue rather than below the last ts:bad use) and it inserts
  !      nothing, so when it validates there is nothing the clean-mode path could add.
  !      When it does not, everything below is exactly as it was.
  do TsSpacelessTry
  if slOk
    cleanFrom = slEnd
    do TsCountBelow
    if ~nAnchor and ~nClip then exit.     ! nothing to simplify
    do TsHalfA
    exit
  end
  ! ---- P: the first DEPTH-0 line start below the last use that refuses the region
  pTok = 0
  loop rz = 1 to records(TsLineQ)
    get(TsLineQ, rz)
    if errorcode() then break.
    if tsl:tslPos > lastBad then pTok = tsl:tslPos ; break.
  end
  if ~pTok then exit.
  ! ---- is the receiver ALREADY provably clean at the top of the region?
  alreadyCl = 0
  cleanFrom = pTok - 1
  firstIx   = 0
  loop rz = 1 to records(TsUseQ)
    get(TsUseQ, rz)
    if errorcode() then break.
    if tsu:tsuPos >= pTok then firstIx = rz ; break.
  end
  if firstIx
    get(TsUseQ, firstIx)
    if ~errorcode() and tsu:tsuKind = ts:cleanSet
      uPos  = tsu:tsuPos
      uEnd  = tsu:tsuEnd
      lsPos = uPos
      do TsIsLineStart
      if lsOk and self.IsEolTok(uEnd + 1)
        alreadyCl = 1                     ! an UNCONDITIONAL clean-setter, alone on its own depth-0 line
        cleanFrom = uEnd
      end
    end
  end
  ! ---- what is waiting to be simplified below the clean point?
  do TsCountBelow
  if ~nAnchor then exit.                  ! no anchor: nothing says the trailing spaces are dead
  if ~alreadyCl
    if ~nClip   or                        |   ! an insertion that only retires the anchor clip is a wash
       ~lastBad                           ! nothing above P has touched the buffer - do not clip at the top of a procedure
      exit
    end
    do TsInsertOk
    if ~insOk then exit.
    logLn  = self.LogLineOf(pTok)         ! captured BEFORE the edits - log coordinates only, never logic
    nSimp  = nAnchor + nClip
    nxPos  = pTok
    nxPos2 = pTok
    nxKind = 4
    nxTxt  = clip(rcTxt) & '.clip()'
    do TsPush
    inserts += 1
    if inserts + simps = 501
      pLog.append('BUILTIN TrailingSpaces: further detail lines suppressed (500 shown)<13,10>')
    end
    if inserts + simps <= 500
      pLog.append('BUILTIN TrailingSpaces line ' & logLn & ': inserted ' & clip(rcTxt) & '.clip() - ' & nSimp & ' later use(s) simplified<13,10>')
    end
  end
  do TsHalfA

! ---- count what is waiting to be simplified strictly below cleanFrom ----
TsCountBelow routine
  data
cz  long,auto
  code
  nAnchor = 0
  nClip   = 0
  loop cz = 1 to records(TsUseQ)
    get(TsUseQ, cz)
    if errorcode() then break.
    if tsu:tsuPos <= cleanFrom then cycle.
    uPos  = tsu:tsuPos
    uEnd  = tsu:tsuEnd
    uKind = tsu:tsuKind
    do TsUseEditable
    if ~edOk then cycle.
    if uKind = ts:anchor
      nAnchor += 1
    elsif uKind = ts:clipLen
      nClip += 1
    end
  end

! ---- HALF A: every qualifying use below the clean point ----
TsHalfA routine
  data
hz  long,auto
  code
  loop hz = 1 to records(TsUseQ)
    get(TsUseQ, hz)
    if errorcode() then break.
    if tsu:tsuPos <= cleanFrom then cycle.
    uPos  = tsu:tsuPos
    uEnd  = tsu:tsuEnd
    uKind = tsu:tsuKind
    do TsUseEditable
    if ~edOk then cycle.
    if uKind = ts:clipLen
      do TsStageClipLen
    elsif uKind = ts:anchor
      do TsStageAnchor
    end
  end

! ---- is this receiver STORED FROM a call whose summary is sm:spaceless, and does it
!      stay spaceless from there to the end of the scope?  If so every use below that store
!      is provably free of TRAILING spaces too, which is what licenses A1 and A2 without
!      inserting anything - and it is what lifts the MaskSigBase refusal, because a
!      setLength cannot EXPOSE a space in a string that has none. ----
TsSpacelessTry routine
  data
zz  long,auto
  code
  slOk   = 0
  slPos  = 0
  slEnd  = 0
  slIx   = 0
  slName = ''
  loop zz = records(TsUseQ) to 1 by -1       ! the LAST such store wins - everything above it is irrelevant
    get(TsUseQ, zz)
    if errorcode() then cycle.
    uPos   = tsu:tsuPos
    cnSelf = 0                               ! NOTHING is known about the buffer yet, so a self-slice term
    do TsSpaceSetAt                          !      here would be circular - `st.setValue(st.sub(1,5))` proves nothing
    if ~ssOk then cycle.
    lsPos = uPos
    do TsIsLineStart
    if ~lsOk then cycle.                     ! it must be UNCONDITIONAL: a depth-0 line start of its own
    if ~self.IsEolTok(ssEnd + 1) then cycle. ! ... and nothing else may share that line
    slPos  = uPos
    slEnd  = ssEnd
    slName = ssName
    slIx   = zz
    break
  end
  if ~slPos then exit.
  loop zz = slIx + 1 to records(TsUseQ)      ! nothing below it may put a space back
    get(TsUseQ, zz)
    if errorcode() then break.
    uPos = tsu:tsuPos
    do TsSpaceKeepAt
    if ~skOk
      do TsWhySetLen                         ! log why, when it is an unguarded setLength
      exit
    end
  end
  loop zz = slEnd + 1 to mainEnd             ! and a routine can do anything to any buffer
    gPos = zz
    do TsGet
    if ~gOk then cycle.
    if gTy = vt:reservedWord and gTU = 'DO' then exit.
  end
  slOk = 1

! ---- recv.setValue(<every top-level '&' term spaceless-yielding>) -> ssOk / ssEnd / ssName.
!      cnSelf must be set by the caller FIRST: 0 on the ESTABLISH walk, 1 on the KEEP walk. ----
TsSpaceSetAt routine
  ssOk   = 0
  ssEnd  = 0
  ssName = ''
  gPos = uPos
  do TsGet
  if ~gOk then exit.
  spIn = gTU
  do TsSplitRoot
  if spSuf then exit.
  gPos = uPos + 1
  do TsGet
  if ~gOk or             |
     gTxt <> '.'
    exit
  end
  gPos = uPos + 2
  do TsGet
  if ~gOk or             |
     gTU <> 'SETVALUE'
    exit
  end
  gPos = uPos + 3
  do TsGet
  if ~gOk or             |
     gTxt <> '('
    exit
  end
  mpOpen = uPos + 3
  do TsMatchParen
  if ~mpClose then exit.
  do TsArgs
  if agN <> 1 then exit. ! setValue(x, st:clip) is the clean-setter, not this
  ssEnd = mpClose        ! captured BEFORE TsConcatOk, which re-uses mpOpen/mpClose
  do TsConcatOk          ! the argument may be a CONCATENATION
  if ~cnOk
    ssEnd = 0
    exit
  end
  ssName = cnNm
  ssOk   = 1

! ---- the setValue argument [agS..agE] split on TOP-LEVEL '&' - depth 0 only, so an
!      '&' inside a nested call's argument list does NOT split - with EVERY term required to
!      be spaceless-yielding. A single term with no '&' is the plain case. ----
TsConcatOk routine
  data
kz  long,auto
kd  long,auto
ktS long,auto
  code
  cnOk = 0
  cnNm = ''
  ktS  = agS
  kd   = 0
  loop kz = agS to agE
    gPos = kz
    do TsGet
    if ~gOk then exit.
    if gTy = vt:literal then cycle.            ! an '&' INSIDE a quoted literal is text, not structure
    if gTxt = '('
      kd += 1
    elsif gTxt = ')'
      kd -= 1
      if kd < 0 then exit.
    elsif ~kd and gTxt = '&'
      tmS = ktS
      tmE = kz - 1
      do TsTermOk
      if ~tmOk then exit.
      ktS = kz + 1
    end
  end
  if kd then exit.                             ! unbalanced - "depth 0" was a lie
  tmS = ktS
  tmE = agE
  do TsTermOk                                  ! the last term (and the ONLY one when there is no '&')
  if ~tmOk then exit.
  if ~cnNm then cnNm = 'a space-free literal'. ! nothing named a callee - say so rather than log an empty name
  cnOk = 1

! ---- ONE term of the '&' chain. Three ways to qualify and nothing else; in particular
!      a BARE VARIABLE is refused, because a fixed STRING(n) concatenates WITH its padding and
!      would inject spaces. Confirmed: a Clarion PROCEDURE returning STRING
!      returns exactly its own length, not a padded field, which is what makes 1 and 2 safe. ----
TsTermOk routine
  tmOk = 0
  if tmE < tmS then exit.                                  ! `a & & b` - an empty term
  smNm = ''
  smF  = self.SummaryOfCallAt(tmS, tmE, scSelf, smNm)      ! 1. a call whose body we summarised as sm:spaceless
  if smF = sm:spaceless
    if ~cnNm then cnNm = smNm.
    tmOk = 1
    exit
  end
  if tmS = tmE                                             ! 3. a quoted literal with no space in it
    gPos = tmS
    do TsGet
    if ~gOk or                                             |
       gTy <> vt:literal                                   ! a BARE VARIABLE lands here and is REFUSED
      exit
    end
    do TsLitSpaceless
    exit
  end
  if ~cnSelf then exit.                                    ! 2. a SELF-SLICE - admissible ONLY on the KEEP walk, see below
  gPos = tmS
  do TsGet
  if ~gOk then exit.
  spIn = gTU
  do TsSplitRoot
  if spRoot <> rcU or                                      |   ! a DIFFERENT buffer, and we know nothing about it
     spSuf
    exit
  end
  gPos = tmS + 1
  do TsGet
  if ~gOk or                                               |
     gTxt <> '.'
    exit
  end
  gPos = tmS + 2
  do TsGet
  if ~gOk            or                                    |
     gTy <> vt:label or                                    |
     gTU <> 'SUB' and gTU <> 'SLICE' and gTU <> 'GETVALUE'
    exit
  end
  gPos = tmS + 3                                           ! ... a SLICING READER: a substring of a spaceless string has no spaces
  do TsGet
  if ~gOk or                                               |
     gTxt <> '('
    exit
  end
  mpOpen = tmS + 3
  do TsMatchParen
  if mpClose <> tmE then exit.                             ! the term must be EXACTLY the call - `st.sub(1,2) - f()` is not
  tmOk = 1

! ---- gTxt is a quoted literal token - is there a space, a tab or a '<' escape in it?
!      The '<' is refused because <32> IS a space under another name, which is the same call
!      TsLitOk makes about a needle and SkReplOk about a replacement. ----
TsLitSpaceless routine
  data
vz  long,auto
vn  long,auto
vc  string(1),auto
  code
  tmOk = 0
  if gCut then exit.    ! a literal longer than 255 characters arrived cut (TsGet): a cut copy cannot be scanned
  vn = len(clip(gTxt))
  if vn < 2 then exit.  ! not a quoted token at all
  loop vz = 2 to vn - 1
    vc = gTxt[vz]
    case val(vc)
    of 32 orof 9
      exit              ! ONE space in ONE literal poisons the whole result
    of 60
      exit
    end
  end
  tmOk = 1

! ---- can the use at uPos put a space back into the buffer? ----
TsSpaceKeepAt routine
  skOk = self.SpaceKeepUse(uPos)
  if skOk then exit.
  do TsTruncGuard    ! the ONE setLength form accepted from the line itself
  if skOk then exit.
  do TsProvenGuard   ! ... or one an EARLIER PASS accepted, before KnownRanges retired the guard
  if skOk then exit.
  do TsDataEndRead   ! a _DataEnd READ inside an argument EXPRESSION
  if skOk then exit.
  cnSelf = 1         ! HERE the buffer is already known spaceless, so a self-slice term is sound
  do TsSpaceSetAt    ! ... and a setValue of spaceless terms KEEPS it spaceless
  if ssOk then skOk = 1.

! ---- `if E <op> recv._DataEnd then recv.setLength(E).` - the author's own proof that
!      the setLength SHRINKS. It matters because StringTheory.SetLength PADS WITH BYTE 32
!      when it grows (see the DEVIATION on BuildSummaries), so an unguarded setLength can
!      put trailing spaces into a spaceless buffer. One-liner form only: a block IF would
!      need the frame walk, and under-reach is the right answer here. ----
TsTruncGuard routine
  data
tz  long,auto
lf  long,auto
aS  long,auto
aE  long,auto
vz  long,auto ! walks the argument span looking for a call - see the note at the SpanTokEqual test
  code
  skOk = 0
  if uPos < 6 then exit.
  gPos = uPos + 1
  do TsGet
  if ~gOk or                                                 |
     gTxt <> '.'
    exit
  end
  gPos = uPos + 2
  do TsGet
  if ~gOk or                                                 |
     gTU <> 'SETLENGTH'
    exit
  end
  gPos = uPos + 3
  do TsGet
  if ~gOk or                                                 |
     gTxt <> '('
    exit
  end
  mpOpen = uPos + 3
  do TsMatchParen
  if ~mpClose then exit.
  aS = mpOpen + 1
  aE = mpClose - 1
  if aE < aS then exit.                                      ! setLength() with no argument is not a shape we model
  gPos = uPos - 1
  do TsGet
  if ~gOk or                                                 |
     gTU <> 'THEN'
    exit
  end
  gPos = uPos - 2
  do TsGet
  if ~gOk then exit.
  spIn = gTU
  do TsSplitRoot
  if spRoot <> rcU or                                        |   ! the bound must be THIS receiver's own length
     spSuf <> '_DATAEND'
    exit
  end
  gPos = uPos - 3
  do TsGet
  if ~gOk or                                                 |
     gTxt <> opLT and gTxt <> opLE
    exit
  end
  lf = 0
  tz = uPos - 4
  loop while tz >= 1
    if self.IsEolTok(tz)
      lf = tz + 1
      break
    end
    tz -= 1
  end
  if ~lf or                                                  |
     lf > uPos - 4                                           ! nothing left for the condition
    exit
  end
  gPos = lf
  do TsGet
  if ~gOk then exit.
  if gTy <> vt:reservedWord then exit.
  if gTU <> 'IF' then exit.
  if gLv <> '+' then exit.
  if lf + 1 > uPos - 4 then exit.                            ! empty condition
  if ~self.SpanTokEqual(lf + 1, uPos - 4, aS, aE) then exit. ! the two E spans must be the SAME expression
  ! SAME TEXT IS NOT SAME VALUE. SpanTokEqual proves the two spellings of E match token for
  !   token; it cannot prove they EVALUATE alike, and E is evaluated twice - once in the
  !   condition and once in setLength(). If E carries a call that can answer differently the
  !   second time, the condition tests one length and setLength applies another, and a
  !   setLength that GROWS pads with byte 32 - poisoning the very spaceless region this guard
  !   was read as proving. The author's own guard is already racy in such code, but this pass
  !   BANKS the proof for later rewrites, so it must not adopt one it cannot stand behind.
  !   Any parenthesis in the span refuses. That also turns away pure calls, and deliberately:
  !   a length expression built from a call is rare, purity here would have to be proved rather
  !   than assumed, and this whole pass exists to under-reach rather than guess.
  vz = aS
  loop while vz <= aE
    gPos = vz
    do TsGet
    if gOk and gTxt = '(' then exit.
    vz += 1
  end
  gPos = mpClose + 1
  do TsGet
  if ~gOk or                                                 |
     gTy <> vt:end                                           ! the inline terminator - block form is not modelled
    exit
  end
  skOk = 1
  tpAS = aS                                                  ! the author's proof exists RIGHT NOW - bank it
  tpAE = aE
  do TsProvenAdd

! ---- THE PROOF OUTLIVES THE GUARD.
!      TsTruncGuard accepts `recv.setLength(E)` only while the author's own same-line proof
!          if E <  recv._DataEnd then recv.setLength(E).
!      is still there. BUILTIN KnownRanges deletes exactly that IF, because with E carrying
!      rk:posBound the condition provably cannot fail - a correct deletion of genuinely dead
!      code. So the guard is present on pass 1 and gone from pass 2 on, and TrailingSpaces
!      gives a DIFFERENT answer about the same line on different passes. Observed, not
!      supposed: trailerode3.clw (a working fixture, not shipped) -
!          pass 1  BUILTIN KnownRanges line 82: guard on P cannot fail - if/then removed
!          pass 2  BUILTIN TrailingSpaces line 82: pass 2 REFUSED st - unguarded setLength
!      Nothing was lost THERE only because TrailingSpaces reached the region first on pass 1.
!      A region first reachable on pass 2 - because a rule rewrote some other use below the
!      store during pass 1 - is refused on every pass and converts never, silently, since a
!      builtin reports what it DID and not what it declined.
!
!      vitrules.txt puts TrailingSpaces BEFORE KnownRanges inside GROUP analysis, which holds
!      this together, and it only holds WITHIN one pass. Correctness must not rest on a line
!      order in a file most users will never open - this is an MIT tool for other people's code.
!
!      THE FIX IS TO REMEMBER, NOT TO REORDER. When TsTruncGuard succeeds, bank
!      (scope NAME, receiver, argument text). Later passes accept a bare setLength matching a
!      bank row. The key is the scope's declaration LABEL, never its scopeId: ids are
!      positional, and a scope-removing builtin - UnusedRoutines commenting out a routine -
!      renumbers them at the reparse, so an id banked on one pass can belong to a DIFFERENT
!      procedure on the next. With `st` and `p - 1` for the other two thirds of the key, that
!      is a collision waiting to happen, and its failure mode is the bad direction: a proof
!      nobody made, spaces left in a buffer the region claims is spaceless. KnownRanges is untouched: the guard IS dead and deleting it IS right.
!      THE KEY NAMES THE SITE AS WELL (TsSiteKey): the setLength's place among its receiver's setLength
!      calls in the scope's code, and how many there are. Argument text names an expression, not a call:
!      `p - 1` proved on one line says nothing of `p - 1` on another line after p is written, so a bare
!      setLength elsewhere in the scope - even in the pass that banked the proof - must not claim it.
!      KnownRanges deleting the guard changes neither number. A rule that adds or removes a setLength
!      of the same receiver changes the count, and the proof stops matching: under-reach again.
!      DELIBERATELY CONSERVATIVE - the identity is the argument's TOKEN TEXT, so if a rule
!      rewrites E between passes the row stops matching and we simply refuse as before.
!      Under-reach is the correct failure here; a stale proof would put spaces in a buffer
!      the whole region claims is spaceless.
!      Per FILE: TransformFile and TransformText both free self.tsProven before parsing.
TsProvenAdd routine
  do TsArgText                                                    ! tpAS..tpAE -> tpArgU
  do TsSiteKey
  if ~tpArgU  or                                                  |
     ~scNameU                                                     ! no name = no stable key. Bank nothing rather than
    exit
  end
                                                                  !   bank under an id that a mid-run reparse can hand to someone else.
  do TsProvenFind
  if tpHit then exit.                                             ! already banked - one row per proof
  self.tsProven.tpNameU = scNameU
  self.tsProven.tpRecvU = rcU
  self.tsProven.tpArgU  = tpArgU
  self.tsProven.tpOrd   = tpOrd
  self.tsProven.tpCnt   = tpCnt
  add(self.tsProven)

! ---- is the use at uPos a bare `recv.setLength(E)` whose E an earlier pass already proved? ----
TsProvenGuard routine
  skOk = 0
  if records(self.tsProven) < 1 then exit.                              ! nothing banked - the common case, so test it first
  gPos = uPos + 1
  do TsGet
  if ~gOk or                                                            |
     gTxt <> '.'
    exit
  end
  gPos = uPos + 2
  do TsGet
  if ~gOk or                                                            |
     gTU <> 'SETLENGTH'
    exit
  end
  gPos = uPos + 3
  do TsGet
  if ~gOk or                                                            |
     gTxt <> '('
    exit
  end
  mpOpen = uPos + 3
  do TsMatchParen
  if ~mpClose then exit.
  tpAS = mpOpen + 1
  tpAE = mpClose - 1
  if tpAE < tpAS then exit.                                             ! setLength() with no argument is not a shape we model
  do TsArgText
  if ~tpArgU then exit.
  do TsSiteKey
  do TsProvenFind
  if tpHit
    skOk = 1
    ! A RECEIPT for the one decision here that rests on something not visible in this pass's
    ! text. Everything else TrailingSpaces does can be read off the line in front of it; this
    ! accepts a BARE setLength because an earlier pass saw a guard that KnownRanges has since
    ! deleted, and without a line in the report there is nothing to grep for when asking
    ! whether the bank fired at all. It also names the scope the proof was made in, which is
    ! the whole point of the key: if that name is ever not the procedure you expected,
    ! the bank has handed out somebody else's proof.
    pLog.append('BUILTIN TrailingSpaces line ' & self.LogLineOf(uPos) & |
                ': bare setLength accepted - proved on an earlier pass in ' & clip(scNameU) & '<13,10>')
  end

! ---- tpAS..tpAE joined, upper-cased, single-spaced. Long spans are refused rather than
!      truncated: a truncated key could collide with a DIFFERENT expression and hand out a
!      proof that was never made. ----
TsArgText routine
  data
tz  long,auto
  code
  ! built in a StringTheory, not by `tpArgU = clip(tpArgU) & ...`. That self-append
  ! form re-reads and re-clips the whole accumulator on EVERY term - quadratic - and it is the
  ! shape that silently truncates the moment the buffer is full. append() just writes at the end.
  ! The refusal below stays: an argument too long to hold is one we decline to key on at all,
  ! because a truncated key could collide with a DIFFERENT expression and hand out a proof
  ! nobody made. Under-reach is the safe direction here.
  tpArg._dataEnd = 0
  loop tz = tpAS to tpAE
    gPos = tz
    do TsGet
    if ~gOk or  |
       ~gTU
      cycle
    end
    if tpArg._dataEnd then tpArg.append(' ').
    tpArg.append(clip(gTU))
  end
  if tpArg._dataEnd > size(tpArgU)
    tpArgU = '' ! too long to key safely - refuse the whole proof
  else
    tpArgU = tpArg.getValue()
  end

! ---- the setLength whose receiver is the token at uPos, as a site: tpOrd = its place among the
!      setLength calls on that same receiver in the scope's code, tpCnt = how many there are ----
TsSiteKey routine
  data
tz  long,auto
tr  string(vs:maxName),auto
  code
  tpOrd = 0 ; tpCnt = 0
  tr = upper(self.tk.GetTok(uPos))
  if ~tr then exit.
  loop tz = codeT to mainEnd
    if upper(self.tk.GetTok(tz)) <> tr then cycle.
    if self.tk.GetTok(tz + 1) <> '.' then cycle.
    if upper(self.tk.GetTok(tz + 2)) <> 'SETLENGTH' then cycle.
    tpCnt += 1
    if tz = uPos then tpOrd = tpCnt.
  end

! ---- scNameU + rcU + tpArgU + the site -> tpHit ----
TsProvenFind routine
  data
tz  long,auto
  code
  tpHit = 0
  if ~scNameU then exit.                   ! an unnamed scope can neither bank nor claim a proof
  loop tz = 1 to records(self.tsProven)
    get(self.tsProven, tz)
    if errorcode() then break.
    if self.tsProven.tpNameU <> scNameU or |
       self.tsProven.tpRecvU <> rcU     or |
       self.tsProven.tpArgU <> tpArgU   or |
       self.tsProven.tpOrd <> tpOrd     or |
       self.tsProven.tpCnt <> tpCnt
      cycle
    end
    tpHit = 1
    break
  end

! ---- DIAGNOSTIC ONLY - transforms nothing. TsSpaceKeepAt has just refused the use at
!      uPos, which abandons the whole spaceless region below the store. If that use is a
!      `recv.setLength(...)`, SAY SO: the one thing that makes such a use acceptable is the
!      author's own same-line shrink proof (TsTruncGuard), and BUILTIN KnownRanges deletes
!      exactly that guard because it provably cannot fail. Silence here reads identically to
!      "nothing matched" and to "nobody looked".
!      HOW TO READ IT: a refusal that appears at pass 2 or later on a line that did NOT refuse
!      at pass 1 is KnownRanges having taken the evidence between the two passes. The ordering
!      rule in vitrules.txt (TrailingSpaces BEFORE KnownRanges) only holds WITHIN one pass;
!      the fixpoint runs the pair again. Same line refusing on every pass = an ordinary
!      unguarded setLength the author never proved, and correctly refused.
TsWhySetLen routine
  gPos = uPos + 1
  do TsGet
  if ~gOk or            |
     gTxt <> '.'
    exit
  end
  gPos = uPos + 2
  do TsGet
  if ~gOk or            |
     gTU <> 'SETLENGTH'
    exit
  end
  pLog.append('BUILTIN TrailingSpaces line ' & self.LogLineOf(uPos) & ': pass ' & self.curPass                                            & |
              ' REFUSED ' & clip(rcTxt) & ' - unguarded setLength, and no earlier pass proved it. SetLength GROWS and pads with byte 32,' & |
              ' so the only accepted form is `if E << ' & clip(rcTxt) & '._DataEnd then '                                                 & |
              clip(rcTxt) & '.setLength(E).` - if that guard was there on pass 1, KnownRanges removed it<13,10>')

! ---- a READ of `recv._DataEnd` that SpaceKeepUse refuses on POSITION alone. It refuses
!      every merged _DataEnd whose previous token is '(' or ',' because a bare argument can
!      bind to a *LONG parameter and be WRITTEN, and growing _DataEnd exposes the slack behind
!      it. An argument that is an EXPRESSION cannot: Clarion evaluates it into a temporary and
!      passes that by value. So the read is accepted only when the very NEXT token is a binary
!      operator, which is exactly what makes it an expression. `f(st._DataEnd)` and
!      `f(a, st._DataEnd, b)` stay refused, and every other verdict is left to SpaceKeepUse.
!      This is the call-site walk only - SpaceKeepUse itself is untouched, because it also runs
!      inside the summary pre-pass. Needed by parser.MaskSigBase:
!          st.sub(choose(q < 0, st._DataEnd + q + 1, q), ...)     - ',' before it, '+' after ----
TsDataEndRead routine
  skOk = 0
  if uPos < 2 then exit.
  gPos = uPos
  do TsGet
  if ~gOk then exit.
  spIn = gTU
  do TsSplitRoot
  if spRoot <> rcU or            |
     spSuf <> '_DATAEND'         ! recv.valuePtr hands out a &STRING that can be written THROUGH
    exit
  end
  gPos = uPos - 1
  do TsGet
  if ~gOk or                     |
     gTxt <> '(' and gTxt <> ',' ! the ONLY case SpaceKeepUse refuses on position alone
    exit
  end
  gPos = uPos + 1
  do TsGet
  if ~gOk then exit.
  case gTxt
  of '+' orof '-' orof '*' orof '/' orof '^' orof '&'
    skOk = 1                     ! `+=` and every other compound assignment is ONE two-character token
  end

! ---- A1: recv.clipLength() -> recv._DataEnd (ONE token, as the tokenizer would build it) ----
TsStageClipLen routine
  logLn  = self.LogLineOf(uPos)
  nxTxt  = ''
  nxPos  = uPos + 1
  nxPos2 = uEnd
  nxKind = 1
  do TsPush     ! drop  . clipLength ( )
  nxPos  = uPos
  nxPos2 = uPos
  nxKind = 3
  nxTxt  = clip(rcTxt) & '._DataEnd'
  do TsPush     ! the receiver token BECOMES the merged property read
  simps += 1
  if inserts + simps = 501
    pLog.append('BUILTIN TrailingSpaces: further detail lines suppressed (500 shown)<13,10>')
  end
  if inserts + simps <= 500
    if slOk     ! the evidence is in ANOTHER procedure, so the log must name it
      pLog.append('BUILTIN TrailingSpaces line ' & logLn & ': ' & clip(rcTxt) & '.clipLength() is ' & clip(rcTxt) & '._DataEnd here - ' & clip(rcTxt) & ' is spaceless via ' & clip(slName) & '<13,10>')
    else
      pLog.append('BUILTIN TrailingSpaces line ' & logLn & ': ' & clip(rcTxt) & '.clipLength() is ' & clip(rcTxt) & '._DataEnd here - the buffer has no trailing spaces<13,10>')
    end
  end

! ---- A2: clip(recv.getValue()) -> recv.getValue() ----
TsStageAnchor routine
  logLn  = self.LogLineOf(uPos)
  nxTxt  = ''
  nxPos  = uEnd
  nxPos2 = uEnd
  nxKind = 1
  do TsPush         ! clip's closing paren
  nxPos  = uPos
  nxPos2 = uPos - 2
  nxKind = 2
  do TsPush         ! the receiver inherits clip's leading trivia
  nxPos  = uPos - 2
  nxPos2 = uPos - 1
  nxKind = 1
  do TsPush         ! `clip` and its '('
  simps += 1
  if inserts + simps = 501
    pLog.append('BUILTIN TrailingSpaces: further detail lines suppressed (500 shown)<13,10>')
  end
  if inserts + simps <= 500
    if slOk         ! name the procedure the fact came from
      pLog.append('BUILTIN TrailingSpaces line ' & logLn & ': clip() around ' & clip(rcTxt) & '.getValue() is redundant - ' & clip(rcTxt) & ' is spaceless via ' & clip(slName) & '<13,10>')
    else
      pLog.append('BUILTIN TrailingSpaces line ' & logLn & ': clip() around ' & clip(rcTxt) & '.getValue() is redundant - removed<13,10>')
    end
  end

! ---- append one staged edit (dataless routine -> no CODE section) ----
TsPush routine
  clear(TsEdQ)
  tse:tsePos  = nxPos
  tse:tsePos2 = nxPos2
  tse:tseKind = nxKind
  tse:tseTxt  = nxTxt
  add(TsEdQ)

! ---- apply the staged edits HIGHEST POSITION FIRST; a delete or an insert shifts everything
!      above it. Ties are broken by KIND ascending so that an INSERT at a position is applied
!      LAST, after any rewrite of the token already at that position. A kind-2 donor is ALWAYS
!      below its target, so by the time the sweep reaches the target the donor has not moved. ----
TsApply routine
  data
az  long,auto
  code
  sort(TsEdQ, -tse:tsePos, +tse:tseKind)
  loop az = 1 to records(TsEdQ)
    get(TsEdQ, az)
    if errorcode() then break.
    case tse:tseKind
    of 1
      self.tk.DeleteToks(tse:tsePos, tse:tsePos2)
    of 2
      get(self.tk.tokens, tse:tsePos2)
      if errorcode() then cycle.
      sbSt.free()
      if not self.tk.tokens.strBefore &= NULL
        sbSt.setValue(self.tk.tokens.strBefore)
      end
      if sbSt._DataEnd
        self.tk.SetStrBefore(tse:tsePos, sbSt.valuePtr[1 : sbSt._DataEnd])
      else
        self.tk.SetStrBefore(tse:tsePos, '')
      end
    of 3
      self.tk.SetTok(tse:tsePos, clip(tse:tseTxt)) ! strBefore OMITTED = keep the existing leading trivia
    of 4
      do TsApplyInsert
    end
  end

! ---- kind 4: put `recv.clip()` on its own line immediately before the token at tsePos ----
TsApplyInsert routine
  data
iz      long,auto
ik      long,auto
ic      string(1),auto
sbLen   long,auto
lnNo    long,auto
nBefore long,auto
nAdded  long,auto
  code
  get(self.tk.tokens, tse:tsePos)
  if errorcode() then exit.
  lnNo = self.tk.tokens.lineNo          ! the construct's CURRENT line - stamped onto the new tokens below
  indSt.free()
  if not self.tk.tokens.strBefore &= NULL
    sbLen = size(self.tk.tokens.strBefore)
    ik = sbLen
    loop while ik >= 1                  ! trailing whitespace run = the indent (CaptureIndentE's rule)
      ic = self.tk.tokens.strBefore[ik]
      case val(ic)
      of 32 orof 9                      ! <space> orof <tab>
        ik -= 1
      else
        break
      end
    end
    if ik < sbLen then indSt.setValue(sub(self.tk.tokens.strBefore, ik + 1, sbLen - ik)).
  end
  ! a comment parked in front of the construct - lines of its own in its trivia - must stay
  ! ABOVE BOTH lines, not between them (14 Sep 2026). No staged insert has one today: TsInsertOk
  ! asks TsIndentOk, which refuses a construct whose trivia is not spaces and tabs alone, so
  ! parkSt stays empty; this keeps the comment in its place should that test ever allow one.
  parkSt.free()
  if not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(33, 1,, self.tk.tokens.strBefore) then parkSt.setValue(self.tk.tokens.strBefore). ! '!'
  end
  insSt.setValue(tse:tseTxt,st:clip)
  insSt.append('<13,10>')                 ! our statement closes its OWN line; the construct keeps its own trivia
  nBefore = records(self.tk.tokens)
  self.tk.InsertString(tse:tsePos, insSt)
  nAdded = records(self.tk.tokens) - nBefore
  if nAdded < 1 then exit.
  ! the whole old trivia, comment and indent, in front of OUR line; the construct keeps its indent alone
  if parkSt._DataEnd
    self.tk.SetStrBefore(tse:tsePos, parkSt.getValue())
    self.tk.SetStrBefore(tse:tsePos + nAdded, indSt.getValue())
  elsif indSt._DataEnd
    self.tk.SetStrBefore(tse:tsePos, indSt.valuePtr[1 : indSt._DataEnd])
  end
  ! THE LINE MAP. InsertString leaves lineNo at zero, and MapFold gives a wholly-inserted
  ! line to its PREDECESSOR when no token on it carries a real line. The decision is
  ! that the SUCCESSOR wins - the construct this clip enables - so stamp its line here.
  loop iz = tse:tsePos to tse:tsePos + nAdded - 1
    get(self.tk.tokens, iz)
    if errorcode() then break.
    self.tk.tokens.lineNo = lnNo
    put(self.tk.tokens)
  end

! ------------------------------------------------------------------------------------
! The ONE place the TrailingSpaces whitelist lives: what a StringTheory method name COULD
! be, on its name alone. The caller (TsClassify) still has to validate the arguments -
! `clip()` is a clean-setter but `clip(alphabet)` is a different method, `clipLength()` is
! a blind read but `clipLength(pStr)` measures someone else's string, and a findChar whose
! needle is a space is not blind at all. Anything absent is ts:bad, which is the safe
! direction: ts:bad only ever shrinks the region the pass may touch.
! Deliberately NOT here, and see the DEVIATION notes on BuiltinTrailingSpaces for why:
!   setLength / setValue-without-st:clip  - blind, but they can CREATE a trailing space;
!   sub / slice / crop                    - "does it reach the end" is a run-time property;
!   append / prepend / len / length / _DataEnd - they observe or relocate the spaces.
! ------------------------------------------------------------------------------------
VitEngine.TsMethodKind Procedure(STRING pMethodU)
  code
  case upper(pMethodU)
  of 'CLIP'       orof 'TRIM'      orof 'REMOVEBYTE'   orof 'SETVALUE'
    return ts:cleanSet
  of 'CLIPLENGTH'
    return ts:clipLen
  of 'GETVALUE'
    return ts:anchor
  of 'FINDCHAR'   orof 'FINDCHARS' orof 'CONTAINSCHAR' orof 'FINDBYTE' orof 'CONTAINSBYTE'
    return ts:read
  end
  return ts:bad

! ====================================================================================
! BUILTIN KeywordCase (OPT-IN, cosmetic) - normalise reserved-word case.
!   BUILTIN KeywordCase, STYLE('lower'|'upper'|'title')   (default lower; bare `, UPPER` etc. also ok;
!                                                        'capitalise', 'capitalize', 'camel' and 'pascal' are all 'title')
!   BUILTIN KeywordCase, STYLE('capitalise'), UPPER('IF OR AND ELSE CASE OF OROF')
!       - an EXCEPTION LIST: the words in it get that case whatever the style. UPPER(...),
!         LOWER(...) and CAPITALISE(...)/TITLE(...) lists; the command line's --kwupper=,
!         --kwlower= and --kwcapitalise= add to them
! Recases every reserved-word token (type='r') to the chosen style: lower `if`, UPPER `IF`,
! or Title `If`.  This is byte-safe by construction - the tokenizer flags a word 'r' ONLY in
! keyword position and NEVER in column 1, so identifiers (even ones spelled like a keyword)
! are type 'b'/label and are left untouched.  Clarion is case-insensitive, so recasing a
! keyword can never change meaning.  In-place SetTok (same length), no reparse needed.
! Scope: reserved words incl. structure keywords (PROCEDURE/CODE/GROUP/QUEUE/CLASS/...), and
! declaration/prototype ATTRIBUTES in attribute position - `,AUTO`, `,OVER`, `,STATIC` and the
! rest of IsClarionAttribute's list, which is why `Flag BYTE,AUTO` recases with everything else.
! An attribute is only safe there because of WHERE it sits: the test is `~col1 and prevComma`,
! so a variable legitimately named `Auto` or `Over` is a label and is never touched.
! SCALAR DATA TYPES (BYTE, LONG, STRING, DATE ...) are recased when they are not in column 1 -
! there they are reserved and cannot be a label; in column 1 they are a label and are left alone.
! RUNTIME BUILTINS (ROUND, EOF ...) are recased only in call position (a '(' follows) and only
! when no user procedure of that name exists.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinKeywordCase Procedure(StringTheory pLog)
styleU    string(12),AUTO
kwStyle   string(12),auto ! the case THIS keyword gets: the style, or its exception list's
upL       StringTheory    ! ' IF OR AND ' - the exception lists, upper, space-fenced
lowL      StringTheory
titL      StringTheory
nm        string(12),auto
hasVal    byte,auto       ! this option carries a (...) value
raw       StringTheory
s         long,auto
i         long,auto
n         long,auto
oldTxt    string(vs:maxName),auto
newTxt    string(vs:maxName),auto
col1      byte,auto
isKw      long,auto
nextParen byte,auto
prevComma byte,auto
prevDot   byte,auto       ! the token before this one is a dot
firstOL   byte,auto       ! this token is first on its line
changes   long
  code
  styleU = 'LOWER'                                                                   ! default (matches the common Clarion house style)
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      nm     = self.CaseStyleWord(upper(self.rl.rules.bparmQ.name))                  ! CAPITALISE(...), CAMEL... arrive as TITLE
      hasVal = choose(not self.rl.rules.bparmQ.value &= NULL)
      if hasVal
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
      end
      case nm
      of 'STYLE'                                                                     ! STYLE('capitalise'), in any of its spellings
        if hasVal then styleU = self.CaseStyleWord(upper(raw.getValue())).
      of 'UPPER' orof 'LOWER' orof 'TITLE'
        if ~hasVal
          styleU = nm                                                                ! the bare form: BUILTIN KeywordCase, UPPER
        else                                                                         ! UPPER('IF OR AND'): an EXCEPTION LIST - those
          raw.replaceByte(44, 32)                                                    !   words get this case whatever the style
          case nm
          of 'UPPER'
            upL.append(' ' & upper(raw.getValue()) & ' ')
          of 'LOWER'
            lowL.append(' ' & upper(raw.getValue()) & ' ')
          else
            titL.append(' ' & upper(raw.getValue()) & ' ')
          end
        end
      end
    end
  end

  if not self.kwUpper &= NULL and self.kwUpper._DataEnd                              ! --kwupper=IF,OR,AND on the command line
    raw.setValue(self.kwUpper)
    raw.replaceByte(44, 32)                                                          ! replace all <comma> with <space>
    upL.append(' ' & upper(raw.getValue()) & ' ')
  end
  if not self.kwLower &= NULL and self.kwLower._DataEnd
    raw.setValue(self.kwLower)
    raw.replaceByte(44, 32)                                                          ! replace all <comma> with <space>
    lowL.append(' ' & upper(raw.getValue()) & ' ')
  end
  if not self.kwTitle &= NULL and self.kwTitle._DataEnd
    raw.setValue(self.kwTitle)
    raw.replaceByte(44, 32)                                                          ! replace all <comma> with <space>
    titL.append(' ' & upper(raw.getValue()) & ' ')
  end

  n = records(self.tk.tokens)
  loop i = 1 to n
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL                                   or               |
       size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' or               |   ! EOL tokens can never recase - skip both peeks
       self.tk.tokens.type = ''''                                                    ! string literals likewise
      cycle
    end
    oldTxt = self.tk.tokens.tok
    col1   = choose(self.tk.tokens.firstOnLine and self.tk.tokens.strBefore &= null) ! a col-1 word can be a label
    firstOL = self.tk.tokens.firstOnLine                                             ! capture now (the peeks below clobber the buffer)
    isKw   = self.tk.TokenIsReservedWord()                                           ! capture NOW: the peeks below clobber the buffer
    prevComma = 0 ; prevDot = 0
    if i > 1
      get(self.tk.tokens, i - 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.tok = ',' then prevComma = 1.
        if self.tk.tokens.tok = '.' then prevDot = 1.
      end
    end
    nextParen = 0
    get(self.tk.tokens, i + 1)
    if ~errorcode() and not self.tk.tokens.tok &= NULL
      if self.tk.tokens.tok = '(' then nextParen = 1.
    end
    ! Recase four identifier-safe classes.  (1) tokenizer keyword (IF/ELSE/PROCEDURE/END/MAP, col-1
    ! labels excluded).  (2) a SCALAR data type in non-col-1 position -
    ! genuinely reserved, never a label.  (3) a RUNTIME BUILTIN (ROUND/EOF/...) in CALL position
    ! (next '(') that is NOT a user proc - so a field `Status` (no '(') or a user proc `Round` is
    ! untouched.  (4) a declaration/prototype ATTRIBUTE (AUTO/OVER/STATIC/...) in attribute position
    ! (prev token ','); the dual-use attrs TYPE/NAME/C/RAW are excluded (they are real field names).
    if prevDot and ~firstOL then cycle.                                              ! a member/field access (Rec.Time) is an identifier - never recase
    if isKw
      ! keyword - recase
    elsif ~col1 and self.IsScalarType(upper(oldTxt))
      ! scalar type - recase
    elsif ~col1 and nextParen and self.IsRuntimeBuiltin(upper(oldTxt)) and ~self.IsUserProc(upper(oldTxt))
      ! runtime builtin call - recase
    elsif ~col1 and prevComma and self.IsClarionAttribute(upper(oldTxt))
      ! declaration / prototype attribute - recase
    else
      cycle
    end
    kwStyle = styleU                                                                 ! a word in an exception list takes that list's case
    if upL._DataEnd  and upL.findChars(' ' & upper(clip(oldTxt)) & ' ')  then kwStyle = 'UPPER'.
    if lowL._DataEnd and lowL.findChars(' ' & upper(clip(oldTxt)) & ' ') then kwStyle = 'LOWER'.
    if titL._DataEnd and titL.findChars(' ' & upper(clip(oldTxt)) & ' ') then kwStyle = 'TITLE'.
    newTxt = self.RecaseWord(oldTxt, kwStyle)
    if newTxt <> oldTxt
      self.tk.SetTok(i, clip(newTxt))                                                ! same length -> in-place text swap, positions unchanged
      changes += 1
      if changes <= 500
        pLog.append('BUILTIN KeywordCase line ' & self.LogLineOf(i) & ': ' & clip(oldTxt) & ' -> ' & clip(newTxt) & '<13,10>')
      end
    end
  end
  if changes
    ! SetTok re-runs TokenType, which clears the level marks that END/'.' get in a later pass;
    ! reparse rebuilds every type/level from the recased text so block nesting stays intact.
    self.wantReparse = true
    pLog.append('BUILTIN KeywordCase (' & clip(styleU) & '): ' & changes & ' keyword(s) recased this pass<13,10>')
  end
  return changes

! ------------------------------------------------------------------------------------
! the one word for a keyword-case style. A user reaches for CAPITALISE (or CAPITALIZE, or the
! older CAMEL and PASCAL) and the code below knows only TITLE; every other word - LOWER,
! UPPER, STYLE, a list name - is returned as it came. One place for it.
! ------------------------------------------------------------------------------------
VitEngine.CaseStyleWord Procedure(STRING pWordU)
  code
  case pWordU
  of 'CAPITALISE' orof 'CAPITALIZE' orof 'CAMEL' orof 'PASCAL'
    return 'TITLE'
  end
  return clip(pWordU)

! ------------------------------------------------------------------------------------
! Recase one word to pStyleU: UPPER -> all caps, TITLE/CAMEL/PASCAL -> first cap rest lower,
! anything else (incl. LOWER) -> all lower.
! ------------------------------------------------------------------------------------
VitEngine.RecaseWord Procedure(STRING pText, STRING pStyleU)
l  long,auto
  code
  case pStyleU
  of 'UPPER'
    return upper(clip(pText))
  of 'TITLE' ! every spelling of it arrives as TITLE - CaseStyleWord
    l = len(clip(pText))
    if l < 1 then return clip(pText).
    if l = 1 then return upper(pText).
    return upper(sub(pText, 1, 1)) & lower(sub(pText, 2, l - 1))
  else
    return lower(clip(pText))
  end

! ------------------------------------------------------------------------------------
! 1 = pUpperName is a Clarion SCALAR data type - one that is genuinely reserved and can
! NEVER be a label (so recasing a non-col-1 occurrence is always safe). Cross-checked
! against the tokenizer's `dataTypes` list, minus:
!   * structure types (WINDOW/FILE/QUEUE/VIEW/KEY/GROUP) - dual-use as method/label names;
!   * INT64/UINT64/BOOL - NOT real Clarion types (StringTheory declares INT64/UINT64 as
!     GROUP labels; the parser comments flag this exact trap).
! ------------------------------------------------------------------------------------
VitEngine.IsScalarType Procedure(STRING pUpperName)
  code
  return choose(instring(' ' & clip(pUpperName) & ' ',                                            |
    ' LONG ULONG SHORT USHORT BYTE SIGNED UNSIGNED REAL SREAL BFLOAT4 BFLOAT8 DECIMAL PDECIMAL' & |
    ' STRING CSTRING PSTRING ASTRING DATE TIME ANY ', 1, 1) > 0)

! ------------------------------------------------------------------------------------
! 1 = pUpperName is a Clarion runtime builtin FUNCTION (Clarion.h free function).  These are
! dual-use with user procedures, so KeywordCase only recases them in CALL position and only
! when IsUserProc is 0.
!
! The list is Clarion's own runtime functions, the string family (CLIP/LEN/SUB and the rest)
! included - not a list borrowed from anywhere else, which is how a gap gets imported as a
! policy.
!
! WHY THE PARENTHESIS TEST IS ENOUGH, which is what decides how far this list can safely go.
! A DIM'd field subscripted as Size(3) is NOT caught by mistake, and cannot be:
! Clarion subscripts with BRACKETS - Size[3] - as the LRM says twice ("Brackets enclose an
! array subscript list", and "the entire list is enclosed in brackets").
! So a bare name followed by '(' in non-column-1, non-member position IS a call, and with
! IsUserProc excluding the program's own procedures the remaining risk is a name this list
! claims that Clarion does not actually define.  Every name below was checked against
! the Clarion Language Reference as a real entry before it went in.
! ------------------------------------------------------------------------------------
VitEngine.IsRuntimeBuiltin Procedure(STRING pUpperName)
  code
  return choose(instring(',' & clip(pUpperName) & ',',                             |
    ',ISALPHA,ISUPPER,ISLOWER,ISSTRING,QUOTE,UNQUOTE,PEEK,POKE,'    &              |
    'GETINI,PUTINI,GETREG,PUTREG,DELETEREG,COMMIT,ROLLBACK,LOGOUT,' &              |
    'HOLD,RELEASE,WATCH,REGET,RESET,STATUS,COPY,REMOVE,RENAME,'     &              |
    'AGE,CHOICE,COMMAND,SETCLOCK,SETNULL,FILEERROR,CHANGES,'        &              |
    'ROUND,INT,LOG10,EXISTS,FLUSH,ASSERT,MAXIMUM,'                  &              |
    'EOF,BOF,EMPTY,BYTES,PACK,LOCK,UNLOCK,SEND,SQL,'                &              |
    'GETSTATE,RESTORESTATE,FREESTATE,INSTANCE,SHARE,'               &              |
    'CLIP,LEN,SUB,UPPER,LOWER,LEFT,RIGHT,CENTER,ALL,'               &              | ! string
    'FORMAT,DEFORMAT,INSTRING,STRPOS,MATCH,NUMERIC,VAL,CHR,'        &              | !   and the rest of that family
    'ABS,RANDOM,SQRT,LOGE,BAND,BOR,BXOR,BSHIFT,INRANGE,'            &              | ! numeric
    'TODAY,CLOCK,DATE,TIME,DAY,MONTH,YEAR,'                         &              | ! date and time
    'RECORDS,POINTER,POSITION,ADDRESS,SIZE,OMITTED,EVALUATE,'       &              | ! these read like field names - see above
    'ERROR,ERRORCODE,ERRORFILE,FILEERRORCODE,INLIST,HOWMANY,WHO,WHAT,', 1, 1) > 0)

! ------------------------------------------------------------------------------------
! 1 = pUpperName is a Clarion declaration/prototype ATTRIBUTE that is safe to recase in
! attribute position (after a ',').  Union of the attributes a data declaration can carry and
! Clarion's procedure attributes, MINUS the dual-use words (TYPE/NAME/C/RAW/COM) that are legitimately
! used as field/label names in real code - those need tighter context and are left alone.
! ------------------------------------------------------------------------------------
VitEngine.IsClarionAttribute Procedure(STRING pUpperName)
  code
  return choose(instring(',' & clip(pUpperName) & ',',                 |
    ',AUTO,OVER,STATIC,THREAD,EXTERNAL,CONST,DIM,PRE,'               & |
    'VIRTUAL,DERIVED,PRIVATE,PROTECTED,BINDABLE,IMPLEMENTS,PARTIAL,' & |
    'PROC,LATE,PROTO,REPLACE,DLL,PASCAL,CDECL,STDCALL,WINAPI,'       & |
    'NETCLASS,ONCE,LINK,', 1, 1) > 0)

! ------------------------------------------------------------------------------------
! 1 = pNameU (upper) is the name of a user-declared PROCEDURE or METHOD in this file - so a
! builtin-named call that is actually the user's own proc is left alone (the user's own
! procedures take priority over the builtin list).  Method scope labels
! are `Class.Method` (one col-1 token) - compare the part after the dot.
! ------------------------------------------------------------------------------------
VitEngine.IsUserProc Procedure(STRING pNameU)
sc   long,auto
lbl  string(vs:maxName),auto
dp   long,auto
  code
  if self.syms &= NULL then return 0.
  loop sc = 1 to records(self.syms.scopes)
    get(self.syms.scopes, sc)
    if errorcode() then break.
    if self.syms.scopes.kind = vs:scProc or self.syms.scopes.kind = vs:scMethod
      lbl = upper(self.tk.GetTok(self.syms.scopes.startTok))
      dp  = instring('.', lbl, 1, 1)
      if dp then lbl = sub(lbl, dp + 1, len(clip(lbl)) - dp).
      if lbl = pNameU then return 1.
    end
  end
  return 0

! ====================================================================================
! BUILTIN SplitStatements (OPT-IN, cosmetic) - one statement per line.
!   BUILTIN SplitStatements
! Splits a line like `a = 1 ; b = 2 ; c = 3` at each top-level ';' so every statement
! lands on its own line at the SAME indent as the original line.  Conservative by design:
!   * bail on any line carrying a level mark (+/-//): IF/LOOP/CASE openers, ELSE/OF, END and
!     block-'.', inline `if..then..` one-liners, compressed `if x; y; end` blocks, and every
!     structure declaration (GROUP/QUEUE/CLASS ... END).  Those are left for ExpandOneLiners
!     / Reindent, which understand nesting.  A pure statement line has no level mark.
!   * only ';' at paren/bracket depth 0 (never inside a call or subscript).
!   * a trailing ';' (next token is EOL) is REMOVED, not split: splitting it would make a blank
!     line, but the statement it separates this one from is empty, so the ';' can simply go.
!     Only when its own trivia is plain spacing - see TrailRemovable. A doubled ';;' is skipped
!     at the first ';'; the split at the second leaves a trailing one, which the next pass
!     removes, so it converges to the right answer without a rule of its own.
!   * a '|' continuation on either side of the ';' is CONVERTED, not refused: once each statement
!     has its own line the continuation has nothing left to continue, so the bar becomes the '!'
!     it already behaves like and the author's words stay on their own physical line (SplitAt).
!   * refuse only trivia holding a newline that is NOT a continuation (absorbed OMIT text): its
!     words are not comment text, so they cannot be re-lined. TriviaClassify says why; the
!     refusal is REPORTED but not counted, and it is per-CANDIDATE.
!   * a line that begins with '?' in column 1 runs in debug builds only, and the mark covers every
!     statement on the line: a release build leaves out `? n += 1 ; n += 10` whole. So each
!     statement split off it starts its own line with the same '?' and the gap after it, and stays
!     a debug statement (DebugIndent). The mark belongs to one physical line, so a debug line
!     written across lines - or a '?' that is not in column 1, which is not the mark - is left as
!     it is, and REPORTED (DebugKept).
! What survives is exactly the safe case: sequences of plain statements (or plain scalar decls,
! whose labels stay in column 1).  The split keeps each new line at the original line's indent;
! if Reindent is also enabled it fixes nesting afterwards.  Lossless mechanics: the ';'
! token is retyped to a newline, CARRYING whatever the surrounding trivia said (a continuation's
! words, with the bar swapped for '!'; nothing at all in the ordinary case, where that trivia is
! just the space before the ';'), and the next statement's first token gets the line indent -
! byte-for-byte the same characters, just re-lined, and the same number of physical lines out as
! in.  wantReparse rebuilds firstOnLine / lineNo / levels from the re-lined text.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinSplitStatements Procedure(StringTheory pLog)
n         long,auto
i         long,auto
k         long,auto
lineStart long,auto
depth     long
hasMark   byte
dbgLine   byte
dbgBad    byte
lvl       string(1)
tv        string(4)
indentSt  StringTheory
changes   long
trivSt    StringTheory ! both sides' trivia around the ';', concatenated in source order
pTok      long         ! token the trivia routines read from (pTok and pTok+1)
sbBad     byte         ! trivia holds a newline that is NOT a '|' continuation - cannot be re-lined
hasWords  byte
CandQ  QUEUE
pos      long
act      byte          ! 0 = split here, 1 = refused (reported, untouched), 2 = trailing ';' to remove
       END
DelQ   QUEUE           ! trailing ';' positions, applied AFTER the scan (see the loop)
pos      long
       END
  code
  n = records(self.tk.tokens)
  if n < 1 then return 0.
  lineStart = 1
  depth     = 0
  hasMark   = 0
  dbgLine   = 0
  dbgBad    = 0
  free(CandQ)
  free(DelQ)
  loop i = 1 to n
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.IsEolTok(i) or i = n
      ! -------- end of the current physical line: flush [lineStart .. this] --------
      if i = n and ~self.IsEolTok(i)
        do ScanTok                   ! last token is real - fold it into the line first
      end
      if ~hasMark and records(CandQ)
        do CaptureIndent             ! read the line's leading indent once
        loop k = 1 to records(CandQ)
          get(CandQ, k)
          case CandQ.act
          of 1
            do KeepAt                ! report the refusal - a decision is worth a receipt
          of 2
            do RemoveAt              ! trailing ';' - queued, removed after the scan
          else
            do SplitAt
          end
        end
      end
      lineStart = i + 1              ! next line begins after this EOL
      depth     = 0
      hasMark   = 0
      dbgLine   = 0
      dbgBad    = 0
      free(CandQ)
    else
      do ScanTok
    end
  end
  ! Trailing ';' removals happen HERE, after the whole scan, and BACKWARDS. Deleting a token
  ! renumbers every token above it, which would invalidate i, n, lineStart and any candidate
  ! position not yet applied; taking the highest position first means the ones still to go
  ! cannot move. (The same reason VitRewrite applies its matches right-to-left.) Splits above
  ! only retype tokens, so they are unaffected either way.
  if records(DelQ)
    loop k = records(DelQ) to 1 by -1
      get(DelQ, k)
      self.tk.DeleteTok(DelQ.pos)
    end
  end
  if changes
    self.wantReparse = true          ! re-line the token stream: rebuild firstOnLine/levels
    pLog.append('BUILTIN SplitStatements: ' & changes & ' statement split(s) this pass<13,10>')
  end
  return changes

! ---- accumulate one non-EOL token into the current line's state (buffer is on token i) ----
ScanTok routine
  data
n2 string(vs:maxName)
  code
  lvl = self.tk.tokens.level
  case val(lvl)
  of 43 orof 47 orof 45           ! '+' orof '/' orof '-'
    hasMark = 1
  end
  if self.tk.tokens.tok &= NULL then exit.
  if i = lineStart and size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '?' then dbgLine = 1.
  if dbgLine and i > lineStart and not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(10, 1,, self.tk.tokens.strBefore) then dbgBad = 1.
  end
  tv = self.tk.tokens.tok
  case val(tv)
  of 40 orof 91                   ! '(' orof '['
    depth += 1
  of 41 orof 93                   ! ')' orof ']'
    if depth > 0 then depth -= 1.
  of 59                           ! <semi-colon>
    if ~depth
      ! candidate - but not a trailing ';' (next is EOL) nor a doubled ';;'
      get(self.tk.tokens, i + 1)
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.IsEolTok(i + 1)
          ! TRAILING ';' - it separates this statement from nothing at all. Splitting it would
          ! make a blank line, so it is removed instead, which is exact,
          ! because the empty statement it introduces does nothing. Only when the ';' carries
          ! plain spacing: a bar or a newline in front of it means a continuation is involved,
          ! and dropping the ';' would leave that bar continuing into nothing.
          pTok = i
          do TrailRemovable
          if ~sbBad
            CandQ.pos = i
            CandQ.act = 2
            add(CandQ)
          end
        else
          n2 = self.tk.tokens.tok ! read BEFORE TriviaClassify moves the buffer
          if n2 <> ';'
            pTok = i
            do TriviaClassify     ! plain continuation, or something we cannot re-line?
            CandQ.pos = i
            CandQ.act = sbBad     ! 0 = split, 1 = refused
            add(CandQ)
          end
        end
      end
      get(self.tk.tokens, i)      ! restore buffer to token i for the caller
    end
  end

! ---- indent = trailing run of spaces/tabs in the line-start token's strBefore (LineIndent) ----
CaptureIndent routine
  self.LineIndent(lineStart, indentSt)
  if dbgLine then do DebugIndent.

! ---- a debug line: the '?' in column 1, then the gap the line has after it, is the indent of every
!      statement split off it - at least one space, or `?n` would be read as one name. A '?' with an
!      indent in front of it is not the mark (dbgBad) ----
DebugIndent routine
  if indentSt._DataEnd then dbgBad = 1 ; exit.
  self.LineIndent(lineStart + 1, indentSt)
  if ~indentSt._DataEnd then indentSt.setValue(' ').
  indentSt.prepend('?')

! ---- is the trivia beside the ';' at pTok a plain '|' continuation, or something that cannot ----
!      be re-lined (SemiTriviaBad)? trivSt is its scratch.
TriviaClassify routine
  sbBad = self.SemiTriviaBad(pTok, trivSt)

! ---- turn the ';' at CandQ.pos into a line break and re-indent the following statement ----
!      (SemiToBreak). A '|' either side of the ';' becomes the comment marker it behaves like.
SplitAt routine
  if dbgBad then do DebugKept ; exit.
  hasWords = self.SemiToBreak(CandQ.pos, indentSt, trivSt)
  changes += 1
  if changes <= 500
    pLog.append('BUILTIN SplitStatements line ' & self.LogLineOf(lineStart) & ': split at ";"' & |
                choose(~hasWords, '', ' (continuation kept as a comment)') & '<13,10>')
  end

! ---- may the trailing ';' at pTok simply be dropped? Only if its own trivia is plain ----
!      spacing on the same physical line. A '|' or a newline in front of it means it sits on a
!      continuation line, and removing it would leave the bar continuing into nothing.
!      (dataless routine -> no CODE statement)
TrailRemovable routine
  sbBad = 0
  get(self.tk.tokens, pTok)
  if errorcode()
    sbBad = 1
  elsif not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(124, 1,, self.tk.tokens.strBefore) or |
       pLog.findByte(10, 1,, self.tk.tokens.strBefore)     ! <line feed>  ! '|'
      sbBad = 1
    end
  end

! ---- queue a trailing ';' for removal (the delete itself is after the scan, backwards) ----
!      DeleteTok disposes the token AND its strBefore, which is exactly right here: that
!      strBefore is the space in front of the ';', so `c = 5 ;` comes back as `c = 5` with no
!      trailing space to clean up afterwards. A comment on the line lives in the EOL token's
!      trivia and is untouched, so `c = 5 ; ! note` keeps its note.
RemoveAt routine
  DelQ.pos = CandQ.pos
  add(DelQ)
  changes += 1
  if changes <= 500
    pLog.append('BUILTIN SplitStatements line ' & self.LogLineOf(lineStart) & |
                ': trailing ";" removed (it separated the statement from nothing)<13,10>')
  end

! ---- a ';' on a debug line that is written across lines, or whose '?' is not in column 1: left
!      byte-identical, and said out loud, once ----
DebugKept routine
  if self.curPass > 1 then exit.
  pLog.append('BUILTIN SplitStatements line ' & self.LogLineOf(lineStart) & ': ";" KEPT - the line begins with ''?''')
  pLog.append(' and is written across lines, or its ''?'' is not in column 1, so a statement split off it')
  pLog.append(' could lose the debug mark<13,10>')

! ---- a candidate the trivia classifier refused: left byte-identical, and said out loud ----
KeepAt routine
  pLog.append('BUILTIN SplitStatements line ' & self.LogLineOf(lineStart)                   & |
              ': ";" KEPT - a newline in the trivia here is not a "|" continuation, so its' & |
              ' text cannot be re-lined as a comment<13,10>')

! ------------------------------------------------------------------------------------
! SplitStatements' line machinery, shared with LoopBlankRecords, ClipAtSplit and TrimAtSplit,
! which put a split's line in order the same way before they rewrite it.
!
! LineIndent: the trailing run of spaces (32) and tabs (9) in the strBefore of pLineStart, the
! line's first token - only the trailing run, which skips a full-line comment kept in strBefore.
! A line that starts with a column-1 label - the target of a GOTO, `Again  n += 1` - is indented
! to where its statement begins: as many spaces as the label is long, then the gap after it. A
! statement moved to a line of its own must not start in column 1, where it would be a label
! (ruled 30 Oct 2026).
! ------------------------------------------------------------------------------------
VitEngine.LineIndent Procedure(LONG pLineStart, StringTheory pOut)
sbLen long,auto
k     long,auto
ch    string(1),auto
  code
  pOut.free()
  if not self.syms &= NULL and self.syms.IsColOneLabel(pLineStart) and ~self.IsEolTok(pLineStart + 1)
    pOut.setValue(all(' ', len(clip(self.tk.GetTok(pLineStart)))))
    get(self.tk.tokens, pLineStart + 1)
    if errorcode() or self.tk.tokens.strBefore &= NULL then return.
    sbLen = size(self.tk.tokens.strBefore)
    k = sbLen
    loop while k >= 1
      ch = self.tk.tokens.strBefore[k]
      if ch <> ' ' and ch <> '<9>' then break.
      k -= 1
    end
    if k < sbLen then pOut.append(sub(self.tk.tokens.strBefore, k + 1, sbLen - k)).
    return
  end
  get(self.tk.tokens, pLineStart)
  if errorcode() then return.
  if self.tk.tokens.strBefore &= NULL then return.
  sbLen = size(self.tk.tokens.strBefore)
  k = sbLen
  loop while k >= 1
    ch = self.tk.tokens.strBefore[k]
    case val(ch)
    of 32 orof 9
      k -= 1
    else
      break
    end
  end
  if k < sbLen then pOut.setValue(sub(self.tk.tokens.strBefore, k + 1, sbLen - k)).

! ------------------------------------------------------------------------------------
! SemiTriviaBad: can the ';' at pSemi be re-lined? Continuations are NOT tokens: the '|',
! whatever the author wrote after it (a comment to the end of the line) and the line break all
! live in the strBefore of the token that FOLLOWS. So the ';' token's own strBefore and its
! successor's are read together, in source order, into pTriv (the caller's scratch). Every
! newline (10) in them must end a continuation segment - have a '|' (124) in front of it - which is the
! only shape the tokenizer makes of a continued line and exactly the shape SemiToBreak can
! convert. Anything else with a newline in it - absorbed OMIT text is the one thing that gets
! there - holds words that are NOT comment text, and moving them would change what the file
! says. A '!' comment cannot reach here on its own: it runs to the end of the line, so it lands
! in the line end's trivia, and that ';' is a trailing one. 1 = it cannot be re-lined.
! ------------------------------------------------------------------------------------
VitEngine.SemiTriviaBad Procedure(LONG pSemi, StringTheory pTriv)
tx      long,auto
sawBar  byte
  code
  pTriv.free()
  get(self.tk.tokens, pSemi)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL then pTriv.append(self.tk.tokens.strBefore).
  get(self.tk.tokens, pSemi + 1)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL then pTriv.append(self.tk.tokens.strBefore).
  loop tx = 1 to pTriv._DataEnd
    case val(pTriv.valuePtr[tx])
    of 124
      sawBar = 1
    of 10
      if ~sawBar then return 1.
      sawBar = 0
    end
  end
  return 0

! ------------------------------------------------------------------------------------
! SemiToBreak: the ';' at pSemi becomes a line break and the statement after it starts at
! pIndent. A '|' either side of the ';' is not a reason to refuse - it is a CONTINUATION, and
! once each statement has its own line there is nothing left for it to continue. It becomes the
! comment marker it already behaves like ('|' and '!' both run to the end of the line) and the
! author's words survive, on the very physical line they were written on: `p = 1 ; |  note`
! becomes `p = 1 !  note`, with `q = 2` still below it. Byte for byte the same characters, one
! glyph swapped, and the physical line count unchanged - only the LAST newline in the trivia
! goes, because the ';' token, now a line feed, supplies it; and no trailing space is left on
! the line just ended. A bare '|' carried no words, and leaves nothing, not a lone '!'.
!
! AN EMPTY INDENT WOULD PUT THE SPLIT STATEMENT IN COLUMN 1, WHERE IT IS A LABEL, NOT A STATEMENT.
!     A statement label is legal on any executable statement and must begin in column 1, so
!     `Lab  x = 1 ; y = 2` starts its line with the LABEL token, whose strBefore carries no
!     trailing whitespace at all - the indent read there is nothing, correctly, because there is
!     none. Writing `y = 2` at that indent makes `y` a second label and `= 2` something Clarion
!     cannot parse, so the file stops compiling. One space is the whole fix, applied here, the
!     one place the indent is used; a line that already has an indent never reaches it.
! pTriv is the caller's scratch. 1 = a continuation's words were kept as a comment.
! ------------------------------------------------------------------------------------
VitEngine.SemiToBreak Procedure(LONG pSemi, StringTheory pIndent, StringTheory pTriv)
tx        long,auto
lastNl    long
hasWords  byte
  code
  pTriv.free()
  get(self.tk.tokens, pSemi)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL then pTriv.append(self.tk.tokens.strBefore).
  get(self.tk.tokens, pSemi + 1)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL then pTriv.append(self.tk.tokens.strBefore).
  pTriv.replaceByte(124, 33)
  loop tx = 1 to pTriv._DataEnd
    if pTriv.valuePtr[tx] = '<10>' then lastNl = tx.
  end
  if lastNl
    pTriv.setLength(lastNl - 1)
    if pTriv._DataEnd and pTriv.valuePtr[pTriv._DataEnd] = '<13>' then pTriv.setLength(pTriv._DataEnd - 1).
  end
  pTriv.clip('<32,9>')
  loop tx = 1 to pTriv._DataEnd
    case val(pTriv.valuePtr[tx])
    of 32 orof 9 orof 33 orof 13 orof 10
    else
      hasWords = 1
      break
    end
  end
  if ~hasWords then pTriv.free().
  self.tk.SetTok(pSemi, '<10>', pTriv.getValue())
  if ~pIndent._DataEnd then pIndent.setValue(' ').
  self.tk.SetStrBefore(pSemi + 1, pIndent.getValue())
  return hasWords

! =============================================================================================
! BUILTIN ChooseClip - a dead clip() at the END of any ARM of a choose(), for ANY number of arms.
!
!     btns = choose(qx = 1, clip(fq:nm), clip(btns) & '|' & clip(fq:nm))
!                           ^^^^ dead                              ^^^^ dead
!
! WHY THIS IS A BUILTIN AND NOT RULES. A rule has to name each argument position, and
! choose() takes any number of them. The obvious way round it, an ARGS metavar to swallow the
! arguments either side of the one being cleaned, is refused outright:
!
!     ERROR  ARGS metavar a must be the entire (...) content
!
! ARGS binds the whole parenthesised content or nothing. So no arrangement of rules can name one
! argument in the middle of a list of unknown length, and this is exactly the case builtins exist
! for.
!
! THE SAFETY ARGUMENT, per ARGUMENT:
!
!   * ARGUMENT 1 IS NEVER TOUCHED, because it is the CONDITION rather than a value. It is not
!     what gets assigned, so the padding argument below says nothing about it either way.
!     That is NOT the same as saying a clip in a condition is doing work - usually it is not,
!     because a Clarion string compare ignores trailing spaces, and the rule
!     `upper(clip(w)) = w1 ==> upper(w) = w1` removes exactly that. What is dead inside a
!     condition is the comparison rules' business; this pass simply has nothing to say about it.
!   * WHICHEVER ARM IS CHOSEN BECOMES THE ASSIGNED VALUE, so a clip at the END of an arm puts its
!     trailing spaces exactly where the fixed-STRING target pads or truncates them anyway.
!   * A CLIP THAT IS NOT LAST IN ITS ARM STAYS. `clip(btns)` above has text after it and decides
!     where btns' own spaces sit relative to the '|'. Enforced by requiring the clip's own closing
!     bracket to BE the last token of the arm - which also refuses a clip nested inside another
!     call, `foo(clip(x))`, where removing it would change what foo receives.
!   * STRING, NOT CSTRING. A CSTRING keeps its trailing spaces and there the clip is real work.
!     The target's own type is the gate, the test a typed metavar makes.
!   * THE RUNTIME'S CLIP ONLY. In `StrUtil.Clip(y)` the name after the '.' is a method of
!     StrUtil, which does whatever that class says, so it stays.
! =============================================================================================
VitEngine.BuiltinChooseClip Procedure(StringTheory pLog)
startTok   long,auto
endBracket long,auto
argS       long,auto               ! first token of the arm being examined
argN       long                    ! which arm - 1 is the condition and is skipped
dep        long,auto
p          long,auto
cp         long,auto
ccName     string(vs:maxName),auto ! the assignment target, for the symbol lookup
ccType     string(vs:maxName)      ! ... and what it resolves to
ccRef      byte                    ! a reference is not ours to judge
ccArgN     string(vs:maxName)      ! a clip's argument
ccArgT     string(vs:maxName)      ! ... and what it resolves to
ccArgR     byte
ccWrap     byte                    ! a line break inside a clip( ... ) was kept, on another token
sbSt       StringTheory            ! the clip token's own leading trivia, moved to what it wrapped
tkSt       StringTheory
changes    long
z          long,auto
CcQ   QUEUE,PRE(cc)
qClip   LONG                       ! the `clip` token
qClose  LONG                       ! its matching ')'
qLn     LONG
      END
  code
  free(CcQ)
  if self.tk &= NULL then return 0.
  startTok = 0
  loop
    startTok = self.tk.FindSeq(',^  ^choose, (', startTok + 1)
    if ~startTok then break.
    if startTok < 3 then cycle.
    if self.tk.GetTok(startTok - 1) <> '=' then cycle.                    ! must be an ASSIGNMENT of a choose()
    if startTok > 3
      case upper(self.tk.GetTok(startTok - 3))                            ! ... where a statement starts: `if s = choose(` compares
      of '<10>' orof ';' orof 'THEN' orof 'ELSE'
      else
        cycle
      end
    end
    get(self.tk.tokens, startTok - 2)                                     ! ... to a plain STRING target
    if errorcode() then cycle.
    if self.tk.tokens.type <> vt:label then cycle.
    ! THE TYPE COMES FROM THE SYMBOL TABLE, NOT FROM THE TOKEN. The token queue carries a
    ! varType field and it is BLANK here for a local declared STRING(200); believing it would
    ! refuse every candidate in silence. The symbol table is where the answer lives, and
    ! Lookup is the route VitMatch takes for a typed metavar.
    ccName = upper(self.tk.GetTok(startTok - 2))
    if ~self.syms.Lookup(ccName, startTok - 2, ccType, ccRef) then cycle.
    if ccType <> 'STRING' then cycle.                                     ! CSTRING/PSTRING keep their spaces,
    if ccRef then cycle.                                                  !   and a reference is not ours to judge
    endBracket = self.tk.MatchLeftBracket('(', ')', startTok + 1)
    if ~endBracket then cycle.
    case upper(self.tk.GetTok(endBracket + 1))                            ! the choose() must be the WHOLE value stored: in
    of '<10>' orof ';' orof '.' orof 'ELSE'                               !   `choose(c, clip(a), clip(b)) & x` an arm's spaces
    else                                                                  !   would land in front of the x
      cycle
    end
    ! ---- walk the arms. A comma at depth 0 inside this bracket separates them. ----
    argN = 1
    argS = startTok + 2
    dep  = 0
    loop p = startTok + 2 to endBracket
      tkSt.setValue(self.tk.GetTok(p))
      if tkSt._DataEnd = 1
        case val(tkSt.valuePtr[1])
        of 40 orof 91                                                     ! '(' orof '['                                                   ! a subscript nests like a call: the comma in arr[i, j]
          dep += 1                                                        !   is not an arm separator
        of 93                                                             ! ']'
          dep -= 1
        of 41                                                             ! ')'
          if p = endBracket or ~dep
            do CcArm                                                      ! the last arm ends at the bracket
            break
          end
          dep -= 1
        of 44                                                             ! <comma>
          if ~dep
            do CcArm
            argN += 1
            argS  = p + 1
          end
        end
      end
    end
  end

  ! HIGHEST FIRST - an edit below a staged index would move it.
  loop z = records(CcQ) to 1 by -1
    get(CcQ, z)
    if errorcode() then cycle.
    self.tk.GetTok(cc:qClip, sbSt, tkSt)                                  ! the clip's own leading spacing
    do CcWrapKept                                                         ! a line break inside clip( ... ) stays, with its comment
    self.tk.DeleteToks(cc:qClose, cc:qClose)                              ! the ')' first - highest index
    self.tk.SetStrBefore(cc:qClip + 2, sbSt.getValue())                   ! what clip wrapped inherits its place
    self.tk.DeleteToks(cc:qClip, cc:qClip + 1)                            ! then `clip` and its '('
    changes += 1
    pLog.append('BUILTIN ChooseClip: line ' & cc:qLn &                    |
                ' dead clip() dropped from a choose() arm<13,10>')
  end
  if ccWrap then self.tk.SetLineNumbers().
  if changes
    pLog.append('BUILTIN ChooseClip: ' & changes & ' clip(s) dropped this pass<13,10>')
  end
  return changes

! ---- the arm that ENDS at p-1 (or at endBracket-1 for the last one) --------------------------
CcArm routine
  if argN < 2 then exit.                                               ! argument 1 is the CONDITION
  if p - 1 < argS then exit.                                           ! an empty arm
  loop cp = argS to p - 1
    tkSt.setValue(self.tk.GetTok(cp))
    if tkSt._DataEnd <> 4 then cycle.
    if upper(tkSt.getValue()) <> 'CLIP' then cycle.
    if self.tk.GetTok(cp + 1) <> '(' then cycle.
    if self.tk.GetTok(cp - 1) = '.' then cycle.                        ! obj.Clip(y) is the object's own METHOD
    if self.tk.MatchLeftBracket('(', ')', cp + 1) <> p - 1 then cycle. ! must END the arm
    if cp + 2 <> p - 2 then exit.                                      ! what it clips must already be a STRING - one
    tkSt.setValue(self.tk.GetTok(cp + 2))                              !   string variable or a literal. clip(n) of a
    if ~tkSt._DataEnd then exit.                                       !   number is what makes its arm a STRING: without
    if tkSt.valuePtr[1] <> ''''                                        !   it choose() returns a DECIMAL, and an arm
      ccArgN = upper(tkSt.getValue())                                  !   such as '-' comes back as 0
      if ~self.syms.Lookup(ccArgN, cp + 2, ccArgT, ccArgR) then exit.
      case ccArgT
      of 'STRING' orof 'CSTRING' orof 'PSTRING'
      else
        exit
      end
    end
    clear(CcQ)
    cc:qClip  = cp
    cc:qClose = p - 1
    cc:qLn    = self.LogLineOf(cp)
    add(CcQ)
    exit                                                               ! one tail clip per arm
  end

! ---- a LINE BREAK inside clip( ... ) stays where it is, with the comment riding it. In the
!      middle of a statement only a '|' puts a line break into a token's trivia, and the words
!      after the bar are the author's. So the trivia of the '(' and of what clip wrapped is kept
!      after clip's own, in front of that token, and the trivia of the ')' moves to the token
!      after it - each only when it holds a line break; plain spacing inside the brackets goes.
!      A moved line break changes which token starts a line, so the lines are restamped once
!      the edits are made (ccWrap). ----
CcWrapKept routine
  data
cw  long,auto
  code
  loop cw = cc:qClip + 1 to cc:qClip + 2
    get(self.tk.tokens, cw)
    if errorcode() or self.tk.tokens.strBefore &= NULL then cycle.
    if ~tkSt.findByte(10, 1,, self.tk.tokens.strBefore) then cycle.
    sbSt.append(self.tk.tokens.strBefore)
    ccWrap = 1
  end
  get(self.tk.tokens, cc:qClose)
  if errorcode() or self.tk.tokens.strBefore &= NULL then exit.
  if ~tkSt.findByte(10, 1,, self.tk.tokens.strBefore) then exit.
  tkSt.setValue(self.tk.tokens.strBefore)
  get(self.tk.tokens, cc:qClose + 1)
  if errorcode() then exit.
  if not self.tk.tokens.strBefore &= NULL then tkSt.append(self.tk.tokens.strBefore).
  self.tk.SetStrBefore(cc:qClose + 1, tkSt.getValue())
  ccWrap = 1

!===============================================================================================
! InstringToST: the free function instring(needle, haystack, 1[, start])
! becomes a FindChars on a StringTheory that is ALREADY in scope, searching the haystack as
! text - ST 3.84's fourth overload, FindChars(pSearchValue, pStart, pEnd, *String p_Text):
!
!     p = instring('abc', hay, 1)         ->   p = st.findChars('abc',,, hay)
!     p = instring('abc', hay, 1, 5)      ->   p = st.findChars('abc', 5,, hay)
!
! The object's own contents are never touched; it is only the method that is borrowed. WHAT IS
! REFUSED, and said in the report: no StringTheory instance visible from the call - a
! reference (&StringTheory) is never used, it could be NULL; an instance whose name means
! something else where the call is (a local, a parameter or a routine's data of that name);
! a step other than the literal 1 (instring's step is a stride, FindChars has none); a
! haystack that is not one STRING - a STRING or &STRING variable, or a field named by a dotted
! chain such as self.tk.tokens.strBefore;
! p_Text is passed BY REFERENCE, so an expression, a slice, a literal or a CSTRING would not
! compile; and a call with fewer than three or more than four arguments. A start of 1 is left
! out, as it is findChars' default.
!
! InstringLitToST (pLit = 1, group st-instring-literal, OFF in every style) takes the calls whose
! text to search is ONE STRING LITERAL, and nothing else, which the String p_Text overload takes
! by value - 3.84 has it, so an older --stversion= refuses it:
!
!     if instring(c, '<<>~=', 1, 1)       ->   if st.findChars(c,,, '<<>~=')
!
! InstringOneCharToST (pLit = 2, group st-instring-onechar, ON in optimised and extreme) takes only a
! call whose needle is provably ONE character - a one-character literal, a STRING(1), or x[i] on a
! string without DIM - over a STRING variable, and writes the same findChars. The rules then make it
! findChar and, in optimised, findByte, which is the point of it:
!
!     p = instring('.', nm, 1, 1)         ->   p = st.findByte(46,,, nm) ! <dot>
!     p = instring(c, nm, 1, 1)           ->   p = st.findByte(val(c),,, nm)
!
! Measured 19 Oct 2026: a one-character findByte on a STRING variable is several times faster than
! instring when the match comes early or the text is short, and no slower on a long search with no
! match. A call it does not take - a needle that may be longer, a literal to search, no StringTheory
! in scope - it does not report; InstringToST reports those when its group is on.
!
! st-instring AND st-instring-literal ARE OFF IN EVERY STYLE (ruled 19 Oct 2026): for any longer
! needle findChars is not reliably the faster. It
! costs a little more per call, and wins only on a search of two or more characters that runs past
! about a hundred bytes before it stops; a one-character search, a search that finds its match
! early, and a literal to search are all faster as instring, and the code does not say which kind
! a call is. Each call is judged and reported by one of the two. instring is case-sensitive and
! FindChars defaults to the same, both return 0 when the needle is not found, and both start at 1
! when no start is given. A method call - st.instring(...), or Util.Instring(...) on a class of
! the program's own - is a different thing and is never touched: an instring after a '.' is
! refused, here and in InstringSliceToST.
!===============================================================================================
! ------------------------------------------------------------------------------------
! The type an instring() haystack token resolves to: a plain name through the symbol table, a
! dotted one - self.tk.tokens.strBefore, Q.tok - through its head and the chain of fields after
! it, as the matcher resolves a receiver. A &STRING resolves to STRING, and findChars takes it
! as it takes a STRING: measured, every answer the same as instring's, and a NULL one gives 0
! from both. '' = unresolved.
! ------------------------------------------------------------------------------------
VitEngine.HayType Procedure(STRING pTok, LONG pIx)
hd    STRING(vs:maxName),AUTO
tU    STRING(vs:maxName)
rf    BYTE
dotP  long,auto
tLen  long,auto
segs  StringTheory
  code
  tLen = len(clip(pTok))
  if ~tLen then return ''.
  dotP = instring('.', pTok[1 : tLen], 1, 1)
  if ~dotP
    if ~self.syms.Lookup(pTok, pIx, tU, rf) then return ''.
    return upper(tU)
  end
  if dotP < 2 or dotP >= tLen then return ''.
  hd = upper(pTok[1 : dotP - 1])
  if ~self.syms.Lookup(hd, pIx, tU, rf)
    if ~self.syms.FindTypeDef(hd) then return ''.
    tU = hd
  end
  segs.setValue(pTok[dotP + 1 : tLen])
  segs.replaceByte(46, 124)
  return upper(self.syms.LookupChain(tU, segs.getValue(), pIx))

! ====================================================================================
! BracketAndOr (group and-or-brackets, OFF in every style, FINAL): where one level of a condition
! mixes AND with OR or XOR, each run of operands joined by AND is bracketed, so a reader does not
! have to know that AND binds tighter:
!
!     if a = 1 or b = 2 and c = 3            ->   if a = 1 or (b = 2 and c = 3)
!     if x and y or z and w then ...         ->   if (x and y) or (z and w) then ...
!
! The brackets only show the order Clarion already uses - AND before OR and XOR, measured on
! Clarion 11 on 19 Oct 2026, where the language reference says it both ways - so the code does
! exactly what it did. A level is the condition after IF, ELSIF, WHILE or UNTIL, or what one pair
! of brackets holds; it ends at its closing bracket, a comma at its own depth, THEN, a ';' or the
! end of the statement (a continued line is one statement). NOT and ~ bind tighter than AND, so a
! NOT stays inside the run it starts. FINAL, so it also sees the conditions MergeGuardChain writes.
! Braces count as brackets: the comma in ?List{PROPLIST:Width, 1} is the property's, not the level's.
! ====================================================================================
VitEngine.BuiltinBracketAndOr Procedure(StringTheory pLog)
i        long,auto
k        long,auto
s        long,auto
dep      long,auto
tU       string(vs:maxName),auto
hasAnd   byte,auto
hasOr    byte,auto
segS     long,auto
segAnd   byte,auto
changes  long
sb       StringTheory
tkSt     StringTheory
InsQ     QUEUE,PRE(iq)
pos        LONG                      ! insert BEFORE this token
open       BYTE                      ! 1 = '(', 0 = ')'
ln         LONG
         END
  code
  free(InsQ)
  if self.tk &= NULL then return 0.
  loop i = 1 to records(self.tk.tokens)
    tU = upper(self.tk.GetTok(i))
    case tU
    of 'IF' orof 'ELSIF' orof 'WHILE' orof 'UNTIL' ! a condition starts after the keyword,
      do Level
    of '('  orof ','                               ! a bracketed level after its '(', and each
      do Level                                     !   argument after the first after its comma
    end
  end
  if ~records(InsQ) then return 0.
  ! ---- HIGHEST FIRST: an insert moves only the tokens after it ----
  sort(InsQ, -iq:pos, -iq:open)                    ! at one position the '(' goes in first, so ')' ends up in front of it
  loop k = 1 to records(InsQ)
    get(InsQ, k)
    if iq:open
      self.tk.GetTok(iq:pos, sb, tkSt)             ! the bracket takes the token's spacing,
      self.tk.InsertString(iq:pos, '(', 1)         !   so a continued line stays continued
      self.tk.SetStrBefore(iq:pos, sb.getValue())
      self.tk.SetStrBefore(iq:pos + 1, '')
      changes += 1
      pLog.append('BUILTIN BracketAndOr: line ' & iq:ln & ' brackets an AND beside an OR<13,10>')
    else
      self.tk.InsertString(iq:pos, ')', 1)
      self.tk.SetStrBefore(iq:pos, '')
    end
  end
  free(InsQ)
  self.tk.SetLineNumbers()
  self.wantReparse = true
  pLog.append('BUILTIN BracketAndOr: ' & changes & ' pair(s) of brackets this pass<13,10>')
  return changes

! ---- one level from token i+1: find its end, and if AND sits beside OR or XOR at its own depth,
!      bracket every OR-separated piece that holds an AND ----
Level routine
  s = i + 1
  hasAnd = 0 ; hasOr = 0 ; dep = 0
  loop k = s to records(self.tk.tokens)
    if self.IsEolTok(k) then break.
    tU = upper(self.tk.GetTok(k))
    case tU
    of '(' orof '[' orof '{{'
      dep += 1
    of ')' orof ']' orof '}'
      if ~dep then break.
      dep -= 1
    of ','   orof ';'   orof 'THEN'
      if ~dep then break.
    of 'AND'
      if ~dep then hasAnd = 1.
    of 'OR'  orof 'XOR'
      if ~dep then hasOr = 1.
    end
  end
  if ~hasAnd or ~hasOr then exit.
  segS = s ; segAnd = 0 ; dep = 0
  loop k = s to records(self.tk.tokens)
    if self.IsEolTok(k) then do Piece ; break.
    tU = upper(self.tk.GetTok(k))
    case tU
    of '(' orof '[' orof '{{'
      dep += 1
    of ')' orof ']' orof '}'
      if ~dep then do Piece ; break.
      dep -= 1
    of ','   orof ';'   orof 'THEN'
      if ~dep then do Piece ; break.
    of 'AND'
      if ~dep then segAnd = 1.
    of 'OR'  orof 'XOR'
      if ~dep
        do Piece
        segS = k + 1 ; segAnd = 0
      end
    end
  end

! the piece segS .. k-1 holds an AND: bracket it
Piece routine
  if ~segAnd or k - 1 <= segS then exit.
  clear(InsQ) ; iq:pos = segS ; iq:open = 1 ; iq:ln = self.LogLineOf(segS) ; add(InsQ)
  clear(InsQ) ; iq:pos = k ; iq:open = 0 ; add(InsQ)

! ====================================================================================
! InstringSliceToST: instring() over a StringTheory's OWN buffer read as a slice becomes that
! object's own search, the slice's ends becoming the search's start and end:
!
!     dotP = instring('.', txt.valuePtr[1 : txt._DataEnd], 1, 1)   ->   dotP = txt.findChars('.')
!     p = instring('_c', st.valuePtr[1 : n], 1, k)                 ->   p = st.findChars('_c', k, n)
!     if instring('.', st.valuePtr[k : n], 1, 1) then x = 1.       ->   if st.findChars('.', k, n) then x = 1.
!
! The rules then make a one-character findChars findChar, and in optimised findByte. A rule cannot
! say this: the object is named only inside st.valuePtr and st._DataEnd, and a dotted occurrence
! checks a metavar, it never binds one. A slice must lie inside the buffer for the original to be
! valid Clarion - outside it is a range error. Past the value's end but inside the buffer,
! instring() also reads the bytes an earlier, longer value left there, which are not part of the
! value; findChars() stops at the value's end, which is what such code means (ruled 10 Nov 2026).
! Inside the value the two search the same bytes. FROM BYTE 1 the position comes back the same, so the call converts
! wherever it stands. FROM ANY OTHER BYTE instring() counts the position from the slice and
! findChars() from the value, so it converts only as a found-or-not test - the whole condition
! after IF, ELSIF, LOOP WHILE, LOOP UNTIL, AND, OR, XOR, NOT or ~, or compared with 0 - and with
! no start of its own (a LOOP asks again on every pass, and each time it asks the same thing). The
! step must be the literal 1; the 2-argument form, whose step is the needle's length, only for a
! one-character needle. ALWAYS ON, beside the getValue() rules of the same family. A slice of a
! StringTheory it leaves alone is reported once, on the first pass; any other instring() is not
! its business and is not mentioned.
! ====================================================================================
VitEngine.BuiltinInstringSliceToST Procedure(StringTheory pLog)
p        long,auto               ! the `instring` token
endB     long,auto               ! its closing bracket
argS     long,auto               ! first token of the argument being collected
argN     long                    ! which argument
dep      long,auto
q        long,auto
a1S      long                    ! the needle
a1E      long
a2S      long                    ! the haystack: X.valuePtr [ lo : hi ]
a2E      long
a3S      long                    ! the step
a3E      long
a4S      long                    ! the start position
a4E      long
bad      byte
colon    long,auto               ! the slice's ':' at its own depth
why      STRING(100)             ! the reason a call is left alone, for the report
ln       long,auto
fromOne  byte,auto               ! the slice starts at byte 1
noEnd    byte,auto               ! and ends at X._DataEnd
hasStart byte,auto               ! a start other than 1
prevU    string(vs:maxName),auto
nextU    string(vs:maxName),auto
afterU   string(vs:maxName),auto
needle   StringTheory
recv     StringTheory            ! X, the object
lo       StringTheory
hi       StringTheory
start    StringTheory
newTxt   StringTheory
sbSt     StringTheory
tkSt     StringTheory
changes  long
refused  long
cmtN     long
cmtOk    byte
cmtRows  StringTheory
cmtTxt   StringTheory
lastEnd  long                    ! the closing bracket of the last call staged
SlQ      QUEUE,PRE(sl)
p          LONG                  ! the instring token
endB       LONG                  ! its closing bracket
ln         LONG
a1S        LONG                  ! the needle
a1E        LONG
a2S        LONG                  ! the X.valuePtr token
loS        LONG                  ! the slice's first byte
loE        LONG
hiS        LONG                  ! and its last
hiE        LONG
a4S        LONG                  ! the start, 0 = none
a4E        LONG
fromOne    BYTE
noEnd      BYTE
         END
  code
  free(SlQ)
  if self.tk &= NULL or self.syms &= NULL then return 0.
  p = 0
  loop
    p = self.tk.FindSeq(',^  ^instring, (', p + 1)
    if ~p then break.
    if lower(self.tk.GetTok(p)) <> 'instring' then cycle.          ! the whole token, not a dotted name ending in it
    if self.tk.GetTok(p - 1) = '.' then cycle.                     ! obj.Instring(...) is the object's own METHOD
    endB = self.tk.MatchLeftBracket('(', ')', p + 1)
    if ~endB then cycle.
    ! ---- split the arguments at bracket depth 0 ----
    argN = 1 ; argS = p + 2 ; dep = 0 ; bad = 0
    a1S = 0 ; a1E = 0 ; a2S = 0 ; a2E = 0 ; a3S = 0 ; a3E = 0 ; a4S = 0 ; a4E = 0
    loop q = p + 2 to endB
      tkSt.setValue(self.tk.GetTok(q))
      if tkSt._DataEnd = 1
        case val(tkSt.valuePtr[1])
        of 40 orof 91                                              ! '(' orof '['
          dep += 1
        of 41 orof 93                                              ! ')' orof ']'
          if q = endB
            do Arg
            break
          end
          dep -= 1
        of 44                                                      ! <comma>
          if ~dep
            do Arg
            argN += 1
            argS = q + 1
          end
        end
      end
    end
    if bad or argN < 2 or argN > 4 or ~a1S or ~a2S then cycle.
    ! ---- the text searched: X.valuePtr[lo : hi] on a StringTheory, and nothing else ----
    recv.setValue(self.tk.GetTok(a2S))
    if recv._DataEnd < 10 then cycle.                                   ! x.valuePtr at the least
    if upper(recv.valuePtr[recv._DataEnd - 8 : recv._DataEnd]) <> '.VALUEPTR' then cycle.
    if a2E <= a2S + 1 or self.tk.GetTok(a2S + 1) <> '[' then cycle.
    if self.tk.MatchLeftBracket('[', ']', a2S + 1) <> a2E then cycle.   ! the slice is the whole argument
    recv.setValue(recv.valuePtr[1 : recv._DataEnd - 9])
    if self.HayType(recv.getValue(), a2S) <> 'STRINGTHEORY' then cycle. ! another class's valuePtr is not this
    ln = self.LogLineOf(p)
    colon = 0 ; dep = 0
    loop q = a2S + 2 to a2E - 1
      tkSt.setValue(self.tk.GetTok(q))
      if tkSt._DataEnd <> 1
        if tkSt.containsByte(58) then colon = -1 ; break.               ! a range spelled as one token, 1:n  ! <colon>
        cycle
      end
      case val(tkSt.valuePtr[1])
      of 40 orof 91                                                     ! '(' orof '['
        dep += 1
      of 41 orof 93                                                     ! ')' orof ']'
        dep -= 1
      of 58                                                             ! <colon>
        if ~dep
          colon = q
          break
        end
      end
    end
    if colon < 1 or colon = a2S + 2 or colon = a2E - 1
      why = 'the slice is not one first and one last byte'
      do Refuse
      cycle
    end
    fromOne = choose(colon = a2S + 3 and self.tk.GetTok(a2S + 2) = '1')
    noEnd = choose(colon = a2E - 2 and upper(self.tk.GetTok(a2E - 1)) = upper(recv.getValue() & '._DataEnd'))
    ! ---- the step, and the 2-argument form ----
    if argN = 2
      if ~self.InstrOneChar(a1S, a1E)
        why = 'a 2-argument instring() of a longer needle steps by its length'
        do Refuse
        cycle
      end
    elsif a3S <> a3E or self.tk.GetTok(a3S) <> '1'
      why = 'the step is not the literal 1'
      do Refuse
      cycle
    end
    hasStart = 0
    if argN = 4
      if ~a4S
        why = 'the start position is empty'
        do Refuse
        cycle
      end
      hasStart = choose(a4S <> a4E or self.tk.GetTok(a4S) <> '1')
    end
    ! ---- from another first byte: a found-or-not test only ----
    if ~fromOne
      why = ''
      if hasStart
        why = 'the slice starts after byte 1 and has a start of its own'
        do Refuse
        cycle
      end
      prevU = upper(self.tk.GetTok(p - 1))
      nextU = upper(self.tk.GetTok(endB + 1))
      case nextU                                                   ! compared with 0: only found or not matters
      of '>' orof '<<>' orof '~=' orof '=' orof '<<='
        if self.tk.GetTok(endB + 2) <> '0' then do NotFoundTest.
        do CmpAlone
      of '>=' orof '<<'
        if self.tk.GetTok(endB + 2) <> '1' then do NotFoundTest.
        do CmpAlone
      of 'THEN' orof 'AND' orof 'OR' orof 'XOR' orof ';'           ! the whole condition: what IF, ELSIF, WHILE, UNTIL,
        do BareTest                                                !   AND, OR, XOR, NOT or ~ in front of it test is found or not
      else
        if self.IsEolTok(endB + 1)
          do BareTest
        else
          do NotFoundTest
        end
      end
      if why then cycle.
    end
    if p >= lastEnd
      do CmtScan
      if cmtN then do CmtEnd.
      if cmtN and ~cmtOk
        why = 'a comment in it has no line end to move to'
        do Refuse
        cycle
      end
    end
    if p < lastEnd then cycle.                                     ! INSIDE A CALL STAGED ALREADY: the edits run highest first, so its
    lastEnd = endB                                                 !   own would move the tokens the outer one cuts - it waits a pass
    clear(SlQ)                                                     ! staged: every call is decided before any is rewritten, so the
    sl:p = p ; sl:endB = endB ; sl:ln = ln ; sl:a2S = a2S          !   positions the symbol table reads stay the ones it was built on
    sl:a1S = a1S ; sl:a1E = a1E
    sl:loS = a2S + 2 ; sl:loE = colon - 1 ; sl:hiS = colon + 1 ; sl:hiE = a2E - 1
    if hasStart then sl:a4S = a4S ; sl:a4E = a4E.
    sl:fromOne = fromOne ; sl:noEnd = noEnd
    add(SlQ)
  end
  ! ---- HIGHEST FIRST: an edit moves only the tokens after it ----
  loop q = records(SlQ) to 1 by -1
    get(SlQ, q)
    if errorcode() then cycle.
    recv.setValue(self.tk.GetTok(sl:a2S))
    recv.setValue(recv.valuePtr[1 : recv._DataEnd - 9])
    self.IsuSpanText(sl:a1S, sl:a1E, needle)
    self.IsuSpanText(sl:loS, sl:loE, lo)
    self.IsuSpanText(sl:hiS, sl:hiE, hi)
    start.free()
    if sl:a4S then self.IsuSpanText(sl:a4S, sl:a4E, start).
    newTxt.setValue(recv.getValue() & '.findChars(' & needle.getValue())
    if sl:fromOne
      if start._DataEnd
        newTxt.append(', ' & start.getValue())
      elsif ~sl:noEnd
        newTxt.append(',')
      end
      if ~sl:noEnd then newTxt.append(', ' & hi.getValue()).
    else
      newTxt.append(', ' & lo.getValue())
      if ~sl:noEnd then newTxt.append(', ' & hi.getValue()).
    end
    newTxt.append(')')
    self.tk.GetTok(sl:p, sbSt, tkSt)                                    ! the call's own leading trivia survives
    p = sl:p ; endB = sl:endB ; a1S = sl:a1S ; a1E = sl:a1E
    a2S = sl:a2S ; colon = sl:hiS - 1 ; a2E = sl:hiE + 1
    fromOne = sl:fromOne ; noEnd = sl:noEnd
    a4S = sl:a4S ; a4E = sl:a4E
    do CmtScan
    self.tk.DeleteToks(sl:p, sl:endB)
    self.tk.InsertString(sl:p, newTxt)
    self.tk.SetStrBefore(sl:p, sbSt.getValue())
    cmtTxt.free()
    self.CmtRowsJoin(cmtRows, cmtTxt)
    if cmtN then self.CmtToLineEnd(self.FirstEolAfter(sl:p), cmtTxt).
    changes += 1
    pLog.append('BUILTIN InstringSliceToST: line ' & sl:ln & ' instring(...) -> ' & newTxt.getValue() & '<13,10>')
  end
  free(SlQ)
  if changes then self.tk.SetLineNumbers().
  if changes or (refused and self.curPass = 1)
    pLog.append('BUILTIN InstringSliceToST: ' & changes & ' instring call(s) rewritten this pass, ' & refused & ' left alone<13,10>')
  end
  return changes

Arg routine
  if q - 1 < argS ! an empty argument
    bad = 1
    exit
  end
  case argN
  of 1
    a1S = argS ; a1E = q - 1
  of 2
    a2S = argS ; a2E = q - 1
  of 3
    a3S = argS ; a3E = q - 1
  of 4
    a4S = argS ; a4E = q - 1
  else
    bad = 1
  end

! the call is the whole condition: IF, ELSIF, a LOOP's WHILE or UNTIL, AND, OR, XOR, NOT or ~ just in front of it
BareTest routine
  case prevU
  of 'IF' orof 'ELSIF' orof 'WHILE' orof 'UNTIL' orof 'AND' orof 'OR' orof 'XOR' orof 'NOT' orof '~'
  else
    do NotFoundTest
  end

! compared with 0, the comparison has to stand on its own: nothing in front of the call or after the
! number may bind into it - x = instring(...) > 0 compares x first, and ... > 0 + 1 adds to the 0
CmpAlone routine
  if why then exit.
  case prevU
  of 'IF' orof 'ELSIF' orof 'WHILE' orof 'UNTIL' orof 'AND' orof 'OR' orof 'XOR' orof 'NOT' orof '~' orof '(' orof ','
  else
    do NotFoundTest
    exit
  end
  afterU = upper(self.tk.GetTok(endB + 3))
  case afterU
  of 'THEN' orof 'AND' orof 'OR' orof 'XOR' orof ')' orof ',' orof ';'
  else
    if ~self.IsEolTok(endB + 3) then do NotFoundTest.
  end

NotFoundTest routine
  why = 'the slice starts after byte 1 and the position itself is used'
  do Refuse

Refuse routine
  refused += 1
  if self.curPass > 1 then exit. ! says why once, not every pass
  pLog.append('BUILTIN InstringSliceToST: line ' & ln & ' left alone - ' & clip(why) & '<13,10>')

! ---- the comments the rewrite would drop, into cmtRows (cmtN of them): the new call is built
!      from the needle, the slice's ends it keeps and the start as written - the trivia between
!      their own tokens comes too - and the object's bare name, so a comment riding the trivia of
!      any other token from the '(' to the ')' - after a '|' - would go. They are carried to the
!      end of the line instead, in front of its own comment (CmtToLineEnd), as KnownRanges
!      carries the comments of the insert it writes. Reads p, endB, a1S, a1E, a2S, colon, a2E,
!      fromOne, noEnd, a4S and a4E: the first byte is written only when the slice does not
!      start at 1, the last only when it does not end at X._DataEnd. ----
CmtScan routine
  data
cz  long,auto
  code
  cmtRows.free()
  cmtN = 0
  loop cz = p + 1 to endB
    if cz > a1S and cz <= a1E then cycle.
    if ~fromOne and cz > a2S + 2 and cz < colon then cycle.
    if ~noEnd and cz > colon + 1 and cz < a2E then cycle.
    if cz > a4S and cz <= a4E then cycle.
    cmtN += self.TriviaCmtRows(cz, cmtRows)
  end

! ---- can they be carried? Only when the call's own line is the last row of its statement, so the
!      line end they go to is the one the comments were written above: no line break in the trivia
!      of anything from the ')' to the EOL token. cmtOk says. ----
CmtEnd routine
  data
ce  long,auto
eol long,auto
  code
  cmtOk = 0
  eol = self.FirstEolAfter(endB)
  if ~eol then exit.
  loop ce = endB + 1 to eol
    get(self.tk.tokens, ce)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if tkSt.findByte(10, 1,, self.tk.tokens.strBefore) then exit.
  end
  cmtOk = 1

! ------------------------------------------------------------------------------------
! Is the instring() needle in tokens pS..pE provably ONE character? The cases the rule guard
! isOneChar accepts by declaration: a quoted literal of one character, counted as the language
! counts it (a doubled quote, a <n> code and a {n} repeat); a variable declared STRING(1) without
! DIM; and x[i] - one subscript, no range - on a plain or a dotted string read without DIM. Anything
! else is not shown to be one character: 0.
! ------------------------------------------------------------------------------------
VitEngine.InstrOneChar Procedure(LONG pS, LONG pE)
txt   StringTheory
k     long,auto
dep   long
  code
  if pS < 1 or pE < pS then return 0.
  txt.setValue(self.tk.GetTok(pS))
  if ~txt._DataEnd then return 0.
  if pS = pE
    if txt.valuePtr[1] = '''' then return choose(self.rw.m.LitLength(txt.getValue()) = 1).
    if ~self.rl.IsLabelToken(txt.getValue()) then return 0.
    return choose(self.syms.DeclaredStrLen(txt.getValue(), pS) = 1)
  end
  if self.tk.GetTok(pS + 1) <> '[' or self.tk.GetTok(pE) <> ']' then return 0. ! x[i]: the name, then its one subscript
  loop k = pS + 2 to pE - 1
    txt.setValue(self.tk.GetTok(k))
    if txt.containsByte(58) then return 0.                                     ! a range, not an index  ! <colon>
    if txt._DataEnd <> 1 then cycle.
    case val(txt.valuePtr[1])
    of 91                                                                      ! '['
      dep += 1
    of 93                                                                      ! ']' closing the subscript early: x[i][j]
      if ~dep then return 0.
      dep -= 1
    of 44                                                                      ! a comma at depth 0: two subscripts
      if ~dep then return 0.
    end
  end
  txt.setValue(self.tk.GetTok(pS))
  if txt.containsByte(46) then return self.rw.m.DottedOneChar(pS).             ! <dot>
  return self.syms.VarOneChar(txt.getValue(), pS)

VitEngine.BuiltinInstringToST Procedure(StringTheory pLog, BYTE pLit=0)
p        long,auto          ! the `instring` token
endB     long,auto          ! its closing bracket
argS     long,auto          ! first token of the argument being collected
argN     long               ! which argument
dep      long,auto
q        long,auto
a1S      long               ! the needle
a1E      long
a2S      long               ! the haystack
a2E      long
a3S      long               ! the step
a3E      long
a4S      long               ! the start position
a4E      long
bad      byte
stTok    long,auto          ! the StringTheory's declaration token
stRf     byte               ! what its name means at the call is a reference
why      STRING(100)        ! the reason a call is left alone, for the report
lastEnd  long               ! the closing bracket of the last call staged
ln       long,auto
hayType  string(vs:maxName) ! no AUTO: may be read before it is set
needle   StringTheory
start    StringTheory
newTxt   StringTheory
sbSt     StringTheory
tkSt     StringTheory
changes  long
refused  long
cmtN     long
cmtOk    byte
cmtRows  StringTheory
cmtTxt   StringTheory
isLit    byte,auto
bi       STRING(20)
IsQ      QUEUE,PRE(is)
p          LONG                      ! the instring token
endB       LONG                      ! its closing bracket
stTok      LONG                      ! the StringTheory whose method is borrowed
ln         LONG
a1S        LONG                      ! the needle
a1E        LONG
a2S        LONG                      ! the haystack, one token
a4S        LONG                      ! the start position, 0 = none
a4E        LONG
         END
  code
  bi = choose(~pLit, 'InstringToST', choose(pLit = 1, 'InstringLitToST', 'InstringOneCharToST'))
  free(IsQ)
  if self.tk &= NULL then return 0.
  p = 0
  loop
    p = self.tk.FindSeq(',^  ^instring, (', p + 1)
    if ~p then break.
    if lower(self.tk.GetTok(p)) <> 'instring' then cycle.          ! the whole token, not a dotted name ending in it
    if self.tk.GetTok(p - 1) = '.' then cycle.                     ! obj.Instring(...) is the object's own METHOD
    endB = self.tk.MatchLeftBracket('(', ')', p + 1)
    if ~endB then cycle.
    ln = self.LogLineOf(p)
    ! ---- split the arguments at bracket depth 0 ----
    argN = 1 ; argS = p + 2 ; dep = 0 ; bad = 0
    a1S = 0 ; a1E = 0 ; a2S = 0 ; a2E = 0 ; a3S = 0 ; a3E = 0 ; a4S = 0 ; a4E = 0
    loop q = p + 2 to endB
      tkSt.setValue(self.tk.GetTok(q))
      if tkSt._DataEnd = 1
        case val(tkSt.valuePtr[1])
        of 40 orof 91                                              ! '(' orof '['
          dep += 1
        of 41 orof 93                                              ! ')' orof ']'
          if q = endB
            do Arg
            break
          end
          dep -= 1
        of 44                                                      ! <comma>
          if ~dep
            do Arg
            argN += 1
            argS = q + 1
          end
        end
      end
    end
    isLit = 0                                                      ! InstringToST takes a STRING to search, and
    if a2S and a2S = a2E                                           !   InstringLitToST a string literal - each call
      tkSt.setValue(self.tk.GetTok(a2S))                           !   is judged and reported by one of the two
      if tkSt._DataEnd and tkSt.valuePtr[1] = '''' then isLit = 1.
    end
    if pLit = 1 and ~isLit then cycle.
    if pLit = 2                                                    ! InstringOneCharToST takes only a needle that is provably
      if isLit or bad or ~a1S then cycle.                          !   ONE character; anything else is not its call and is
      if ~self.InstrOneChar(a1S, a1E) then cycle.                  !   not reported here - it runs by default
      if ~self.syms.FirstInstanceOf('STRINGTHEORY', p) then cycle. ! no object to borrow the method from: not its call either
      if a2S <> a2E then cycle.                                    ! an expression to search is not a variable: not its call
    end
    if isLit and ~pLit                                             ! instring is the faster of the two on a text
      why = 'the text it searches is a literal - group'            !   as short as a literal, so only
      why = clip(why) & ' st-instring-literal converts it'         !   InstringLitToST, off by default, converts it
      do Refuse
      cycle
    end
    if bad or argN < 3 or argN > 4 or ~a1S or ~a2S or ~a3S
      why = 'not instring(text, where, 1[, start])'
      do Refuse
      cycle
    end
    if a3S <> a3E or self.tk.GetTok(a3S) <> '1'                    ! the step must be the literal 1
      why = 'the step is not the literal 1'
      do Refuse
      cycle
    end
    if a2S <> a2E                                                  ! the haystack: ONE token, a plain variable
      why = 'the text it searches is an expression'
      do Refuse
      cycle
    end
    tkSt.setValue(self.tk.GetTok(a2S))
    if tkSt._DataEnd < 1
      why = 'the text it searches cannot be read'
      do Refuse
      cycle
    end
    if isLit                                                         ! a string literal: the String p_Text overload takes
      if not self.rl &= NULL and self.rl.stVersion and               |  !   it by value, from StringTheory 3.84 on
         self.rl.stVersion < '3.84'
        why = 'a literal to search needs StringTheory 3.84'
        do Refuse
        cycle
      end
    else
      hayType = self.HayType(tkSt.getValue(), a2S)
      if hayType <> 'STRING'                                         ! *String p_Text: a CSTRING would not compile
        why = 'the text it searches is not a STRING'
        do Refuse
        cycle
      end
    end
    if argN = 4 and ~a4S
      why = 'the start position is empty'
      do Refuse
      cycle
    end
    stTok = self.syms.FirstInstanceOf('STRINGTHEORY', p)
    if ~stTok
      refused += 1
      if pLit <> 2 or self.curPass = 1
        pLog.append('BUILTIN ' & clip(bi) & ': line ' & ln & ' left alone - no StringTheory instance in scope<13,10>')
      end
      cycle
    end
    ! *** THE NAME MUST MEAN THAT OBJECT WHERE THE CALL IS. *** The instance may be borrowed
    ! from an outer scope, and a local, a parameter or a routine's data of the same name hides
    ! it there: `st LONG` over a module `st StringTheory` makes st.findChars(...) a call on a
    ! LONG. So the name is looked up at the call, and must be a StringTheory, not a reference.
    if ~self.syms.Lookup(self.tk.GetTok(stTok), p, hayType, stRf) or |
       upper(hayType) <> 'STRINGTHEORY' or stRf
      why = 'the name ' & self.tk.GetTok(stTok) & ' means something else here'
      do Refuse
      cycle
    end
    if p >= lastEnd
      do CmtScan
      if cmtN then do CmtEnd.
      if cmtN and ~cmtOk
        why = 'a comment in it has no line end to move to'
        do Refuse
        cycle
      end
    end
    if p < lastEnd then cycle.                                       ! INSIDE A CALL STAGED ALREADY: the edits run highest first, so its
    lastEnd = endB                                                   !   own would move the tokens the outer one cuts - it waits a pass
    clear(IsQ)                                                       ! staged: every call is decided before any is rewritten, so the
    is:p = p ; is:endB = endB ; is:stTok = stTok ; is:ln = ln        !   positions the symbol table reads stay the ones it was built on
    is:a1S = a1S ; is:a1E = a1E ; is:a2S = a2S
    is:a4S = choose(argN = 4, a4S, 0) ; is:a4E = a4E
    add(IsQ)
  end
  ! ---- HIGHEST FIRST: an edit moves only the tokens after it ----
  loop q = records(IsQ) to 1 by -1
    get(IsQ, q)
    if errorcode() then cycle.
    self.IsuSpanText(is:a1S, is:a1E, needle)
    start.free()
    if is:a4S then self.IsuSpanText(is:a4S, is:a4E, start).
    newTxt.setValue(self.tk.GetTok(is:stTok) & '.findChars(' & needle.getValue() & ',')
    if start._DataEnd and start.getValue() <> '1'                    ! a start of 1 is findChars' own default
      newTxt.append(' ' & start.getValue())
    end
    newTxt.append(',, ' & self.tk.GetTok(is:a2S) & ')')
    self.tk.GetTok(is:p, sbSt, tkSt)                                 ! the call's own leading trivia survives
    p = is:p ; endB = is:endB ; a1S = is:a1S ; a1E = is:a1E
    a4S = is:a4S ; a4E = is:a4E
    do CmtScan
    self.tk.DeleteToks(is:p, is:endB)
    self.tk.InsertString(is:p, newTxt)
    self.tk.SetStrBefore(is:p, sbSt.getValue())
    cmtTxt.free()
    self.CmtRowsJoin(cmtRows, cmtTxt)
    if cmtN then self.CmtToLineEnd(self.FirstEolAfter(is:p), cmtTxt).
    changes += 1
    pLog.append('BUILTIN ' & clip(bi) & ': line ' & is:ln & ' instring(...) -> ' & newTxt.getValue() & '<13,10>')
  end
  free(IsQ)
  if changes then self.tk.SetLineNumbers().
  if changes or (refused and (pLit <> 2 or self.curPass = 1))
    pLog.append('BUILTIN ' & clip(bi) & ': ' & changes & ' instring call(s) rewritten this pass, ' & refused & ' left alone<13,10>')
  end
  return changes

Arg routine
  if q - 1 < argS ! an empty argument
    bad = 1
    exit
  end
  case argN
  of 1
    a1S = argS ; a1E = q - 1
  of 2
    a2S = argS ; a2E = q - 1
  of 3
    a3S = argS ; a3E = q - 1
  of 4
    a4S = argS ; a4E = q - 1
  else
    bad = 1
  end

Refuse routine
  refused += 1
  if pLit = 2 and self.curPass > 1 then exit. ! the default-on mode says why once, not every pass
  pLog.append('BUILTIN ' & clip(bi) & ': line ' & ln & ' left alone - ' & clip(why) & '<13,10>')

! ---- the comments the rewrite would drop, into cmtRows (cmtN of them): the new call is built
!      from the needle and the start as written - the trivia between their own tokens comes too -
!      and from the bare text of everything else, so a comment riding the trivia of any other
!      token from the '(' to the ')' - after a '|' - would go. They are carried to the end of the
!      line instead, in front of its own comment (CmtToLineEnd), as KnownRanges carries the
!      comments of the insert it writes. Reads p, endB, a1S, a1E, a4S and a4E. ----
CmtScan routine
  data
cz  long,auto
  code
  cmtRows.free()
  cmtN = 0
  loop cz = p + 1 to endB
    if cz > a1S and cz <= a1E then cycle.
    if cz > a4S and cz <= a4E then cycle.
    cmtN += self.TriviaCmtRows(cz, cmtRows)
  end

! ---- can they be carried? Only when the call's own line is the last row of its statement, so the
!      line end they go to is the one the comments were written above: no line break in the trivia
!      of anything from the ')' to the EOL token. cmtOk says. ----
CmtEnd routine
  data
ce  long,auto
eol long,auto
  code
  cmtOk = 0
  eol = self.FirstEolAfter(endB)
  if ~eol then exit.
  loop ce = endB + 1 to eol
    get(self.tk.tokens, ce)
    if errorcode() then exit.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if tkSt.findByte(10, 1,, self.tk.tokens.strBefore) then exit.
  end
  cmtOk = 1

! =============================================================================================
! BUILTIN RejoinWrapped - the INVERSE of SplitWideLines. A statement wrapped over two lines that
! would now fit comfortably on one is put back onto one line.
!
!     if ~p1 or |                                 if ~p1 or ln[1 : 4]
!        ln[1 : 4]              becomes             r = 1
!      r = 1                                      end
!
! OPT-IN, OFF BY DEFAULT, own group, because it rewrites a line the author deliberately
! wrapped, which is a formatting CHOICE and wants a switch like every other choice here.
!
! *** WHERE A LINE BREAK LIVES IS CHECKED, NEVER ASSUMED. The tokenizer settles it in its
! own comment: "with continuations ('|') there is no <10> token". So there are TWO line
! endings and this pass has to handle both:
!
!     a NORMAL line ends with an EOL TOKEN            - tok is <10>
!     a CONTINUED line ends in the NEXT token's TRIVIA - its strBefore holds the bar, the CR/LF
!                                                        and the indent, in that order
!
! The width is measured the same way SplitWideLines measures it - strBefore plus tok, reset
! at BOTH endings - or it accumulates across the file and every join is refused in silence.
! This pass reports every candidate and its measurement under --verbose. ***
!
! WHAT IT REFUSES, and each one is a rule from the spec rather than caution for its own sake:
!   * a COMMENT on the first line - a '!', or words written after its bar. It would end up in the
!     middle of the statement.
!   * a joined line WIDER than the splitter's own limit. Same limit, so the two passes cannot
!     fight: SplitWideLines only breaks a line ABOVE the limit and this only joins to AT or BELOW
!     it, which is what stops the ratchet the round trip exists to catch.
!   * a three-line wrap is joined ONE PAIR PER PASS. After joining a pair the pass does not
!     immediately treat the result as the first line of another pair - the widths it would be
!     reasoning from are the ones it just invalidated. The fixpoint comes back round.
! A COMMENT on the SECOND line is not refused. It ends the joined line, as it ended its own, and
! its width counts toward the limit: it lives in the trivia of that line's EOL token, which the
! width has taken in before RjClose measures the pair.
! =============================================================================================
VitEngine.BuiltinRejoinWrapped Procedure(StringTheory pLog)
n        long,auto
x        long,auto
z        long,auto
w        long      ! rendered width of the line being walked - strBefore + tok, as SplitWideLines counts it, reset at BOTH line endings
indW     long      ! that line's indent width, so the CONTENT width is w - indW
newLine  byte,auto ! the next token's strBefore is this line's indent
lastNl   long,auto
hasBar   byte      ! the line that just ended is CONTINUED
hasCmt   byte      ! ... and carries a comment
pendW    long      ! width of the FIRST line of a candidate pair, bar excluded
pendTok  long      ! the token that BEGINS the second line - its trivia becomes a space
pendLn   long      ! source line of the first, for the log
joined   long,auto
changes  long
lim      long,auto
RjQ   QUEUE,PRE(rj)
qTok    LONG
qW      LONG
qLn     LONG
      END
  code
  free(RjQ)
  if self.tk &= NULL then return 0.
  lim = self.splitWidth
  if lim < 1 then return 0.                                         ! no limit to fit inside - nothing to decide
  n = records(self.tk.tokens)
  w = 0 ; indW = 0 ; newLine = 0
  pendW = 0 ; pendTok = 0 ; pendLn = 0
  loop x = 1 to n
    get(self.tk.tokens, x)
    if errorcode() then break.
    if not self.tk.tokens.strBefore &= NULL
      lastNl = 0
      loop z = 1 to size(self.tk.tokens.strBefore)
        if self.tk.tokens.strBefore[z] = '<10>' then lastNl = z.
      end
      if lastNl                                                     ! a line ENDS inside this token's trivia
        hasBar = 0 ; hasCmt = 0
        loop z = 1 to lastNl
          case self.tk.tokens.strBefore[z]
          of '|'
            hasBar = 1
          of '!'
            hasCmt = 1
          of ' ' orof '<9>' orof '<13>' orof '<10>'
          else
            if hasBar then hasCmt = 1.                              ! words after the bar are a comment too
          end
        end
        do RjClose
        w = size(self.tk.tokens.strBefore) - lastNl                 ! the new line's indent
        indW = w
        newLine = 0
      else
        w += size(self.tk.tokens.strBefore)
        if newLine
          indW = w
          newLine = 0
        end
      end
    end
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' ! a NORMAL line ending
      hasBar = 0 ; hasCmt = 0
      do RjClose
      w = 0 ; indW = 0 ; newLine = 1
      cycle
    end
    w += size(self.tk.tokens.tok)
  end

  ! HIGHEST FIRST, like every other staged edit here - an earlier rewrite does not move a later
  ! token, but walking backwards keeps this the same shape as the passes beside it.
  loop z = records(RjQ) to 1 by -1
    get(RjQ, z)
    if errorcode() then cycle.
    self.tk.SetStrBefore(rj:qTok, ' ')                              ! the bar, the CR/LF and the indent become ONE space
    changes += 1
    pLog.append('BUILTIN RejoinWrapped: line ' & rj:qLn & ' joined with the line below it, ' & |
                rj:qW & ' characters<13,10>')
  end
  if changes
    self.wantReparse = true                                         ! the two physical lines are now one
    pLog.append('BUILTIN RejoinWrapped: ' & changes & ' rejoin(s) this pass<13,10>')
  end
  return changes

! ---- close the line whose width is now in w -------------------------------------------------
RjClose routine
  if pendTok
    joined = pendW + 1 + (w - indW)                                                     ! first line, one space, second line's CONTENT
    if self.verbose
      pLog.append('  [RJ] line ' & pendLn & ' first=' & pendW & ' second=' & w - indW & |
                  ' joined=' & joined & ' limit=' & lim & ' cmt=' & hasCmt            & |
                  ' -> ' & choose(joined <= lim and ~hasCmt, 'JOIN', 'refuse') & '<13,10>')
    end
    if joined <= lim and ~hasCmt
      clear(RjQ)
      rj:qTok = pendTok
      rj:qW   = joined
      rj:qLn  = pendLn
      add(RjQ)
    end
    pendTok = 0                                                                         ! one pair per pass - see the header
  elsif hasBar and ~hasCmt
    pendW   = w
    pendTok = x
    pendLn  = self.LogLineOf(x)
  end

! ====================================================================================
! BUILTIN ExpandOneLiners (OPT-IN, cosmetic) - inline IF -> block form.
!   BUILTIN ExpandOneLiners
! Rewrites a single-line  `if C then S. [else T.]`  - or the ';'-separator form
! `if C; S. [else T.]`, which Clarion accepts as the same statement -
! into the multi-line block form:
!       if C                       if C
!         S           or             S
!       end                        else
!                                    T
!                                  end
! Handles ONE flat IF per line only.  Bails (line left byte-identical) on:
!   * multi-statement clauses (a ';' beyond the single THEN-or-';' separator, e.g.
!     `if C then S; T.` or `if C; S; T.`) - NB SplitStatements ALSO bails on an IF
!     line (level mark), so multi-statement one-liners stay one-liners by design;
!   * ELSIF chains / nested IF / any second block (plusCnt<>1, thenCnt+semiCnt<>1, slashCnt>1,
!     or a '/' token that is not ELSE);
!   * a non-'.' terminator or a '.' that is not the final token (requires the block '.');
!   * a comment in the line interior or trailing (a LEADING full-line comment above the IF
!     is fine - it lives in the IF token's strBefore, which the comment check skips).
! Mechanics (NO token nulled - TokenType is not null-safe): `then` (or the separator
! ';') is RETYPED to a newline
! (the same proven move SplitStatements makes on ';'), so the word vanishes and becomes the
! break after `if C`; the `else`/`end` line breaks are a CRLF placed in the following token's
! strBefore; the terminating '.' is retyped to `end`.  Body indent = IF indent + 2 spaces
! (Reindent, if later enabled, normalises).  wantReparse re-lines the token stream.
! ====================================================================================
VitEngine.BuiltinExpandOneLiners Procedure(StringTheory pLog)
n          long,auto
i          long,auto
k          long,auto
llStart    long
plusCnt    long
slashCnt   long
thenPos    long
thenCnt    long
elsePos    long
dotPos     long
lastPos    long
lastIsDot  byte
isIfLine   byte
elseIsElse byte
semiCnt    long
semiPos    long
flushEol   long
sbLen      long,auto
ch         string(1)
lvl        string(1)
ifIndentSt StringTheory
sBody      StringTheory
sIfNL      StringTheory
sBodyNL    StringTheory
changes    long
  code
  n = records(self.tk.tokens)
  if n < 1 then return 0.
  llStart = 1
  do ResetLine
  loop i = 1 to n
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.IsEolTok(i) or i = n
      if i = n and ~self.IsEolTok(i)
        do ScanE ! last token is real - fold it in first
      end
      flushEol = i
      do FlushLine
      llStart  = i + 1
      do ResetLine
    else
      do ScanE
    end
  end
  if changes
    self.wantReparse = true
    pLog.append('BUILTIN ExpandOneLiners: ' & changes & ' one-liner(s) expanded this pass<13,10>')
  end
  return changes

! ---- reset per-line accumulators (dataless routine -> no CODE) ----
ResetLine routine
  plusCnt = 0; slashCnt = 0
  thenPos = 0; thenCnt = 0; elsePos = 0; dotPos = 0; lastPos = 0; lastIsDot = 0
  isIfLine = 0; elseIsElse = 0; semiCnt = 0; semiPos = 0

! ---- accumulate one non-EOL token into the line state (buffer is on token i) ----
ScanE routine
  data
uvt string(vs:maxName),AUTO
  code
  ! '+' (block opener) and '/' (else/elsif/of) levels are set by TokenType from the KEYWORD, so
  ! they are reliable even for an inline one-liner.  The '-' (end/'.') level is set by a separate
  ! pass and may not mark an inline '.', so the terminator is detected by VALUE (last token = '.').
  lvl = self.tk.tokens.level
  if lvl = '+' then plusCnt += 1.
  if lvl = '/'
    slashCnt += 1
    elsePos = i
    if not self.tk.tokens.tok &= NULL
      if upper(self.tk.tokens.tok) = 'ELSE' then elseIsElse = 1.
    end
  end
  if self.tk.tokens.tok &= NULL then exit.
  uvt = upper(self.tk.tokens.tok)
  lastPos = i
  lastIsDot = choose(self.tk.tokens.tok = '.') ! updated each token -> reflects the final one at flush
  if i = llStart and uvt = 'IF' and lvl = '+' then isIfLine = 1.
  case uvt
  of 'THEN'
    thenCnt += 1
    thenPos = i
  of ';'
    semiCnt += 1
    semiPos = i
  end

! ---- qualify + transform the current line (dataless routine -> no CODE) ----
FlushLine routine
  if ~isIfLine    or                                              |
     plusCnt <> 1 or                                              |   ! exactly one block opener (the IF)
     thenCnt + semiCnt <> 1                                       ! exactly ONE separator: THEN or the ';' form (both/extra ';' = multi-statement -> bail)
    exit
  end
  if semiCnt = 1 then thenPos = semiPos.                          ! `if C; S.` - the ';' plays THEN's role
  if slashCnt > 1                 or                              |
     slashCnt = 1 and ~elseIsElse or                              |
     ~lastIsDot                                                   ! terminator must be a final '.' token
    exit
  end
  dotPos = lastPos                                                ! the terminating '.'
  if thenPos < llStart or dotPos < thenPos then exit.             ! sanity
  if self.LineHasComment(llStart + 1, flushEol) then exit.        ! interior/trailing comment -> skip (leading is ignored)
  if slashCnt = 1
    if thenPos + 1 >= elsePos or elsePos + 1 >= dotPos then exit. ! empty then/else clause
  else
    if thenPos + 1 >= dotPos then exit.                           ! empty then clause
  end
  do ExpandLine
  changes += 1
  if changes <= 500
    pLog.append('BUILTIN ExpandOneLiners line ' & self.LogLineOf(llStart) & ': inline IF -> block form<13,10>')
  end

! ---- capture the IF-line indent = trailing whitespace run of the line-start strBefore ----
CaptureIndentE routine
  ifIndentSt.free()
  get(self.tk.tokens, llStart)
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL then exit.
  sbLen = size(self.tk.tokens.strBefore)
  k = sbLen
  loop while k >= 1
    ch = self.tk.tokens.strBefore[k]
    case val(ch)
    of 32 orof 9 ! <space> orof <tab>
      k -= 1
    else
      break
    end
  end
  if k < sbLen then ifIndentSt.setValue(sub(self.tk.tokens.strBefore, k + 1, sbLen - k)).

! ---- perform the block-form rewrite for the qualified line ----
ExpandLine routine
  do CaptureIndentE
  sBody.setValue(ifIndentSt.getValuePtr())
  sBody.append('  ')                                      ! body indent = if-indent + 2 (spaces only)
  sIfNL.setValue('<13,10>')
  sIfNL.append(ifIndentSt)                                ! newline + if-indent
  sBodyNL.setValue('<13,10>')
  sBodyNL.append(ifIndentSt)
  sBodyNL.append('  ')                                    ! newline + body indent
  self.tk.SetTok(thenPos, '<10>', '')                     ! 'then' -> the line break after `if C`
  self.tk.SetStrBefore(thenPos + 1, sBody.getValue())     ! then-clause first token at body indent
  if slashCnt = 1
    self.tk.SetStrBefore(elsePos, sIfNL.getValue())       ! 'else' onto its own line at if-indent
    self.tk.SetStrBefore(elsePos + 1, sBodyNL.getValue()) ! else-clause first token at body indent
  end
  self.tk.SetTok(dotPos, 'end', sIfNL.getValue())         ! '.' -> `end` on its own line at if-indent

! ====================================================================================
! BUILTIN BlockEndStyle (OPT-IN, cosmetic) - `.` <-> END terminators.
!   BUILTIN BlockEndStyle, STYLE('end'|'period')     (default 'end' = spell terminators out)
!   * STYLE('end')    : '.'  -> the word `end`
!   * STYLE('period') : `END` -> '.'
!
! TWO CASES, AND THEY ARE DECIDED DIFFERENTLY. That difference is the whole design:
!
!  1. WHOLE-LINE - the terminator is the only non-EOL token on its line. Its VALUE settles it:
!     a token alone on a line that reads '.' or END cannot be anything else. No type or level
!     information is consulted. strBefore (indent AND any comment) is preserved as-is.
!     The one exclusion is a COLUMN-1 `End`, which is a jump label (GOTO End), not a terminator.
!
!  2. INLINE - the terminator shares its line with code, as in `if x then y.`. Here the
!     value is NOT enough: `st.getValue()` also contains a lone '.' token. So this case keys on
!     the token TYPE, vt:end, which ParseText's promotion walk sets only for a '.' that is
!     really a terminator - a method dot stays vt:dot because the token after it is a name with
!     no gap in front. Additional conditions, all of them under-reach:
!       * the terminator must be the LAST token on the line;
!       * EXACTLY ONE terminator on the line. A stacked run (`. .`, closing several blocks at
!         once) is REFUSED - see below;
!       * the gap in front of it must be blank. A comment or continuation there is left alone.
!
! WHY STACKED RUNS ARE REFUSED. To expand `. .` into `END END` correctly the
! builtin would have to trust the tokenizer's level marks to know the run really closes two
! blocks. It does not count blocks anywhere else, and a wrong count would not fail loudly - it
! would silently reshape the block structure, which is the worst failure class here: one wrong
! level mark moves every block boundary after it. Identifying
! ONE token as a terminator is a local decision and safe; counting how many blocks a run closes
! is not. Under-reach is the correct direction here.
!
! SPACING. Going '.' -> end INSERTS a space, or `y.` would become `yend`. Going END -> '.'
! removes a single-space gap, so `y END` comes back as `y.` and the pair round trips. The space
! is written with SetStrBefore, which stores anything of non-zero size - a trivia writer that
! tested truthiness instead would read a lone ' ' as blank and drop it.
!
! wantReparse rebuilds levels; the converse spelling never re-fires (an `end` is not a '.').
! Inline expansion of a one-liner into block form is a DIFFERENT builtin, ExpandOneLiners -
! this one only restyles a terminator where it already stands.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinBlockEndStyle Procedure(StringTheory pLog)
styleU     string(12),auto
nm         string(12),auto
raw        StringTheory
s          long,auto
n          long,auto
i          long,auto
llStart    long,AUTO
tokCnt     long
onlyPos    long
onlyValDot byte
onlyIsEnd  byte
endCnt     long ! terminators on this line - inline converts only at 1
lastIsTerm byte ! is the LAST token scanned on the line a terminator
toEnd      byte ! 1 = STYLE(end) '.'->end ; 0 = STYLE(period) END->'.'
styleNm    string(8),auto
changes    long
  code
  toEnd = 1       ! default: spell terminators out as `end`
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      nm = upper(self.rl.rules.bparmQ.name)
      if nm = 'STYLE' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        styleU = upper(raw.getValue())
        if styleU = 'PERIOD' or styleU = 'DOT' then toEnd = 0.
        if styleU = 'END' then toEnd = 1.
      elsif nm = 'PERIOD' or nm = 'DOT'
        toEnd = 0 ! bare form: BUILTIN BlockEndStyle, PERIOD
      elsif nm = 'END'
        toEnd = 1
      end
    end
  end

  n = records(self.tk.tokens)
  if n < 1 then return 0.
! #Unused assignment (never read):   llStart = 1
  do ResetB
  loop i = 1 to n
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.IsEolTok(i) or i = n
      if i = n and ~self.IsEolTok(i)
        do ScanB
      end
      do FlushB
      llStart = i + 1
      do ResetB
    else
      do ScanB
    end
  end
  if changes
    self.wantReparse = true
    if toEnd then styleNm = 'end' else styleNm = 'period'.
    pLog.append('BUILTIN BlockEndStyle (' & clip(styleNm) & '): ' & changes & ' terminator(s) this pass<13,10>')
  end
  return changes

! ---- reset per-line state (dataless routine -> no CODE) ----
ResetB routine
  tokCnt = 0; onlyPos = 0; onlyValDot = 0; onlyIsEnd = 0; endCnt = 0; lastIsTerm = 0

! ---- accumulate one non-EOL token (buffer is on token i) ----
ScanB routine
  if self.tk.tokens.tok &= NULL then exit.
  tokCnt += 1
  onlyPos = i
  if self.tk.tokens.tok = '.' then onlyValDot = 1 else onlyValDot = 0.
  if upper(self.tk.tokens.tok) = 'END' then onlyIsEnd = 1 else onlyIsEnd = 0.
  ! TYPE, not value - this is the inline test. ParseText's promotion walk types a '.' as
  ! vt:end only when it is really a block terminator; a method dot in `st.getValue()` stays
  ! vt:dot because the token after it is a name with no gap in front. See the banner above.
  if self.tk.tokens.type = vt:end
    endCnt += 1
    lastIsTerm = 1
  else
    lastIsTerm = 0
  end

! ---- convert a whole-line terminator (dataless routine -> no CODE) ----
FlushB routine
  if tokCnt < 1 then exit.
  get(self.tk.tokens, onlyPos)
  if errorcode() then exit.                  ! could not read it - never convert blind
  if tokCnt > 1
    ! ---- INLINE terminator: it shares its line with code, e.g. `if x then y.` ----
    if endCnt <> 1 or                        |   ! stacked run - REFUSED, see the banner
       ~lastIsTerm                           ! must be the LAST token on the line
      exit
    end
    if not self.tk.tokens.strBefore &= NULL
      if self.tk.tokens.strBefore then exit. ! a comment or continuation in the gap - leave alone
    end
    if toEnd
      if ~onlyValDot then exit.              ! already a word - nothing to do
      self.tk.SetTok(onlyPos, 'end')
      self.tk.SetStrBefore(onlyPos, ' ')     ! `y.` -> `y end`, NEVER `yend`
    else
      if ~onlyIsEnd then exit.               ! already '.' - nothing to do
      self.tk.SetTok(onlyPos, '.')
      self.tk.SetStrBefore(onlyPos, '')      ! `y END` -> `y.` so the pair round trips
    end
    changes += 1
    if changes <= 500
      pLog.append('BUILTIN BlockEndStyle line ' & self.LogLineOf(onlyPos) & ': inline terminator restyled<13,10>')
    end
    exit
  end
  ! ---- WHOLE-LINE terminator: alone on its line, so the VALUE decides ----
  ! A COLUMN-1 'End' is a jump label (GOTO End), not a terminator - firstOnLine with NO
  ! trivia in front of it IS column 1, the same test TokenIsReservedWord uses.
  if self.tk.tokens.firstOnLine and self.tk.BufColOne() then exit.
  ! A lone token on its own line that is '.' or END is unambiguously a block terminator, so we key
  ! on the VALUE (not the '-' level, which a separate pass sets and we don't want to depend on).
  if toEnd
    if ~onlyValDot then exit.                ! already a word - nothing to do
    self.tk.SetTok(onlyPos, 'end')           ! '.' -> end ; strBefore (indent/comment) preserved
  else
    if ~onlyIsEnd then exit.                 ! already '.' - nothing to do
    self.tk.SetTok(onlyPos, '.')             ! END -> '.' ; strBefore preserved
  end
  changes += 1
  if changes <= 500
    pLog.append('BUILTIN BlockEndStyle line ' & self.LogLineOf(onlyPos) & ': terminator restyled<13,10>')
  end

! ====================================================================================
! BUILTIN Reindent (OPT-IN, cosmetic) - normalise block-body indentation.
!   BUILTIN Reindent, WIDTH(2), CASEOF('flush'|'indent')     (default WIDTH 2, CASEOF flush; TABS is not supported)
! Recomputes the leading indent of executable block bodies from nesting depth, using the
! tokenizer's reliable level marks: '+' opens (IF/LOOP/CASE/EXECUTE/...), '-' closes (END/'.'),
! '/' continues (ELSE/ELSIF/OF/OROF).  Model = a STACK of open-block indents:
!   * a block BODY line  -> opener-indent + WIDTH;
!   * an END/'.'/ELSE/OF -> aligned back to the opener's indent (flush CASEOF);
!   * WHEN NO BLOCK IS OPEN, a line's indent is LEFT AS-IS - this preserves each procedure's
!     baseline indent for free, so we never model proc/routine/data-section boundaries.
! Safety by construction (heavy under-reach):
!   * ANY column-1 label line is skipped whole (data decls, proc/routine/method headers,
!     GROUP/QUEUE/CLASS/WINDOW/REPORT/FILE structures - all have col-1 labels) - so data
!     sections and structure declarations are never re-indented and their labels stay put;
!   * only the FIRST-on-line token's leading indent is rewritten (its trailing whitespace run),
!     preserving any leading full-line comment in the same strBefore; continuation ('|') lines
!     and comment-only lines live inside other tokens' strBefore and are untouched;
!   * a col-1 proc/routine header also RESETS the stack (defensive against a mis-balanced block
!     leaking across procedures; well-formed code is already balanced so this is a no-op);
!   * a col-1 label line that OPENS a block still pushes a frame for it, marked layout-preserving,
!     so the structure it declares keeps its interior exactly as authored and the matching END
!     pops the right frame.
! CASEOF('flush'|'indent') (default flush): a CASE frame carries an isCase flag; its OF/OROF/ELSE
! lines either align with the CASE (flush) or indent one level under it (indent), and the branch
! bodies follow (opener+WIDTH flush, opener+2*WIDTH indent) via the frame's bodyLen.  IF-block
! ELSE/ELSIF always align with the IF regardless of CASEOF.
! CODECOL(n) (OPT-IN - absent = un-nested lines are left as-is, the safe default): the CODE statement
! sets the executable baseline (baseCol=n) and is moved to column n; every un-nested body line and
! top-level block opener then anchors to baseCol (nesting = baseCol + depth*WIDTH) instead of keeping
! its own indent.  baseActive persists across the proc's ROUTINEs so their bodies share the same
! baseline (routines are appended at body level, not nested), and is CLEARED at the next
! PROCEDURE/FUNCTION header - the baseline belongs to the procedure that declared it, so the next
! proc's data section is left as authored until its own CODE.  This gives an absolute proc-body reflow
! keyed off the one keyword that reliably marks it, with no proc/routine/method/DATA-section modelling.
! The CODE statement is an INDENTED reserved word (type 'r'); a data field named `Code` is a col-1
! label (type 'b') and is not mistaken for it.
! Idempotent (a second run finds 0 changes -> converges).  Indent-only edit (no token/level/
! symbol change), so NO wantReparse. Indents are written with spaces; TABS is not supported.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinReindent Procedure(StringTheory pLog)
width          long
caseIndent     byte         ! CASEOF: 0 = flush (default), 1 = indent OF/OROF one level under CASE
codeCol        long         ! CODECOL(n): target column for CODE + the executable baseline
codeColSet     byte         ! CODECOL was supplied (opt-in; absent = un-nested lines left as-is)
baseCol        long         ! current executable baseline (set by each CODE line)
baseActive     byte         ! a CODE has been seen -> anchor un-nested lines to baseCol
lineIsCode     byte         ! this line is a CODE statement (indented reserved word)
s              long,auto
nmv            string(12),auto
raw            StringTheory
n              long,auto
i              long,auto
m              long,auto
j              long,auto
llStart        long
lvl            string(1)
firstStructLev string(1)
closerAtStart  byte         ! was that first structural mark the line's FIRST token?
firstType      string(1)
firstFOL       byte
firstDbg       byte,auto    ! the first token is a column-1 `?` - the debug-only marker
sawStruct      byte
isCol1Label    byte
hasProcKw      byte
hasProcHdr     byte         ! PROCEDURE/FUNCTION only - a ROUTINE shares the proc's baseline and must NOT clear it
lineIsCase     byte         ! this line's '+' opener is a CASE
lineIsStruct   byte         ! this line's '+' opener is a DATA STRUCTURE (WINDOW/GROUP/QUEUE/SHEET/...), not control flow
targetLen      long
topOpn         long         ! stack top: opener indent
topBody        long         ! stack top: body indent
tmpLen         long
shifted        byte         ! .txa: this line was shifted one column right by the pre-process (its EOL trivia holds <251>)
ez             long,auto
indentLen      long,auto
tmpLeadLen     long
hadTab         byte
c              string(1)
sbCap          StringTheory
sbNew          StringTheory ! build the reindented strBefore with ST (no fixed buffer)
changes        long
StackQ QUEUE
opnLen   long               ! the opener line's own indent (END/ELSE/OF align here)
bodyLen  long               ! indent for this block's direct body lines (CASE-of adjusts it)
isCase   byte               ! this frame is a CASE (so ELSE/OF get the CASEOF treatment)
isStruct byte               ! this frame is a data structure - leave its member/END layout untouched
       END
MarkQ QUEUE
mklev   string(1)
       END
  code
  width = 2                            ! default nesting width
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      nmv = upper(self.rl.rules.bparmQ.name)
      if nmv = 'WIDTH' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        width = raw.getValue()         ! WIDTH(n) - Clarion string->numeric on assign
      elsif nmv = 'CASEOF' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        if upper(choose(raw._DataEnd < 1, '', raw.valuePtr[1 : raw._DataEnd])) = 'INDENT' then caseIndent = 1.
        if upper(choose(raw._DataEnd < 1, '', raw.valuePtr[1 : raw._DataEnd])) = 'FLUSH'  then caseIndent = 0.
      elsif nmv = 'CODECOL' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.unquote('''','''')
        codeCol    = raw.getValue()    ! CODECOL(n): opt-in absolute baseline anchored on CODE
        codeColSet = 1
      elsif nmv = 'TABS'
        if self.curPass = 1
          pLog.append('BUILTIN Reindent: TABS is not supported - indents are written with spaces<13,10>')
        end
      end
    end
  end
  if width < 0 then width = 0.
  if width > 32 then width = 32.
  if codeCol < 1 then codeCol = 1.     ! CODECOL(0) would re-base lines to column 1 = they become LABELS
  if codeCol > 256 then codeCol = 256.

  n = records(self.tk.tokens)
  if n < 1 then return 0.
  free(StackQ)
  llStart = 1
  do ResetR
  loop i = 1 to n
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.IsEolTok(i) or i = n
      if i = n and ~self.IsEolTok(i)
        do ScanR
      end
      do FlushR
      llStart = i + 1
      do ResetR
    else
      do ScanR
    end
  end
  if changes
    pLog.append('BUILTIN Reindent (width ' & width & '): ' & changes & ' line(s) re-indented this pass<13,10>')
  end
  return changes

! ---- reset per-line accumulators (dataless routine -> no CODE) ----
ResetR routine
  firstStructLev = ' '; firstType = ' '; firstFOL = 0; firstDbg = 0
  sawStruct = 0; closerAtStart = 0; isCol1Label = 0; hasProcKw = 0; hasProcHdr = 0; lineIsCase = 0; lineIsCode = 0; lineIsStruct = 0
  free(MarkQ)

! ---- accumulate one non-EOL token into the line state (buffer is on token i) ----
ScanR routine
  data
uw string(vs:maxName),AUTO
  code
  if i = llStart
    firstFOL  = self.tk.tokens.firstOnLine
    firstType = self.tk.tokens.type
    firstDbg  = choose(size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '?') ! the column-1 debug marker: a layout line, never re-indented
  end
  lvl = self.tk.tokens.level
  case val(lvl)
  of 43 orof 45 orof 47                                                           ! '+' orof '-' orof '/'
    if ~sawStruct
      firstStructLev = lvl
      closerAtStart  = choose(i = llStart)                                        ! is the line the terminator, or does it merely END with one?
      sawStruct = 1
    end
    case val(lvl)
    of 43 orof 45                                                                 ! '+' orof '-'
      MarkQ.mklev = lvl                                                           ! record openers/closers in order for the stack
      add(MarkQ)
    end
  end
  if not self.tk.tokens.tok &= NULL
    uw = upper(self.tk.tokens.tok)
    case uw
    of 'PROCEDURE' orof 'FUNCTION' orof 'ROUTINE'
      hasProcKw = 1
    end
    if uw = 'PROCEDURE' or uw = 'FUNCTION'                   then hasProcHdr = 1. ! ROUTINE deliberately excluded - see the baseActive note in FlushR
    if uw = 'CASE' and lvl = '+' then lineIsCase = 1.                             ! opener is a CASE -> its ELSE/OF get the CASEOF treatment
    if lvl = '+'                                                                  ! classify this opener - control-flow vs data-structure
      case uw
      of 'IF' orof 'CASE' orof 'LOOP' orof 'EXECUTE' orof 'BEGIN' orof 'ACCEPT'
        ! control-flow opener - reindented normally
      else
        lineIsStruct = 1                                                          ! WINDOW/GROUP/QUEUE/RECORD/FILE/VIEW/REPORT/MENU/SHEET/TAB/... - a declaration block
      end
    end

    ! the CODE *statement* is an indented reserved word (a data field named Code is a col-1 label, type 'b')
    if i = llStart and uw = 'CODE' and self.tk.tokens.type = vt:reservedWord then lineIsCode = 1.
  end

! ---- decide + apply the line's indent, then update the block stack (dataless -> no CODE) ----
FlushR routine
  if ~firstFOL then exit.                         ! blank line (llStart is an EOL) or non-line-start -> skip
  do ScanIndentR                                  ! fills sbCap / tmpLen / tmpLeadLen / hadTab
  ! CODECOL (opt-in): a CODE statement sets the executable baseline and is moved to it.  Everything
  ! below (un-nested lines, top-level block openers) then anchors to baseCol instead of being left as-is.
  ! baseActive persists across the proc's routines (their bodies share the proc-body baseline).
  if lineIsCode and codeColSet
    baseCol    = codeCol
    baseActive = 1
    targetLen  = baseCol
    do SetIndentR                                 ! CODE has no level marks -> nothing to push/pop
    exit
  end
  ! A column-1 label line (data decl / proc / routine / structure) - or a column-1 `?`, the debug-only
  ! statement marker, which is not a label to the tokenizer but must stay in column 1 all the same - but a
  ! block OPENED on one still has to push its frame, or everything inside it is loose: `MyQ QUEUE`
  ! is how almost every structure is written, and without the frame its members and END fall
  ! through to the un-nested arm below and are re-based to baseCol, destroying the authored
  ! layout the moment CODECOL is on. (An un-pushed opener also leaves the stack unbalanced: the
  ! structure's END then pops whatever block happens to enclose it.)
  ! The frame is always LAYOUT-PRESERVING (isStruct), whatever the opener is, because the
  ! opener's own indent is 0: aligning an END to column 1 would turn it into a LABEL. So a
  ! column-1-labelled control-flow block (a labelled LOOP) keeps its body as authored rather
  ! than being reflowed - the safe answer.
  isCol1Label = 0
  if firstFOL and ~tmpLen and (firstType = vt:label or firstDbg) then isCol1Label = 1.
  if isCol1Label
    if hasProcKw  then free(StackQ).              ! proc/routine boundary -> reset the stack
    if hasProcHdr then baseActive = 0.            ! ... and the baseline belongs to the procedure that declared it: a new PROCEDURE has none until its OWN CODE, so its data section is left as authored. A
                                                  !   ROUTINE header does NOT clear it - routines are appended at body level and share the proc baseline by design. A MAP/CLASS prototype has the same shape
                                                  !   and clears it too; that is harmless - a prototype only ever precedes the CODE that sets a baseline, and clearing it just leaves lines as authored.
    targetLen    = tmpLen                         ! 0 - recorded as the frame's opener indent, never applied to this line
    lineIsStruct = 1                              ! layout-preserving, per the note above
  elsif records(StackQ) = 0
    if baseActive
      targetLen = baseCol                         ! CODECOL: anchor un-nested executable lines to the CODE baseline
      do SetIndentR
    else
      targetLen = tmpLen                          ! default: not inside a block -> leave the indent as-is
    end
  else
    get(StackQ, records(StackQ))
    topOpn  = StackQ.opnLen
    topBody = StackQ.bodyLen
    case val(firstStructLev)
    of 45                                         ! '-'
      ! A LINE THAT *IS* THE TERMINATOR ALIGNS WITH ITS OPENER. A LINE THAT MERELY ENDS
      ! WITH ONE IS A BODY LINE. Clarion lets a full stop close a block, so `count = 1.` does
      ! two jobs at once: it finishes the statement AND it closes the IF. This arm read the
      ! FIRST structural mark found ANYWHERE on the line, so that line scored as a closer and
      ! the whole statement was dragged out to sit under the `if` - legal, unchanged in meaning,
      ! and not what anyone wrote. The stack still pops either way; only the COLUMN changes.
      if closerAtStart
        targetLen = topOpn                        ! the line IS the terminator: END, or a bare '.'
      else
        targetLen = topBody                       ! a statement that happens to carry one
      end
    of 47                                         ! '/'
      if StackQ.isCase                            ! CASE branch: OF/OROF/ELSE
        if caseIndent
          targetLen      = topOpn + width         ! OF indented one level under CASE
          StackQ.bodyLen = topOpn + width + width ! its body a further level
        else
          targetLen      = topOpn                 ! OF flush with CASE (default)
          StackQ.bodyLen = topOpn + width
        end
        put(StackQ)                               ! persist the of-body indent for the following body lines
      else
        targetLen = topOpn                        ! IF-block ELSE/ELSIF always aligns with the IF
      end
    else
      targetLen = topBody                         ! plain body / nested-opener line
    end
    if StackQ.isStruct                            ! inside a data structure - preserve the member/END layout as authored
      targetLen = tmpLen
    else
      do SetIndentR
    end
  end
  ! push each opener at this line's indent; pop on each closer (handles inline one-liners too)
  loop m = 1 to records(MarkQ)
    get(MarkQ, m)
    case MarkQ.mklev
    of '+'
      StackQ.opnLen  = targetLen                  ! this opener's own indent
      StackQ.bodyLen = targetLen + width          ! its body one level deeper (CASE-of may re-adjust)
      StackQ.isCase  = lineIsCase
      StackQ.isStruct = lineIsStruct
      add(StackQ)
    of '-'
      if records(StackQ) > 0
        get(StackQ, records(StackQ))
        delete(StackQ)
      end
    end
  end

! ---- capture llStart's strBefore + measure its trailing whitespace run (dataless -> no CODE) ----
ScanIndentR routine
  sbCap.free()
  tmpLen = 0; tmpLeadLen = 0; hadTab = 0
  get(self.tk.tokens, llStart)
  if errorcode() then exit.
  if self.tk.tokens.strBefore &= NULL then exit.
  sbCap.setValue(self.tk.tokens.strBefore)
  j = size(self.tk.tokens.strBefore)
  loop while j >= 1
    c = self.tk.tokens.strBefore[j]
    case val(c)
    of 32                 ! <space>
      tmpLen += 1; j -= 1
    of 9                  ! <tab>
      tmpLen += 1; hadTab = 1; j -= 1
    else
      break
    end
  end
  tmpLeadLen = j          ! chars before the trailing whitespace run
  ! ---- a .txa: step 6 of the pre-process shifts every column-1 CODE-embed line one space right and marks it
  !      with !<251> at its end, and the post-process takes that one space back. Reindent must measure such a
  !      line at its REAL indent (one less) and write the lent space back with whatever indent it decides, or the
  !      body under a column-1 opener comes out one column too deep. ----
  shifted = 0
  if self.isTxa and tmpLen >= 1
    ez = llStart
    loop while ez < n
      if self.IsEolTok(ez) then break.
      ez += 1
    end
    get(self.tk.tokens, ez)
    if ~errorcode() and not self.tk.tokens.strBefore &= NULL
      if pLog.findByte(251, 1,, self.tk.tokens.strBefore) then shifted = 1 ; tmpLen -= 1. ! '<251>'
    end
  end

! ---- rewrite llStart's leading indent to targetLen spaces, preserving the leading part ----
SetIndentR routine
  data
plen long,auto
  code
  if targetLen < 0 then targetLen = 0.
  if targetLen > 256 then targetLen = 256.
  if tmpLen = targetLen and ~hadTab then exit.             ! already correct (all-space, right length)
  plen = tmpLeadLen
  if plen < 0 then plen = 0.
  sbNew.free()                                             ! no fixed buffer - a leading comment of ANY length survives
  if plen > 0 then sbNew.setValue(sbCap.sub(1, plen)).     ! keep the whole leading comment/continuation part
  indentLen = targetLen + shifted
  if indentLen > 0 then sbNew.append(all(' ', indentLen)). ! then the normalised indent (plus the space a .txa shift lent)
  self.tk.SetStrBefore(llStart, sbNew.getValue())          ! '' when both parts are empty - correct
  changes += 1
  if changes <= 500
    pLog.append('BUILTIN Reindent line ' & self.LogLineOf(llStart) & ': ' & tmpLen & ' -> ' & targetLen & ' space(s)<13,10>')
  end

! ====================================================================================
! BUILTIN AutoCheck - ,AUTO safety by definite-assignment analysis.
! Full design + correctness rationale: AutoCheck-spec.md - which is NOT SHIPPED, so
! everything a reader needs is written out here and at the walk below. Safety invariant:
!   * a wrong ADD injects a read-of-uninitialised-memory bug -> SAFE must be PROVEN.
!   * a wrong REMOVE is NOT harmless. Restoring zero-init keeps the program correct, but it
!     edits a declaration the author wrote deliberately, pays the zero-init the ,AUTO was there
!     to avoid, and writes a note into their source asserting a read that was never observed.
!     So REMOVE requires POSITIVE EVIDENCE of a read before a write. Absence of evidence of a
!     WRITE is ac:unknown - touch nothing - and never ac:unsafe. Uncertainty means UNKNOWN in
!     both directions: no ADD, and no REMOVE either.
! WHAT IT RESTS ON: the tokenizer's per-token `level` marks (+ = if/case/loop open,
!     - = end/'.', / = else/elsif). A tokenizer defect that mis-levels a structure
!     arrives here as a wrong verdict, so the level census is this builtin's early
!     warning as much as the tokenizer's. TestData\autoCheck*.clw is the acceptance gate.
!     AutoCheck ships UNGROUPED and ON by default, and the tool's own sources go through
!     it on every gate - one wrong ADD would leave an uninitialised variable inside the
!     tool doing the transforming.
! ====================================================================================
VitEngine.BuiltinAutoCheck Procedure(StringTheory pLog)
doAdd    byte,AUTO
doRem    byte,AUTO
doSafe   byte,auto               ! SAFE param = remove-only (opt OUT of ADD)
doWhy    byte                    ! WHY param = report why each candidate was NOT given ,AUTO
whyN     long                    ! WHY lines emitted (capped)
whyTxt   string(200)             ! the reason for the current symbol
noteSt   StringTheory
wasSt    StringTheory            ! a number's initial value as it was written, for the note when it goes
raw      StringTheory
s        long,auto
verdict  long,auto
changes  long
ok       byte,auto
scpNm    string(vs:maxName),auto ! enclosing proc/method/routine name, for drift-proof audit logs
WorkQ  QUEUE,PRE(wq)
declT    long
act      byte                    ! 1 = ADD, 2 = REMOVE
nm       string(vs:maxName)
scp      string(vs:maxName)      ! owning scope name
why      long                    ! diag: acWhyLine at verdict time
whyT     string(900)             ! diag: conviction state + ledger
       END
  code
  self.lmProcS = -1
  if self.syms &= NULL then return 0.
  self.acScopeId = 0                                 ! token stream/symbols may have changed since the last pass

  doSafe = 0
  noteSt.setValue('no AUTO: may be read before it is set')
  if not self.rl.rules.bparmQ &= NULL
    loop s = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, s)
      case upper(self.rl.rules.bparmQ.name)
      of 'SAFE' ; doSafe = 1
      of 'WHY'  ; doWhy = 1                          ! opt-in diagnostic - answer 'why did X NOT get ,AUTO'
      of 'NOTE'
        if not self.rl.rules.bparmQ.value &= NULL
          raw.setValue(self.rl.rules.bparmQ.value)
          raw.unquote('''','''')
          noteSt.setValue(raw)
        end
      end
    end
  end
  ! Only two modes: DEFAULT = ALL transformations (ADD + REMOVE); SAFE = remove-only
  ! (the zero-risk direction - a REMOVE only ever restores zero-init).
  doRem = 1
  doAdd = choose(~(doSafe = 1))

  ! ---- pass 1: classify every eligible local, collect the edits (no token edits yet) ----
  free(WorkQ)
  loop s = 1 to records(self.syms.syms)
    get(self.syms.syms, s)
    if errorcode() then break.
    if ~self.AutoEligible(s)
      if doWhy
        whyTxt = self.acWhyElig                            ! set at every refusal inside AutoEligible
        if whyTxt then do WhyLog.                          ! blank = the row-GET failed, nothing to report
      end
      cycle
    end
    verdict = self.AutoVerdict(s)
    scpNm = ''
    get(self.syms.scopes, self.syms.syms.scopeId)          ! capture the owning scope name for the log
    if ~errorcode()
      get(self.tk.tokens, self.syms.scopes.startTok)       ! scope startTok = the proc/method/routine header label = its name
      if ~errorcode() and not self.tk.tokens.tok &= NULL then scpNm = self.tk.tokens.tok.
    end
    if verdict = ac:safe and doAdd
      if self.DeclHasInitValue(self.syms.syms.declTok) = 2 ! a STRING('abc') - the literal is its length too
        if doWhy then whyTxt = 'its initial value is a literal that also sets its length' ; do WhyLog.
      elsif ~self.DeclHasAttr(self.syms.syms.declTok, 'AUTO')
        clear(WorkQ) ; wq:declT = self.syms.syms.declTok ; wq:act = 1 ; wq:nm = self.syms.syms.nameU ; wq:scp = scpNm ; add(WorkQ)
      elsif doWhy
        whyTxt = 'it already carries ,AUTO' ; do WhyLog
      end
    elsif verdict = ac:unsafe and doRem
      if self.DeclHasAttr(self.syms.syms.declTok, 'AUTO')
        clear(WorkQ) ; wq:declT = self.syms.syms.declTok ; wq:act = 2 ; wq:nm = self.syms.syms.nameU ; wq:scp = scpNm ; wq:why = self.acWhyLine ; wq:whyT = self.acWhyTxt ; add(WorkQ)
      elsif doWhy
        whyTxt = 'read before it is written (line ' & self.acWhyLine & ') - ,AUTO would be a bug here' ; do WhyLog
      end
    elsif doWhy                                            ! WHY: eligible, walked, but not proven safe
      if verdict = ac:safe
        whyTxt = 'proven safe, but ADD is off (the SAFE parameter)'
      elsif self.acBail
        whyTxt = 'the walk bailed on this scope - GOTO, COMPILE or OMIT present, or no CODE'
      else
        whyTxt = 'the walk could not prove it either way (line ' & self.acWhyLine & ' ' & clip(self.acWhyTxt) & ')'
      end
      do WhyLog
    end
  end
  if ~records(WorkQ) then return 0.

  ! ---- pass 2: apply DESCENDING by declTok so a REMOVE's DeleteToks/insert never
  !      shifts a not-yet-applied lower declTok (ADD is position-stable, but sort anyway) ----
  sort(WorkQ, -wq:declT)
  loop s = 1 to records(WorkQ)
    get(WorkQ, s)
    if wq:act = 1
      ! AUTO MEANS NO INITIAL VALUE (ruled 17 Oct 2026). The walk proved the variable is set before it
      !   is read, so a starting value it was declared with is never used: it goes, and a note says
      !   what it was. The value is taken out first; AddAutoAttr then finds the declaration's end.
      wasSt.free()
      if self.DeclHasInitValue(wq:declT) = 1 then self.DropInitValue(wq:declT, wasSt).
      ok = self.AddAutoAttr(wq:declT)
      if ok and noteSt._DataEnd then do DropOwnNote.
      if ok and wasSt._DataEnd
        self.tk.InsertStringAtEOL(wq:declT + 1, 'AutoCheck: was ' & wasSt.getValue() & ' - set before it is read, so that starting value is never used', 1)
      end
    else
      ok = self.RemoveAutoAttr(wq:declT, noteSt)
    end
    if ok
      changes += 1
      if wq:act = 1
        pLog.append('BUILTIN AutoCheck ADD ,AUTO: ' & clip(wq:scp) & '.' & clip(wq:nm) & ' line ' & self.LogLineOf(wq:declT) & '<13,10>') ! proc.var (drift-proof anchor; line# is post-transform)
      else
        pLog.append('BUILTIN AutoCheck REMOVE ,AUTO (read before write): ' & clip(wq:scp) & '.' & clip(wq:nm) |
           & ' line ' & self.LogLineOf(wq:declT) & ' (trigger line ' & wq:why & ' ' & clip(wq:whyT) & ')<13,10>') ! proc.var (drift-proof anchor); diag: trigger + state
      end
    end
  end
  if changes
    self.wantReparse = true                                ! decl attributes changed; re-tokenise + resymbol so later passes see them and merged tokens split
    pLog.append('BUILTIN AutoCheck: ' & changes & ' change(s) this pass<13,10>')
  end
  return changes

! one WHY line for a declaration that did NOT get ,AUTO. Opt-in via
! BUILTIN AutoCheck, WHY - silent otherwise, because this fires for every declaration
! the builtin looks at. The symbol row is re-fetched: an AutoEligible refusal can
! return with the syms buffer parked on a sibling row (the OVER scan).
WhyLog routine
  data
wsc  long,auto
wnm  string(vs:maxName),auto
wscp string(vs:maxName),auto
wdcl long,auto
  code
  whyN += 1
  if whyN = 501
    pLog.append('BUILTIN AutoCheck WHY: further lines suppressed (500 shown)<13,10>')
  end
  if whyN > 500 then exit.
  get(self.syms.syms, s)
  if errorcode() then exit.
  wnm  = self.syms.syms.nameU
  wdcl = self.syms.syms.declTok
  wsc  = self.syms.syms.scopeId
  wscp = ''
  get(self.syms.scopes, wsc)
  if ~errorcode()
    get(self.tk.tokens, self.syms.scopes.startTok) ! scope startTok = the proc/method/routine header label
    if ~errorcode() and not self.tk.tokens.tok &= NULL then wscp = self.tk.tokens.tok.
  end
  pLog.append('BUILTIN AutoCheck WHY no ,AUTO: ' & clip(wscp) & '.' & clip(wnm) & ' line ' & self.LogLineOf(wdcl) & ' - ' & clip(whyTxt) & '<13,10>')

! A declaration that is given ,AUTO can still carry this builtin's own note from an earlier
! pass or run, when the variable was read before it was set: another local losing ,AUTO since
! can make the variable provably set first. The note goes, or it would say the opposite of the
! line it is on. Only the note's own text is taken; a comment of the user's on the line stays.
DropOwnNote routine
  data
dnEol long,auto
dnTx  StringTheory
  code
  dnEol = self.FirstEolAfter(self.DeclLastTok(wq:declT))
  if ~dnEol then exit.
  get(self.tk.tokens, dnEol)
  if errorcode() or self.tk.tokens.strBefore &= NULL then exit.
  dnTx.setValue(self.tk.tokens.strBefore)
  if ~dnTx.findChars('! ' & noteSt.getValue()) then exit.
  dnTx.replace('! ' & noteSt.getValue(), '', 1)
  dnTx.clip()
  self.tk.SetStrBefore(dnEol, dnTx.getValue())

! ------------------------------------------------------------------------------------
! Eligible = a simple scalar LOCAL worth analysing. Anything else -> not our business.
! ------------------------------------------------------------------------------------
VitEngine.AutoEligible Procedure(LONG pSymRow, LONG pPersistOk=0)
r        long,auto
declTok  long,auto
attMask  long,auto
nameU    string(vs:maxName),AUTO
  code
  self.acWhyElig = ''                                                                   ! WHY: set at every refusal below
  get(self.syms.syms, pSymRow)
  if errorcode() then return 0.
  if self.syms.syms.isRef  then self.acWhyElig = 'reference (&) declaration - AUTO n/a' ; return 0.
  if self.syms.syms.isLike then self.acWhyElig = 'LIKE declaration - structure/aliased' ; return 0.
  if self.syms.syms.isField then self.acWhyElig = 'structure field - AUTO applies to locals only' ; return 0.
  ! ,AUTO grants uninitialised STACK memory - module-level
  ! data (PROGRAM global / MEMBER module sections, scope kind vs:scModule) is STATIC
  ! storage read/written across procedures, so neither AutoCheck's definite-assignment
  ! walk nor DeadStores' liveness holds there (the walk cannot see the other procs).
  ! AutoEligible is the shared gate, so this one guard covers BOTH builtins. Locals only.
  get(self.syms.scopes, self.syms.syms.scopeId)                                         ! positional: scopeId = row (AddScope appends)
  if errorcode() then self.acWhyElig = 'scope not found' ; return 0.
  if self.syms.scopes.kind = vs:scModule then self.acWhyElig = 'module-scope data - static storage, not a stack local' ; return 0.
  ! The .txa embed rule, STRICT: on a .txa only a scope contained wholly
  ! inside ONE embed is decidable - the template's generated code can read or write
  ! anything in a scope that spans embed points, so neither definite-assignment nor
  ! liveness holds there. AutoEligible is the shared gate, so this one test covers
  ! BOTH AutoCheck and UnusedAssignments; UnusedVars carries its own copy.
  if self.isTxa
    if ~self.ScopeFullyEmbedded(self.syms.scopes.startTok, self.syms.scopes.endTok)
      self.acWhyElig = 'on a .txa its procedure/routine spans embed points - generated code between them is not visible here'
      return 0
    end
  end
  nameU   = self.syms.syms.nameU
  declTok = self.syms.syms.declTok
  if nameU = 'SELF' then self.acWhyElig = 'the synthetic SELF receiver' ; return 0.
  if ~self.syms.IsColOneLabel(declTok) then self.acWhyElig = 'parameter or non-declaration - not a column-1 label' ; return 0.
  ! scalar keyword only (no GROUP/QUEUE/RECORD/FILE/VIEW/WINDOW/CLASS/named-type)
  case upper(self.syms.syms.typeU)
  of   'LONG' orof 'ULONG' orof 'SHORT'   orof 'USHORT'   orof 'BYTE'    orof 'SIGNED'  orof 'UNSIGNED' |
  orof 'REAL' orof 'SREAL' orof 'DECIMAL' orof 'PDECIMAL' orof 'BFLOAT4' orof 'BFLOAT8'                 |
  orof 'DATE' orof 'TIME'  orof 'STRING'  orof 'CSTRING'  orof 'PSTRING'
    ! scalar - ok
  else
    self.acWhyElig = 'not a scalar type - it is ' & self.syms.syms.typeU
    return 0
  end
  ! OVER = shared storage; DIM = array; STATIC and THREAD persist across calls, so ',AUTO'
  ! is wrong on all four. ONE decl-line walk (DeclAttrBits) instead of four.
  ! *** PERSISTENT STORAGE IS ONLY WRONG FOR ,AUTO. *** This gate is shared and the two
  ! builtins ask different questions of it. ,AUTO grants uninitialised STACK memory, so
  ! anything with persistent storage is ruled out. "Is this variable ever READ?" does not care
  ! where the storage lives: a procedure-local is visible only inside that procedure, so a scan
  ! of the procedure is a COMPLETE usage test, and a variable nothing reads is unused whether
  ! or not its value survives the return.
  !
  ! THREAD IS INCLUDED WITH STATIC, AND FOR EXACTLY THE SAME REASON: an unused static local
  ! can be commented out like any other unused variable, because its limited scope makes the
  ! usage test complete, and `,STATIC,THREAD` is a common spelling. THREAD alters WHERE the
  ! storage lives (one instance per thread), never WHO CAN SEE THE NAME, and visibility is
  ! the whole basis of the test. UnusedVars comments an unused local carrying either
  ! attribute - it refuses only EXPORT/EXTERNAL/DLL and .txa embeds - and the two halves of
  ! the cascade must agree.
  !
  ! What does NOT follow, and is deliberately kept: the SCOPE-END dead-store case stays off for
  ! both, because a persistent local's LAST store may be read on the next call. That is
  ! `allowEnd` at the caller. The caller says which question it is asking.
  attMask = ab:over + ab:dim
  if ~pPersistOk then attMask += ab:static + ab:thread.
  if band(self.DeclAttrBits(declTok), attMask)
    self.acWhyElig = 'declared ' & choose(pPersistOk = 0, 'OVER, DIM, STATIC or THREAD', 'OVER or DIM')
    return 0
  end
  ! THIS IS A BACKSTOP, NOT A CONTINUATION REFUSAL. DeclLastTok walks to the LOGICAL end of
  ! the statement, so a continued declaration is read whole: a benign continuation earns
  ! ',AUTO' after the logical last token, a ',STATIC' past a '|' is refused on its own merits,
  ! and an existing ',AUTO' past a '|' is not doubled. So on a well-formed declaration this
  ! arm does not fire. IT STAYS ANYWAY: what follows DeclLastTok is an EOL or the end of file
  ! on any statement this tool can parse, and if it is something else then the walk did NOT
  ! find the end of the declaration - and the next thing that happens is AddAutoAttr merging
  ! ',AUTO' into text it has misread. Refusing is the conservative answer on input we have
  ! failed to understand. Pinned by autocont-test.txt / TestData\r224auto.clw.
  r = self.DeclLastTok(declTok) + 1
  get(self.tk.tokens, r)
  if ~errorcode()
    if self.tk.tokens.tok &= NULL
      ! trailing strBefore-only token = EOF after the decl - fine
    elsif size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>'
      ! genuine EOL - fine
    else
      self.acWhyElig = 'declaration continued with a vertical bar - attributes may hide on line 2'
      return 0
    end
  end
  ! Another local declared OVER(V) aliases V's storage - a read through the alias sees
  ! garbage after an ADD. V's own decl was checked above; the SIBLING decls are HasSiblingOver's
  ! question, asked here and by KnownRanges' KrLocalOk from the one place so the two cannot
  ! drift. The scope-bounded walk lives there:
  ! syms is sorted on (+scopeId, +nameU), so a scope's rows are CONTIGUOUS and it walks OUT
  ! from the candidate rather than scanning the file - a large file holds thousands of
  ! symbols, and BUILTIN AutoCheck is ungrouped, so it runs on every pass of every file.
  if self.HasSiblingOver(pSymRow, nameU) then self.acWhyElig = 'a sibling declaration OVERs this one - shared storage' ; return 0.
  get(self.syms.syms, pSymRow)                                                          ! restore the candidate's buffer
  ! routine-touched -> UNKNOWN: a routine can run before the main-code write, in any order
  self.AutoScopePrep(self.syms.syms.scopeId)                                            ! the scope's routine list is cached
  loop r = 1 to records(self.acRoutQ)
    get(self.acRoutQ, r)
    if self.NameRefdInRange(nameU, self.acRoutQ.rStart, self.acRoutQ.rEnd) then self.acWhyElig = 'referenced inside a ROUTINE - a routine can run before the main-code write' ; return 0.
  end
  ! a MERGED dotted token rooted at this name anywhere in the scope hides a
  ! read/write from every whole-token scan (the UnusedVars disease). Neither
  ! AutoCheck's definite-assignment walk nor DeadStores' liveness can classify a
  ! hidden ref -> the symbol is simply NOT ELIGIBLE for AUTO/dead-store surgery.
  ! (AutoEligible is the shared gate: this one guard covers BOTH builtins.)
  ! On VALID code this is a no-op while eligibility is scalars-only, since a
  ! spaceless scalar.name never compiles - belt-and-braces for non-compiling input.
  ! Keyed lookup in the per-scope roots cache, which AutoScopePrep builds once per scope.
  clear(self.acDotQ)
  self.acDotQ.rootU = nameU
  get(self.acDotQ, self.acDotQ.rootU)
  if ~errorcode() then self.acWhyElig = 'a merged dotted token is rooted at this name - hidden reference' ; return 0.
  get(self.syms.syms, pSymRow)
  if errorcode() then return 0.
  r = self.syms.syms.scopeId
  get(self.syms.scopes, r)
  if errorcode() then return 0.
  if self.MayHaveLocalMethods(r)
    if self.UsedInLocalMethods(nameU, self.syms.scopes.startTok, self.syms.scopes.endTok)
      self.acWhyElig = 'used in a method of a class its procedure declares - those methods share its local data'
      return 0
    end
  end
  get(self.syms.syms, pSymRow)                                                          ! the walk above moved both buffers: put them back
  get(self.syms.scopes, r)                                                              !   where the caller left them
  ! READ WHERE THE SCANS CANNOT SEE: a control's USE(), a FILE's NAME(), an INCLUDE, an escaped
  ! address. Every caller of this gate decides from what the code says, so any of these makes
  ! its answer wrong - "never read" and "set before it is read" alike.
  case self.UnseenRead(nameU)
  of 1
    self.acWhyElig = 'named in another declaration of its procedure - a control''s USE() or a file''s NAME() reads it'
    return 0
  of 2
    self.acWhyElig = 'its procedure INCLUDEs a file, whose text this file does not show'
    return 0
  of 3
    self.acWhyElig = 'its storage escapes - &=, ADDRESS() or BIND - and can be read under another name'
    return 0
  end
  get(self.syms.syms, pSymRow)
  get(self.syms.scopes, r)
  return 1

! ------------------------------------------------------------------------------------
! Is this local read somewhere the code scans cannot see? The scans that decide "never read"
! and "set before it is read" walk the CODE. A local can be read without its name appearing
! there, and then both answers are wrong:
!   1  named in ANOTHER declaration of its procedure - a WINDOW or REPORT control's USE(v),
!      which DISPLAY, ACCEPT and PRINT read; a FILE's NAME(v), which OPEN reads;
!   2  the scope INCLUDEs a file - in its data, its code, or a method of a class its
!      procedure declares - and the included text is not in this stream (ScopeIncludes);
!   3  its storage escapes in the code - `x &= v`, ADDRESS(v), or v handed to BIND - after
!      which anything can read it under another name.
! Returns the reason, 0 for none. The answers are collected once per scope, by AutoScopePrep,
! which every caller of AutoEligible has run for the candidate's scope.
! ------------------------------------------------------------------------------------
VitEngine.UnseenRead Procedure(STRING pNameU)
  code
  if self.urData.findChars(' ' & clip(upper(pNameU)) & ' ') then return 1.
  if self.urInc then return 2.
  if self.urEsc.findChars(' ' & clip(upper(pNameU)) & ' ') then return 3.
  return 0

! ------------------------------------------------------------------------------------
! The definite-assignment walk. Returns ac:safe / ac:unsafe / ac:unknown for the local
! in row pSymRow. SAFE = no path reads it before writing it, and it is written at least
! once (whole-variable, clean). Handles straight-line code, IF/ELSIF/ELSE and LOOP
! precisely - a loop body is walked as straight-line code, and the assignment state is
! restored at the loop's END, since it may run zero times; CASE, EXECUTE, BEGIN and
! anything unrecognised bail to UNKNOWN the moment the var is touched inside them while
! still unassigned. AutoCheck-spec.md holds the state machine but is not shipped; the frame
! model is described at the CASE below, which is the part that has to be got right.
! ------------------------------------------------------------------------------------
VitEngine.AutoVerdict Procedure(LONG pSymRow)
mainEnd   long,auto
codeT     long,auto
i         long,auto
j         long,auto
nU        string(vs:maxName),AUTO
txt       string(vs:maxName),auto
tU        string(vs:maxName),auto
ty        string(1),auto
lvl       string(1),auto
fol       byte,auto
prevU     string(vs:maxName),auto
nextU     string(vs:maxName),auto
stmtKw    string(vs:maxName) ! leading keyword of the current statement (robust block-kind detection)
curAsg    byte,auto          ! V definitely assigned on the current straight-line path
lastExit  byte,auto          ! the last line begun was a RETURN - a branch ending in one never reaches the join (14 Sep 2026)
brOk      byte,auto          !   so at a fold at ELSE / END it counts as assigned, as a written branch does
sawWrite  byte,auto
lastWLn   long               ! diag: line of the last write-credit for this symbol
lastPopLn long               ! diag: line of the most recent frame POP
lastPopTx string(12)         ! diag: token text that caused it
contLn    byte,auto          ! current reference token starts a '|' continuation line
selfRead  byte,auto          ! audit: RHS self-reference scan verdict for one name hit
ctlOurs   byte               ! this LOOP's control variable IS the symbol being walked
lcJ       long,auto          ! scan of the rest of a LOOP header
lcSeen    byte               ! the counter is READ in its own header
danger    long,auto          ! open CASE / EXECUTE / unrecognised frames (NOT LOOP); touch here while unassigned -> UNKNOWN
exitCount long               ! BREAK / GOTO seen so far, at any depth - see the bare-LOOP credit
vScope    long               ! V's scope, captured before FindSym moves the syms buffer
inZG      byte,auto          ! this reference sits inside an IF whose guard IMPLIES V was written
zgJ       long,auto          ! scans of the condition, of the guard's writes, and back for V's
zgK       long,auto
zgHits    long,auto          ! identifiers in the condition
zgRow     long,auto          ! the guard's syms row
zgDeclT   long,auto          ! and its declaration token
zgOK      byte,auto          ! the guard survived every test
zgDepth   long,auto          ! block depth while scanning back for V's write
zgFound   byte,auto          ! a dominating write to V was found
zgWrites  long,auto          ! writes to the guard seen - none at all is NOT a pass
zgNm      string(vs:maxName) ! the guard's name
zgRead    byte,auto          ! ZeroGuardRead: the guard's occurrence in hand only reads it
dbgOn     byte,auto          ! this line runs in DEBUG builds only - a '?' alone began it
dbgAsg    byte               ! curAsg as that line began: what the line writes does not outlive it
dbgHd     byte,auto          ! the reference stands right after that '?', so it begins the statement
ptOn      byte,auto          ! reading the condition of a post-test UNTIL / WHILE (2 = on its word)
ptBody    byte               ! curAsg where the loop body ended - the condition runs only after it
ptAfter   byte               ! curAsg after the loop, put back where the condition ends
FrameQ QUEUE,PRE(fr)
kind     byte                ! 1=IF, 2=LOOP, 3=bail-context
entryAsg byte
allBr    byte
hasElse  byte
dng      byte                ! this frame incremented `danger`
bare     byte                ! kind 2 only: a BARE `loop` - no counter, no WHILE, no UNTIL, no TIMES. Its body
                             !   ALWAYS runs at least once, so a write at the top of it is not conditional
bodyAsg  byte                ! a write to V was seen at THIS frame's own level before any exit from it
exitAt   long                ! exitCount when this frame opened - equal still means no exit has been seen in it
zeroG    byte                ! kind 1 only: this IF's condition IMPLIES V has been written - see ZeroGuardChk
       END
  code
  get(self.syms.syms, pSymRow)
  if errorcode() then return ac:unknown.
  nU = self.syms.syms.nameU
  ! main-code bounds, CODE token, and the GOTO / COMPILE-OMIT pre-scan are
  ! per-SCOPE facts - AutoScopePrep computes them once per scope instead of once per symbol.
  vScope = self.syms.syms.scopeId                                           ! FindSym moves the syms buffer, so keep V's scope
  self.AutoScopePrep(self.syms.syms.scopeId)
  if self.acBail then return ac:unknown.                                    ! missing scope / no CODE / GOTO / COMPILE / OMIT present
  codeT   = self.acCodeT
  mainEnd = self.acMainEnd

  free(FrameQ)
  curAsg = 0 ; sawWrite = 0 ; danger = 0 ; lastExit = 0
  exitCount = 0
  dbgOn = 0 ; ptOn = 0
  self.acWhyLine = 0 ; self.acWhyTxt = ''                                   ! diag
  loop i = codeT + 1 to mainEnd                                             ! start AFTER the CODE token
    get(self.tk.tokens, i)
    if errorcode() then break.
    lvl = self.tk.tokens.level
    fol = self.tk.tokens.firstOnLine
    ty  = self.tk.tokens.type
    if self.tk.tokens.tok &= NULL
      txt = ''
    else
      txt = self.tk.tokens.tok
    end
    tU = upper(txt)
    ! A LINE THAT RUNS IN DEBUG BUILDS ONLY. The LRM gives a '?' alone in column one as "execute the
    ! statement that follows in DEBUG mode only", so the line is a block with no ELSE that one build
    ! runs and the other does not. A READ on it is judged as any read is - a debug build makes it -
    ! but nothing it WRITES may count once the line is over: curAsg goes back to what it was as the
    ! line began, and the bare-loop credit is not given there (LoopBodyAsg). The name after the
    ! marker begins its statement, so `? v = 0` is a write, not a read (BeginsStmt does not know
    ! the marker).
    ! THE CONDITION OF A POST-TEST UNTIL OR WHILE runs only when the body has run to its end - a
    ! BREAK leaves without it, and a CYCLE goes back to the top without it (measured 28 Oct 2026) -
    ! so it is judged with curAsg as the body left it, and the state after the loop is put back
    ! where the condition ends. The LOOP frame pops at that UNTIL / WHILE, which carries the '-'.
    if ptOn and (tU = '<10>' or tU = ';')
      curAsg = ptAfter ; ptOn = 0
    end
    if dbgOn and tU = '<10>'
      curAsg = dbgAsg ; dbgOn = 0
    end
    if fol and tU = '?'
      dbgOn = 1 ; dbgAsg = curAsg
    end
    ! COUNT anything that can leave a loop body before a later write. A plain counter, compared
    ! against the value a frame recorded when it opened, answers "has an exit been seen anywhere
    ! inside this frame" without touching FrameQ - and touching FrameQ here is what must not
    ! happen: the buffer is shared with the opener that is still being built a few lines below.
    ! It has to count exits at ANY depth, not just the frame's own level:
    ! `loop / if pFlag then break. / b = 1 / end` puts the BREAK inside the IF frame, and the
    ! write that follows is back at the LOOP's own level, so a per-frame mark on the innermost
    ! frame alone left the loop looking exit-free and credited a write the break can skip. That
    ! is a WRONG ADD, the one direction this must never go; BareLoopBreakFirst pins it.
    ! ONLY A BREAK OR A GOTO can reach the code after a bare loop without passing a write at the loop's
    ! own level. A RETURN before the write leaves the procedure, so nothing after the loop runs on that
    ! path; a CYCLE goes back to the top of the loop, and the only way out is still a BREAK, which has to
    ! pass the write first. Counting them as exits took a correct ,AUTO off the transpiler's Lexer
    ! (`if i > len then return ''.` above `ch = ...`), found 19 Oct 2026; p4_acloop pins both ways.
    case tU
    of 'BREAK' orof 'GOTO'
      exitCount += 1
    end
    if fol and txt then stmtKw = tU.                                        ! the first token of the line. IF/LOOP/CASE/ELSE/END are RESERVED words (vt:reservedWord), NOT labels,
                                                                            !   so a gate on ty='b' would miss every one of them. A frame is classified by the word that opens it, not
                                                                            !   by this - except on a line a '?' began, where this is the '?' and the frame is the bail-context.

    ! ---------- block structure via level marks ----------
    ! A FRAME TAKES ITS KIND FROM THE TOKEN THAT OPENS IT, not from the word that begins the line.
    ! In `loop i = 1 to 3 ; if i = 2 then v = 1 else message(v).` the second opener is an IF, and its
    ! ELSE must start that arm from the state at the IF; read as a LOOP, the write in the THEN arm
    ! would count for the read in the ELSE arm and v would earn ,AUTO over storage nothing had set.
    ! The same holds for an opener after a ';', a THEN, an ELSE or a label: a CASE or EXECUTE there
    ! raises danger, a LOOP there gets its counter credit. A frame opened on a line a '?' began is the
    ! bail-context, as an unrecognised opener is: what the marker covers past its own line is not known.
    if lvl = '+'                                                            ! block opener (if/case/loop/execute/...)
      clear(FrameQ)
      fr:entryAsg = curAsg ; fr:allBr = 1 ; fr:hasElse = 0 ; fr:dng = 0
      fr:bare = 0 ; fr:bodyAsg = 0 ; fr:exitAt = exitCount
      case choose(~dbgOn, tU, stmtKw)                                       ! the OPENER's own word; on a '?' line the line's first word, the '?', which no arm names
      of 'IF'
        fr:kind = 1
        if tU = 'IF' then do ZeroGuardChk.                                  ! gate on the OPENER's own text, as the LOOP arm below does
      of 'LOOP'
        fr:kind = 2
        ! CREDIT THE LOOP COUNTER HERE, before the entered-unassigned test. The counted
        ! LOOP form assigns its control variable ON ENTRY - the counter is set to the
        ! start value before the first limit test, so it is written even when the body
        ! runs zero times, and it survives the loop holding limit+step. Without this
        ! credit the counter's own LOOP raises `danger`, the very next token - the
        ! counter itself - returns ac:unknown, and the commonest local in Clarion, the
        ! loop index, can never be ,AUTO.
        ! The credit needs the cursor ON the LOOP token, and it is: the frame is classified
        ! by the opener's own word, so on a compressed line (`loop x = 1 to n ; if v = 1
        ! then break..`) the IF's frame never reaches this arm, and LoopCtlChk cannot read
        ! `v` `=` after that IF as a counter write - crediting a READ as a definite write,
        ! the inversion that licenses a wrong ADD (,AUTO over a zero-init the comparison
        ! relied on). A LOOP opened after a THEN (`if c then loop x = 1 to n.`) gets its
        ! credit here as well. AutoR43m pins both halves: the IF's read stays a read, and
        ! the real counter on the same line keeps its credit.
        if tU = 'LOOP'
          do LoopBareChk                                                    ! before LoopCtlChk, which moves the buffer
          do LoopCtlChk
          if ctlOurs
            sawWrite = 1 ; curAsg = 1 ; lastWLn = self.LineOfTok(i)
            fr:entryAsg = 1                                                 ! and still assigned after the frame pops
          end
        end
        ! The shape to keep in mind is `loop` / `p = st.findChar(...)` / reads of p below
        ! it: a LOOP frame does NOT raise `danger`. Raising it would mean "V is
        ! unassigned at loop entry, so any touch inside is ambiguous" - which convicts
        ! the commonest shape in Clarion, a variable WRITTEN at the top of a loop body
        ! and read further down the same body. The frame model already handles the real
        ! risk without it: a loop body is straight-line code, so a write credits curAsg
        ! for the reads below it, a read ABOVE the write is still convicted on the first
        ! iteration, and the kind-2 pop restores curAsg = fr:entryAsg - so relying on a
        ! loop-body write AFTER the loop is convicted exactly as before (the loop may run
        ! zero times). CASE/EXECUTE keep their danger: their branches are alternatives,
        ! not straight-line code, so a write in one branch must never credit the others.
        ! NB this makes the LoopCtlChk credit above LOAD-BEARING: without it the counted
        ! header token `i` in `loop i = 1 to n` would read as a read-before-write and
        ! REMOVE ,AUTO. The two halves ship together.
      of 'CASE' orof 'EXECUTE' orof 'BEGIN'
        fr:kind = 3 ; fr:dng = 1 ; danger += 1
      else
        fr:kind = 3 ; fr:dng = 1 ; danger += 1                              ! unrecognised opener -> bail-context
      end
      add(FrameQ)
      curAsg = fr:entryAsg                                                  ! first branch body starts at entry state
    elsif lvl = '/'                                                         ! else / elsif  (IF branch separator)
      if records(FrameQ)
        get(FrameQ, records(FrameQ))
        if fr:kind = 1
          brOk = choose(curAsg = 1 or lastExit = 1)
          fr:allBr = choose(fr:allBr = 1 and brOk = 1)                      ! fold the just-finished branch
          if tU = 'ELSE' then fr:hasElse = 1 .                              ! full else (not elsif) - the no-branch path is covered. Use the '/'-token's OWN text: stmtKw is the LINE-leading keyword,
                                                                            !   still 'IF' on a one-liner, so an INLINE else never set hasElse and the join could not fire (AutoR41a caught it)
          fr:zeroG = 0                                                      ! a zero guard holds only in the THEN arm: the arms after it run when it is 0
          put(FrameQ)
          curAsg = fr:entryAsg                                              ! new branch body starts at entry state
        end
      end
    elsif lvl = '-' or (ty = vt:end and lvl <> '+' and lvl <> '/')          ! end / '.' - audit: an INLINE '.' terminator is retyped vt:end but may carry NO '-' level (the level pass skips
                                                                            !   inline dots); without this the one-liner if/then/else frame never closed, blocking the all-branches-wrote join
      lastPopLn = self.tk.tokens.lineNo ; lastPopTx = txt                   ! diag
      if ~records(FrameQ) then return ac:unknown.                           ! level underflow -> don't trust the walk
      get(FrameQ, records(FrameQ))
      if fr:dng then danger -= 1.
      if fr:kind = 2 and (tU = 'UNTIL' or tU = 'WHILE')
        ptOn = 2 ; ptBody = curAsg
      end
      if fr:kind = 1
        brOk = choose(curAsg = 1 or lastExit = 1)
        fr:allBr = choose(fr:allBr = 1 and brOk = 1)                        ! fold final branch
        if fr:entryAsg = 1 or (fr:hasElse = 1 and fr:allBr = 1)
          curAsg = 1                                                        ! every path through the IF assigns V
        else
          curAsg = fr:entryAsg
        end
      elsif fr:kind = 2 and fr:bare = 1 and fr:bodyAsg = 1
        ! A BARE `loop` CANNOT RUN ZERO TIMES. `loop` with no control clause repeats until a
        ! BREAK or a RETURN takes it out, so its body ALWAYS executes at least once - and a
        ! write at the top of that body, reached before any exit, has therefore happened on
        ! every path that leaves the loop. Treating it like a counted loop is what convicted
        ! StringTheory.Instring's `x`: `x = 0` is the FIRST statement of a bare loop and the
        ! only read outside is the `return x` below it, so ,AUTO was correct and was removed
        ! with the note `no AUTO: may be read before it is set`, which was not true.
        ! bodyAsg is set ONLY for a write at the loop's OWN level with no BREAK or GOTO seen
        ! before it - a write under an IF is conditional, and a write after a `break` can be
        ! skipped on the iteration that leaves. A RETURN or a CYCLE before it cannot reach
        ! the code after the loop: see where exitCount is counted.
        curAsg = 1
      else
        curAsg = fr:entryAsg                                                ! a COUNTED or conditional LOOP may run 0 times; bail-context leaves state as entered
      end
      delete(FrameQ)
      if ptOn = 2 then ptAfter = curAsg ; curAsg = ptBody ; ptOn = 1.
    end

    ! ---------- variable reference ----------
    if ty = 'b' and tU = nU
      prevU = '' ; nextU = ''
      if i > codeT
        get(self.tk.tokens, i - 1)
        if not self.tk.tokens.tok &= NULL then prevU = upper(self.tk.tokens.tok).
      end
      if i < mainEnd
        get(self.tk.tokens, i + 1)
        if not self.tk.tokens.tok &= NULL then nextU = upper(self.tk.tokens.tok).
        ! a '.' that ENDS the statement (typed vt:end) is the END it stands for, not a member dot:
        ! in `if c then x = v.` the v is read like any other
        if nextU = '.' and self.tk.tokens.type = vt:end
          nextU = 'END'
        end
      end
      dbgHd = choose(dbgOn = 1 and prevU = '?')
      get(self.tk.tokens, i)                                                ! restore buffer to the reference token
      contLn = 0                                                            ! fol=1 is ALSO true on a '|' continuation line (CRLF lives in strBefore) - 'IF a = 1 AND |' / 'V = 2' is a COMPARISON, not a write
      if not self.tk.tokens.strBefore &= NULL
        if self.TriviaHasContinuation(self.tk.tokens.strBefore) then contLn = 1.
      end
      do ZeroGuardHere                                                      ! inside an IF whose guard implies V was written?
      if prevU = '.'                                                        ! x.V -> V is a member of x, not our local; ignore
        ! (skip)
      elsif nextU = '.' or nextU = '[' or nextU = '{{'                      ! V.field / V[i] / V{prop} -> structure use -> can't classify
        return ac:unknown
      elsif ~curAsg and inZG                                                ! THE GUARD IMPLIES THE WRITE, so this read is not a read of unwritten
        ! storage and convicts nothing. It credits nothing either - curAsg is left
        ! alone - so a LATER unguarded read is judged exactly as it was before.
      elsif danger > 0 and ~curAsg                                          ! touched inside a case / execute / unrecognised block WHILE still unassigned
        ! the bail is about reading storage that may never have been written on
        ! this path - so it only applies while the symbol is NOT yet definitely
        ! assigned. Once curAsg is 1 (assigned before the frame opened, or credited at
        ! a counted LOOP opener inside it), a read here is reading something written,
        ! and the frame pop still restores the entry state afterwards, so a read AFTER
        ! the block is convicted exactly as before. This is what lets an INNER counted
        ! loop's index earn ,AUTO under an outer loop. A WRITE while unassigned still
        ! bails: an EXECUTE/CASE branch write cannot be credited, its branch may not run.
        return ac:unknown
      elsif nextU = '=' and (self.BeginsStmt(i) or dbgHd)                   ! whole-variable assignment target: V = <expr> (also after ;/THEN/ELSE or a column-1 label, and not on a continuation line)
        ! self-reference (V = ...V...) as the FIRST touch = read of uninitialised V -> UNSAFE.
        ! Scan the RHS (i+2 .. the true end of statement). Stop on a GENUINE statement
        ! boundary (a <10> EOL token or a ';' separator), NOT firstOnLine - a '|' continuation line
        ! also sets firstOnLine but carries no <10> token (CRLF is in strBefore), so a
        ! firstOnLine break would truncate a continued RHS and miss a self-read on it. This follows
        ! the logical statement to its end (same <10>/; boundary the matcher's TokIsEOL uses).
        if ~curAsg
          j = i + 2
          loop while j <= mainEnd
            get(self.tk.tokens, j)
            if errorcode() then break.
            if self.tk.tokens.tok &= NULL then break.                       ! NULL tok = statement boundary
            if self.tk.tokens.tok = '<10>' then break.                      ! genuine EOL (a '|' continuation has none)
            if self.tk.tokens.tok = ';' then break.                         ! explicit statement separator
            case upper(self.tk.tokens.tok)
            of 'THEN' orof 'ELSE'
              break                                                         ! audit: one-line if C then V = x else V = y. - the RHS of the
            end                                                             ! then-clause ENDS at ELSE; overrunning would read the else-branch WRITE target as a self-read
            if self.tk.tokens.type = 'b' and upper(self.tk.tokens.tok) = nU
              selfRead = 1                                                  ! audit: not every name hit is a READ of our local -
              get(self.tk.tokens, j - 1)
              if ~errorcode() and not self.tk.tokens.tok &= NULL
                if self.tk.tokens.tok = '.' then selfRead = 0.              ! x.V is a MEMBER, not our local
              end
              get(self.tk.tokens, j + 1)
              if ~errorcode() and not self.tk.tokens.tok &= NULL
                if self.tk.tokens.tok = '(' then selfRead = 0.              ! V( is a CALL name, not our local
              end
              if selfRead
                self.acWhyLine = self.LineOfTok(j)                          ! diag: the RHS token read as a self-reference
                self.acWhyTxt  = 'SCAN prev=' & clip(prevU) & ' next=' & clip(nextU) & ' fol=' & fol & ' cont=' & contLn & ' dng=' & danger & ' lastW=' & lastWLn & ' frm=' & records(FrameQ)
                return ac:unsafe
              end
            end
            j += 1
          end
        end
        sawWrite = 1 ; curAsg = 1 ; lastWLn = self.LineOfTok(i)             ! diag
        do LoopBodyAsg
      elsif self.AutoOutArgWrite(i, prevU)                                  ! CLEAR(V..)/GETPOSITION(feq,V..) - a builtin writes V via an output arg
        sawWrite = 1 ; curAsg = 1 ; lastWLn = self.LineOfTok(i)             ! diag
        do LoopBodyAsg
      elsif self.AutoSizeOnly(i, prevU)                                     ! SIZE(V) - the declared size: V is neither read nor written
        ! (skip)
      else                                                                  ! any other occurrence = a READ
        if ~curAsg                                                          ! read before write on this path
          if self.AutoAddrTaken(i, prevU)                                   ! ... unless the ADDRESS was taken: the storage escaped,
            return ac:unknown                                               !     so this is not evidence of a read - it is no evidence
          end
          if self.AutoArgIsRefParam(i)                                      ! ... nor when the prototype declares that slot BY REFERENCE:
            return ac:unknown                                               !     the callee writes the caller's storage, and a write we
          end                                                               !     cannot see is not a read either
          self.acWhyLine = self.LineOfTok(i)                                ! diag: the read that convicted it
          self.acWhyTxt = 'READ prev=' & clip(prevU) & ' next=' & clip(nextU) & ' fol=' & fol & ' cont=' & contLn |
             & ' dng=' & danger & ' lastW=' & lastWLn & ' frm=' & records(FrameQ) & ' pop=' & lastPopLn & ':' & lastPopTx
          return ac:unsafe
        end
      end
    end
    if fol then lastExit = choose(tU = 'RETURN').
  end

  if records(FrameQ) then return ac:unknown.                                ! unbalanced blocks -> don't trust
  if sawWrite then return ac:safe.
  return ac:unknown                                                         ! never written (and never read-before-write) -> not our business

! is this LOOP the counted form over the symbol being walked - LOOP <nU> = ... ?
! i is the walk cursor, parked on the LOOP token (the '+' level mark lives on LOOP
! itself), so the control variable is the next CONTENT token and its
! '=' the one after. Only that exact shape counts: LOOP alone, LOOP UNTIL/WHILE, and
! LOOP n TIMES assign nothing, and a non-matching name is somebody else's counter.
! ---- DOES THIS IF'S CONDITION IMPLY THAT V HAS ALREADY BEEN WRITTEN?
!      The shape, found twice in StringTheory - RemoveByte's `dest` guarded by `removed`, and
!      Replace's `z` guarded by `charsRemoved`:
!
!          loop
!            if removed then ... dest ...      the only reads of dest are here
!            dest = addr - removed             written FIRST
!            removed += 1                      and only THEN does the guard change
!          end
!
!      THE REASONING IS AN IMPLICATION, NOT A CLAIM ABOUT LOOPS. A local declared WITHOUT ,AUTO
!      is zero-initialised, so the guard starts at 0. Every write to the guard is preceded, in
!      its own block, by a write to V. So the guard can only be non-zero once V has been written,
!      and a read of V under it is reading something written - on EVERY pass, not just the first.
!      No first-iteration peeling is involved and none is needed; an earlier attempt that tried to
!      reason about first passes instead credited all four fences at once, which is a WRONG ADD.
!
!      FIVE THINGS HAVE TO HOLD, and each is a case in TestData\autozero.clw:
!        the condition is ONE bare identifier    anything else is not a plain zero test
!        it is not V itself                      V guarding itself says nothing
!        it is a column-1 LOCAL declaration      GuardIsParam - a parameter is the caller's
!        it does NOT carry ,AUTO                 GuardIsAuto - an ,AUTO guard holds whatever the
!                                                stack held, so its entry value is unknown
!        EVERY write to it is dominated by a     GuardWrittenFirst (`g = 1` with no write above
!        write to V                              it), GuardedNeverWritten (nothing writes V at
!                                                all), GuardWriteNested (the write to V is inside
!                                                an IF, so it is conditional)
!      AND THE GUARD IS WHAT IT SEEMS: no initial value but 0, nothing that reads or sets it where
!      the code does not say, and every occurrence that is not a counted write a plain read - not a
!      LOOP header, an argument that may be written, or a use of its parts (ZeroGuardSeen,
!      ZeroGuardRead). The credit holds only in the THEN arm: an ELSE or ELSIF runs when it is 0.
ZeroGuardChk routine
  fr:zeroG = 0
  zgHits = 0 ; zgNm = ''
  loop zgJ = i + 1 to mainEnd                                                       ! the condition, to THEN or the line end
    get(self.tk.tokens, zgJ)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1
      if self.tk.tokens.tok[1] = '<10>' or self.tk.tokens.tok = ';' then break.
    end
    if upper(self.tk.tokens.tok) = 'THEN' then break.
    zgHits += 1
    if zgHits > 1 then break.                                                       ! more than one token - not a plain `if g`
    if self.tk.tokens.type <> 'b' then break.                                       ! not an identifier
    zgNm = upper(self.tk.tokens.tok)
  end
  get(self.tk.tokens, i)                                                            ! restore the buffer to the opener
  if zgHits <> 1 or ~zgNm then exit.
  if zgNm = nU then exit.                                                           ! V guarding itself says nothing
  ! THE SYMS BUFFER IS SHARED AND THE CALLER READS IT AFTER THIS WALK RETURNS - it asks
  ! DeclHasAttr(self.syms.syms.declTok, 'AUTO') to decide whether there is an attribute to take
  ! off. FindSym moves that buffer to the GUARD's row, so every question the caller asked was
  ! being answered about the guard instead of about V, and NOTHING was ever removed. So the
  ! answers are taken here, in one place, and the buffer is put back on V's row before anything
  ! can exit. Restore on EVERY path, not just the one that succeeds.
  zgOK = 0 ; zgDeclT = 0
  zgRow = self.syms.FindSym(zgNm, vScope)                                           ! moves the syms buffer; nU and vScope are captured
  if zgRow
    get(self.syms.syms, zgRow)
    if ~errorcode()
      zgDeclT = self.syms.syms.declTok
      if self.syms.IsColOneLabel(zgDeclT)                                           ! a parameter is the caller's, not zero-initialised
        if ~self.DeclHasAttr(zgDeclT, 'AUTO') and ~self.DeclHasAttr(zgDeclT, 'STATIC') and ~self.DeclHasAttr(zgDeclT, 'THREAD') and ~self.DeclHasAttr(zgDeclT, 'OVER') ! AUTO, STATIC, THREAD or OVER: not zero at the call
          if ~self.HasSiblingOver(zgRow, zgNm)                                      ! shared storage - something else can set it
            zgOK = 1
            loop zgK = 1 to records(self.acRoutQ)                                   ! HOLD THE GUARD TO V'S OWN STANDARD: AutoEligible
              get(self.acRoutQ, zgK)                                                !   refuses V when a ROUTINE touches it, because a
              if errorcode() then break.                                            !   routine can run before the main-code write. A
              if self.NameRefdInRange(zgNm, self.acRoutQ.rStart, self.acRoutQ.rEnd) ! guard set in a routine is the same hazard.
                zgOK = 0
                break
              end
            end
          end
        end
      end
    end
  end
  if zgOK then do ZeroGuardSeen.
  get(self.syms.syms, pSymRow)                                                      ! V's row, before anything else reads it
  get(self.tk.tokens, i)
  if ~zgOK then exit.
  do ZeroGuardWrites                                                                ! the dominance test needs no syms access
  if zgOK then fr:zeroG = 1.

! ---- EVERY write to the guard must be dominated by a write to V. Walks the whole body: one
!      write to the guard that is not covered sinks the guard, because that write could make it
!      non-zero with V still unwritten.
ZeroGuardWrites routine
  zgOK = 0 ; zgWrites = 0
  loop zgJ = codeT + 1 to mainEnd
    get(self.tk.tokens, zgJ)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> 'b' then cycle.
    if upper(self.tk.tokens.tok) <> zgNm then cycle.
    if ~self.AutoTokIsWrite(zgJ)                                           ! a READ of the guard changes nothing - but a
      do ZeroGuardRead                                                     !   LOOP header, an argument or a use of its
      if ~zgRead then exit.                                                !   parts may write it where no count sees
      cycle
    end
    zgWrites += 1
    do ZeroGuardDominated                                                  ! is a write to V above it, in its own block?
    if ~zgFound then exit.                                                 ! one uncovered write sinks it - zgOK stays 0
  end
  ! NO WRITES AT ALL IS NOT A PASS. "every write is dominated" is vacuously true when none can be
  ! seen, and a guard written somewhere this walk cannot see - inside a ROUTINE, say - looks
  ! exactly like a guard that is never written. That is how `if tailRj` came to qualify in
  ! WalkUnreachable, where tailRj is set by `do TailRejoinChk`: the scan found no writes, passed
  ! vacuously, and credited a read of pendHead that really is a read before its write. The
  ! dogfood leg caught it as a WRONG ADD on our own source. At least one write, and every one of
  ! them dominated.
  if zgWrites then zgOK = 1.

! ---- scan BACK from a write to the guard, at that write's own block level, for a write to V.
!      Depth keeps a write inside a nested IF from counting, and first-on-line keeps the write in
!      `if g then v += 1.` from counting - that one is inside the guard, not above it. It keeps a
!      write to V after a column-1 '?' from counting too: that line runs in debug builds only. A
!      write to the GUARD on such a line is counted like any other (AutoTokIsWrite): one build
!      skips it, and in the other it must be covered as well.
ZeroGuardDominated routine
  zgFound = 0 ; zgDepth = 0
  loop zgK = zgJ - 1 to codeT + 1 by -1
    get(self.tk.tokens, zgK)
    if errorcode() then break.
    case self.tk.tokens.level
    of '-'
      zgDepth += 1                                                         ! a nested block closes above us
    of '+'
      if ~zgDepth then break.                                              ! our own block's opener - stop, nothing found
      zgDepth -= 1
    of '/'
      ! AN ELSE OR ELSIF IS A WALL, NOT A STEP. The arms of an IF are ALTERNATIVES: a write in the
      ! THEN arm does not run on the path that reaches the ELSE arm. Counting only '+' and '-' walked
      ! straight through the separator, so a guard written in the ELSE arm was credited by a write to
      ! V in the THEN arm, and V then earned ,AUTO over storage a read under that guard really can
      ! reach - a WRONG ADD, the one direction this must never go. Found by review, 16 Sep 2026.
      if ~zgDepth then break.
    end
    if zgDepth then cycle.                                                 ! inside a nested block - conditional, so no
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> 'b' then cycle.
    if ~self.tk.tokens.firstOnLine then cycle.                             ! `if g then v += 1.` - v is not first on the line
    if upper(self.tk.tokens.tok) <> nU then cycle.
    if self.AutoTokIsWrite(zgK)
      zgFound = 1
      break
    end
  end
  get(self.tk.tokens, i)                                                   ! restore the buffer to the opener

! ---- the guard must start at zero and change only where ZeroGuardWrites can see it: no initial value
!      but 0 (`g LONG(1)` is not zero when the procedure starts), not read or set where the code does
!      not say (a control's USE(), an INCLUDE, &=, ADDRESS() - UnseenRead), and not named in a method
!      of a class the procedure declares, which shares its data. The scopes buffer goes back to V's.
ZeroGuardSeen routine
  if self.DeclHasInitValue(zgDeclT)
    if self.tk.GetTok(zgDeclT + 3) <> '0' or self.tk.GetTok(zgDeclT + 4) <> ')' then zgOK = 0.
  end
  if zgOK and self.UnseenRead(zgNm) then zgOK = 0.
  if zgOK
    get(self.syms.scopes, vScope)
    if self.MayHaveLocalMethods(vScope)
      if self.UsedInLocalMethods(zgNm, self.syms.scopes.startTok, self.syms.scopes.endTok) then zgOK = 0.
    end
    get(self.syms.scopes, vScope)
  end
  get(self.tk.tokens, i)

! ---- zgRead = the guard's occurrence at zgJ, which is no assignment, only READS it. A counted LOOP's
!      header writes it, and so may an argument - CLEAR, PEEK, a slot passed by address, a call this
!      cannot place - and a use of its parts. Any of those sinks the guard: a write ZeroGuardWrites
!      does not count could make it non-zero while V is still unwritten. A '.' after it that ENDS the
!      statement (typed vt:end) is no use of its parts: `if c then y = g.` only reads g.
ZeroGuardRead routine
  data
pv   string(vs:maxName),auto
nx   string(vs:maxName),auto
  code
  zgRead = 0
  pv = upper(self.tk.GetTok(zgJ - 1))
  nx = self.tk.GetTok(zgJ + 1)
  if nx = '.' and self.tk.tokens.type = vt:end then nx = 'END'.
  if pv = '.'
    zgRead = 1
  elsif pv <> 'LOOP' and nx <> '[' and nx <> '.' and nx <> '{{' and ~self.AutoOutArgWrite(zgJ, pv)
    zgRead = 1
    if (pv = '(' or pv = ',') and (nx = ')' or nx = ',')
      if self.AutoArgIsRefParam(zgJ, 1) then zgRead = 0.
    end
  end
  get(self.tk.tokens, i)

! ---- is any OPEN frame such an IF? A read of V inside one convicts nothing.
ZeroGuardHere routine
  inZG = 0
  loop zgJ = 1 to records(FrameQ)
    get(FrameQ, zgJ)
    if errorcode() then break.
    if fr:zeroG
      inZG = 1
      break
    end
  end
  get(self.tk.tokens, i) ! FrameQ walk left it alone, but be explicit

! ---- is this a BARE `loop`? The opener token is LOOP and the statement ends right after it,
!      so there is no counter, no WHILE, no UNTIL and no TIMES clause to make it zero-trip.
!      The buffer is on the LOOP token; it is restored before returning.
LoopBareChk routine
  fr:bare = 0
  get(self.tk.tokens, i + 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if size(self.tk.tokens.tok) = 1
      if self.tk.tokens.tok[1] = '<10>' or self.tk.tokens.tok = ';' then fr:bare = 1.
    end
  end
  get(self.tk.tokens, i) ! restore the buffer to the opener token

! ---- a write to V at the innermost frame's OWN level, before anything that could leave it.
!      Only that shape is guaranteed on every path out of a bare loop. A write on a line that runs
!      in debug builds only is not: a release build never makes it.
LoopBodyAsg routine
  if dbgOn then exit.
  if records(FrameQ)
    get(FrameQ, records(FrameQ))
    if ~errorcode()
      if fr:kind = 2 and fr:bare = 1 and fr:exitAt = exitCount and ~fr:bodyAsg
        fr:bodyAsg = 1 ; put(FrameQ)
      end
    end
  end

LoopCtlChk routine
  ctlOurs = 0
  get(self.tk.tokens, i + 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if self.tk.tokens.type = 'b' and upper(self.tk.tokens.tok) = nU
      get(self.tk.tokens, i + 2)
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.tok = '=' then ctlOurs = 1.
      end
    end
  end
  ! *** A COUNTER THAT READS ITSELF IN ITS OWN HEADER IS NOT WRITTEN FIRST. ***
  ! `loop v = v + 1 to 3` evaluates the START expression before it assigns v, so v is
  ! READ while still unassigned - and crediting the write here would let it earn ,AUTO
  ! over the zero-init that read depends on, which is a WRONG ADD in the one direction
  ! this routine must never go. `loop u = 1 to u` is the same question about the limit,
  ! and the order there is not something to rely on either way.
  !
  ! So the rest of the header is scanned for the name, and the credit is withdrawn if it
  ! is there. Withdrawing it does not convict anything by itself: it just lets the normal
  ! walk see the token, which is a read of an unassigned variable and is judged as one.
  !
  ! The scan runs to the EOL token or a ';', so a header continued with '|' is covered -
  ! the continuation makes the newline trivia rather than a token. Over-reaching would
  ! only ever REFUSE a credit, which is the safe direction, so the bound is generous.
  if ctlOurs
    lcSeen = 0
    loop lcJ = i + 3 to records(self.tk.tokens)
      get(self.tk.tokens, lcJ)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then cycle.
      if size(self.tk.tokens.tok) = 1
        if self.tk.tokens.tok[1] = '<10>' or |   ! end of the statement
           self.tk.tokens.tok = ';'          !   and of a compressed one
          break
        end
      end
      if self.tk.tokens.type = 'b' and upper(self.tk.tokens.tok) = nU
        lcSeen = 1
        break
      end
    end
    if lcSeen then ctlOurs = 0.
  end
  get(self.tk.tokens, i)                     ! restore the buffer to the opener token

! ------------------------------------------------------------------------------------
! does the builtin call surrounding token pTok WRITE it via an output/by-ref
! argument?  Only genuine whole-variable writes are recognised, so this can never create
! a wrong ADD; it removes false REMOVEs (and catches a few more legit ADDs) where a var's
! first touch is such a call.  CLEAR(V ...) writes V (arg 1).  GETPOSITION(feq, x,y,w,h)
! writes args 2-5 (feq, arg 1, is input - reached via prevU='(' so never matched here).
! Extend the allow-list at the CASE below for further output-writing builtins.
! ------------------------------------------------------------------------------------
! ---- IS THE NAME TOKEN AT pTok AN ASSIGNMENT TARGET? Asked about the ZERO GUARD, which is a
!      different name from the one AutoVerdict is walking, so it cannot use that walk's prevU /
!      nextU state and re-reads them here.
!      IT MUST KNOW THE COMPOUND OPERATORS. AutoVerdict's own test is `nextU = '='` alone, which
!      is right there - it is followed by a self-reference scan of the RHS that handles the rest -
!      but a guard is almost always stepped with `g += 1`, and reading that as a non-write would
!      make a guard with no dominating write look like a guard with no writes AT ALL, which is
!      exactly backwards: GuardedNeverWritten would then pass. So every assignment operator counts.
!      WHERE A STORE STANDS is StoreHead's answer: a name that begins its statement, the counter of
!      a LOOP that begins one, and a name right after the DEBUG mark, a '?' alone in column 1 - so
!      `? g = 1` is a write in the builds that run the line. The first name on a '|' continuation
!      line does not begin a statement: in `if a or |` / `g = 2` the second line compares g.
VitEngine.AutoTokIsWrite Procedure(LONG pTok)
nxt   string(8),auto
prv   string(8),auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  prv = '' ; nxt = ''
  get(self.tk.tokens, pTok - 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then prv = upper(self.tk.tokens.tok).
  get(self.tk.tokens, pTok + 1)
  if ~errorcode() and not self.tk.tokens.tok &= NULL then nxt = upper(self.tk.tokens.tok).
  get(self.tk.tokens, pTok)                              ! leave the buffer on the name, as the callers expect
  if prv = '.' then return 0.                            ! x.G is a MEMBER, not our local
  if ~self.StoreHead(pTok) then return 0.
  case nxt
  of '=' orof '+=' orof '-=' orof '*=' orof '/=' orof '^=' orof '%=' orof '&=' orof ':=:'
    return 1
  end
  return 0

! ---- SIZE(V) NEITHER READS NOR WRITES V. It is the declared size, which the compiler knows, so no
!      byte of V is looked at and the occurrence is no evidence either way. V must be the whole
!      argument, and o.Size(V) is a method, not the builtin.
VitEngine.AutoSizeOnly Procedure(LONG pTok, STRING pPrevU)
  code
  if pPrevU <> '(' then return 0.
  if self.tk.GetTok(pTok + 1) <> ')' then return 0.
  if upper(self.tk.GetTok(pTok - 2)) <> 'SIZE' then return 0.
  if self.tk.GetTok(pTok - 3) = '.' then return 0.
  return 1

! ---- IS PARAMETER pPos OF THIS PROTOTYPE DECLARED BY REFERENCE? Read from the prototype's own
!      tokens rather than from a copy in the registry, because the registry deliberately strips
!      the marker: pSlotsU exists to MATCH a call site to a prototype by type, and a '*' there
!      would stop it matching. The tokenizer merges '*' with the type after it, so a by-reference
!      parameter arrives as one token beginning '*'. A reference parameter, `&STRING`, arrives as
!      '&' and its type: the callee is handed the caller's storage just the same, and may write it.
!      pTk is the stream the token belongs to.
VitEngine.ProtoParamIsRef Procedure(LONG pProtoTok, LONG pPos, VitTokenize pTk)
z    long,auto
d    long,auto
pos  long,auto
seen byte,auto
txt  string(vs:maxName),auto
  code
  if pProtoTok < 1 or pPos < 1 then return 0.
  pos = 1 ; d = 0 ; seen = 0
  loop z = pProtoTok + 1 to pProtoTok + 400      ! its own declaration, never past it
    get(pTk.tokens, z)
    if errorcode() then return 0.
    if pTk.tokens.tok &= NULL then return 0.
    if pTk.tokens.tok[1] = '<10>' then return 0. ! the prototype line ended
    if ~seen                                     ! step over the name and PROCEDURE
      if pTk.tokens.tok = '('
        seen = 1 ; d = 1
      end
      cycle
    end
    case pTk.tokens.tok
    of '(' orof '['
      d += 1
      cycle
    of ')' orof ']'
      d -= 1
      if ~d then return 0.                         ! the list closed before pPos
      cycle
    of ','
      if d = 1
        pos += 1
        cycle
      end
    end
    if pos = pPos and d = 1
      txt = upper(pTk.tokens.tok)
      if txt[1] = '<<' then cycle.                 ! an omittable parameter opens with '<'
      if txt = 'CONST' then cycle.                 ! CONST *STRING is still the caller's storage
      if txt[1] = '*' then return 1.
      if txt = '&' then return 1.                  ! a reference: the callee writes through it
      return 0                                     ! a type token with no marker: BY VALUE
    end
  end
  return 0

! ---- IS THIS NAME AN ARGUMENT SITTING IN A BY-REFERENCE SLOT? Then the callee may write the
!      caller's storage before anything reads it, so the occurrence is not evidence of a READ.
!      Only a PLAIN call is answered here - a dotted receiver is a method, whose prototype this
!      route does not reach - and only where the name has exactly ONE prototype: with overloads,
!      which one a call binds is not knowable from the name.
!      The walk back counts the slot at bracket depth 0, and the braces of a property count as
!      brackets: in `Fill(?List{PROPLIST:Width, 1}, work)` the comma inside the braces is not the
!      call's, so work is in slot 2. A name inside the braces themselves is a property's index,
!      which is read, as a subscript is.
!      `self.Method(` is answered from the class of the procedure or method the call stands in,
!      found from the call itself, so every pass that asks gets the same answer (AaSelfCls).
VitEngine.AutoArgIsRefParam Procedure(LONG pTok, BYTE pUnknown=0)
z    long,auto
d    long,auto
opn  long,auto
pos  long,auto
pt   long,auto
nmU  string(vs:maxName),auto
oU   string(vs:maxName),auto
aaRd byte,auto
  code
  if self.syms &= NULL then return 0.
  if pTok < 3 then return 0.
  d = 0 ; opn = 0 ; pos = 1
  loop z = pTok - 1 to 1 by -1                          ! back to the call's opening paren
    get(self.tk.tokens, z)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then return 0.        ! statement boundary
    if self.tk.tokens.type = vt:literal then cycle.
    if self.tk.tokens.tok[1] = '<10>' then return 0.
    if self.tk.tokens.tok = ';' then return 0.
    if self.tk.tokens.tok = '}' then d += 1 ; cycle.
    if self.tk.tokens.tok = '{{'
      if ~d then return 0.
      d -= 1 ; cycle
    end
    if self.tk.tokens.tok = ')' or self.tk.tokens.tok = ']'
      d += 1
    elsif self.tk.tokens.tok = '(' or self.tk.tokens.tok = '['
      if d
        d -= 1
      elsif self.tk.tokens.tok = '('
        opn = z ; break
      else
        return 0                                                   ! a subscript, not an argument list
      end
    elsif self.tk.tokens.tok = ',' and ~d
      pos += 1
    end
  end
  if ~opn then return 0.
  get(self.tk.tokens, opn - 1)                                     ! the callee's name
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type <> vt:label then return 0.
  nmU = upper(self.tk.tokens.tok)
  if instring('.', nmU, 1, 1) then return 0.                       ! a MERGED dotted name is never a call
  ! FROM HERE ON THE CALL IS FOUND AND ITS PROTOTYPE IS THE QUESTION. AutoCheck asks "is this
  ! slot provably by reference" and an unplaceable callee answers no; InlineSingleUse asks "is it
  ! provably by value" and passes pUnknown = 1, so the same callee answers yes - except a function
  ! on the pure list, which takes values - and only as one of the runtime's own readers, with no
  ! procedure of that name in this file (AaReader).
  oU = ''
  if opn >= 3                                                      ! self.Method( arrives as FOUR tokens, not one
    get(self.tk.tokens, opn - 2)
    if ~errorcode() and not self.tk.tokens.tok &= NULL and self.tk.tokens.tok = '.'
      get(self.tk.tokens, opn - 3)
      if errorcode() then return 0.
      if self.tk.tokens.tok &= NULL then return 0.
      if upper(self.tk.tokens.tok) <> 'SELF' then return pUnknown. ! only SELF names a class this walk knows
      do AaSelfCls
      if ~oU then return pUnknown.
    end
  end
  if oU
    pt = self.syms.MethodProtoTok(oU, nmU)                         ! refuses an overload; a VIRTUAL is answered
  else
    pt = self.syms.MapProtoTok(nmU)
  end
  if ~pt and pUnknown and ~oU
    do AaReader
    if aaRd then return 0.
  end
  if ~pt then return pUnknown.                                     ! no prototype, or overloaded: nothing known
  if oU and not self.syms.expTk &= NULL                            ! a METHOD prototype, with the includes read, is a
    return self.ProtoParamIsRef(pt, pos, self.syms.expTk)          !   token of the EXPANDED stream - read it there
  end
  return self.ProtoParamIsRef(pt, pos, self.tk)

! ---- the class of SELF where the call stands: the procedure or method that holds it (a ROUTINE's
!      tokens lie inside its procedure's range). The scopes buffer is put back where it was. ----
AaSelfCls routine
  data
sv  long,auto
sc  long,auto
  code
  oU = ''
  if self.syms.scopes &= NULL then exit.
  sv = pointer(self.syms.scopes)
  sc = self.syms.ScopeContaining(opn, vs:scProc, vs:scMethod)
  if sc
    get(self.syms.scopes, sc)
    if ~errorcode() then oU = self.syms.scopes.selfClass.
  end
  if sv then get(self.syms.scopes, sv).

! ---- a plain call no single prototype here places: it takes values only as one of the runtime's
!      own readers on the pure list, and only where this file gives no procedure that name - its MAP
!      may prototype one, or overload it, and that one may take the argument by address. The own
!      list is asked for this one name (PureOwnList, PureProc). ----
AaReader routine
  data
one  StringTheory
own  StringTheory
  code
  one.setValue(' ' & clip(nmU) & ' ')
  self.PureOwnList(one, own)
  aaRd = self.PureProc(nmU, self.dgPure, own)

! ---- ADDRESS(V) MEANS UNKNOWN, NEVER A READ. When a variable's address is handed to something -
!      MemCopy(address(v), n), an API that fills a buffer - the storage ESCAPES. The callee may
!      write it, read it, or both, and nothing here can tell which. That is the definition of
!      ac:unknown: leave the author's declaration exactly as it is. Reading it as a READ is what
!      turned "I could not find a write" into a REMOVE, which edits the declaration AND writes a
!      note into the author's source asserting a read that was never observed.
VitEngine.AutoAddrTaken Procedure(LONG pTok, STRING pPrevU)
  code
  if pPrevU <> '(' then return 0.                        ! V must be the argument of the call
  get(self.tk.tokens, pTok - 2)                          ! ... whose NAME is the token before that paren
  if errorcode() then return 0.
  if self.tk.tokens.tok &= NULL then return 0.
  if upper(self.tk.tokens.tok) <> 'ADDRESS' then return 0.
  get(self.tk.tokens, pTok - 3)                          ! o.Address(V) is a METHOD, not the builtin
  if ~errorcode() and not self.tk.tokens.tok &= NULL
    if self.tk.tokens.tok = '.' then return 0.
  end
  return 1

VitEngine.AutoOutArgWrite Procedure(LONG pTok, STRING pPrevU)
j     long,auto
depth long,auto
k     long,auto
vU    STRING(vs:maxName),AUTO
  code
  if pPrevU = '('                                        ! V is the FIRST arg of the call
    get(self.tk.tokens, pTok - 2)
    if errorcode() then return 0.
    if self.tk.tokens.tok &= NULL then return 0.
    if upper(self.tk.tokens.tok) = 'CLEAR'
      get(self.tk.tokens, pTok - 3)                      ! o.Clear(V) is a METHOD - it may READ its argument; only the builtin statement CLEAR writes
      if ~errorcode() and not self.tk.tokens.tok &= NULL
        if self.tk.tokens.tok = '.' then return 0.
      end
      return 1                                           ! CLEAR(V) / CLEAR(V,fill)
    end
    return 0
  end
  if pPrevU = ','                                        ! V is at arg position 2+ : walk back to the call name
    depth = 0
    loop j = pTok - 1 to 1 by -1
      get(self.tk.tokens, j)
      if errorcode() then break.
      if self.tk.tokens.tok &= NULL then break.          ! statement boundary
      case self.tk.tokens.tok
      of '<10>' orof ';'
        break                                            ! never cross a statement
      of '['    orof ']'
        return 0                                         ! a subscript comma (arr[i, V]) is NOT an argument slot - bail
      of ')'
        depth += 1
      of '('
        if ~depth                                        ! the enclosing arg-list open paren
          get(self.tk.tokens, j - 1)
          if errorcode() then return 0.
          if self.tk.tokens.tok &= NULL then return 0.
          case upper(self.tk.tokens.tok)
          of   'GETPOSITION'                             ! args 2-5 are OUTPUT (x,y,w,h)
          orof 'PEEK'                                    ! PEEK(address, V) writes its 2nd (only other) arg
            get(self.tk.tokens, j - 2)                   ! o.GetPosition(a,V) is a METHOD, not the builtin
            if ~errorcode() and not self.tk.tokens.tok &= NULL
              if self.tk.tokens.tok = '.' then return 0.
            end
            vU = upper(self.tk.GetTok(pTok))             ! V read later in the same list - a subscript - is read
            depth = 0                                    !   before the call writes it
            loop k = pTok + 1 to records(self.tk.tokens)
              get(self.tk.tokens, k)
              if errorcode() or self.tk.tokens.tok &= NULL then break.
              if self.tk.tokens.tok = '<10>' or self.tk.tokens.tok = ';' then break.
              if self.tk.tokens.tok = '(' then depth += 1.
              if self.tk.tokens.tok = ')'
                if ~depth then break.
                depth -= 1
              end
              if upper(self.tk.tokens.tok) = vU then return 0.
            end
            return 1
          end
          return 0
        end
        depth -= 1
      end
    end
  end
  return 0

! ------------------------------------------------------------------------------------
! A bare-label token (type 'b') equal to pNameU anywhere in [pStart,pEnd], excluding
! member (`.V`) and qualified uses. Used for the routine-touched eligibility test.
! ------------------------------------------------------------------------------------
VitEngine.NameRefdInRange Procedure(STRING pNameU, LONG pStart, LONG pEnd)
i     long,auto
nU    string(vs:maxName),AUTO
prevU string(vs:maxName),auto
  code
  nU = upper(pNameU)
  loop i = pStart to pEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.type <> 'b' or   |
       self.tk.tokens.tok &= NULL or   |
       upper(self.tk.tokens.tok) <> nU
      cycle
    end
    prevU = ''
    if i > 1
      get(self.tk.tokens, i - 1)
      if not self.tk.tokens.tok &= NULL then prevU = self.tk.tokens.tok.
    end
    if prevU <> '.' then return true.
  end
  return false

!===============================================================================================
! Does this token range hold an OMIT or COMPILE keyword? The four analyses refuse a scope that
! does, because whether such a block is built at all depends on a compile-time switch: a
! declaration read only from inside one would scan as unused and be commented out on the
! strength of a build the caller never asked for.
!
! ***  THIS READS TOKENS, AND THE TOKENIZER ABSORBS SOME OMIT BLOCKS INTO TRIVIA - keyword
! ***  and all. So this can only ever see the blocks that were NOT absorbed, and the two
! ***  boundaries have to coincide EXACTLY. They do, and it is load-bearing:
!
!   absorbed      = the UNCONDITIONAL one-argument OMIT('...') and nothing else. The machine in
!                   vitTokenize.clw fires on a 4-character OMIT token only - so never COMPILE -
!                   and its walk reverts unless the very next tokens are ( 'literal' ). The
!                   two-argument conditional form presents a comma there and reverts.
!                   That code is omitted from EVERY build, so a reference inside it genuinely
!                   does not count, and analysing the scope normally is correct.
!   not absorbed  = everything conditional. The keyword survives as a token, this finds it,
!                   and the scope is refused.
!
! Absorption therefore coincides with UNCONDITIONAL omission, which is what makes "refuse what
! is still visible, analyse what was absorbed" safe. Widen absorption to a conditional form and
! this goes blind without a word: the keyword would be gone, nothing would refuse, and a
! variable used only in the branch that is sometimes built would be silently commented out.
! TestData\uvomit.clw is the pin, and its case is a COMPILE precisely because that is never
! absorbed.
!===============================================================================================
VitEngine.ScopeIsConditional Procedure(LONG pFromTok, LONG pToTok)
i  long,auto
  code
  loop i = pFromTok to pToTok
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case upper(self.tk.tokens.tok)
    of 'OMIT' orof 'COMPILE'
      return 1
    end
  end
  return 0

!===============================================================================================
! The first mention of the object pNameU in pFirst..pLast that can set its base64 flag or its encoding - a
! member fl:writers names, _StealValue, or setValue given an object or a name the table cannot type -
! or 0. pEnc is set when that mention gives it a USTRING's value alone, which sets the encoding to
! UTF-16. Lifted from DeadValueWrite's DwObjScan for the final sweep (V3-1, V3-5, V3-7): a SetValue
! clears the marks a Free() keeps, a by-value copy carries none of them, and a trim moved past a loop
! clears them later - each matters only when the procedure can set them, which is this question.
!===============================================================================================
VitEngine.MarkSetterAt Procedure(STRING pNameU, LONG pFirst, LONG pLast, *BYTE pEnc)
k    long,auto
n    long,auto
a    long
t    STRING(vs:maxName),auto
m    STRING(vs:maxName)
tU   STRING(vs:maxName)
rf   BYTE
nmU  STRING(vs:maxName),AUTO
  code
  pEnc = 0
  if self.ignoreMarks then return 0. ! --ignoremarks: the marks are the user's own risk
  nmU = upper(pNameU)
  n = len(clip(nmU))
  if ~n or n + 1 >= size(t) then return 0.
  loop k = pFirst to pLast
    get(self.tk.tokens, k)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    t = upper(self.tk.tokens.tok)
    if t = nmU and self.tk.GetTok(k + 1) = '.'
      m = upper(self.tk.GetTok(k + 2)) ; a = k + 3
    elsif t[1 : n + 1] = clip(nmU) & '.'
      m = t[n + 2 : size(t)] ; a = k + 1
    else
      cycle
    end
    if m = '_STEALVALUE' or instring(' ' & clip(m) & ' ', fl:writers, 1, 1) then return k.
    if m <> 'SETVALUE' or self.tk.GetTok(a) <> '(' then cycle.
    if self.tk.GetTok(a + 2) <> ')' and self.tk.GetTok(a + 2) <> ',' then cycle.
    get(self.tk.tokens, a + 1)
    if errorcode() or self.tk.tokens.tok &= NULL or self.tk.tokens.type <> vt:label then cycle.
    if ~self.syms.Lookup(self.tk.tokens.tok, a + 1, tU, rf) or upper(tU) = 'STRINGTHEORY' or ~self.UvPlainType(tU) then return k.
    if upper(tU) = 'USTRING' and self.tk.GetTok(a + 2) = ')' then pEnc = 1 ; return k.
  end
  return 0

!===============================================================================================
! Is pTok inside a COMPILE(...) or conditional OMIT(...) block - code some builds leave out?
!
! A proof that a line RUNS - the write that makes another dead, the copy every read follows, the
! first += of a local - cannot rest on a line there: in the build without the block it does not
! run. Ruled 9 Nov 2026: such a proof refuses when a line it relies on is in a block, and only then,
! so a procedure with a debug block keeps every clean-up the block does not touch.
!
! The keyword survives as a token (a plain OMIT is absorbed into trivia whole: no build has its
! code), and its first argument is the terminator. The block ends on the line holding it, which the
! tokenizer folds into the strBefore of the token after that line, so it is matched as TermFold
! matches it: by case, anywhere in the line - in front of a comment or in it, which also ends the
! block (measured) - and an outer block's terminator closes the inner ones with it. The walk starts at the procedure or method the token is
! in, or the program's own code, not the file.
!===============================================================================================
VitEngine.InCondBlock Procedure(LONG pTok)
sc    long,auto
i     long,auto
j     long,auto
k     long,auto
fromT long,auto
open  StringTheory ! the terminators of the blocks open so far, the innermost last
sb    StringTheory
ln    StringTheory
  code
  fromT = 1
  sc = self.syms.ScopeContaining(pTok, vs:scProc, vs:scMethod)
  if ~sc then sc = self.syms.ScopeContaining(pTok, vs:scMain, vs:scMain).
  if sc
    self.syms.scopes.scopeId = sc
    get(self.syms.scopes, self.syms.scopes.scopeId)
    if ~errorcode() then fromT = self.syms.scopes.startTok.
  end
  loop i = fromT to pTok
    get(self.tk.tokens, i)
    if errorcode() then break.
    if open.records() and not self.tk.tokens.strBefore &= NULL
      sb.setValue(self.tk.tokens.strBefore)
      sb.split('<10>')
      loop j = 1 to sb.records()
        ln.setValue(sb.getLine(j))
        if ~ln._DataEnd then cycle.
        loop k = open.records() to 1 by -1
          if ln.findChars(open.getLine(k))
            loop while open.records() >= k
              open.deleteLine(open.records())
            end
            break
          end
        end
        if ~open.records() then break.
      end
      get(self.tk.tokens, i)
      if errorcode() then break.
    end
    if i = pTok then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case upper(self.tk.tokens.tok)
    of 'OMIT' orof 'COMPILE'
      if i > 1 and self.tk.GetTok(i - 1) = '.' then cycle. ! a method of that name
      if self.tk.GetTok(i + 1) <> '(' then cycle.
      ln.setValue(self.tk.GetTok(i + 2))
      if ln._DataEnd < 3 or ln.valuePtr[1] <> '''' or ln.valuePtr[ln._DataEnd] <> '''' then cycle.
      ln.setValue(ln.valuePtr[2 : ln._DataEnd - 1])
      ln.replace('''''', '''')
      if ln._DataEnd then open.addLine(ln.getValue()).
    end
  end
  return choose(open.records() > 0)

!===============================================================================================
! Is there a COMMENT riding the leading trivia of any token in this range?
!
! Trivia is whitespace, continuations and COMMENTS, and a comment there belongs to the author.
! Two places in MergeGuardChain would destroy trivia if they did not ask: MgOrForm overwrites the
! THEN token's, and MgCollapseRuns deletes the condition tokens' along with the tokens. Neither
! produces wrong CODE - a comment is not code - but both could silently drop something a person
! wrote, which is not ours to do. They ask this first and refuse the merge if the answer is yes.
!
! A '!' anywhere in trivia starts a comment: trivia holds no string literals, so there is no
! quoting to reason about. So do words written after a '|' - the compiler ignores the rest of
! a line after a continuation bar - and TriviaCmtRows reads both. An OMIT/COMPILE body
! absorbed into trivia can contain one too, and that prose is just as much the author's -
! refusing there is right for the same reason.
!
! REFUSING, not carrying. Carrying the text is the better answer and it is what the per-condition
! comment bank already does for the comments it knows about; this is for the trivia nothing has
! claimed. Refusing costs a merge on a shape that has a comment in an unusual place. Dropping
! the comment costs the comment, and nobody would ever see it go.
!
! THE .TXA SHIFT MARKER COUNTS TOO. It is no comment (TxaMarkOff), but the trivia that holds it
! ends a line that began in column 1, and a pass that deletes or rewrites that trivia leaves the
! line one column out when the file is written back. So it refuses there, as for a comment.
!===============================================================================================
VitEngine.SpanTriviaHasComment Procedure(LONG pFromTok, LONG pToTok)
i  long,auto
r  StringTheory
  code
  loop i = pFromTok to pToTok
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.strBefore &= NULL then cycle.
    if self.isTxa
      if r.findByte(251, 1,, self.tk.tokens.strBefore) then return 1.
    end
    if self.TriviaCmtRows(i, r) then return 1.
  end
  return 0

!===============================================================================================
! Does this leading trivia hold a CONTINUATION '|', as opposed to one inside a comment?
!
! `firstOnLine` is true on a continuation line too, so the passes that ask "is this token the
! start of a statement" have to tell the two apart, and the '|' lives in the token's trivia. A
! plain search for it also finds one written inside a FULL-LINE COMMENT sitting in that same
! trivia - and a comment may say anything at all. The token is then taken for a continuation,
! `fol and ~contLn` goes false, and a genuine whole-variable write becomes invisible: the
! variable reads as touched-before-written, which is how an author's own ,AUTO gets removed on
! a claim that is not true.
!
! Everything from a '!' to the end of that line is comment, so a '|' there is text. A '|'
! before any '!' is the real thing - and code after a continuation is ignored by the compiler,
! so `x = 1 | ! note` is a continuation carrying a comment, found correctly by reading left to
! right and stopping at the first unquoted marker.
!
! Only the contLine/contLn sites use this. The places that REFUSE on a '|' - the hoist tail
! test, the strBefore purity test - keep the blunt search on purpose: refusing on a comment's
! '|' is under-reach, which is their safe direction.
!===============================================================================================
VitEngine.TriviaHasContinuation Procedure(STRING pTrivia)
i    long,auto
n    long,auto
inC  byte,auto
  code
  n = size(pTrivia)
  inC = 0
  loop i = 1 to n
    if pTrivia[i] = '<10>' ! a newline ends the comment, not the trivia
      inC = 0
    elsif pTrivia[i] = '!'
      inC = 1
    elsif pTrivia[i] = '|' and ~inC
      return 1
    end
  end
  return 0

!===============================================================================================
VitEngine.CodeTokOfScope Procedure(LONG pStart, LONG pEnd)
i  long,auto
  code
  loop i = pStart to pEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if ~self.tk.tokens.firstOnLine or     |
       self.tk.tokens.tok &= NULL
      cycle
    end
    if upper(self.tk.tokens.tok) = 'CODE'
      if self.tk.BufColOne() then cycle.  ! a COLUMN-1 'code' is a LABEL (a local variable), not the
      return i                            !   CODE statement - the exclusion BuiltinUnusedVars already applies
    end
  end
  return 0

!===============================================================================================
! Could the statement the hoist wants to lift be read through an ALIAS of its own left side?
!
! Gate (3) at TryStartHoist asks whether the CONDITION mentions the lhs by name, and that test is
! textual - SpanHasName compares name roots and consults nothing. OVER is the one aliasing spelling
! a textual test cannot see at all, because the alias does not resemble the name it aliases. With
! `x LONG` and `sh SHORT,OVER(x)`, two branches both starting `x = 1` look safe to hoist above
! `if sh = 2` - and the hoisted store writes the very bytes the condition reads, so the other arm
! runs. No GPF; just the wrong branch, quietly.
!
! HasSiblingOver answers it for AutoCheck and for KnownRanges' KrLocalOk, and wants a syms
! ROW; the hoist has a token and a name, so this composes the two lookups that bridge them
! and adds no second copy of the rule.
!
! IT REFUSES WHEN IT CANNOT TELL, which is the whole posture of this gate: no scope, no symbol row,
! or no symbol table at all means no proof, and an unproven hoist is one that does not happen.
!===============================================================================================
VitEngine.HoistAliasRisk Procedure(LONG pTokPos, STRING pNameU)
sc    long,auto
syRow long
  code
  if self.syms &= NULL then return 1. ! no table - cannot tell, so refuse
  if ~pNameU then return 1.
  ! INNERMOST-OUT, the same ladder LookupIn walks: a ROUTINE's DATA is private to that routine,
  !   so a name declared there is the one the statement means. Only when the routine declares
  !   nothing does the surrounding procedure answer.
  sc = self.syms.ScopeContaining(pTokPos, vs:scRoutine, vs:scRoutine)
  if sc then syRow = self.syms.FindSym(pNameU, sc).
  if ~syRow
    sc = self.syms.ScopeContaining(pTokPos, vs:scProc, vs:scMethod)
    if sc then syRow = self.syms.FindSym(pNameU, sc).
  end
  if ~syRow
    ! MODULE LEVEL IS ASKED TOO: a global can be OVERed by another global just as a local
    !   can, and a hoist whose lhs is module-level is common. Stopping at the procedure would
    !   refuse every one of those for want of a lookup rather than for want of proof.
    sc = self.syms.ScopeContaining(pTokPos, vs:scModule, vs:scModule)
    if sc then syRow = self.syms.FindSym(pNameU, sc).
  end
  if ~syRow then return 1.            ! nowhere in the table - no proof, so refuse
  ! THE TARGET MAY BE THE ALIAS ITSELF: `sh SHORT,OVER(p)` written above `if p = 2` writes the
  !   bytes the test reads, and nothing is declared OVER sh for the sibling walk to find.
  get(self.syms.syms, syRow)
  if ~errorcode() and self.DeclHasAttr(self.syms.syms.declTok, 'OVER') then return 1.
  return self.HasSiblingOver(syRow, pNameU)

!===============================================================================================
! Does the storage pNameU names have a second name in the procedure around pTok?
!
! A proof that reads a variable's writes by its SPELLING is blind to a write through another name
! for the same bytes: `b LONG,OVER(a)` written while a is read, `r &= a` then `r = 5`, or a GROUP's
! field written as `pg:a` while the group is read as `g`. Four passes asked this each in its own
! way and each missed one (the final sweep, 9 Nov 2026): this is the one answer they share.
!   * OVER either way, module level included, and "cannot tell" refuses: HoistAliasRisk.
!   * the name is itself a reference (`r &LONG`): it reads whatever it was last pointed at.
!   * a reference taken on the name anywhere in its procedure or routine (`&= name`).
!   * a prefixed spelling (`pg:a`): the field is also the group's bytes, which the symbol table
!     files under no name this could follow, so it is taken as shared.
! 1 = shared, or not provable. Refusing costs one rewrite; a wrong one costs the user's code.
!===============================================================================================
VitEngine.NameShared Procedure(LONG pTok, STRING pNameU)
sc   long,auto
k    long,auto
nmU  string(vs:maxName),auto
  code
  nmU = upper(pNameU)
  if ~nmU then return 1.
  if instring(':', nmU, 1, 1) then return 1.
  if self.HoistAliasRisk(pTok, nmU) then return 1.
  sc = self.syms.ScopeContaining(pTok, vs:scProc, vs:scMethod)
  if ~sc then return 1.
  k = self.syms.FindOwn(nmU, sc)
  if k
    get(self.syms.syms, k)
    if ~errorcode() and self.syms.syms.isRef then return 1.
  end
  self.syms.scopes.scopeId = sc
  get(self.syms.scopes, self.syms.scopes.scopeId)
  if errorcode() then return 1.
  loop k = self.syms.scopes.startTok to self.syms.scopes.endTok
    if self.tk.GetTok(k) = '&=' and upper(self.tk.GetTok(k + 1)) = nmU then return 1.
  end
  return 0

!===============================================================================================
! Is any OTHER declaration in this symbol's scope declared OVER it?
!
! OVER is the fifth way one storage location gets two names, and the one a textual test cannot
! see at all: the alias does not resemble the name it aliases. `p LONG` / `sh SHORT,OVER(p)` are
! two labels on the same bytes, so a write through either is a write to both.
!
! VitSymbols sorts syms on (+scopeId, +nameU), so a scope's rows are CONTIGUOUS: walk OUT from
! the candidate and stop at the scope boundary rather than scanning the file.
!===============================================================================================
VitEngine.HasSiblingOver Procedure(LONG pSymRow, STRING pNameU)
r   long,auto
sc  long,auto
res long,auto
  code
  res = 0
  get(self.syms.syms, pSymRow)
  if errorcode() then return 0.
  sc = self.syms.syms.scopeId
  loop r = pSymRow - 1 to 1 by -1
    get(self.syms.syms, r)
    if errorcode() then break.
    if self.syms.syms.scopeId <> sc then break.
    if ~self.DeclHasAttr(self.syms.syms.declTok, 'OVER') then cycle.
    if self.DeclLineMentions(self.syms.syms.declTok, pNameU) then res = 1 ; break.
  end
  if ~res
    loop r = pSymRow + 1 to records(self.syms.syms)
      get(self.syms.syms, r)
      if errorcode() then break.
      if self.syms.syms.scopeId <> sc then break.
      if ~self.DeclHasAttr(self.syms.syms.declTok, 'OVER') then cycle.
      if self.DeclLineMentions(self.syms.syms.declTok, pNameU) then res = 1 ; break.
    end
  end
  if ~res
    do OverInStructure         ! a GROUP or RECORD opener has no symbol row to walk
  end
  get(self.syms.syms, pSymRow) ! restore the caller's buffer
  return res

! ---- A STRUCTURE DECLARATION IS INVISIBLE TO THE TWO WALKS ABOVE. They step through SYMBOL
!      ROWS, and VitSymbols.Build gives a GROUP/RECORD opener no row at all - it skips the whole
!      structure with `x = t2 ; cycle`, and the MEMBERS carry no OVER of their own, the opener
!      does. So `GROUP,OVER(p)` was missed, LABELLED OR NOT, while `sh SHORT,OVER(p)` was seen -
!      and that is the commonest aliasing shape in Clarion.
!      WHAT IT COST, and it is the harm this guard exists to stop, measured in kroverlap.clw:
!      KnownRanges runs BY DEFAULT and only ever REMOVES a guard. With the alias invisible it
!      deleted `if p >= 0 then f = 1.` from a procedure where a write through the group had just
!      made p -5. A wrong transform on the user's own code. O1 in that fixture pins the scalar
!      spelling; O3 and O4 pin the two structure spellings.
!      SO THE LAST WORD IS A TOKEN SCAN of the scope, for the attribute itself rather than for a
!      declaration carrying it. It runs only when the symbol walks have already failed, so the
!      keyed walks still answer every case they used to. A variable that happens to be CALLED
!      `over` would make this refuse where it need not - which is the safe direction, and the only
!      direction this guard is allowed to be wrong in.
OverInStructure routine
  data
ovT   long,auto
ovSv  long,auto
  code
  ovSv = pointer(self.syms.scopes)
  get(self.syms.scopes, sc)                  ! scopes are addressed positionally by scopeId here
  if errorcode() then exit.
  loop ovT = self.syms.scopes.startTok to self.syms.scopes.endTok
    get(self.tk.tokens, ovT)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) <> 'OVER' then cycle.
    get(self.tk.tokens, ovT + 1)             ! OVER ( name ) - the attribute, spelled out
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '(' then cycle.
    get(self.tk.tokens, ovT + 2)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = pNameU
      res = 1
      break
    end
  end
  get(self.syms.scopes, ovSv)      ! the scopes buffer belongs to the caller

! ------------------------------------------------------------------------------------
! Does the declaration whose label is pDeclTok give the variable an INITIAL VALUE? AUTO means it
! has none (ruled 17 Oct 2026). 1 = a number's: a number type with a bracket - LONG(0), BYTE(5),
! REAL(1.5) - or a DECIMAL or PDECIMAL with a THIRD argument, after the size and the places; that
! value can go. 2 = a STRING, CSTRING or PSTRING whose bracket holds a quoted literal, which sets its
! length as well (a number there is the length, an @ the picture). 0 = none.
! ------------------------------------------------------------------------------------
VitEngine.DeclHasInitValue Procedure(LONG pDeclTok)
t    long,auto
k    long,auto
dep  long,auto
cm   long,auto
tU   string(vs:maxName),auto
  code
  t = pDeclTok + 1
  tU = upper(self.tk.GetTok(t))
  if self.tk.GetTok(t + 1) <> '(' then return 0.
  case tU
  of 'STRING' orof 'CSTRING' orof 'PSTRING' orof 'ASTRING'
    if sub(self.tk.GetTok(t + 2), 1, 1) = '''' then return 2. ! the literal sets the length as well: it cannot simply go
    return 0
  of 'DECIMAL' orof 'PDECIMAL'
    dep = 0 ; cm = 0
    loop k = t + 1 to t + 40
      if self.IsEolTok(k) then break.
      case self.tk.GetTok(k)
      of '('
        dep += 1
      of ')'
        dep -= 1
        if dep < 1 then break.
      of ','
        if dep = 1 then cm += 1.
      end
    end
    return choose(cm >= 2)
  of   'BYTE'  orof 'SHORT'  orof 'USHORT' orof 'LONG'  orof 'ULONG'   orof 'SIGNED'  orof 'UNSIGNED' |
  orof 'INT64' orof 'UINT64' orof 'REAL'   orof 'SREAL' orof 'BFLOAT4' orof 'BFLOAT8' orof 'DATE'     |
  orof 'TIME'  orof 'BOOL'
    return 1
  end
  return 0

! ------------------------------------------------------------------------------------
! Take a number's initial value out of the declaration whose label is pDeclTok - the whole bracket
! of LONG(0), the third argument of DECIMAL(7,2,1) - and give back in pWas what the type was
! written as, for the note. Returns 1 when something went.
! ------------------------------------------------------------------------------------
VitEngine.DropInitValue Procedure(LONG pDeclTok, StringTheory pWas)
t    long,auto
o    long,auto
c    long,auto
k    long,auto
dep  long,auto
cm   long,auto
  code
  t = pDeclTok + 1
  o = t + 1
  if self.tk.GetTok(o) <> '(' then return 0.
  c = self.tk.MatchLeftBracket('(', ')', o)
  if c <= o then return 0.
  self.IsuSpanText(t, c, pWas)
  case upper(self.tk.GetTok(t))
  of 'DECIMAL' orof 'PDECIMAL'
    dep = 0 ; cm = 0
    loop k = o to c
      case self.tk.GetTok(k)
      of '('
        dep += 1
      of ')'
        dep -= 1
      of ','
        if dep = 1
          cm += 1
          if cm = 2
            self.tk.DeleteToks(k, c - 1)                                           ! `, 1` - the size and the places stay
            return 1
          end
        end
      end
    end
    return 0
  end
  self.tk.DeleteToks(o, c)                                                         ! `(0)` - the bracket and all of it
  return 1

! ------------------------------------------------------------------------------------
! Does the declaration line carry pAttrU (AUTO/OVER/DIM) as a real bare token?
! (An 'AUTO' inside NAME('..AUTO..') is a quoted literal token, not caught.) An attribute
! is a bare word straight after a comma, outside every bracket, so a field NAMED Auto in
! OVER(Auto) or LIKE(Auto) is not the attribute.
! ------------------------------------------------------------------------------------
VitEngine.DeclHasAttr Procedure(LONG pDeclTok, STRING pAttrU)
i     long,auto
ln    long,auto
aU    string(vs:maxName),AUTO
daDep long
daCm  byte
  code
  aU = upper(pAttrU)
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    ! *** A DECLARATION IS A LOGICAL LINE, NOT A PHYSICAL ONE. *** A lineNo change ends it
    ! only when the new token's trivia holds no '|' continuation: `sh SHORT,|` / `OVER(p)`
    ! carries an OVER, and ',DIM(3)' can sit past a '|' too.
     if self.tk.tokens.lineNo <> ln
       if ~self.TriviaHasContinuation(self.tk.tokens.strBefore) then break.
       ln = self.tk.tokens.lineNo ! the declaration carries on here
     end
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = 'b' and ~daDep and daCm
      if upper(self.tk.tokens.tok) = aU then return true.
    end
    if self.tk.tokens.tok = '(' then daDep += 1.
    if self.tk.tokens.tok = ')' then daDep -= 1.
    if self.tk.tokens.tok <> '|' then daCm = choose(self.tk.tokens.tok = ',').
  end
  return false

! ------------------------------------------------------------------------------------
! Last non-trivia token of the declaration statement (the logical line, continuations included).
! ------------------------------------------------------------------------------------
VitEngine.DeclLastTok Procedure(LONG pDeclTok)
i    long,auto
ln   long,auto
last long,auto
  code
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return pDeclTok.
  ln = self.tk.tokens.lineNo
  last = pDeclTok
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    ! *** A DECLARATION IS A LOGICAL LINE, NOT A PHYSICAL ONE. *** A lineNo change ends it
    ! only when the new token's trivia holds no '|' continuation: `sh SHORT,|` / `OVER(p)`
    ! carries an OVER, and ',DIM(3)' can sit past a '|' too.
     if self.tk.tokens.lineNo <> ln
       if ~self.TriviaHasContinuation(self.tk.tokens.strBefore) then break.
       ln = self.tk.tokens.lineNo                                               ! the declaration carries on here
     end
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then break. ! CHR(10) EOL token carries lineNo=ln (vitTokenize SetLineNumbers): stop BEFORE it,
                                                                                !   else ',AUTO' merges onto the newline and renders at the next line's start
    last = i
  end
  return last

! ------------------------------------------------------------------------------------
! Append ',AUTO' to the declaration by merging it onto the last decl token (byte-safe
! on output; a later reparse re-splits on the comma). 1 = edited.
! ------------------------------------------------------------------------------------
VitEngine.AddAutoAttr Procedure(LONG pDeclTok)
last   long,auto
i      long,auto
ln     long,auto
k      long,auto
c      long,auto
hasUp  byte,auto
hasLo  byte,auto
cur    StringTheory
tyStr  string(vs:maxName)
autoTx string(4),auto
  code
  last = self.DeclLastTok(pDeclTok)
  cur.setValue(self.tk.getTok(last))
  if ~cur._DataEnd then return 0.
  ! match the ,AUTO case to the data-type keyword's case
  ! (string -> ,auto ; STRING -> ,AUTO ; String -> ,Auto).  Clarion '=' is caseless,
  ! so classify by byte value (val), not a string compare.
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  tyStr = ''
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.lineNo <> ln then break.
    if self.tk.tokens.tok &= NULL then cycle.
    tyStr = self.tk.tokens.tok                ! first token after the label = the data-type keyword
    break
  end
  hasUp = 0 ; hasLo = 0
  loop k = 1 to len(clip(tyStr))
    c = val(tyStr[k])
    if c >= 65 and c <= 90  then hasUp = 1.   ! A-Z
    if c >= 97 and c <= 122 then hasLo = 1.   ! a-z
  end
  if hasLo and ~hasUp
    autoTx = 'auto'
  elsif hasUp and hasLo
    autoTx = 'Auto'
  else
    autoTx = 'AUTO'                           ! all-caps or no letters -> AUTO
  end
  cur.append(',' & clip(autoTx))
  self.tk.SetTok(last, cur.valuePtr[1 : cur._DataEnd])
  return 1

! ------------------------------------------------------------------------------------
! Strip ',AUTO' (the AUTO token and its preceding comma) and append the NOTE as a
! trailing line comment. 1 = edited.
! ------------------------------------------------------------------------------------
VitEngine.RemoveAutoAttr Procedure(LONG pDeclTok, StringTheory pNote)
i      long,auto
ln     long,auto
autoT  long,auto
commaT long,auto
barT   long,auto    ! a '|' token seen on the current physical line - the declaration continues
cmtAt  long,auto    ! position of a '!' in the trivia of a token that goes - a comment riding the continuation
svCmt  StringTheory ! ...salvaged onto the note line, or the user's text vanishes with the span
raPc   StringTheory ! one token's comment, before it joins svCmt
raDep  long         ! bracket depth - an attribute stands outside every bracket
raCm   byte         ! the last token that was not a '|' was a comma
  code
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  autoT = 0 ; commaT = 0 ; barT = 0
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.lineNo <> ln
      if ~barT                                                                      ! not continued by a trailing '|' token - the bar can also live
        if self.tk.tokens.strBefore &= NULL then break.
        if ~self.TriviaHasContinuation(self.tk.tokens.strBefore) then break.        ! ...in the next token's trivia
      end
      ln = self.tk.tokens.lineNo                                                    ! an ,AUTO after a '|' is still THIS declaration - follow it
      barT = 0
    end
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '|' then barT = 1.
    if self.tk.tokens.type = 'b' and upper(self.tk.tokens.tok) = 'AUTO' and ~raDep and raCm ! the attribute, not a field NAMED Auto inside OVER(Auto)
      autoT = i
      break
    end
    if self.tk.tokens.tok = '(' then raDep += 1.
    if self.tk.tokens.tok = ')' then raDep -= 1.
    if self.tk.tokens.tok = ',' then commaT = i.                                    ! remember the most recent comma before AUTO
    if self.tk.tokens.tok <> '|' then raCm = choose(self.tk.tokens.tok = ',').
  end
  if ~autoT then return 0.
  svCmt.free()                                                                      ! a comment riding the continuation ('long, | !keep') lives in
  loop i = choose(commaT > 0 and commaT < autoT, commaT, autoT) to autoT            !   the trivia of a token the edit deletes - AUTO's, or the comma's
    get(self.tk.tokens, i)                                                          !   (`v LONG |  ! note` / `,AUTO`) - and would vanish with the span:
    if errorcode() or self.tk.tokens.strBefore &= NULL then cycle.                  !   every one is salvaged onto the note line instead
    cmtAt = pNote.findByte(33, 1,, self.tk.tokens.strBefore)                        ! '!'
    if ~cmtAt then cycle.
    raPc.setValue(self.tk.tokens.strBefore[cmtAt : size(self.tk.tokens.strBefore)])
    raPc.replaceByte(13, 32) ; raPc.replaceByte(10, 32) ; raPc.removeByte(124)      ! replace all <carriage return> with <space>  ! replace all <line feed> with <space>  ! remove all '|'
    raPc.trim()
    if svCmt._DataEnd then svCmt.append('  ').
    svCmt.append(raPc)
  end
  if commaT and commaT < autoT
    self.tk.DeleteToks(commaT, autoT)                                               ! remove ',AUTO' (comma + keyword together)
  else
    self.tk.DeleteToks(autoT, autoT)                                                ! defensive: AUTO with no leading comma
  end
  ! Insert on a MID-LINE token (pDeclTok+1 = the type keyword), NOT the col-1 label:
  ! InsertStringAtEOL walks forward to the line's <10> EOL token, but a first-on-line
  ! label has an empty strBefore, so starting there trips its 'expecting continuation
  ! line' stop.  pDeclTok+1 sits before the just-deleted comma, so the DeleteToks above
  ! does not shift its index.  pComment=1 supplies the '!' itself (as VitRewrite's NOTE does).
  self.tk.InsertStringAtEOL(pDeclTok + 1, clip(pNote.getValue()) & choose(svCmt._DataEnd < 1, '', '  ' & clip(svCmt.getValue())), 1)
  return 1

! ------------------------------------------------------------------------------------
VitEngine.LineOfTok Procedure(LONG pTok)
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return 0.
  return self.tk.tokens.lineNo

! ------------------------------------------------------------------------------------
! LOG-facing line of a token. In the preview (tk.mapOn armed) the change log
! must carry SOURCE line numbers - the Changes list clicks land without any guesswork;
! in batch (mapOn 0) MapLine is identity so reports stay byte-identical. Use in pLog
! emission ONLY - logic must keep using LineOfTok (stream coordinates).
! ------------------------------------------------------------------------------------
VitEngine.LogLineOf Procedure(LONG pTok)
  code
  return self.tk.MapLine(self.LineOfTok(pTok))

! ------------------------------------------------------------------------------------
! Single-char helpers. A "single char" is:
! a bare digit 0-9 (the digit character), or a quoted literal whose content is
! one char: 'x', a doubled pair ''/<<//{{, or one char-code group '<nnn>' with
! nnn 0-255. Multi-value groups like '<13,10>' are NOT single.
! ------------------------------------------------------------------------------------
VitEngine.GetSingleCharVal Procedure(STRING pStr)
s      StringTheory
inner  StringTheory
n      long,auto
  code
  s.setValue(pStr)
  s.trim()
  if s._DataEnd = 1
    if s.valuePtr[1] >= '0' and s.valuePtr[1] <= '9' then return val(s.valuePtr[1]).
    return -1
  end
  if s._DataEnd < 3 or                                                        |
     s.valuePtr[1] <> '''' or s.valuePtr[s._DataEnd] <> ''''
    return -1
  end
  inner.setValue(s.valuePtr[2 : s._DataEnd - 1])
  case inner._DataEnd
  of 1
    return val(inner.valuePtr[1])
  of 2
    if inner._DataEnd = 2 and inner.valuePtr[1 : 2] = '''''' then return 39.  ! <single quote>           ! '' -> the quote char
    if inner._DataEnd = 2 and inner.valuePtr[1 : 2] = '<<<<' then return 60.  ! '<<'           ! << -> <
    if inner._DataEnd = 2 and inner.valuePtr[1 : 2] = '{{{{' then return 123. ! '{{'           ! {{ -> {
    return -1
  else
    if inner.valuePtr[1] = '<<' and inner.valuePtr[inner._DataEnd] = '>'
      inner.setValue(inner.valuePtr[2 : inner._DataEnd - 1])
      if inner._DataEnd and inner.IsAllDigits()
        n = inner.getValue()
        if n >= 0 and n <= 255 then return n.
      end
    end
    return -1
  end

! ------------------------------------------------------------------------------------
VitEngine.IsSingleChar Procedure(STRING pStr)
  code
  if self.GetSingleCharVal(pStr) = -1 then return false.
  return true

! ------------------------------------------------------------------------------------
! The BYTES a RAW quoted literal stands for, escapes read, into pOut: '' is one quote,
! << one '<', {{ one '{', <a,b,...> one byte per decimal code, C{n} the character before
! the brace n times in all. 0 = not a literal of that grammar (a code that is not
! decimal, a stray quote, an unclosed group, a repeat with nothing before it), and pOut
! then holds only what was read up to the fault.
! ------------------------------------------------------------------------------------
VitEngine.LitBytes Procedure(STRING pLit, StringTheory pOut)
n     long,auto
i     long,auto
j     long,auto
v     long,auto
rep   long,auto
  code
  pOut.free()
  n = len(clip(pLit))
  if n < 2 or pLit[1] <> '''' or pLit[n] <> '''' then return 0.
  i = 2
  loop while i <= n - 1
    case val(pLit[i])
    of 39                                                 ! '' - one quote
      if i + 1 > n - 1 or pLit[i + 1] <> '''' then return 0.
      pOut.append(pLit[i])
      i += 2
    of 60                                                 ! '<<' - one '<', else a <a,b,...> group
      if i + 1 <= n - 1 and pLit[i + 1] = '<<' then pOut.append(pLit[i]) ; i += 2 ; cycle.
      j = i + 1
      loop
        loop while j <= n - 1 and pLit[j] = ' '
          j += 1
        end
        v = -1
        loop while j <= n - 1 and val(pLit[j]) >= 48 and val(pLit[j]) <= 57
          if v < 0 then v = 0.
          v = v * 10 + pLit[j]
          j += 1
        end
        if j > n - 1 or v < 0 or v > 255 then return 0.
        pOut.append(chr(v))
        if pLit[j] = '>' then break.
        if pLit[j] <> ',' then return 0.
        j += 1
      end
      i = j + 1
    of 123      ! '{{' - one '{', else C{n}
      if i + 1 <= n - 1 and pLit[i + 1] = '{{' then pOut.append(pLit[i]) ; i += 2 ; cycle.
      if ~pOut._DataEnd then return 0.
      rep = 0
      j = i + 1
      loop while j <= n - 1 and val(pLit[j]) >= 48 and val(pLit[j]) <= 57
        rep = rep * 10 + pLit[j]
        j += 1
      end
      if j > n - 1 or pLit[j] <> '}' or rep < 1 then return 0.
      v = val(pOut.valuePtr[pOut._DataEnd])
      loop while rep > 1
        pOut.append(chr(v))
        rep -= 1
      end
      i = j + 1
    else
      pOut.append(pLit[i])
      i += 1
    end
  end
  return 1

! ------------------------------------------------------------------------------------
! Pretty names for generated comments (NOT VitTokenize.DescribeChar, which is a hex
! debug aid).
! ------------------------------------------------------------------------------------
VitEngine.CharName Procedure(STRING pStr)
nm  string(24),auto
  code
  ! the table lives in VitTokenize (CharNameOfByte) so the rule-file charname() helper
  ! shares it - two copies would drift the moment one gained an entry.
  nm = self.tk.CharNameOfByte(self.GetSingleCharVal(pStr))
  if nm then return clip(nm).
  return clip(left(pStr))

! ------------------------------------------------------------------------------------
! Truncate a RAW quoted literal (outer quotes present, escapes intact) to
! pWant logical characters. Escape-aware like VitMatch.LitLength: doubled
! pairs stay pairs, '<13,10>' groups keep only the values needed, 'A{5}'
! repeat counts are reduced. Result is re-quoted raw text. Used by CheckCat.
! ------------------------------------------------------------------------------------
VitEngine.LitTruncate Procedure(StringTheory pInOut, LONG pWant)
out   StringTheory
grp   StringTheory
n     long
i     long,auto
j     long,auto
k     long,auto
rep   long,auto
take  long,auto
  code
  if pInOut._DataEnd < 2 or                                                 |
     pInOut.valuePtr[1] <> '''' or pInOut.valuePtr[pInOut._DataEnd] <> ''''
    return
  end
  out.setValue('''')
  i = 2
  loop while i <= pInOut._DataEnd - 1 and n < pWant
    if i < pInOut._DataEnd - 1
      case pInOut.valuePtr[i : i+1]
      of '''''' orof '<<<<' orof '{{{{'
        out.append(pInOut.valuePtr[i : i+1])
        n += 1
        i += 2
        cycle
      end
    end
    if pInOut.valuePtr[i] = '<<'                                            ! char-code group
      j = i + 1
      loop while j <= pInOut._DataEnd - 1 and pInOut.valuePtr[j] <> '>'
        j += 1
      end
      if j > pInOut._DataEnd - 1 or j = i + 1 then break.                   ! malformed: stop here
      grp.setValue(pInOut.valuePtr[i+1 : j-1])
      grp.split(',')
      take = pWant - n
      if take > grp.records() then take = grp.records().
      out.append('<<')
      loop k = 1 to take
        if k > 1 then out.append(',').
        out.append(clip(left(grp.getLine(k))))
      end
      out.append('>')
      n += take
      i = j + 1
      cycle
    end
    if pInOut.valuePtr[i] = '{{'                                            ! repeat group: previous char counted once already
      j = i + 1
      loop while j <= pInOut._DataEnd - 1 and pInOut.valuePtr[j] <> '}'
        j += 1
      end
      if j > pInOut._DataEnd - 1 or j = i + 1 or ~n then break.
      grp.setValue(pInOut.valuePtr[i+1 : j-1])
      if ~grp.IsAllDigits() then break.
      rep = grp.getValue()
      take = pWant - n
      if take > rep - 1 then take = rep - 1.
      if take > 0
        out.append('{{' & (take + 1) & '}')
        n += take
      end
      i = j + 1
      cycle
    end
    out.append(pInOut.valuePtr[i])
    n += 1
    i += 1
  end
  out.append('''')
  pInOut.setValue(out)

! ------------------------------------------------------------------------------------
! True when any strBefore in the token span carries a line break - i.e. the
! span crosses a continuation or holds a comment. Builtins that rejoin and
! reflow argument lists skip such spans so trivia is never lost.
! ------------------------------------------------------------------------------------
VitEngine.SpanHasNL Procedure(LONG pS, LONG pE)
x  long,auto
  code
  loop x = pS to pE
    get(self.tk.tokens, x)
    if errorcode() then return true. ! defensive: treat unknown as unsafe
    if self.tk.tokens.tok &= NULL then return true.
    if self.tk.tokens.tok = '<10>' then return true.
    if not self.tk.tokens.strBefore &= NULL
      if instring('<10>', self.tk.tokens.strBefore, 1, 1) then return true.
    end
  end
  return false

! ------------------------------------------------------------------------------------
! BUILTIN RemoveDoubledBrackets - port of the vtxaDiff009 routine.
! foo((x)) -> foo(x): the inner pair must bracket exactly the same extent. The pair
! is skipped when the outer (, the inner ( or the outer ) starts a new line, so a
! continuation or a comment in their strBefore is never lost; what stands in front
! of the outer ( - the space in `if ((x))` - moves onto the inner one.
! ------------------------------------------------------------------------------------
VitEngine.BuiltinDoubledBrackets Procedure(StringTheory pLog)
startTok     long
endBracket   long,auto
lineNo       long,auto
changes      long
stB          StringTheory
stT          StringTheory
stI          StringTheory
  code
  loop
    startTok = self.tk.FindSeq(',^ (, (', startTok+1)                           ! look for ( (
    if ~startTok then break.
    endBracket = self.tk.MatchLeftBracket('(',')',startTok)
    if ~endBracket then cycle.                                                  ! shouldn't happen
    if self.tk.MatchLeftBracket('(',')',startTok+1) <> endBracket-1 then cycle. ! not matching doubled brackets
    self.tk.GetTok(startTok+1, stB, stT)                                        ! inner ( on a continuation line? skip the pair
    if stB.containsByte(10) then cycle.                                         ! <line feed>
    self.tk.GetTok(endBracket, stB, stT)                                        ! outer ) on a continuation line? skip the pair
    if stB.containsByte(10) then cycle.                                         ! <line feed>
    self.tk.GetTok(startTok + 1, stI, stT)
    self.tk.GetTok(startTok, stB, stT)                                          ! outer ( on a new line or past a continuation? skip the pair
    if stB.containsByte(10) then cycle.                                         ! <line feed>
    stB.append(stI)                                                             ! its trivia goes in front of the inner (
    self.tk.getTok(startTok)
    lineNo = self.tk.tokens.lineNo
    self.tk.deleteTok(endBracket)                                               ! delete duplicated outer brackets - do end bracket first!
    self.tk.deleteTok(startTok)
    self.tk.SetStrBefore(startTok, stB.getValue())
    pLog.append('BUILTIN RemoveDoubledBrackets line ' & self.tk.MapLine(lineNo) & ': doubled brackets removed<13,10>')
    startTok -= 1                                                               ! restart from the same place - that bracket is gone
    changes += 1
  end
  return changes

! ------------------------------------------------------------------------------------
VitEngine.RejoinReparse Procedure()
whole  StringTheory
svMap  BYTE,AUTO
t0     LONG,AUTO
  code
  t0 = clock()
  self.nReparse += 1
  svMap = self.tk.mapOn
  if svMap
    self.tk.MapFold()      ! compose the preview line map BEFORE the re-lex frees the tokens
    self.tk.mapOn = 0      ! ParseText restamps a FRESH stream - it must not fold garbage coordinates
  end
  self.tk.JoinToks(whole)
  self.tk.FreeToks()
  self.tk.ParseText(whole)
  self.tk.mapOn = svMap
  self.rw.m.Changed()      ! token queue rebuilt - anchor counts stale
  self.rw.m.patchable = 0  !   every position is new: the full walk, not a patch
  self.rulesDirty = 0      ! whoever reparses, the stream is fresh - pending level-hazard debt is paid
  self.syms.Build(self.tk)
  self.tReparse += self.TicksSince(t0)

! ------------------------------------------------------------------------------------
! clock() ticks (hundredths of a second) since pT0, across midnight
! ------------------------------------------------------------------------------------
VitEngine.TicksSince Procedure(LONG pT0)
d  long,auto
  code
  d = clock() - pT0
  if d < 0 then d += 8640000.
  return d

! ------------------------------------------------------------------------------------
! --timing: add one call's ticks and changes to pName's row of pQ, a new row on the first
! call. The queue is kept in name order so GET by name finds the row; TimeBreakdown sorts
! it by time at the end of the file, and TransformFile frees it before the next file.
! ------------------------------------------------------------------------------------
VitEngine.NoteTime Procedure(TimeRowQType pQ, STRING pName, LONG pTicks, LONG pChg)
  code
  pQ.trName = pName
  get(pQ, pQ.trName)
  if errorcode()
    clear(pQ)
    pQ.trName  = pName
    pQ.trTicks = pTicks
    pQ.trCalls = 1
    pQ.trChg   = pChg
    add(pQ, pQ.trName)
  else
    pQ.trTicks += pTicks
    pQ.trCalls += 1
    pQ.trChg   += pChg
    put(pQ)
  end

! ------------------------------------------------------------------------------------
! --timing: how the log names the current rule - its id, and its NAME(...) when it has one.
! ------------------------------------------------------------------------------------
VitEngine.RuleTag Procedure()
  code
  if ~self.rl.rules.ruleName then return 'rule ' & self.rl.rules.ruleId.
  return 'rule ' & self.rl.rules.ruleId & ' ' & clip(self.rl.rules.ruleName)

! ------------------------------------------------------------------------------------
! --timing: clock ticks as seconds with two decimals and no padding, for a report line.
! ------------------------------------------------------------------------------------
VitEngine.Secs Procedure(LONG pTicks)
  code
  return clip(left(format(pTicks / 100, @n_9.2)))

! ------------------------------------------------------------------------------------
! --timing: the breakdown after the summary line - every built-in that ran in this file,
! slowest first, then the ten slowest rules and one line for all the rest. A built-in's
! time is its own pass; a re-lex it asked for is in the summary line's re-lexes figure.
! ------------------------------------------------------------------------------------
VitEngine.TimeBreakdown Procedure(STRING pFn, StringTheory pLog)
i        long,auto
restT    long
restN    long
restC    long
  code
  sort(self.biTime, -self.biTime.trTicks)
  loop i = 1 to records(self.biTime)
    get(self.biTime, i)
    pLog.append(clip(pFn) & ': timing - built-in ' & clip(self.biTime.trName) & ' ' & self.Secs(self.biTime.trTicks) & 's (' & |
                self.biTime.trCalls & ' pass(es), ' & self.biTime.trChg & ' change(s))<13,10>')
  end
  sort(self.ruTime, -self.ruTime.trTicks)
  loop i = 1 to records(self.ruTime)
    get(self.ruTime, i)
    if i <= 10
      pLog.append(clip(pFn) & ': timing - ' & clip(self.ruTime.trName) & ' ' & self.Secs(self.ruTime.trTicks) & 's (' &        |
                  self.ruTime.trCalls & ' scan(s), ' & self.ruTime.trChg & ' change(s))<13,10>')
    else
      restT += self.ruTime.trTicks ; restN += self.ruTime.trCalls ; restC += self.ruTime.trChg
    end
  end
  if restN
    pLog.append(clip(pFn) & ': timing - the other ' & (records(self.ruTime) - 10) & ' rules ' & self.Secs(restT) & 's (' &     |
                restN & ' scan(s), ' & restC & ' change(s))<13,10>')
  end

! ------------------------------------------------------------------------------------
! ------------------------------------------------------------------------------------
! TXA SUPPORT. A .txa is a template EXPORT, not Clarion source: the code you wrote lives
! inside [SOURCE] blocks scattered through template markup, and it starts in COLUMN 1 -
! which in Clarion is label position. Handed straight to the tokenizer, every one of those
! lines reads as a label and the whole analysis is wrong.
!
! So the file is wrapped: made to look like Clarion on the way in, and put back exactly on
! the way out. The marker protocol is reversible by construction - every edit leaves a mark
! saying how to undo it, and TxaPostProcess undoes them in the opposite order:
!
!   <253>        a line joined onto the one before it        -> becomes <10> again
!   !<255>       the lifted application header               -> the marker is removed
!   !<250>       a template-data line, commented out          -> the marker is removed
!   !<252,10>    a whole line this pass INSERTED             -> the line is removed
!   !<251,10>    a line shifted one column right             -> marker and the space removed
!
! Those FIVE marker bytes are chosen because they cannot occur in a .txa: it is plain text, and
! 251-255 are not produced by the template writer.
!
! WHAT IT DOES, in order:
!   1. Normalises to LF so every position test below is counting one byte per line end.
!   2. An [APPLICATION] export holds several applications; each is processed separately and
!      the results re-joined, because the header lift in step 3 is per application.
!   3. Everything before the program's first [DATA] is application and template metadata -
!      dictionary references, template registrations, the procedure list. None of it is
!      Clarion, so it is lifted out behind a !<255> marker rather than parsed.
!   4. A `WHEN` continuation (a line ending '|') is folded onto its own first line, so the
!      tokenizer sees one statement rather than a fragment per line.
!   5. Each [PROCEDURE] gets a synthesised `<name> PROCEDURE(<params>)` header inserted
!      ahead of it, marked !<252,10>. The TXA has the name and PARAMETERS as template
!      fields, not as a Clarion header, so without this there is no scope for a procedure's
!      declarations and code to belong to.
!   6. Inside a [SOURCE] block that belongs to a CODE embed, a line starting in column 1 is
!      shifted one space right and marked !<251,10>. Only code embeds: a DATA embed's
!      column-1 text really is a label and must stay where it is. The embed kind is found
!      by scanning BACK from the [SOURCE] line to the enclosing EMBED, which is why this
!      cannot be done a line at a time.
!   7. Every line OUTSIDE a [SOURCE] block is template data and is commented out behind a
!      !<250> marker, so no pass can touch it; the synthesised headers stay live.
! ------------------------------------------------------------------------------------
VitEngine.TxaPreProcess Procedure(StringTheory pSrc)
apps   StringTheory
one    StringTheory
out    StringTheory
x      long,auto
  code
  pSrc.LineEndings(st:unix)
  x = pSrc.count('[APPLICATION]<10>')
  if x < 2
    self.TxaPreOne(pSrc)            ! one application, or a procedure export
    return                          ! RETURN, not EXIT - EXIT leaves a ROUTINE
  end
  apps.setValue(pSrc)               ! several - each gets its own header lift
  apps.split('[APPLICATION]<10>')
  loop x = 1 to apps.records()
    if x = 1
      one.setValue(apps.getLine(x)) ! whatever stood BEFORE the first separator - see below
    else
      one.setValue('[APPLICATION]<10>' & apps.getLine(x))
    end
    if ~one._DataEnd then cycle.    ! the empty first field a leading separator always makes
    self.TxaPreOne(one)
    out.append(one)
  end
  pSrc._StealValue(out)
  ! RECORD 1 IS NOT AN APPLICATION, IT IS WHATEVER PRECEDED THE FIRST ONE.
  !     Splitting a value that BEGINS with the separator always yields an EMPTY first field -
  !     splitNoQuotes starts at 1 and its AddLine sets the end to (separator position - 1), which is
  !     zero. Prefixing every record would turn N applications into N+1, with a phantom empty
  !     application at the top of the file that re-imports as one. So record 1 goes through
  !     unprefixed and is skipped when empty: a file starting with the separator loses nothing and
  !     a file carrying a preamble before its first application keeps it verbatim.

! ---- one application (or one procedure export). See the header above for the steps. ----
VitEngine.TxaPreOne Procedure(StringTheory pSt)
hdr        StringTheory ! the lifted metadata, flattened to one line
tmp        StringTheory
proc       StringTheory
stPos      long,auto
endPos     long,auto
xx         long,auto
codeLine   long,auto
str8       string(8),auto
! #Removed as not used: wln        StringTheory   ! the whole line, so the word-boundary test can look past str8's eight characters
wx         long,auto
inSrc      long,auto    ! inside a [SOURCE] block (step 7)
borrowedLf long,auto    ! step 5 lent the text a leading line feed and owes it back
px         long,auto    ! step 5: a position in the PARAMETERS text
inQ        byte,auto    ! step 5: inside a quoted literal there
inData     byte,auto    ! step 6: inside a PROCEDURE's or ROUTINE's own declarations
afterRtn   byte,auto    ! step 6: the line before was a ROUTINE header, so DATA may open its declarations
w1U        string(32)   ! step 6: the line's first word, upper case
w2U        string(32)   ! step 6: and its second
lnSt       StringTheory ! step 6: the line being read
gtSt       StringTheory ! step 6: every name a GOTO jumps to, upper case, each between spaces
! #Removed as not used: gtAt       long,auto    ! step 6: where the line's first word stands among them, 0 = not one
  code
  ! ---- 3. lift the application/template metadata ----
  if pSt.startsWith('[APPLICATION]')
    stPos = pSt.findChars('[PROGRAM]<10>')
    stPos = pSt.findChars('<10>[DATA]<10>', stPos)        ! THE LEADING <10> IS PART OF THE MATCH AND IS LOAD-BEARING - see below
    if stPos > 1
      hdr.setValue('!<255>')
      hdr.append(pSt.valuePtr[1 : stPos - 1])             ! everything BEFORE that line feed
      pSt.removeFromPosition(1, stPos)                    ! ...and the line feed with it, so the body starts at '[DATA]'
      hdr.replaceByte(10,253)                             ! the whole header is now ONE line  ! replace all <line feed> with '<253>'
      pSt.prepend(hdr.getValue() & '<10>')                ! the line feed added here stands in EXACTLY for the one removed
    end
  end
  ! THE LIFT MUST REMOVE EXACTLY WHAT IT PUTS BACK.
  !     Searching for '[DATA]<10>' returns the position of the MATCH START - the '[' itself - so a
  !     slice on that alone lifts the '[' into the header while removeFromPosition takes it out of
  !     the body, leaving the body starting 'DATA]'. The prepend then adds a line feed that nothing
  !     ever removes, and the file comes back with a line holding just '[' and the next line
  !     starting 'DATA]', which breaks re-import. Searching for the line feed TOO makes stPos point
  !     at that line feed instead, so the header ends where the line ends and the added line feed
  !     replaces the removed one byte for byte.
  !     It also self-guards: a '[DATA]' not at the start of a line does not match at all, and the
  !     lift is skipped rather than eating a real character off the front of it.
  !     The shape comes from a DIFF tool, which wraps both sides the same way and never writes the
  !     text back - so exact reconstruction does not matter there, and it does here.
  ! ---- 4. fold a WHEN continuation onto its first line ----
  stPos = 0
L loop
    stPos = pSt.findChars('<10>WHEN ', stPos+1)
    if ~stPos then break.
    stPos += 5
    loop
      stPos = pSt.findByte(10, stPos+1)                            ! <line feed>
      if ~stPos then break L.
      if pSt.valuePtr[stPos-1] <> '|' then break.
      pSt.valuePtr[stPos] = '<253>'
    end
  end
  ! ---- 5. give every [PROCEDURE] a real Clarion header to be a scope ----
  ! THE FIRST [PROCEDURE] IN THE FILE HAS NOTHING IN FRONT OF IT, AND THE SEARCH BELOW WANTS A
  !     LINE FEED THERE. A procedure export - much the commonest kind - STARTS with '[PROCEDURE]'
  !     at position 1, and a scan that stepped over it would leave every local in that procedure
  !     unscoped, quietly withheld from the analyses. A borrowed line feed goes on before the
  !     scan and comes off after, so the first procedure looks like all the others to one body
  !     of code, and the text this procedure returns is unchanged by the loan.
  borrowedLf = false
  if pSt.startsWith('[PROCEDURE]<10>NAME ')
    pSt.prepend('<10>')
    borrowedLf = true
  end
  stPos = 1
  loop
    endPos = 0
    tmp.setValue(pSt.FindBetween('<10>[PROCEDURE]<10>NAME ','<10>[', stPos, endPos))
    if ~stPos then break.
    stPos -= 17                                                    ! back to the '[' of [PROCEDURE]
    tmp.split('<10>')
    proc.setValue(tmp.getLine(1) & ' PROCEDURE ')
    tmp.setValueFromLine(tmp.InLine('PARAMETERS ',,,,,,st:begins))
    if tmp._DataEnd
      tmp.SetAfter('PARAMETERS ')
      tmp.trim()
      tmp.unquote('''','''')
      ! THE HEADER CARRIES NO COMMENT OF ITS OWN. A PARAMETERS value may hold one -
      !   `(STRING pStr) !,LONG` - and on the header it is a real trailing comment, ahead of
      !   the !<252> mark: the aligner moves it, counts the change, and the restore deletes the
      !   line, so the run reports a change it never made. The list ends at a '!' outside quotes.
      inQ = 0
      loop px = 1 to tmp._DataEnd
        if tmp.valuePtr[px] = '''' then inQ = 1 - inQ.
        if tmp.valuePtr[px] = '!' and ~inQ
          tmp.setLength(px - 1)
          break
        end
      end
      tmp.clip()
      proc.append(tmp)
    end
    proc.clip()
    proc.append(' !<252,10>')                             ! marked: this whole line is ours
    pSt.insert(stPos, proc)
    stPos = endPos + proc._DataEnd
  end
  if borrowedLf then pSt.removeFromPosition(1, 1).        ! give the line feed back - see the note above step 5
  ! ---- 6. shift column-1 CODE out of label position ----
  pSt.split('<10>')
  do TxaGotoTargets
  stPos = 0
  loop
    stPos = pSt.inline('[SOURCE]',,stPos+1,,,st:wholeLine)
    if ~stPos then break.
    codeLine = false
    loop xx = stPos to 1 by -1                            ! which embed does this block sit in?
      tmp.setValue(pSt.getLine(xx))
      if choose(tmp._DataEnd < 1, '', tmp.valuePtr[1 : tmp._DataEnd]) = 'WHEN ''Accepted''' then codeLine = true ; break.
      if choose(tmp._DataEnd < 1, '', tmp.valuePtr[1 : tmp._DataEnd]) = '[END]' then break.
      if not tmp.StartsWith('EMBED ') then cycle.
      if tmp.findChars('Code',7) or tmp.findChars('EventHandling',7)
        codeLine = true
        break
      end
      if tmp.findChars('Data',7) or tmp.findChars('Routines',7) or tmp.findChars('Procedures',7) then break.
    end
    if ~codeLine then cycle.                                       ! a DATA embed's column 1 is a real label
    endPos = pSt.inline('[END]',,stPos+1,,,st:wholeLine)
    if ~endPos then break.
    inData = 0 ; afterRtn = 0
    loop xx = stPos+1 to endPos-1
      str8 = pSt.getLine(xx)
      case str8
      of 'PROPERTY' orof 'PRIORITY' orof 'LABEL'
        ! str8 holds only the first EIGHT characters, so `PRIORITYX = 1` truncates
        ! straight into this arm - and `PRIORITY 5000` matched only BECAUSE of that same
        ! truncation. A directive is a WORD: require what follows it to be blank, nothing, or the
        ! ':' of PROPERTY:BEGIN / PROPERTY:END - which are directives too, and were being shifted.
        pSt.setValueFromLine(xx)
        wx = len(clip(str8)) + 1
        if wx > pSt._DataEnd or pSt.valuePtr[wx] = ' ' or pSt.valuePtr[wx] = '<9>' or pSt.valuePtr[wx] = ':'
          cycle                                           ! template directives, not code
        end
      end
      ! NOT EVERY COLUMN-1 LINE IN A CODE EMBED LOST ITS INDENT. A hand-written procedure keeps its
      ! ROUTINEs, local PROCEDUREs and their declarations in a code embed, and their labels are
      ! in column 1 because that is where a label goes. Shifted, a ROUTINE header stops being one,
      ! so the routine reads as code after the last statement and is judged unreachable.
      lnSt.setValue(pSt.getLine(xx))
      do TxaLineWords
      if inData
        if w1U = 'CODE' then inData = 0.                  ! the declarations end where the code starts
        if inData then cycle.                             ! a declaration: its column-1 label stays
      end
      if lnSt._DataEnd and lnSt.valuePtr[1] <> ' ' and lnSt.valuePtr[1] <> '<9>'
        case w2U
        of 'ROUTINE'
          afterRtn = 1                                    ! DATA may follow; CODE, or code, may not
          cycle
        of 'PROCEDURE' orof 'FUNCTION'
          inData = 1 ; afterRtn = 0                       ! its declarations follow, up to CODE
          cycle
        end
      end
      if afterRtn and w1U
        if w1U = 'DATA' then inData = 1.                  ! ROUTINE ... DATA: the routine's own declarations
        afterRtn = 0
      end
      ! A LABEL A GOTO JUMPS TO stays in column 1 as well. Shifted, `Done` or `Done x = 3` reads as
      ! a statement that begins with the name, and the code after `goto Done` reads as unreachable.
      if w1U and gtSt.findChars(' ' & clip(w1U) & ' ') then cycle.
      case val(str8[1])
      of 32 orof 33 orof 63 orof 124                      ! <space> orof '!' orof '?' orof '|'
        ! already clear of column 1, or a comment/continuation - leave it
      else
        pSt.setLine(xx, ' ' & pSt.getLine(xx) & '!<251>')
      end
    end
  end
  ! ---- 7. EVERYTHING OUTSIDE A [SOURCE] BLOCK IS TEMPLATE DATA. Comment it out.
  !      Template markup is a column-1 word followed by a value:
  !          NAME DrawMakeHeading
  !          FROM ABC Source
  !          PRIORITY 5000
  !      which is exactly the shape of a Clarion declaration, so AlignDeclTypes would line
  !      their "type column" up with the real declarations below and rewrite the template's
  !      own data.
  !      Commenting is used rather than shifting because a comment is inert to EVERYTHING -
  !      every rule, every builtin, every aligner - and this file has no business being
  !      changed outside the source the author embedded in it. The marker goes in column 1
  !      so the comment sits at position 1, which AlignComments skips (it ignores anything
  !      with Pos < 2), so these lines cannot become anchors for the real comments either.
  !      The synthesised PROCEDURE headers are NOT commented: they are what gives a
  !      procedure's declarations and code a scope to share.
  inSrc = 0
  loop xx = 1 to pSt.records()
    tmp.setValue(pSt.getLine(xx))
    if tmp.StartsWith('[SOURCE]') then inSrc = 1 ; cycle. ! the marker itself is data
    if tmp.StartsWith('[END]')    then inSrc = 0.         ! ... and so is this one
    if inSrc
      ! PROPERTY / PRIORITY / LABEL are template DIRECTIVES that live INSIDE a source
      ! block. They are not Clarion, and in column 1 they look exactly like a declaration
      ! label, so the aligners would reformat them - `PRIORITY 5000` lined up as
      ! `PRIORITY   5000` with the equates under it. The shift loop above already skips them
      ! for the same reason; they need protecting from the aligners as well.
      str8 = tmp.getValue()
      case str8
      of 'PROPERTY' orof 'PRIORITY' orof 'LABEL'
        wx = len(clip(str8)) + 1                          ! the same word-boundary test as above
        if wx > tmp._DataEnd or tmp.valuePtr[wx] = ' ' or tmp.valuePtr[wx] = '<9>' or tmp.valuePtr[wx] = ':'
          pSt.setLine(xx, '!<250>' & tmp.getValue())
        end
      end
      cycle                                               ! everything else here is real source
    end
    if tmp.findChars('!<252>') or                                  |   ! our own synthesised header - must stay live
       ~tmp._DataEnd                                               ! a blank line is already inert
      cycle
    end
    pSt.setLine(xx, '!<250>' & tmp.getValue())
  end
  ! ---- the [SOURCE] markers are data too. The loop above CYCLES on them - it has to set inSrc
  !      before anything else happens - so they are commented out here, exactly as [END] was
  !      there, and the post-process takes the mark off again. Uncommented lines on purpose: a
  !      commented marker is a comment-only line, and no layout pass moves those. ----
  loop xx = 1 to pSt.records()
    tmp.setValue(pSt.getLine(xx))
    if tmp.StartsWith('[SOURCE]') then pSt.setLine(xx, '!<250>' & tmp.getValue()).
  end
  ! ---- steps 6 and 7 both worked on the SPLIT line queue. Without this join none of those
  !      setLine writes reach the value the caller goes on to parse - the shift and the
  !      comment-out both silently do nothing, and the first sign of it is the template's own
  !      data coming back reformatted.
  pSt.join('<10>')

! ---- the first two words of lnSt, upper case, leading blanks skipped: a word ends at a blank,
!      a '(' or a '!', so `Name PROCEDURE(LONG p)` and `Name Routine  ! note` both give the keyword ----
TxaLineWords routine
  data
p   long,auto
q   long,auto
n   long,auto
  code
  w1U = '' ; w2U = ''
  p = 1
  loop n = 1 to 2
    loop while p <= lnSt._DataEnd and (lnSt.valuePtr[p] = ' ' or lnSt.valuePtr[p] = '<9>')
      p += 1
    end
    if p > lnSt._DataEnd then break.
    q = p
    loop while q <= lnSt._DataEnd and lnSt.valuePtr[q] <> ' ' and lnSt.valuePtr[q] <> '<9>' and lnSt.valuePtr[q] <> '(' and lnSt.valuePtr[q] <> '!'
      q += 1
    end
    if q = p then break. ! a '(' or a '!' where a word would be
    if n = 1 then w1U = upper(lnSt.valuePtr[p : q - 1]) else w2U = upper(lnSt.valuePtr[p : q - 1]).
    p = q
  end

! ---- every name a GOTO jumps to, read from every line of the text, into gtSt upper case with a space
!      on each side. GOTO is the word with the line start, a blank or a ';' before it and a blank
!      after it; the name is the run of label characters (letters, digits, '_' and ':') after the
!      blanks. A GOTO written in a string or a comment counts as well: all that can do is keep a
!      column-1 line that starts with the same name in column 1 ----
TxaGotoTargets routine
  data
g   long,auto
p   long,auto
q   long,auto
c   string(1),auto
nm  string(32),auto
up  StringTheory
  code
  gtSt.setValue(' ')
  loop g = 1 to pSt.records()
    up.setValue(pSt.getLine(g))
    up.upper()
    p = 0
    loop
      p = up.findChars('GOTO', p + 1)
      if ~p then break.
      if p > 1
        c = up.valuePtr[p - 1]
        if c <> ' ' and c <> '<9>' and c <> ';' then cycle.
      end
      q = p + 4
      loop while q <= up._DataEnd and (up.valuePtr[q] = ' ' or up.valuePtr[q] = '<9>')
        q += 1
      end
      if q = p + 4 or q > up._DataEnd then cycle.
      p = q
      loop while q <= up._DataEnd
        case val(up.valuePtr[q])
        of 48 to 58 orof 65 to 90 orof 95
          q += 1
        else
          break
        end
      end
      if q = p then cycle.
      nm = up.valuePtr[p : q - 1]
      gtSt.append(clip(nm) & ' ')
    end
  end

! ---- undo TxaPreProcess, marker by marker, in the opposite order. Ported unchanged. ----
VitEngine.TxaPostProcess Procedure(StringTheory pOut)
x long,auto
y long,auto
z long,auto
  code
  pOut.LineEndings(st:unix)            ! JoinToks emits CRLF; count one byte per end
  pOut.replaceByte(253,10)             ! un-join the folded lines  ! replace all '<253>' with <line feed>
  pOut.remove('!<255>')                ! the lifted header is itself again
  pOut.remove('!<250>')                ! template data is data again (step 7)
  y = 1
  loop                                 ! drop the lines we inserted whole
    x = pOut.findChars('!<252,10>', y)
    if ~x then break.
    y = pOut.instring('<10>',-1,1,x)
    pOut.RemoveFromPosition(y+1, x+2-y)
  end
  y = 1
  loop                                 ! put the shifted lines back in column 1
    x = pOut.findChars('!<251,10>', y)
    if ~x then break.
    y = pOut.instring('<10>',-1,1,x)
    ! blanks between the text and the marker are not the line's own: the marker reads as a trailing
    ! comment, so a column rule lines it up and pads the text to reach it. They go with the marker
    ! (a real trailing blank on a column-1 line meant nothing either)
    z = x
    loop while z > y + 2 and pOut.valuePtr[z - 1] = ' '
      z -= 1
    end
    pOut.RemoveFromPosition(z, x - z + 2)
    if pOut.valuePtr[y + 1] = ' ' then pOut.RemoveFromPosition(y+1, 1). ! the shift SPACE - a line a rule commented out starts '!', and that stays
  end
  pOut.replace('<10>','<13,10>')

! ------------------------------------------------------------------------------------
! The three analyses RESTRICTED on a .txa.
!
! A template export contains only the source YOU embedded. What the template generates
! around it is not in the file and does not exist until the app is built. All three of
! these decide by looking at every use in the text they can see:
!
!   UnusedVars         a variable used only by generated code looks unused, and the
!                      declaration would be commented out
!   UnusedAssignments  same premise, same failure
!   AutoCheck          adds ,AUTO once it can prove always-set-before-read. A read in
!                      generated code is invisible to that proof, so the proof is false
!                      and ,AUTO puts an uninitialised variable into a live procedure
!
! So on a .txa they run only on a scope wholly inside ONE embed (ScopeFullyEmbedded, at each
! analysis's own gate); this names the trio so the caller can print a once-per-file advisory.
! ------------------------------------------------------------------------------------
VitEngine.TxaAnalysisRefused Procedure(STRING pBuiltin)
  code
  ! Under the .txa embed rule this names the RESTRICTED trio, not a refusal: the caller
  ! prints the once-per-file advisory and falls through, and the real restricting is
  ! ScopeFullyEmbedded at each analysis's own gate.
  if ~self.isTxa then return 0.
  case upper(pBuiltin)
  of 'UNUSEDVARS' orof 'UNUSEDASSIGNMENTS' orof 'AUTOCHECK'
    return 1
  end
  return 0

! ------------------------------------------------------------------------------------
! is the scope [pStartTok..pEndTok] contained WHOLLY inside one .txa embed? Always true
! on a plain .clw. The wrap marks every template line with byte 250 in the trivia of
! the tokens that follow it, so any 250 INSIDE the span means the scope crosses
! template data - and the template's generated code there can read or write anything,
! which is what makes a spanning scope undecidable (the embed rule, strict form).
! A synthesised procedure header spans template data by construction, so procedures
! rarely qualify; a ROUTINE wholly inside one [SOURCE] block is the working case.
! The span's LEADING trivia (pStartTok's own strBefore) is the world BEFORE the scope
! and must not disqualify a scope that starts right after a boundary; likewise the
! trailing gap after the last content token belongs to the NEXT scope's world.
! ------------------------------------------------------------------------------------
VitEngine.ScopeFullyEmbedded Procedure(LONG pStartTok, LONG pEndTok)
i     long,auto
lastC long
  code
  if ~self.isTxa then return 1.
  loop i = pEndTok to pStartTok by -1
    get(self.tk.tokens, i)
    if errorcode() then cycle.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1 and self.tk.tokens.tok = '<10>' then cycle.
    lastC = i
    break
  end
  if ~lastC then return 1. ! nothing but trivia - vacuously inside
  loop i = pStartTok + 1 to lastC
    get(self.tk.tokens, i)
    if errorcode() then return 0.
    if not self.tk.tokens.strBefore &= NULL
      if instring('<250>', self.tk.tokens.strBefore, 1, 1) then return 0.
    end
  end
  return 1

! ------------------------------------------------------------------------------------
! Join the token stream and write the result, taking a backup first for an in-place run.
!
! ORDER MATTERS HERE and both steps below say why at the site: the final clip has to happen
! after the join, because the last line of a file with no trailing newline has no EOL token to
! carry its trailing whitespace; and the .txa unwrap has to happen after the clip, because its
! markers sit at line ends and a later clip would eat a space a shifted line is owed.
! ------------------------------------------------------------------------------------
VitEngine.WriteOutput Procedure(STRING pFn, StringTheory pLog)
out    StringTheory
outFn  StringTheory
bak    StringTheory ! in-place: the untouched original, saved as a .bak first
bakFn  StringTheory ! uncapped: BackupName returns a full PATH, and a fixed receiver here would truncate the name the backup is written under while still reporting the whole one
  code
  self.tk.JoinToks(out)
  ! the LAST line of a file that has no line ending after it carries its
  ! trailing whitespace in no EOL token's strBefore - there is no EOL token - so ClipLines cannot
  ! see it. One clip on the joined text is the whole fix. It cannot touch anything else: only
  ! spaces and tabs are named, and only at the very end of the file. A file that DOES end in a
  ! newline ends in byte 10, so this is a no-op there.
  out.clip('<32,9>')
  ! ---- .txa: undo the wrap. This is the LAST thing done to the text, after the clip
  !      above, because the markers it removes sit at line ends - a clip running after
  !      them could eat the space a shifted line is owed back. See TxaPostProcess.
  if self.isTxa then self.TxaPostProcess(out).
  ! ---- the Processed-by line. LAST of all - after the wrap, the clip and the .txa undo - so
  !      nothing can split or re-column it, however wide the switch list makes it. A .txa gets
  !      none: a comment line at the top of a template export is not a comment there.
  if ~self.noBanner and ~self.isTxa then self.AddBanner(out).
  outFn.setValue(self.OutName(pFn))
  ! outDir given: the output name must not BE the input - that path takes no .bak, so a
  ! same-name hit would destroy the original. The CLI refuses a same-directory outDir up
  ! front by filesystem probe (which settles '.', relative and absolute spellings); this
  ! equality test is the engine's own last line of defence for an embedder that passes
  ! the source's directory spelled the same way, and it can never false-positive.
  if self.outDir and upper(choose(outFn._DataEnd < 1, '', outFn.valuePtr[1 : outFn._DataEnd])) = upper(pFn)
    self.saveErrors += 1
    pLog.append('ERROR output file is the input file ' & clip(pFn) &                 |
                ' - ORIGINAL NOT OVERWRITTEN (use --in-place for a backed-up overwrite)<13,10>')
    return
  end
  ! in-place (no outDir): the original is about to be overwritten - preserve it as a
  ! timestamped .bak first, straight from disk (still untouched: we transform in memory).
  ! If the backup cannot be written we REFUSE to overwrite, so nothing is ever lost.
  if ~self.outDir
    bakFn.setValue(self.BackupName(pFn))
    if ~bak.LoadFile(clip(pFn))
      self.saveErrors += 1
      pLog.append('ERROR could not read original to back up ' & clip(pFn) & ' : ' & bak.LastError & |
                  '  - ORIGINAL NOT OVERWRITTEN<13,10>')
      return
    end
    if ~bak.SaveFile(bakFn.getValue())
      self.saveErrors += 1
      pLog.append('ERROR could not write backup ' & bakFn.getValue() & ' : ' & bak.LastError & |
                  '  - ORIGINAL NOT OVERWRITTEN<13,10>')
      return
    end
    pLog.append('backup: ' & bakFn.getValue() & '<13,10>')
  end
  if not out.SaveFile(outFn.getValue())
    self.saveErrors += 1
    pLog.append('ERROR could not save ' & outFn.getValue() & ' : ' & out.LastError & |
                '  (does the output directory exist? SaveFile does not create it)<13,10>')
    return
  end
  pLog.append('written: ' & outFn.getValue() & '<13,10>')

! ------------------------------------------------------------------------------------
! The line at the top of every file this tool writes, saying what produced it:
!   ! Processed by VitTransform <version> (build <n>) on <yyyymmdd> at <hhmmss> using vitrules.txt --cmtwrap=225 (style plain)
! After `using` come the rule file and every switch as the user typed them, then the style the
! run actually applied - which the switches alone do not always show. One line, never split.
! It goes on line 1, or line 2 when line 1 is !ABCIncludeFile, which the IDE looks for there.
! A file this tool has written before keeps the lines it already carries and gets this run's
! above them, so the top of the file reads as the history of the runs that changed it. The
! line ending is the file's own, read from its first line, and CRLF for a file with no line ending at all.
! ------------------------------------------------------------------------------------
VitEngine.AddBanner Procedure(StringTheory pOut)
line  StringTheory
nl    long,auto    ! the first line feed, 0 when the text has none
at    long,auto    ! where the line goes in
  code
  nl = pOut.FindByte(10)
  line.setValue('! Processed by VitTransform ' & vr:version & ' (build ' & vr:buildNo & ')' & |
                self.stamp[1 : 22] & ' using ' & self.bannerUsing.getValue()                & |
                choose(not self.rl &= NULL and self.rl.appliedStyle <> '',                    |
                       ' (style ' & clip(self.rl.appliedStyle) & ')', ' (file defaults)'))
  line.append(choose(~nl or (nl > 1 and pOut.valuePtr[nl - 1] = '<13>'), '<13,10>', '<10>'))
  at = 1
  if nl and pOut._DataEnd >= 15 and upper(pOut.valuePtr[1 : 15]) = '!ABCINCLUDEFILE' then at = nl + 1.
  pOut.insert(at, line)

! ------------------------------------------------------------------------------------
! One-line heartbeat, overwritten each step: watch the file to see where a
! long run is. clock() = hundredths of a second since midnight.
! ------------------------------------------------------------------------------------
VitEngine.Progress Procedure(STRING pMsg)
st  StringTheory
  code
  if ~self.progressFn then return.
  if clock() >= self.progLast and clock() - self.progLast < 25 then return. ! throttle to ~4 writes/sec; midnight wrap falls through
  self.progLast = clock()
  st.setValue(clock() & '  ' & clip(self.curFile) & '  ' & clip(pMsg) & '<13,10>')
  st.SaveFile(clip(self.progressFn))

! ------------------------------------------------------------------------------------
VitEngine.OutName Procedure(STRING pFn)
full  StringTheory ! the name being built. It holds a PATH, so it must not have a length cap: a cap can only truncate from the right, and the right-hand end of a path is the extension.
dp    long,AUTO
  code
  ! 1. base target path: outDir\basename.ext, or the source path in-place
  if ~self.outDir
    full.setValue(pFn, st:clip)               ! in-place (may still get a suffix below)
  else
    full.setValue(self.outDir,st:clip)
    if full.valuePtr[full._DataEnd] <> '\' then full.append('\').
    full.append(full.FileNameOnly(pFn, true)) ! StringTheory's FileNameOnly(<<fPath>, pIncludeExtension=true): `true` keeps the extension, which is what an output path needs
  end
  ! 2. insert the suffix (if any) just before the final '.' so the extension is preserved
  if self.outSuffix._DataEnd
    dp = full.instring('.', -1, 1)            ! last '.' (step -1 = search backwards, from the end down to 1)
    if dp                                     ! a dot inside a DIRECTORY name (c:\src.v2\noext) is not an extension
      if dp < full.instring('\', -1, 1) or dp < full.instring('/', -1, 1)
        dp = 0
      end
    end
    if dp > 0
      full.insert(dp, self.outSuffix)         ! in BEFORE the '.', so the extension stays on the end.
                                              !   dp = 1 (a dotfile, '.gitignore') routes to prepend, which
                                              !   is the same answer
    else
      full.append(self.outSuffix)             ! no extension - just append
    end
  end
  return full.getValue()

! ------------------------------------------------------------------------------------
! In-place backup name: the source path with the run stamp inserted before the final
! '.', then '.bak' appended, e.g.  src\Foo.clw  ->  src\Foo on 20260714 at 14302547.clw.bak
VitEngine.BackupName Procedure(STRING pFn)
full  StringTheory ! uncapped, for the reason given in OutName
dp    long,AUTO
  code
  full.setValue(pFn, st:clip)
  dp = full.instring('.', -1, 1)      ! last '.' (step -1 = search backwards, from the end down to 1)
  if dp                               ! dot inside a directory name is not an extension
    if dp < full.instring('\', -1, 1) or dp < full.instring('/', -1, 1)
      dp = 0
    end
  end
  if dp > 0
    full.insert(dp, clip(self.stamp)) ! before the '.' - see OutName
  else
    full.append(clip(self.stamp))     ! no extension - just append the stamp
  end
  return full.getValue() & '.bak'

! ------------------------------------------------------------------------------------
! Does the declaration LINE of pDeclTok mention pNameU as a whole token?
! Used to find sibling decls carrying OVER(V) for candidate V.
! ------------------------------------------------------------------------------------
VitEngine.DeclLineMentions Procedure(LONG pDeclTok, STRING pNameU)
i   long,auto
ln  long,auto
nU  string(vs:maxName),AUTO
  code
  nU = upper(pNameU)
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    ! *** A DECLARATION IS A LOGICAL LINE, NOT A PHYSICAL ONE. *** A lineNo change ends it
    ! only when the new token's trivia holds no '|' continuation: `sh SHORT,|` / `OVER(p)`
    ! carries an OVER, and ',DIM(3)' can sit past a '|' too.
     if self.tk.tokens.lineNo <> ln
       if ~self.TriviaHasContinuation(self.tk.tokens.strBefore) then break.
       ln = self.tk.tokens.lineNo ! the declaration carries on here
     end
    if self.tk.tokens.tok &= NULL then cycle.
    if upper(self.tk.tokens.tok) = nU then return 1.
  end
  return 0

! ------------------------------------------------------------------------------------
! Insert pHeader at the start of the PHYSICAL line the token begins - i.e.
! after the LAST line feed in its strBefore. A plain PrependStrBefore lands the '!'
! BEFORE any continuation text / swallowed OMIT block living in strBefore, which
! renders at the END of the PREVIOUS physical line and leaves this line live.
! ------------------------------------------------------------------------------------
VitEngine.CommentLineStart Procedure(LONG pTok, STRING pHeader)
sb   StringTheory
out  StringTheory
p    long,auto
k    long,auto
  code
  get(self.tk.tokens, pTok)
  if errorcode() then return.
  if self.tk.tokens.strBefore &= NULL
    self.tk.PrependStrBefore(pTok, pHeader)
    return
  end
  p = 0
  loop k = 1 to size(self.tk.tokens.strBefore)
    if self.tk.tokens.strBefore[k] = '<10>' then p = k.
  end
  if ~p
    self.tk.PrependStrBefore(pTok, pHeader)
    return
  end
  sb.setValue(self.tk.tokens.strBefore)
  out.setValue(sb.sub(1, p))
  out.append(pHeader)
  if p < sb._DataEnd then out.append(sb.slice(p + 1)).
  self.tk.SetStrBefore(pTok, out.getValue())

! ------------------------------------------------------------------------------------
! fill the per-scope AutoCheck cache. Everything here is a function of the
! SCOPE, not the symbol, so it is computed ONCE rather than per candidate (which would be
! O(symbols x span)):
! main-code bounds (stop before the first routine), the CODE token, the routine list,
! and the GOTO / COMPILE / OMIT bail pre-scan. acBail=1 also encodes "missing
! scope" and "no CODE section" - AutoVerdict returns UNKNOWN for all of them.
! ------------------------------------------------------------------------------------
VitEngine.AutoScopePrep Procedure(LONG pScopeId)
r       long,auto
i       long,auto
dp      long,auto ! first '.' inside a token
startT  long,auto
endT    long,auto
urCode  long,auto
urJ     long,auto
urDep   long,auto
urHit   byte,auto
urNmU   string(vs:maxName),auto
urPrevU string(vs:maxName),auto
  code
  if self.acScopeId = pScopeId then return.
  self.acScopeId = pScopeId
  self.acCodeT = 0 ; self.acMainEnd = 0 ; self.acBail = 1
  self.urData.free() ; self.urEsc.free() ; self.urInc = 0
  free(self.acRoutQ)
  free(self.acDotQ)
  get(self.syms.scopes, pScopeId)
  if errorcode() then return.
  startT = self.syms.scopes.startTok
  endT   = self.syms.scopes.endTok
  if endT <= startT then return.
  self.acMainEnd = endT
  loop r = 1 to records(self.syms.scopes)
    get(self.syms.scopes, r)
    if self.syms.scopes.kind = vs:scRoutine and self.syms.scopes.parentId = pScopeId
      self.acRoutQ.rStart = self.syms.scopes.startTok
      self.acRoutQ.rEnd   = self.syms.scopes.endTok
      add(self.acRoutQ)
      if self.syms.scopes.startTok > startT and self.syms.scopes.startTok - 1 < self.acMainEnd
        self.acMainEnd = self.syms.scopes.startTok - 1
      end
    end
  end
  self.acCodeT = self.CodeTokOfScope(startT, self.acMainEnd)
  ! collect the ROOTS of every merged dotted token in the WHOLE scope span, ONCE
  ! per scope rather than once per eligible symbol.
  ! Dups are kept (hit/miss lookup only); sorted for the keyed GET in AutoEligible.
  loop i = startT to endT
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    dp = instring('.', self.tk.tokens.tok, 1, 1)
    if dp < 2 then cycle.                  ! no dot / leading dot: not a merged label
    self.acDotQ.rootU = upper(sub(self.tk.tokens.tok, 1, dp - 1))
    add(self.acDotQ)
  end
  sort(self.acDotQ, +self.acDotQ.rootU)
  ! the reads the code scans cannot see (UnseenRead), collected in ONE walk of the scope: every
  ! name the DATA section mentions other than a declaration's own label in column 1, and every
  ! name whose storage escapes in the code - after &=, inside ADDRESS(), as an argument of BIND
  self.urData.free()
  self.urEsc.free()
  self.urInc = self.ScopeIncludes(pScopeId)
  urCode = self.CodeTokOfScope(startT, endT)
  if ~urCode then urCode = endT + 1.
  loop i = startT to endT
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL or self.tk.tokens.type <> 'b' then cycle.
    if i < urCode and self.tk.tokens.firstOnLine and self.tk.BufColOne() then cycle.
    urNmU = upper(self.tk.tokens.tok)
    urPrevU = upper(self.tk.GetTok(i - 1))
    if urPrevU = '.' then cycle.                 ! a member of something else
    if i < urCode
      self.urData.append(' ' & clip(urNmU) & ' ')
      cycle
    end
    urHit = choose(urPrevU = '&=' or self.AutoAddrTaken(i, urPrevU))
    if ~urHit                                    ! an argument of BIND: walk back to the open bracket
      urDep = 0
      loop urJ = i - 1 to startT by -1
        get(self.tk.tokens, urJ)
        if errorcode() or self.tk.tokens.tok &= NULL then break.
        if self.tk.tokens.tok[1] = '<10>' or self.tk.tokens.tok = ';' then break.
        if self.tk.tokens.tok = ')' then urDep += 1.
        if self.tk.tokens.tok = '('
          if ~urDep
            if upper(self.tk.GetTok(urJ - 1)) = 'BIND' then urHit = 1.
            break
          end
          urDep -= 1
        end
      end
    end
    if urHit then self.urEsc.append(' ' & clip(urNmU) & ' ').
  end
  if ~self.acCodeT then return.
  self.acBail = 0
  loop i = self.acCodeT + 1 to self.acMainEnd
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    case upper(self.tk.tokens.tok)
    of 'GOTO' orof 'COMPILE' orof 'OMIT'
      self.acBail = 1
      break
    end
  end

!===============================================================================================
! Should this receiver be refused? 1 = yes.
!
! The Check* builtins find their work by METHOD NAME - `.replace(`, `.cat(` and so on - so they
! can be pointed at any object that happens to have a same-named method. Some receivers
! PROVABLY name another class; many more cannot be resolved from one file at all.
!
! What happens to the unresolved ones is --receiver=:
!
!   assume   rewrite it as a StringTheory, identified or not.
!   check    DEFAULT. Refuse if any use of it in scope is not a StringTheory method.
!   strict   Refuse unless it PROVABLY resolves to a StringTheory.
!
! `check` can only ADD refusals, so it cannot break output that works today, and it catches
! most genuinely-wrong receivers. It is NOT sound: a class whose methods are all ALSO
! StringTheory methods passes it. That residual is what `strict` is for, and `strict` wants --thorough to be
! useful, since that is what makes a receiver declared in an include resolvable.
!
! A receiver token that is no name at all - a ']' or ')' in front of the dot - cannot be looked
! up. strict refuses it, as it refuses anything it cannot prove; check has no name to ask about,
! and like assume takes it as written.
!===============================================================================================
VitEngine.RecvIsOtherClass Procedure(LONG pRecvTok)
bestR  long,auto
nm     string(vs:maxName),auto
  code
  get(self.tk.tokens, pRecvTok)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.type <> 'b' then return choose(self.recvMode = rm:strict).
  nm = upper(self.tk.tokens.tok)
  if ~nm then return 0.
  bestR = self.RecvDeclAt(nm, pRecvTok)
  if bestR
    get(self.syms.syms, bestR)
    if ~errorcode() and self.syms.syms.typeU and ~self.syms.syms.isLike
      return choose(self.syms.syms.typeU <> 'STRINGTHEORY') ! resolved: it is, or it is not
    end
  end
  ! ---- not resolvable: SELF, a qualified name, or a declaration this file cannot see --------
  case self.recvMode
  of rm:strict
    return 1                                                ! proof required, and there is none
  of rm:check
    return self.RecvForeignUse(pRecvTok)
  end
  return 0                                                  ! rm:assume - treat it as a StringTheory

!===============================================================================================
! Is this receiver used ANYWHERE in a way a StringTheory could not be?
!
! Every `<recv>.<method>(` that names the same object is looked up in the StringTheory method table.
! For SELF or a qualified name that is the enclosing scope. A plain name asked about here was not
! declared in any scope around it, so it is declared outside this file's procedures, and every use
! in the file is the same object - except where a local of that name is declared, which is skipped.
! So `regex.Replace(st,p,r,1)` in one procedure is refused because another procedure calls
! `regex.CompileRegex`: on that class the shorter call would pick another overload.
! One method that is not there is enough: SystemStringClass gives itself away with FromFile and
! CountLines, UltimateString with Get and Contains.
!
! The table going stale is safe. If CapeSoft adds a method and this list has not caught up, the
! new method reads as foreign and the site is REFUSED - a lost rewrite, not a wrong one. A class
! DERIVED from StringTheory that adds methods refuses for the same reason: where its declaration
! cannot be seen, nothing shows that it only adds to StringTheory.
!===============================================================================================
VitEngine.RecvForeignUse Procedure(LONG pRecvTok)
i     long,auto
plain byte,auto
sS    long,auto
sE    long,auto
sc    long,auto
recvU string(vs:maxName),auto
methU string(vs:maxName),auto
  code
  get(self.tk.tokens, pRecvTok)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  recvU = upper(self.tk.tokens.tok)
  if ~recvU then return 0.
  ! a plain name is declared outside every scope around it, so the whole file is walked
  plain = choose(recvU <> 'SELF' and ~instring('.', recvU, 1, 1) and ~instring(':', recvU, 1, 1))
  sS = 1
  sE = records(self.tk.tokens)
  loop sc = 1 to records(self.syms.scopes)
    if plain then break.
    get(self.syms.scopes, sc)
    if errorcode() then break.
    if self.syms.scopes.startTok > pRecvTok or self.syms.scopes.endTok < pRecvTok then cycle.
    if self.syms.scopes.endTok - self.syms.scopes.startTok < sE - sS
      sS = self.syms.scopes.startTok
      sE = self.syms.scopes.endTok
    end
  end
  loop i = sS to sE - 2
    get(self.tk.tokens, i)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> 'b' then cycle.
    if upper(self.tk.tokens.tok) <> recvU then cycle.
    get(self.tk.tokens, i + 1)
    if errorcode() or self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok <> '.' then cycle.
    ! a use where a local of that name is declared is another object
    if plain and self.RecvDeclAt(recvU, i) then cycle.
    get(self.tk.tokens, i + 2)
    if errorcode() or self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type <> 'b' then cycle.
    methU = upper(self.tk.tokens.tok)
    if ~methU then cycle.
    if ~self.stMeth.findChars(' ' & clip(methU) & ' ')
      return 1 ! one foreign method is enough
    end
  end
  return 0

!===============================================================================================
! The row of the declaration a plain name refers to at this token: the declaration in the
! smallest scope around the token, or 0 when no scope around it declares the name. SELF and a
! qualified name are never looked up here and answer 0.
!===============================================================================================
VitEngine.RecvDeclAt Procedure(STRING pNameU, LONG pTok)
sy     long,auto
scr    long,auto
bestR  long,auto
bestSp long,auto
  code
  if pNameU = 'SELF' or instring('.', pNameU, 1, 1) or instring(':', pNameU, 1, 1) then return 0.
  bestR  = 0
  bestSp = 0
  loop sy = 1 to records(self.syms.syms)
    get(self.syms.syms, sy)
    if errorcode() then break.
    if self.syms.syms.nameU <> pNameU then cycle.
    scr = self.syms.syms.scopeId
    get(self.syms.scopes, scr)
    if errorcode() then cycle.
    if self.syms.scopes.startTok > pTok or self.syms.scopes.endTok < pTok then cycle.
    if ~bestR or self.syms.scopes.endTok - self.syms.scopes.startTok < bestSp
      bestR  = sy
      bestSp = self.syms.scopes.endTok - self.syms.scopes.startTok
    end
  end
  return bestR

!===============================================================================================
! Is this declaration a STRING(1)?
!
! Asked of a DIM'd head: an element of a STRING(1) array is one character, so the DIM does not
! defeat a single-index pick. Anything else - a wider STRING, a LONG, an unsized or computed
! size - answers 0 and the pick is refused.
!===============================================================================================
VitEngine.DeclIsString1 Procedure(LONG pDeclTok)
tw  long,auto
  code
  loop tw = pDeclTok to pDeclTok + 2
    if upper(self.tk.getTok(tw)) = 'STRING'
      if self.tk.getTok(tw+1) = '(' and self.tk.getTok(tw+3) = ')'
        if self.tk.getTok(tw+2) = '1' then return 1.
      end
      break
    end
  end
  return 0

!===============================================================================================
! Is pNameU the buffer of a StringTheory - `st.valuePtr`, `self.buf.valuePtr`? Then a single-index
! pick of it is ONE CHARACTER whatever the run has read: StringTheory declares valuePtr as a
! &STRING, never an array, which is a fact about the library rather than about this file. The
! object in front of it is resolved as an instring() haystack is (HayType), so a dotted chain
! counts when it resolves.
!===============================================================================================
VitEngine.ValuePtrPick Procedure(STRING pNameU, LONG pAt)
vpN   long,auto
vpD   long,auto
  code
  vpN = len(clip(pNameU))
  vpD = vpN
  loop while vpD > 1 and pNameU[vpD] <> '.'
    vpD -= 1
  end
  if vpD < 2 or vpD >= vpN then return 0.
  if pNameU[vpD + 1 : vpN] <> 'VALUEPTR' then return 0.
  return choose(self.HayType(pNameU[1 : vpD - 1], pAt) = 'STRINGTHEORY')

!===============================================================================================
! Is a single-index pick of pNameU provably ONE CHARACTER?
!
! `x[2]` is one byte of a STRING - but one ELEMENT of a DIM'd array, and an element can be any
! width or any type. So this answers only YES or DON'T KNOW, and DON'T KNOW refuses.
!
! *** "IS IT DIM'd?" IS THE WRONG QUESTION. *** It answers NO when it cannot find the
! declaration at all, which lets two shapes through: an array PARAMETER, where the DIM is on the
! caller's declaration and never on this one (`P1 PROCEDURE(*STRING[] pa)` - `pa[2]` is an
! element of the caller's array), and a DIM'd member of a plain GROUP, where the merged token
! `grp.arr` is not what the symbol table holds.
!
! Proof required: the name resolves to a declaration visible here, and either that declaration
! starts in column one and carries no DIM, or it is a STRING, CSTRING or PSTRING PARAMETER with no
! `[]` in its own declaration - which is where an array parameter says it is one.
!===============================================================================================
VitEngine.NameSliceOk Procedure(STRING pNameU, LONG pAtTok)
sy     long,auto
scr    long,auto
bestR  long,auto
bestSp long,auto
dTok   long,auto
depth  long,auto
nm     string(vs:maxName),auto
atTok  long,auto ! where THIS link is resolved from
pk     long,auto ! a parameter's own declaration, walked out to its ',' or brackets
pkU    string(vs:maxName),auto
  code
  nm    = pNameU
  depth = 0
  atTok = pAtTok
  loop
    depth += 1
    if depth > 8 then return 0.                 ! a LIKE cycle - do not chase it
    bestR  = 0
    bestSp = 0
    loop sy = 1 to records(self.syms.syms)
      get(self.syms.syms, sy)
      if errorcode() then break.
      if self.syms.syms.nameU <> nm then cycle.
      scr = self.syms.syms.scopeId
      get(self.syms.scopes, scr)
      if errorcode() then cycle.
      if self.syms.scopes.startTok > atTok or self.syms.scopes.endTok < atTok then cycle.
      if ~bestR or self.syms.scopes.endTok - self.syms.scopes.startTok < bestSp
        bestR  = sy
        bestSp = self.syms.scopes.endTok - self.syms.scopes.startTok
      end
    end
    if ~bestR then return 0.                         ! not resolvable - do not guess
    get(self.syms.syms, bestR)
    if errorcode() then return 0.
    dTok = self.syms.syms.declTok
    if ~self.syms.IsColOneLabel(dTok)                ! A PARAMETER: an array one says so in its own declaration -
      case upper(self.syms.syms.typeU)               !   `*STRING[] pa`, the DIM being the caller's - so a STRING,
      of 'STRING' orof 'CSTRING' orof 'PSTRING'      !   CSTRING or PSTRING with no `[` from the '(' or ',' that
      else                                           !   opens it to the ',' or ')' that closes it is one string,
        return 0                                     !   and a pick of it is one character (ruled 23 Oct 2026)
      end
      loop pk = dTok - 1 to 1 by -1
        pkU = self.tk.GetTok(pk)
        if pkU = ',' or pkU = '(' then break.
        if pkU = '[' or pkU = ']' or self.IsEolTok(pk) then return 0.
      end
      if pk < 1 then return 0.
      loop pk = dTok to records(self.tk.tokens)
        pkU = self.tk.GetTok(pk)
        if pkU = ',' or pkU = ')' then break.
        if pkU = '[' or pkU = ']' or self.IsEolTok(pk) then return 0.
      end
      if pk > records(self.tk.tokens) then return 0.
      return 1
    end
    ! *** DIM ONLY DEFEATS THE PROOF WHEN THE ELEMENT IS WIDER THAN ONE. *** `x STRING(5),DIM(3)`
    ! makes x[2] a five-character element, but `d1 STRING(1),DIM(3)` makes d1[2] exactly one
    ! character - which is what this arm is trying to establish.
    if band(self.DeclAttrBits(dTok), ab:dim) and ~self.DeclIsString1(dTok) then return 0.
    if ~self.syms.syms.isLike then break.       ! a real declaration, and no DIM on it
    ! *** LIKE INHERITS DIM, SO THE PROOF HAS TO FOLLOW IT. *** `lk LIKE(sdim)` carries no DIM of
    ! its own and never will - it takes the one on sdim. Refusing every LIKE would be sound but
    ! throws away `lp LIKE(pl)` of a plain STRING, which is one character and should convert. For
    ! a LIKE symbol the registry keeps the TARGET's name in typeU, so walk to it and ask again.
    ! *** AND THE NEXT LINK RESOLVES WHERE IT IS DECLARED, NOT WHERE IT IS USED. *** Clarion
    ! binds LIKE(target) at the DECLARATION, so a local at the use site that happens to share
    ! the target's name is a different variable entirely, and resolving each link from pAtTok
    ! would let such a local stand in for the real target.
    atTok = dTok
    nm    = self.syms.syms.typeU
    if ~nm then return 0.
  end
  return 1


! ------------------------------------------------------------------------------------
! one walk of the declaration line returning every attribute of interest as
! a bitmask (ab:*). Replaces four separate DeclHasAttr walks in AutoEligible.
! ------------------------------------------------------------------------------------
VitEngine.DeclAttrBits Procedure(LONG pDeclTok)
i    long,auto
ln   long,auto
b    long
  code
  get(self.tk.tokens, pDeclTok)
  if errorcode() then return 0.
  ln = self.tk.tokens.lineNo
  i = pDeclTok
  loop
    i += 1
    get(self.tk.tokens, i)
    if errorcode() then break.
    ! *** A DECLARATION IS A LOGICAL LINE, NOT A PHYSICAL ONE. *** A lineNo change ends it
    ! only when the new token's trivia holds no '|' continuation: `sh SHORT,|` / `OVER(p)`
    ! carries an OVER, and ',DIM(3)' can sit past a '|' too.
     if self.tk.tokens.lineNo <> ln
       if ~self.TriviaHasContinuation(self.tk.tokens.strBefore) then break.
       ln = self.tk.tokens.lineNo    ! the declaration carries on here
     end
    if self.tk.tokens.type <> 'b' or |
       self.tk.tokens.tok &= NULL
      cycle
    end
    case upper(self.tk.tokens.tok)
    of 'AUTO'   ; b = bor(b, ab:auto)
    of 'OVER'   ; b = bor(b, ab:over)
    of 'DIM'    ; b = bor(b, ab:dim)
    of 'STATIC' ; b = bor(b, ab:static)
    of 'THREAD' ; b = bor(b, ab:thread)
    end
  end
  return b

!===============================================================================================
! MergeGuardChain: consecutive single-line IFs that set the SAME thing become ONE test.
!
!     if extraPos.containsByte(92) then pathish = 1.   ! '\'
!     if extraPos.containsByte(47) then pathish = 1.   ! '/'
!     if extraPos.containsByte(46) then pathish = 1.   ! <<dot>
!
! Three statements saying one thing. When every condition asks whether the SAME receiver holds
! ONE character, the whole chain is a single library call:
!
!     if extraPos.containsA('\/.') then pathish = 1.
!
! ContainsA takes an ALPHABET and answers whether any of it is present, which is the question
! the chain was asking a character at a time. Two rules come with it:
!   - pClip defaults to st:Clip and clips the ALPHABET, so a space written LAST is trimmed off
!     and silently stops being searched for. The order of an alphabet means nothing, so a space
!     is simply never put there.
!   - a quote is doubled, as in any Clarion literal.
!
! *** WHAT MAY BE MERGED, and this is the whole of the safety argument. ***
!   - the statements must be CONSECUTIVE, each a whole line of its own
!   - they must not be the arms of an EXECUTE: those are alternatives picked by position,
!     so folding two into one would make every later arm answer to a different value
!   - each must be the single-line form `if COND then ASSIGNMENT.`
!   - the ASSIGNMENT must be the same in every one of them
!   - every condition must only READ: a one-character containment test on the same receiver,
!     a StringTheory (MgOneCharTest asks), gives the containsA form; any other run whose
!     conditions are all on the purity list (the list IfChainToCase uses, plus containsA and a
!     rule file's PURE(...) names) becomes one OR-joined IF, a condition to a line or on one line
!   - a name with no bracket after it, in a condition or on the right of the assignment, must
!     be data: Clarion calls a parameterless procedure by its label alone (MgBareCall)
!
! The last three are what make it safe. N separate IFs evaluate N conditions; one merged test
! stops as soon as it has its answer. That only matters if a condition DOES something besides
! answer - and the purity list admits only calls that read. The assignment ran once in the
! chain (or not at all) and runs once here (or not at all), whatever the conditions did.
!
! THE JOIN. The conditions are joined with OR, and every operator but one binds tighter than
! OR: `if a then` and `if b and c then` give `a or b and c`, which is `a or (b and c)`. The
! one is XOR. It shares OR's level and the two are read left to right, so `a or b xor c` is
! `(a or b) xor c`. A condition holding XOR outside brackets is therefore written in brackets
! when it is joined on behind another; the first condition is never behind anything.
!
! THE COMMENTS. Those `! '\'` notes are generated by the rule that wrote the containsByte call,
! from NOTE(charname(lit)): either CharNameOfByte's name for the byte, or the source literal
! when it has no special name. Both are recognised EXACTLY and dropped, because the characters
! they document are now visible in the alphabet itself. Anything else is an author's own comment
! and is carried onto the merged line - a transformer does not get to discard those.
!===============================================================================================
VitEngine.BuiltinMergeGuardChain Procedure(StringTheory pLog)
i          long,auto
n          long,auto
changes    long
lnS        long          ! first token of the line being read
lnE        long          ! its EOL token
mgIf       long          ! the IF token, when the line is one of ours
mgThen     long          ! its THEN
mgDot      long          ! the terminating '.'
asgTxt     StringTheory  ! the assignment, normalised, for comparing
runAsg     StringTheory  !   and the one this run agreed on
recvTxt    StringTheory  ! the receiver of a one-character test
runRecv    StringTheory  !   and the one this run agreed on
rawTxt     StringTheory
condTxt    StringTheory  ! the condition being staged, as text
sb         StringTheory
alpha      StringTheory  ! the alphabet, before escaping
carried    StringTheory  ! comments that were NOT ours to drop
cmtRaw     StringTheory  ! one line's comment, unpacked from the bank
cmtBank    StringTheory  ! every staged comment end to end; cmtSt/cmtLn slice it
pureU      StringTheory  ! ' NAME NAME ' - calls that only READ
pureAddU   StringTheory  !   the names PURE(...) adds - the author's word
pureOwnU   StringTheory  !   the names on it this file gives a procedure
allPure    byte          ! every condition is safe to short-circuit
mgAgain    byte          ! a merge moved the tokens - walk again
mgOneDone  byte          ! MgOneLine took the chain, so the block form is not wanted
raw        StringTheory
t          long,auto
runCount   long
mgRuns     long,auto     ! conditions collapsed by MgCollapseRuns
allChar    byte          ! every condition so far is a one-character test
mgQ        QUEUE,PRE(mq)
ifTok        long
eolTok       long
condS        long
condE        long
cmtSt        long        ! this line's comment as a slice of cmtBank - start and
cmtLn        long        ! length. *** NEITHER A FIXED FIELD NOR A TOKEN INDEX. ***
                         ! A fixed field silently cut a 217-character comment to
                         ! 200. A token index has no size to get wrong, but it is
                         ! only valid until the first DeleteToks - and MgOrForm
                         ! reads its comments AFTER editing tokens, so every
                         ! carried comment came from the wrong place and was lost.
                         ! Text banked when the line is STAGED is immune to both.
ch           string(1)
hasCh        byte
shf          byte
condTx       string(400) ! the condition as written, for the OR form
             END
  code
  n = records(self.tk.tokens)
  if n < 2 then return 0.
  free(mgQ)
  ! The same list IfChainToCase uses, and extensible the same way: a rule file's PURE(...)
  ! adds to it. A call that only READS may be short-circuited; anything else may not.
  self.IfCasePureList(pureU)
  pureU.append('CONTAINSA ')
  pureAddU.setValue(' ')
  if not self.rl.rules.bparmQ &= NULL
    loop t = 1 to records(self.rl.rules.bparmQ)
      get(self.rl.rules.bparmQ, t)
      if upper(self.rl.rules.bparmQ.name) = 'PURE' and not self.rl.rules.bparmQ.value &= NULL
        raw.setValue(self.rl.rules.bparmQ.value)
        raw.Upper()
        pureU.append(clip(raw.getValue()) & ' ')
        pureAddU.append(clip(raw.getValue()) & ' ')
      end
    end
  end
  self.PureOwnList(pureU, pureOwnU)
  ! *** A MERGE MOVES EVERY INDEX AFTER IT, SO THE WALK STARTS AGAIN. *** MgFlush deletes the
  ! lines it folded in; i and n were read before that, so carrying on with them would read the
  ! wrong tokens - some chains merged, others silently missed, a pass that depends on how much
  ! it has already done. Restarting terminates: a merge always removes more than it adds.
  changes  = 0
  mgAgain  = 1
  loop while mgAgain
    mgAgain  = 0
    runCount = 0
    free(mgQ)
    n = records(self.tk.tokens)
    if changes then self.syms.dirty = 1.
    i = 1
    loop while i <= n
      do MgReadLine
      do MgCutRun
      if mgAgain then break.
      if mgIf and mgThen and mgDot
        self.MgSpanText(mgThen + 1, mgDot - 1, asgTxt)
        ! *** A MERGE RUNS THE BODY ONCE WHERE IT RAN ONCE PER TRUE CONDITION. *** That is only
        ! the same thing for a repeatable statement, so the shape is checked before the run is
        ! opened OR extended - it gates the OR-joined form as much as the containsA one. A name
        ! on a right-hand side may be a procedure called with no brackets: MgBareCall asks.
        if self.MgStmtRepeatable(asgTxt)              and |
           ~self.MgBareCall(mgThen + 1, mgDot - 1, 1) and |
           ~self.MgRhsShared(mgThen + 1, mgDot - 1)   and |
           (~runCount or self.MgSameStmt(asgTxt, runAsg))
          if ~runCount
            runAsg.setValue(asgTxt)
            allChar = 1
            allPure = 1
            runRecv.free()
          end
          do MgStageLine
          i = lnE + 1
          cycle
        end
      end
      do MgFlush                                          ! this line is not part of the open run
      if mgAgain then break.                              !   and the indices below have moved
      ! IT MAY STILL START THE NEXT ONE: a line that closes one run may open the next.
      if mgIf and mgThen and mgDot
        runAsg.setValue(asgTxt)
        allChar = 1
        allPure = 1
        runRecv.free()
        do MgStageLine
      end
      i = lnE + 1
    end
    if ~mgAgain then do MgFlush.                          ! a run still open at end of file
  end
  free(mgQ)
  ! ... and the same collapse INSIDE a condition the author already wrote as one line.
  ! Run after the chain merging, on settled text, for the reason the whole builtin is
  ! FINAL: the rules that make containsByte() live further down the rule file.
  mgRuns = self.MgCollapseRuns()
  if mgRuns
    changes += mgRuns
    pLog.append('BUILTIN MergeGuardChain: ' & mgRuns & ' condition(s) collapsed to containsA<13,10>')
  end
  if changes
    self.wantReparse = true
    ! changes counts the collapses too, and they have their own line above: this one counts chains
    if changes > mgRuns
      pLog.append('BUILTIN MergeGuardChain: ' & (changes - mgRuns) & ' chain(s) merged this pass<13,10>')
    end
  end
  return changes

! ---- the physical line starting at i --------------------------------------------------------
! mgIf/mgThen/mgDot are non-zero only when the line is exactly `if COND then ASSIGNMENT.`
! THEN is taken at bracket depth 0, so a `then` inside a call cannot be mistaken for the
! statement's own, and the dot must be the LAST token on the line: `if a then b. ; c` is two
! statements and not ours to touch. A line with an ELSE or ELSIF is not one: in `if a then
! b = 1 else c = 2.` the ELSE runs when the test fails, and a merged test would skip it. Nor
! is an IF with an OMIT block folded in front of it: the merge would delete the block.
! Nor is a line whose body holds a terminator of its own, as in `if a = 1 then hit = 1..`: the
! second '.' closes the block around the IF, so the next such line is in another block, and a
! merge that deleted it would take that block's end with it.
MgReadLine routine
  data
mrD    long,auto
mrJ    long,auto
  code
  lnS = i ; lnE = 0 ; mgIf = 0 ; mgThen = 0 ; mgDot = 0
  loop mrJ = i to n
    if self.IsEolTok(mrJ) then lnE = mrJ ; break.
  end
  if ~lnE then lnE = n + 1.
  if lnE - lnS < 5 then exit.                                     ! if C then A . - five tokens at the very least
  get(self.tk.tokens, lnS)
  if errorcode() then exit.
  if self.tk.tokens.tok &= NULL then exit.
  if upper(self.tk.tokens.tok) <> 'IF' then exit.
  if not self.tk.tokens.strBefore &= NULL
    if pLog.findByte(10, 1,, self.tk.tokens.strBefore) then exit. ! <line feed>
  end
  mgIf = lnS
  mrD = 0
  loop mrJ = lnS + 1 to lnE - 1
    get(self.tk.tokens, mrJ)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if size(self.tk.tokens.tok) = 1
      if self.tk.tokens.tok = '(' then mrD += 1.
      if self.tk.tokens.tok = ')' then mrD -= 1.
    end
    if ~mrD and upper(self.tk.tokens.tok) = 'THEN' and ~mgThen then mgThen = mrJ.
    case upper(self.tk.tokens.tok)
    of 'ELSE' orof 'ELSIF'
      mgIf = 0
      exit
    end
  end
  if ~mgThen
    mgIf = 0
    exit
  end
  get(self.tk.tokens, lnE - 1)
  if errorcode() or self.tk.tokens.tok &= NULL
    mgIf = 0
    exit
  end
  if size(self.tk.tokens.tok) <> 1 or self.tk.tokens.tok <> '.'
    mgIf = 0
    exit
  end
  mgDot = lnE - 1
  loop mrJ = mgThen + 1 to mgDot - 1                              ! `S..` closes more than the IF: not a guard line
    get(self.tk.tokens, mrJ)
    if errorcode() then mgIf = 0 ; break.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.type = vt:end then mgIf = 0 ; break.
  end
  if mgDot <= mgThen + 1 then mgIf = 0.                           ! `if x then.` - nothing assigned

! ---- a COMMENT A MERGE WOULD DELETE ends the open run above this line. Lines 2..k of a run go
!      whole, and all that comes back of each is its condition, written from its first token on
!      with the trivia inside it (MgSpanRaw). A comment riding the trivia of that first token, of
!      THEN, of the assignment or of the dot - after a '|' - would go with the line, without a
!      word. So the run is closed above such a line, and the line may open the next one: a run's
!      FIRST line keeps those tokens (MgOrForm asks about the ones it rewrites). ----
MgCutRun routine
  if ~runCount or ~mgIf or ~mgThen or ~mgDot then exit.
  if self.SpanTriviaHasComment(mgIf + 1, mgIf + 1) then do MgFlush ; exit.
  if self.SpanTriviaHasComment(mgThen, mgDot) then do MgFlush.

! ---- stage this line into the run -----------------------------------------------------------
!      A comment INSIDE the condition, after its first token, rides into the OR-joined forms with
!      the condition's own text (MgSpanRaw). The containsA form writes no condition at all, so a
!      run holding one is not offered that form: allChar goes to 0.
MgStageLine routine
  data
msP  long,auto
msB  long,auto
  code
  clear(mgQ)
  mq:ifTok  = mgIf
  mq:eolTok = lnE
  mq:condS  = mgIf + 1
  mq:condE  = mgThen - 1
  mq:cmtSt  = 0
  mq:cmtLn  = 0
  mq:hasCh  = 0
  mq:ch     = ''
  get(self.tk.tokens, lnE)                                  ! a trailing comment rides the EOL token's trivia
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    cmtRaw.setValue(self.tk.tokens.strBefore)
    mq:shf = self.TxaMarkOff(cmtRaw)
    msP = pLog.findByte(33, 1,, self.tk.tokens.strBefore)   ! '!'
    if msP
      self.MgCmtText(lnE, cmtRaw)                           ! READ IT HERE, while the token index
      if cmtRaw._DataEnd                                    !   is still valid - a later DeleteToks
        mq:cmtSt = cmtBank._DataEnd + 1                     !   makes it point at something else
        mq:cmtLn = cmtRaw._DataEnd
        cmtBank.append(cmtRaw)
      end
    end
  end
  self.MgSpanRaw(mq:condS, mq:condE, condTxt)               ! as written: this text is re-emitted
  ! XOR shares OR's level, so behind an OR it keeps brackets of its own
  if self.SpanTopWord(mq:condS, mq:condE, ' XOR ')
    condTxt.enclose('(', ')')
  end
  if condTxt._DataEnd > 400 then allChar = 0 ; allPure = 0. ! too wide to carry - leave it alone
  mq:condTx = condTxt.getValue()                            ! tested FIRST: this field is a fixed width and truncates in silence
  if ~self.MgCondIsPure(mq:condS, mq:condE, pureU, pureAddU, pureOwnU) then allPure = 0.
  msB = self.MgOneCharTest(mq:condS, mq:condE, recvTxt)
  if msB > 0
    if ~runRecv._DataEnd then runRecv.setValue(recvTxt).
    if upper(choose(recvTxt._DataEnd < 1, '', recvTxt.valuePtr[1 : recvTxt._DataEnd])) = upper(runRecv.getValue())
      mq:hasCh = 1
      mq:ch    = chr(msB)
    end
  end
  if ~mq:hasCh then allChar = 0.
  if self.SpanTriviaHasComment(mq:condS + 1, mq:condE) then allChar = 0.
  if self.MgBareCall(mq:condS, mq:condE, 0) then allPure = 0.
  add(mgQ)
  runCount += 1

! ---- close the run: merge it if it earned the right, then start over ------------------------
MgFlush routine
  data
mfQ      long,auto
mfFirst  long,auto
mfLast   long,auto
mfCondS  long,auto
mfCondE  long,auto
mfName   string(64),auto
mfShf    byte
  code
  if runCount < 2 then do MgReset ; exit.
  ! THE ARMS OF AN EXECUTE ARE NOT A CHAIN. The lines of a run are consecutive, so they are
  ! all arms of one EXECUTE or none are, and the first line answers for every one of them.
  get(mgQ, 1)
  if self.ArmOfExecute(mq:ifTok) then do MgReset ; exit.
  if ~allChar
    if allPure
      do MgOneLine
      if ~mgOneDone then do MgOrForm.
    end
    do MgReset
    exit
  end
  alpha.free() ; carried.free()
  loop mfQ = 1 to records(mgQ)
    get(mgQ, mfQ)
    if errorcode() then break.
    alpha.append(mq:ch)
    if mfQ = 1 then mfShf = mq:shf.
    if mq:cmtLn                                   ! ours to drop, or the author's to keep?
      mfName = self.tk.CharNameOfByte(val(mq:ch))
      cmtRaw.free()                               ! the comment WHOLE, straight from the
      if mq:cmtLn then cmtRaw.setValue(cmtBank.valuePtr[mq:cmtSt : mq:cmtSt + mq:cmtLn - 1]).
      self.TxaMarkOff(cmtRaw)
      rawTxt.setValue(cmtRaw)                     !   token - nothing to overflow
      rawTxt.RemoveFromPosition(1,1)              ! past the '!'
      rawTxt.trim()
      if choose(rawTxt._DataEnd < 1, '', rawTxt.valuePtr[1 : rawTxt._DataEnd]) = mfName or choose(rawTxt._DataEnd < 1, '', rawTxt.valuePtr[1 : rawTxt._DataEnd]) = '''' & mq:ch & ''''
        ! generated from the character itself, which the alphabet now shows - drop it
      else
        if carried._DataEnd then carried.append(' ').
        carried.append(cmtRaw)                    ! whole, however long it was
      end
    end
  end
  if ~self.MgAlphaFix(alpha)                      ! an all-space alphabet clips to
    if allPure                                    !   nothing, and would test for
      do MgOneLine
      if ~mgOneDone then do MgOrForm.
    end
    do MgReset                                    !   nothing
    exit
  end
  sb.setValue(runRecv)
  sb.append('.containsA(''')
  self.MgLitAlphabet(alpha, sb)                   ! quote, '<', '{' and the unprintables
  sb.append(''')')
  get(mgQ, 1)
  mfFirst = mq:eolTok ; mfCondS = mq:condS ; mfCondE = mq:condE
  get(mgQ, records(mgQ))
  mfLast = mq:eolTok
  ! BACK TO FRONT: dropping the later lines first leaves the earlier indices untouched.
  if mfLast > mfFirst then self.tk.DeleteToks(mfFirst + 1, mfLast).
  if mfCondE > mfCondS then self.tk.DeleteToks(mfCondS + 1, mfCondE).
  self.tk.SetTok(mfCondS, sb.getValue())          ! strBefore omitted: the space after IF stays
  ! THE TRAILING TRIVIA IS REWRITTEN EITHER WAY. The surviving line came into this with a
  ! comment of its own, and if that one was generated it has to GO - leaving it would name one
  ! character out of an alphabet that now lists them all. Anything an author wrote is in
  ! `carried`, whichever line it was on, so this puts back exactly what should be there and
  ! nothing else. The column is not this routine's business: AlignComments settles it after.
  ! On a .txa a line that began in column 1 ends with the shift marker, which is no comment: the
  ! comments above were taken without it, and the line gets its own back, last - straight after
  ! the code when no comment is carried, as the line had it, with no blanks for a clip to take.
  if carried._DataEnd then carried.prepend('   ').
  if mfShf then carried.append('!<251>').
  self.tk.SetStrBefore(mfFirst - (mfCondE - mfCondS), carried.getValue())
  changes += 1
  mgAgain = 1                                      ! the indices have moved - walk again
  do MgReset


! ---- SHAPE C: ONE LINE, when every comment is the same and the result fits -------------------
! Shape B below writes a condition to a line SO THAT EACH KEEPS THE COMMENT WRITTEN BESIDE IT.
! Where every line carries the SAME comment - or none of them carries one - there is nothing to
! keep by splitting, and the merge is better said in one line:
!
!     If pSize < 1 Then pSize = 10.                  ! default to 10MB
!     If pSize > 500 Then pSize = 10.                ! default to 10MB
!       ==>
!     If pSize < 1 or pSize > 500 Then pSize = 10.   ! default to 10MB
!
! The comment is written once, because it was one thing said twice. Every other guarantee shape B
! makes still holds: the conditions were proved READ-ONLY before either form was reached, so
! stopping at the first true one changes nothing.
!
! IT FIRES ONLY WHEN THE FINISHED CODE FITS. A one-liner that SplitWideLines then breaks again is
! worse than the block, so the width is checked BEFORE any token moves and the block form is what
! this falls back to. Asked for 15 Sep 2026.
MgOneLine routine
  data
mlQ     long,auto
mlPos   long,auto
mlEol   long,auto
mlLast  long,auto
mlIf    long,auto
mlDot   long,auto
mlW     long,auto
mlJ     long,auto
mlNl    long,auto
mlInd   StringTheory
mlOne   StringTheory
mlCmt1  StringTheory
mlCmtN  StringTheory
  code
  mgOneDone = 0
  get(mgQ, 1)
  if errorcode() then exit.
  mlIf  = mq:ifTok
  mlEol = mq:eolTok
  mlDot = mlEol - 1                                           ! the statement's own terminating dot
  mlCmt1.free()                                               ! EVERY COMMENT THE SAME, or every one
  if mq:cmtLn then mlCmt1.setValue(cmtBank.valuePtr[mq:cmtSt : mq:cmtSt + mq:cmtLn - 1]). !   absent
  self.TxaMarkOff(mlCmt1)
  loop mlQ = 2 to records(mgQ)
    get(mgQ, mlQ)
    if errorcode() then exit.
    mlCmtN.free()
    if mq:cmtLn then mlCmtN.setValue(cmtBank.valuePtr[mq:cmtSt : mq:cmtSt + mq:cmtLn - 1]).
    self.TxaMarkOff(mlCmtN)
    if ~mlCmtN.equals(mlCmt1, st:clip) then exit.             ! they differ - shape B keeps both
  end
  mlInd.free()                                                ! the line's own indent, for the width
  get(self.tk.tokens, mlIf)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    mlNl = 0
    loop mlJ = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[mlJ] = '<10>' then mlNl = mlJ.
    end
    if mlNl < size(self.tk.tokens.strBefore)
      mlInd.setValue(self.tk.tokens.strBefore[mlNl + 1 : size(self.tk.tokens.strBefore)])
    end
  end
  self.MgSpanRaw(mlIf, mlDot, mlOne)                          ! the first line exactly as written
  mlW = mlInd._DataEnd + mlOne._DataEnd
  loop mlQ = 2 to records(mgQ)
    get(mgQ, mlQ)
    if errorcode() then exit.
    mlW += 4 + len(clip(mq:condTx))                           ! the ' or ' and the condition itself
  end
  if self.splitWidth > 0 and mlW > self.splitWidth then exit. ! the splitter would break it again
  get(mgQ, records(mgQ))                                      ! THE EDIT: lines 2..k go ...
  mlLast = mq:eolTok
  if mlLast > mlEol then self.tk.DeleteToks(mlEol + 1, mlLast).
  get(mgQ, 1)
  mlPos = mq:condE                                            ! ... and their conditions arrive in
  loop mlQ = 2 to records(mgQ)                                !     front of THEN, in order
    get(mgQ, mlQ)
    if errorcode() then break.
    self.tk.AddTok(mlPos + 1, 'or', ' ')
    mlPos += 1
    self.tk.AddTok(mlPos + 1, clip(mq:condTx), ' ')
    mlPos += 1
  end
  changes += 1
  mgAgain = 1                                                 ! the indices have moved - walk again
  mgOneDone = 1

! ---- SHAPE B: one OR-joined test, a condition to a line ------------------------------------
! Everything the containsA form cannot take still collapses, just not into a library call:
!
!     if firstCond or |                      ! the first author's comment
!        secondCond or |                     ! the second
!        thirdCond                           ! the third
!       target = value
!     end
!
! A condition to a line, so each keeps the comment written beside it. Text after a '|' is
! ignored by the compiler exactly as text after a '!' is, so a comment rides there safely.
!
! N separate IFs evaluate N conditions; this stops at the first true one. That is why every
! condition had to be provably READ-ONLY before we got here - see allPure.
!
! The tokens are written back to front, because every insertion moves the indices after it and
! nothing moves the ones before. Each condition becomes ONE coarse token: the pass sets
! wantReparse, so the file is tokenised again before anything reads these as tokens rather than
! as text, and what reaches the file is the text.
!
! THE NEW END IS MARKED AS A CLOSE AT ONCE. Only the parse gives an END its '-', and this walk
! goes on before the next parse. Without the mark the IF would read as still open to a later
! line asking which block it stands in - MgFlush's EXECUTE test - and a line in an EXECUTE below
! a merged BEGIN arm would be taken for a line of that BEGIN.
MgOrForm routine
  data
moQ     long,auto
moEol   long,auto
moLast  long,auto
moIf    long,auto
moThen  long,auto
moAsgS  long,auto
moAsgE  long,auto
moPos   long,auto
moNl    long,auto
moJ     long,auto
moShf   byte,auto
moIndSt StringTheory ! the indent, exact: a fixed string pads it
moSb    StringTheory
  code
  get(mgQ, 1)
  if errorcode() then exit.
  moIf   = mq:ifTok
  moEol  = mq:eolTok
  moThen = mq:condE + 1
  moAsgS = moThen + 1
  moAsgE = moEol - 2                                            ! the token before the statement's own dot
  if moAsgE < moAsgS then exit.
  ! The THEN token's trivia is about to be OVERWRITTEN with ' ' so THEN can become the
  ! first 'or'. When the first chain line breaks before THEN - `if <cond> | ! note` and then
  ! THEN on the next line - that trivia is where the author's '|' and anything written after
  ! it lives, and overwriting it drops the note without a word. Refuse the whole merge.
  ! Before any edit, deliberately: an early exit here leaves the chain exactly as written, and
  ! `changes` is not incremented until the bottom of this routine. The first token of the
  ! assignment is given a fresh indent and the statement's dot is deleted, so a comment riding
  ! the trivia of either refuses the same way.
  if self.SpanTriviaHasComment(moThen, moAsgS) then exit.
  if self.SpanTriviaHasComment(moEol - 1, moEol - 1) then exit.
  get(mgQ, records(mgQ))
  moLast = mq:eolTok
  ! the line's own indent, from the IF token's leading trivia
  moIndSt.free()
  get(self.tk.tokens, moIf)
  if ~errorcode() and not self.tk.tokens.strBefore &= NULL
    moNl = 0
    loop moJ = 1 to size(self.tk.tokens.strBefore)
      if self.tk.tokens.strBefore[moJ] = '<10>' then moNl = moJ.
    end
    if moNl < size(self.tk.tokens.strBefore)
      moIndSt.setValue(self.tk.tokens.strBefore[moNl + 1 : size(self.tk.tokens.strBefore)])
    end
  end
  if moLast > moEol then self.tk.DeleteToks(moEol + 1, moLast). ! lines 2..k
  self.tk.DeleteToks(moEol - 1, moEol - 1)                      ! the dot: a block has none
  ! *** EVERY NEW LINE ENDS WITH A REAL EOL TOKEN. *** Writing the newline into the next
  ! token's trivia instead LOOKS identical in the file - the writer turns a lone <10> into
  ! CRLF either way - but it leaves a physical line that no line-walker can SEE, because
  ! they bracket lines by EOL tokens. This routine is itself such a walker, and a line it
  ! cannot see mis-brackets every line after it.
  self.tk.AddTok(moAsgE + 1, '<10>', '')                        ! ends the body's line
  self.tk.AddTok(moAsgE + 2, 'end', moIndSt.getValue())         ! ... and an END instead
  get(self.tk.tokens, moAsgE + 2)
  self.tk.tokens.type = vt:end
  self.tk.tokens.level = '-'
  put(self.tk.tokens)
  get(mgQ, records(mgQ))                                        ! the LAST condition's comment
  cmtRaw.free()                                                 !   sits on its own line
  if mq:cmtLn then cmtRaw.setValue(cmtBank.valuePtr[mq:cmtSt : mq:cmtSt + mq:cmtLn - 1]).
  moSb.setValue('   ')
  if cmtRaw._DataEnd then moSb.append(cmtRaw).                  ! the last condition's comment
  self.tk.AddTok(moAsgS, '<10>', moSb.getValue())               ! closes the condition line
  moSb.setValue(moIndSt.getValuePtr())
  moSb.append('  ')
  self.tk.SetStrBefore(moAsgS + 1, moSb.getValue())             ! the body, on its own line
  self.tk.SetStrBefore(moEol + 2, '')                           ! the old trailing comment has been re-placed on its condition's line; leaving it here trails the END
  self.tk.SetTok(moThen, 'or')                                  ! THEN becomes the first OR
  self.tk.SetStrBefore(moThen, ' ')
  moPos = moThen
  self.tk.AddTok(moPos + 1, '|', ' ')
  moPos += 1
  loop moQ = 2 to records(mgQ)
    get(mgQ, moQ)
    if errorcode() then break.
    moSb.setValue('   ')
    get(mgQ, moQ - 1)                                           ! the PREVIOUS line's comment
    cmtRaw.free()                                               !   closes the line before
    if mq:cmtLn then cmtRaw.setValue(cmtBank.valuePtr[mq:cmtSt : mq:cmtSt + mq:cmtLn - 1]).
    if cmtRaw._DataEnd then moSb.append(cmtRaw).                !   whole, however long this
    self.tk.AddTok(moPos + 1, '<10>', moSb.getValue())          ! a real end to that line
    moPos += 1
    get(mgQ, moQ)
    self.tk.AddTok(moPos + 1, clip(mq:condTx), moIndSt.getValue() & '   ')
    moPos += 1
    if moQ < records(mgQ)
      self.tk.AddTok(moPos + 1, 'or', ' ')
      moPos += 1
      self.tk.AddTok(moPos + 1, '|', ' ')
      moPos += 1
    end
  end
  changes += 1
  mgAgain = 1                                                   ! the indices have moved - walk again
  ! ON A .TXA each line written here stands at the first line's indent, so each ends with the
  ! shift marker exactly when the first line did, whatever comment was carried onto it: the
  ! k condition lines, the body and the END (TxaMarkOff).
  if self.isTxa
    get(mgQ, 1)
    moShf = mq:shf
    moPos = moIf
    loop moQ = 1 to records(mgQ) + 2
      moPos = self.FirstEolAfter(moPos)
      if ~moPos then break.
      moSb.free()
      get(self.tk.tokens, moPos)
      if ~errorcode() and not self.tk.tokens.strBefore &= NULL
        moSb.setValue(self.tk.tokens.strBefore)
      end
      self.TxaMarkOff(moSb)
      if moShf then moSb.append('!<251>').
      self.tk.SetStrBefore(moPos, moSb.getValue())
    end
  end

MgReset routine
  free(mgQ)
  runCount = 0
  allChar  = 0
  allPure  = 0
  runRecv.free()

!===============================================================================================
! The tokens pS..pE as text, normalised to ONE space between them. Used to ask whether two
! assignments are the same thing written twice: `f = 1` and `f  =  1` are, and comparing the
! source spacing would say otherwise.
!===============================================================================================
VitEngine.MgSpanText Procedure(LONG pS, LONG pE, StringTheory pOut)
j  long,auto
  code
  pOut.free()
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if pOut._DataEnd then pOut.append(' ').
    pOut.append(self.tk.tokens.tok)
  end

!===============================================================================================
! Is pS..pE exactly `RECEIVER.containsByte(n)` or `RECEIVER.containsChar('c')` for ONE character?
! Returns the byte, 1..255, or 0 for anything else - and fills pRecv with the receiver as it was
! written, dotted names included.
!
! Read from the RIGHT, because that is where the fixed shape is: ')' , the value, '(' , the
! method name, '.' - and whatever is left in front of them is the receiver. A receiver may be
! `x`, `self.buf` or `a.b.c`, and none of those need special handling this way round.
!===============================================================================================
VitEngine.MgOneCharTest Procedure(LONG pS, LONG pE, StringTheory pRecv)
nmU   string(32),auto
valTx string(64)
b     long,auto
  code
  pRecv.free()
  if pE - pS < 4 then return 0.                   ! r . name ( v ) is five tokens at the least
  get(self.tk.tokens, pE)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> ')' then return 0.
  get(self.tk.tokens, pE - 2)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '(' then return 0.
  get(self.tk.tokens, pE - 3)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  nmU = upper(self.tk.tokens.tok)
  if nmU <> 'CONTAINSBYTE' and nmU <> 'CONTAINSCHAR' then return 0.
  get(self.tk.tokens, pE - 4)
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  if self.tk.tokens.tok <> '.' then return 0.
  get(self.tk.tokens, pE - 1)                     ! the value
  if errorcode() or self.tk.tokens.tok &= NULL then return 0.
  valTx = self.tk.tokens.tok
  if nmU = 'CONTAINSBYTE'
    if ~self.MgAllDigits(valTx) then return 0.
    b = valTx                                     ! the digits, as a number
  else
    ! a literal of exactly one character. An escape like '<9>' is a single character too, but it
    ! is not one this decides - it is left to the containsByte form, which states its byte.
    if len(clip(valTx)) <> 3 or                   |
       valTx[1] <> '''' or valTx[3] <> ''''
      return 0
    end
    b = val(valTx[2])
  end
  if b < 1 or b > 255 then return 0.
  ! *** WHAT IS IN FRONT OF THE '.' HAS TO BE A NAME, AND ONLY A NAME. *** Taking the span on
  ! trust and stripping its spaces turned `ok and s.containsByte(92)` into the receiver
  ! `okands` - an identifier that does not exist - and `~s.containsByte(92)` into `~s`, which
  ! DOES compile and is wrong: the chain means `~A or ~B`, the merge means `~(A or B)`. A call
  ! left there, `foo(x).containsByte(92)`, would collapse N evaluations of foo into one.
  if ~self.MgPlainRecv(pS, pE - 5) then return 0.
  self.MgSpanText(pS, pE - 5, pRecv)              ! everything before the '.method(' is the receiver
  pRecv.removeByte(32)                            ! `a . b` and `a.b` are the same receiver  ! remove all <space>
  if ~pRecv._DataEnd then return 0.
  ! *** AND THE RECEIVER MUST BE A STRINGTHEORY. *** containsA is StringTheory's method: on a
  ! class of the author's own that has a ContainsByte, the merged line would not compile, or
  ! would call another method. A receiver that resolves must be a StringTheory; one that does
  ! not resolve is decided by --receiver=, as the Check* builtins decide it (RecvIsOtherClass).
  if self.syms &= NULL then return 0.
  case self.HayType(pRecv.getValue(), pS)
  of 'STRINGTHEORY'
  of ''
    if pS <> pE - 5 then return 0.
    if self.RecvIsOtherClass(pS) then return 0.
  else
    return 0
  end
  return b


!===============================================================================================
! ONE condition that tests the same receiver for several single characters, collapsed to one
! containsA - the same saving MergeGuardChain makes across consecutive IFs, made inside a
! condition the author already wrote as one.
!
!     if s.containsByte(92) or s.containsByte(47)     ->   if s.containsA('\/')
!     if ~s.containsByte(92) and ~s.containsByte(47)  ->   if ~s.containsA('\/')
!
! BOTH DIRECTIONS ARE DE MORGAN, AND THE OPERATOR IS NOT INTERCHANGEABLE.
! containsA asks "does it hold ANY of these", so it is an OR of the tests:
!     A or B                 == containsA(ab)
!     ~A and ~B  == ~(A or B) == ~containsA(ab)
! The other two pairings are NOT equal to anything containsA can say - `A and B` is
! contains-ALL, which StringTheory has no method for, and `~A or ~B` is its negation. A run
! whose polarity and operator do not match the two lines above is left alone.
!
! *** THE RUN MUST BE THE WHOLE CONDITION. *** `if x and A or B` parses as `(x and A) or B`,
! so collapsing the A-or-B that the eye sees would move a term across an operator that binds
! tighter. Requiring the run to span the entire condition costs a few collapses and cannot
! make that mistake. Parenthesised sub-runs are a later question, not a silent assumption.
!===============================================================================================
VitEngine.MgCollapseRuns Procedure()
cS     long,auto      ! first token of the condition
cE     long,auto      ! last token of the condition
p      long,auto
j      long,auto
d      long,auto
tS     long,auto      ! this term's first token
tEnd   long,auto
opU    string(8),auto ! the operator joining the terms - all must match
neg    byte,auto      ! this term is negated
runNeg byte,auto      ! ... and every term must agree
b      long,auto
terms  long,auto
ok     byte,auto
nTok   long,auto
tokU   string(16),auto
recv   StringTheory
first  StringTheory
alpha  StringTheory
sb     StringTheory
hits   long,auto
  code
  hits = 0
  nTok = records(self.tk.tokens)
  ! BACK TO FRONT: a collapse deletes tokens, so working backwards leaves every index we have
  ! yet to visit exactly where it was.
  loop p = nTok to 1 by -1
    get(self.tk.tokens, p)
    if errorcode() or self.tk.tokens.tok &= NULL then cycle.
    tokU = upper(self.tk.tokens.tok)
    if tokU <> 'IF' and tokU <> 'ELSIF' then cycle.
    cS = p + 1
    cE = 0
    d  = 0
    loop j = cS to nTok
      if self.IsEolTok(j) then cE = j - 1 ; break.
      get(self.tk.tokens, j)
      if errorcode() or self.tk.tokens.tok &= NULL then cycle.
      if size(self.tk.tokens.tok) = 1
        if self.tk.tokens.tok = '(' then d += 1.
        if self.tk.tokens.tok = ')' then d -= 1.
      end
      if ~d and upper(self.tk.tokens.tok) = 'THEN' then cE = j - 1 ; break.
    end
    if ~cE or cE < cS then cycle.
    ! ---- walk the condition as terms separated by ONE repeated operator -----------------
    opU   = ''
    terms = 0
    ok    = 1
    runNeg = 2                                           ! 2 = not yet known
    alpha.free()
    first.free()
    tS = cS
    d  = 0
    loop j = cS to cE + 1
      if j <= cE
        get(self.tk.tokens, j)
        if errorcode() or self.tk.tokens.tok &= NULL then cycle.
        if size(self.tk.tokens.tok) = 1
          if self.tk.tokens.tok = '(' then d += 1.
          if self.tk.tokens.tok = ')' then d -= 1.
        end
        if d then cycle.
        tokU = upper(self.tk.tokens.tok)
        if tokU <> 'OR' and tokU <> 'AND' then cycle.
        if opU and opU <> tokU then ok = 0 ; break.      ! mixed operators - precedence, leave it
        opU = tokU
      end
      tEnd = j - 1                                       ! the term is everything up to the operator
      neg = 0
      get(self.tk.tokens, tS)
      if errorcode() or self.tk.tokens.tok &= NULL then ok = 0 ; break.
      case upper(self.tk.tokens.tok)
      of '~' orof 'NOT'
        neg = 1
        tS += 1
      end
      if runNeg = 2 then runNeg = neg.
      if neg <> runNeg then ok = 0 ; break.              ! mixed polarity says nothing containsA can
      b = self.MgOneCharTest(tS, tEnd, recv)
      if ~b then ok = 0 ; break.
      if ~terms
        first.setValue(recv)
      elsif upper(choose(first._DataEnd < 1, '', first.valuePtr[1 : first._DataEnd])) <> upper(recv.getValue())
        ok = 0                                           ! a different receiver each time
        break
      end
      alpha.append(chr(b))
      terms += 1
      tS = j + 1
    end
    if ~ok or terms < 2 then cycle.
    if ~self.MgAlphaFix(alpha) then cycle.               ! all-space, or a space left last
    if opU = 'OR'  and runNeg then cycle.                ! ~A or ~B  - contains-ALL, no method for it
    if opU = 'AND' and ~runNeg then cycle.               !  A and B  - the same, the other way up
    ! The condition tokens are about to be DELETED, and a token's trivia goes with it. A
    ! run spanning a '|' continuation collapses correctly - the continuation is trivia, so the
    ! condition is still one logical line - but a comment written after that '|' is trivia too
    ! and would go with the tokens. Refuse this run rather than drop it.
    if self.SpanTriviaHasComment(cS + 1, cE) then cycle.
    ! ---- emit ---------------------------------------------------------------------------
    sb.free()
    if runNeg then sb.append('~').
    sb.append(first)
    sb.append('.containsA(''')
    self.MgLitAlphabet(alpha, sb)
    sb.append(''')')
    self.tk.SetTok(cS, sb.getValue())
    if cE > cS then self.tk.DeleteToks(cS + 1, cE).
    hits += 1
    self.syms.dirty = 1
    nTok = records(self.tk.tokens)
  end
  return hits

!===============================================================================================
! Is the span a bare name chain - `a`, `a.b`, `a.b.c` - and nothing else?
!
! The shape is strict on purpose: an identifier, then any number of '.'-separated identifiers,
! with no operator, no '~', no parenthesis and no keyword anywhere in it. Alternation alone
! rejects `ok and s` (three identifiers running together) and `not s`, and the token test
! rejects `~s` and `foo(x)`.
!===============================================================================================
VitEngine.MgPlainRecv Procedure(LONG pS, LONG pE)
j     long,auto
wantN byte,auto ! 1 = a NAME is due here, 0 = a '.' is due
  code
  if pE < pS then return 0.
  wantN = 1
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() or self.tk.tokens.tok &= NULL then return 0.
    if self.tk.tokens.tok = '.'
      if wantN then return 0.   ! '..' or a leading dot
      wantN = 1
      cycle
    end
    if ~wantN then return 0.    ! two names with nothing between them - `ok and s`
    case self.tk.tokens.tok[1]
    of 'A' to 'Z' orof 'a' to 'z' orof '_'
    else
      return 0                  ! `~`, a digit, a quote, a bracket - not a name
    end
    wantN = 0
  end
  return choose(wantN = 0)      ! must have ENDED on a name, not a trailing '.'

!===============================================================================================
! Would running this statement ONCE do what running it N times does?
!
! A merge folds N single-line IFs into one, so the body runs once where it used to run once per
! TRUE condition. For `f = 1` that is the same thing. For `n += 1`, `do Bump` or anything that
! calls out, it is not: two true conditions used to add 2 and would now add 1.
!
! Deliberately strict - a refusal only costs a merge, and a wrong merge costs correct code:
!   * a plain `=` assignment, and nothing else. Compound assignment is out by definition.
!   * no '(' anywhere, so no call with brackets can hide on either side. A call with none -
!     `f = Bump` - is found by MgBareCall, which reads the tokens this text came from.
!   * the target must not appear on the right, which is `x = x + 1` wearing a different hat.
!===============================================================================================
VitEngine.MgStmtRepeatable Procedure(StringTheory pStmt)
one    StringTheory
lhs    StringTheory
rhs    StringTheory
allLhs StringTheory ! every target in the statement, <1>-separated
allRhs StringTheory ! every source in the statement, <1>-separated
txt    StringTheory
j      long,auto
seg    long,auto
  code
  txt.setValue(pStmt)
  txt.trim()
  if ~txt._DataEnd then return 0.
  ! *** A SEMICOLON JOINS STATEMENTS, IT DOES NOT DISQUALIFY THEM. *** `f = 2 ; g = 3` is two
  ! plain stores and merging it is perfectly safe; `f = 2 ; n += 1` is not. So split, and
  ! require EVERY part to be repeatable.
  !
  ! Split does the quoting itself, which is the point of using it: a ';' inside a literal is
  ! DATA, so `f = ';'` is one statement and not two. RemoveLines then drops the empty part a
  ! stray or doubled ';' leaves behind - `f = 1 ;;` is still just a store.
  allLhs.free()
  allRhs.free()
  txt.split(';', '''', '''')
  txt.removeLines()
  if ~txt.records() then return 0.
  loop j = 1 to txt.records()
    one.setValue(txt.getLine(j))
    if ~self.MgOneStore(one, lhs, rhs) then return 0.
    allLhs.append(lhs) ; allLhs.append('<1>')
    allRhs.append(rhs) ; allRhs.append('<1>')
  end
  ! *** THE PARTS ARE NOT INDEPENDENT OF EACH OTHER. *** Each one on its own can be perfectly
  ! repeatable while the PAIR is not: in `f = g ; g = 2` the second part writes what the
  ! first one reads, so the second time round the first part sees a different g. With g = 5
  ! and both characters present, the original chain ends f = 2 and the merged line ends f = 5.
  !
  ! So no target may appear among the sources ANYWHERE in the statement. This also refuses
  ! `g = 2 ; f = g`, which is in fact safe - but the cost of refusing is one merge, and the
  ! cost of allowing a wrong one is the user's code.
  seg = 1
  loop j = 1 to allLhs._DataEnd
    if allLhs.valuePtr[j] <> '<1>' then cycle.
    if j > seg
      if instring(upper(allLhs.valuePtr[seg : j - 1]), upper(allRhs.getValue()), 1, 1) then return 0.
    end
    seg = j + 1
  end
  ! *** A NAME IS TEXT HERE, BUT WHAT IS AT STAKE IS STORAGE. *** Two spellings can name the
  ! same bytes: a GROUP appears in an expression as a string over its members, so `grp` and
  ! `grp.x` overlap. And a colon is TWO different mechanisms wearing one spelling: `Prefix:Field`
  ! under PRE, and `Structure:Field`, which the LRM allows "instead of a period ... to reference
  ! member variables of any structure except CLASS and named reference variables" (Field
  ! Qualification, p28). So `q.g` and `q:g` can be one field written two ways.
  !
  ! Comparing the TEXT sees none of that, and `f = grp ;
  ! grp.x = 2` merged wrongly. Rather than teach this test the storage model, refuse the
  ! moment a qualified name is in play against anything but constants - the shape is rare and
  ! a refusal costs one merge.
  if self.MgQualClash(allLhs, allRhs) then return 0.
  return 1

!===============================================================================================
! Is a qualified name in play against anything that is not a constant?
!
! IT OVER-REFUSES, AND THE CASES ARE WORTH KNOWING so they do not read as defects later. A '.'
! is a qualifier here whether or not it qualifies anything, so a decimal constant refuses
! (`f = 1.5 * g`); and a ':' or '.' INSIDE a literal counts too (`u = 'a:b'`). Each costs one
! merge on a shape that is rare to begin with, and each errs toward leaving the code alone.
!
! 1 = yes, refuse. A '.' or a ':' anywhere on either side makes a name qualified, and the
! question is then only whether the other side names anything at all - `f = 8 ; pq:state = 9`
! stores constants and is perfectly safe, while `f = g ; grp.x = 2` is not.
!===============================================================================================
VitEngine.MgQualClash Procedure(StringTheory pLhs, StringTheory pRhs)
j    long,auto
c    string(1),auto
qual byte,auto
  code
  qual = 0
  loop j = 1 to pLhs._DataEnd
    c = pLhs.valuePtr[j]
    if c = '.' or c = ':' then qual = 1 ; break.
  end
  if ~qual
    loop j = 1 to pRhs._DataEnd
      c = pRhs.valuePtr[j]
      if c = '.' or c = ':' then qual = 1 ; break.
    end
  end
  if ~qual then return 0.
  ! *** A CLARION LABEL NEED NOT CONTAIN A LETTER. *** "The first character must be a letter or
  ! the underscore character" (the Clarion Language Reference, valid labels), so `_1` and `__2` are names
  ! and a letters-only test cannot see them: `f = _1 ; _1.x = 2` merged wrongly. A letterless
  ! name has to START with the underscore, and no numeric constant carries one, so admitting it
  ! here costs nothing. MgPlainRecv already spells this class correctly.
  loop j = 1 to pRhs._DataEnd          ! does the other side name anything?
    case val(pRhs.valuePtr[j])
    of 65 to 90 orof 97 to 122 orof 95 ! 'A' to 'Z' orof 'a' to 'z' orof '_'
      return 1
    end
  end
  return 0

!===============================================================================================
! Are these two statements the same statement?
!
! Clarion identifiers are case-blind, so `F = 1` and `f = 1` ARE the same statement and should
! merge. A LITERAL is not case-blind: `f = 'a'` and `f = 'A'` store different bytes, and a
! plain upper() compare would call them equal and merge them - with only the second character
! present the original stores 'A' and the merged line 'a'.
!
! *** THE CASE RULE CHANGES AT THE QUOTE, NOT AT THE STATEMENT. *** Comparing the whole thing
! as written the moment a quote appears anywhere would stop `F = 'a'` matching `f = 'a'`, which
! IS the same statement - a refusal, and an arbitrary one. So this walks the two together and
! switches rule at each quote: case-blind in the code, byte-for-byte inside the literal.
!
! The two run in step, so a quote in one and not the other fails at that character anyway -
! one side is a quote and the other is not, and nothing upper() does makes those equal.
!===============================================================================================
VitEngine.MgSameStmt Procedure(StringTheory pA, StringTheory pB)
a     StringTheory
b     StringTheory
j     long,auto
ca    string(1),auto
cb    string(1),auto
inLit byte,auto
  code
  a.setValue(pA)
  a.trim()
  b.setValue(pB)
  b.trim()
  if a._DataEnd <> b._DataEnd then return 0.
  inLit = 0
  loop j = 1 to a._DataEnd
    ca = a.valuePtr[j]
    cb = b.valuePtr[j]
    if inLit
      if ca <> cb then return 0.               ! inside a literal, bytes are bytes
    else
      if upper(ca) <> upper(cb) then return 0. ! outside it, Clarion is case-blind
    end
    if ca = '''' then inLit = 1 - inLit.
  end
  return 1

!===============================================================================================
! ONE statement, and whether running it twice is the same as running it once. The target and
! the source come back in pOut/pRhs so the caller can check the parts against EACH OTHER.
!
! Deliberately strict - a refusal costs a merge, a wrong merge costs correct code:
!   * a plain `=` store, and nothing else. Compound assignment is out by definition: `n += 1`
!     run once where it ran twice is a different number.
!   * no '(' anywhere, so no call with brackets can hide on either side and be made to happen
!     fewer times. A call with none is MgBareCall's to find.
!   * the target must not appear on its own right, which is `x = x + 1` wearing another hat.
!===============================================================================================
VitEngine.MgOneStore Procedure(StringTheory pOne, StringTheory pLhs, StringTheory pRhs)
txt   StringTheory
lhs   StringTheory
rhs   StringTheory
eqP   long,auto
j     long,auto
  code
  txt.setValue(pOne)
  txt.trim()
  if ~txt._DataEnd then return 0.                  ! an empty part - `f = 1 ;;` say
  if txt.findByte(40) then return 0.               ! '(' - a call may hide either side
  eqP = txt.findByte(61)                           ! '='
  if eqP < 2 then return 0.                        ! no '=', or nothing to assign to
  ! The LRM lists SIX operating assignments - += -= *= /= ^= %= - and none of them is a plain
  ! store, so none may be merged. '&=' is on this list for a different reason: it is REFERENCE
  ! assignment, not concatenation, which makes it even less of a store. All seven are listed
  ! so the refusal is deliberate rather than an accident of the plain-name test below.
  case val(txt.valuePtr[eqP - 1])
  ! '+' orof '-' orof '*' orof '/' orof '&' orof '^' orof '%'
  of 43 orof 45 orof 42 orof 47 orof 38 orof 94 orof 37
    return 0
  end
  if eqP < txt._DataEnd
    if txt.valuePtr[eqP + 1] = '=' then return 0.       ! '==' is a comparison, not a store
  end
  lhs.setValue(txt.valuePtr[1 : eqP - 1])
  lhs.trim()
  rhs.setValue(txt.valuePtr[eqP + 1 : txt._DataEnd])
  rhs.trim()
  if ~lhs._DataEnd or ~rhs._DataEnd then return 0.
  ! the target has to be a plain name - `f`, `grp.fld`, `pq:state`
  loop j = 1 to lhs._DataEnd
    case val(lhs.valuePtr[j])
    ! 'A' to 'Z' orof 'a' to 'z' orof '0' to '9' orof '_' orof <dot> orof <colon>
    of 65 to 90 orof 97 to 122 orof 48 to 57 orof 95 orof 46 orof 58
    else
      return 0
    end
  end
  ! `x = x + 1` reads its own target, so once is not the same as twice
  if instring(upper(lhs.getValue()), upper(rhs.getValue()), 1, 1) then return 0.
  pLhs.setValue(lhs)                               ! hand both back for the
  pRhs.setValue(rhs)                               !   cross-part check
  return 1

!===============================================================================================
! Make the alphabet fit to go inside containsA, or say it cannot.
!
! containsA CLIPS its argument, so a space at the END of the alphabet is simply not there at
! run time - the character would stop being tested and nothing would say so. Order carries no
! meaning in an alphabet, so a trailing space is moved to the FRONT rather than refusing a
! chain that is otherwise perfectly mergeable.
!
! An alphabet that is ALL spaces has nowhere to move it to. Clipped, it becomes the empty
! string, and `containsA('')` asks whether the receiver holds one of no characters. Returns 0
! (1 = usable, and pAlpha may have been reordered).
!===============================================================================================
VitEngine.MgAlphaFix Procedure(StringTheory pAlpha)
j   long,auto
sb  StringTheory
  code
  if ~pAlpha._DataEnd then return 0.
  loop j = 1 to pAlpha._DataEnd
    if pAlpha.valuePtr[j] <> ' ' then break.
  end
  if j > pAlpha._DataEnd then return 0. ! every byte is a space - nothing survives clip
  if pAlpha._DataEnd > 1 and pAlpha.valuePtr[pAlpha._DataEnd] = ' '
    sb.setValue(' ')
    sb.append(pAlpha.slice(1, pAlpha._DataEnd - 1))
    pAlpha.setValue(sb)
  end
  return 1

!===============================================================================================
! The alphabet, written as the body of a Clarion literal.
!
! Printable characters go in as themselves, with the quote, '<' and '{' doubled. A run of
! UNPRINTABLE bytes becomes ONE escape with the values comma-separated - <10,13>, not
! <10><13>. Both are legal and mean the same thing, but the comma form is the spelling the
! rest of this file already produces, and *** A FINAL BUILTIN HAS TO EMIT FINAL SPELLINGS. ***
! Running after the fixpoint, anything it writes that another rule would have tidied never
! gets tidied, and the file would settle only on a second run.
!===============================================================================================
VitEngine.MgLitAlphabet Procedure(StringTheory pAlpha, StringTheory pOut)
j    long,auto
b    long,auto
opn  byte,auto ! an escape group is open
  code
  opn = 0
  loop j = 1 to pAlpha._DataEnd
    b = val(pAlpha.valuePtr[j])
    case b
    of 32 to 126
    else
      if opn
        pOut.append(',' & b) ! another value in the group already open
      else
        pOut.append('<<' & b)
        opn = 1
      end
      cycle
    end
    if opn
      pOut.append('>')
      opn = 0
    end
    self.MgLitByte(b, pOut)
  end
  if opn then pOut.append('>').

!===============================================================================================
! This line's trailing comment, whole, from '!' to the last thing on it.
!
! Called by MgStageLine when the line is staged, and the text is banked whole in cmtBank:
! a queue row holding a fixed string would cut a longer comment to fit without a word about
! it, and a token index goes stale after the first DeleteToks.
!===============================================================================================
! ------------------------------------------------------------------------------------
! Drop the lines from pFirst to the EOL pLastEol, and keep every comment they carried:
! each trailing comment, each comment after a `|` inside a statement carried over lines, and
! each comment-only line, comes back as a comment line of its own at the first line's indent,
! where the lines were, in the order they stood. Returns how many. A caller that has already
! written the trivia of the tokens pCarryS to pCarryE somewhere else - an expression moved
! whole into another line, with the bars and comments inside it - names them, and their
! comments are not kept twice. The rule, ruled 14
! Sep 2026: a comment is not a reason to
! keep a line a pass has proved unnecessary, and it is not thrown away either. DropValueCopy
! and TakeOverValue keep theirs the same way (DvDropLine); this is the shared form for the
! other passes. EolHasCmt is the peek a log line takes before the drop.
! An OMIT block the tokenizer folded in front of one of the lines is the author's text as well,
! and it is kept the same way: every one, in order, stays where the lines were, above the comment
! lines (AbsorbedBlockOf). It rides the trivia of the token that now begins the spot, so a caller
! that puts a line there uses InsertLinesAbove, which keeps it above that line too.
! ------------------------------------------------------------------------------------
VitEngine.DropLinesKeepCmts Procedure(LONG pFirst, LONG pLastEol, LONG pCarryS=0, LONG pCarryE=0)
ind   StringTheory
cmt   StringTheory
txt   StringTheory
blk   StringTheory
one   StringTheory
bar   StringTheory
x     long,auto
e     long,auto
j     long,auto
k     long,auto
n     long
shf   byte
  code
  if pLastEol < pFirst then return 0.
  self.IndentOf(pFirst, ind)
  shf = self.TxaShiftOf(pFirst)
  x = pFirst
  loop while x <= pLastEol
    if x > pFirst or x = 1 or self.IsEolTok(x - 1)
      self.AbsorbedBlockOf(x, one)
      blk.append(one)
    end
    if self.IsEolTok(x)
      e = x ! a comment-only line IS its EOL
    else
      e = self.FirstEolAfter(x)
    end
    if ~e or e > pLastEol then break.
    loop j = x + 1 to e - 1
      if j >= pCarryS and j <= pCarryE then cycle.
      do KeepBarCmts
    end
    self.MgCmtText(e, cmt)
    self.TxaMarkOff(cmt)
    if cmt._DataEnd
      if ind._DataEnd then txt.append(ind.valuePtr[1 : ind._DataEnd]).
      txt.append(cmt)
      if shf then txt.append('!<251>').
      txt.append('<13,10>')
      n += 1
    end
    x = e + 1
  end
  self.tk.DeleteToks(pFirst, pLastEol)
  if n then self.tk.InsertString(pFirst, txt).
  if blk._DataEnd then self.tk.PrependStrBefore(pFirst, blk.getValue()).
  return n

! ---- the trivia in front of token j, inside a statement: each line it closes ends after a `|`,
!      and a comment there is the author's - a '!' and what follows it, or the words written
!      after the bar, which the compiler ignores as it does a comment. TriviaCmtRows reads both and
!      gives each row its marker; each comes back as a comment line at the first line's indent.
KeepBarCmts routine
  get(self.tk.tokens, j)
  if errorcode() or self.tk.tokens.strBefore &= NULL then exit.
  bar.setValue(self.tk.tokens.strBefore)
  if ~bar.findByte(10) then exit.
  bar.free()
  if ~self.TriviaCmtRows(j, bar) then exit.
  bar.split('<13,10>')
  loop k = 1 to bar.records()
    one.setValue(bar.getLine(k))
    self.TxaMarkOff(one)
    if ~one._DataEnd then cycle.
    if ind._DataEnd then txt.append(ind.valuePtr[1 : ind._DataEnd]).
    txt.append(one)
    if shf then txt.append('!<251>').
    txt.append('<13,10>')
    n += 1
  end

VitEngine.EolHasCmt Procedure(LONG pEol)
cmt   StringTheory
  code
  self.MgCmtText(pEol, cmt)
  return choose(cmt._DataEnd > 0)

! The search starts after the LAST line feed: a comment-only line's EOL token can carry an OMIT
! block folded in front of the line, and a '!' inside that block is the block's, not this line's.
! On a .txa a line that began in column 1 ends with the shift marker `!<251>` (TxaMarkOff): the
! marker alone is no comment, and the answer is blank. A comment keeps it at its end, as its line
! had it, so a comment line written from it goes back to column 1 the way its line would.
VitEngine.MgCmtText Procedure(LONG pEolTok, StringTheory pOut)
p  long,auto
s  long,auto
  code
  pOut.free()
  get(self.tk.tokens, pEolTok)
  if errorcode() or self.tk.tokens.strBefore &= NULL then return.
  s = size(self.tk.tokens.strBefore)
  loop while s >= 1
    if self.tk.tokens.strBefore[s] = '<10>' then break.
    s -= 1
  end
  if s = size(self.tk.tokens.strBefore) then return.
  s += 1
  p = pOut.findByte(33, s,, self.tk.tokens.strBefore) ! '!'
  if ~p then return.
  pOut.setValue(self.tk.tokens.strBefore[p : size(self.tk.tokens.strBefore)])
  pOut.trim()                                         ! the field's trailing padding is not part of the comment
  if pOut._DataEnd = 2 then self.TxaMarkOff(pOut).

!===============================================================================================
! The comments riding token pTok's leading trivia, appended to pOut one ROW each - the marker,
! the text, then CR/LF. Returns how many rows it wrote.
!
! A comment starts at a '!', or at the first word after a '|'. The compiler ignores the rest of
! a line after a continuation bar, so `& |   now the tail` carries a comment with no marker of
! its own, and its row is given one; a '|' in column 1 makes a comment row inside a continuation
! the same way. Each physical line of the trivia is read on its own, and one that holds neither
! - an indent, a bare bar - adds nothing. The trivia of a token in the middle of a statement
! holds a line break only where a '|' put one, so that is where these comments are found; a
! pass that deletes such a token, or rebuilds the statement from its text, asks here first.
! On a .txa the shift marker at the end of a row (TxaMarkOff) stays with the row's comment, as in
! MgCmtText, and a row that is the marker alone is no comment and adds nothing.
! (Codes: 13 and 10 end a line, 32 and 9 are spacing, 124 is '|', 33 is '!'.)
!===============================================================================================
VitEngine.TriviaCmtRows Procedure(LONG pTok, StringTheory pOut)
row  StringTheory
k    long,auto
a    long,auto
onB  byte,auto
n    long
  code
  get(self.tk.tokens, pTok)
  if errorcode() or self.tk.tokens.strBefore &= NULL then return 0.
  a = 0 ; onB = 0
  loop k = 1 to size(self.tk.tokens.strBefore)
    case val(self.tk.tokens.strBefore[k])
    of 13 orof 10
      if a then row.setValue(self.tk.tokens.strBefore[a : k - 1]) ; do AddRow.
      a = 0 ; onB = 0
    of 32  orof 9
    of 124
      onB = 1
    of 33
      if ~a then a = k.
    else
      if onB and ~a then a = k.
    end
  end
  if a then row.setValue(self.tk.tokens.strBefore[a : size(self.tk.tokens.strBefore)]) ; do AddRow.
  return n

AddRow routine
  row.clip()
  if ~row._DataEnd then exit.
  if row._DataEnd = 2 and self.TxaMarkOff(row) then exit.
  if row.valuePtr[1] <> '!' then row.prepend('! ').
  pOut.append(row)
  pOut.append('<13,10>')
  n += 1

!===============================================================================================
! Rows from TriviaCmtRows joined onto pAcc as ONE comment. The rows of a comment wrapped over a
! continuation are one sentence: the first keeps its '!', and every later row - in pRows or
! after what pAcc already holds - drops its marker and follows after one space.
! A row's .txa shift marker (TxaMarkOff) is not joined: it belongs to a line that is no longer one.
!===============================================================================================
VitEngine.CmtRowsJoin Procedure(StringTheory pRows, StringTheory pAcc)
row  StringTheory
k    long,auto
a    long,auto
  code
  a = 1
  loop k = 1 to pRows._DataEnd
    case val(pRows.valuePtr[k])
    of 13 orof 10
      if k > a then row.setValue(pRows.valuePtr[a : k - 1]) ; do OneRow.
      a = k + 1
    end
  end
  if a <= pRows._DataEnd then row.setValue(pRows.valuePtr[a : pRows._DataEnd]) ; do OneRow.

OneRow routine
  row.trim()
  self.TxaMarkOff(row)
  if ~row._DataEnd then exit.
  if pAcc._DataEnd
    if row.valuePtr[1] = '!' then row.RemoveFromPosition(1, 1).
    row.trim()
    if row._DataEnd then pAcc.append(' ' & row.getValue()).
  else
    pAcc.append(row)
  end

!===============================================================================================
! A comment carried off rows that a rewrite joins into one line goes where that line now ends:
! in FRONT of the line's own comment and joined to it as one comment - the carried text first,
! so a sentence wrapped over the rows still reads in order under one marker - or after the code
! when the line has none. The gap in front of the comment stays the line's own. KnownRanges
! carries the comments of the insert it writes in the same way. pEol is the line's EOL token.
! On a .txa the line's own shift marker (TxaMarkOff) is no comment of the line's: it comes off
! first and goes back last, so the line still ends with it.
!===============================================================================================
VitEngine.CmtToLineEnd Procedure(LONG pEol, StringTheory pCmt)
sb  StringTheory
ap  long,auto
shf byte,auto
  code
  if ~pCmt._DataEnd then return.
  get(self.tk.tokens, pEol)
  if errorcode() then return.
  if not self.tk.tokens.strBefore &= NULL then sb.setValue(self.tk.tokens.strBefore).
  shf = self.TxaMarkOff(sb)
  ap = sb.findByte(33)
  if ap
    sb.RemoveFromPosition(ap, 1)
    loop while ap <= sb._DataEnd and sb.valuePtr[ap] = ' '
      sb.RemoveFromPosition(ap, 1)
    end
    sb.insert(ap, pCmt.getValue() & ' ')
  else
    sb.append('  ' & pCmt.getValue())
  end
  if shf then sb.append('!<251>').
  self.tk.SetStrBefore(pEol, sb.getValue())

!===============================================================================================
! THE .TXA SHIFT MARKER IS NOT A COMMENT. On a .txa a code line that begins in column 1 is moved
! one space right while the file is worked on, and `!<251>` is written at its end so that the
! space comes off again when the file is written back (TxaPreOne, TxaPostProcess - only a marker
! that ends its line is undone). Read as trivia it looks like a comment, or like the end of one.
! This takes it off the end of pS, with the blanks and line ends either side of it, and answers 1
! when it was there. On any other file, or with no marker at the end, pS is left as it is.
! (Codes: 32 and 9 are spacing, 13 and 10 end a line, 251 is the marker's byte.)
!===============================================================================================
VitEngine.TxaMarkOff Procedure(StringTheory pS)
e  long,auto
  code
  if ~self.isTxa then return 0.
  e = pS._DataEnd
  loop while e >= 1
    case val(pS.valuePtr[e])
    of 32 orof 9 orof 13 orof 10
      e -= 1
    else
      break
    end
  end
  if e < 2 then return 0.
  if pS.valuePtr[e] <> '<251>' or pS.valuePtr[e - 1] <> '!' then return 0.
  pS.RemoveFromPosition(e - 1, pS._DataEnd - e + 2)
  pS.clip()
  return 1

!===============================================================================================
! DID THE LINE pTok IS ON BEGIN IN COLUMN 1? On a .txa such a line is moved one space right while
! the file is worked on and ends with the shift marker (TxaMarkOff), which sits in the trivia of
! the line's end. A pass that writes new lines at that line's indent gives them the marker too
! (TxaMarkLines), or they come back one column out. On any other file the answer is 0.
!===============================================================================================
VitEngine.TxaShiftOf Procedure(LONG pTok)
e    long,auto
one  StringTheory
  code
  if ~self.isTxa or pTok < 1 then return 0.
  if self.IsEolTok(pTok)
    e = pTok
  else
    e = self.FirstEolAfter(pTok)
  end
  if ~e then return 0.
  get(self.tk.tokens, e)
  if errorcode() or self.tk.tokens.strBefore &= NULL then return 0.
  one.setValue(self.tk.tokens.strBefore)
  return self.TxaMarkOff(one)

!===============================================================================================
! The lines of pTxt, each ended by a line break, are about to be written at the indent of a line
! of this file. On a .txa each loses a shift marker it carries - a moved line's own comment brings
! one - and, when that line began in column 1 (pShf, from TxaShiftOf), each gets the marker, so
! the space the shift added comes off every one of them when the file is written back and they
! keep their places beside it. On any other file pTxt is left as it is.
!===============================================================================================
VitEngine.TxaMarkLines Procedure(StringTheory pTxt, BYTE pShf)
lines  StringTheory
one    StringTheory
acc    StringTheory
k      long,auto
n      long,auto
ec     byte,auto
  code
  if ~self.isTxa or ~pTxt._DataEnd then return.
  ec = pTxt.endsWith('<13,10>')
  lines.setValue(pTxt)
  lines.split('<13,10>')
  n = lines.records()
  loop k = 1 to n
    one.setValue(lines.getLine(k))
    if k = n and ~one._DataEnd then break. ! the text ended with a line break
    self.TxaMarkOff(one)
    if pShf and one._DataEnd then one.append('!<251>').
    acc.append(one)
    if k < n then acc.append('<13,10>').
  end
  if ec and ~acc.endsWith('<13,10>') then acc.append('<13,10>').
  pTxt.setValue(acc)

!===============================================================================================
! One byte, written so a Clarion literal survives it.
!
! Three characters have to be doubled inside a literal - the quote, '<' (which opens the
! `<n>` escape) and '{' (which opens a repeat count) - and anything outside printable ASCII
! has to BE an escape, because writing the byte raw puts it in the source. A CR or an LF
! written raw physically splits the line in half, mid-literal, and the file will not compile.
!===============================================================================================
VitEngine.MgLitByte Procedure(LONG pB, StringTheory pOut)
c  string(1),auto
  code
  case pB
  of 32 to 126
  else                           ! not printable - it must be an escape
    pOut.append('<<' & pB & '>')
    return
  end
  c = chr(pB)
  case val(c)
  of 39                          ! <single quote>
    pOut.append('''''')          ! doubled, as in any Clarion literal
  of 60                          ! '<<'                                    ! THE ESCAPER NEEDS THE ESCAPING IT WRITES.
    pOut.append('<<<<')          !   '<<' in Clarion source IS one '<', so two
  of 123                         ! '{{'                                    !   of them take four here. A single '{' does
    pOut.append('{{{{')          !   not even compile - it opens a repeat count.
  else
    pOut.append(c)
  end

!===============================================================================================
VitEngine.MgAllDigits Procedure(STRING pTxt)
j  long,auto
n  long,auto
  code
  n = len(clip(pTxt))
  if ~n then return 0.
  loop j = 1 to n
    if pTxt[j] < '0' or pTxt[j] > '9' then return 0.
  end
  return 1

!===============================================================================================
! Is every call in pS..pE one that only READS?
!
! An OR-joined test short-circuits, so a condition that is not reached is not evaluated. That is
! only safe when evaluating it does nothing but answer. A '(' whose preceding token is a NAME is
! a call; one after an operator, a comma, or at the start of the span is grouping. The name has
! to be on the list, and the list is the one IfChainToCase uses, so a rule file's PURE(...)
! extends both at once. As in IfChainToCase, a METHOD counts only on a StringTheory: a
! GetLine of another class may read the next line on every call - see PureMethodAt.
! A call with no object in front of it counts only as one of the runtime's own readers, and only
! where this file gives no procedure that name (PureProc, with pOwn from PureOwnList): GetLine or
! Length written alone is a procedure of the program's own. A name PURE(...) adds (pAdd) is the
! author's word.
!===============================================================================================
VitEngine.MgCondIsPure Procedure(LONG pS, LONG pE, StringTheory pPure, StringTheory pAdd, StringTheory pOwn)
j     long,auto
nmU   string(64)
  code
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL                                 or |
       size(self.tk.tokens.tok) <> 1 or self.tk.tokens.tok <> '(' or |
       j <= pS                                                       ! opens the span - grouping
      cycle
    end
    get(self.tk.tokens, j - 1)
    if errorcode() or self.tk.tokens.tok &= NULL then cycle.
    nmU = upper(self.tk.tokens.tok)
    if ~nmU then cycle.
    case val(nmU[len(clip(nmU))])                                    ! a NAME immediately before '(' is a call
    of 65 to 90 orof 48 to 57 orof 95                                ! 'A' to 'Z' orof '0' to '9' orof '_'
      if ~pPure.findChars(' ' & clip(nmU) & ' ') then return 0.
      if self.tk.GetTok(j - 2) = '.' and ~self.PureMethodAt(j, pPure) then return 0.
      if self.tk.GetTok(j - 2) <> '.'
        if ~pAdd.findChars(' ' & clip(nmU) & ' ') and ~self.PureProc(nmU, pPure, pOwn) then return 0.
      end
    end
  end
  return 1

!===============================================================================================
! Does a right-hand side in the body pS..pE read storage that has a second name? `x = y + 1` with
! `y LONG,OVER(x)` reads its own target under another name, so run once it adds 1 where two true
! conditions added 2 - and MgStmtRepeatable's text test cannot see that. Every name after an '='
! up to the next ';' is asked (NameShared); a target is not, MgOneStore has judged it.
!===============================================================================================
VitEngine.MgRhsShared Procedure(LONG pS, LONG pE)
j    long,auto
rhs  byte,auto
  code
  rhs = 0
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then return 1.
    if self.tk.tokens.tok &= NULL then cycle.
    if self.tk.tokens.tok = '=' then rhs = 1 ; cycle.
    if self.tk.tokens.tok = ';' then rhs = 0 ; cycle.
    if ~rhs or self.tk.tokens.type <> vt:label then cycle.
    if self.NameShared(j, self.NameRoot(self.tk.tokens.tok)) then return 1.
  end
  return 0

!===============================================================================================
! Can a name in pS..pE be a CALL, though no bracket shows one?
!
! Clarion calls a parameterless procedure or method by its label alone: `f = Bump` runs Bump,
! and `if Bump then` runs it too. Merged, such a call would run once where it ran once per line
! - on the right of a store, once per true condition; in a condition behind an OR, not at all
! once an earlier one is true. So every name has to be one the symbol table places as data, an
! equate or a member (BareNameIsCall). With pStore = 1 the span is a line of stores, and only
! the right-hand sides are asked: the target in front of each '=' is storage, and each
! statement after a ';' has its own. 1 = a call may hide there.
!===============================================================================================
VitEngine.MgBareCall Procedure(LONG pS, LONG pE, BYTE pStore)
j    long,auto
lhs  byte,auto
  code
  lhs = pStore
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then return 1.
    if self.tk.tokens.tok &= NULL then cycle.
    if pStore and self.tk.tokens.tok = ';' then lhs = 1 ; cycle.
    if lhs
      if self.tk.tokens.tok = '=' then lhs = 0.
      cycle
    end
    if self.BareNameIsCall(j) then return 1.
  end
  return 0

!===============================================================================================
! The tokens pS..pE AS WRITTEN - each one's own leading trivia kept, except the first, whose
! trivia belongs to whatever came before it. MgSpanText normalises to one space, which is what
! you want for COMPARING two spans and not at all what you want for re-emitting one: it turns
! `p.findChar('z')` into `p . findChar ( 'z' )`.
!===============================================================================================
VitEngine.MgSpanRaw Procedure(LONG pS, LONG pE, StringTheory pOut)
j  long,auto
  code
  pOut.free()
  loop j = pS to pE
    get(self.tk.tokens, j)
    if errorcode() then break.
    if self.tk.tokens.tok &= NULL then cycle.
    if j > pS and not self.tk.tokens.strBefore &= NULL
      pOut.append(self.tk.tokens.strBefore)
    end
    pOut.append(self.tk.tokens.tok)
  end
