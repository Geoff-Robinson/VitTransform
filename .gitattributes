# VitTransform source must stay CRLF + plain ANSI (byte-exact) to compile in
# Clarion. Disable git's end-of-line conversion on these types so a clone on
# any platform never rewrites the line endings.
#
# THIS FILE IS THE ONLY THING STOPPING THAT CONVERSION, and it is consulted by
# its NAME. A misspelling has exactly the same effect as no file at all, and
# looks completely correct in a directory listing - which is how the first
# release went out as ".gitattibutes" with every text file converted to LF.
*.clw    -text
*.inc    -text
*.txt    -text
*.bat    -text
*.sln    -text
*.cwproj -text
*.red    -text
*.equ    -text
*.int    -text
*.pr     -text
*.trn    -text

# Not compiled by Clarion, so the endings do not matter to the build - but a
# file that git normalises cannot be byte-compared against the working copy,
# and an exception in a check is how the last fault hid. These two are listed
# so that EVERY shipped file can be verified the same way, with no exceptions
# to remember. LICENSE has no extension, so it is matched by its exact name.
*.md     -text
LICENSE  -text

# AND THIS FILE ITSELF, plus .gitignore. Nothing in the list above matches
# either of them - no extension, and no exact-name entry - so git normalised
# both on the way out of a clone, and a byte-for-byte check against the working
# directory reported the attributes file as differing. That is the one file
# whose entire job is to stop that happening, so it not covering itself is the
# gap most likely to be read as "the check is unreliable" rather than "the file
# is not protected".
.gitattributes -text
.gitignore     -text

# from: https://help.github.com/articles/dealing-with-line-endings via Carl B
# Denote all files that are truly binary and should not be modified.
*.app binary
*.bmp binary
*.chm binary
*.dct binary
*.dll binary
*.exe binary
*.gif binary
*.hlp binary
*.ico binary
*.jpg binary
*.lib binary
*.png binary
*.zip binary
*.docx binary
*.pdf binary

# Declare language association
*.clw linguist-language=Clarion
*.equ linguist-language=Clarion
*.inc linguist-language=Clarion
*.int linguist-language=Clarion
*.tpl linguist-language=Clarion
*.tpw linguist-language=Clarion
*.txa linguist-language=Clarion
*.txd linguist-language=Clarion
*.apv linguist-language=Clarion
*.dcv linguist-language=Clarion
